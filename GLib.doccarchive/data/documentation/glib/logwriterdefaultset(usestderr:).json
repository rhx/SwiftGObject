text","text":" "},{"text":"sent to ","type":"text"},{"type":"codeVoice","code":"stderr"},{"type":"text","text":". This is problematic for applications that intend"},{"text":" ","type":"text"},{"type":"text","text":"to reserve "},{"type":"codeVoice","code":"stdout"},{"type":"text","text":" for structured output such as JSON or XML."}],"type":"paragraph"},{"type":"paragraph","inlineContent":[{"type":"text","text":"This function sets global state. It is not thread-aware, and should be"},{"text":" ","type":"text"},{"type":"text","text":"called at the very start of a program, before creating any other threads"},{"text":" ","type":"text"},{"type":"text","text":"or creating objects that could create worker threads of their own."}]}],"kind":"content"}],"identifier":{"url":"doc:\/\/GLib\/documentation\/GLib\/logWriterDefaultSet(useStderr:)","interfaceLanguage":"swift"},"sections":[],"abstract":[{"text":"Configure whether the built-in log functions will output all log messages to","type":"text"},{"text":" ","type":"text"},{"type":"codeVoice","code":"stderr"},{"type":"text","text":"."}],"hierarchy":{"paths":[["doc:\/\/GLib\/documentation\/GLib"]]},"kind":"symbol","schemaVersion":{"minor":3,"patch":0,"major":0},"variants":[{"paths":["\/documentation\/glib\/logwriterdefaultset(usestderr:)"],"traits":[{"interfaceLanguage":"swift"}]}],"references":{"doc://GLib/documentation/GLib":{"identifier":"doc:\/\/GLib\/documentation\/GLib","title":"GLib","abstract":[],"type":"topic","url":"\/documentation\/glib","kind":"symbol","role":"collection"},"doc://GLib/documentation/GLib/logWriterDefaultSet(useStderr:)":{"title":"logWriterDefaultSet(useStderr:)","identifier":"doc:\/\/GLib\/documentation\/GLib\/logWriterDefaultSet(useStderr:)","url":"\/documentation\/glib\/logwriterdefaultset(usestderr:)","kind":"symbol","fragments":[{"text":"func","kind":"keyword"},{"text":" ","kind":"text"},{"text":"logWriterDefaultSet","kind":"identifier"},{"text":"(","kind":"text"},{"text":"useStderr","kind":"exte