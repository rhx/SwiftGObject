{"abstract":[{"text":"Returns the ISO 8601 week-numbering year in which the week containing","type":"text"},{"text":" ","type":"text"},{"type":"codeVoice","code":"datetime"},{"text":" falls.","type":"text"}],"schemaVersion":{"patch":0,"minor":3,"major":0},"hierarchy":{"paths":[["doc:\/\/GLib\/documentation\/GLib","doc:\/\/GLib\/documentation\/GLib\/DateTimeProtocol"]]},"kind":"symbol","identifier":{"url":"doc:\/\/GLib\/documentation\/GLib\/DateTimeProtocol\/weekNumberingYear","interfaceLanguage":"swift"},"metadata":{"roleHeading":"Instance Property","externalID":"s:4GLib16DateTimeProtocolPAAE17weekNumberingYearSivp","modules":[{"name":"GLib"}],"title":"weekNumberingYear","role":"symbol","fragments":[{"text":"var","kind":"keyword"},{"kind":"text","text":" "},{"kind":"identifier","text":"weekNumberingYear"},{"text":": ","kind":"text"},{"text":"Int","kind":"typeIdentifier","preciseIdentifier":"s:Si"}],"extendedModule":"GLib","symbolKind":"property"},"sections":[],"primaryContentSections":[{"kind":"declarations","declarations":[{"tokens":[{"kind":"keyword","text":"var"},{"text":" ","kind":"text"},{"kind":"identifier","text":"weekNumberingYear"},{"kind":"text","text":": "},{"text":"Int","preciseIdentifier":"s:Si","kind":"typeIdentifier"},{"kind":"text","text":" { "},{"kind":"keyword","text":"get"},{"kind":"text","text":" }"}],"platforms":["macOS"],"languages":["swift"]}]},{"kind":"content","content":[{"level":2,"text":"Discussion","type":"heading","anchor":"discussion"},{"inlineContent":[{"type":"text","text":"This function, taken together with "},{"type":"codeVoice","code":"g_date_time_get_week_of_year()"},{"type":"text","text":" and"},{"text":" ","type":"text"},{"type":"codeVoice","code":"g_date_time_get_day_of_week()"},{"type":"text","text":" can be used to determine the full ISO"},{"type":"text","text":" "},{"type":"text","text":"week date on which "},{"code":"datetime","type":"codeVoice"},{"text":" falls.","type":"text"}],"type":"paragraph"},{"type":"paragraph","inlineContent":[{"text":"This is usually equal to the normal Gregorian year (as returned by","type":"text"},{"type":"text","text":" "},{"type":"codeVoice","code":"g_date_time_get_year()"},{"text":"), except as detailed below:","type":"text"}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"For Thursday, the week-numbering year is always equal to the usual"},{"text":" ","type":"text"},{"text":"calendar year.  For other days, the number is such that every day","type":"text"},{"text":" ","type":"text"},{"type":"text","text":"within a complete week (Monday to Sunday) is contained within the"},{"type":"text","text":" "},{"type":"text","text":"same week-numbering year."}]},{"type":"paragraph","inlineContent":[{"text":"For Monday, Tuesday and Wednesday occurring near the end of the year,","type":"text"},{"text":" ","type":"text"},{"type":"text","text":"this may mean that the week-numbering year is one greater than the"},{"type":"text","text":" "},{"type":"text","text":"calendar year (so that these days have the same week-numbering year"},{"type":"text","text":" "},{"text":"as the Thursday occurring early in the next year).","type":"text"}]},{"inlineContent":[{"type":"text","text":"For Friday, Saturday and Sunday occurring near the start of the year,"},{"type":"text","text":" "},{"text":"this may mean that the week-numbering year is one less than the","type":"text"},{"text":" ","type":"text"},{"type":"text","text":"calendar year (so that these days have the same week-numbering year"},{"type":"text","text":" "},{"type":"text","text":"as the Thursday occurring late in the previous year)."}],"type":"paragraph"},{"type":"paragraph","inlineContent":[{"text":"An equivalent description is that the week-numbering year is equal to","type":"text"},{"type":"text","text":" "},{"text":"the calendar year containing the majority of the days in the current","type":"text"},{"type":"text","text":" "},{"text":"week (Monday to Sunday).","type":"text"}]},{"type":"paragraph","inlineContent":[{"text":"Note that January 1 0001 in the proleptic Gregorian calendar is a","type":"text"},{"type":"text","text":" "},{"type":"text","text":"Monday, so this function never returns 0."}]}]}],"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/glib\/datetimeprotocol\/weeknumberingyear"]}],"references":{"doc://GLib/documentation/GLib/DateTimeProtocol/weekNumberingYear":{"role":"symbol","identifier":"doc:\/\/GLib\/documentation\/GLib\/DateTimeProtocol\/weekNumberingYear","kind":"symbol","fragments":[{"kind":"keyword","text":"var"},{"text":" ","kind":"text"},{"text":"weekNumberingYear","kind":"identifier"},{"text":": ","kind":"text"},{"preciseIdentifier":"s:Si","kind":"typeIdentifier","text":"Int"}],"title":"weekNumberingYear","type":"topic","abstract":[{"type":"text","text":"Returns the ISO 8601 week-numbering year in which the week containing"},{"text":" ","type":"text"},{"type":"codeVoice","code":"datetime"},{"type":"text","text":" falls."}],"url":"\/documentation\/glib\/datetimeprotocol\/weeknumberingyear"},"doc://GLib/documentation/GLib":{"identifier":"doc:\/\/GLib\/documentation\/GLib","title":"GLib","abstract":[],"type":"topic","url":"\/documentation\/glib","kind":"symbol","role":"collection"},"doc://GLib/documentation/GLib/DateTimeProtocol":{"url":"\/documentation\/glib\/datetimeprotocol","role":"symbol","abstract":[{"type":"codeVoice","code":"GDateTime"},{"text":" is a structure that combines a Gregorian date and time","type":"text"},{"text":" ","type":"text"},{"type":"text","text":"into a single structure."}],"title":"DateTimeProtocol","fragments":[{"kind":"keyword","text":"protocol"},{"text":" ","kind":"text"},{"text":"DateTimeProtocol","kind":"identifier"}],"kind":"symbol","type":"topic","identifier":"doc:\/\/GLib\/documentation\/GLib\/DateTimeProtocol","navigatorTitle":[{"text":"DateTimeProtocol","kind":"identifier"}]}}}