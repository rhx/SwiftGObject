{"primaryContentSections":[{"kind":"declarations","declarations":[{"tokens":[{"kind":"keyword","text":"func"},{"kind":"text","text":" "},{"text":"getWeekOfYear","kind":"identifier"},{"kind":"text","text":"() -> "},{"kind":"typeIdentifier","preciseIdentifier":"s:Si","text":"Int"}],"languages":["swift"],"platforms":["macOS"]}]},{"kind":"content","content":[{"anchor":"discussion","text":"Discussion","type":"heading","level":2},{"type":"paragraph","inlineContent":[{"text":"The first week of the year is week 1.  This is the week that contains","type":"text"},{"type":"text","text":" "},{"type":"text","text":"the first Thursday of the year.  Equivalently, this is the first week"},{"type":"text","text":" "},{"type":"text","text":"that has more than 4 of its days falling within the calendar year."}]},{"inlineContent":[{"text":"The value 0 is never returned by this function.  Days contained","type":"text"},{"type":"text","text":" "},{"text":"within a year but occurring before the first ISO 8601 week of that","type":"text"},{"text":" ","type":"text"},{"type":"text","text":"year are considered as being contained in the last week of the"},{"text":" ","type":"text"},{"text":"previous year.  Similarly, the final days of a calendar year may be","type":"text"},{"type":"text","text":" "},{"type":"text","text":"considered as being part of the first ISO 8601 week of the next year"},{"type":"text","text":" "},{"type":"text","text":"if 4 or more days of that week are contained within the new year."}],"type":"paragraph"}]}],"metadata":{"extendedModule":"GLib","externalID":"s:4GLib16DateTimeProtocolPAAE13getWeekOfYearSiyF","fragments":[{"text":"func","kind":"keyword"},{"kind":"text","text":" "},{"kind":"identifier","text":"getWeekOfYear"},{"text":"() -> ","kind":"text"},{"text":"Int","kind":"typeIdentifier","preciseIdentifier":"s:Si"}],"role":"symbol","symbolKind":"method","modules":[{"name":"GLib"}],"roleHeading":"Instance Method","title":"getWeekOfYear()"},"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/glib\/datetimeprotocol\/getweekofyear()"]}],"identifier":{"url":"doc:\/\/GLib\/documentation\/GLib\/DateTimeProtocol\/getWeekOfYear()","interfaceLanguage":"swift"},"hierarchy":{"paths":[["doc:\/\/GLib\/documentation\/GLib","doc:\/\/GLib\/documentation\/GLib\/DateTimeProtocol"]]},"sections":[],"kind":"symbol","abstract":[{"text":"Returns the ISO 8601 week number for the week containing ","type":"text"},{"type":"codeVoice","code":"datetime"},{"text":".","type":"text"},{"text":" ","type":"text"},{"text":"The ISO 8601 week number is the same for every day of the week (from","type":"text"},{"text":" ","type":"text"},{"text":"Moday through Sunday).  That can produce some unusual results","type":"text"},{"type":"text","text":" "},{"type":"text","text":"(described below)."}],"schemaVersion":{"major":0,"minor":3,"patch":0},"references":{"doc://GLib/documentation/GLib/DateTimeProtocol/getWeekOfYear()":{"fragments":[{"kind":"keyword","text":"func"},{"kind":"text","text":" "},{"text":"getWeekOfYear","kind":"identifier"},{"kind":"text","text":"() -> "},{"preciseIdentifier":"s:Si","text":"Int","kind":"typeIdentifier"}],"kind":"symbol","type":"topic","url":"\/documentation\/glib\/datetimeprotocol\/getweekofyear()","abstract":[{"type":"text","text":"Returns the ISO 8601 week number for the week containing "},{"type":"codeVoice","code":"datetime"},{"text":".","type":"text"},{"type":"text","text":" "},{"type":"text","text":"The ISO 8601 week number is the same for every day of the week (from"},{"type":"text","text":" "},{"type":"text","text":"Moday through Sunday).  That can produce some unusual results"},{"text":" ","type":"text"},{"type":"text","text":"(described below)."}],"role":"symbol","title":"getWeekOfYear()","identifier":"doc:\/\/GLib\/documentation\/GLib\/DateTimeProtocol\/getWeekOfYear()"},"doc://GLib/documentation/GLib/DateTimeProtocol":{"url":"\/documentation\/glib\/datetimeprotocol","role":"symbol","abstract":[{"type":"c