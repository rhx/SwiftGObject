{"schemaVersion":{"minor":3,"patch":0,"major":0},"abstract":[{"text":"Creates a newly allocated string representing the requested ","type":"text"},{"code":"format","type":"codeVoice"},{"type":"text","text":"."}],"hierarchy":{"paths":[["doc:\/\/GLib\/documentation\/GLib","doc:\/\/GLib\/documentation\/GLib\/DateTimeProtocol"]]},"identifier":{"url":"doc:\/\/GLib\/documentation\/GLib\/DateTimeProtocol\/format(format:)","interfaceLanguage":"swift"},"primaryContentSections":[{"kind":"declarations","declarations":[{"platforms":["macOS"],"languages":["swift"],"tokens":[{"kind":"keyword","text":"func"},{"text":" ","kind":"text"},{"text":"format","kind":"identifier"},{"text":"(","kind":"text"},{"kind":"externalParam","text":"format"},{"kind":"text","text":": "},{"preciseIdentifier":"s:SP","text":"UnsafePointer","kind":"typeIdentifier"},{"kind":"text","text":"<"},{"preciseIdentifier":"c:@T@gchar","text":"gchar","kind":"typeIdentifier"},{"text":">!) -> ","kind":"text"},{"text":"String","preciseIdentifier":"s:SS","kind":"typeIdentifier"},{"text":"!","kind":"text"}]}]},{"content":[{"anchor":"discussion","type":"heading","level":2,"text":"Discussion"},{"type":"paragraph","inlineContent":[{"type":"text","text":"The format strings understood by this function are a subset of the"},{"type":"text","text":" "},{"code":"strftime()","type":"codeVoice"},{"type":"text","text":" format language as specified by C99.  The "},{"type":"codeVoice","code":"D"},{"text":", ","type":"text"},{"code":"U","type":"codeVoice"},{"type":"text","text":" and "},{"type":"codeVoice","code":"W"},{"type":"text","text":" "},{"type":"text","text":"conversions are not supported, nor is the "},{"type":"codeVoice","code":"E"},{"text":" modifier.  The GNU","type":"text"},{"text":" ","type":"text"},{"type":"text","text":"extensions "},{"type":"codeVoice","code":"k"},{"text":", ","type":"text"},{"code":"l","type":"codeVoice"},{"text":", ","type":"text"},{"type":"codeVoice","code":"s"},{"text":" and ","type":"text"},{"type":"codeVoice","code":"P"},{"text":" are supported, however, as are the","type":"text"},{"type":"text","text":" "},{"type":"codeVoice","code":"0"},{"text":", ","type":"text"},{"type":"codeVoice","code":"_"},{"type":"text","text":" and "},{"code":"-","type":"codeVoice"},{"text":" modifiers. The Python extension ","type":"text"},{"type":"codeVoice","code":"f"},{"text":" is also supported.","type":"text"}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"In contrast to "},{"code":"strftime()","type":"codeVoice"},{"type":"text","text":", this function always produces a UTF-8"},{"text":" ","type":"text"},{"type":"text","text":"string, regardless of the current locale.  Note that the rendering of"},{"text":" ","type":"text"},{"text":"many formats is locale-dependent and may not match the ","type":"text"},{"type":"codeVoice","code":"strftime()"},{"type":"text","text":" "},{"type":"text","text":"output exactly."}]},{"inlineContent":[{"text":"The following format specifiers are supported:","type":"text"}],"type":"paragraph"},{"type":"unorderedList","items":[{"content":[{"inlineContent":[{"code":"a","type":"codeVoice"},{"text":": the abbreviated weekday name according to the current locale","type":"text"}],"type":"paragraph"}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"A"},{"type":"text","text":": the full weekday name according to the current locale"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"b"},{"type":"text","text":": the abbreviated month name according to the current locale"}]}]},{"content":[{"inlineContent":[{"type":"codeVoice","code":"B"},{"text":": the full month name according to the current locale","type":"text"}],"type":"paragraph"}]},{"content":[{"type":"paragraph","inlineContent":[{"code":"c","type":"codeVoice"},{"text":": the preferred date and time representation for the current locale","type":"text"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"code":"C","type":"codeVoice"},{"type":"text","text":": the century number (year\/100) as a 2-digit integer (00-99)"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"d"},{"text":": the day of the month as a decimal number (range 01 to 31)","type":"text"}]}]},{"content":[{"inlineContent":[{"identifier":"doc:\/\/GLib\/documentation\/GLib\/e-3m6a4","isActive":true,"type":"reference"},{"text":": the day of the month as a decimal number (range 1 to 31);","type":"text"},{"type":"text","text":" "},{"type":"text","text":"single digits are preceded by a figure space (U+2007)"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"code":"F","type":"codeVoice"},{"type":"text","text":": equivalent to "},{"code":"Y-","type":"codeVoice"},{"type":"text","text":"m-"},{"type":"codeVoice","code":"d"},{"text":" (the ISO 8601 date format)","type":"text"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"code":"g","type":"codeVoice"},{"type":"text","text":": the last two digits of the ISO 8601 week-based year as a"},{"type":"text","text":" "},{"text":"decimal number (00-99). This works well with ","type":"text"},{"type":"codeVoice","code":"V"},{"type":"text","text":" and "},{"code":"u","type":"codeVoice"},{"text":".","type":"text"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"type":"codeVoice","code":"G"},{"type":"text","text":": the ISO 8601 week-based year as a decimal number. This works"},{"type":"text","text":" "},{"text":"well with ","type":"text"},{"type":"codeVoice","code":"V"},{"type":"text","text":" and "},{"code":"u","type":"codeVoice"},{"text":".","type":"text"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"type":"codeVoice","code":"h"},{"type":"text","text":": equivalent to "},{"type":"codeVoice","code":"b"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"code":"H","type":"codeVoice"},{"type":"text","text":": the hour as a decimal number using a 24-hour clock (range 00 to 23)"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"type":"codeVoice","code":"I"},{"type":"text","text":": the hour as a decimal number using a 12-hour clock (range 01 to 12)"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"code":"j","type":"codeVoice"},{"type":"text","text":": the day of the year as a decimal number (range 001 to 366)"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"code":"k","type":"codeVoice"},{"type":"text","text":": the hour (24-hour clock) as a decimal number (range 0 to 23);"},{"text":" ","type":"text"},{"type":"text","text":"single digits are preceded by a figure space (U+2007)"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"code":"l","type":"codeVoice"},{"text":": the hour (12-hour clock) as a decimal number (range 1 to 12);","type":"text"},{"text":" ","type":"text"},{"text":"single digits are preceded by a figure space (U+2007)","type":"text"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"code":"m","type":"codeVoice"},{"text":": the month as a decimal number (range 01 to 12)","type":"text"}],"type":"paragraph"}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"M"},{"type":"text","text":": the minute as a decimal number (range 00 to 59)"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"code":"f","type":"codeVoice"},{"type":"text","text":": the microsecond as a decimal number (range 000000 to 999999)"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"code":"p","type":"codeVoice"},{"text":": either ‘AM’ or ‘PM’ according to the given time value, or the","type":"text"},{"type":"text","text":" "},{"type":"text","text":"corresponding  strings for the current locale.  Noon is treated as"},{"type":"text","text":" "},{"type":"text","text":"‘PM’ and midnight as ‘AM’. Use of this format specifier is discouraged, as"},{"type":"text","text":" "},{"text":"many locales have no concept of AM\/PM formatting. Use ","type":"text"},{"type":"codeVoice","code":"c"},{"text":" or ","type":"text"},{"type":"codeVoice","code":"X"},{"type":"text","text":" instead."}]}]},{"content":[{"type":"paragraph","inlineContent":[{"code":"P","type":"codeVoice"},{"type":"text","text":": like "},{"code":"p","type":"codeVoice"},{"type":"text","text":" but lowercase: ‘am’ or ‘pm’ or a corresponding string for"},{"text":" ","type":"text"},{"type":"text","text":"the current locale. Use of this format specifier is discouraged, as"},{"text":" ","type":"text"},{"text":"many locales have no concept of AM\/PM formatting. Use ","type":"text"},{"type":"codeVoice","code":"c"},{"type":"text","text":" or "},{"type":"codeVoice","code":"X"},{"type":"text","text":" instead."}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"r"},{"type":"text","text":": the time in a.m. or p.m. notation. Use of this format specifier is"},{"text":" ","type":"text"},{"text":"discouraged, as many locales have no concept of AM\/PM formatting. Use ","type":"text"},{"type":"codeVoice","code":"c"},{"type":"text","text":" "},{"type":"text","text":"or "},{"type":"codeVoice","code":"X"},{"type":"text","text":" instead."}]}]},{"content":[{"type":"paragraph","inlineContent":[{"code":"R","type":"codeVoice"},{"type":"text","text":": the time in 24-hour notation ("},{"type":"codeVoice","code":"H:"},{"type":"text","text":"M``)"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"s"},{"text":": the number of seconds since the Epoch, that is, since 1970-01-01","type":"text"},{"type":"text","text":" "},{"type":"text","text":"00:00:00 UTC"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"code":"S","type":"codeVoice"},{"text":": the second as a decimal number (range 00 to 60)","type":"text"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"code":"t","type":"codeVoice"},{"text":": a tab character","type":"text"}]}]},{"content":[{"inlineContent":[{"code":"T","type":"codeVoice"},{"text":": the time in 24-hour notation with seconds (","type":"text"},{"type":"codeVoice","code":"H:"},{"text":"M:","type":"text"},{"type":"codeVoice","code":"S"},{"text":")","type":"text"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"type":"codeVoice","code":"u"},{"type":"text","text":": the ISO 8601 standard day of the week as a decimal, range 1 to 7,"},{"text":" ","type":"text"},{"type":"text","text":"Monday being 1. This works well with "},{"code":"G","type":"codeVoice"},{"type":"text","text":" and "},{"type":"codeVoice","code":"V"},{"type":"text","text":"."}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"type":"codeVoice","code":"V"},{"text":": the ISO 8601 standard week number of the current year as a decimal","type":"text"},{"type":"text","text":" "},{"type":"text","text":"number, range 01 to 53, where week 1 is the first week that has at"},{"type":"text","text":" "},{"text":"least 4 days in the new year. See ","type":"text"},{"code":"g_date_time_get_week_of_year()","type":"codeVoice"},{"text":".","type":"text"},{"type":"text","text":" "},{"text":"This works well with ","type":"text"},{"code":"G","type":"codeVoice"},{"type":"text","text":" and "},{"code":"u","type":"codeVoice"},{"type":"text","text":"."}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"type":"codeVoice","code":"w"},{"text":": the day of the week as a decimal, range 0 to 6, Sunday being 0.","type":"text"},{"type":"text","text":" "},{"type":"text","text":"This is not the ISO 8601 standard format — use "},{"type":"codeVoice","code":"u"},{"text":" instead.","type":"text"}],"type":"paragraph"}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"x"},{"text":": the preferred date representation for the current locale without","type":"text"},{"type":"text","text":" "},{"text":"the time","type":"text"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"code":"X","type":"codeVoice"},{"type":"text","text":": the preferred time representation for the current locale without"},{"type":"text","text":" "},{"text":"the date","type":"text"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"code":"y","type":"codeVoice"},{"text":": the year as a decimal number without the century","type":"text"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"code":"Y","type":"codeVoice"},{"type":"text","text":": the year as a decimal number including the century"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"code":"z","type":"codeVoice"},{"type":"text","text":": the time zone as an offset from UTC ("},{"type":"codeVoice","code":"+hhmm"},{"type":"text","text":")"}]}]},{"content":[{"inlineContent":[{"type":"codeVoice","code":":z"},{"type":"text","text":": the time zone as an offset from UTC ("},{"code":"+hh:mm","type":"codeVoice"},{"text":").","type":"text"},{"type":"text","text":" "},{"type":"text","text":"This is a gnulib "},{"type":"codeVoice","code":"strftime()"},{"type":"text","text":" extension. Since: 2.38"}],"type":"paragraph"}]},{"content":[{"type":"paragraph","inlineContent":[{"code":"::z","type":"codeVoice"},{"type":"text","text":": the time zone as an offset from UTC ("},{"type":"codeVoice","code":"+hh:mm:ss"},{"type":"text","text":"). This is a"},{"text":" ","type":"text"},{"type":"text","text":"gnulib "},{"type":"codeVoice","code":"strftime()"},{"type":"text","text":" extension. Since: 2.38"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"code":":::z","type":"codeVoice"},{"type":"text","text":": the time zone as an offset from UTC, with "},{"code":":","type":"codeVoice"},{"text":" to necessary","type":"text"},{"type":"text","text":" "},{"text":"precision (e.g., ","type":"text"},{"code":"-04","type":"codeVoice"},{"type":"text","text":", "},{"code":"+05:30","type":"codeVoice"},{"type":"text","text":"). This is a gnulib "},{"code":"strftime()","type":"codeVoice"},{"text":" extension. Since: 2.38","type":"text"}]}]},{"content":[{"inlineContent":[{"code":"Z","type":"codeVoice"},{"type":"text","text":": the time zone or name or abbreviation"}],"type":"paragraph"}]},{"content":[{"type":"paragraph","inlineContent":[{"text":"``````: a literal ```` character","type":"text"}]}]}]},{"inlineContent":[{"type":"text","text":"Some conversion specifications can be modified by preceding the"},{"text":" ","type":"text"},{"type":"text","text":"conversion specifier by one or more modifier characters."}],"type":"paragraph"},{"type":"paragraph","inlineContent":[{"text":"The following modifiers are supported for many of the numeric","type":"text"},{"text":" ","type":"text"},{"type":"text","text":"conversions:"}]},{"type":"unorderedList","items":[{"content":[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"O"},{"type":"text","text":": Use alternative numeric symbols, if the current locale supports those."}]}]},{"content":[{"type":"paragraph","inlineContent":[{"code":"_","type":"codeVoice"},{"text":": Pad a numeric result with spaces. This overrides the default padding","type":"text"},{"text":" ","type":"text"},{"type":"text","text":"for the specifier."}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"-"},{"type":"text","text":": Do not pad a numeric result. This overrides the default padding"},{"type":"text","text":" "},{"type":"text","text":"for the specifier."}]}]},{"content":[{"inlineContent":[{"code":"0","type":"codeVoice"},{"type":"text","text":": Pad a numeric result with zeros. This overrides the default padding"},{"type":"text","text":" "},{"type":"text","text":"for the specifier."}],"type":"paragraph"}]}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"The following modifiers are supported for many of the alphabetic conversions:"}]},{"type":"unorderedList","items":[{"content":[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"^"},{"text":": Use upper case if possible. This is a gnulib ","type":"text"},{"code":"strftime()","type":"codeVoice"},{"text":" extension.","type":"text"},{"text":" ","type":"text"},{"text":"Since: 2.80","type":"text"}]}]},{"content":[{"inlineContent":[{"code":"#","type":"codeVoice"},{"type":"text","text":": Use opposite case if possible. This is a gnulib "},{"code":"strftime()","type":"codeVoice"},{"type":"text","text":" "},{"text":"extension. Since: 2.80","type":"text"}],"type":"paragraph"}]}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"Additionally, when "},{"type":"codeVoice","code":"O"},{"text":" is used with ","type":"text"},{"code":"B","type":"codeVoice"},{"text":", ","type":"text"},{"type":"codeVoice","code":"b"},{"type":"text","text":", or "},{"code":"h","type":"codeVoice"},{"text":", it produces the alternative","type":"text"},{"type":"text","text":" "},{"type":"text","text":"form of a month name. The alternative form should be used when the month"},{"type":"text","text":" "},{"type":"text","text":"name is used without a day number (e.g., standalone). It is required in"},{"text":" ","type":"text"},{"type":"text","text":"some languages (Baltic, Slavic, Greek, and more) due to their grammatical"},{"text":" ","type":"text"},{"text":"rules. For other languages there is no difference. ","type":"text"},{"type":"codeVoice","code":"OB"},{"type":"text","text":" is a GNU and BSD"},{"text":" ","type":"text"},{"code":"strftime()","type":"codeVoice"},{"type":"text","text":" extension expected to be added to the future POSIX specification,"},{"type":"text","text":" "},{"type":"codeVoice","code":"Ob"},{"type":"text","text":" and "},{"type":"codeVoice","code":"Oh"},{"text":" are GNU ","type":"text"},{"type":"codeVoice","code":"strftime()"},{"type":"text","text":" extensions. Since: 2.56"}]},{"inlineContent":[{"text":"Since GLib 2.80, when ","type":"text"},{"type":"codeVoice","code":"E"},{"text":" is used with ","type":"text"},{"type":"codeVoice","code":"c"},{"type":"text","text":", "},{"type":"codeVoice","code":"C"},{"text":", ","type":"text"},{"type":"codeVoice","code":"x"},{"type":"text","text":", "},{"type":"codeVoice","code":"X"},{"text":", ","type":"text"},{"type":"codeVoice","code":"y"},{"text":" or ","type":"text"},{"type":"codeVoice","code":"Y"},{"type":"text","text":","},{"type":"text","text":" "},{"type":"text","text":"the date is formatted using an alternate era representation specific to the"},{"text":" ","type":"text"},{"text":"locale. This is typically used for the Thai solar calendar or Japanese era","type":"text"},{"text":" ","type":"text"},{"type":"text","text":"names, for example."}],"type":"paragraph"},{"items":[{"content":[{"type":"paragraph","inlineContent":[{"code":"Ec","type":"codeVoice"},{"type":"text","text":": the preferred date and time representation for the current locale,"},{"text":" ","type":"text"},{"type":"text","text":"using the alternate era representation"}]}]},{"content":[{"inlineContent":[{"code":"EC","type":"codeVoice"},{"text":": the name of the era","type":"text"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"type":"codeVoice","code":"Ex"},{"type":"text","text":": the preferred date representation for the current locale without"},{"text":" ","type":"text"},{"text":"the time, using the alternate era representation","type":"text"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"code":"EX","type":"codeVoice"},{"text":": the preferred time representation for the current locale without","type":"text"},{"text":" ","type":"text"},{"type":"text","text":"the date, using the alternate era representation"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"code":"Ey","type":"codeVoice"},{"text":": the year since the beginning of the era denoted by the ","type":"text"},{"code":"EC","type":"codeVoice"},{"type":"text","text":" "},{"text":"specifier","type":"text"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"type":"codeVoice","code":"EY"},{"text":": the full alternative year representation","type":"text"}],"type":"paragraph"}]}],"type":"unorderedList"}],"kind":"content"}],"sections":[],"variants":[{"paths":["\/documentation\/glib\/datetimeprotocol\/format(format:)"],"traits":[{"interfaceLanguage":"swift"}]}],"metadata":{"externalID":"s:4GLib16DateT