{"kind":"symbol","abstract":[{"type":"text","text":"Returns the ISO 8601 week-numbering year in which the week containing"},{"text":" ","type":"text"},{"code":"datetime","type":"codeVoice"},{"type":"text","text":" falls."}],"sections":[],"identifier":{"interfaceLanguage":"swift","url":"doc:\/\/GLib\/documentation\/GLib\/DateTimeProtocol\/getWeekNumberingYear()"},"metadata":{"extendedModule":"GLib","symbolKind":"method","role":"symbol","roleHeading":"Instance Method","title":"getWeekNumberingYear()","externalID":"s:4GLib16DateTimeProtocolPAAE20getWeekNumberingYearSiyF","modules":[{"name":"GLib"}],"fragments":[{"text":"func","kind":"keyword"},{"text":" ","kind":"text"},{"kind":"identifier","text":"getWeekNumberingYear"},{"kind":"text","text":"() -> "},{"kind":"typeIdentifier","text":"Int","preciseIdentifier":"s:Si"}]},"variants":[{"paths":["\/documentation\/glib\/datetimeprotocol\/getweeknumberingyear()"],"traits":[{"interfaceLanguage":"swift"}]}],"primaryContentSections":[{"kind":"declarations","declarations":[{"languages":["swift"],"tokens":[{"kind":"keyword","text":"func"},{"text":" ","kind":"text"},{"kind":"identifier","text":"getWeekNumberingYear"},{"text":"() -> ","kind":"text"},{"text":"Int","kind":"typeIdentifier","preciseIdentifier":"s:Si"}],"platforms":["macOS"]}]},{"kind":"content","content":[{"level":2,"type":"heading","text":"Discussion","anchor":"discussion"},{"inlineContent":[{"type":"text","text":"This function, taken together with "},{"type":"codeVoice","code":"g_date_time_get_week_of_year()"},{"type":"text","text":" and"},{"text":" ","type":"text"},{"code":"g_date_time_get_day_of_week()","type":"codeVoice"},{"type":"text","text":" can be used to determine the full ISO"},{"text":" ","type":"text"},{"text":"week date on which ","type":"text"},{"type":"codeVoice","code":"datetime"},{"text":" falls.","type":"text"}],"type":"paragraph"},{"type":"paragraph","inlineContent":[{"type":"text","text":"This is usually equal to the normal Gregorian year (as returned by"},{"text":" ","type":"text"},{"type":"codeVoice","code":"g_date_time_get_year()"},{"text":"), except as detailed below:","type":"text"}]},{"inlineContent":[{"type":"text","text":"For Thursday, the week-numbering year is always equal to the usual"},{"type":"text","text":" "},{"type":"text","text":"calendar year.  For other days, the number is such that every day"},{"text":" ","type":"text"},{"text":"within a complete week (Monday to Sunday) is contained within the","type":"text"},{"type":"text","text":" "},{"type":"text","text":"same week-numbering year."}],"type":"paragraph"},{"type":"paragraph","inlineContent":[{"type":"text","text":"For Monday, Tuesday and Wednesday occurring near the end of the year,"},{"type":"text","text":" "},{"text":"this may mean that the week-numbering year is one greater than the","type":"text"},{"type":"text","text":" "},{"text":"calendar year (so that these days have the same week-numbering year","type":"text"},{"type":"text","text":" "},{"type":"text","text":"as the Thursday occurring early in the next year)."}]},{"inlineContent":[{"text":"For Friday, Saturday and Sunday occurring near the start of the year,","type":"text"},{"type":"text","text":" "},{"text":"this may mean that the week-numbering year is one less than the","type":"text"},{"type":"text","text":" "},{"type":"text","text":"calendar year (so that these days have the same week-numbering year"},{"type":"text","text":" "},{"type":"text","text":"as the Thursday occurring late in the previous year)."}],"type":"paragraph"},{"type":"paragraph","inlineContent":[{"type":"text","text":"An equivalent description is that the week-numbering year is equal to"},{"type":"text","text":" "},{"type":"text","text":"the calendar year containing the majority of the days in the current"},{"type":"text","text":" "},{"type":"text","text":"week (Monday to Sunday)."}]},{"inlineContent":[{"text":"Note that January 1 0001 in the proleptic Gregorian calendar is a","type":"text"},{"type":"text","text":" "},{"type":"text","text":"Monday, so this function never returns 0."}],"type":"paragraph"}]}],"hierarchy":{"paths":[["doc:\/\/GLib\/documentation\/GLib","doc:\/\/GLib\/documentation\/GLib\/DateTimeProtocol"]]},"schemaVersion":{"major":0,"patch":0,"minor":3},"references":{"doc://GLib/documentation/GLib/DateTimeProtocol":{"url":"\/documentation\/glib\/datetimeprotocol","role":"symbol","abstract":[{"type":"codeVoice","code":"GDateTime"},{"text":" is a structure that combines a Gregorian date and time","type":"text"},{"text":" ","type":"text"},{"type":"text","text":"into a single structure."}],"title":"DateTimeProtocol","fragments":[{"kind":"keyword","text":"protocol"},{"text":" ","kind":"text"},{"text":"DateTimeProtocol","kind":"identifier"}],"kind":"symbol","type":"topic","identifier":"doc:\/\/GLib\/documentation\/GLib\/DateTimeProtocol","navigatorTitle":[{"text":"DateTimeProtocol","kind":"identifier"}]},"doc://GLib/documentation/GLib/DateTimeProtocol/getWeekNumberingYear()":{"fragments":[{"kind":"keyword","text":"func"},{"text":" ","kind":"text"},{"kind":"identifier","text":"getWeekNumberingYear"},{"kind":"text","text":"() -> "},{"text":"Int","kind":"typeIdentifier","preciseIdentifier":"s:Si"}],"kind":"symbol","url":"\/documentation\/glib\/datetimeprotocol\/getweeknumberingyear()","type":"topic","abstract":[{"text":"Returns the ISO 8601 week-numbering year in which the week containing","type":"text"},{"text":" ","type":"text"},{"type":"codeVoice","code":"datetime"},{"text":" falls.","type":"text"}],"role":"symbol","title":"getWeekNumberingYear()","identifier":"doc:\/\/GLib\/documentation\/GLib\/DateTimeProtocol\/getWeekNumberingYear()"},"doc://GLib/documentation/GLib":{"identifier":"doc:\/\/GLib\/documentation\/GLib","title":"GLib","abstract":[],"type":"topic","url":"\/documentation\/glib","kind":"symbol","role":"collection"}}}