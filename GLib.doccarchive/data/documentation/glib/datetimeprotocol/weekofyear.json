{"schemaVersion":{"major":0,"patch":0,"minor":3},"hierarchy":{"paths":[["doc:\/\/GLib\/documentation\/GLib","doc:\/\/GLib\/documentation\/GLib\/DateTimeProtocol"]]},"abstract":[{"text":"Returns the ISO 8601 week number for the week containing ","type":"text"},{"type":"codeVoice","code":"datetime"},{"type":"text","text":"."},{"type":"text","text":" "},{"text":"The ISO 8601 week number is the same for every day of the week (from","type":"text"},{"type":"text","text":" "},{"type":"text","text":"Moday through Sunday).  That can produce some unusual results"},{"type":"text","text":" "},{"text":"(described below).","type":"text"}],"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/glib\/datetimeprotocol\/weekofyear"]}],"kind":"symbol","sections":[],"metadata":{"modules":[{"name":"GLib"}],"fragments":[{"text":"var","kind":"keyword"},{"kind":"text","text":" "},{"text":"weekOfYear","kind":"identifier"},{"text":": ","kind":"text"},{"text":"Int","kind":"typeIdentifier","preciseIdentifier":"s:Si"}],"role":"symbol","symbolKind":"property","roleHeading":"Instance Property","title":"weekOfYear","externalID":"s:4GLib16DateTimeProtocolPAAE10weekOfYearSivp","extendedModule":"GLib"},"identifier":{"url":"doc:\/\/GLib\/documentation\/GLib\/DateTimeProtocol\/weekOfYear","interfaceLanguage":"swift"},"primaryContentSections":[{"declarations":[{"platforms":["macOS"],"tokens":[{"kind":"keyword","text":"var"},{"text":" ","kind":"text"},{"kind":"identifier","text":"weekOfYear"},{"kind":"text","text":": "},{"kind":"typeIdentifier","text":"Int","preciseIdentifier":"s:Si"},{"text":" { ","kind":"text"},{"kind":"keyword","text":"get"},{"kind":"text","text":" }"}],"languages":["swift"]}],"kind":"declarations"},{"kind":"content","content":[{"level":2,"text":"Discussion","type":"heading","anchor":"discussion"},{"inlineContent":[{"text":"The first week of the year is week 1.  This is the week that contains","type":"text"},{"text":" ","type":"text"},{"type":"text","text":"the first Thursday of the year.  Equivalently, this is the first week"},{"text":" ","type":"text"},{"text":"that has more than 4 of its days falling within the calendar year.","type":"text"}],"type":"paragraph"},{"inlineContent":[{"text":"The value 0 is never returned by this function.  Days contained","type":"text"},{"text":" ","type":"text"},{"type":"text","text":"within a year but occurring before the first ISO 8601 week of that"},{"type":"text","text":" "},{"type":"text","text":"year are considered as being contained in the last week of the"},{"text":" ","type":"text"},{"text":"previous year.  Similarly, the final days of a calendar year may be","type":"text"},{"text":" ","type":"text"},{"text":"considered as being part of the first ISO 8601 week of the next year","type":"text"},{"type":"text","text":" "},{"text":"if 4 or more days of that week are contained within the new year.","type":"text"}],"type":"paragraph"}]}],"references":{"doc://GLib/documentation/GLib/DateTimeProtocol":{"url":"\/documentation\/glib\/datetimeprotocol","role":"symbol","abstract":[{"type":"codeVoice","code":"GDateTime"},{"text":" is a structure that combines a Gregorian date and time","type":"text"},{"text":" ","type":"text"},{"type":"text","text":"into a single structure."}],"title":"DateTimeProtocol","fragments":[{"kind":"keyword","text":"protocol"},{"text":" ","kind":"text"},{"text":"DateTimeProtocol","kind":"identifier"}],"kind":"symbol","type":"topic","identifier":"doc:\/\/GLib\/documentation\/GLib\/DateTimeProtocol","navigatorTitle":[{"text":"DateTimeProtocol","kind":"identifier"}]},"doc://GLib/documentation/GLib":{"identifier":"doc:\/\/GLib\/documentation\/GLib","title":"GLib","abstract":[],"type":"topic","url":"\/documentation\/glib","kind":"symbol","role":"collection"},"doc://GLib/documentation/GLib/DateTimeProtocol/weekOfYear":{"fragments":[{"kind":"keyword","text":"var"},{"text":" ","kind":"text"},{"kind":"identifier","text":"weekOfYear"},{"kind":"text","text":": "},{"preciseIdentifier":"s:Si","kind":"typeIdentifier","text":"Int"}],"kind":"symbol","type":"topic","url":"\/documentation\/glib\/datetimeprotocol\/weekofyear","abstract":[{"type":"text","text":"Returns the ISO 8601 week number for the week containing "},{"type":"codeVoice","code":"datetime"},{"type":"text","text":"."},{"text":" ","type":"text"},{"text":"The ISO 8601 week number is the same for every day of the week (from","type":"text"},{"type":"text","text":" "},{"type":"text","text":"Moday through Sunday).  That can produce some unusual results"},{"text":" ","type":"text"},{"type":"text","text":"(described below)."}],"role":"symbol","title":"weekOfYear","identifier":"doc:\/\/GLib\/documentation\/GLib\/DateTimeProtocol\/weekOfYear"}}}