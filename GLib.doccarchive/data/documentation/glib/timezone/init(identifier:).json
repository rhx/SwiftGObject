{"schemaVersion":{"major":0,"minor":3,"patch":0},"hierarchy":{"paths":[["doc:\/\/GLib\/documentation\/GLib","doc:\/\/GLib\/documentation\/GLib\/TimeZone"]]},"sections":[],"metadata":{"title":"init(identifier:)","symbolKind":"init","roleHeading":"Initializer","fragments":[{"kind":"identifier","text":"init"},{"kind":"text","text":"("},{"kind":"externalParam","text":"identifier"},{"kind":"text","text":": "},{"kind":"typeIdentifier","text":"UnsafePointer","preciseIdentifier":"s:SP"},{"kind":"text","text":"<"},{"kind":"typeIdentifier","text":"gchar","preciseIdentifier":"c:@T@gchar"},{"text":">?)","kind":"text"}],"role":"symbol","externalID":"s:4GLib8TimeZoneC10identifierACSPys4Int8VGSg_tcfc","modules":[{"name":"GLib"}]},"variants":[{"paths":["\/documentation\/glib\/timezone\/init(identifier:)"],"traits":[{"interfaceLanguage":"swift"}]}],"identifier":{"url":"doc:\/\/GLib\/documentation\/GLib\/TimeZone\/init(identifier:)","interfaceLanguage":"swift"},"kind":"symbol","primaryContentSections":[{"declarations":[{"languages":["swift"],"platforms":["macOS"],"tokens":[{"text":"init","kind":"keyword"},{"text":"(","kind":"text"},{"kind":"externalParam","text":"identifier"},{"kind":"text","text":": "},{"preciseIdentifier":"s:SP","kind":"typeIdentifier","text":"UnsafePointer"},{"kind":"text","text":"<"},{"text":"gchar","kind":"typeIdentifier","preciseIdentifier":"c:@T@gchar"},{"text":">? = nil)","kind":"text"}]}],"kind":"declarations"},{"kind":"content","content":[{"type":"heading","anchor":"discussion","text":"Discussion","level":2},{"type":"paragraph","inlineContent":[{"code":"identifier","type":"codeVoice"},{"type":"text","text":" can either be an RFC3339\/ISO 8601 time offset or"},{"type":"text","text":" "},{"text":"something that would pass as a valid value for the ","type":"text"},{"type":"codeVoice","code":"TZ"},{"text":" environment","type":"text"},{"text":" ","type":"text"},{"text":"variable (including ","type":"text"},{"code":"nil","type":"codeVoice"},{"text":").","type":"text"}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"In Windows, "},{"type":"codeVoice","code":"identifier"},{"type":"text","text":" can also be the unlocalized name of a time"},{"text":" ","type":"text"},{"text":"zone for standard time, for example “Pacific Standard Time”.","type":"text"}]},{"inlineContent":[{"type":"text","text":"Valid RFC3339 time offsets are "},{"type":"codeVoice","code":"\"Z\""},{"type":"text","text":" (for UTC) or"},{"type":"text","text":" "},{"code":"\"±hh:mm\"","type":"codeVoice"},{"text":".  ISO 8601 additionally specifies","type":"text"},{"text":" ","type":"text"},{"code":"\"±hhmm\"","type":"codeVoice"},{"text":" and ","type":"text"},{"code":"\"±hh\"","type":"codeVoice"},{"type":"text","text":".  Offsets are"},{"text":" ","type":"text"},{"text":"time values to be added to Coordinated Universal Time (UTC) to get","type":"text"},{"type":"text","text":" "},{"type":"text","text":"the local time."}],"type":"paragraph"},{"type":"paragraph","inlineContent":[{"type":"text","text":"In UNIX, the "},{"type":"codeVoice","code":"TZ"},{"text":" environment variable typically corresponds","type":"text"},{"text":" ","type":"text"},{"text":"to the name of a file in the zoneinfo database, an absolute path to a file","type":"text"},{"text":" ","type":"text"},{"text":"somewhere else, or a string in","type":"text"},{"text":" ","type":"text"},{"text":"“std offset [dst [offset],start[\/time],end[\/time]]” (POSIX) format.","type":"text"},{"text":" ","type":"text"},{"type":"text","text":"There  are  no spaces in the specification. The name of standard"},{"text":" ","type":"text"},{"type":"text","text":"and daylight savings time zone must be three or more alphabetic"},{"type":"text","text":" "},{"text":"characters. Offsets are time values to be added to local time to","type":"text"},{"text":" ","type":"text"},{"text":"get Coordinated Universal Time (UTC) and should be","type":"text"},{"type":"text","text":" "},{"code":"\"[±]hh[[:]mm[:ss]]\"","type":"codeVoice"},{"text":".  Dates are either","type":"text"},{"text":" ","type":"text"},{"code":"\"Jn\"","type":"codeVoice"},{"type":"text","text":" (Julian day with n between 1 and 365, leap"},{"text":" ","type":"text"},{"text":"years not counted), ","type":"text"},{"code":"\"n\"","type":"codeVoice"},{"text":" (zero-based Julian day","type":"text"},{"text":" ","type":"text"},{"text":"with n between 0 and 365) or ","type":"text"},{"type":"codeVoice","code":"\"Mm.w.d\""},{"text":" (day d","type":"text"},{"type":"text","text":" "},{"type":"text","text":"(0 <= d <= 6) of week w (1 <= w <= 5) of month m (1 <= m <= 12), day"},{"type":"text","text":" "},{"type":"text","text":"0 is a Sunday).  Times are in local wall clock time, the default is"},{"text":" ","type":"text"},{"text":"02:00:00.","type":"text"}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"In Windows, the “tzn[+|–]hh"},{"isActive":true,"type":"reference","identifier":"#dzn"},{"type":"text","text":"” format is used, but also"},{"text":" ","type":"text"},{"type":"text","text":"accepts POSIX format.  The Windows format uses US rules for all time"},{"text":" ","type":"text"},{"text":"zones; daylight savings time is 60 minutes behind the standard time","type":"text"},{"text":" ","type":"text"},{"text":"with date and time of change taken from Pacific Standard Time.","type":"text"},{"text":" ","type":"text"},{"type":"text","text":"Offsets are time values to be added to the local time to get"},{"text":" ","type":"text"},{"type":"text","text":"Coordinated Universal Time (UTC)."}]},{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"g_time_zone_new_local()"},{"text":" calls this function with the value of the","type":"text"},{"type":"text","text":" "},{"type":"codeVoice","code":"TZ"},{"text":" environment variable. This function itself is independent of","type":"text"},{"text":" ","type":"text"},{"type":"text","text":"the value of "},{"code":"TZ","type":"codeVoice"},{"type":"text","text":", but if "},{"type":"codeVoice","code":"identifier"},{"type":"text","text":" is "},{"code":"nil","type":"codeVoice"},{"text":" then ","type":"text"},{"type":"codeVoice","code":"\/etc\/localtime"},{"type":"text","text":" "},{"type":"text","text":"will be consulted to discover the correct time zone on UNIX and the"},{"type":"text","text":" "},{"type":"text","text":"registry will be consulted or "},{"code":"GetTimeZoneInformation()","type":"codeVoice"},{"text":" will be used","type":"text"},{"text":" ","type":"text"},{"text":"to get the local time zone on Windows.","type":"text"}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"If intervals are not available, only time zone rules from "},{"type":"codeVoice","code":"TZ"},{"text":" ","type":"text"},{"text":"environment variable or other means, then they will be computed","type":"text"},{"type":"text","text":" "},{"type":"text","text":"from year 1900 to 2037.  If the maximum year for the rules is"},{"type":"text","text":" "},{"type":"text","text":"available and it is greater than 2037, then it will followed"},{"text":" ","type":"text"},{"text":"instead.","type":"text"}]},{"inlineContent":[{"type":"text","text":"See"},{"type":"text","text":" "},{"identifier":"http:\/\/tools.ietf.org\/html\/rfc3339#section-5.6","isActive":true,"type":"reference"},{"type":"text","text":" "},{"text":"for a precise definition of valid RFC3339 time offsets","type":"text"},{"type":"text","text":" "},{"type":"text","text":"(the "},{"type":"codeVoice","code":"time-offset"},{"text":" expansion) and ISO 8601 for the","type":"text"},{"type":"text","text":" "},{"type":"text","text":"full list of valid time offsets.  See"},{"type":"text","text":" "},{"isActive":true,"type":"reference","identifier":"http:\/\/www.gnu.org\/s\/libc\/manual\/html_node\/TZ-Variable.html"},{"type":"text","text":" "},{"text":"for an explanation of the possible","type":"text"},{"text":" ","type":"text"},{"text":"values of the ","type":"text"},{"code":"TZ","type":"codeVoice"},{"type":"text","text":" environment variable. See"},{"text":" ","type":"text"},{"type":"reference","identifier":"http:\/\/msdn.microsoft.com\/en-us\/library\/ms912391%28v=winembedded.11%29.aspx","isActive":true},{"text":" ","type":"text"},{"type":"text","text":"for the list of time zones on Windows."}],"type":"paragraph"},{"inlineContent":[{"text":"You should release the return value by calling ","type":"text"},{"type":"codeVoice","code":"g_time_zone_unref()"},{"text":" ","type":"text"},{"type":"text","text":"when you are done with it."}],"type":"paragraph"}]}],"abstract":[{"text":"Creates a ","type":"text"},{"type":"reference","isActive":true,"identifier":"doc:\/\/GLib\/documentation\/GLib\/TimeZone"},{"text":" corresponding to ","type":"text"},{"type":"codeVoice","code":"identifier"},{"type":"text","text":". If "},{"type":"codeVoice","code":"identifier"},{"type":"text","text":" cannot be"},{"text":" ","type":"text"},{"type":"text","text":"parsed or loaded, "},{"code":"nil","type":"codeVoice"},{"text":" is returned.","type":"text"}],"references":{"http://msdn.microsoft.com/en-us/library/ms912391%28v=winembedded.11%29.aspx":{"identifier":"http:\/\/msdn.microsoft.com\/en-us\/library\/ms912391%28v=winembedded.11%29.aspx","title":"Microsoft Time Zone Index Values","titleInlineContent":[{"type":"text","text":"Microsoft Time Zone Index Values"}],"type":"link","url":"http:\/\/msdn.microsoft.com\/en-us\/library\/ms912391%28v=winembedded.11%29.aspx"},"doc://GLib/documentation/GLib/TimeZone":{"navigatorTitle":[{"text":"TimeZone","kind":"identifier"}],"kind":"symbol","abstract":[{"type":"text","text":"A "},{"code":"GTimeZone","type":"codeVoice"},{"text":" represents a time zone, at no particular point in time.","type":"text"}],"identifier":"doc:\/\/GLib\/documentation\/GLib\/TimeZone","title":"TimeZone","fragments":[{"text":"class","kind":"keyword"},{"kind":"text","text":" "},{"text":"TimeZone","kind":"identifier"}],"url":"\/documentation\/glib\/timezone","role":"symbol","type":"topic"},"http://tools.ietf.org/html/rfc3339#section-5.6":{"identifier":"http:\/\/tools.ietf.org\/html\/rfc3339#section-5.6","title":"RFC3339 §5.6","titleInlineContent":[{"type":"text","text":"RFC3339 §5.6"}],"type":"link","url":"http:\/\/tools.ietf.org\/html\/rfc3339#section-5.6"},"doc://GLib/documentation/GLib/TimeZone/init(identifier:)":{"title":"init(identifier:)","kind":"symbol","role":"symbol","fragments":[{"text":"init","kind":"identifier"},{"text":"(","kind":"text"},{"text":"identifier","kind":"externalParam"},{"text":": ","kind":"text"},{"kind":"typeIdentifier","text":"UnsafePointer","preciseIdentifier":"s:SP"},{"kind":"text","text":"<"},{"text":"gchar","kind":"typeIdentifier","preciseIdentifier":"c:@T@gchar"},{"kind":"text","text":">?)"}],"type":"topic","abstract":[{"type":"text","text":"Creates a "},{"type":"reference","isActive":true,"identifier":"doc:\/\/GLib\/documentation\/GLib\/TimeZone"},{"type":"text","text":" corresponding to "},{"type":"codeVoice","code":"identifier"},{"text":". If ","type":"text"},{"code":"identifier","type":"codeVoice"},{"type":"text","text":" cannot be"},{"type":"text","text":" "},{"type":"text","text":"parsed or loaded, "},{"code":"nil","type":"codeVoice"},{"text":" is returned.","type":"text"}],"url":"\/documentation\/glib\/timezone\/init(identifier:)","identifier":"doc:\/\/GLib\/documentation\/GLib\/TimeZone\/init(identifier:)"},"doc://GLib/documentation/GLib":{"identifier":"doc:\/\/GLib\/documentation\/GLib","title":"GLib","abstract":[],"type":"topic","url":"\/documentation\/glib","kind":"symbol","role":"collection"},"#dzn":{"identifier":"#dzn","title":":mm[:ss]","titleInlineContent":[{"type":"text","text":":mm[:ss]"}],"type":"link","url":"#dzn"},"http://www.gnu.org/s/libc/manual/html_node/TZ-Variable.html":{"identifier":"http:\/\/www.gnu.org\/s\/libc\/manual\/html_node\/TZ-Variable.html","title":"The GNU C Library manual","titleInlineContent":[{"type":"text","text":"The GNU C Library manual"}],"type":"link","url":