{"kind":"symbol","hierarchy":{"paths":[["doc:\/\/GLib\/documentation\/GLib","doc:\/\/GLib\/documentation\/GLib\/TimeZone"]]},"sections":[],"metadata":{"title":"new(identifier:)","role":"symbol","symbolKind":"method","modules":[{"name":"GLib"}],"fragments":[{"text":"static","kind":"keyword"},{"kind":"text","text":" "},{"kind":"keyword","text":"func"},{"kind":"text","text":" "},{"text":"new","kind":"identifier"},{"text":"(","kind":"text"},{"text":"identifier","kind":"externalParam"},{"text":": ","kind":"text"},{"kind":"typeIdentifier","preciseIdentifier":"s:SP","text":"UnsafePointer"},{"text":"<","kind":"text"},{"preciseIdentifier":"c:@T@gchar","text":"gchar","kind":"typeIdentifier"},{"kind":"text","text":">?) -> "},{"text":"TimeZone","kind":"typeIdentifier","preciseIdentifier":"s:4GLib8TimeZoneC"},{"kind":"text","text":"!"}],"roleHeading":"Type Method","externalID":"s:4GLib8TimeZoneC3new10identifierACSgSPys4Int8VGSg_tFZ"},"identifier":{"url":"doc:\/\/GLib\/documentation\/GLib\/TimeZone\/new(identifier:)","interfaceLanguage":"swift"},"variants":[{"paths":["\/documentation\/glib\/timezone\/new(identifier:)"],"traits":[{"interfaceLanguage":"swift"}]}],"primaryContentSections":[{"kind":"declarations","declarations":[{"languages":["swift"],"tokens":[{"text":"static","kind":"keyword"},{"text":" ","kind":"text"},{"kind":"keyword","text":"func"},{"kind":"text","text":" "},{"text":"new","kind":"identifier"},{"kind":"text","text":"("},{"text":"identifier","kind":"externalParam"},{"kind":"text","text":": "},{"preciseIdentifier":"s:SP","text":"UnsafePointer","kind":"typeIdentifier"},{"text":"<","kind":"text"},{"text":"gchar","preciseIdentifier":"c:@T@gchar","kind":"typeIdentifier"},{"text":">? = nil) -> ","kind":"text"},{"kind":"typeIdentifier","identifier":"doc:\/\/GLib\/documentation\/GLib\/TimeZone","text":"TimeZone","preciseIdentifier":"s:4GLib8TimeZoneC"},{"kind":"text","text":"!"}],"platforms":["macOS"]}]},{"content":[{"text":"Discussion","anchor":"discussion","level":2,"type":"heading"},{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"identifier"},{"type":"text","text":" can either be an RFC3339\/ISO 8601 time offset or"},{"type":"text","text":" "},{"text":"something that would pass as a valid value for the ","type":"text"},{"code":"TZ","type":"codeVoice"},{"type":"text","text":" environment"},{"text":" ","type":"text"},{"type":"text","text":"variable (including "},{"type":"codeVoice","code":"nil"},{"type":"text","text":")."}]},{"type":"paragraph","inlineContent":[{"text":"In Windows, ","type":"text"},{"type":"codeVoice","code":"identifier"},{"text":" can also be the unlocalized name of a time","type":"text"},{"type":"text","text":" "},{"type":"text","text":"zone for standard time, for example “Pacific Standard Time”."}]},{"inlineContent":[{"type":"text","text":"Valid RFC3339 time offsets are "},{"code":"\"Z\"","type":"codeVoice"},{"type":"text","text":" (for UTC) or"},{"type":"text","text":" "},{"type":"codeVoice","code":"\"±hh:mm\""},{"text":".  ISO 8601 additionally specifies","type":"text"},{"type":"text","text":" "},{"type":"codeVoice","code":"\"±hhmm\""},{"type":"text","text":" and "},{"type":"codeVoice","code":"\"±hh\""},{"type":"text","text":".  Offsets are"},{"text":" ","type":"text"},{"type":"text","text":"time values to be added to Coordinated Universal Time (UTC) to get"},{"text":" ","type":"text"},{"type":"text","text":"the local time."}],"type":"paragraph"},{"type":"paragraph","inlineContent":[{"text":"In UNIX, the ","type":"text"},{"code":"TZ","type":"codeVoice"},{"type":"text","text":" environment variable typically corresponds"},{"type":"text","text":" "},{"type":"text","text":"to the name of a file in the zoneinfo database, an absolute path to a file"},{"type":"text","text":" "},{"text":"somewhere else, or a string in","type":"text"},{"text":" ","type":"text"},{"text":"“std offset [dst [offset],start[\/time],end[\/time]]” (POSIX) format.","type":"text"},{"type":"text","text":" "},{"type":"text","text":"There  are  no spaces in the specification. The name of standard"},{"type":"text","text":" "},{"type":"text","text":"and daylight savings time zone must be three or more alphabetic"},{"text":" ","type":"text"},{"type":"text","text":"characters. Offsets are time values to be added to local time to"},{"text":" ","type":"text"},{"text":"get Coordinated Universal Time (UTC) and should be","type":"text"},{"text":" ","type":"text"},{"type":"codeVoice","code":"\"[±]hh[[:]mm[:ss]]\""},{"text":".  Dates are either","type":"text"},{"text":" ","type":"text"},{"type":"codeVoice","code":"\"Jn\""},{"type":"text","text":" (Julian day with n between 1 and 365, leap"},{"text":" ","type":"text"},{"type":"text","text":"years not counted), "},{"type":"codeVoice","code":"\"n\""},{"type":"text","text":" (zero-based Julian day"},{"type":"text","text":" "},{"text":"with n between 0 and 365) or ","type":"text"},{"type":"codeVoice","code":"\"Mm.w.d\""},{"type":"text","text":" (day d"},{"type":"text","text":" "},{"text":"(0 <= d <= 6) of week w (1 <= w <= 5) of month m (1 <= m <= 12), day","type":"text"},{"text":" ","type":"text"},{"text":"0 is a Sunday).  Times are in local wall clock time, the default is","type":"text"},{"type":"text","text":" "},{"type":"text","text":"02:00:00."}]},{"inlineContent":[{"text":"In Windows, the “tzn[+|–]hh","type":"text"},{"isActive":true,"type":"reference","identifier":"#dzn"},{"text":"” format is used, but also","type":"text"},{"type":"text","text":" "},{"text":"accepts POSIX format.  The Windows format uses US rules for all time","type":"text"},{"type":"text","text":" "},{"text":"zones; daylight savings time is 60 minutes behind the standard time","type":"text"},{"type":"text","text":" "},{"type":"text","text":"with date and time of change taken from Pacific Standard Time."},{"type":"text","text":" "},{"text":"Offsets are time values to be added to the local time to get","type":"text"},{"type":"text","text":" "},{"type":"text","text":"Coordinated Universal Time (UTC)."}],"type":"paragraph"},{"type":"paragraph","inlineContent":[{"code":"g_time_zone_new_local()","type":"codeVoice"},{"text":" calls this function with the value of the","type":"text"},{"type":"text","text":" "},{"code":"TZ","type":"codeVoice"},{"type":"text","text":" environment variable. This function itself is independent of"},{"text":" ","type":"text"},{"type":"text","text":"the value of "},{"type":"codeVoice","code":"TZ"},{"text":", but if ","type":"text"},{"code":"identifier","type":"codeVoice"},{"text":" is ","type":"text"},{"code":"nil","type":"codeVoice"},{"type":"text","text":" then "},{"type":"codeVoice","code":"\/etc\/localtime"},{"type":"text","text":" "},{"type":"text","text":"will be consulted to discover the correct time zone on UNIX and the"},{"type":"text","text":" "},{"type":"text","text":"registry will be consulted or "},{"code":"GetTimeZoneInformation()","type":"codeVoice"},{"type":"text","text":" will be used"},{"type":"text","text":" "},{"text":"to get the local time zone on Windows.","type":"text"}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"If intervals are not available, only time zone rules from "},{"type":"codeVoice","code":"TZ"},{"type":"text","text":" "},{"text":"environment variable or other means, then they will be computed","type":"text"},{"text":" ","type":"text"},{"text":"from year 1900 to 2037.  If the maximum year for the rules is","type":"text"},{"type":"text","text":" "},{"type":"text","text":"available and it is greater than 2037, then it will followed"},{"text":" ","type":"text"},{"text":"instead.","type":"text"}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"See"},{"text":" ","type":"text"},{"identifier":"http:\/\/tools.ietf.org\/html\/rfc3339#section-5.6","isActive":true,"type":"reference"},{"type":"text","text":" "},{"type":"text","text":"for a precise definition of valid RFC3339 time offsets"},{"text":" ","type":"text"},{"text":"(the ","type":"text"},{"type":"codeVoice","code":"time-offset"},{"type":"text","text":" expansion) and ISO 8601 for the"},{"type":"text","text":" "},{"text":"full list of valid time offsets.  See","type":"text"},{"text":" ","type":"text"},{"isActive":true,"type":"reference","identifier":"http:\/\/www.gnu.org\/s\/libc\/manual\/html_node\/TZ-Variable.html"},{"text":" ","type":"text"},{"text":"for an explanation of the possible","type":"text"},{"type":"text","text":" "},{"type":"text","text":"values of the "},{"code":"TZ","type":"codeVoice"},{"type":"text","text":" environment variable. See"},{"text":" ","type":"text"},{"identifier":"http:\/\/msdn.microsoft.com\/en-us\/library\/ms912391%28v=winembedded.11%29.aspx","type":"reference","isActive":true},{"type":"text","text":" "},{"text":"for the list of time zones on Windows.","type":"text"}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"You should release the return value by calling "},{"type":"codeVoice","code":"g_time_zone_unref()"},{"type":"text","text":" "},{"type":"text","text":"when you are done with it."}]}],"kind":"content"}],"schemaVersion":{"patch":0,"minor":3,"major":0},"abstract":[{"text":"Creates a ","type":"text"},{"isActive":true,"type":"reference","identifier":"doc:\/\/GLib\/documentation\/GLib\/TimeZone"},{"type":"text","text":" corresponding to "},{"code":"identifier","type":"codeVoice"},{"type":"text","text":". If "},{"type":"codeVoice","code":"identifier"},{"text":" cannot be","type":"text"},{"type":"text","text":" "},{"text":"parsed or loaded, ","type":"text"},{"code":"nil","type":"codeVoice"},{"type":"text","text":" is returned."}],"references":{"#dzn":{"type":"link","title":":mm[:ss]","identifier":"#dzn","titleInlineContent":[{"text":":mm[:ss]","type":"text"}],"url":"#dzn"},"http://www.gnu.org/s/libc/manual/html_node/TZ-Variable.html":{"type":"link","title":"The GNU C Library manual","identifier":"http:\/\/www.gnu.org\/s\/libc\/manual\/html_node\/TZ-Variable.html","titleInlineContent":[{"text":"The GNU C Library manual","type":"text"}],"url":"http:\/\/www.gnu.org\/s\/libc\/manual\/html_node\/TZ-Variable.html"},"http://msdn.microsoft.com/en-us/library/ms912391%28v=winembedded.11%29.aspx":{"type":"link","title":"Microsoft Time Zone Index Values","identifier":"http:\/\/msdn.microsoft.com\/en-us\/library\/ms912391%28v=winembedded.11%29.aspx","titleInlineContent":[{"type":"text","text":"Microsoft Time Zone Index Values"}],"url":"http:\/\/msdn.microsoft.com\/en-us\/library\/ms912391%28v=winembedded.11%29.aspx"},"http://tools.ietf.org/html/rfc3339#section-5.6":{"type":"link","title":"RFC3339 §5.6","identifier":"http:\/\/tools.ietf.org\/html\/rfc3339#section-5.6","titleInlineContent":[{"text":"RFC3339 §5.6","type":"text"}],"url":"http:\/\/tools.ietf.org\/html\/rfc3339#section-5.6"},"doc://GLib/documentation/GLib/TimeZone":{"navigatorTitle":[{"text":"TimeZone","kind":"identifier"}],"kind":"symbol","abstract":[{"type":"text","text":"A "},{"code":"GTimeZone","type":"codeVoice"},{"text":" represents a time zone, at no particular point in time.","type":"text"}],"identifier":"doc:\/\/GLib\/documentation\/GLib\/TimeZone","title":"TimeZone","fragments":[{"text":"class","kind":"keyword"},{"kind":"text","text":" "},{"text":"TimeZone","kind":"identifier"}],"url":"\/documentation\/glib\/timezone","role":"symbol","type":"topic"},"doc://GLib/documentation/GLib/TimeZone/new(identifier:)":{"title":"new(identifier:)","role":"symbol","kind":"symbol","identifier":"doc:\/\/GLib\/documentation\/GLib\/TimeZone\/new(identifier:)","url":"\/documentation\/glib\/timezone\/new(identifier:)","fragments":[{"text":"static","kind":"keyword"},{"text":" ","kind":"text"},{"kind":"keyword","text":"func"},{"text":" ","kind":"text"},{"kind":"identifier","text":"new"},{"kind":"text","text":"("},{"text":"identifier","kind":"externalParam"},{"text":": ","kind":"text"},{"text":"UnsafePointer","kind":"typeIdentifier","preciseIdentifier":"s:SP"},{"kind":"text","text":"<"},{"text":"gchar","kind":"typeIdentifier","preciseIdentifier":"c:@T@gchar"},{"text":">?) -> ","kind":"text"},{"text":"TimeZone","kind":"typeIdentifier","preciseIdentifier":"s:4GLib8TimeZoneC"},{"text":"!","kind":"text"}],"type":"topic","abstract":[{"text":"Creates a ","type":"text"},{"isActive":true,"type":"reference","identifier":"doc:\/\/GLib\/documentation\/GLib\/TimeZone"},{"type":"text","text":" corresponding to "},{"type":"codeVoice","code":"identifier"},{"type":"text","text":". If "},{"type":"codeVoice","code":"identifier"},{"type":"text","text":" cannot be"},{"text":" ","type":"text"},{"type":"text","text":"parsed or loaded, "},{"code":"nil","type":"codeVoice"},{"text":" is returned.","type":"text"}]},"doc://GLib/documentation/GLib":{"identifier":"doc:\/\/GLib\/documentation\/GLib","title":"GLib","abstract":[],"type":"topic","url":"\/documentation\/glib","kind":"symbol","role":"collection"}}}