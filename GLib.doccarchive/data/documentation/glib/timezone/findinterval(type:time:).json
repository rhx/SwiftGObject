,{"content":[{"level":2,"text":"Discussion","type":"heading","anchor":"discussion"},{"type":"paragraph","inlineContent":[{"text":"If ","type":"text"},{"code":"type","type":"codeVoice"},{"text":" is ","type":"text"},{"type":"codeVoice","code":"universal"},{"type":"text","text":" then this function will always"},{"text":" ","type":"text"},{"type":"text","text":"succeed (since universal time is monotonic and continuous)."}]},{"inlineContent":[{"type":"text","text":"Otherwise "},{"type":"codeVoice","code":"time"},{"type":"text","text":" is treated as local time.  The distinction between"},{"text":" ","type":"text"},{"code":"standard","type":"codeVoice"},{"text":" and ","type":"text"},{"type":"codeVoice","code":"daylight"},{"type":"text","text":" is ignored except in"},{"type":"text","text":" "},{"text":"the case that the given ","type":"text"},{"type":"codeVoice","code":"time"},{"type":"text","text":" is ambiguous.  In Toronto, for example,"},{"text":" ","type":"text"},{"text":"01:30 on November 7th 2010 occurred twice (once inside of daylight","type":"text"},{"text":" ","type":"text"},{"type":"text","text":"savings time and the next, an hour later, outside of daylight savings"},{"text":" ","type":"text"},{"text":"time).  In this case, the different value of ","type":"text"},{"type":"codeVoice","code":"type"},{"text":" would result in a","type":"text"},{"text":" ","type":"text"},{"text":"different interval being returned.","type":"text"}],"type":"paragraph"},{"type":"paragraph","inlineContent":[{"type":"text","text":"It is still possible for this function to fail.  In Toronto, for"},{"type":"text","text":" "},{"text":"example, 02:00 on March 14th 2010 does not exist (due to the leap","type":"text"},{"type":"text","text":" "},{"type":"text","text":"forward to begin daylight savings time).  -1 is returned in that"},{"type":"text","text":" "},{"type":"text","text":"case."}]}],"kind":"content"}],"variants":[{"paths":["\/documentation\/glib\/timezone\/findinterval(type:time: