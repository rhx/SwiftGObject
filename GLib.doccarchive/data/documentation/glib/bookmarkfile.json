{"primaryContentSections":[{"kind":"declarations","declarations":[{"languages":["swift"],"tokens":[{"kind":"keyword","text":"class"},{"kind":"text","text":" "},{"kind":"identifier","text":"BookmarkFile"}],"platforms":["macOS"]}]},{"content":[{"text":"Overview","anchor":"overview","type":"heading","level":2},{"inlineContent":[{"type":"text","text":"Bookmarks refer to a URI, along with some meta-data about the resource"},{"type":"text","text":" "},{"text":"pointed by the URI like its MIME type, the application that is registering","type":"text"},{"text":" ","type":"text"},{"type":"text","text":"the bookmark and the icon that should be used to represent the bookmark."},{"type":"text","text":" "},{"text":"The data is stored using the","type":"text"},{"text":" ","type":"text"},{"isActive":true,"identifier":"https:\/\/www.freedesktop.org\/wiki\/Specifications\/desktop-bookmark-spec\/","type":"reference"},{"type":"text","text":"."}],"type":"paragraph"},{"type":"paragraph","inlineContent":[{"type":"text","text":"The syntax of the bookmark files is described in detail inside the"},{"type":"text","text":" "},{"text":"Desktop Bookmark Specification, here is a quick summary: bookmark","type":"text"},{"text":" ","type":"text"},{"text":"files use a sub-class of the XML Bookmark Exchange Language","type":"text"},{"text":" ","type":"text"},{"text":"specification, consisting of valid UTF-8 encoded XML, under the","type":"text"},{"text":" ","type":"text"},{"type":"codeVoice","code":"<xbel>"},{"text":" root element; each bookmark is stored inside a","type":"text"},{"type":"text","text":" "},{"type":"codeVoice","code":"<bookmark>"},{"type":"text","text":" element, using its URI: no relative paths can"},{"type":"text","text":" "},{"type":"text","text":"be used inside a bookmark file. The bookmark may have a user defined"},{"text":" ","type":"text"},{"type":"text","text":"title and description, to be used instead of the URI. Under the"},{"text":" ","type":"text"},{"type":"codeVoice","code":"<metadata>"},{"type":"text","text":" element, with its owner attribute set to"},{"type":"text","text":" "},{"code":"http:\/\/freedesktop.org","type":"codeVoice"},{"text":", is stored the meta-data about a resource","type":"text"},{"text":" ","type":"text"},{"type":"text","text":"pointed by its URI. The meta-data consists of the resource’s MIME"},{"type":"text","text":" "},{"type":"text","text":"type; the applications that have registered a bookmark; the groups"},{"type":"text","text":" "},{"text":"to which a bookmark belongs to; a visibility flag, used to set the","type":"text"},{"type":"text","text":" "},{"text":"bookmark as “private” to the applications and groups that has it","type":"text"},{"type":"text","text":" "},{"text":"registered; the URI and MIME type of an icon, to be used when","type":"text"},{"type":"text","text":" "},{"type":"text","text":"displaying the bookmark inside a GUI."}]},{"inlineContent":[{"text":"Here is an example of a bookmark file:","type":"text"},{"type":"text","text":" "},{"identifier":"https:\/\/gitlab.gnome.org\/GNOME\/glib\/-\/blob\/HEAD\/glib\/tests\/bookmarks.xbel","isActive":true,"type":"reference"}],"type":"paragraph"},{"type":"paragraph","inlineContent":[{"text":"A bookmark file might contain more than one bookmark; each bookmark","type":"text"},{"text":" ","type":"text"},{"type":"text","text":"is accessed through its URI."}]},{"inlineContent":[{"type":"text","text":"The important caveat of bookmark files is that when you add a new"},{"text":" ","type":"text"},{"text":"bookmark you must also add the application that is registering it, using","type":"text"},{"text":" ","type":"text"},{"text":"[method","type":"text"},{"type":"codeVoice","code":"GLib.BookmarkFile.add_application"},{"text":"] or [method","type":"text"},{"code":"GLib.BookmarkFile.set_application_info","type":"codeVoice"},{"type":"text","text":"]."},{"type":"text","text":" "},{"text":"If a bookmark has no applications then it won’t be dumped when creating","type":"text"},{"text":" ","type":"text"},{"type":"text","text":"the on disk representation, using [method"},{"code":"GLib.BookmarkFile.to_data","type":"codeVoice"},{"text":"] or","type":"text"},{"text":" ","type":"text"},{"type":"text","text":"[method"},{"code":"GLib.BookmarkFile.to_file","type":"codeVoice"},{"text":"].","type":"text"}],"type":"paragraph"},{"inlineContent":[{"text":"The ","type":"text"},{"isActive":true,"identifier":"doc:\/\/GLib\/documentation\/GLib\/BookmarkFile","type":"reference"},{"type":"text","text":" type acts as an owner of an underlying "},{"type":"codeVoice","code":"GBookmarkFile"},{"text":" instance.","type":"text"},{"text":" ","type":"text"},{"type":"text","text":"It provides the methods that can operate on this data type through "},{"type":"reference","identifier":"doc:\/\/GLib\/documentation\/GLib\/BookmarkFileProtocol","isActive":true},{"text":" conformance.","type":"text"},{"type":"text","text":" "},{"text":"Use ","type":"text"},{"identifier":"doc:\/\/GLib\/documentation\/GLib\/BookmarkFile","isActive":true,"type":"reference"},{"type":"text","text":" as a strong reference or owner of a "},{"type":"codeVoice","code":"GBookmarkFile"},{"type":"text","text":" instance."}],"type":"paragraph"},{"style":"note","type":"aside","name":"Note","content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"Use "},{"type":"reference","identifier":"doc:\/\/GLib\/documentation\/GLib\/BookmarkFileRef","isActive":true},{"text":" (instead of ","type":"text"},{"isActive":true,"type":"reference","identifier":"doc:\/\/GLib\/documentation\/GLib\/BookmarkFile"},{"type":"text","text":") for a lightweight Swift reference to an underlying "},{"code":"GBookmarkFile","type":"codeVoice"},{"type":"text","text":" instance."}]}]}],"kind":"content"}],"schemaVersion":{"patch":0,"minor":3,"major":0},"metadata":{"modules":[{"name":"GLib"}],"fragments":[{"kind":"keyword","text":"class"},{"text":" ","kind":"text"},{"text":"BookmarkFile","kind":"identifier"}],"role":"s