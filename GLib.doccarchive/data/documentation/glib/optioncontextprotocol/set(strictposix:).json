{"schemaVersion":{"major":0,"patch":0,"minor":3},"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/glib\/optioncontextprotocol\/set(strictposix:)"]}],"metadata":{"fragments":[{"kind":"keyword","text":"func"},{"text":" ","kind":"text"},{"kind":"identifier","text":"set"},{"kind":"text","text":"("},{"kind":"externalParam","text":"strictPosix"},{"text":": ","kind":"text"},{"kind":"typeIdentifier","text":"Bool","preciseIdentifier":"s:Sb"},{"text":")","kind":"text"}],"modules":[{"name":"GLib"}],"externalID":"s:4GLib21OptionContextProtocolPAAE3set11strictPosixySb_tF","symbolKind":"method","roleHeading":"Instance Method","role":"symbol","title":"set(strictPosix:)","extendedModule":"GLib"},"kind":"symbol","primaryContentSections":[{"kind":"declarations","declarations":[{"languages":["swift"],"platforms":["macOS"],"tokens":[{"text":"func","kind":"keyword"},{"text":" ","kind":"text"},{"text":"set","kind":"identifier"},{"kind":"text","text":"("},{"text":"strictPosix","kind":"externalParam"},{"kind":"text","text":": "},{"text":"Bool","kind":"typeIdentifier","preciseIdentifier":"s:Sb"},{"text":")","kind":"text"}]}]},{"kind":"content","content":[{"text":"Discussion","type":"heading","anchor":"discussion","level":2},{"type":"paragraph","inlineContent":[{"text":"By default, this mode is disabled.","type":"text"}]},{"inlineContent":[{"text":"In strict POSIX mode, the first non-argument parameter encountered","type":"text"},{"type":"text","text":" "},{"type":"text","text":"(eg: filename) terminates argument processing.  Remaining arguments"},{"text":" ","type":"text"},{"text":"are treated as non-options and are not attempted to be parsed.","type":"text"}],"type":"paragraph"},{"type":"paragraph","inlineContent":[{"text":"If strict POSIX mode is disabled then parsing is done in the GNU way","type":"text"},{"text":" ","type":"text"},{"type":"text","text":"where option arguments can be freely mixed with non-options."}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"As an example, consider “ls foo -l”.  With GNU style parsing, this"},{"type":"text","text":" "},{"text":"will list “foo” in long mode.  In strict POSIX style, this will list","type":"text"},{"type":"text","text":" "},{"text":"the files named “foo” and “-l”.","type":"text"}]},{"inlineContent":[{"type":"text","text":"It may be useful to force strict POSIX mode when creating “verb"},{"text":" ","type":"text"},{"text":"style” command line tools.  For example, the “gsettings” command line","type":"text"},{"type":"text","text":" "},{"text":"tool supports the global option “–schemadir” as well as many","type":"text"},{"text":" ","type":"text"},{"text":"subcommands (“get”, “set”, etc.) which each have their own set of","type":"text"},{"text":" ","type":"text"},{"type":"text","text":"arguments.  Using strict POSIX mode will allow parsing the global"},{"type":"text","text":" "},{"type":"text","text":"options up to the verb name while leaving the remaining options to be"},{"type":"text","text":" "},{"text":"parsed by the relevant subcommand (which can be determined by","type":"text"},{"type":"text","text":" "},{"type":"text","text":"examining the verb name, which should be present in argv[1] after"},{"type":"text","text":" "},{"text":"parsing).","type":"text"}],"type":"paragraph"}]}],"sections":[],"hierarchy":{"paths":[["doc:\/\/GLib\/documentation\/GLib","doc:\/\/GLib\/documentation\/GLib\/OptionContextProtocol"]]},"identifier":{"url":"doc:\/\/GLib\/documentation\/GLib\/OptionContextProtocol\/set(strictPosix:)","interfaceLanguage":"swift"},"abstract":[{"type":"text","text":"Sets strict POSIX mode."}],"references":{"doc://GLib/documentation/GLib/OptionContextProtocol":{"abstract":[{"text":"A ","type":"text"},{"type":"codeVoice","code":"GOptionContext"},{"type":"text","text":" struct defines which options"},{"text":" ","type":"text"},{"type":"text","text":"are accepted by the commandline option parser. The struct has only private"},{"text":" ","type":"text"},{"type":"text","text":"fields and should not be directly accessed."}],"url":"\/documentation\/glib\/optioncontextprotocol","title":"OptionContextProtocol","identifier":"doc:\/\/GLib\/documentation\/GLib\/OptionContextProtocol","fragments":[{"kind":"keyword","text":"protocol"},{"text":" ","kind":"text"},{"text":"OptionContextProtocol","kind":"identifier"}],"role":"symbol","navigatorTitle":[{"kind":"identifier","text":"OptionContextProtocol"}],"kind":"symbol","type":"topic"},"doc://GLib/documentation/GLib/OptionContextProtocol/set(strictPosix:)":{"kind":"symbol","role":"symbol","fragments":[{"text":"func","kind":"keyword"},{"text":" ","kind":"text"},{"kind":"identifier","text":"set"},{"kind":"text","text":"("},{"text":"strictPosix","kind":"externalParam"},{"text":": ","kind":"text"},{"kind":"typeIdentifier","text":"Bool","preciseIdentifier":"s:Sb"},{"text":")","kind":"text"}],"identifier":"doc:\/\/GLib\/documentation\/GLib\/OptionContextProtocol\/set(strictPosix:)","abstract":[{"type":"text","text":"Sets strict POSIX mode."}],"url":"\/documentation\/glib\/optioncontextprotocol\/set(strictposix:)","title":"set(strictPosix:)","type":"topic"},"doc://GLib/documentation/GLib":{"identifier":"doc:\/\/GLib\/documentation\/GLib","title":"GLib","abstract":[],"type":"topic","url":"\/documentation\/glib","kind":"symbol","role":"collection"}}}