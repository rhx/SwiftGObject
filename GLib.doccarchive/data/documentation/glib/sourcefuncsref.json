{"schemaVersion":{"minor":3,"major":0,"patch":0},"identifier":{"url":"doc:\/\/GLib\/documentation\/GLib\/SourceFuncsRef","interfaceLanguage":"swift"},"primaryContentSections":[{"kind":"declarations","declarations":[{"platforms":["macOS"],"languages":["swift"],"tokens":[{"text":"struct","kind":"keyword"},{"kind":"text","text":" "},{"kind":"identifier","text":"SourceFuncsRef"}]}]},{"content":[{"anchor":"overview","type":"heading","level":2,"text":"Overview"},{"inlineContent":[{"type":"text","text":"For idle sources, the prepare and check functions always return "},{"code":"true","type":"codeVoice"},{"text":" ","type":"text"},{"text":"to indicate that the source is always ready to be processed. The prepare","type":"text"},{"type":"text","text":" "},{"type":"text","text":"function also returns a timeout value of 0 to ensure that the "},{"code":"poll()","type":"codeVoice"},{"type":"text","text":" call"},{"type":"text","text":" "},{"type":"text","text":"doesn’t block (since that would be time wasted which could have been spent"},{"type":"text","text":" "},{"type":"text","text":"running the idle function)."}],"type":"paragraph"},{"type":"paragraph","inlineContent":[{"text":"For timeout sources, the prepare and check functions both return ","type":"text"},{"type":"codeVoice","code":"true"},{"type":"text","text":" "},{"type":"text","text":"if the timeout interval has expired. The prepare function also returns"},{"text":" ","type":"text"},{"type":"text","text":"a timeout value to ensure that the "},{"type":"codeVoice","code":"poll()"},{"type":"text","text":" call doesn’t block too long"},{"text":" ","type":"text"},{"type":"text","text":"and miss the next timeout."}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"For file descriptor sources, the prepare function typically returns "},{"code":"false","type":"codeVoice"},{"type":"text","text":","},{"type":"text","text":" "},{"text":"since it must wait until ","type":"text"},{"type":"codeVoice","code":"poll()"},{"text":" has been called before it knows whether","type":"text"},{"text":" ","type":"text"},{"text":"any events need to be processed. It sets the returned timeout to -1 to","type":"text"},{"type":"text","text":" "},{"type":"text","text":"indicate that it doesn’t mind how long the "},{"type":"codeVoice","code":"poll()"},{"type":"text","text":" call blocks. In the"},{"type":"text","text":" "},{"type":"text","text":"check function, it tests the results of the "},{"type":"codeVoice","code":"poll()"},{"text":" call to see if the","type":"text"},{"text":" ","type":"text"},{"text":"required condition has been met, and returns ","type":"text"},{"code":"true","type":"codeVoice"},{"text":" if so.","type":"text"}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"The "},{"type":"reference","identifier":"doc:\/\/GLib\/documentation\/GLib\/SourceFuncsRef","isActive":true},{"type":"text","text":" type acts as a lightweight Swift reference to an underlying "},{"code":"GSourceFuncs","type":"codeVoice"},{"text":" instance.","type":"text"},{"type":"text","text":" "},{"text":"It exposes methods that can operate on this data type through ","type":"text"},{"type":"reference","isActive":true,"identifier":"doc:\/\/GLib\/documentation\/GLib\/SourceFuncsProtocol"},{"text":" conformance.","type":"text"},{"text":" ","type":"text"},{"type":"text","text":"Use "},{"type":"reference","identifier":"doc:\/\/GLib\/documentation\/GLib\/SourceFuncsRef","isActive":true},{"text":" only as an ","type":"text"},{"type":"codeVoice","code":"unowned"},{"type":"text","text":" reference to an existing "},{"type":"codeVoice","code":"GSourceFuncs"},{"type":"text","text":" instance."}]},{"content":[{"inlineContent":[{"text":"Use ","type":"text"},{"identifier":"doc:\/\/GLib\/documentation\/GLib\/SourceFuncs","isActive":true,"type":"reference"},{"type":"text","text":" (instead of "},{"type":"reference","isActive":true,"identifier":"doc:\/\/GLib\/documentation\/GLib\/SourceFuncsRef"},{"type":"text","text":") if you want to use Automatic Reference Counting for memory management of the underlying "},{"code":"GSourceFuncs","type":"codeVoice"},{"text":" instance.","type":"text"}],"type":"paragraph"}],"type":"aside","name":"Note","style":"note"}],"kind":"content"}],"hierarchy":{"paths":[["doc:\/\/GLib\/documentation\/GLib"]]},"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/glib\/sourcefuncsref"]}],"kind":"symbol","sections":[],"topicSections":[{"anchor":"Initializers","generated":true,"title":"Initializers","identifiers":["doc:\/\/GLib\/documentation\/GLib\/SourceFuncsRef\/init(_:)-1il83","doc:\/\/GLib\/documentation\/GLib\/SourceFuncsRef\/init(_:)-5idr3","doc:\/\/GLib\/documentation\/GLib\/SourceFuncsRef\/init(_:)-891i5","doc:\/\/GLib\/documentation\/GLib\/SourceFuncsRef\/init(_:)-937im","doc:\/\/GLib\/documentation\/GLib\/SourceFuncsRef\/init(_:)-9qm49","doc:\/\/GLib\/documentation\/GLib\/SourceFuncsRef\/init(cPointer:)","doc:\/\/GLib\/documentation\/GLib\/SourceFuncsRef\/init(constPointer:)","doc:\/\/GLib\/documentation\/GLib\/SourceFuncsRef\/init(gconstpointer:)","doc:\/\/GLib\/documentation\/GLib\/SourceFuncsRef\/init(gpointer:)","doc:\/\/GLib\/documentation\/GLib\/SourceFuncsRef\/init(mutating:)","doc:\/\/GLib\/documentation\/GLib\/SourceFuncsRef\/init(opaquePointer:)"]},{"identifiers":["doc:\/\/GLib\/documentation\/GLib\/SourceFuncsRef\/ptr"],"anchor":"Instance-Properties","generated":true,"title":"Instance Properties"},{"generated":true,"anchor":"Default-Implementations","title":"Default Implementations","identifiers":["doc:\/\/GLib\/documentation\/GLib\/SourceFuncsRef\/PointerWrapper-Implementations","doc:\/\/GLib\/documentation\/GLib\/SourceFuncsRef\/SourceFuncsProtocol-Implementations"]}],"abstract":[{"text":"The ","type":"text"},{"code":"GSourceFuncs","type":"codeVoice"},{"text":" struct contains a table of","type":"text"},{"text":" ","type":"text"},{"type":"text","text":"functions used to handle event sources in a generic manner."