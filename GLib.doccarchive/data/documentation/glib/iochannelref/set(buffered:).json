{"schemaVersion":{"minor":3,"major":0,"patch":0},"primaryContentSections":[{"kind":"declarations","declarations":[{"languages":["swift"],"tokens":[{"kind":"keyword","text":"func"},{"text":" ","kind":"text"},{"kind":"identifier","text":"set"},{"text":"(","kind":"text"},{"text":"buffered","kind":"externalParam"},{"text":": ","kind":"text"},{"preciseIdentifier":"s:Sb","text":"Bool","kind":"typeIdentifier"},{"kind":"text","text":")"}],"platforms":["macOS"]}]},{"content":[{"level":2,"type":"heading","text":"Discussion","anchor":"discussion"},{"type":"paragraph","inlineContent":[{"type":"text","text":"A buffered channel can only be set unbuffered if the channel’s"},{"text":" ","type":"text"},{"type":"text","text":"internal buffers have been flushed. Newly created channels or"},{"text":" ","type":"text"},{"text":"channels which have returned ","type":"text"},{"code":"eof","type":"codeVoice"},{"text":" ","type":"text"},{"type":"text","text":"not require such a flush. For write-only channels, a call to"},{"type":"text","text":" "},{"text":"g_io_channel_flush () is sufficient. For all other channels,","type":"text"},{"type":"text","text":" "},{"text":"the buffers may be flushed by a call to g_io_channel_seek_position ().","type":"text"},{"type":"text","text":" "},{"type":"text","text":"This includes the possibility of seeking with seek type "},{"code":"cur","type":"codeVoice"},{"text":" ","type":"text"},{"type":"text","text":"and an offset of zero. Note that this means that socket-based"},{"type":"text","text":" "},{"text":"channels cannot be set unbuffered once they have had data","type":"text"},{"text":" ","type":"text"},{"text":"read from them.","type":"text"}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"On unbuffered channels, it is safe to mix read and write"},{"text":" ","type":"text"},{"type":"text","text":"calls from the new and old APIs, if this is necessary for"},{"type":"text","text":" "},{"type":"text","text":"maintaining old code."}]},{"inlineContent":[{"type":"text","text":"The default state of the channel is buffered."}],"type":"paragraph"}],"kind":"content"}],"sections":[],"abstract":[{"text":"The buffering state can only be set if the channel’s encoding","type":"text"},{"text":" ","type":"text"},{"text":"is ","type":"text"},{"code":"nil","type":"codeVoice"},{"text":". For any other encoding, the channel must be buffered.","type":"text"}],"identifier":{"url":"doc:\/\/GLib\/documentation\/GLib\/IOChannelRef\/set(buffered:)","interfaceLanguage":"swift"},"kind":"symbol","hierarchy":{"paths":[["doc:\/\/GLib\/documentation\/GLib","doc:\/\/GLib\/documentation\/GLib\/IOChannelRef","doc:\/\/GLib\/documentation\/GLib\/IOChannelRef\/IOChannelProtocol-Implementations"]]},"variants":[{"paths":["\/documentation\/glib\/iochannelref\/set(buffered:)"],"traits":[{"interfaceLanguage":"swift"}]}],"metadata":{"role":"symbol","symbolKind":"method","modules":[{"name":"GLib"}],"roleHeading":"Instance Method","externalID":"s:4GLib17IOChannelProtocolPAAE3set8bufferedySb_tF::SYNTHESIZED::s:4GLib12IOChannelRefV","fragments":[{"text":"func","kind":"keyword"},{"text":" ","kind":"text"},{"text":"set","kind":"identifier"},{"text":"(","kind":"text"},{"text":"buffered","kind":"externalParam"},{"kind":"text","text":": "},{"kind":"typeIdentifier","preciseIdentifier":"s:Sb","text":"Bool"},{"text":")","kind":"text"}],"title":"set(buffered:)","extendedModule":"GLib"},"references":{"doc://GLib/documentation/GLib":{"identifier":"doc:\/\/GLib\/documentation\/GLib","title":"GLib","abstract":[],"type":"topic","url":"\/documentation\/glib","kind":"symbol","role":"collection"},"doc://GLib/documentation/GLib/IOChannelRef/IOChannelProtocol-Implementations":{"abstract":[],"identifier":"doc:\/\/GLib\/documentation\/GLib\/IOChannelRef\/IOChannelProtocol-Implementations","kind":"article","title":"IOChannelProtocol Implementations","role":"collectionGroup","url":"\/documentation\/glib\/iochannelref\/iochannelprotocol-implementations","type":"topic"},"doc://GLib/documentation/GLib/MainContext":{"title":"MainContext","identifier":"doc:\/\/GLib\/documentation\/GLib\/MainContext","fragments":[{"kind":"keyword","text":"class"},{"kind":"text","text":" "},{"kind":"identifier","text":"MainContext"}],"url":"\/documentation\/glib\/maincontext","navigatorTitle":[{"kind":"identifier","text":"MainContext"}],"kind":"symbol","type":"topic","role":"symbol","abstract":[{"type":"text","text":"The "},{"code":"GMainContext","type":"codeVoice"},{"text":" struct is an opaque data","type":"text"},{"text":" ","type":"text"},{"type":"text","text":"type representing a set of sources to be handled in a main loop."}]},"doc://GLib/documentation/GLib/IOChannelRef/set(buffered:)":{"role":"symbol","type":"topic","abstract":[{"text":"The buffering state can only be set if the channel’s encoding","type":"text"},{"type":"text","text":" "},{"text":"is ","type":"text"},{"type":"codeVoice","code":"nil"},{"type":"text","text":". For any other encoding, the channel must be buffered."}],"url":"\/documentation\/glib\/iochannelref\/set(buffered:)","kind":"symbol","fragments":[{"kind":"keyword","text":"func"},{"text":" ","kind":"text"},{"kind":"identifier","text":"set"},{"kind":"text","text":"("},{"kind":"externalParam","text":"buffered"},{"text":": ","kind":"text"},{"kind":"typeIdentifier","text":"Bool","preciseIdentifier":"s:Sb"},{"kind":"text","text":")"}],"title":"set(buffered:)","identifier":"doc:\/\/GLib\/documentation\/GLib\/IOChannelRef\/set(buffered:)"},"doc://GLib/documentation/GLib/IOChannelRef":{"url":"\/documentation\/glib\/iochannelref","identifier":"doc:\/\/GLib\/documentation\/GLib\/IOChannelRef","title":"IOChannelRef","role":"symbol","type":"topic","navigatorTitle":[{"text":"IOChannelRef","kind":"identifier"}],"kind":"symbol","fragments":[{"text":"struct","kind":"keyword"},{"kind":"text","text":" "},{"text":"IOChannelRef","kind":"identifier"}],"abstract":[{"text":"The ","type":"text"},{"type":"codeVoice","code":"GIOChannel"},{"text":" data type aims to provide a portable method for","type":"text"},{"type":"text","text":" "},{"text":"using file descriptors, pipes, and sockets, and integrating them","type":"text"},{"text":" ","type":"text"},{"type":"text","text":"into the main event loop (see [struct"},{"isActive":true,"type":"reference","identifier":"doc:\/\/GLib\/documentation\/GLib\/MainContext"},{"type":"text","text":"]). Currently,"},{"text":" ","type":"text"},{"text":"full support is available on UNIX platforms; support for Windows","type":"text"},{"type":"text","text":" "},{"type":"text","text":"is only partially complete."}]}}}