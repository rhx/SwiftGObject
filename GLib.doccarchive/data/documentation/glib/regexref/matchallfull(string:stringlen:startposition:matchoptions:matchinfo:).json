ch_info_fetch_pos()"},{"type":"text","text":". Note that the strings are returned in"},{"type":"text","text":" "},{"text":"reverse order of length; that is, the longest matching string is","type":"text"},{"text":" ","type":"text"},{"type":"text","text":"given first."}]},{"inlineContent":[{"type":"text","text":"Note that the DFA algorithm is slower than the standard one and it"},{"type":"text","text":" "},{"type":"text","text":"is not able to capture substrings, so backreferences do not work."}],"type":"paragraph"},{"type":"paragraph","inlineContent":[{"type":"text","text":"Setting "},{"type":"codeVoice","code":"startPosition"},{"type":"text","text":" differs from just passing over a shortened"},{"text":" ","type":"text"},{"type":"text","text":"string and setting "},{"type":"codeVoice","code":"notbol"},{"type":"text","text":" in the case of a pattern"},{"type":"text","text":" "},{"type":"text","text":"that begins with any kind of lookbehind assertion, such as “\\b”."}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"Unless "},{"code":"raw","type":"codeVoice"},{"text":" is specified in the options, ","type":"text"},{"type":"codeVoice","code":"string"},{"text":" must be valid UTF-8.","type":"text"}]},{"type":"paragraph","inlineContent":[{"text":"A ","type":"text"},{"identifier":"doc:\/\/GLib\/documentation\/GLib\/MatchInfo","isActive":true,"type":"reference"},{"type":"text","text":" structure, used to get information on the match, is"},{"text":" ","type":"text"},{"text":"stored in ","type":"text"},{"type":"codeVoice","code":"matchInfo"},{"type":"text","text":" if not "},{"code":"nil","type":"codeVoice"},{"text":". Note that if ","type":"text"},{"code":"matchInfo","type":"codeVoice"},{"text":" is","type":"text"},{"type":"text","text":" "},{"type":"text","text":"not "},{"type":"codeVoice","code":"nil"},{"text":" then it is created even if the function returns ","type":"text"},{"type":"codeVoice","code":"false"},{"text":",","type":"text"},{"text":" ","type":"