{"abstract":[{"type":"text","text":"Using the standard algorithm for regular expression matching only"},{"type":"text","text":" "},{"type":"text","text":"the longest match in the "},{"type":"codeVoice","code":"string"},{"text":" is retrieved, it is not possible","type":"text"},{"text":" ","type":"text"},{"type":"text","text":"to obtain all the available matches. For instance matching"},{"type":"text","text":" "},{"code":"\"<a> <b> <c>\"","type":"codeVoice"},{"type":"text","text":" against the pattern "},{"code":"\"<.*>\"","type":"codeVoice"},{"type":"text","text":" "},{"type":"text","text":"you get "},{"code":"\"<a> <b> <c>\"","type":"codeVoice"},{"text":".","type":"text"}],"identifier":{"interfaceLanguage":"swift","url":"doc:\/\/GLib\/documentation\/GLib\/RegexRef\/matchAllFull(string:stringLen:startPosition:matchOptions:matchInfo:)"},"schemaVersion":{"minor":3,"patch":0,"major":0},"primaryContentSections":[{"kind":"declarations","declarations":[{"languages":["swift"],"tokens":[{"text":"func","kind":"keyword"},{"text":" ","kind":"text"},{"text":"matchAllFull","kind":"identifier"},{"kind":"text","text":"("},{"text":"string","kind":"externalParam"},{"kind":"text","text":": "},{"preciseIdentifier":"s:SP","kind":"typeIdentifier","text":"UnsafePointer"},{"text":"<","kind":"text"},{"text":"gchar","kind":"typeIdentifier","preciseIdentifier":"c:@T@gchar"},{"kind":"text","text":">!, "},{"kind":"externalParam","text":"stringLen"},{"text":": ","kind":"text"},{"preciseIdentifier":"c:@T@gssize","text":"gssize","kind":"typeIdentifier"},{"text":", ","kind":"text"},{"text":"startPosition","kind":"externalParam"},{"kind":"text","text":": "},{"preciseIdentifier":"s:Si","kind":"typeIdentifier","text":"Int"},{"text":", ","kind":"text"},{"text":"matchOptions","kind":"externalParam"},{"kind":"text","text":": "},{"text":"RegexMatchFlags","preciseIdentifier":"s:4GLib15RegexMatchFlagsV","identifier":"doc:\/\/GLib\/documentation\/GLib\/RegexMatchFlags","kind":"typeIdentifier"},{"kind":"text