forms":["macOS"],"tokens":[{"text":"func","kind":"keyword"},{"kind":"text","text":" "},{"kind":"identifier","text":"testExpectMessage"},{"text":"(","kind":"text"},{"kind":"externalParam","text":"logDomain"},{"text":": ","kind":"text"},{"text":"UnsafePointer","preciseIdentifier":"s:SP","kind":"typeIdentifier"},{"text":"<","kind":"text"},{"preciseIdentifier":"c:@T@gchar","text":"gchar","kind":"typeIdentifier"},{"text":">? = nil, ","kind":"text"},{"text":"logLevel","kind":"externalParam"},{"text":": ","kind":"text"},{"preciseIdentifier":"s:4GLib13LogLevelFlagsV","kind":"typeIdentifier","text":"LogLevelFlags","identifier":"doc:\/\/GLib\/documentation\/GLib\/LogLevelFlags"},{"text":", ","kind":"text"},{"kind":"externalParam","text":"pattern"},{"text":": ","kind":"text"},{"text":"UnsafePointer","preciseIdentifier":"s:SP","kind":"typeIdentifier"},{"text":"<","kind":"text"},{"kind":"typeIdentifier","text":"gchar","preciseIdentifier":"c:@T@gchar"},{"kind":"text","text":">!)"}],"languages":["swift"]}],"kind":"declarations"},{"content":[{"text":"Discussion","level":2,"type":"heading","anchor":"discussion"},{"inlineContent":[{"text":"When this message is logged, it will not be printed, and the test case will","type":"text"},{"type":"text","text":" "},{"text":"not abort.","type":"text"}],"type":"paragraph"},{"type":"paragraph","inlineContent":[{"text":"This API may only be used with the old logging API ([func","type":"text"},{"code":"GLib.log","type":"codeVoice"},{"text":"] without","type":"text"},{"type":"text","text":" "},{"code":"G_LOG_USE_STRUCTURED","type":"codeVoice"},{"text":" defined). It will not work with the structured logging","type":"text"},{"type":"text","text":" "},{"text":"API. See ","type":"text"},{"isActive":true,"type":"reference","identifier":"logging.html#testing-for-messages"},{"type":"text","text":"."}]},{"inlineContent":[{"type":"text","text":"Use [func"},{"code":"GLib.test_assert_expected_messages","type":"codeVoice"},{"text":"] to assert that all","type":"text"},{"type":"text","text":" "},{"text":"previously-expected messages have been seen and suppressed.","type":"text"}],"type":"paragraph"},{"inlineContent":[{"text":"You can call this multiple times in a row, if multiple messages are","type":"text"},{"type":"text","text":" "},{"type":"text","text":"expected as a result of a single call. (The messages must appear in"},{"type":"text","text":" "},{"text":"the same order as the calls to [func","type":"text"},{"code":"GLib.test_expect_message","type":"codeVoice"},{"type":"text","text":"].)"}],"type":"paragraph"},{"type":"paragraph","inlineContent":[{"type":"text","text":"For example:"}]},{"type":"codeListing","code":["\/\/ `g_main_context_push_thread_default()` should fail if the","\/\/ context is already owned by another thread.","g_test_expect_message (G_LOG_DOMAIN,","                       G_LOG_LEVEL_CRITICAL,","                       \"assertion*acquired_context*failed\");","g_main_context_push_thread_default (bad_context);","g_test_assert_expected_messages ();"],"syntax":"c"},{"inlineContent":[{"type":"text","text":"Note that you cannot use this to test [func"},{"type":"codeVoice","code":"GLib.error"},{"type":"text","text":"] messages, since"},{"type":"text","text":" "},{"type":"text","text":"[func"},{"type":"codeVoice","code":"GLib.error"},{"text":"] intentionally never returns even if the program doesn’t","type":"text"},{"type":"text","text":" "},{"text":"abort; use [func","type":"text"},{"code":"GLib.test_trap_subprocess","type":"codeVoice"},{"type":"text","text":"] in this case."}],"type":"paragraph"},{"type":"paragraph","inlineContent":[{"text":"If messages at [flags","type":"text"},{"type":"codeVoice","code":"GLib.LogLevelFlags.LEVEL_DEBUG"},{"type":"text","text":"] are emitted, but not explicitly"},{"text":" ","type":"text"},{"text":"expected via [func","type":"text"},{"code":"GLib.test_expect_message","type":"codeVoice"},{"type":"text","text":"] then they will be ignored."}]}],"kind":"content"}],"refere