{"schemaVersion":{"patch":0,"minor":3,"major":0},"sections":[],"identifier":{"url":"doc:\/\/GLib\/documentation\/GLib\/open(filename:flags:mode:)","interfaceLanguage":"swift"},"hierarchy":{"paths":[["doc:\/\/GLib\/documentation\/GLib"]]},"kind":"symbol","primaryContentSections":[{"kind":"declarations","declarations":[{"tokens":[{"text":"func","kind":"keyword"},{"text":" ","kind":"text"},{"text":"open","kind":"identifier"},{"text":"(","kind":"text"},{"kind":"externalParam","text":"filename"},{"kind":"text","text":": "},{"kind":"typeIdentifier","text":"UnsafePointer","preciseIdentifier":"s:SP"},{"text":"<","kind":"text"},{"kind":"typeIdentifier","preciseIdentifier":"c:@T@gchar","text":"gchar"},{"kind":"text","text":">!, "},{"text":"flags","kind":"externalParam"},{"kind":"text","text":": "},{"preciseIdentifier":"s:Si","text":"Int","kind":"typeIdentifier"},{"kind":"text","text":", "},{"text":"mode","kind":"externalParam"},{"text":": ","kind":"text"},{"kind":"typeIdentifier","preciseIdentifier":"s:Si","text":"Int"},{"text":") -> ","kind":"text"},{"kind":"typeIdentifier","preciseIdentifier":"s:Si","text":"Int"}],"languages":["swift"],"platforms":["macOS"]}]},{"content":[{"level":2,"text":"Discussion","anchor":"discussion","type":"heading"},{"type":"paragraph","inlineContent":[{"text":"On POSIX systems file descriptors are implemented by the operating","type":"text"},{"text":" ","type":"text"},{"text":"system. On Windows, it’s the C library that implements ","type":"text"},{"type":"codeVoice","code":"open()"},{"type":"text","text":" and"},{"text":" ","type":"text"},{"type":"text","text":"file descriptors. The actual Win32 API for opening files is quite"},{"text":" ","type":"text"},{"type":"text","text":"different, see MSDN documentation for "},{"type":"codeVoice","code":"CreateFile()"},{"text":". The Win32 API","type":"text"},{"type":"text","text":" "},{"type":"text","text":"uses file handles, which are more randomish integers, not small"},{"type":"text","text":" "},{"text":"integers like file descriptors.","type":"text"}]},{"type":"paragraph","inlineContent":[{"text":"Because file descriptors are specific to the C library on Windows,","type":"text"},{"type":"text","text":" "},{"type":"text","text":"the file descriptor returned by this function makes sense only to"},{"text":" ","type":"text"},{"text":"functions in the same C library. Thus if the GLib-using code uses a","type":"text"},{"type":"text","text":" "},{"type":"text","text":"different C library than GLib does, the file descriptor returned by"},{"type":"text","text":" "},{"text":"this function cannot be passed to C library functions like ","type":"text"},{"type":"codeVoice","code":"write()"},{"text":" ","type":"text"},{"type":"text","text":"or "},{"type":"codeVoice","code":"read()"},{"type":"text","text":"."}]},{"inlineContent":[{"text":"See your C library manual for more details about ","type":"text"},{"type":"codeVoice","code":"open()"},{"type":"text","text":"."}],"type":"paragraph"}],"kind":"content"}],"variants":[{"paths":["\/documentation\/glib\/open(filename:flags:mode:)"],"traits":[{"interfaceLanguage":"swift"}]}],"abstract":[{"type":"text","text":"A wrapper for the POSIX "},{"type":"codeVoice","code":"open()"},{"type":"text","text":" function. The "},{"type":"codeVoice","code":"open()"},{"type":"text","text":" function is"},{"type":"text","text":" "},{"type":"text","text":"used to convert a pathname into a file descriptor."}],"metadata":{"externalID":"s:4GLib4open8filename5flags4modeSiSPys4Int8VGSg_S2itF","title":"open(filename:flags:mode:)","fragments":[{"text":"func","kind":"keyword"},{"text":" ","kind":"text"},{"kind":"identifier","text":"open"},{"kind":"text","text":"("},{"kind":"externalParam","text":"filename"},{"kind":"text","text":": "},{"kind":"typeIdentifier","preciseIdentifier":"s:SP","text":"UnsafePointer"},{"kind":"text","text":"<"},{"preciseIdentifier":"c:@T@gchar","text":"gchar","kind":"typeIdentifier"},{"kind":"text","text":">!, "},{"kind":"externalPara