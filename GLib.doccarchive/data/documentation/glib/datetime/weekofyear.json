{"hierarchy":{"paths":[["doc:\/\/GLib\/documentation\/GLib","doc:\/\/GLib\/documentation\/GLib\/DateTime","doc:\/\/GLib\/documentation\/GLib\/DateTime\/DateTimeProtocol-Implementations"]]},"identifier":{"interfaceLanguage":"swift","url":"doc:\/\/GLib\/documentation\/GLib\/DateTime\/weekOfYear"},"kind":"symbol","schemaVersion":{"major":0,"minor":3,"patch":0},"sections":[],"metadata":{"title":"weekOfYear","modules":[{"name":"GLib"}],"role":"symbol","roleHeading":"Instance Property","externalID":"s:4GLib16DateTimeProtocolPAAE10weekOfYearSivp::SYNTHESIZED::s:4GLib8DateTimeC","fragments":[{"kind":"keyword","text":"var"},{"text":" ","kind":"text"},{"kind":"identifier","text":"weekOfYear"},{"text":": ","kind":"text"},{"preciseIdentifier":"s:Si","kind":"typeIdentifier","text":"Int"}],"extendedModule":"GLib","symbolKind":"property"},"abstract":[{"type":"text","text":"Returns the ISO 8601 week number for the week containing "},{"code":"datetime","type":"codeVoice"},{"type":"text","text":"."},{"type":"text","text":" "},{"type":"text","text":"The ISO 8601 week number is the same for every day of the week (from"},{"text":" ","type":"text"},{"type":"text","text":"Moday through Sunday).  That can produce some unusual results"},{"type":"text","text":" "},{"type":"text","text":"(described below)."}],"primaryContentSections":[{"kind":"declarations","declarations":[{"languages":["swift"],"tokens":[{"text":"var","kind":"keyword"},{"text":" ","kind":"text"},{"text":"weekOfYear","kind":"identifier"},{"kind":"text","text":": "},{"preciseIdentifier":"s:Si","text":"Int","kind":"typeIdentifier"},{"text":" { ","kind":"text"},{"text":"get","kind":"keyword"},{"text":" }","kind":"text"}],"platforms":["macOS"]}]},{"kind":"content","content":[{"anchor":"discussion","text":"Discussion","type":"heading","level":2},{"type":"paragraph","inlineContent":[{"type":"text","text":"The first week of the year is week 1.  This is the week that contains"},{"text":" ","type":"text"},{"type":"text","text":"the first Thursday of the year.  Equivalently, this is the first week"},{"type":"text","text":" "},{"type":"text","text":"that has more than 4 of its days falling within the calendar year."}]},{"inlineContent":[{"text":"The value 0 is never returned by this function.  Days contained","type":"text"},{"text":" ","type":"text"},{"text":"within a year but occurring before the first ISO 8601 week of that","type":"text"},{"type":"text","text":" "},{"text":"year are considered as being contained in the last week of the","type":"text"},{"type":"text","text":" "},{"type":"text","text":"previous year.  Similarly, the final days of a calendar year may be"},{"type":"text","text":" "},{"type":"text","text":"considered as being part of the first ISO 8601 week of the next year"},{"text":" ","type":"text"},{"text":"if 4 or more days of that week are contained within the new year.","type":"text"}],"type":"paragraph"}]}],"variants":[{"paths":["\/documentation\/glib\/datetime\/weekofyear"],"traits":[{"interfaceLanguage":"swift"}]}],"references":{"doc://GLib/documentation/GLib":{"identifier":"doc:\/\/GLib\/documentation\/GLib","title":"GLib","abstract":[],"type":"topic","url":"\/documentation\/glib","kind":"symbol","role":"collection"},"doc://GLib/documentation/GLib/DateTime/weekOfYear":{"identifier":"doc:\/\/GLib\/documentation\/GLib\/DateTime\/weekOfYear","abstract":[{"text":"Returns the ISO 8601 week number for the week containing ","type":"text"},{"type":"codeVoice","code":"datetime"},{"type":"text","text":"."},{"type":"text","text":" "},{"type":"text","text":"The ISO 8601 week number is the same for every day of the week (from"},{"text":" ","type":"text"},{"type":"text","text":"Moday through Sunday).  That can produce some unusual results"},{"text":" ","type":"text"},{"text":"(described below).","type":"text"}],"url":"\/documentation\/glib\/datetime\/weekofyear","type":"topic","role":"symbol","fragments":[{"text":"var","kind":"keyword"},{"kind":"text","text":" "},{"kind":"identifier","t