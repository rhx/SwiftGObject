{"kind":"symbol","sections":[],"schemaVersion":{"patch":0,"major":0,"minor":3},"primaryContentSections":[{"kind":"declarations","declarations":[{"platforms":["macOS"],"languages":["swift"],"tokens":[{"kind":"keyword","text":"func"},{"kind":"text","text":" "},{"text":"format","kind":"identifier"},{"kind":"text","text":"("},{"text":"format","kind":"externalParam"},{"kind":"text","text":": "},{"preciseIdentifier":"s:SP","text":"UnsafePointer","kind":"typeIdentifier"},{"text":"<","kind":"text"},{"preciseIdentifier":"c:@T@gchar","text":"gchar","kind":"typeIdentifier"},{"text":">!) -> ","kind":"text"},{"kind":"typeIdentifier","preciseIdentifier":"s:SS","text":"String"},{"text":"!","kind":"text"}]}]},{"kind":"content","content":[{"anchor":"discussion","text":"Discussion","level":2,"type":"heading"},{"type":"paragraph","inlineContent":[{"type":"text","text":"The format strings understood by this function are a subset of the"},{"text":" ","type":"text"},{"code":"strftime()","type":"codeVoice"},{"type":"text","text":" format language as specified by C99.  The "},{"code":"D","type":"codeVoice"},{"type":"text","text":", "},{"type":"codeVoice","code":"U"},{"text":" and ","type":"text"},{"type":"codeVoice","code":"W"},{"type":"text","text":" "},{"type":"text","text":"conversions are not supported, nor is the "},{"code":"E","type":"codeVoice"},{"text":" modifier.  The GNU","type":"text"},{"text":" ","type":"text"},{"text":"extensions ","type":"text"},{"type":"codeVoice","code":"k"},{"type":"text","text":", "},{"code":"l","type":"codeVoice"},{"type":"text","text":", "},{"type":"codeVoice","code":"s"},{"type":"text","text":" and "},{"type":"codeVoice","code":"P"},{"type":"text","text":" are supported, however, as are the"},{"text":" ","type":"text"},{"code":"0","type":"codeVoice"},{"text":", ","type":"text"},{"type":"codeVoice","code":"_"},{"type":"text","text":" and "},{"code":"-","type":"codeVoice"},{"text":" modifiers. The Python extension ","type":"text"},{"code":"f","type":"codeVoice"},{"text":" is also supported.","type":"text"}]},{"inlineContent":[{"text":"In contrast to ","type":"text"},{"type":"codeVoice","code":"strftime()"},{"text":", this function always produces a UTF-8","type":"text"},{"type":"text","text":" "},{"text":"string, regardless of the current locale.  Note that the rendering of","type":"text"},{"text":" ","type":"text"},{"text":"many formats is locale-dependent and may not match the ","type":"text"},{"code":"strftime()","type":"codeVoice"},{"text":" ","type":"text"},{"type":"text","text":"output exactly."}],"type":"paragraph"},{"inlineContent":[{"type":"text","text":"The following format specifiers are supported:"}],"type":"paragraph"},{"items":[{"content":[{"type":"paragraph","inlineContent":[{"code":"a","type":"codeVoice"},{"type":"text","text":": the abbreviated weekday name according to the current locale"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"code":"A","type":"codeVoice"},{"text":": the full weekday name according to the current locale","type":"text"}]}]},{"content":[{"inlineContent":[{"code":"b","type":"codeVoice"},{"type":"text","text":": the abbreviated month name according to the current locale"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"code":"B","type":"codeVoice"},{"type":"text","text":": the full month name according to the current locale"}],"type":"paragraph"}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"c"},{"type":"text","text":": the preferred date and time representation for the current locale"}]}]},{"content":[{"inlineContent":[{"code":"C","type":"codeVoice"},{"type":"text","text":": the century number (year\/100) as a 2-digit integer (00-99)"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"type":"codeVoice","code":"d"},{"type":"text","text":": the day of the month as a decimal number (range 01 to 31)"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"isActive":true,"type":"reference","identifier":"doc:\/\/GLib\/documentation\/GLib\/e-3m6a4"},{"type":"text","text":": the day of the month as a decimal number (range 1 to 31);"},{"type":"text","text":" "},{"text":"single digits are preceded by a figure space (U+2007)","type":"text"}],"type":"paragraph"}]},{"content":[{"type":"paragraph","inlineContent":[{"code":"F","type":"codeVoice"},{"text":": equivalent to ","type":"text"},{"type":"codeVoice","code":"Y-"},{"type":"text","text":"m-"},{"type":"codeVoice","code":"d"},{"text":" (the ISO 8601 date format)","type":"text"}]}]},{"content":[{"inlineContent":[{"code":"g","type":"codeVoice"},{"text":": the last two digits of the ISO 8601 week-based year as a","type":"text"},{"type":"text","text":" "},{"type":"text","text":"decimal number (00-99). This works well with "},{"type":"codeVoice","code":"V"},{"type":"text","text":" and "},{"type":"codeVoice","code":"u"},{"text":".","type":"text"}],"type":"paragraph"}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"G"},{"text":": the ISO 8601 week-based year as a decimal number. This works","type":"text"},{"text":" ","type":"text"},{"type":"text","text":"well with "},{"type":"codeVoice","code":"V"},{"text":" and ","type":"text"},{"type":"codeVoice","code":"u"},{"type":"text","text":"."}]}]},{"content":[{"inlineContent":[{"type":"codeVoice","code":"h"},{"type":"text","text":": equivalent to "},{"code":"b","type":"codeVoice"}],"type":"paragraph"}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"H"},{"type":"text","text":": the hour as a decimal number using a 24-hour clock (range 00 to 23)"}]}]},{"content":[{"inlineContent":[{"code":"I","type":"codeVoice"},{"type":"text","text":": the hour as a decimal number using a 12-hour clock (range 01 to 12)"}],"type":"paragraph"}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"j"},{"type":"text","text":": the day of the year as a decimal number (range 001 to 366)"}]}]},{"content":[{"inlineContent":[{"type":"codeVoice","code":"k"},{"type":"text","text":": the hour (24-hour clock) as a decimal number (range 0 to 23);"},{"text":" ","type":"text"},{"text":"single digits are preceded by a figure space (U+2007)","type":"text"}],"type":"paragraph"}]},{"content":[{"type":"paragraph","inlineContent":[{"code":"l","type":"codeVoice"},{"type":"text","text":": the hour (12-hour clock) as a decimal number (range 1 to 12);"},{"text":" ","type":"text"},{"text":"single digits are preceded by a figure space (U+2007)","type":"text"}]}]},{"content":[{"inlineContent":[{"code":"m","type":"codeVoice"},{"text":": the month as a decimal number (range 01 to 12)","type":"text"}],"type":"paragraph"}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"M"},{"type":"text","text":": the minute as a decimal number (range 00 to 59)"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"f"},{"type":"text","text":": the microsecond as a decimal number (range 000000 to 999999)"}]}]},{"content":[{"inlineContent":[{"code":"p","type":"codeVoice"},{"text":": either ‘AM’ or ‘PM’ according to the given time value, or the","type":"text"},{"text":" ","type":"text"},{"type":"text","text":"corresponding  strings for the current locale.  Noon is treated as"},{"type":"text","text":" "},{"type":"text","text":"‘PM’ and midnight as ‘AM’. Use of this format specifier is discouraged, as"},{"type":"text","text":" "},{"type":"text","text":"many locales have no concept of AM\/PM formatting. Use "},{"type":"codeVoice","code":"c"},{"type":"text","text":" or "},{"code":"X","type":"codeVoice"},{"type":"text","text":" instead."}],"type":"paragraph"}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"P"},{"text":": like ","type":"text"},{"code":"p","type":"codeVoice"},{"type":"text","text":" but lowercase: ‘am’ or ‘pm’ or a corresponding string for"},{"type":"text","text":" "},{"text":"the current locale. Use of this format specifier is discouraged, as","type":"text"},{"text":" ","type":"text"},{"text":"many locales have no concept of AM\/PM formatting. Use ","type":"text"},{"code":"c","type":"codeVoice"},{"text":" or ","type":"text"},{"code":"X","type":"codeVoice"},{"type":"text","text":" instead."}]}]},{"content":[{"inlineContent":[{"type":"codeVoice","code":"r"},{"type":"text","text":": the time in a.m. or p.m. notation. Use of this format specifier is"},{"type":"text","text":" "},{"text":"discouraged, as many locales have no concept of AM\/PM formatting. Use ","type":"text"},{"code":"c","type":"codeVoice"},{"type":"text","text":" "},{"type":"text","text":"or "},{"type":"codeVoice","code":"X"},{"text":" instead.","type":"text"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"code":"R","type":"codeVoice"},{"type":"text","text":": the time in 24-hour notation ("},{"code":"H:","type":"codeVoice"},{"text":"M``)","type":"text"}],"type":"paragraph"}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"s"},{"type":"text","text":": the number of seconds since the Epoch, that is, since 1970-01-01"},{"type":"text","text":" "},{"type":"text","text":"00:00:00 UTC"}]}]},{"content":[{"inlineContent":[{"type":"codeVoice","code":"S"},{"text":": the second as a decimal number (range 00 to 60)","type":"text"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"type":"codeVoice","code":"t"},{"type":"text","text":": a tab character"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"code":"T","type":"codeVoice"},{"type":"text","text":": the time in 24-hour notation with seconds ("},{"type":"codeVoice","code":"H:"},{"text":"M:","type":"text"},{"type":"codeVoice","code":"S"},{"type":"text","text":")"}],"type":"paragraph"}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"u"},{"type":"text","text":": the ISO 8601 standard day of the week as a decimal, range 1 to 7,"},{"type":"text","text":" "},{"text":"Monday being 1. This works well with ","type":"text"},{"type":"codeVoice","code":"G"},{"text":" and ","type":"text"},{"type":"codeVoice","code":"V"},{"type":"text","text":"."}]}]},{"content":[{"type":"paragraph","inlineContent":[{"code":"V","type":"codeVoice"},{"type":"text","text":": the ISO 8601 standard week number of the current year as a decimal"},{"type":"text","text":" "},{"type":"text","text":"number, range 01 to 53, where week 1 is the first week that has at"},{"text":" ","type":"text"},{"type":"text","text":"least 4 days in the new year. See "},{"type":"codeVoice","code":"g_date_time_get_week_of_year()"},{"type":"text","text":"."},{"type":"text","text":" "},{"type":"text","text":"This works well with "},{"type":"codeVoice","code":"G"},{"text":" and ","type":"text"},{"code":"u","type":"codeVoice"},{"text":".","type":"text"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"code":"w","type":"codeVoice"},{"text":": the day of the week as a decimal, range 0 to 6, Sunday being 0.","type":"text"},{"text":" ","type":"text"},{"type":"text","text":"This is not the ISO 8601 standard format — use "},{"type":"codeVoice","code":"u"},{"text":" instead.","type":"text"}]}]},{"content":[{"inlineContent":[{"code":"x","type":"codeVoice"},{"type":"text","text":": the preferred date representation for the current locale without"},{"type":"text","text":" "},{"type":"text","text":"the time"}],"type":"paragraph"}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"X"},{"text":": the preferred time representation for the current locale without","type":"text"},{"type":"text","text":" "},{"type":"text","text":"the date"}]}]},{"content":[{"inlineContent":[{"type":"codeVoice","code":"y"},{"text":": the year as a decimal number without the century","type":"text"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"type":"codeVoice","code":"Y"},{"text":": the year as a decimal number including the century","type":"text"}],"type":"paragraph"}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"z"},{"type":"text","text":": the time zone as an offset from UTC ("},{"code":"+hhmm","type":"codeVoice"},{"type":"text","text":")"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"code":":z","type":"codeVoice"},{"type":"text","text":": the time zone as an offset from UTC ("},{"type":"codeVoice","code":"+hh:mm"},{"type":"text","text":")."},{"text":" ","type":"text"},{"type":"text","text":"This is a gnulib "},{"type":"codeVoice","code":"strftime()"},{"text":" extension. Since: 2.38","type":"text"}]}]},{"content":[{"inlineContent":[{"type":"codeVoice","code":"::z"},{"text":": the time zone as an offset from UTC (","type":"text"},{"code":"+hh:mm:ss","type":"codeVoice"},{"type":"text","text":"). This is a"},{"type":"text","text":" "},{"text":"gnulib ","type":"text"},{"type":"codeVoice","code":"strftime()"},{"type":"text","text":" extension. Since: 2.38"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"type":"codeVoice","code":":::z"},{"text":": the time zone as an offset from UTC, with ","type":"text"},{"code":":","type":"codeVoice"},{"type":"text","text":" to necessary"},{"text":" ","type":"text"},{"type":"text","text":"precision (e.g., "},{"type":"codeVoice","code":"-04"},{"type":"text","text":", "},{"type":"codeVoice","code":"+05:30"},{"type":"text","text":"). This is a gnulib "},{"type":"codeVoice","code":"strftime()"},{"type":"text","text":" extension. Since: 2.38"}],"type":"paragraph"}]},{"content":[{"type":"paragraph","inlineContent":[{"code":"Z","type":"codeVoice"},{"type":"text","text":": the time zone or name or abbreviation"}]}]},{"content":[{"inlineContent":[{"type":"text","text":"``````: a literal ```` character"}],"type":"paragraph"}]}],"type":"unorderedList"},{"inlineContent":[{"type":"text","text":"Some conversion specifications can be modified by preceding the"},{"text":" ","type":"text"},{"type":"text","text":"conversion specifier by one or more modifier characters."}],"type":"paragraph"},{"type":"paragraph","inlineContent":[{"type":"text","text":"The following modifiers are supported for many of the numeric"},{"type":"text","text":" "},{"type":"text","text":"conversions:"}]},{"type":"unorderedList","items":[{"content":[{"inlineContent":[{"code":"O","type":"codeVoice"},{"type":"text","text":": Use alternative numeric symbols, if the current locale supports those."}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"code":"_","type":"codeVoice"},{"type":"text","text":": Pad a numeric result with spaces. This overrides the default padding"},{"text":" ","type":"text"},{"text":"for the specifier.","type":"text"}],"type":"paragraph"}]},{"content":[{"type":"paragraph","inlineContent":[{"code":"-","type":"codeVoice"},{"type":"text","text":": Do not pad a numeric result. This overrides the default padding"},{"text":" ","type":"text"},{"text":"for the specifier.","type":"text"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"code":"0","type":"codeVoice"},{"type":"text","text":": Pad a numeric result with zeros. This overrides the default padding"},{"text":" ","type":"text"},{"text":"for the specifier.","type":"text"}]}]}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"The following modifiers are supported for many of the alphabetic conversions:"}]},{"type":"unorderedList","items":[{"content":[{"inlineContent":[{"type":"codeVoice","code":"^"},{"type":"text","text":": Use upper case if possible. This is a gnulib "},{"type":"codeVoice","code":"strftime()"},{"text":" extension.","type":"text"},{"text":" ","type":"text"},{"text":"Since: 2.80","type":"text"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"code":"#","type":"codeVoice"},{"text":": Use opposite case if possible. This is a gnulib ","type":"text"},{"type":"codeVoice","code":"strftime()"},{"type":"text","text":" "},{"type":"text","text":"extension. Since: 2.80"}],"type":"paragraph"}]}]},{"inlineContent":[{"type":"text","text":"Additionally, when "},{"type":"codeVoice","code":"O"},{"type":"text","text":" is used with "},{"type":"codeVoice","code":"B"},{"type":"text","text":", "},{"type":"codeVoice","code":"b"},{"type":"text","text":", or "},{"type":"codeVoice","code":"h"},{"text":", it produces the alternative","type":"text"},{"text":" ","type":"text"},{"type":"text","text":"form of a month name. The alternative form should be used when the month"},{"type":"text","text":" "},{"type":"text","text":"name is used without a day number (e.g., standalone). It is required in"},{"text":" ","type":"text"},{"type":"text","text":"some languages (Baltic, Slavic, Greek, and more) due to their grammatical"},{"type":"text","text":" "},{"type":"text","text":"rules. For other languages there is no difference. "},{"code":"OB","type":"codeVoice"},{"type":"text","text":" is a GNU and BSD"},{"text":" ","type":"text"},{"type":"codeVoice","code":"strftime()"},{"text":" extension expected to be added to the future POSIX specification,","type":"text"},{"type":"text","text":" "},{"code":"Ob","type":"codeVoice"},{"text":" and ","type":"text"},{"code":"Oh","type":"codeVoice"},{"text":" are GNU ","type":"text"},{"code":"strftime()","type":"codeVoice"},{"type":"text","text":" extensions. Since: 2.56"}],"type":"paragraph"},{"inlineContent":[{"type":"text","text":"Since GLib 2.80, when "},{"type":"codeVoice","code":"E"},{"text":" is used with ","type":"text"},{"code":"c","type":"codeVoice"},{"text":", ","type":"text"},{"code":"C","type":"codeVoice"},{"text":", ","type":"text"},{"code":"x","type":"codeVoice"},{"type":"text","text":", "},{"code":"X","type":"codeVoice"},{"type":"text","text":", "},{"type":"codeVoice","code":"y"},{"text":" or ","type":"text"},{"type":"codeVoice","code":"Y"},{"type":"text","text":","},{"text":" ","type":"text"},{"type":"text","text":"the date is formatted using an alternate era representation specific to the"},{"text":" ","type":"text"},{"type":"text","text":"locale. This is typically used for the Thai solar calendar or Japanese era"},{"type":"text","text":" "},{"type":"text","text":"names, for example."}],"type":"paragraph"},{"items":[{"content":[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"Ec"},{"type":"text","text":": the preferred date and time representation for the current locale,"},{"text":" ","type":"text"},{"text":"using the alternate era representation","type":"text"}]}]},{"content":[{"inlineContent":[{"code":"EC","type":"codeVoice"},{"text":": the name of the era","type":"text"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"code":"Ex","type":"codeVoice"},{"type":"text","text":": the preferred date representation for the current locale without"},{"type":"text","text":" "},{"text":"the time, using the alternate era representation","type":"text"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"type":"codeVoice","code":"EX"},{"type":"text","text":": the preferred time representation for the current locale without"},{"type":"text","text":" "},{"type":"text","text":"the date, using the alternate era representation"}],"type":"paragraph"}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"Ey"},{"type":"text","text":": the year since the beginning of the era denoted by the "},{"code":"EC","type":"codeVoice"},{"type":"text","text":" "},{"text":"specifier","type":"text"}]}]},{"content":[{"inlineContent":[{"code":"EY","type":"codeVoice"},{"type":"text","text":": the full alternative year representation"}],"type":"paragraph"}]}],"type":"unorderedList"}]}],"identifier":{"url":"doc:\/\/GLib\/documentation\/GLib\/DateTime\/format(format:)","interfaceLanguage":"swift"},"abstract":[{"text":"Creates a newly allocated string representing the requested ","type":"text"},{"code":"format","type":"codeVoice"},{"type":"text","text":"."}],"hierarchy":{"paths":[["doc:\/\/GLib\/documentation\/GLib","doc:\/\/GLib\/documentation\/GLib\/DateTime","doc:\/\/GLib\/documentation\/GLib\/DateTime\/DateTimeProtocol-Implementations"]]},"variants":[{"paths":["\/documentation\/glib\/datetime\/format(format:)"],"traits":[{