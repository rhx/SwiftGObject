{"sections":[],"hierarchy":{"paths":[["doc:\/\/GLib\/documentation\/GLib","doc:\/\/GLib\/documentation\/GLib\/DateTime","doc:\/\/GLib\/documentation\/GLib\/DateTime\/DateTimeProtocol-Implementations"]]},"schemaVersion":{"patch":0,"major":0,"minor":3},"kind":"symbol","identifier":{"url":"doc:\/\/GLib\/documentation\/GLib\/DateTime\/getWeekNumberingYear()","interfaceLanguage":"swift"},"metadata":{"title":"getWeekNumberingYear()","roleHeading":"Instance Method","modules":[{"name":"GLib"}],"role":"symbol","fragments":[{"text":"func","kind":"keyword"},{"text":" ","kind":"text"},{"text":"getWeekNumberingYear","kind":"identifier"},{"text":"() -> ","kind":"text"},{"text":"Int","preciseIdentifier":"s:Si","kind":"typeIdentifier"}],"symbolKind":"method","extendedModule":"GLib","externalID":"s:4GLib16DateTimeProtocolPAAE20getWeekNumberingYearSiyF::SYNTHESIZED::s:4GLib8DateTimeC"},"primaryContentSections":[{"kind":"declarations","declarations":[{"platforms":["macOS"],"tokens":[{"text":"func","kind":"keyword"},{"kind":"text","text":" "},{"text":"getWeekNumberingYear","kind":"identifier"},{"kind":"text","text":"() -> "},{"preciseIdentifier":"s:Si","kind":"typeIdentifier","text":"Int"}],"languages":["swift"]}]},{"content":[{"text":"Discussion","type":"heading","anchor":"discussion","level":2},{"type":"paragraph","inlineContent":[{"type":"text","text":"This function, taken together with "},{"code":"g_date_time_get_week_of_year()","type":"codeVoice"},{"text":" and","type":"text"},{"text":" ","type":"text"},{"code":"g_date_time_get_day_of_week()","type":"codeVoice"},{"text":" can be used to determine the full ISO","type":"text"},{"type":"text","text":" "},{"type":"text","text":"week date on which "},{"type":"codeVoice","code":"datetime"},{"text":" falls.","type":"text"}]},{"type":"paragraph","inlineContent":[{"text":"This is usually equal to the normal Gregorian year (as returned by","type":"text"},{"type":"text","text":" "},{"code":"g_date_time_get_year()","type":"codeVoice"},{"text":"), except as detailed below:","type":"text"}]},{"inlineContent":[{"text":"For Thursday, the week-numbering year is always equal to the usual","type":"text"},{"text":" ","type":"text"},{"text":"calendar year.  For other days, the number is such that every day","type":"text"},{"text":" ","type":"text"},{"type":"text","text":"within a complete week (Monday to Sunday) is contained within the"},{"type":"text","text":" "},{"type":"text","text":"same week-numbering year."}],"type":"paragraph"},{"inlineContent":[{"type":"text","text":"For Monday, Tuesday and Wednesday occurring near the end of the year,"},{"type":"text","text":" "},{"text":"this may mean that the week-numbering year is one greater than the","type":"text"},{"type":"text","text":" "},{"text":"calendar year (so that these days have the same week-numbering year","type":"text"},{"type":"text","text":" "},{"type":"text","text":"as the Thursday occurring early in the next year)."}],"type":"paragraph"},{"type":"paragraph","inlineContent":[{"type":"text","text":"For Friday, Saturday and Sunday occurring near the start of the year,"},{"type":"text","text":" "},{"type":"text","text":"this may mean that the week-numbering year is one less than the"},{"type":"text","text":" "},{"type":"text","text":"calendar year (so that these days have the same week-numbering year"},{"type":"text","text":" "},{"type":"text","text":"as the Thursday occurring late in the previous year)."}]},{"type":"paragraph","inlineContent":[{"text":"An equivalent description is that the week-numbering year is equal to","type":"text"},{"text":" ","type":"text"},{"text":"the calendar year containing the majority of the days in the current","type":"text"},{"text":" ","type":"text"},{"text":"week (Monday to Sunday).","type":"text"}]},{"type":"paragraph","inlineContent":[{"text":"Note that January 1 0001 in the proleptic Gregorian calendar is a","type":"text"},{"type":"text","text":" "},{"text":"Monday, so this function never returns 0.","type":"text"}]}],"kind":"content"}],"abstract":[{"text":"Returns the ISO 8601 week-numbering year in which the week containing","type":"text"},{"type":"text","text":" "},{"code":"datetime","type":"codeVoice"},{"type":"text","text":" falls."}],"variants":[{"paths":["\/documentation\/glib\/datetime\/getweeknumberingyear()"],"traits":[{"interfaceLanguage":"swift"}]}],"references":{"doc://GLib/documentation/GLib":{"identifier":"doc:\/\/GLib\/documentation\/GLib","title":"GLib","abstract":[],"type":"topic","url":"\/documentation\/glib","kind":"symbol","role":"collection"},"doc://GLib/documentation/GLib/DateTime":{"fragments":[{"kind":"keyword","text":"class"},{"text":" ","kind":"text"},{"kind":"identifier","text":"DateTime"}],"navigatorTitle":[{"text":"DateTime","kind":"identifier"}],"abstract":[{"type":"codeVoice","code":"GDateTime"},{"type":"text","text":" is a structure that combines a Gregorian date and time"},{"text":" ","type":"text"},{"type":"text","text":"into a single structure."}],"kind":"symbol","role":"symbol","title":"DateTime","identifier":"doc:\/\/GLib\/documentation\/GLib\/DateTime","type":"topic","url":"\/documentation\/glib\/datetime"},"doc://GLib/documentation/GLib/DateTime/DateTimeProtocol-Implementations":{"type":"topic","title":"DateTimeProtocol Implementations","url":"\/documentation\/glib\/datetime\/datetimeprotocol-implementations","kind":"article","abstract":[],"identifier":"doc:\/\/GLib\/documentation\/GLib\/DateTime\/DateTimeProtocol-Implementations","role":"collectionGroup"},"doc://GLib/documentation/GLib/DateTime/getWeekNumberingYear()":{"identifier":"doc:\/\/GLib\/documentation\/GLib\/DateTime\/getWeekNumberingYear()","url":"\/documentation\/glib\/datetime\/getweeknumberingyear()","abstract":[{"text":"Returns the ISO 8601 week-numbering year in which the week containing","type":"text"},{"text":" ","type":"text"},{"type":"codeVoice","code":"datetime"},{"type":"text","text":" falls."}],"type":"topic","role":"symbol","fragments":[{"kind":"keyword","text":"f