{"sections":[],"abstract":[{"type":"text","text":"Returns the ISO 8601 week number for the week containing "},{"type":"codeVoice","code":"datetime"},{"text":".","type":"text"},{"type":"text","text":" "},{"text":"The ISO 8601 week number is the same for every day of the week (from","type":"text"},{"type":"text","text":" "},{"type":"text","text":"Moday through Sunday).  That can produce some unusual results"},{"text":" ","type":"text"},{"text":"(described below).","type":"text"}],"primaryContentSections":[{"kind":"declarations","declarations":[{"platforms":["macOS"],"languages":["swift"],"tokens":[{"text":"func","kind":"keyword"},{"text":" ","kind":"text"},{"text":"getWeekOfYear","kind":"identifier"},{"kind":"text","text":"() -> "},{"text":"Int","preciseIdentifier":"s:Si","kind":"typeIdentifier"}]}]},{"content":[{"anchor":"discussion","text":"Discussion","type":"heading","level":2},{"inlineContent":[{"type":"text","text":"The first week of the year is week 1.  This is the week that contains"},{"text":" ","type":"text"},{"type":"text","text":"the first Thursday of the year.  Equivalently, this is the first week"},{"text":" ","type":"text"},{"type":"text","text":"that has more than 4 of its days falling within the calendar year."}],"type":"paragraph"},{"type":"paragraph","inlineContent":[{"text":"The value 0 is never returned by this function.  Days contained","type":"text"},{"type":"text","text":" "},{"text":"within a year but occurring before the first ISO 8601 week of that","type":"text"},{"type":"text","text":" "},{"type":"text","text":"year are considered as being contained in the last week of the"},{"type":"text","text":" "},{"text":"previous year.  Similarly, the final days of a calendar year may be","type":"text"},{"text":" ","type":"text"},{"type":"text","text":"considered as being part of the first ISO 8601 week of the next year"},{"text":" ","type":"text"},{"text":"if 4 or more days of that week are contained within the new year.","type":"text"}]}],"kind":"content"}],"identifier":{"interfaceLanguage":"swift","url":"doc:\/\/GLib\/documentation\/GLib\/DateTime\/getWeekOfYear()"},"schemaVersion":{"major":0,"minor":3,"patch":0},"kind":"symbol","variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/glib\/datetime\/getweekofyear()"]}],"hierarchy":{"paths":[["doc:\/\/GLib\/documentation\/GLib","doc:\/\/GLib\/documentation\/GLib\/DateTime","doc:\/\/GLib\/documentation\/GLib\/DateTime\/DateTimeProtocol-Implementations"]]},"metadata":{"modules":[{"name":"GLib"}],"role":"symbol","fragments":[{"text":"func","kind":"keyword"},{"text":" ","kind":"text"},{"kind":"identifier","text":"getWeekOfYear"},{"text":"() -> ","kind":"text"},{"preciseIdentifier":"s:Si","kind":"typeIdentifier","text":"Int"}],"title":"getWeekOfYear()","symbolKind":"method","externalID":"s:4GLib16DateTimeProtocolPAAE13getWeekOfYearSiyF::SYNTHESIZED::s:4GLib8DateTimeC","extendedModule":"GLib","roleHeading":"Instance Method"},"references":{"doc://GLib/documentation/GLib/DateTime/getWeekOfYear()":{"identifier":"doc:\/\/GLib\/documentation\/GLib\/DateTime\/getWeekOfYear()","url":"\/documentation\/glib\/datetime\/getweekofyear()","abstract":[{"type":"text","text":"Returns the ISO 8601 week number for the week containing "},{"code":"datetime","type":"codeVoice"},{"text":".","type":"text"},{"text":" ","type":"text"},{"text":"The ISO 8601 week number is the same for every day of the week (from","type":"text"},{"type":"text","text":" "},{"type":"text","text":"Moday through Sunday).  That can produce some unusual results"},{"type":"text","text":" "},{"text":"(described below).","type":"text"}],"type":"topic","role":"symbol","fragments":[{"kind":"keyword","text":"func"},{"text":" ","kind":"text"},{"text":"getWeekOfYear","kind":"identifier"},{"kind":"text","text":"() -> "},{"preciseIdentifier":"s:Si","text":"Int","kind":"typeIdentifier"}],"title":"getWeekOfYear()","kind":"symbol"},"doc://GLib/documentation/GLib/DateTime/DateTimeProtocol-Implementations