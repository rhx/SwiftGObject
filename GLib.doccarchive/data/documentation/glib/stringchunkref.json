{"identifier":{"url":"doc:\/\/GLib\/documentation\/GLib\/StringChunkRef","interfaceLanguage":"swift"},"abstract":[{"code":"GStringChunk","type":"codeVoice"},{"text":" provides efficient storage of groups of strings","type":"text"}],"hierarchy":{"paths":[["doc:\/\/GLib\/documentation\/GLib"]]},"topicSections":[{"anchor":"Initializers","identifiers":["doc:\/\/GLib\/documentation\/GLib\/StringChunkRef\/init(_:)-2b1td","doc:\/\/GLib\/documentation\/GLib\/StringChunkRef\/init(_:)-3hmw3","doc:\/\/GLib\/documentation\/GLib\/StringChunkRef\/init(_:)-47idj","doc:\/\/GLib\/documentation\/GLib\/StringChunkRef\/init(_:)-7mrrb","doc:\/\/GLib\/documentation\/GLib\/StringChunkRef\/init(_:)-7w9mc","doc:\/\/GLib\/documentation\/GLib\/StringChunkRef\/init(cPointer:)","doc:\/\/GLib\/documentation\/GLib\/StringChunkRef\/init(constPointer:)","doc:\/\/GLib\/documentation\/GLib\/StringChunkRef\/init(gconstpointer:)","doc:\/\/GLib\/documentation\/GLib\/StringChunkRef\/init(gpointer:)","doc:\/\/GLib\/documentation\/GLib\/StringChunkRef\/init(mutating:)","doc:\/\/GLib\/documentation\/GLib\/StringChunkRef\/init(opaquePointer:)"],"generated":true,"title":"Initializers"},{"identifiers":["doc:\/\/GLib\/documentation\/GLib\/StringChunkRef\/ptr"],"generated":true,"anchor":"Instance-Properties","title":"Instance Properties"},{"anchor":"Default-Implementations","identifiers":["doc:\/\/GLib\/documentation\/GLib\/StringChunkRef\/PointerWrapper-Implementations","doc:\/\/GLib\/documentation\/GLib\/StringChunkRef\/StringChunkProtocol-Implementations"],"title":"Default Implementations","generated":true}],"relationshipsSections":[{"identifiers":["doc:\/\/GLib\/documentation\/GLib\/PointerWrapper","doc:\/\/GLib\/documentation\/GLib\/StringChunkProtocol"],"type":"conformsTo","title":"Conforms To","kind":"relationships"}],"schemaVersion":{"patch":0,"minor":3,"major":0},"sections":[],"metadata":{"role":"symbol","navigatorTitle":[{"kind":"identifier","text":"StringChunkRef"}],"roleHeading":"Structure","modules":[{"name":"GLib"}],"title":"StringChunkRef","fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"StringChunkRef","kind":"identifier"}],"externalID":"s:4GLib14StringChunkRefV","symbolKind":"struct"},"primaryContentSections":[{"kind":"declarations","declarations":[{"languages":["swift"],"platforms":["macOS"],"tokens":[{"kind":"keyword","text":"struct"},{"text":" ","kind":"text"},{"text":"StringChunkRef","kind":"identifier"}]}]},{"kind":"content","content":[{"anchor":"overview","text":"Overview","level":2,"type":"heading"},{"inlineContent":[{"type":"text","text":"String chunks are used to store groups of strings. Memory is"},{"type":"text","text":" "},{"type":"text","text":"allocated in blocks, and as strings are added to the "},{"code":"GStringChunk","type":"codeVoice"},{"type":"text","text":" "},{"type":"text","text":"they are copied into the next free position in a block. When a block"},{"text":" ","type":"text"},{"text":"is full a new block is allocated.","type":"text"}],"type":"paragraph"},{"type":"paragraph","inlineContent":[{"type":"text","text":"When storing a large number of strings, string chunks are more"},{"type":"text","text":" "},{"type":"text","text":"efficient than using [func"},{"type":"codeVoice","code":"GLib.strdup"},{"type":"text","text":"] since fewer calls to "},{"type":"codeVoice","code":"malloc()"},{"type":"text","text":" "},{"text":"are needed, and less memory is wasted in memory allocation overheads.","type":"text"}]},{"inlineContent":[{"type":"text","text":"By adding strings with [method"},{"type":"codeVoice","code":"GLib.StringChunk.insert_const"},{"text":"] it is also","type":"text"},{"type":"text","text":" "},{"text":"possible to remove duplicates.","type":"text"}],"type":"paragraph"},{"inlineContent":[{"type":"text","text":"To create a new "},{"code":"GStringChunk","type":"codeVoice"},{"text":" use [func","type":"text"},{"code":"GLib.StringChunk.new","type":"codeVoice"},{"text":"].","type":"text"}],"type":"paragraph"},{"type":"paragraph","inlineContent":[{"type":"text","text":"To add strings to a "},{"type":"codeVoice","code":"GStringChunk"},{"text":" use [method","type":"text"},{"type":"codeVoice","code":"GLib.StringChunk.insert"},{"text":"].","type":"text"}]},{"type":"paragraph","inlineContent":[{"text":"To add strings to a ","type":"text"},{"type":"codeVoice","code":"GStringChunk"},{"type":"text","text":", but without duplicating strings"},{"text":" ","type":"text"},{"type":"text","text":"which are already in the "},{"code":"GStringChunk","type":"codeVoice"},{"type":"text","text":", use [method"},{"code":"GLib.StringChunk.insert_const","type":"codeVoice"},{"text":"].","type":"text"}]},{"type":"paragraph","inlineContent":[{"text":"To free the entire ","type":"text"},{"type":"codeVoice","code":"GStringChunk"},{"type":"text","text":" use [method"},{"type":"codeVoice","code":"GLib.StringChunk.free"},{"type":"text","text":"]."},{"text":" ","type":"text"},{"text":"It is not possible to free individual strings.","type":"text"}]},{"type":"paragraph","inlineContent":[{"text":"The ","type":"text"},{"identifier":"doc:\/\/GLib\/documentation\/GLib\/StringChunkRef","isActive":true,"type":"reference"},{"type":"text","text":" type acts as a lightweight Swift reference to an underlying "},{"type":"codeVoice","code":"GStringChunk"},{"text":" instance.","type":"text"},{"type":"text","text":" "},{"type":"text","text":"It exposes methods that can operate on this data type through "},{"type":"reference","identifier":"doc:\/\/GLib\/documentation\/GLib\/StringChunkProtocol","isActive":true},{"type":"text","text":" conformance."},{"text":" ","type":"text"},{"type":"text","text":"Use "},{"isActive":true,"identifier":"doc:\/\/GLib\/documentation\/GLib\/StringChunkRef","type":"reference"},{"text":" only as an ","type":"text"},{"type":"codeVoice","code":"unowned"},{"text":" reference to an existing ","type":"text"},{"type":"codeVoice","code":"GStringChunk"},{"type":"text","text":" instance."}]},{"type":"aside","name":"Note","content":[{"inlineContent":[{"text":"Use ","type":"text"},{"identifier":"doc:\/\/GLib\/documentation\/GLib\/StringChunk","isActive":true,"type":"reference"},{"type":"text","text":" (instead of "},{"type":"reference","isActive":true,"identifier":"doc:\/\/GLib\/documentation\/GLib\/StringChunkRef"},{"text":") if you want to use Automatic Reference Counting for memory management of the underlying ","type":"text"},{"type":"codeVoice","code":"GStringChunk"},{"type":"text","text":" instance."}],"type":"paragraph"}],"style":"note"}]}],"kind":"symbol","variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/glib\/stringchunkref"]}],"references":{"doc://GLib/documentation/GLib/StringChunkRef/ptr":{"type":"topic","fragments":[{"text":"let","kind":"keyword"},{"text":" ","kind":"text"},{"kind":"identifier","text":"ptr"},{"text":": ","kind":"text"},{"text":"UnsafeMutableRawPointer","preciseIdentifier":"s:Sv","kind":"typeIdentifier"},{"kind":"text","text":"!"}],"identifier":"doc:\/\/GLib\/documentation\/GLib\/StringChunkRef\/ptr","abstract":[{"type":"text","text":"Untyped pointer to the underlying "},{"code":"GStringChunk","type":"codeVoice"},{"type":"text","text":" instance."},{"type":"text","text":" "},{"type":"text","text":"For type-safe access, use the generated, typed pointer "},{"code":"StringChunkProtocol\/_ptr","type":"codeVoice"},{"type":"text","text":" property instead."}],"title":"ptr","role":"symbol","kind":"symbol","url":"\/documentation\/glib\/stringchunkref\/ptr"},"doc://GLib/documentation/GLib":{"identifier":"doc:\/\/GLib\/documentation\/GLib","title":"GLib","abstract":[],"type":"topic","url":"\/documentation\/glib","kind":"symbol","role":"collection"},"doc://GLib/documentation/GLib/StringChunkRef/StringChunkProtocol-Implementations":{"type":"topic","title":"StringChunkProtocol Implementations","identifier":"doc:\/\/GLib\/documentation\/GLib\/StringChunkRef\/StringChunkProtocol-Implementations","url":"\/docu