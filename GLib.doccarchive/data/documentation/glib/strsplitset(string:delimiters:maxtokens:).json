{"kind":"symbol","sections":[],"abstract":[{"type":"text","text":"Splits "},{"type":"codeVoice","code":"string"},{"type":"text","text":" into a number of tokens not containing any of the"},{"type":"text","text":" "},{"text":"bytes in ","type":"text"},{"type":"codeVoice","code":"delimiters"},{"type":"text","text":"."}],"variants":[{"paths":["\/documentation\/glib\/strsplitset(string:delimiters:maxtokens:)"],"traits":[{"interfaceLanguage":"swift"}]}],"hierarchy":{"paths":[["doc:\/\/GLib\/documentation\/GLib"]]},"primaryContentSections":[{"kind":"declarations","declarations":[{"tokens":[{"text":"func","kind":"keyword"},{"text":" ","kind":"text"},{"text":"strsplitSet","kind":"identifier"},{"text":"(","kind":"text"},{"text":"string","kind":"externalParam"},{"text":": ","kind":"text"},{"text":"UnsafePointer","kind":"typeIdentifier","preciseIdentifier":"s:SP"},{"text":"<","kind":"text"},{"kind":"typeIdentifier","text":"gchar","preciseIdentifier":"c:@T@gchar"},{"kind":"text","text":">!, "},{"kind":"externalParam","text":"delimiters"},{"kind":"text","text":": "},{"kind":"typeIdentifier","preciseIdentifier":"s:SP","text":"UnsafePointer"},{"text":"<","kind":"text"},{"kind":"typeIdentifier","text":"gchar","preciseIdentifier":"c:@T@gchar"},{"kind":"text","text":">!, "},{"text":"maxTokens","kind":"externalParam"},{"text":": ","kind":"text"},{"kind":"typeIdentifier","preciseIdentifier":"s:Si","text":"Int"},{"kind":"text","text":") -> "},{"preciseIdentifier":"s:Sp","kind":"typeIdentifier","text":"UnsafeMutablePointer"},{"kind":"text","text":"<"},{"preciseIdentifier":"s:Sp","text":"UnsafeMutablePointer","kind":"typeIdentifier"},{"text":"<","kind":"text"},{"text":"gchar","preciseIdentifier":"c:@T@gchar","kind":"typeIdentifier"},{"text":">?>!","kind":"text"}],"languages":["swift"],"platforms":["macOS"]}]},{"content":[{"type":"heading","anchor":"discussion","text":"Discussion","level":2},{"inlineContent":[{"text":"A token is the (possibly empty) longest string that does not","type":"text"},{"type":"text","text":" "},{"text":"contain any of the bytes in ","type":"text"},{"code":"delimiters","type":"codeVoice"},{"type":"text","text":". Note that separators"},{"type":"text","text":" "},{"type":"text","text":"will only be single bytes from "},{"type":"codeVoice","code":"delimiters"},{"type":"text","text":". If "},{"code":"maxTokens","type":"codeVoice"},{"type":"text","text":" is reached,"},{"text":" ","type":"text"},{"text":"the remainder is appended to the last token.","type":"text"}],"type":"paragraph"},{"inlineContent":[{"text":"For example, the result of ","type":"text"},{"code":"g_strsplit_set (\"abc:def\/ghi\", \":\/\", -1)","type":"codeVoice"},{"text":" ","type":"text"},{"text":"is an array containing the three strings ","type":"text"},{"type":"codeVoice","code":"\"abc\""},{"text":", ","type":"text"},{"type":"codeVoice","code":"\"def\""},{"type":"text","text":", and "},{"type":"codeVoice","code":"\"ghi\""},{"text":".","type":"text"}],"type":"paragraph"},{"inlineContent":[{"text":"The result of ","type":"text"},{"code":"g_strsplit_set (\":def\/ghi:\/x\", \":\/\", -1)","type":"codeVoice"},{"type":"text","text":" is an array"},{"text":" ","type":"text"},{"type":"text","text":"containing the five strings "},{"code":"\"\"","type":"codeVoice"},{"text":", ","type":"text"},{"type":"codeVoice","code":"\"def\""},{"type":"text","text":", "},{"type":"codeVoice","code":"\"ghi\""},{"text":", ","type":"text"},{"code":"\"\"","type":"codeVoice"},{"type":"text","text":", "},{"code":"\"x\"","type":"codeVoice"},{"text":".","type":"text"}],"type":"paragraph"},{"inlineContent":[{"text":"As a special case, the result of splitting the empty string ","type":"text"},{"code":"\"\"","type":"codeVoice"},{"text":" is an empty","type":"text"},{"text":" ","type":"text"},{"type":"text","text":"array, not an array containing a single string. The reason for this"},{"type":"text","text":" "},{"text":"special case is that being able to represent an empty array is typically","type":"text"},{"type":"text","text":" "},{"type":"text","text":"more useful than consistent handling of empty elements. If you do need"},{"type":"text","text":" "},{"type":"text","text":"to represent empty elements, you’ll need to check for the empty string"},{"text":" ","type":"text"},{"text":"before calling ","type":"text"},{"type":"codeVoice","code":"g_strsplit_set()"},{"type":"text","text":"."}],"type":"paragraph"},{"type":"paragraph","inlineContent":[{"text":"Note that this function works on bytes not characters, so it can’t be used","type":"text"},{"type":"text","text":" "},{"type":"text","text":"to delimit UTF-8 strings for anything but ASCII characters."}]}],"kind":"content"}],"schemaVersion":{"major":0,"minor":3,"patch":0},"identifier":{"interfaceLanguage":"swift","url":"doc:\/\/GLib\/documentation\/GLib\/strsplitSet(string:delimiters:maxTokens:)"},"metadata":{"title":"strsplitSet(string:delimiters:maxTokens:)","role":"symbol","symbolKind":"func","modules":[{"name":"GLib"}],"fragments":[{"text":"func","kind":"keyword"},{"text":" ","kind":"text"},{"text":"strsplitSet","kind":"identifier"},{"text":"(","kind":"text"},{"text":"string","kind":"externalParam"},{"text":": ","kind":"text"},{"preciseIdentifier":"s:SP","kind":"typeIdentifier","text":"UnsafePointer"},{"kind":"text","text":"<"},{"text":"gchar","kind":"typeIdentifier","preciseIdentifier":"c:@T@gchar"},{"text":">!, ","kind":"text"},{"text":"delimiters","kind":"externalParam"},{"kind":"text","text":": "},{"kind":"typeIdentifier","preciseIdentifier":"s:SP","text":"UnsafePointer"},{"text":"<","kind":"text"},{"text":"gchar","preciseIdentifier":"c:@T@gchar","kind":"typeIdentifier"},{"kind":"text","text":">!, "},{"text":"maxTokens","kind":"externalParam"},{"kind":"text","text":": "},{"preciseIdentifier":"s:Si","text":"Int","kind":"typeIdentifier"},{"kind":"text","text":") -> "},{"preciseIdentifier":"s:Sp","text":"UnsafeMutablePointer","kind":"typeIdentifier"},{"text":"<","kind":"text"},{"preciseIdentifier":"s:Sp",