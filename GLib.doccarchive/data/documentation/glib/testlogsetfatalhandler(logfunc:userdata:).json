{"sections":[],"kind":"symbol","abstract":[{"text":"Installs a non-error fatal log handler which can be","type":"text"},{"type":"text","text":" "},{"type":"text","text":"used to decide whether log messages which are counted"},{"type":"text","text":" "},{"type":"text","text":"as fatal abort the program."}],"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/glib\/testlogsetfatalhandler(logfunc:userdata:)"]}],"primaryContentSections":[{"kind":"declarations","declarations":[{"tokens":[{"text":"func","kind":"keyword"},{"text":" ","kind":"text"},{"text":"testLogSetFatalHandler","kind":"identifier"},{"kind":"text","text":"("},{"kind":"externalParam","text":"logFunc"},{"text":": ","kind":"text"},{"kind":"typeIdentifier","text":"GTestLogFatalFunc","preciseIdentifier":"c:@T@GTestLogFatalFunc"},{"text":"?, ","kind":"text"},{"text":"userData","kind":"externalParam"},{"text":": ","kind":"text"},{"preciseIdentifier":"c:@T@gpointer","text":"gpointer","kind":"typeIdentifier"},{"kind":"text","text":"? = nil)"}],"languages":["swift"],"platforms":["macOS"]}]},{"kind":"content","content":[{"text":"Discussion","type":"heading","anchor":"discussion","level":2},{"inlineContent":[{"type":"text","text":"The use case here is that you are running a test case"},{"text":" ","type":"text"},{"text":"that depends on particular libraries or circumstances","type":"text"},{"type":"text","text":" "},{"text":"and cannot prevent certain known critical or warning","type":"text"},{"type":"text","text":" "},{"text":"messages. So you install a handler that compares the","type":"text"},{"text":" ","type":"text"},{"type":"text","text":"domain and message to precisely not abort in such a case."}],"type":"paragraph"},{"type":"paragraph","inlineContent":[{"text":"Note that the handler is reset at the beginning of","type":"text"},{"type":"text","text":" "},{"text":"any test case, so you have to set it inside each test","type":"text"},{"type":"text","text":" "},{"type":"text","text":"function which needs the special behavior."}]},{"inlineContent":[{"type":"text","text":"This handler has no effect on g_error messages."}],"type":"paragraph"},{"type":"paragraph","inlineContent":[{"type":"text","text":"This handler also has no effect on structured log messages (using"},{"type":"text","text":" "},{"type":"text","text":"[func"},{"type":"codeVoice","code":"GLib.log_structured"},{"text":"] or [func","type":"text"},{"code":"GLib.log_structured_array","type":"codeVoice"},{"type":"text","text":"]). To change the fatal"},{"text":" ","type":"text"},{"text":"behaviour for specific log messages, programs must install a custom log","type":"text"},{"text":" ","type":"text"},{"type":"text","text":"writer function using [func"},{"code":"GLib.log_set_writer_func","type":"codeVoice"},{"text":"].See","type":"text"},{"type":"text","text":" "},{"identifier":"logging.html#using-structured-logging","type":"reference","isActive":true},{"text":".","type":"text"}]}]}],"metadata":{"fragments":[{"text":"func","kind":"keyword"},{"text":" ","kind":"text"},{"kind":"identifier","text":"testLogSetFatalHandler"},{"kind":"text","text":"("},{"text":"logFunc","kind":"externalParam"},{"kind":"text","text":": "},{"kind":"typeIdentifier","preciseIdentifier":"c:@T@GTestLogFatalFunc","text":"GTestLogFatalFunc"},{"text":"?, ","kind":"text"},{"text":"userData","kind":"externalParam"},{"kind":"text","text":": "},{"kind":"typeIdentifier","preciseIdentifier":"c:@T@gpointer","text":"gpointer"},{"text":"?)","kind":"text"}],"symbolKind":"func","modules":[{"name":"GLib"}],"roleHeading":"Function","title":"testLogSetFatalHandler(logFunc:userData:)","role":"symbol","externalID":"s:4GLib22testLogSetFatalHandler7logFunc8userDatays5Int32VSPys4Int8VGSg_So14GLogLevelFlagsaAJSvSgtXCSg_AMtF"},"identifier":{"url":"doc:\/\/GLib\/documentation\/GLib\/testLogSetFatalHandler(logFunc:userData:)","interfaceLanguage":"swift"},"schemaVersion":{"major":0,"minor":3,"patch":0},"hierarchy":{"paths":[["doc:\/\/GLib\/docu