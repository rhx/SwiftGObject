{"schemaVersion":{"patch":0,"minor":3,"major":0},"kind":"symbol","metadata":{"extendedModule":"GLib","modules":[{"name":"GLib"}],"symbolKind":"method","title":"waitUntil(mutex:endTime:)","fragments":[{"kind":"keyword","text":"func"},{"text":" ","kind":"text"},{"text":"waitUntil","kind":"identifier"},{"kind":"text","text":"<"},{"text":"MutexT","kind":"genericParameter"},{"kind":"text","text":">("},{"text":"mutex","kind":"externalParam"},{"text":": ","kind":"text"},{"text":"MutexT","kind":"typeIdentifier"},{"text":", ","kind":"text"},{"text":"endTime","kind":"externalParam"},{"text":": ","kind":"text"},{"kind":"typeIdentifier","text":"gint64","preciseIdentifier":"c:@T@gint64"},{"text":") -> ","kind":"text"},{"preciseIdentifier":"s:Sb","text":"Bool","kind":"typeIdentifier"}],"role":"symbol","externalID":"s:4GLib12CondProtocolPAAE9waitUntil5mutex7endTimeSbqd___s5Int64VtAA05MutexC0Rd__lF::SYNTHESIZED::s:4GLib4CondC","roleHeading":"Instance Method"},"hierarchy":{"paths":[["doc:\/\/GLib\/documentation\/GLib","doc:\/\/GLib\/documentation\/GLib\/Cond","doc:\/\/GLib\/documentation\/GLib\/Cond\/CondProtocol-Implementations"]]},"primaryContentSections":[{"kind":"declarations","declarations":[{"languages":["swift"],"tokens":[{"kind":"keyword","text":"func"},{"text":" ","kind":"text"},{"kind":"identifier","text":"waitUntil"},{"text":"<","kind":"text"},{"text":"MutexT","kind":"genericParameter"},{"kind":"text","text":">("},{"text":"mutex","kind":"externalParam"},{"kind":"text","text":": "},{"text":"MutexT","kind":"typeIdentifier"},{"text":", ","kind":"text"},{"text":"endTime","kind":"externalParam"},{"kind":"text","text":": "},{"text":"gint64","kind":"typeIdentifier","preciseIdentifier":"c:@T@gint64"},{"text":") -> ","kind":"text"},{"kind":"typeIdentifier","preciseIdentifier":"s:Sb","text":"Bool"},{"text":" ","kind":"text"},{"text":"where","kind":"keyword"},{"text":" ","kind":"text"},{"text":"MutexT","kind":"typeIdentifier"},{"kind":"text","text":" : "},{"identifier":"doc:\/\/GLib\/documentation\/GLib\/MutexProtocol","text":"MutexProtocol","preciseIdentifier":"s:4GLib13MutexProtocolP","kind":"typeIdentifier"}],"platforms":["macOS"]}]},{"kind":"content","content":[{"level":2,"type":"heading","anchor":"discussion","text":"Discussion"},{"type":"paragraph","inlineContent":[{"text":"As with ","type":"text"},{"type":"codeVoice","code":"g_cond_wait()"},{"text":" it is possible that a spurious or stolen wakeup","type":"text"},{"type":"text","text":" "},{"type":"text","text":"could occur.  For that reason, waiting on a condition variable should"},{"text":" ","type":"text"},{"type":"text","text":"always be in a loop, based on an explicitly-checked predicate."}]},{"inlineContent":[{"type":"codeVoice","code":"true"},{"text":" is returned if the condition variable was signalled (or in the","type":"text"},{"type":"text","text":" "},{"text":"case of a spurious wakeup).  ","type":"text"},{"type":"codeVoice","code":"false"},{"text":" is returned if ","type":"text"},{"type":"codeVoice","code":"endTime"},{"type":"text","text":" has"},{"type":"text","text":" "},{"type":"text","text":"passed."}],"type":"paragraph"},{"type":"paragraph","inlineContent":[{"type":"text","text":"The following code shows how to correctly perform a timed wait on a"},{"type":"text","text":" "},{"type":"text","text":"condition variable (extending the example presented in the"},{"text":" ","type":"text"},{"type":"text","text":"documentation for "},{"identifier":"doc:\/\/GLib\/documentation\/GLib\/Cond","isActive":true,"type":"reference"},{"text":"):","type":"text"}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"(C Language Example):"}]},{"type":"codeListing","syntax":"C","code":["gpointer","pop_data_timed (void)","{","  gint64 end_time;","  gpointer data;","","  g_mutex_lock (&data_mutex);","","  end_time = g_get_monotonic_time () + 5 * G_TIME_SPAN_SECOND;","  while (!current_data)","    if (!g_cond_wait_until (&data_cond, &data_mutex, end_time))","      {","        \/\/ timeout has passed.","        g_mutex_unlock (&data_mutex);","        return NULL;","      }","","  \/\/ there is data for us","  data = current_data;","  current_data = NULL;","","  g_mutex_unlock (&data_mutex);","","  return data;","}"]},{"inlineContent":[{"text":"Notice that the end time is calculated once, before entering the","type":"text"},{"type":"text","text":" "},{"type":"text","text":"loop and reused.  This is the motivation behind the use of absolute"},{"text":" ","type":"text"},{"type":"text","text":"time on this API – if a relative time of 5 seconds were passed"},{"text":" ","type":"text"},{"type":"text","text":"directly to the call and a spurious wakeup occurred, the program would"},{"type":"text","text":" "},{"type":"text","text":"have to start over waiting again (which would lead to a total wait"},{"type":"text","text":" "},{"text":"time of more than 5 seconds).","type":"text"}],"type":"paragraph"}]}],"sections":[],"abstract":[{"type":"text","text":"Waits until either "},{"code":"cond","type":"codeVoice"},{"type":"text","text":" is signalled or "},{"type":"codeVoice","code":"endTime"},{"text":" has passed.","type":"text"}],"identifier":{"url":"doc:\/\/GLib\/documentation\/GLib\/Cond\/waitUntil(mutex:endTime:)","interfaceLanguage":"swift"},"variants":[{"paths":["\/documentation\/glib\/cond\/waituntil(mutex:endtime:)"],"traits":[{"interfaceLanguage":"swift"}]}],"references":{"doc://GLib/documentation/GLib/Cond/CondProtocol-Implementations":{"abstract":[],"title":"CondProtocol Implementations","identifier":"doc:\/\/GLib\/documentation\/GLib\/Cond\/CondProtocol-Implementations","type":"topic","role":"collectionGroup","url":"\/documentation\/glib\/cond\/condprotocol-implementations","kind":"article"},"doc://GLib/documentation/GLib/Mutex":{"abstract":[{"type":"text","text":"The "},{"isActive":true,"type":"reference","identifier":"doc:\/\/GLib\/documentation\/GLib\/Mutex"},{"type":"text","text":" struct is an opaque data structure to represent a mutex"},{"type":"text","text":" "},{"text":"(mutual exclusion). It can be used to protect data against shared","type":"text"},{"type":"text","text":" "},{"type":"text","text":"access."}],"fragments":[{"text":"class","kind":"keyword"},{"kind":"text","text":" "},{"text":"Mutex","kind":"identifier"}],"navigatorTitle":[{"text":"Mutex","kind":"identifier"}],"kind":"symbol","type":"topic","role":"symbol","title":"Mutex","identifier":"doc:\/\/GLib\/documentation\/GLib\/Mutex","url":"\/documentation\/glib\/mutex"},"doc://GLib/documentation/GLib":{"identifier":"doc:\/\/GLib\/documentation\/GLib","title":"GLib","abstract":[],"type":"topic","url":"\/documentation\/glib","kind":"symbol","role":"collection"},"doc://GLib/documentation/GLib/MutexProtocol":{"title":"MutexProtocol","kind":"symbol","fragments":[{"text":"protocol","kind":"keyword"},{"text":" ","kind":"text"},{"text":"MutexProtocol","kind":"identifier"}],"role":"symbol","abstract":[{"type":"text","text":"The "},{"isActive":true,"type":"reference","identifier":"doc:\/\/GLib\/documentation\/GLib\/Mutex"},{"type":"text","text":" struct is an opaque data structure to represent a mutex"},{"type":"text","text":" "},{"type":"text","text":"(mutual exclusion). It can be used to protect data against shared"},{"text":" ","type":"text"},{"type":"text","text":"access."}],"identifier":"doc:\/\/GLib\/documentation\/GLib\/MutexProtocol","url":"\/documentation\/glib\/mutexprotocol","type":"topic","navigatorTitle":[{"kind":"identifier","text":"MutexProtocol"}]},"doc://GLib/documentation/GLib/Cond/waitUntil(mutex:endTime:)":{"abstract":[{"type":"text","text":"Waits until either "},{"type":"codeVoice","code":"cond"},{"type":"text","text":" is signalled or "},{"type":"codeVoice","code":"endTime"},{"type":"text","text":" has passed."}],"title":"waitUntil(mutex:endTime:)","url":"\/documentation\/glib\/cond\/waituntil(mutex:endtime:)","kind":"symbol","fragments":[{"kind":"keyword","text":"func"},{"text":" ","kind":"text"},{"text":"waitUntil","kind":"identifier"},{"text":"<","kind":"text"},{"kind":"genericParameter","text":"MutexT"},{"kind":"text","text":">("},{"text":"mutex","kind":"externalParam"},{"text":": ","kind":"text"},{"text":"MutexT","kind":"typeIdentifier"},{"text":", ","kind":"text"},{"kind":"externalParam","text":"endTime"},{"kind":"text","text":": "},{"text":"gint64","kind":"typeIdentifier","preciseIdentifier":"c:@T@gint64"},{"text":") -> ","kind":"text"},{"text":"Bool","kind":"typeIdentifier","preciseIdentifier":"s:Sb"}],"role":"symbol","identifier":"doc:\/\/GLib\/documentation\/GLib\/Cond\/waitUntil(mutex:endTime:)","type":"topic"},"doc://GLib/documentation/GLib/Cond":{"identifier":"doc:\/\/GLib\/documentation\/GLib\/Cond","type":"topic","fragments":[{"kind":"keyword","text":"class"},{"text":" ","kind":"text"},{"kind":"identifier","text":"Cond"}],"role":"symbol","title":"Cond","kind":"symbol","navigatorTitle":[{"kind":"identifier","text":"Cond"}],"abstract":[{"type":"text","text":"The "},{"identifier":"doc:\/\/GLib\/documentation\/GLib\/Cond","isActive":true,"type":"reference"},{"text":" struct is an opaque data structure that represents a","type":"text"},{"type":"text","text":" "},{"type":"text","text":"condition. Threads can block on a "},{"type":"reference","identifier":"doc:\/\/GLib\/documentation\/GLib\/Cond","isActive":true},{"type":"text","text":" if they find a certain"},{"type":"text","text":" "},{"type":"text","text":"condition to be false. If other threads change the state of this"},{"text":" ","type":"text"},{"text":"condition they signal the ","type":"text"},{"type":"reference","isActive":true,"identifier":"doc:\/\/GLib\/documentation\/GLib\/Cond"},{"type":"text","text":", and that causes the waiting"},{"text":" ","type":"text"},{"text":"threads to be woken up.","type":"text"}],"url":"\/documentation\/glib\/cond"}}}