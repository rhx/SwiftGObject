{"kind":"symbol","sections":[],"abstract":[{"type":"text","text":"Breaks the string on the pattern, and returns an array of"},{"type":"text","text":" "},{"text":"the tokens. If the pattern contains capturing parentheses,","type":"text"},{"text":" ","type":"text"},{"type":"text","text":"then the text for each of the substrings will also be returned."},{"text":" ","type":"text"},{"text":"If the pattern does not match anywhere in the string, then the","type":"text"},{"type":"text","text":" "},{"type":"text","text":"whole string is returned as the first token."}],"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/glib\/regexsplitsimple(pattern:string:compileoptions:matchoptions:)"]}],"hierarchy":{"paths":[["doc:\/\/GLib\/documentation\/GLib"]]},"primaryContentSections":[{"kind":"declarations","declarations":[{"platforms":["macOS"],"tokens":[{"text":"func","kind":"keyword"},{"text":" ","kind":"text"},{"text":"regexSplitSimple","kind":"identifier"},{"kind":"text","text":"("},{"kind":"externalParam","text":"pattern"},{"kind":"text","text":": "},{"kind":"typeIdentifier","preciseIdentifier":"s:SP","text":"UnsafePointer"},{"text":"<","kind":"text"},{"preciseIdentifier":"c:@T@gchar","text":"gchar","kind":"typeIdentifier"},{"kind":"text","text":">!, "},{"kind":"externalParam","text":"string"},{"text":": ","kind":"text"},{"kind":"typeIdentifier","preciseIdentifier":"s:SP","text":"UnsafePointer"},{"kind":"text","text":"<"},{"kind":"typeIdentifier","preciseIdentifier":"c:@T@gchar","text":"gchar"},{"kind":"text","text":">!, "},{"kind":"externalParam","text":"compileOptions"},{"text":": ","kind":"text"},{"kind":"typeIdentifier","preciseIdentifier":"s:4GLib17RegexCompileFlagsV","identifier":"doc:\/\/GLib\/documentation\/GLib\/RegexCompileFlags","text":"RegexCompileFlags"},{"text":", ","kind":"text"},{"text":"matchOptions","kind":"externalParam"},{"text":": ","kind":"text"},{"text":"RegexMatchFlags","identifier":"doc:\/\/GLib\/documentation\/GLib\/RegexMatchFlags","kind":"typeIdentifier","preciseIdentifier":"s:4GLib15RegexMatchFlagsV"},{"text":") -> ","kind":"text"},{"kind":"typeIdentifier","preciseIdentifier":"s:Sp","text":"UnsafeMutablePointer"},{"kind":"text","text":"<"},{"text":"UnsafeMutablePointer","preciseIdentifier":"s:Sp","kind":"typeIdentifier"},{"kind":"text","text":"<"},{"kind":"typeIdentifier","preciseIdentifier":"c:@T@gchar","text":"gchar"},{"text":">?>!","kind":"text"}],"languages":["swift"]}]},{"kind":"content","content":[{"level":2,"type":"heading","text":"Discussion","anchor":"discussion"},{"type":"paragraph","inlineContent":[{"text":"This function is equivalent to ","type":"text"},{"code":"g_regex_split()","type":"codeVoice"},{"type":"text","text":" but it does"},{"text":" ","type":"text"},{"text":"not require to compile the pattern with ","type":"text"},{"code":"g_regex_new()","type":"codeVoice"},{"text":", avoiding","type":"text"},{"type":"text","text":" "},{"text":"some lines of code when you need just to do a split without","type":"text"},{"type":"text","text":" "},{"type":"text","text":"extracting substrings, capture counts, and so on."}]},{"inlineContent":[{"text":"If this function is to be called on the same ","type":"text"},{"type":"codeVoice","code":"pattern"},{"type":"text","text":" more than"},{"type":"text","text":" "},{"text":"once, it’s more efficient to compile the pattern once with","type":"text"},{"text":" ","type":"text"},{"code":"g_regex_new()","type":"codeVoice"},{"type":"text","text":" and then use "},{"type":"codeVoice","code":"g_regex_split()"},{"type":"text","text":"."}],"type":"paragraph"},{"type":"paragraph","inlineContent":[{"text":"As a special case, the result of splitting the empty string “”","type":"text"},{"type":"text","text":" "},{"type":"text","text":"is an empty vector, not a vector containing a single string."},{"text":" ","type":"text"},{"text":"The reason for this special case is that being able to represent","type":"text"},{"type":"text","text":" "},{"type":