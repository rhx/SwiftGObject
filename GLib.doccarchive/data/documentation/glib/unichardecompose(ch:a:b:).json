":"canonical decomposition for ","type":"text"},{"code":"ch","type":"codeVoice"},{"text":", one would need to","type":"text"},{"type":"text","text":" "},{"type":"text","text":"recursively call this function on "},{"code":"a","type":"codeVoice"},{"type":"text","text":".  Or use"},{"type":"text","text":" "},{"code":"g_unichar_fully_decompose()","type":"codeVoice"},{"type":"text","text":"."}],"type":"paragraph"},{"type":"paragraph","inlineContent":[{"text":"See","type":"text"},{"type":"text","text":" "},{"type":"reference","identifier":"http:\/\/unicode.org\/reports\/tr15\/","isActive":true},{"type":"text","text":" "},{"type":"text","text":"for details."}]}]}],"kind":"symbol","variants":[{"paths":["\/documentation\/glib\/unichardecompose(ch:a:b:)"],"traits":[{"interfaceLanguage":"swift"}]}],"hierarchy":{"paths":[["doc:\/\/GLib\/documentation\/GLib"]]},"abstract":[{"type":"text","text":"Performs a single decomposition step of the"},{"text":" ","type":"text"},{"type":"text","text":"Unicode canonical decomposition algorithm."}],"references":{"http://unicode.org/reports/tr15/":{"titleInlineContent":[{"text":"UAX","type":"text"},{"type":"codeVoice","code":"15"}],"url":"http:\/\/unicode.org\/reports\/tr15\/","title":"UAX15","type":"link","identifier":"http:\/\/unicode.org\/reports\/tr15\/"},"doc://GLib/documentation/GLib/unicharDecompose(ch:a:b:)":{"fragments":[{"text":"func","kind":"keyword"},{"kind":"text","text":" "},{"text":"unicharDecompose","kind":"identifier"},{"kind":"text","text":"("},{"kind":"externalParam","text":"ch"},{"text":": ","kind":"text"},{"text":"gunichar","kind":"typeIdentifier","preciseIdentifier":"c:@T@gunichar"},{"text":", ","kind":"text"},{"kind":"externalParam","text":"a"},{"kind":"text","text":": "},{"kind":"typeIdentifier","text":"UnsafeMutablePointer","preciseIdentifier":"s:Sp"},{"kind":"text","text":"<"},{"kind":"typeIdentifier","text":"gunichar","preciseIdentifier":"c:@T@gunichar"},{"kind":"text","text":">!, "},{"text":"b","kind":"externalParam