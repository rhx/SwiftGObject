de":"0","type":"codeVoice"},{"text":") then the source will be","type":"text"},{"type":"text","text":" "},{"text":"dispatched immediately.","type":"text"}],"type":"paragraph"},{"type":"paragraph","inlineContent":[{"type":"text","text":"If "},{"code":"readyTime","type":"codeVoice"},{"type":"text","text":" is "},{"code":"-1","type":"codeVoice"},{"text":" then the source is never woken up on the basis","type":"text"},{"type":"text","text":" "},{"type":"text","text":"of the passage of time."}]},{"inlineContent":[{"text":"Dispatching the source does not reset the ready time.  You should do","type":"text"},{"text":" ","type":"text"},{"text":"so yourself, from the source dispatch function.","type":"text"}],"type":"paragraph"},{"type":"paragraph","inlineContent":[{"text":"Note that if you have a pair of sources where the ready time of one","type":"text"},{"text":" ","type":"text"},{"text":"suggests that it will be delivered first but the priority for the","type":"text"},{"type":"text","text":" "},{"text":"other suggests that it would be delivered first, and the ready time","type":"text"},{"type":"text","text":" "},{"type":"text","text":"for both sources is reached during the same main context iteration,"},{"text":" ","type":"text"},{"text":"then the order of dispatch is undefined.","type":"text"}]},{"inlineContent":[{"type":"text","text":"It is a no-op to call this function on a [struct"},{"isActive":true,"type":"reference","identifier":"doc:\/\/GLib\/documentation\/GLib\/Source"},{"type":"text","text":"] which has"},{"type":"text","text":" "},{"text":"already been destroyed with [method","type":"text"},{"type":"codeVoice","code":"GLib.Source.destroy"},{"type":"text","text":"]."}],"type":"paragraph"},{"type":"paragraph","inlineContent":[{"type":"text","text":"This API is only intended to be used by implementations of [struct"},{"isActive":true,"identifier":"doc:\/\/GLib\/documentation\/GLib\/Source","type":"reference"},{"type":"text","text":"]."},{"type":"text","text":" "},