{"metadata":{"extendedModule":"GLib","title":"push(parser:userData:)","roleHeading":"Instance Method","symbolKind":"method","fragments":[{"kind":"keyword","text":"func"},{"kind":"text","text":" "},{"kind":"identifier","text":"push"},{"text":"<","kind":"text"},{"text":"MarkupParserT","kind":"genericParameter"},{"text":">(","kind":"text"},{"text":"parser","kind":"externalParam"},{"text":": ","kind":"text"},{"text":"MarkupParserT","kind":"typeIdentifier"},{"kind":"text","text":", "},{"text":"userData","kind":"externalParam"},{"text":": ","kind":"text"},{"preciseIdentifier":"c:@T@gpointer","text":"gpointer","kind":"typeIdentifier"},{"kind":"text","text":"?)"}],"role":"symbol","externalID":"s:4GLib26MarkupParseContextProtocolPAAE4push6parser8userDatayqd___SvSgtAA0b6ParserE0Rd__lF::SYNTHESIZED::s:4GLib21MarkupParseContextRefV","modules":[{"name":"GLib"}]},"abstract":[{"text":"Temporarily redirects markup data to a sub-parser.","type":"text"}],"identifier":{"interfaceLanguage":"swift","url":"doc:\/\/GLib\/documentation\/GLib\/MarkupParseContextRef\/push(parser:userData:)"},"primaryContentSections":[{"declarations":[{"platforms":["macOS"],"languages":["swift"],"tokens":[{"text":"func","kind":"keyword"},{"kind":"text","text":" "},{"text":"push","kind":"identifier"},{"text":"<","kind":"text"},{"text":"MarkupParserT","kind":"genericParameter"},{"text":">(","kind":"text"},{"text":"parser","kind":"externalParam"},{"text":": ","kind":"text"},{"kind":"typeIdentifier","text":"MarkupParserT"},{"kind":"text","text":", "},{"kind":"externalParam","text":"userData"},{"text":": ","kind":"text"},{"preciseIdentifier":"c:@T@gpointer","kind":"typeIdentifier","text":"gpointer"},{"text":"? = nil) ","kind":"text"},{"kind":"keyword","text":"where"},{"kind":"text","text":" "},{"kind":"typeIdentifier","text":"MarkupParserT"},{"kind":"text","text":" : "},{"text":"MarkupParserProtocol","preciseIdentifier":"s:4GLib20MarkupParserProtocolP","identifier":"doc:\/\/GLib\/documentation\/GLib\/MarkupParserProtocol","kind":"typeIdentifier"}]}],"kind":"declarations"},{"content":[{"anchor":"discussion","type":"heading","level":2,"text":"Discussion"},{"inlineContent":[{"text":"This function may only be called from the start_element handler of","type":"text"},{"text":" ","type":"text"},{"text":"a ","type":"text"},{"isActive":true,"type":"reference","identifier":"doc:\/\/GLib\/documentation\/GLib\/MarkupParser"},{"type":"text","text":". It must be matched with a corresponding call to"},{"type":"text","text":" "},{"code":"g_markup_parse_context_pop()","type":"codeVoice"},{"text":" in the matching end_element handler","type":"text"},{"text":" ","type":"text"},{"text":"(except in the case that the parser aborts due to an error).","type":"text"}],"type":"paragraph"},{"type":"paragraph","inlineContent":[{"type":"text","text":"All tags, text and other data between the matching tags is"},{"type":"text","text":" "},{"type":"text","text":"redirected to the subparser given by "},{"type":"codeVoice","code":"parser"},{"type":"text","text":". "},{"code":"userData","type":"codeVoice"},{"type":"text","text":" is used"},{"text":" ","type":"text"},{"type":"text","text":"as the user_data for that parser. "},{"type":"codeVoice","code":"userData"},{"text":" is also passed to the","type":"text"},{"text":" ","type":"text"},{"type":"text","text":"error callback in the event that an error occurs. This includes"},{"type":"text","text":" "},{"type":"text","text":"errors that occur in subparsers of the subparser."}]},{"type":"paragraph","inlineContent":[{"text":"The end tag matching the start tag for which this call was made is","type":"text"},{"type":"text","text":" "},{"type":"text","text":"handled by the previous parser (which is given its own user_data)"},{"type":"text","text":" "},{"type":"text","text":"which is why "},{"code":"g_markup_parse_context_pop()","type":"codeVoice"},{"type":"text","text":" is provided to allow “one"},{"text":" ","type":"text"},{"type":"text","text":"last access” to the "},{"code":"userData","type":"codeVoice"},{"type":"text","text":" provided to this function. In the"},{"type":"text","text":" "},{"type":"text","text":"case of error, the "},{"type":"codeVoice","code":"userData"},{"text":" provided here is passed directly to","type":"text"},{"type":"text","text":" "},{"text":"the error callback of the subparser and ","type":"text"},{"type":"codeVoice","code":"g_markup_parse_context_pop()"},{"type":"text","text":" "},{"text":"should not be called. In either case, if ","type":"text"},{"type":"codeVoice","code":"userData"},{"type":"text","text":" was allocated"},{"type":"text","text":" "},{"text":"then it ought to be freed from both of these locations.","type":"text"}]},{"inlineContent":[{"text":"This function is not intended to be directly called by users","type":"text"},{"text":" ","type":"text"},{"text":"interested in invoking subparsers. Instead, it is intended to be","type":"text"},{"text":" ","type":"text"},{"type":"text","text":"used by the subparsers themselves to implement a higher-level"},{"type":"text","text":" "},{"text":"interface.","type":"text"}],"type":"paragraph"},{"inlineContent":[{"text":"As an example, see the following implementation of a simple","type":"text"},{"type":"text","text":" "},{"type":"text","text":"parser that counts the number of tags encountered."}],"type":"paragraph"},{"type":"paragraph","inlineContent":[{"text":"(C Language Example):","type":"text"}]},{"syntax":"C","code":["typedef struct","{","  gint tag_count;","} CounterData;","","static void","counter_start_element (GMarkupParseContext  *context,","                       const gchar          *element_name,","                       const gchar         **attribute_names,","                       const gchar         **attribute_values,","                       gpointer              user_data,","                       GError              **error)","{","  CounterData *data = user_data;","","  data->tag_count++;","}","","static void","counter_error (GMarkupParseContext *context,","               GError              *error,","               gpointer             user_data)","{","  CounterData *data = user_data;","","  g_slice_free (CounterData, data);","}","","static GMarkupParser counter_subparser =","{","  counter_start_element,","  NULL,","  NULL,","  NULL,","  counter_error","};"],"type":"codeListing"},{"type":"paragraph","inlineContent":[{"type":"text","text":"In order to allow this parser to be easily used as a subparser, the"},{"type":"text","text":" "},{"text":"following interface is provided:","type":"text"}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"(C Language Example):"}]},{"type":"codeListing","code":["void","start_counting (GMarkupParseContext *context)","{","  CounterData *data = g_slice_new (CounterData);","","  data->tag_count = 0;","  g_markup_parse_context_push (context, &counter_subparser, data);","}","","gint","end_counting (GMarkupParseContext *context)","{","  CounterData *data = g_markup_parse_context_pop (context);","  int result;","","  result = data->tag_count;","  g_slice_free (CounterData, data);","","  return result;","}"],"syntax":"C"},{"type":"paragraph","inlineContent":[{"type":"text","text":"The subparser would then be used as follows:"}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"(C Language Example):"}]},{"type":"codeListing","code":["static void start_element (context, element_name, ...)","{","  if (strcmp (element_name, \"count-these\") == 0)","    start_counting (context);","","  \/\/ else, handle other tags...","}","","static void end_element (context, element_name, ...)","{","  if (strcmp (element_name, \"count-these\") == 0)","    g_print (\"Counted %d tags\\n\", end_counting (context));","","  \/\/ else, handle other tags...","}"],"syntax":"C"}],"kind":"content"}],"sections":[],"schemaVersion":{"minor":3,"patch":0,"major":0},"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/glib\/markupparsecontextref\/push(parser:userdata:)"]}],"kind":"symbol","hierarchy":{"paths":[["doc:\/\/GLib\/documentation\/GLib","doc:\/\/GLib\/documentation\/GLib\/MarkupParseContextRef","doc:\/\/GLib\/documentation\/GLib\/MarkupParseContextRef\/MarkupParseContextProtocol-Implementations"]]},"references":{"doc://GLib/documentation/GLib":{"identifier":"doc:\/\/GLib\/documentation\/GLib","title":"GLib","abstract":[],"type":"topic","url":"\/documentation\/glib","kind":"symbol","role":"collection"},"doc://GLib/documentation/GLib/MarkupParserProtocol":{"kind":"symbol","role":"symbol","fragments":[{"text":"protocol","kind":"keyword"},{"text":" ","kind":"text"},{"kind":"identifier","text":"MarkupParserProtocol"}],"abstract":[{"type":"text","text":"Any of the fields in "},{"isActive":true,"type":"reference","identifier":"doc:\/\/GLib\/documentation\/GLib\/MarkupParser"},{"type":"text","text":" can be "},{"type":"codeVoice","code":"nil"},{"text":", in which case they","type":"text"},{"text":" ","type":"text"},{"type":"text","text":"will be ignored. Except for the "},{"code":"error","type":"codeVoice"},{"text":" function, any of these callbacks","type":"text"},{"type":"text","text":" "},{"type":"text","text":"can set an error; in particular the "},{"code":"unknownElement","type":"codeVoice"},{"text":",","type":"text"},{"type":"text","text":" "},{"type":"codeVoice","code":"unknownAttribute"},{"type":"text","text":", and "},{"type":"codeVoice","code":"invalidContent"},{"text":" ","type":"text"},{"text":"errors are intended to be set from these callbacks. If you set an error","type":"text"},{"text":" ","type":"text"},{"text":"from a callback, ","type":"text"},{"type":"codeVoice","code":"g_markup_parse_context_parse()"},{"type":"text","text":" will report that error"},{"text":" ","type":"text"},{"text":"back to its caller.","type":"text"}],"identifier":"doc:\/\/GLib\/documentation\/GLib\/MarkupParserProtocol","navigatorTitle":[{"kind":"identifier","text":"MarkupParserProtocol"}],"url":"\/documentation\/glib\/markupparserprotocol","type":"topic","title":"MarkupParserProtocol"},"doc://GLib/documentation/GLib/MarkupParser":{"fragments":[{"text":"class","kind":"keyword"},{"text":" ","kind":"text"},{"text":"MarkupParser","kind":"identifier"}],"role":"symbol","navigatorTitle":[{"text":"MarkupParser","kind":"identifier"}],"abstract":[{"type":"text","text":"Any of the fields in "},{"type":"reference","identifier":"doc:\/\/GLib\/documentation\/GLib\/MarkupParser","isActive":true},{"text":" can be ","type":"text"},{"type":"codeVoice","code":"nil"},{"text":", in which case they","type":"text"},{"type":"text","text":" "},{"type":"text","text":"will be ignored. Except for the "},{"code":"error","type":"codeVoice"},{"text":" function, any of these callbacks","type":"text"},{"type":"text","text":" "},{"text":"can set an error; in particular the ","type":"text"},{"code":"unknownElement","type":"codeVoice"},{"text":",","type":"text"},{"text":" ","type":"text"},{"code":"unknownAttribute","type":"codeVoice"},{"text":", and ","type":"text"},{"type":"codeVoice","code":"invalidContent"},{"text":" ","type":"text"},{"type":"text","text":"errors are intended to be set from these callbacks. If you set an error"},{"type":"text","text":" "},{"type":"text","text":"from a callback, "},{"type":"codeVoice","code":"g_markup_parse_context_parse()"},{"text":" will report that error","type":"text"},{"type":"text","text":" "},{"text":"back to its caller.","type":"text"}],"title":"MarkupParser","type":"topic","identifier":"doc:\/\/GLib\/documentation\/GLib\/MarkupParser","url":"\/documentation\/glib\/markupparser","kind":"symbol"},"doc://GLib/documentation/GLib/MarkupParseContextRef/push(parser:userData:)":{"type":"topic","kind":"symbol","title":"push(parser:userData:)","url":"\/documentation\/glib\/markupparsecontextref\/push(parser:userdata:)","identifier":"doc:\/\/GLib\/documentation\/GLib\/MarkupParseContextRef\/push(parser:userData:)","fragments":[{"text":"func","kind":"keyword"},{"text":" ","kind":"text"},{"text":"push","kind":"identifier"},{"text":"<","kind":"text"},{"text":"MarkupParserT","kind":"genericParameter"},{"kind":"text","text":">("},{"text":"parser","kind":"externalParam"},{"text":": ","kind":"text"},{"kind":"typeIdentifier","text":"MarkupParserT"},{"text":", ","kind":"text"},{"text":"userData","kind":"externalParam"},{"kind":"text","text":": "},{"preciseIdentifier":"c:@T@gpointer","kind":"typeIdentifier","text":"gpointer"},{"kind":"text","text":"?)"}],"role":"symbol","abstract":[{"type":"text","text":"Temporarily redirects markup data to a sub-parser."}]},"doc://GLib/documentation/GLib/MarkupParseContextRef/MarkupParseContextProtocol-Implementations":{"identifier":"doc:\/\/GLib\/documentation\/GLib\/MarkupParseContextRef\/MarkupParseContextProtocol-Implementations","type":"topic","role":"collectionGroup","kind":"article","abstract":[],"url":"\/documentation\/glib\/markupparsecontextref\/markupparsecontextprotocol-implementations","title":"MarkupParseContextProtocol Implementations"},"doc://GLib/documentation/GLib/MarkupParseContextRef":{"fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"MarkupParseContextRef"}],"role":"symbol","navigatorTitle":[{"kind":"identifier","text":"MarkupParseContextRef"}],"abstract":[{"text":"A parse context is used to parse a stream of bytes that","type":"text"},{"type":"text","text":" "},{"text":"you expect to contain marked-up text.","type":"text"}],"type":"topic","title":"MarkupParseContextRef","identifier":"doc:\/\/GLib\/documentation\/GLib\/MarkupParseContextRef","kind":"symbol","url":"\/documentation\/glib\/markupparsecontextref"}}}