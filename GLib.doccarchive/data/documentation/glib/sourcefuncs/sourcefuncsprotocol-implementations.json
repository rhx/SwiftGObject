e":"text"},{"type":"text","text":"timeout and the source also has a ready time set, then the"},{"text":" ","type":"text"},{"text":"lower of the two will be used.","type":"text"}],"type":"topic","title":"prepare"},"doc://GLib/documentation/GLib/SourceFuncs/finalize":{"type":"topic","abstract":[{"text":"Called when the source is finalized. At this point,","type":"text"},{"text":" ","type":"text"},{"type":"text","text":"the source will have been destroyed, had its callback cleared, and have"},{"text":" ","type":"text"},{"type":"text","text":"been removed from its [struct"},{"type":"reference","identifier":"doc:\/\/GLib\/documentation\/GLib\/MainContext","isActive":true},{"text":"], but it will still have","type":"text"},{"type":"text","text":" "},{"text":"its final reference count, so methods can be called on it from within","type":"text"},{"type":"text","text":" "},{"text":"this function. This may be ","type":"text"},{"code":"nil","type":"codeVoice"},{"text":", in which case the effect is as if the","type":"text"},{"type":"text","text":" "},{"type":"text","text":"function does nothing and returns."}],"title":"finalize","kind":"symbol","identifier":"doc:\/\/GLib\/documentation\/GLib\/SourceFuncs\/finalize","url":"\/documentation\/glib\/sourcefuncs\/finalize","role":"symbol","fragments":[{"kind":"keyword","text":"var"},{"kind":"text","text":" "},{"text":"finalize","kind":"identifier"},{"kind":"text","text":": "},{"text":"GSourceFuncsFinalizeFunc","preciseIdentifier":"c:@T@GSourceFuncsFinalizeFunc","kind":"typeIdentifier"},{"kind":"text","text":"!"}]},"doc://GLib/documentation/GLib/SourceFuncs/sourceRemoveByFuncs(userData:)":{"kind":"symbol","identifier":"doc:\/\/GLib\/documentation\/GLib\/SourceFuncs\/sourceRemoveByFuncs(userData:)","url":"\/documentation\/glib\/sourcefuncs\/sourceremovebyfuncs(userdata:)","fragments":[{"text":"func","kind":"keyword"},{"kind":"text","text":" "},{"kind":"identifier","text":"sourceRemoveByFuncs"},{"text":"(","kind":"text"},{"kind":"extern