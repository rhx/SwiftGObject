{"sections":[],"schemaVersion":{"major":0,"minor":3,"patch":0},"metadata":{"navigatorTitle":[{"text":"KeyFileRef","kind":"identifier"}],"title":"KeyFileRef","roleHeading":"Structure","symbolKind":"struct","fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"KeyFileRef","kind":"identifier"}],"modules":[{"name":"GLib"}],"externalID":"s:4GLib10KeyFileRefV","role":"symbol"},"hierarchy":{"paths":[["doc:\/\/GLib\/documentation\/GLib"]]},"kind":"symbol","topicSections":[{"title":"Initializers","identifiers":["doc:\/\/GLib\/documentation\/GLib\/KeyFileRef\/init()","doc:\/\/GLib\/documentation\/GLib\/KeyFileRef\/init(_:)-5cs5o","doc:\/\/GLib\/documentation\/GLib\/KeyFileRef\/init(_:)-766bl","doc:\/\/GLib\/documentation\/GLib\/KeyFileRef\/init(_:)-776w8","doc:\/\/GLib\/documentation\/GLib\/KeyFileRef\/init(_:)-7qdi8","doc:\/\/GLib\/documentation\/GLib\/KeyFileRef\/init(_:)-935ll","doc:\/\/GLib\/documentation\/GLib\/KeyFileRef\/init(cPointer:)","doc:\/\/GLib\/documentation\/GLib\/KeyFileRef\/init(constPointer:)","doc:\/\/GLib\/documentation\/GLib\/KeyFileRef\/init(gconstpointer:)","doc:\/\/GLib\/documentation\/GLib\/KeyFileRef\/init(gpointer:)","doc:\/\/GLib\/documentation\/GLib\/KeyFileRef\/init(mutating:)","doc:\/\/GLib\/documentation\/GLib\/KeyFileRef\/init(opaquePointer:)"],"generated":true,"anchor":"Initializers"},{"identifiers":["doc:\/\/GLib\/documentation\/GLib\/KeyFileRef\/ptr"],"generated":true,"title":"Instance Properties","anchor":"Instance-Properties"},{"generated":true,"anchor":"Default-Implementations","identifiers":["doc:\/\/GLib\/documentation\/GLib\/KeyFileRef\/KeyFileProtocol-Implementations","doc:\/\/GLib\/documentation\/GLib\/KeyFileRef\/PointerWrapper-Implementations"],"title":"Default Implementations"}],"relationshipsSections":[{"kind":"relationships","title":"Conforms To","type":"conformsTo","identifiers":["doc:\/\/GLib\/documentation\/GLib\/KeyFileProtocol","doc:\/\/GLib\/documentation\/GLib\/PointerWrapper"]}],"identifier":{"url":"doc:\/\/GLib\/documentation\/GLib\/KeyFileRef","interfaceLanguage":"swift"},"abstract":[{"code":"GKeyFile","type":"codeVoice"},{"text":" parses .ini-like config files.","type":"text"}],"primaryContentSections":[{"kind":"declarations","declarations":[{"tokens":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"KeyFileRef","kind":"identifier"}],"platforms":["macOS"],"languages":["swift"]}]},{"kind":"content","content":[{"text":"Overview","level":2,"anchor":"overview","type":"heading"},{"inlineContent":[{"code":"GKeyFile","type":"codeVoice"},{"type":"text","text":" lets you parse, edit or create files containing groups of"},{"type":"text","text":" "},{"text":"key-value pairs, which we call ‘key files’ for lack of a better name.","type":"text"},{"text":" ","type":"text"},{"type":"text","text":"Several freedesktop.org specifications use key files. For example, the"},{"type":"text","text":" "},{"type":"reference","identifier":"https:\/\/specifications.freedesktop.org\/desktop-entry-spec\/latest\/","isActive":true},{"text":" ","type":"text"},{"text":"and the ","type":"text"},{"type":"reference","identifier":"https:\/\/specifications.freedesktop.org\/icon-theme-spec\/latest\/","isActive":true},{"text":".","type":"text"}],"type":"paragraph"},{"type":"paragraph","inlineContent":[{"type":"text","text":"The syntax of key files is described in detail in the"},{"type":"text","text":" "},{"overridingTitle":"Desktop Entry Specification","isActive":true,"type":"reference","identifier":"https:\/\/specifications.freedesktop.org\/desktop-entry-spec\/latest\/","overridingTitleInlineContent":[{"text":"Desktop Entry Specification","type":"text"}]},{"type":"text","text":","},{"text":" ","type":"text"},{"type":"text","text":"here is a quick summary: Key files consists of groups of key-value pairs, interspersed"},{"type":"text","text":" "},{"text":"with comments.","type":"text"}]},{"type":"codeListing","code":["# this is just an example","# there can be comments before the first group","","[First Group]","","Name=Key File Example\\tthis value shows\\nescaping","","# localized strings are stored in multiple key-value pairs","Welcome=Hello","Welcome[de]=Hallo","Welcome[fr_FR]=Bonjour","Welcome[it]=Ciao","","[Another Group]","","Numbers=2;20;-200;0","","Booleans=true;false;true;true"],"syntax":"txt"},{"type":"paragraph","inlineContent":[{"text":"Lines beginning with a ","type":"text"},{"type":"codeVoice","code":"#"},{"type":"text","text":" and blank lines are considered comments."}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"Groups are started by a header line containing the group name enclosed"},{"type":"text","text":" "},{"type":"text","text":"in "},{"code":"[","type":"codeVoice"},{"type":"text","text":" and "},{"code":"]","type":"codeVoice"},{"text":", and ended implicitly by the start of the next group or","type":"text"},{"text":" ","type":"text"},{"text":"the end of the file. Each key-value pair must be contained in a group.","type":"text"}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"Key-value pairs generally have the form "},{"type":"codeVoice","code":"key=value"},{"text":", with the exception","type":"text"},{"type":"text","text":" "},{"text":"of localized strings, which have the form ","type":"text"},{"code":"key[locale]=value","type":"codeVoice"},{"type":"text","text":", with a"},{"text":" ","type":"text"},{"type":"text","text":"locale identifier of the form "},{"type":"codeVoice","code":"lang_COUNTRY"},{"text":"MODIFIER`` where ","type":"text"},{"type":"codeVoice","code":"COUNTRY"},{"text":" ","type":"text"},{"type":"text","text":"and `MODIFIER` are optional. As a special case, the locale `C` is associated"},{"type":"text","text":" "},{"type":"text","text":"with the untranslated pair `key=value` (since GLib 2.84). Space before and"},{"type":"text","text":" "},{"type":"text","text":"after the `=` character is ignored. Newline, tab, carriage return and"},{"type":"text","text":" "},{"text":"backslash characters in value are escaped as `\\n`, `\\t`, `\\r`, and `\\\\`,","type":"text"},{"type":"text","text":" "},{"text":"respectively. To preserve leading spaces in values, these can also be escaped","type":"text"},{"type":"text","text":" "},{"text":"as `\\s`.","type":"text"}]},{"inlineContent":[{"type":"text","text":"Key files can store strings (possibly with localized variants), integers,"},{"text":" ","type":"text"},{"type":"text","text":"booleans and lists of these. Lists are separated by a separator character,"},{"type":"text","text":" "},{"text":"typically ","type":"text"},{"type":"codeVoice","code":";"},{"type":"text","text":" or "},{"type":"codeVoice","code":","},{"text":". To use the list separator character in a value in","type":"text"},{"text":" ","type":"text"},{"text":"a list, it has to be escaped by prefixing it with a backslash.","type":"text"}],"type":"paragraph"},{"type":"paragraph","inlineContent":[{"type":"text","text":"This syntax is obviously inspired by the .ini files commonly met"},{"text":" ","type":"text"},{"type":"text","text":"on Windows, but there are some important differences:"}]},{"items":[{"content":[{"type":"paragraph","inlineContent":[{"text":".ini files use the ","type":"text"},{"type":"codeVoice","code":";"},{"text":" character to begin comments,","type":"text"},{"type":"text","text":" "},{"text":"key files use the ","type":"text"},{"type":"codeVoice","code":"#"},{"type":"text","text":" character."}]}]},{"content":[{"inlineContent":[{"type":"text","text":"Key files do not allow for ungrouped keys meaning only"},{"text":" ","type":"text"},{"text":"comments can precede the first group.","type":"text"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"type":"text","text":"Key files are always encoded in UTF-8."}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"type":"text","text":"Key and Group names are case-sensitive. For example, a group called"},{"type":"text","text":" "},{"code":"[GROUP]","type":"codeVoice"},{"text":" is a different from ","type":"text"},{"code":"[group]","type":"codeVoice"},{"type":"text","text":"."}],"type":"paragraph"}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":".ini files don’t have a strongly typed boolean entry type,"},{"type":"text","text":" "},{"type":"text","text":"they only have "},{"code":"GetProfileInt()","type":"codeVoice"},{"text":". In key files, only","type":"text"},{"type":"text","text":" "},{"code":"true","type":"codeVoice"},{"type":"text","text":" and "},{"type":"codeVoice","code":"false"},{"text":" (in lower case) are allowed.","type":"text"}]}]}],"type":"unorderedList"},{"type":"paragraph","inlineContent":[{"type":"text","text":"Note that in contrast to the"},{"text":" ","type":"text"},{"identifier":"https:\/\/specifications.freedesktop.org\/desktop-entry-spec\/latest\/","overridingTitleInlineContent":[{"type":"text","text":"Desktop Entry Specification"}],"type":"reference","overridingTitle":"Desktop Entry Specification","isActive":true},{"text":",","type":"text"},{"text":" ","type":"text"},{"text":"groups in key files may contain the same key multiple times; the last entry wins.","type":"text"},{"text":" ","type":"text"},{"text":"Key files may also contain multiple groups with the same name; they are merged","type":"text"},{"type":"text","text":" "},{"type":"text","text":"together. Another difference is that keys and group names in key files are not"},{"type":"text","text":" "},{"type":"text","text":"restricted to ASCII characters."}]},{"inlineContent":[{"text":"Here is an example of loading a key file and reading a value:","type":"text"}],"type":"paragraph"},{"type":"codeListing","code":["`g_autoptr(GError)` error = NULL;","`g_autoptr(GKeyFile)` key_file = g_key_file_new ();","","if (!g_key_file_load_from_file (key_file, \"key-file.ini\", flags, &error))","  {","    if (!g_error_matches (error, G_FILE_ERROR, G_FILE_ERROR_NOENT))","      g_warning (\"Error loading key file: `s`\", error->message);","    return;","  }","","g_autofree gchar *val = g_key_file_get_string (key_file, \"Group Name\", \"SomeKey\", &error);","if (val == NULL &&","    !g_error_matches (error, G_KEY_FILE_ERROR, G_KEY_FILE_ERROR_KEY_NOT_FOUND))","  {","    g_warning (\"Error finding key in key file: `s`\", error->message);","    return;","  }","else if (val == NULL)","  {","    \/\/ Fall back to a default value.","    val = g_strdup (\"default-value\");","  }"],"syntax":"c"},{"type":"paragraph","inlineContent":[{"type":"text","text":"Here is an example of creating and saving a key file:"}]},{"code":["`g_autoptr(GKeyFile)` key_file = g_key_file_new ();","const gchar *val = …;","`g_autoptr(GError)` error = NULL;","","g_key_file_set_string (key_file, \"Group Name\", \"SomeKey\", val);","","\/\/ Save as a file.","if (!g_key_file_save_to_file (key_file, \"key-file.ini\", &error))","  {","    g_warning (\"Error saving key file: `s`\", error->message);","    return;","  }","","\/\/ Or store to a GBytes for use elsewhere.","gsize data_len;","g_autofree guint8 *data = (guint8 *) g_key_file_to_data (key_file, &data_len, &error);","if (data == NULL)","  {","    g_warning (\"Error saving key file: `s`\", error->message);","    return;","  }","`g_autoptr(GBytes)` bytes = g_bytes_new_take (g_steal_pointer (&data), data_len);"],"type":"codeListing","syntax":"c"},{"type":"paragraph","inlineContent":[{"type":"text","text":"The "},{"identifier":"doc:\/\/GLib\/documentation\/GLib\/KeyFileRef","isActive":true,"type":"reference"},{"type":"text","text":" type acts as a lightweight Swift reference to an underlying "},{"type":"codeVoice","code":"GKeyFile"},{"type":"text","text":" instance."},{"text":" ","type":"text"},{"text":"It exposes methods that can operate on this data type through ","type":"text"},{"identifier":"doc:\/\/GLib\/documentation\/GLib\/KeyFileProtocol","isActive":true,"type":"reference"},{"type":"text","text":" conformance."},{"type":"text","text":" "},{"text":"Use ","type":"text"},{"type":"reference","isActive":true,"identifier":"doc:\/\/GLib\/documentation\/GLib\/KeyFileRef"},{"text":" only as an ","type":"text"},{"code":"unowned","type":"codeVoice"},{"text":" reference to an existing ","type":"text"},{"type":"codeVoice","code":"GKeyFile"},{"type":"text","text":" instance."}]},{"style":"note","content":[{"inlineContent":[{"type":"text","text":"Use "},{"isActive":true,"identifier":"doc:\/\/GLib\/documentation\/GLib\/KeyFile","type":"reference"},{"type":"text","text":" (instead of "},{"isActive":true,"type":"reference","identifier":"doc:\/\/GLib\/documentation\/GLib\/KeyFileRef"},{"type":"text","text":") if you want to use Automatic Reference Counting for memory management of the underlying "},{"code":"GKeyFile","type":"codeVoice"},{"type":"text","text":" instance."}],"type":"paragraph"}],"name":"Note","type":"aside"}]}],"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/glib\/keyfileref"]}],"references":{"doc://GLib/documentation/GLib/KeyFileRef/init(gconstpointer:)":{"type":"topic","fragments":[{"text":"init","kind":"identifier"},{"text":"!(","kind":"text"},{"kind":"externalParam","text":"gconstpointer"},{"text":": ","kind":"text"},{"preciseIdentifier":"c:@T@gconstpointer","text":"gconstpointer","kind":"typeIdentifier"},{"kind":"text","text":"?)"}],"kind":"symbol","title":"init(gconstpointer:)","abstract":[{"type":"text","text":"Conditional initialiser from an optional, non-mutable "},{"type":"codeVoice","code":"gconstpointer"}],"role":"symbol","identifier":"doc:\/\/GLib\/documentation\/GLib\/KeyFileRef\/init(gconstpointer:)","url":"\/documentation\/glib\/keyfileref\/init(gconstpointer:)"},"doc://GLib/documentation/GLib/KeyFileRef/init(_:)-766bl":{"fragments":[{"text":"init","kind":"identifier"},{"kind":"text","text":"<"},{"kind":"genericParameter","text":"T"},{"kind":"text","text":">("},{"text":"T","kind":"typeIdentifier"},{"text":")","kind":"text"}],"title":"init(_:)","abstract":[{"type":"text","text":"Reference in