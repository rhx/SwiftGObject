ndition variables, it is possible that a spurious wakeup","type":"text"},{"type":"text","text":" "},{"text":"may occur (ie: ","type":"text"},{"type":"codeVoice","code":"g_cond_wait()"},{"type":"text","text":" returns even though "},{"code":"g_cond_signal()","type":"codeVoice"},{"text":" was","type":"text"},{"text":" ","type":"text"},{"type":"text","text":"not called).  It’s also possible that a stolen wakeup may occur."},{"text":" ","type":"text"},{"text":"This is when ","type":"text"},{"code":"g_cond_signal()","type":"codeVoice"},{"type":"text","text":" is called, but another thread acquires"},{"type":"text","text":" "},{"type":"codeVoice","code":"mutex"},{"text":" before this thread and modifies the state of the program in","type":"text"},{"text":" ","type":"text"},{"text":"such a way that when ","type":"text"},{"type":"codeVoice","code":"g_cond_wait()"},{"text":" is able to return, the expected","type":"text"},{"text":" ","type":"text"},{"text":"condition is no longer met.","type":"text"}]},{"inlineContent":[{"text":"For this reason, ","type":"text"},{"type":"codeVoice","code":"g_cond_wait()"},{"type":"text","text":" must always be used in a loop.  See"},{"text":" ","type":"text"},{"text":"the documentation for ","type":"text"},{"identifier":"doc:\/\/GLib\/documentation\/GLib\/Cond","isActive":true,"type":"reference"},{"text":" for a complete example.","type":"text"}],"type":"paragraph"}]}],"abstract":[{"text":"Atomically releases ","type":"text"},{"code":"mutex","type":"codeVoice"},{"type":"text","text":" and waits until "},{"type":"codeVoice","code":"cond"},{"type":"text","text":" is signalled."},{"text":" ","type":"text"},{"text":"When this function returns, ","type":"text"},{"type":"codeVoice","code":"mutex"},{"type":"text","text":" is locked again and owned by the"},{"text":" ","type":"text"},{"type":"text","text":"calling thread."}],"references":{"doc://GLib/documentation/GLib/CondRef/wait(mutex:)":{"type":"topic","title":"wait(mutex:)","url":"\/documentati