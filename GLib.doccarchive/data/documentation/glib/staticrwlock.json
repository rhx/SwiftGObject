.","type":"text"}],"role":"symbol","navigatorTitle":[{"text":"StaticMutex","kind":"identifier"}]},"doc://GLib/documentation/GLib/StaticRWLock/init(retainingRaw:)-2wn2i":{"kind":"symbol","role":"symbol","fragments":[{"text":"init","kind":"identifier"},{"text":"(","kind":"text"},{"text":"retainingRaw","kind":"externalParam"},{"text":": ","kind":"text"},{"text":"UnsafeRawPointer","kind":"typeIdentifier","preciseIdentifier":"s:SV"},{"kind":"text","text":")"}],"abstract":[{"type":"text","text":"Unsafe untyped, retaining initialiser."},{"type":"text","text":" "},{"inlineContent":[{"type":"text","text":"Do not use unless you know the underlying data type the pointer points to conforms to "},{"identifier":"doc:\/\/GLib\/documentation\/GLib\/StaticRWLockProtocol","type":"reference","isActive":true},{"text":".","type":"text"}],"type":"strong"}],"type":"topic","identifier":"doc:\/\/GLib\/documentation\/GLib\/StaticRWLock\/init(retainingRaw:)-2wn2i","title":"init(retainingRaw:)","url":"\/documentation\/glib\/staticrwlock\/init(retainingraw:)-2wn2i"},"doc://GLib/documentation/GLib/StaticRWLock/init(cPointer:)":{"kind":"symbol","title":"init(cPointer:)","type":"topic","role":"symbol","fragments":[{"kind":"identifier","text":"init"},{"text":"<","kind":"text"},{"text":"T","kind":"genericParameter"},{"text":">(","kind":"text"},{"text":"cPointer","kind":"externalParam"},{"text":": ","kind":"text"},{"preciseIdentifier":"s:Sp","kind":"typeIdentifier","text":"UnsafeMutablePointer"},{"text":"<","kind":"text"},{"kind":"typeIdentifier","text":"T"},{"text":">)","kind":"text"}],"url":"\/documentation\/glib\/staticrwlock\/init(cpointer:)","abstract":[{"text":"Unsafe typed initialiser.","type":"text"},{"text":" ","type":"text"},{"type":"strong","inlineContent":[{"type":"text","text":"Do not use unless you know the underlying data type the pointer points to conforms to "},{"type":"reference","isActive":true,"identifier":"doc:\/\/GLib\/documentation\/GLib\/StaticRWLockProtocol"},{"type":"text","