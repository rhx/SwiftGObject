{"kind":"symbol","primaryContentSections":[{"kind":"declarations","declarations":[{"tokens":[{"kind":"keyword","text":"func"},{"text":" ","kind":"text"},{"kind":"identifier","text":"set"},{"kind":"text","text":"("},{"text":"buffered","kind":"externalParam"},{"kind":"text","text":": "},{"kind":"typeIdentifier","text":"Bool","preciseIdentifier":"s:Sb"},{"text":")","kind":"text"}],"platforms":["macOS"],"languages":["swift"]}]},{"content":[{"anchor":"discussion","text":"Discussion","type":"heading","level":2},{"type":"paragraph","inlineContent":[{"text":"A buffered channel can only be set unbuffered if the channel’s","type":"text"},{"type":"text","text":" "},{"text":"internal buffers have been flushed. Newly created channels or","type":"text"},{"type":"text","text":" "},{"type":"text","text":"channels which have returned "},{"code":"eof","type":"codeVoice"},{"type":"text","text":" "},{"type":"text","text":"not require such a flush. For write-only channels, a call to"},{"type":"text","text":" "},{"type":"text","text":"g_io_channel_flush () is sufficient. For all other channels,"},{"type":"text","text":" "},{"text":"the buffers may be flushed by a call to g_io_channel_seek_position ().","type":"text"},{"text":" ","type":"text"},{"text":"This includes the possibility of seeking with seek type ","type":"text"},{"code":"cur","type":"codeVoice"},{"type":"text","text":" "},{"type":"text","text":"and an offset of zero. Note that this means that socket-based"},{"type":"text","text":" "},{"text":"channels cannot be set unbuffered once they have had data","type":"text"},{"type":"text","text":" "},{"type":"text","text":"read from them."}]},{"inlineContent":[{"text":"On unbuffered channels, it is safe to mix read and write","type":"text"},{"text":" ","type":"text"},{"type":"text","text":"calls from the new and old APIs, if this is necessary for"},{"type":"text","text":" "},{"type":"text","text":"maintaining old code."}],"type":"paragraph"},{"type":"paragraph","inlineContent":[{"type":"text","text":"The default state of the channel is buffered."}]}],"kind":"content"}],"identifier":{"interfaceLanguage":"swift","url":"doc:\/\/GLib\/documentation\/GLib\/IOChannel\/set(buffered:)"},"sections":[],"metadata":{"symbolKind":"method","fragments":[{"kind":"keyword","text":"func"},{"text":" ","kind":"text"},{"kind":"identifier","text":"set"},{"text":"(","kind":"text"},{"text":"buffered","kind":"externalParam"},{"text":": ","kind":"text"},{"text":"Bool","kind":"typeIdentifier","preciseIdentifier":"s:Sb"},{"kind":"text","text":")"}],"role":"symbol","extendedModule":"GLib","roleHeading":"Instance Method","modules":[{"name":"GLib"}],"externalID":"s:4GLib17IOChannelProtocolPAAE3set8bufferedySb_tF::SYNTHESIZED::s:4GLib9IOChannelC","title":"set(buffered:)"},"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/glib\/iochannel\/set(buffered:)"]}],"hierarchy":{"paths":[["doc:\/\/GLib\/documentation\/GLib","doc:\/\/GLib\/documentation\/GLib\/IOChannel","doc:\/\/GLib\/documentation\/GLib\/IOChannel\/IOChannelProtocol-Implementations"]]},"abstract":[{"text":"The buffering state can only be set if the channel’s encoding","type":"text"},{"text":" ","type":"text"},{"type":"text","text":"is "},{"type":"codeVoice","code":"nil"},{"text":". For any other encoding, the channel must be buffered.","type":"text"}],"schemaVersion":{"patch":0,"minor":3,"major":0},"references":{"doc://GLib/documentation/GLib":{"identifier":"doc:\/\/GLib\/documentation\/GLib","title":"GLib","abstract":[],"type":"topic","url":"\/documentation\/glib","kind":"symbol","role":"collection"},"doc://GLib/documentation/GLib/IOChannel":{"url":"\/documentation\/glib\/iochannel","identifier":"doc:\/\/GLib\/documentation\/GLib\/IOChannel","title":"IOChannel","role":"symbol","type":"topic","navigatorTitle":[{"text":"IOChannel","kind":"identifier"}],"kind":"symbol","fragments":[{"kind":"keyword","text":"class"},{"kind":"text","text":" "},{"text":"IOChannel","kind":"identifier"}],"abstract":[{"type":"text","text":"The "},{"code":"GIOChannel","type":"codeVoice"},{"text":" data type aims to provide a portable method for","type":"text"},{"text":" ","type":"text"},{"type":"text","text":"using file descriptors, pipes, and sockets, and integrating them"},{"text":" ","type":"text"},{"type":"text","text":"into the main event loop (see [struct"},{"type":"reference","identifier":"doc:\/\/GLib\/documentation\/GLib\/MainContext","isActive":true},{"type":"text","text":"]). Currently,"},{"text":" ","type":"text"},{"text":"full support is available on UNIX platforms; support for Windows","type":"text"},{"type":"text","text":" "},{"text":"is only partially complete.","type":"text"}]},"doc://GLib/documentation/GLib/IOChannel/IOChannelProtocol-Implementations":{"kind":"article","title":"IOChannelProtocol Implementations","identifier":"doc:\/\/GLib\/documentation\/GLib\/IOChannel\/IOChannelProtocol-Implementations","type":"topic","role":"collectionGroup","abstract":[],"url":"\/documentation\/glib\/iochannel\/iochannelprotocol-implementations"},"doc://GLib/documentation/GLib/MainContext":{"title":"MainContext","identifier":"doc:\/\/GLib\/documentation\/GLib\/MainContext","fragments":[{"kind":"keyword","text":"class"},{"kind":"text","text":" "},{"kind":"identifier","text":"MainContext"}],"url":"\/documentation\/glib\/maincontext","navigatorTitle":[{"kind":"identifier","text":"MainContext"}],"kind":"symbol","type":"topic","role":"symbol","abstract":[{"type":"text","text":"The "},{"code":"GMainContext","type":"codeVoice"},{"text":" struct is an opaque data","type":"text"},{"text":" ","type":"text"},{"type":"text","text":"type representing a set of sources to be handled in a main loop."}]},"doc://GLib/documentation/GLib/IOChannel/set(buffered:)":{"type":"topic","kind":"symbol","fragments":[{"text":"func","kind":"keyword"},{"text":" ","kind":"text"},{"kind":"identifier","text":"set"},{"text":"(","kind":"text"},{"text":"buffered","kind":"externalParam"},{"text":": ","kind":"text"},{"preciseIdentifier":"s:Sb","text":"Bool","kind":"typeIdentifier"},{"kind":"text","text":")"}],"role":"symbol","abstract":[{"type":"text","text":"The buffering state can only be set if the channel’s encoding"},{"text":" ","type":"text"},{"type":"text","text":"is "},{"type":"codeVoice","code":"nil"},{"text":". For any other encoding, the channel must be buffered.","type":"text"}],"identifier":"doc:\/\/GLib\/documentation\/GLib\/IOChannel\/set(buffered:)","url":"\/documentation\/glib\/iochannel\/set(buffered:)","title":"set(buffered:)"}}}