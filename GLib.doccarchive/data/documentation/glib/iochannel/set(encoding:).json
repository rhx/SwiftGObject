xt":"GIOStatus"}]}]},{"kind":"content","content":[{"text":"Discussion","type":"heading","anchor":"discussion","level":2},{"inlineContent":[{"text":"The encoding ","type":"text"},{"type":"codeVoice","code":"nil"},{"text":" is safe to use with binary data.","type":"text"}],"type":"paragraph"},{"inlineContent":[{"type":"text","text":"The encoding can only be set if one of the following conditions"},{"text":" ","type":"text"},{"type":"text","text":"is true:"}],"type":"paragraph"},{"type":"unorderedList","items":[{"content":[{"inlineContent":[{"type":"text","text":"The channel was just created, and has not been written to or read from yet."}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"text":"The channel is write-only.","type":"text"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"type":"text","text":"The channel is a file, and the file pointer was just repositioned"},{"text":" ","type":"text"},{"type":"text","text":"by a call to "},{"code":"g_io_channel_seek_position()","type":"codeVoice"},{"type":"text","text":". (This flushes all the"},{"type":"text","text":" "},{"text":"internal buffers.)","type":"text"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"type":"text","text":"The current encoding is "},{"type":"codeVoice","code":"nil"},{"text":" or UTF-8.","type":"text"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"text":"One of the (new API) read functions has just returned ","type":"text"},{"type":"codeVoice","code":"eof"},{"type":"text","text":" "},{"text":"(or, in the case of ","type":"text"},{"code":"g_io_channel_read_to_end()","type":"codeVoice"},{"type":"text","text":", "},{"code":"normal","type":"codeVoice"},{"type":"text","text":")."}],"type":"paragraph"}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"One of the functions "},{"type":"codeVoice","code":"g_io_channel_read_chars()"},{"text":" or","type":"text"},{"type":"text","text":" "},{"code":"g_io_channel_read_unichar()","type":"codeVoice"},{"text":" has returned ","type":"text"},{"code":"again","type":"codeVoice"},{"type":"text","text":" or"},{"type":"text","text":" "},{"type":"codeVoice","code":"error"},{"text":". This may be useful in the case of","type":"text"},{"type":"text","text":" "},{"code":"illegalSequence","type":"codeVoice"},{"type":"text","text":"."},{"text":" ","type":"text"},{"text":"Returning one of these statuses from ","type":"text"},{"code":"g_io_channel_read_line()","type":"codeVoice"},{"type":"text","text":","},{"type":"text","text":" "},{"code":"g_io_channel_read_line_string()","type":"codeVoice"},{"text":", or ","type":"text"},{"code":"g_io_channel_read_to_end()","type":"codeVoice"},{"type":"text","text":" "},{"text":"does not guarantee that the encoding can be changed.","type":"text"}]}]}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"Channels which do not meet one of the above conditions cannot call"},{"text":" ","type":"text"},{"code":"g_io_channel_seek_position()","type":"codeVoice"},{"type":"text","text":" with an offset of "},{"type":"codeVoice","code":"cur"},{"text":", and, if","type":"text"},{"type":"text","text":" "},{"type":"text","text":"they are “seekable”, cannot call "},{"type":"codeVoice","code":"g_io_channel_write_chars()"},{"text":" after","type":"text"},{"type":"text","text":" "},{"text":"calling one of the API “read” functions.","type":"text"}]}]}],"abstract":[{"text":"Sets the encoding for the input\/output of the channel.","type":"text"},{"text":" ","type":"text"},{"text":"The internal encoding is always UTF-8. The default encoding","type":"text"},{"type":"text","text":" "},{"type":"text","text":"for the external file is UTF-8."}],"references":{"doc://GLib/documentation/GLib/IOChannel/set(encoding:)":{"kind":"symbol","abstract":[{"type":"text","text":"Sets the encoding for the input\/output of the channel."},{"type":"text","text":" "},{"text":"The internal encoding is always UTF-8. The default encoding","type":"text"},{"type":"text","text":" "},{"text":