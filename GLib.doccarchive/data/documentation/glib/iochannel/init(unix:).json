{"abstract":[{"text":"Creates a new ","type":"text"},{"identifier":"doc:\/\/GLib\/documentation\/GLib\/IOChannel","type":"reference","isActive":true},{"text":" given a file descriptor. On UNIX systems","type":"text"},{"text":" ","type":"text"},{"type":"text","text":"this works for plain files, pipes, and sockets."}],"metadata":{"symbolKind":"init","role":"symbol","externalID":"s:4GLib9IOChannelC4unixACSi_tcfc","modules":[{"name":"GLib"}],"title":"init(unix:)","fragments":[{"text":"init","kind":"identifier"},{"text":"(","kind":"text"},{"text":"unix","kind":"externalParam"},{"kind":"text","text":": "},{"text":"Int","preciseIdentifier":"s:Si","kind":"typeIdentifier"},{"text":")","kind":"text"}],"roleHeading":"Initializer"},"schemaVersion":{"patch":0,"major":0,"minor":3},"primaryContentSections":[{"kind":"declarations","declarations":[{"languages":["swift"],"platforms":["macOS"],"tokens":[{"text":"init","kind":"keyword"},{"text":"(","kind":"text"},{"text":"unix","kind":"externalParam"},{"kind":"text","text":" "},{"text":"fd","kind":"internalParam"},{"text":": ","kind":"text"},{"kind":"typeIdentifier","preciseIdentifier":"s:Si","text":"Int"},{"kind":"text","text":")"}]}]},{"kind":"content","content":[{"type":"heading","level":2,"text":"Discussion","anchor":"discussion"},{"type":"paragraph","inlineContent":[{"text":"The returned ","type":"text"},{"isActive":true,"type":"reference","identifier":"doc:\/\/GLib\/documentation\/GLib\/IOChannel"},{"text":" has a reference count of 1.","type":"text"}]},{"type":"paragraph","inlineContent":[{"text":"The default encoding for ","type":"text"},{"identifier":"doc:\/\/GLib\/documentation\/GLib\/IOChannel","isActive":true,"type":"reference"},{"text":" is UTF-8. If your application","type":"text"},{"type":"text","text":" "},{"text":"is reading output from a command using via pipe, you may need to set","type":"text"},{"type":"text","text":" "},{"type":"text","text":"the encoding to the encoding of the current locale (see"},{"type":"text","text":" "},{"code":"g_get_charset()","type":"codeVoice"},{"type":"text","text":") with the "},{"type":"codeVoice","code":"g_io_channel_set_encoding()"},{"type":"text","text":" function."},{"text":" ","type":"text"},{"text":"By default, the fd passed will not be closed when the final reference","type":"text"},{"type":"text","text":" "},{"type":"text","text":"to the "},{"isActive":true,"type":"reference","identifier":"doc:\/\/GLib\/documentation\/GLib\/IOChannel"},{"type":"text","text":" data structure is dropped."}]},{"type":"paragraph","inlineContent":[{"text":"If you want to read raw binary data without interpretation, then","type":"text"},{"type":"text","text":" "},{"type":"text","text":"call the "},{"code":"g_io_channel_set_encoding()","type":"codeVoice"},{"type":"text","text":" function with "},{"code":"nil","type":"codeVoice"},{"text":" for the","type":"text"},{"type":"text","text":" "},{"type":"text","text":"encoding argument."}]},{"inlineContent":[{"text":"This function is available in GLib on Windows, too, but you should","type":"text"},{"type":"text","text":" "},{"type":"text","text":"avoid using it on Windows. The domain of file descriptors and"},{"type":"text","text":" "},{"type":"text","text":"sockets overlap. There is no way for GLib to know which one you mean"},{"text":" ","type":"text"},{"type":"text","text":"in case the argument you pass to this function happens to be both a"},{"type":"text","text":" "},{"type":"text","text":"valid file descriptor and socket. If that happens a warning is"},{"type":"text","text":" "},{"type":"text","text":"issued, and GLib assumes that it is the file descriptor you mean."}],"type":"paragraph"}]}],"variants":[{"paths":["\/documentation\/glib\/iochannel\/init(unix:)"],"traits":[{"interfaceLanguage":"swift"}]}],"sections":[],"kind":"symbol","hierarchy":{"paths":[["doc:\/\/GLib\/documentation\/GLib","doc:\/\/GLib\/documentation\/GLib\/IOChannel"]]},"identifier":{"interfaceLanguage":"swift","url":"doc:\/\/GLib\/documentation\/GLib\/IOChannel\/init(unix:)"},"references":{"doc://GLib/documentation/GLib":{"identifier":"doc:\/\/GLib\/documentation\/GLib","title":"GLib","abstract":[],"type":"topic","url":"\/documentation\/glib","kind":"symbol","role":"collection"},"doc://GLib/documentation/GLib/IOChannel":{"url":"\/documentation\/glib\/iochannel","identifier":"doc:\/\/GLib\/documentation\/GLib\/IOChannel","title":"IOChannel","role":"symbol","type":"topic","navigatorTitle":[{"text":"IOChannel","kind":"identifier"}],"kind":"symbol","fragments":[{"kind":"keyword","text":"class"},{"kind":"text","text":" "},{"text":"IOChannel","kind":"identifier"}],"abstract":[{"type":"text","text":"The "},{"code":"GIOChannel","type":"codeVoice"},{"text":" data type aims to provide a portable method for","type":"text"},{"text":" ","type":"text"},{"type":"text","text":"using file descriptors, pipes, and sockets, and integrating them"},{"text":" ","type":"text"},{"type":"text","text":"into the main event loop (see [struct"},{"type":"reference","identifier":"doc:\/\/GLib\/documentation\/GLib\/MainContext","isActive":true},{"type":"text","text":"]). Currently,"},{"text":" ","type":"text"},{"text":"full support is available on UNIX platforms; support for Windows","type":"text"},{"type":"text","text":" "},{"text":"is only partially complete.","type":"text"}]},"doc://GLib/documentation/GLib/MainContext":{"title":"MainContext","identifier":"doc:\/\/GLib\/documentation\/GLib\/MainContext","fragments":[{"kind":"keyword","text":"class"},{"kind":"text","text":" "},{"kind":"identifier","text":"MainContext"}],"url":"\/documentation\/glib\/maincontext","navigatorTitle":[{"kind":"identifier","text":"MainContext"}],"kind":"symbol","type":"topic","role":"symbol","abstract":[{"type":"text","text":"The "},{"code":"GMainContext","type":"codeVoice"},{"text":" struct is an opaque data","type":"text"},{"text":" ","type":"text"},{"type":"text","text":"type representing a set of sources to be handled in a main loop."}]},"doc://GLib/do