{"identifier":{"url":"doc:\/\/GLib\/documentation\/GLib\/VariantProtocol\/takeRef()","interfaceLanguage":"swift"},"hierarchy":{"paths":[["doc:\/\/GLib\/documentation\/GLib","doc:\/\/GLib\/documentation\/GLib\/VariantProtocol"]]},"abstract":[{"text":"If ","type":"text"},{"type":"codeVoice","code":"value"},{"text":" is floating, sink it.  Otherwise, do nothing.","type":"text"}],"sections":[],"schemaVersion":{"patch":0,"major":0,"minor":3},"primaryContentSections":[{"kind":"declarations","declarations":[{"platforms":["macOS"],"tokens":[{"kind":"keyword","text":"func"},{"text":" ","kind":"text"},{"kind":"identifier","text":"takeRef"},{"kind":"text","text":"() -> "},{"kind":"typeIdentifier","text":"VariantRef","preciseIdentifier":"s:4GLib10VariantRefV","identifier":"doc:\/\/GLib\/documentation\/GLib\/VariantRef"},{"kind":"text","text":"!"}],"languages":["swift"]}]},{"kind":"content","content":[{"anchor":"discussion","type":"heading","text":"Discussion","level":2},{"type":"paragraph","inlineContent":[{"type":"text","text":"Typically you want to use "},{"type":"codeVoice","code":"g_variant_ref_sink()"},{"type":"text","text":" in order to"},{"type":"text","text":" "},{"type":"text","text":"automatically do the correct thing with respect to floating or"},{"type":"text","text":" "},{"text":"non-floating references, but there is one specific scenario where","type":"text"},{"text":" ","type":"text"},{"type":"text","text":"this function is helpful."}]},{"type":"paragraph","inlineContent":[{"text":"The situation where this function is helpful is when creating an API","type":"text"},{"text":" ","type":"text"},{"type":"text","text":"that allows the user to provide a callback function that returns a"},{"text":" ","type":"text"},{"identifier":"doc:\/\/GLib\/documentation\/GLib\/Variant","isActive":true,"type":"reference"},{"type":"text","text":".  We certainly want to allow the user the flexibility to"},{"type":"text","text":" "},{"text":"return a non-floating reference from this callback (for the case","type":"text"},{"text":" ","type":"text"},{"type":"text","text":"where the value that is being returned already exists)."}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"At the same time, the style of the "},{"type":"reference","isActive":true,"identifier":"doc:\/\/GLib\/documentation\/GLib\/Variant"},{"type":"text","text":" API makes it likely that"},{"text":" ","type":"text"},{"text":"for newly-created ","type":"text"},{"identifier":"doc:\/\/GLib\/documentation\/GLib\/Variant","type":"reference","isActive":true},{"type":"text","text":" instances, the user can be saved some"},{"text":" ","type":"text"},{"type":"text","text":"typing if they are allowed to return a "},{"identifier":"doc:\/\/GLib\/documentation\/GLib\/Variant","isActive":true,"type":"reference"},{"text":" with a floating","type":"text"},{"type":"text","text":" "},{"type":"text","text":"reference."}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"Using this function on the return value of the user’s callback allows"},{"type":"text","text":" "},{"type":"text","text":"the user to do whichever is more convenient for them.  The caller"},{"type":"text","text":" "},{"text":"will always receives exactly one full reference to the value: either","type":"text"},{"type":"text","text":" "},{"type":"text","text":"the one that was returned in the first place, or a floating reference"},{"type":"text","text":" "},{"type":"text","text":"that has been converted to a full reference."}]},{"type":"paragraph","inlineContent":[{"text":"This function has an odd interaction when combined with","type":"text"},{"type":"text","text":" "},{"type":"codeVoice","code":"g_variant_ref_sink()"},{"type":"text","text":" running at the same time in another thread on"},{"type":"text","text":" "},{"type":"text","text":"the same "},{"type":"reference","identifier":"doc:\/\/GLib\/documentation\/GLib\/Variant","isActive":true},{"text":" instance.  If ","type":"text"},{"code":"g_variant_ref_sink()","type":"codeVoice"},{"type":"text","text":" runs first then"},{"text":" ","type":"text"},{"type":"text","text":"the result will be that the floating reference is converted to a hard"},{"type":"text","text":" "},{"type":"text","text":"reference.  If "},{"type":"codeVoice","code":"g_variant_take_ref()"},{"type":"text","text":" runs first then the result will"},{"text":" ","type":"text"},{"type":"text","text":"be that the floating reference is converted to a hard reference and"},{"type":"text","text":" "},{"text":"an additional reference on top of that one is added.  It is best to","type":"text"},{"type":"text","text":" "},{"type":"text","text":"avoid this situation."}]}]}],"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/glib\/variantprotocol\/takeref()"]}],"kind":"symbol","metadata":{"modules":[{"name":"GLib"}],"title":"takeRef()","symbolKind":"method","roleHeading":"Instance Method","externalID":"s:4GLib15VariantProtocolPAAE7takeRefAA0bE0VSgyF","fragments":[{"kind":"keyword","text":"func"},{"kind":"text","text":" "},{"text":"takeRef","kind":"identifier"},{"kind":"text","text":"() -> "},{"kind":"typeIdentifier","text":"VariantRef","preciseIdentifier":"s:4GLib10VariantRefV"},{"text":"!","kind":"text"}],"extendedModule":"GLib","role":"symbol"},"references":{"doc://GLib/documentation/GLib/VariantProtocol":{"role":"symbol","title":"VariantProtocol","url":"\/documentation\/glib\/variantprotocol","navigatorTitle":[{"text":"VariantProtocol","kind":"identifier"}],"kind":"symbol","fragments":[{"kind":"keyword","text":"protocol"},{"text":" ","kind":"text"},{"text":"VariantProtocol","kind":"identifier"}],"abstract":[{"code":"GVariant","type":"codeVoice"},{"type":"text","text":" is a variant datatype; it can contain one or more values"},{"type":"text","text":" "},{"type":"text","text":"along with information about the type of the values."}],"identifier":"doc:\/\/GLib\/documentation\/GLib\/VariantProtocol","type":"topic"},"doc://GLib/documentation/GLib/VariantProtocol/takeRef()":{"kind":"symbol","title":"takeRef()","url":"\/documentation\/glib\/variantprotocol\/takeref()","role":"symbol","fragments":[{"text":"func","kind":"keyword"},{"text":" ","kind":"text"},{"kind":"identifier","text":"takeRef"},{"kind":"text","text":"() -> "},{"preciseIdentifier":"s:4GLib10VariantRefV","text":"VariantRef","kind":"typeIdentifier"},{"text":"!","kind":"text"}],"type":"topic","identifier":"doc:\/\/GLib\/documentation\/GLib\/VariantProtocol\/takeRef()","abstract":[{"type":"text","text":"If "},{"type":"codeVoice","code":"value"},{"type":"text","text":" is floating, sink it.  Otherwise, do nothing."}]},"doc://GLib/documentation/GLib/Variant":{"role":"symbol","kind":"symbol","navigatorTitle":[{"text":"Variant","kind":"identifier"}],"title":"Variant","identifier":"doc:\/\/GLib\/documentation\/GLib\/Variant","fragments":[{"kind":"keyword","text":"class"},{"text":" ","kind":"text"},{"text":"Variant","kind":"identifier"}],"abstract":[{"code":"GVariant","type":"codeVoice"},{"type":"text","text":" is a variant datatype; it can contain one or more values"},{"type":"text","text":" "},{"type":"text","text":"along with information about the type of the values."}],"type":"topic","url":"\/documentation\/glib\/variant"},"doc://GLib/documentation/GLib":{"identifier":"doc:\/\/GLib\/documentation\/GLib","title":"GLib","abstract":[],"type":"topic","url":"\/documentation\/glib","kind":"symbol","role":"collection"},"doc://GLib/documentation/GLib/VariantRef":{"url":"\/documentation\/glib\/variantref","kind":"symbol","role":"symbol","type":"topic","identifier":"doc:\/\/GLib\/documentation\/GLib\/VariantRef","abstract":[{"code":"GVariant","type":"codeVoice"},{"type":"text","text":" is a variant datatype; it can contain one or more values"},{"type":"text","text":" "},{"text":"along with information about the type of the values.","type":"text"}],"fragments":[{"text":"struct","kind":"keyword"},{"kind":"text","text":" "},{"text":"VariantRef","kind":"identifier"}],"navigatorTitle":[{"text":"VariantRef","kind":"identifier"}],"title":"VariantRef"}}}