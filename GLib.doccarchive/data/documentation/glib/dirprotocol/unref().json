{"abstract":[{"type":"text","text":"Decrements the reference count of "},{"type":"codeVoice","code":"dir"},{"type":"text","text":"."}],"kind":"symbol","sections":[],"schemaVersion":{"major":0,"patch":0,"minor":3},"primaryContentSections":[{"declarations":[{"tokens":[{"text":"func","kind":"keyword"},{"kind":"text","text":" "},{"kind":"identifier","text":"unref"},{"kind":"text","text":"()"}],"languages":["swift"],"platforms":["macOS"]}],"kind":"declarations"},{"content":[{"text":"Discussion","level":2,"type":"heading","anchor":"discussion"},{"inlineContent":[{"text":"Once the reference count reaches zero, the directory will be closed and all","type":"text"},{"type":"text","text":" "},{"text":"resources associated with it will be freed. If [method","type":"text"},{"type":"codeVoice","code":"GLib.Dir.close"},{"type":"text","text":"] is"},{"type":"text","text":" "},{"text":"called when the reference count is greater than zero, the directory is closed","type":"text"},{"text":" ","type":"text"},{"text":"but the ","type":"text"},{"code":"GDir","type":"codeVoice"},{"text":" structure will not be freed until its reference count reaches","type":"text"},{"text":" ","type":"text"},{"type":"text","text":"zero."}],"type":"paragraph"},{"inlineContent":[{"type":"text","text":"It is an error to call any of the "},{"code":"GDir","type":"codeVoice"},{"text":" methods other than","type":"text"},{"type":"text","text":" "},{"type":"text","text":"[method"},{"code":"GLib.Dir.ref","type":"codeVoice"},{"type":"text","text":"] and [method"},{"type":"codeVoice","code":"GLib.Dir.unref"},{"type":"text","text":"] on a "},{"type":"codeVoice","code":"GDir"},{"type":"text","text":" after calling"},{"type":"text","text":" "},{"type":"text","text":"[method"},{"code":"GLib.Dir.close","type":"codeVoice"},{"text":"] on it.","type":"text"}],"type":"paragraph"}],"kind":"content"}],"hierarchy":{"paths":[["doc:\/\/GLib\/documentation\/GLib","doc:\/\/GLib\/documentation\/GLib\/DirProtocol"]]},"identifier":{"in