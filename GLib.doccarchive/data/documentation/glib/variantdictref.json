{"schemaVersion":{"minor":3,"major":0,"patch":0},"primaryContentSections":[{"kind":"declarations","declarations":[{"languages":["swift"],"tokens":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"VariantDictRef"}],"platforms":["macOS"]}]},{"kind":"content","content":[{"level":2,"type":"heading","anchor":"overview","text":"Overview"},{"type":"paragraph","inlineContent":[{"type":"text","text":"It can be used for doing a sequence of dictionary lookups in an"},{"text":" ","type":"text"},{"text":"efficient way on an existing ","type":"text"},{"isActive":true,"type":"reference","identifier":"doc:\/\/GLib\/documentation\/GLib\/Variant"},{"type":"text","text":" dictionary or it can be used"},{"type":"text","text":" "},{"type":"text","text":"to construct new dictionaries with a hashtable-like interface.  It"},{"text":" ","type":"text"},{"type":"text","text":"can also be used for taking existing dictionaries and modifying them"},{"type":"text","text":" "},{"type":"text","text":"in order to create new ones."}]},{"type":"paragraph","inlineContent":[{"isActive":true,"identifier":"doc:\/\/GLib\/documentation\/GLib\/VariantDict","type":"reference"},{"text":" can only be used with ","type":"text"},{"code":"G_VARIANT_TYPE_VARDICT","type":"codeVoice"},{"text":" ","type":"text"},{"type":"text","text":"dictionaries."}]},{"type":"paragraph","inlineContent":[{"text":"It is possible to use ","type":"text"},{"identifier":"doc:\/\/GLib\/documentation\/GLib\/VariantDict","isActive":true,"type":"reference"},{"type":"text","text":" allocated on the stack or on the"},{"type":"text","text":" "},{"type":"text","text":"heap.  When using a stack-allocated "},{"type":"reference","identifier":"doc:\/\/GLib\/documentation\/GLib\/VariantDict","isActive":true},{"text":", you begin with a","type":"text"},{"text":" ","type":"text"},{"text":"call to ","type":"text"},{"type":"codeVoice","code":"g_variant_dict_init()"},{"type":"text","text":" and free the resources with a call to"},{"type":"text","text":" "},{"type":"codeVoice","code":"g_variant_dict_clear()"},{"type":"text","text":"."}]},{"inlineContent":[{"text":"Heap-allocated ","type":"text"},{"identifier":"doc:\/\/GLib\/documentation\/GLib\/VariantDict","type":"reference","isActive":true},{"type":"text","text":" follows normal refcounting rules: you"},{"text":" ","type":"text"},{"type":"text","text":"allocate it with "},{"type":"codeVoice","code":"g_variant_dict_new()"},{"type":"text","text":" and use "},{"code":"g_variant_dict_ref()","type":"codeVoice"},{"type":"text","text":" "},{"type":"text","text":"and "},{"type":"codeVoice","code":"g_variant_dict_unref()"},{"text":".","type":"text"}],"type":"paragraph"},{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"g_variant_dict_end()"},{"type":"text","text":" is used to convert the "},{"isActive":true,"identifier":"doc:\/\/GLib\/documentation\/GLib\/VariantDict","type":"reference"},{"text":" back into a","type":"text"},{"text":" ","type":"text"},{"text":"dictionary-type ","type":"text"},{"type":"reference","identifier":"doc:\/\/GLib\/documentation\/GLib\/Variant","isActive":true},{"text":".  When used with stack-allocated instances,","type":"text"},{"type":"text","text":" "},{"text":"this also implicitly frees all associated memory, but for","type":"text"},{"type":"text","text":" "},{"text":"heap-allocated instances, you must still call ","type":"text"},{"type":"codeVoice","code":"g_variant_dict_unref()"},{"type":"text","text":" "},{"text":"afterwards.","type":"text"}]},{"inlineContent":[{"text":"You will typically want to use a heap-allocated ","type":"text"},{"type":"reference","isActive":true,"identifier":"doc:\/\/GLib\/documentation\/GLib\/VariantDict"},{"type":"text","text":" when"},{"text":" ","type":"text"},{"text":"you expose it as part of an API.  For most other uses, the","type":"text"},{"type":"text","text":" "},{"type":"text","text":"stack-allocated form will be more convenient."}],"type":"paragraph"},{"type":"paragraph","inlineContent":[{"type":"text","text":"Consider the following two examples that do the same thing in each"},{"type":"text","text":" "},{"type":"text","text":"style: take an existing dictionary and look up the “count” uint32"},{"text":" ","type":"text"},{"text":"key, adding 1 to it if it is found, or returning an error if the","type":"text"},{"type":"text","text":" "},{"text":"key is not found.  Each returns the new dictionary as a floating","type":"text"},{"text":" ","type":"text"},{"identifier":"doc:\/\/GLib\/documentation\/GLib\/Variant","isActive":true,"type":"reference"},{"type":"text","text":"."}]},{"level":2,"anchor":"Using-a-stack-allocated-GVariantDict","type":"heading","text":"Using a stack-allocated GVariantDict"},{"type":"paragraph","inlineContent":[{"text":"(C Language Example):","type":"text"}]},{"code":["  GVariant *","  add_to_count (GVariant  *orig,","                GError   **error)","  {","    GVariantDict dict;","    guint32 count;","","    g_variant_dict_init (&dict, orig);","    if (!g_variant_dict_lookup (&dict, \"count\", \"u\", &count))","      {","        g_set_error (...);","        g_variant_dict_clear (&dict);","        return NULL;","      }","","    g_variant_dict_insert (&dict, \"count\", \"u\", count + 1);","","    return g_variant_dict_end (&dict);","  }"],"syntax":"C","type":"codeListing"},{"text":"Using heap-allocated GVariantDict","anchor":"Using-heap-allocated-GVariantDict","type":"heading","level":2},{"inlineContent":[{"type":"text","text":"(C Language Example):"}],"type":"paragraph"},{"type":"codeListing","syntax":"C","code":["  GVariant *","  add_to_count (GVariant  *orig,","                GError   **error)","  {","    GVariantDict *dict;","    GVariant *result;","    guint32 count;","","    dict = g_variant_dict_new (orig);","","    if (g_variant_dict_lookup (dict, \"count\", \"u\", &count))","      {","        g_variant_dict_insert (dict, \"count\", \"u\", count + 1);","        result = g_variant_dict_end (dict);","      }","    else","      {","        g_set_error (...);","        result = NULL;","      }","","    g_variant_dict_unref (dict);","","    return result;","  }"]},{"inlineContent":[{"type":"text","text":"The "},{"identifier":"doc:\/\/GLib\/documentation\/GLib\/VariantDictRef","isActive":true,"type":"reference"},{"type":"text","text":" type acts as a lightweight Swift reference to an underlying "},{"code":"GVariantDict","type":"codeVoice"},{"text":" instance.","type":"text"},{"type":"text","text":" "},{"text":"It exposes methods that can operate on this data type through ","type":"text"},{"identifier":"doc:\/\/GLib\/documentation\/GLib\/VariantDictProtocol","type":"reference","isActive":true},{"text":" conformance.","type":"text"},{"text":" ","type":"text"},{"text":"Use ","type":"text"},{"type":"reference","isActive":true,"identifier":"doc:\/\/GLib\/documentation\/GLib\/VariantDictRef"},{"type":"text","text":" only as an "},{"code":"unowned","type":"codeVoice"},{"text":" reference to an existing ","type":"text"},{"type":"codeVoice","code":"GVariantDict"},{"text":" instance.","type":"text"}],"type":"paragraph"},{"name":"Note","style":"note","content":[{"inlineContent":[{"type":"text","text":"Use "},{"identifier":"doc:\/\/GLib\/documentation\/GLib\/VariantDict","isActive":true,"type":"reference"},{"text":" (instead of ","type":"text"},{"type":"reference","isActive":true,"identifier":"doc:\/\/GLib\/documentation\/GLib\/VariantDictRef"},{"text":") if you want to use Automatic Reference Counting for memory management of the underlying ","type":"text"},{"type":"codeVoice","code":"GVariantDict"},{"type":"text","text":" instance."}],"type":"paragraph"}],"type":"aside"}]}],"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/glib\/variantdictref"]}],"metadata":{"externalID":"s:4GLib14VariantDictRefV","roleHeading":"Structure","navigatorTitle":[{"text":"VariantDictRef","kind":"identifier"}],"role":"symbol","symbolKind":"struct","titl