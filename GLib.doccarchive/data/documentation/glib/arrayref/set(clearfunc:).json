{"metadata":{"symbolKind":"method","role":"symbol","roleHeading":"Instance Method","title":"set(clearFunc:)","extendedModule":"GLib","modules":[{"name":"GLib"}],"externalID":"s:4GLib13ArrayProtocolPAAE3set9clearFuncyySvSgXCSg_tF::SYNTHESIZED::s:4GLib8ArrayRefV","fragments":[{"text":"func","kind":"keyword"},{"text":" ","kind":"text"},{"kind":"identifier","text":"set"},{"kind":"text","text":"("},{"kind":"externalParam","text":"clearFunc"},{"text":": ","kind":"text"},{"preciseIdentifier":"c:@T@GDestroyNotify","kind":"typeIdentifier","text":"GDestroyNotify"},{"text":"?)","kind":"text"}]},"identifier":{"url":"doc:\/\/GLib\/documentation\/GLib\/ArrayRef\/set(clearFunc:)","interfaceLanguage":"swift"},"sections":[],"schemaVersion":{"minor":3,"patch":0,"major":0},"hierarchy":{"paths":[["doc:\/\/GLib\/documentation\/GLib","doc:\/\/GLib\/documentation\/GLib\/ArrayRef","doc:\/\/GLib\/documentation\/GLib\/ArrayRef\/ArrayProtocol-Implementations"]]},"variants":[{"paths":["\/documentation\/glib\/arrayref\/set(clearfunc:)"],"traits":[{"interfaceLanguage":"swift"}]}],"abstract":[{"type":"text","text":"Sets a function to clear an element of "},{"code":"array","type":"codeVoice"},{"type":"text","text":"."}],"primaryContentSections":[{"kind":"declarations","declarations":[{"tokens":[{"text":"func","kind":"keyword"},{"kind":"text","text":" "},{"text":"set","kind":"identifier"},{"text":"(","kind":"text"},{"kind":"externalParam","text":"clearFunc"},{"text":": ","kind":"text"},{"text":"GDestroyNotify","kind":"typeIdentifier","preciseIdentifier":"c:@T@GDestroyNotify"},{"text":"? = nil)","kind":"text"}],"platforms":["macOS"],"languages":["swift"]}]},{"kind":"content","content":[{"level":2,"text":"Discussion","type":"heading","anchor":"discussion"},{"inlineContent":[{"text":"The ","type":"text"},{"code":"clearFunc","type":"codeVoice"},{"type":"text","text":" will be called when an element in the array"},{"text":" ","type":"text"},{"type":"text","text":"data segment is removed and when the array is freed and data"},{"text":" ","type":"text"},{"type":"text","text":"segment is deallocated as well. "},{"code":"clearFunc","type":"codeVoice"},{"type":"text","text":" will be passed a"},{"text":" ","type":"text"},{"type":"text","text":"pointer to the element to clear, rather than the element itself."}],"type":"paragraph"},{"inlineContent":[{"text":"Note that in contrast with other uses of [callback","type":"text"},{"type":"reference","identifier":"doc:\/\/GLib\/documentation\/GLib\/DestroyNotify","isActive":true},{"type":"text","text":"]"},{"text":" ","type":"text"},{"text":"functions, ","type":"text"},{"code":"clearFunc","type":"codeVoice"},{"text":" is expected to clear the contents of","type":"text"},{"text":" ","type":"text"},{"text":"the array element it is given, but not free the element itself.","type":"text"}],"type":"paragraph"},{"type":"codeListing","code":["typedef struct","{","  gchar *str;","  GObject *obj;","} ArrayElement;","","static void","array_element_clear (ArrayElement *element)","{","  g_clear_pointer (&element->str, g_free);","  g_clear_object (&element->obj);","}","","\/\/ main code","GArray *garray = g_array_new (FALSE, FALSE, sizeof (ArrayElement));","g_array_set_clear_func (garray, (GDestroyNotify) array_element_clear);","\/\/ assign data to the structure","g_array_free (garray, TRUE);"],"syntax":"c"}]}],"kind":"symbol","references":{"doc://GLib/documentation/GLib/DestroyNotify":{"abstract":[{"type":"text","text":"Specifies the type of function which is called when a data element"},{"type":"text","text":" "},{"type":"text","text":"is destroyed. It is passed the pointer to the data element and"},{"text":" ","type":"text"},{"text":"should free any memory and resources allocated for it.","type":"text"}],"kind":"symbol","fragments":[{"kind":"keyword","text":"typealias"},{"text":" ","kind":"text"},{"text":"DestroyNotify","kind":"identifier"}],"url":"\/documentation\/glib\/destroynotify","identifier":"doc:\/\/GLib\/documentation\/GLib\/Dest