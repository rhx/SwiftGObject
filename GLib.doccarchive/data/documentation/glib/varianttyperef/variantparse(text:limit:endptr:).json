":"paragraph"},{"type":"paragraph","inlineContent":[{"text":"The format is described ","type":"text"},{"identifier":"gvariant-text-format.html","type":"reference","isActive":true},{"type":"text","text":"."}]},{"type":"paragraph","inlineContent":[{"text":"The memory at ","type":"text"},{"type":"codeVoice","code":"limit"},{"text":" will never be accessed and the parser behaves as","type":"text"},{"type":"text","text":" "},{"type":"text","text":"if the character at "},{"type":"codeVoice","code":"limit"},{"text":" is the nul terminator.  This has the","type":"text"},{"text":" ","type":"text"},{"type":"text","text":"effect of bounding "},{"type":"codeVoice","code":"text"},{"type":"text","text":"."}]},{"inlineContent":[{"text":"If ","type":"text"},{"code":"endptr","type":"codeVoice"},{"type":"text","text":" is non-"},{"type":"codeVoice","code":"nil"},{"type":"text","text":" then "},{"type":"codeVoice","code":"text"},{"type":"text","text":" is permitted to contain data"},{"text":" ","type":"text"},{"text":"following the value that this function parses and ","type":"text"},{"code":"endptr","type":"codeVoice"},{"type":"text","text":" will be"},{"type":"text","text":" "},{"text":"updated to point to the first character past the end of the text","type":"text"},{"text":" ","type":"text"},{"text":"parsed by this function.  If ","type":"text"},{"type":"codeVoice","code":"endptr"},{"text":" is ","type":"text"},{"type":"codeVoice","code":"nil"},{"type":"text","text":" and there is extra data"},{"text":" ","type":"text"},{"type":"text","text":"then an error is returned."}],"type":"paragraph"},{"inlineContent":[{"type":"text","text":"If "},{"code":"type","type":"codeVoice"},{"text":" is non-","type":"text"},{"code":"nil","type":"codeVoice"},{"type":"text","text":" then the value will be parsed to have that"},{"type":"text","text":" "},{"text":"type.  This may result in additional parse errors (in the case that","type":"text"},{"text":" ","type":"text"},{"type":"text","text":"the parsed value doesn’t fit the type) but may also result in fewer"},{"text":" ","type":"text"},{"type":"text","text":"errors (in the case that the type would have been ambiguous, such as"},{"text":" ","type":"text"},{"text":"with empty arrays).","type":"text"}],"type":"paragraph"},{"inlineContent":[{"text":"In the event that the parsing is successful, the resulting ","type":"text"},{"identifier":"doc:\/\/GLib\/documentation\/GLib\/Variant","isActive":true,"type":"reference"},{"type":"text","text":" "},{"type":"text","text":"is returned. It is never floating, and must be freed with"},{"type":"text","text":" "},{"text":"[method","type":"text"},{"type":"codeVoice","code":"GLib.Variant.unref"},{"text":"].","type":"text"}],"type":"paragraph"},{"inlineContent":[{"type":"text","text":"In case of any error, "},{"code":"nil","type":"codeVoice"},{"text":" will be returned.  If ","type":"text"},{"code":"error","type":"codeVoice"},{"type":"text","text":" is non-"},{"code":"nil","type":"codeVoice"},{"type":"text","text":" "},{"type":"text","text":"then it will be set to reflect the error that occurred."}],"type":"paragraph"},{"inlineContent":[{"text":"Officially, the language understood by the parser is “any string","type":"text"},{"type":"text","text":" "},{"type":"text","text":"produced by [method"},{"code":"GLib.Variant.print","type":"codeVoice"},{"text":"]”. This explicitly includes","type":"text"},{"type":"text","text":" "},{"code":"g_variant_print()","type":"codeVoice"},{"type":"text","text":"’s annotated types like "},{"type":"codeVoice","code":"int64 -1000"},{"text":".","type":"text"}],"type":"paragraph"},{"inlineContent":[{"type":"text","text":"There may be implementation specific restrictions on deeply nested values,"},{"type":"text","text":" "},{"text":"which would result in a ","type":"text"},{"code":"recursion","type":"codeVoice"},{"type":"text","text":" error. "},{"identifier":"doc:\/\/GLib\/documentation\/GLib\/Variant","isActive":true,"type":"reference"},{"text":" is",