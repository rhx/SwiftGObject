{"schemaVersion":{"minor":3,"major":0,"patch":0},"sections":[],"identifier":{"url":"doc:\/\/GLib\/documentation\/GLib\/RWLockProtocol","interfaceLanguage":"swift"},"hierarchy":{"paths":[["doc:\/\/GLib\/documentation\/GLib"]]},"kind":"symbol","relationshipsSections":[{"title":"Inherits From","kind":"relationships","identifiers":["doc:\/\/GLib\/documentation\/GLib\/PointerWrapper"],"type":"inheritsFrom"},{"kind":"relationships","identifiers":["doc:\/\/GLib\/documentation\/GLib\/RWLock","doc:\/\/GLib\/documentation\/GLib\/RWLockRef"],"type":"conformingTypes","title":"Conforming Types"}],"primaryContentSections":[{"kind":"declarations","declarations":[{"languages":["swift"],"platforms":["macOS"],"tokens":[{"kind":"keyword","text":"protocol"},{"text":" ","kind":"text"},{"text":"RWLockProtocol","kind":"identifier"},{"text":" : ","kind":"text"},{"preciseIdentifier":"s:4GLib14PointerWrapperP","kind":"typeIdentifier","text":"PointerWrapper","identifier":"doc:\/\/GLib\/documentation\/GLib\/PointerWrapper"}]}]},{"content":[{"level":2,"type":"heading","anchor":"overview","text":"Overview"},{"type":"paragraph","inlineContent":[{"text":"The difference to a mutex is that a reader-writer lock discriminates","type":"text"},{"type":"text","text":" "},{"type":"text","text":"between read-only (‘reader’) and full (‘writer’) access. While only"},{"type":"text","text":" "},{"type":"text","text":"one thread at a time is allowed write access (by holding the ‘writer’"},{"text":" ","type":"text"},{"type":"text","text":"lock via "},{"code":"g_rw_lock_writer_lock()","type":"codeVoice"},{"type":"text","text":"), multiple threads can gain"},{"type":"text","text":" "},{"text":"simultaneous read-only access (by holding the ‘reader’ lock via","type":"text"},{"type":"text","text":" "},{"type":"codeVoice","code":"g_rw_lock_reader_lock()"},{"text":").","type":"text"}]},{"inlineContent":[{"text":"It is unspecified whether readers or writers have priority in acquiring the","type":"text"},{"type":"text","text":" "},{"type":"text","text":"lock when a reader already holds the lock and a writer is queued to acquire"},{"type":"text","text":" "},{"type":"text","text":"it."}],"type":"paragraph"},{"type":"paragraph","inlineContent":[{"type":"text","text":"Here is an example for an array with access functions:"},{"text":" ","type":"text"},{"type":"text","text":"(C Language Example):"}]},{"code":["  GRWLock lock;","  GPtrArray *array;","","  gpointer","  my_array_get (guint index)","  {","    gpointer retval = NULL;","","    if (!array)","      return NULL;","","    g_rw_lock_reader_lock (&lock);","    if (index < array->len)","      retval = g_ptr_array_index (array, index);","    g_rw_lock_reader_unlock (&lock);","","    return retval;","  }","","  void","  my_array_set (guint index, gpointer data)","  {","    g_rw_lock_writer_lock (&lock);","","    if (!array)","      array = g_ptr_array_new ();","","    if (index >= array->len)","      g_ptr_array_set_size (array, index+1);","    g_ptr_array_index (array, index) = data;","","    g_rw_lock_writer_unlock (&lock);","  }"," "],"syntax":"C","type":"codeListing"},{"inlineContent":[{"text":"This example shows an array which can be accessed by many readers","type":"text"},{"type":"text","text":" "},{"type":"text","text":"(the "},{"code":"my_array_get()","type":"codeVoice"},{"text":" function) simultaneously, whereas the writers","type":"text"},{"text":" ","type":"text"},{"type":"text","text":"(the "},{"code":"my_array_set()","type":"codeVoice"},{"type":"text","text":" function) will only be allowed one at a time"},{"text":" ","type":"text"},{"type":"text","text":"and only if no readers currently access the array. This is because"},{"text":" ","type":"text"},{"type":"text","text":"of the potentially dangerous resizing of the array. Using these"},{"type":"text","text":" "},{"text":"functions is fully multi-thread safe now.","type":"text"}],"type":"paragraph"},{"type":"paragraph","inlineContent":[{"text":"If a ","type":"text"},{"isActive":true,"identifier":"doc:\/\/GLib\/documentation\/GLib\/RWLock","type":"reference"},{"type":"text","text":" is allocated in static storage then it can be used"},{"type":"text","text":" "},{"text":"without initialisation.  Otherwise, you should call","type":"text"},{"type":"text","text":" "},{"type":"codeVoice","code":"g_rw_lock_init()"},{"type":"text","text":" on it and "},{"code":"g_rw_lock_clear()","type":"codeVoice"},{"type":"text","text":" when done."}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"A GRWLock should only be accessed with the g_rw_lock_ functions."}]},{"inlineContent":[{"type":"text","text":"The "},{"type":"reference","identifier":"doc:\/\/GLib\/documentation\/GLib\/RWLockProtocol","isActive":true},{"text":" protocol exposes the methods and properties of an underlying ","type":"text"},{"type":"codeVoice","code":"GRWLock"},{"type":"text","text":" instance."},{"text":" ","type":"text"},{"text":"The default implementation of these can be found in the protocol extension below.","type":"text"},{"type":"text","text":" "},{"type":"text","text":"For a concrete class that implements these methods and properties, see "},{"isActive":true,"type":"reference","identifier":"doc:\/\/GLib\/documentation\/GLib\/RWLock"},{"type":"text","text":"."},{"text":" ","type":"text"},{"text":"Alternatively, use ","type":"text"},{"identifier":"doc:\/\/GLib\/documentation\/GLib\/RWLockRef","type":"reference","isActive":true},{"text":" as a lighweight, ","type":"text"},{"code":"unowned","type":"codeVoice"},{"type":"text","text":" reference if you already have an instance you just want to use."}],"type":"paragraph"}],"kind":"content"}],"abstract":[{"type":"text","text":"The GRWLock struct is an opaque data structure to represent a"},{"text":" ","type":"text"},{"text":"reader-writer lock. It is similar to a ","type":"text"},{"type":"reference","isActive":true,"identifier":"doc:\/\/GLib\/documentation\/GLib\/Mutex"},{"text":" in that it allows","type":"text"},{"text":" ","type":"text"},{"text":"multiple threads to coordinate access to a shared resource.","type":"text"}],"variants":[{"paths":["\/documentation\/glib\/rwlockprotocol"],"traits":[{"interfaceLanguage":"swift"}]}],"metadata":{"externalID":"s:4GLib14RWLockProtocolP","title":"RWLockProtocol","fragments":[{"text":"protocol","kind":"keyword"},{"kind":"text","text":" "},{"text":"RWLockProtocol","kind":"identifier"}],"roleHeading":"Protocol","role":"symbol","modules":[{"name":"GLib"}],"navigatorTitle":[{"text":"RWLockProtocol","kind":"identifier"}],"symbolKind":"protocol"},"topicSections":[{"generated":true,"identifiers":["doc:\/\/GLib\/documentation\/GLib\/RWLockProtocol\/clear()","doc:\/\/GLib\/documentation\/GLib\/RWLockProtocol\/init_()","doc:\/\/GLib\/documentation\/GLib\/RWLockProtocol\/readerLock()","doc:\/\/GLib\/documentation\/GLib\/RWLockProtocol\/readerTrylock()","doc:\/\/GLib\/documentation\/GLib\/RWLockProtocol\/readerUnlock()","doc:\/\/GLib\/documentation\/GLib\/RWLockProtocol\/writerLock()","doc:\/\/GLib\/documentation\/GLib\/RWLockProtocol\/writerTrylock()","doc:\/\/GLib\/documentation\/GLib\/RWLockProtocol\/writerUnlock()"],"anchor":"Instance-Methods","title":"Instance Methods"}],"references":{"doc://GLib/documentation/GLib/RWLock":{"title":"RWLock","url":"\/documentation\/glib\/rwlock","kind":"symbol","identifier":"doc:\/\/GLib\/documentation\/GLib\/RWLock","type":"topic","abstract":[{"type":"text","text":"The GRWLock struct is an opaque data structure to represent a"},{"text":" ","type":"text"},{"type":"text","text":"reader-writer lock. It is similar to a "},{"identifier":"doc:\/\/GLib\/documentation\/GLib\/Mutex","isActive":true,"type":"reference"},{"text":" in that it allows","type":"text"},{"text":" ","type":"text"},{"type":"text","text":"multiple threads to coordinate access to a shared resource."}],"navigatorTitle":[{"text":"RWLock","kind":"identifier"}],"role":"symbol","fragments":[{"kind":"keyword","text":"class"},{"kind":"text","text":" "},{"kind":"identifier","text":"RWLock"}]},"doc://GLib/documentation/GLib/RWLockProtocol":{"type":"topic","identifier":"doc:\/\/GLib\/documentation\/GLib\/RWLockProtocol","abstract":[{"type":"text","text":"The GRWLock struct is an opaque data structure to represent a"},{"text":" ","type":"text"},{"type":"text","text":"reader-writer lock. It is similar to a "},{"type":"reference","identifier":"doc:\/\/GLib\/documentation\/GLib\/Mutex","isActive":true},{"text":" in that it allows","type":"text"},{"type":"text","text":" "},{"type":"text","text":"multiple threads to coordinate access to a shared resource."}],"title":"RWLockProtocol","role":"symbol","fragments":[{"kind":"keyword","text":"protocol"},{"text":" ","kind":"text"},{"text":"RWLockProtocol","kind":"identifier"}],"url":"\/documentation\/glib\/rwlockprotocol","kind":"symbol","navigatorTitle":[{"text":"RWLockProtocol","kind":"identifier"}]},"doc://GLib/documentation/GLib/RWLockProtocol/readerLock()":{"role":"symbol","fragments":[{"text":"func","kind":"keyword"},{"kind":"text","text":" "},{"kind":"identifier","text":"readerLock"},{"text":"()","kind":"text"}],"identifier":"doc:\/\/GLib\/documentation\/GLib\/RWLockProtocol\/readerLock()","url":"\/documentation\/glib\/rwlockprotocol\/readerlock()","title":"readerLock()","abstract":[{"text":"Obtain a read lock on ","type":"text"},{"type":"codeVoice","code":"rwLock"},{"text":". If another thread currently holds","type":"text"},{"type":"text","text":" "},{"text":"the write lock on ","type":"text"},{"code":"rwLock","type":"codeVoice"},{"type":"text","text":", the current thread will block until the"},{"text":" ","type":"text"},{"text":"write lock was (held and) released. If another thread does not hold","type":"text"},{"type":"text","text":" "},{"text":"the write lock, but is waiting for it, it is implementation defined","type":"text"},{"type":"text","text":" "},{"type":"text","text":"whether the reader or writer will block. Read locks can be taken"},{"type":"text","text":" "}