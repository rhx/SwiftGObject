{"schemaVersion":{"patch":0,"major":0,"minor":3},"abstract":[{"text":"Checks the source for readiness.","type":"text"}],"primaryContentSections":[{"declarations":[{"languages":["swift"],"tokens":[{"text":"typealias","kind":"keyword"},{"kind":"text","text":" "},{"text":"SourceFuncsPrepareFunc","kind":"identifier"},{"kind":"text","text":" = "},{"text":"GSourceFuncsPrepareFunc","preciseIdentifier":"c:@T@GSourceFuncsPrepareFunc","kind":"typeIdentifier"}],"platforms":["macOS"]}],"kind":"declarations"},{"content":[{"anchor":"discussion","text":"Discussion","type":"heading","level":2},{"type":"paragraph","inlineContent":[{"type":"text","text":"Called before all the file descriptors are polled. If the"},{"text":" ","type":"text"},{"type":"text","text":"source can determine that it is ready here (without waiting for the"},{"type":"text","text":" "},{"type":"text","text":"results of the poll call) it should return "},{"type":"codeVoice","code":"true"},{"text":". It can also return","type":"text"},{"type":"text","text":" "},{"type":"text","text":"a "},{"type":"codeVoice","code":"timeout"},{"text":" value which should be the maximum timeout (in milliseconds)","type":"text"},{"text":" ","type":"text"},{"text":"which should be passed to the poll call. The actual timeout used will","type":"text"},{"type":"text","text":" "},{"type":"text","text":"be "},{"type":"codeVoice","code":"-1"},{"type":"text","text":" if all sources returned "},{"type":"codeVoice","code":"-1"},{"text":", or it will be the minimum of all","type":"text"},{"text":" ","type":"text"},{"type":"text","text":"the "},{"type":"codeVoice","code":"timeout"},{"type":"text","text":" values returned which were greater than or equal to "},{"code":"0","type":"codeVoice"},{"text":".","type":"text"},{"text":" ","type":"text"},{"type":"text","text":"If the prepare function returns a timeout and the source also has a"},{"text":" ","type":"text"},{"type":"text","text":"ready time set, then the lower of the two will be used."}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"Since 2.36 this may be "},{"type":"codeVoice","code":"NULL"},{"type":"text","text":", in which case the effect is as if the"},{"text":" ","type":"text"},{"text":"function always returns ","type":"text"},{"code":"FALSE","type":"codeVoice"},{"text":" with a timeout of ","type":"text"},{"type":"codeVoice","code":"-1"},{"text":".","type":"text"}]}],"kind":"content"}],"variants":[{"paths":["\/documentation\/glib\/sourcefuncspreparefunc"],"traits":[{"interfaceLanguage":"swift"}]}],"sections":[],"hierarchy":{"paths":[["doc:\/\/GLib\/documentation\/GLib"]]},"kind":"symbol","identifier":{"interfaceLanguage":"swift","url":"doc:\/\/GLib\/documentation\/GLib\/SourceFuncsPrepareFunc"},"metadata":{"externalID":"s:4GLib22SourceFuncsPrepareFunca","roleHeading":"Type Alias","modules":[{"name":"GLib"}],"title":"SourceFuncsPrepareFunc","symbolKind":"typealias","role":"symbol","fragments":[{"kind":"keyword","text":"typealias"},{"text":" ","kind":"text"},{"text":"SourceFuncsPrepareFunc","kind":"identifier"}],"navigatorTitle":[{"kind":"identifier","text":"SourceFuncsPrepareFunc"}]},"references":{"doc://GLib/documentation/GLib/SourceFuncsPrepareFunc":{"title":"SourceFuncsPrepareFunc","identifier":"doc:\/\/GLib\/documentation\/GLib\/SourceFuncsPrepareFunc","navigatorTitle":[{"kind":"identifier","text":"SourceFuncsPrepareFunc"}],"role":"symbol","url":"\/documentation\/glib\/sourcefuncspreparefunc","kind":"symbol","abstract":[{"text":"Checks the source for readiness.","type":"text"}],"type":"topic","fragments":[{"kind":"keyword","text":"typealias"},{"kind":"text","text":" "},{"text":"SourceFuncsPrepareFunc","kind":"identifier"}]},"doc://GLib/documentation/GLib":{"identifier":"doc:\/\/GLib\/documentation\/GLib","title":"GLib","abstract":[],"type":"topic","url":"\/documentation\/glib","kind":"symbol","role":"collection"}}}