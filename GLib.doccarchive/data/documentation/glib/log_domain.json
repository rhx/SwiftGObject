{"kind":"symbol","abstract":[{"text":"Libraries should define this so that any messages","type":"text"},{"type":"text","text":" "},{"type":"text","text":"which they log can be differentiated from messages from other"},{"type":"text","text":" "},{"text":"libraries and application code. But be careful not to define","type":"text"},{"type":"text","text":" "},{"type":"text","text":"it in any public header files."}],"sections":[],"hierarchy":{"paths":[["doc:\/\/GLib\/documentation\/GLib"]]},"metadata":{"platforms":[],"fragments":[{"text":"let","kind":"keyword"},{"text":" ","kind":"text"},{"text":"LOG_DOMAIN","kind":"identifier"},{"text":": ","kind":"text"},{"text":"Int","kind":"typeIdentifier","preciseIdentifier":"s:Si"}],"modules":[{"name":"GLib"}],"title":"LOG_DOMAIN","symbolKind":"var","externalID":"s:4GLib10LOG_DOMAINSivp","roleHeading":"Global Variable","role":"symbol"},"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/glib\/log_domain"]}],"primaryContentSections":[{"kind":"declarations","declarations":[{"languages":["swift"],"platforms":["macOS"],"tokens":[{"text":"let","kind":"keyword"},{"kind":"text","text":" "},{"kind":"identifier","text":"LOG_DOMAIN"},{"kind":"text","text":": "},{"preciseIdentifier":"s:Si","kind":"typeIdentifier","text":"Int"}]}]},{"kind":"content","content":[{"text":"Discussion","anchor":"discussion","type":"heading","level":2},{"inlineContent":[{"type":"text","text":"Log domains must be unique, and it is recommended that they are the"},{"text":" ","type":"text"},{"type":"text","text":"application or library name, optionally followed by a hyphen and a sub-domain"},{"type":"text","text":" "},{"text":"name. For example, ","type":"text"},{"code":"bloatpad","type":"codeVoice"},{"text":" or ","type":"text"},{"code":"bloatpad-io","type":"codeVoice"},{"text":".","type":"text"}],"type":"paragraph"},{"type":"paragraph","inlineContent":[{"type":"text","text":"If undefined, it defaults to the default "},{"type":"codeVoice","code":"nil"},{"type":"text","text":" (or "},{"code":"\"\"","type":"codeVoice"},{"text":") log domain; this is","type":"text"},{"type":"text","text":" "},{"type":"text","text":"not advisable, as it cannot be filtered against using the "},{"type":"codeVoice","code":"G_MESSAGES_DEBUG"},{"text":" ","type":"text"},{"text":"environment variable.","type":"text"}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"For example, GTK uses this in its "},{"type":"codeVoice","code":"Makefile.am"},{"type":"text","text":":"}]},{"type":"codeListing","syntax":null,"code":["AM_CPPFLAGS = -DG_LOG_DOMAIN=\\\"Gtk\\\""]},{"inlineContent":[{"text":"Applications can choose to leave it as the default ","type":"text"},{"type":"codeVoice","code":"nil"},{"text":" (or ","type":"text"},{"type":"codeVoice","code":"\"\""},{"text":")","type":"text"},{"type":"text","text":" "},{"text":"domain. However, defining the domain offers the same advantages as","type":"text"},{"type":"text","text":" "},{"type":"text","text":"above."}],"type":"paragraph"}]}],"identifier":{"url":"doc:\/\/GLib\/documentation\/GLib\/LOG_DOMAIN","interfaceLanguage":"swift"},"schemaVersion":{"major":0,"minor":3,"patch":0},"references":{"doc://GLib/documentation/GLib/LOG_DOMAIN":{"deprecated":true,"fragments":[{"text":"let","kind":"keyword"},{"text":" ","kind":"text"},{"text":"LOG_DOMAIN","kind":"identifier"},{"kind":"text","text":": "},{"kind":"typeIdentifier","text":"Int","preciseIdentifier":"s:Si"}],"role":"symbol","type":"topic","url":"\/documentation\/glib\/log_domain","identifier":"doc:\/\/GLib\/documentation\/GLib\/LOG_DOMAIN","kind":"symbol","abstract":[{"type":"text","text":"Libraries should define this so that any messages"},{"type":"text","text":" "},{"type":"text","text":"which they log can be differentiated from messages from other"},{"type":"text","text":" "},{"type":"text","text":"libraries and application code. But be careful not to define"},{"type":"text","text":" "},{"text":"it in any public header files.","type":"text"}],"title":"LOG_DOMAIN"},"doc://GLib/documentation/GLib":{"identifier":"doc:\/\/GLib\/documentation\/GLib","title":"GLib","abstract":[],"type":"topic","url":"\/documentation\/glib","kind":"symbol","role":"collection"}}}