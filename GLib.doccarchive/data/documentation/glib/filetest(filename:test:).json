{"schemaVersion":{"minor":3,"major":0,"patch":0},"hierarchy":{"paths":[["doc:\/\/GLib\/documentation\/GLib"]]},"abstract":[{"text":"Returns ","type":"text"},{"type":"codeVoice","code":"true"},{"type":"text","text":" if any of the tests in the bitfield "},{"code":"test","type":"codeVoice"},{"type":"text","text":" are"},{"type":"text","text":" "},{"code":"true","type":"codeVoice"},{"type":"text","text":". For example, "},{"type":"codeVoice","code":"(G_FILE_TEST_EXISTS | G_FILE_TEST_IS_DIR)"},{"text":" ","type":"text"},{"type":"text","text":"will return "},{"type":"codeVoice","code":"true"},{"type":"text","text":" if the file exists; the check whether it’s a"},{"text":" ","type":"text"},{"text":"directory doesn’t matter since the existence test is ","type":"text"},{"type":"codeVoice","code":"true"},{"text":". With","type":"text"},{"text":" ","type":"text"},{"text":"the current set of available tests, there’s no point passing in","type":"text"},{"text":" ","type":"text"},{"text":"more than one test at a time.","type":"text"}],"variants":[{"paths":["\/documentation\/glib\/filetest(filename:test:)"],"traits":[{"interfaceLanguage":"swift"}]}],"kind":"symbol","sections":[],"metadata":{"title":"fileTest(filename:test:)","roleHeading":"Function","symbolKind":"func","fragments":[{"text":"func","kind":"keyword"},{"text":" ","kind":"text"},{"kind":"identifier","text":"fileTest"},{"kind":"text","text":"("},{"kind":"externalParam","text":"filename"},{"kind":"text","text":": "},{"text":"UnsafePointer","kind":"typeIdentifier","preciseIdentifier":"s:SP"},{"text":"<","kind":"text"},{"kind":"typeIdentifier","preciseIdentifier":"c:@T@gchar","text":"gchar"},{"text":">!, ","kind":"text"},{"kind":"externalParam","text":"test"},{"kind":"text","text":": "},{"preciseIdentifier":"s:4GLib8FileTestV","kind":"typeIdentifier","text":"FileTest"},{"text":") -> ","kind":"text"},{"text":"Bool","kind":"typeIdentifier","preciseIdentifier":"s:Sb"}],"role":"symbol","externalID":"s:4GLib8fileTest8filename4testSbSPys4Int8VGSg_AA04FileC0VtF","modules":[{"name":"GLib"}]},"identifier":{"interfaceLanguage":"swift","url":"doc:\/\/GLib\/documentation\/GLib\/fileTest(filename:test:)"},"primaryContentSections":[{"declarations":[{"languages":["swift"],"platforms":["macOS"],"tokens":[{"kind":"keyword","text":"func"},{"kind":"text","text":" "},{"kind":"identifier","text":"fileTest"},{"text":"(","kind":"text"},{"kind":"externalParam","text":"filename"},{"text":": ","kind":"text"},{"kind":"typeIdentifier","preciseIdentifier":"s:SP","text":"UnsafePointer"},{"text":"<","kind":"text"},{"preciseIdentifier":"c:@T@gchar","text":"gchar","kind":"typeIdentifier"},{"text":">!, ","kind":"text"},{"kind":"externalParam","text":"test"},{"text":": ","kind":"text"},{"text":"FileTest","preciseIdentifier":"s:4GLib8FileTestV","identifier":"doc:\/\/GLib\/documentation\/GLib\/FileTest","kind":"typeIdentifier"},{"kind":"text","text":") -> "},{"text":"Bool","preciseIdentifier":"s:Sb","kind":"typeIdentifier"}]}],"kind":"declarations"},{"kind":"content","content":[{"text":"Discussion","type":"heading","anchor":"discussion","level":2},{"type":"paragraph","inlineContent":[{"text":"Apart from ","type":"text"},{"type":"codeVoice","code":"isSymlink"},{"text":" all tests follow symbolic links,","type":"text"},{"type":"text","text":" "},{"text":"so for a symbolic link to a regular file ","type":"text"},{"type":"codeVoice","code":"g_file_test()"},{"text":" will return","type":"text"},{"text":" ","type":"text"},{"type":"codeVoice","code":"true"},{"type":"text","text":" for both "},{"code":"isSymlink","type":"codeVoice"},{"type":"text","text":" and "},{"type":"codeVoice","code":"isRegular"},{"text":".","type":"text"}]},{"inlineContent":[{"type":"text","text":"Note, that for a dangling symbolic link "},{"type":"codeVoice","code":"g_file_test()"},{"text":" will return","type":"text"},{"text":" ","type":"text"},{"code":"true","type":"codeVoice"},{"text":" for ","type":"text"},{"type":"codeVoice","code":"isSymlink"},{"type":"text","text":" and "},{"type":"codeVoice","code":"false"},{"type":"text","text":" for all other flags."}],"type":"paragraph"},{"inlineContent":[{"type":"text","text":"You should never use "},{"type":"codeVoice","code":"g_file_test()"},{"text":" to test whether it is safe","type":"text"},{"text":" ","type":"text"},{"text":"to perform an operation, because there is always the possibility","type":"text"},{"type":"text","text":" "},{"text":"of the condition changing before you actually perform the operation,","type":"text"},{"type":"text","text":" "},{"text":"see ","type":"text"},{"type":"reference","identifier":"https:\/\/en.wikipedia.org\/wiki\/Time-of-check_to_time-of-use","isActive":true},{"type":"text","text":"."}],"type":"paragraph"},{"type":"paragraph","inlineContent":[{"type":"text","text":"For example, you might think you could use "},{"type":"codeVoice","code":"isSymlink"},{"text":" ","type":"text"},{"type":"text","text":"to know whether it is safe to write to a file without being"},{"type":"text","text":" "},{"type":"text","text":"tricked into writing into a different location. It doesn’t work!"}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"(C Language Example):"}]},{"syntax":"C","code":[" \/\/ DON'T DO THIS"," if (!g_file_test (filename, G_FILE_TEST_IS_SYMLINK))","   {","     fd = g_open (filename, O_WRONLY);","     \/\/ write to fd","   }",""," \/\/ DO THIS INSTEAD"," fd = g_open (filename, O_WRONLY | O_NOFOLLOW | O_CLOEXEC);"," if (fd == -1)","   {","     \/\/ check error","     if (errno == ELOOP)","       \/\/ file is a symlink and can be ignored","     else","       \/\/ handle errors as before","   }"," else","   {","     \/\/ write to fd","   }"],"type":"codeListing"},{"inlineContent":[{"type":"text","text":"Another thing to note is that "},{"code":"exists","type":"codeVoice"},{"type":"text","text":" and"},{"type":"text","text":" "},{"code":"isExecutable","type":"codeVoice"},{"text":" are implemented using the ","type":"text"},{"type":"codeVoice","code":"access()"},{"text":" ","type":"text"},{"type":"text","text":"system call. This usually doesn’t matter, but if your program"},{"type":"text","text":" "},{"type":"text","text":"is setuid or setgid it means that these tests will give you"},{"text":" ","type":"text"},{"type":"text","text":"the answer for the real user ID and group ID, rather than the"},{"text":" ","type":"text"},{"text":"effective user ID and group ID.","type":"text"}],"type":"paragraph"},{"type":"paragraph","inlineContent":[{"text":"On Windows, there are no symlinks, so testing for","type":"text"},{"type":"text","text":" "},{"code":"isSymlink","type":"codeVoice"},{"text":" will always return ","type":"text"},{"code":"false","type":"codeVoice"},{"type":"text","text":". Testing for"},{"text":" ","type":"text"},{"type":"codeVoice","code":"isExecutable"},{"text":" will just check that the file exists and","type":"text"},{"text":" ","type":"text"},{"text":"its name indicates that it is executable, checking for well-known","type":"text"},{"type":"text","text":" "},{"text":"extensions and those listed in the ","type":"text"},{"type":"codeVoice","code":"PATHEXT"},{"type":"text","text":" environment variable."}]}]}],"references":{"doc://GLib/documentation/GLib/fileTest(filename:test:)":{"title":"fileTest(filename:test:)","identifier":"doc:\/\/GLib\/documentation\/GLib\/fileTest(filename:test:)","role":"symbol","url":"\/documentation\/glib\/filetest(filename:test:)","kind":"symbol","abstract":[{"text":"Returns ","type":"text"},{"code":"true","type":"codeVoice"},{"type":"text","text":" if any of the tests in the bitfield "},{"code":"test","type":"codeVoice"},{"text":" are","type":"text"},{"type":"text","text":" "},{"code":"true","type":"codeVoice"},{"text":". For example, ","type":"text"},{"type":"codeVoice","code":"(G_FILE_TEST_EXISTS | G_FILE_TEST_IS_DIR)"},{"type":"text","text":" "},{"text":"will return ","type":"text"},{"type":"codeVoice","code":"true"},{"type":"text","text":" if the file exists; the check whether it’s a"},{"type":"text","text":" "},{"type":"text","text":"directory doesn’t matter since the existence test is "},{"code":"true","type":"codeVoice"},{"type":"text","text":". With"},{"type":"text","text":" "},{"text":"the current set of available tests, there’s no point passing in","type":"text"},{"type":"text","text":" "},{"type":"text","text":"more than one test at a time."}],"type":"topic","fragments":[{"kind":"keyword","text":"func"},{"text":" ","kind":"text"},{"text":"fileTest","kind":"identifier"},{"kind":"text","text":"("},{"text":"filename","kind":"externalParam"},{"text":": ","kind":"text"},{"text":"UnsafePointer","preciseIdentifier":"s:SP","kind":"typeIdentifier"},{"text":"<","kind":"text"},{"preciseIdentifier":"c:@T@gchar","kind":"typeIdentifier","text":"gchar"},{"kind":"text","text":">!, "},{"text":"test","kind":"externalParam"},{"text":": ","kind":"text"},{"text":"FileTest","kind":"typeIdentifier","preciseIdentifier":"s:4GLib8FileTestV"},{"kind":"text","text":") -> "},{"kind":"typeIdentifier","preciseIdentifier":"s:Sb","text":"Bool"}]},"doc://GLib/documentation/GLib":{"identifier":"doc:\/\/GLib\/documentation\/GLib","title":"GLib","abstract":[],"type":"topic","url":"\/documentation\/glib","kind":"symbol","role":"collection"},"https://en.wikipedia.org/wiki/Time-of-check_to_time-of-use":{"title":"TOCTOU","url":"https:\/\/en.wikipedia.org\/wiki\/Time-of-check_to_time-of-use","type":"link","titleInlineContent":[{"type":"text","text":"TOCTOU"}],"identifier":"https:\/\/en.wikipedia.org\/wiki\/Time-of-check_to_time-of-use"},"doc://GLib/documentation/GLib/FileTest":{"identifier":"doc:\/\/GLib\/documentation\/GLib\/FileTest","url":"\/documentation\/glib\/filetest","fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"kind":"identifier","text":"FileTest"}],"kind":"symbol","title":"FileTest","type":"topic","role":"symbol","navigatorTitle":[{"text":"FileTest","kind":"identifier"}],"abstract":[{"type":"text","text":"A test to perform on a file using "},{"type":"codeVoice","code":"g_file_test()"},{"type":"text","text":"."}]}}}