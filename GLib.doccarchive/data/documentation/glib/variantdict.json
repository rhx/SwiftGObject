tializers","generated":true},{"identifiers":["doc:\/\/GLib\/documentation\/GLib\/VariantDict\/ptr"],"generated":true,"title":"Instance Properties","anchor":"Instance-Properties"},{"title":"Default Implementations","anchor":"Default-Implementations","generated":true,"identifiers":["doc:\/\/GLib\/documentation\/GLib\/VariantDict\/VariantDictProtocol-Implementations"]}],"primaryContentSections":[{"declarations":[{"languages":["swift"],"platforms":["macOS"],"tokens":[{"text":"class","kind":"keyword"},{"kind":"text","text":" "},{"kind":"identifier","text":"VariantDict"}]}],"kind":"declarations"},{"kind":"content","content":[{"text":"Overview","type":"heading","anchor":"overview","level":2},{"type":"paragraph","inlineContent":[{"text":"It can be used for doing a sequence of dictionary lookups in an","type":"text"},{"text":" ","type":"text"},{"type":"text","text":"efficient way on an existing "},{"identifier":"doc:\/\/GLib\/documentation\/GLib\/Variant","type":"reference","isActive":true},{"type":"text","text":" dictionary or it can be used"},{"type":"text","text":" "},{"text":"to construct new dictionaries with a hashtable-like interface.  It","type":"text"},{"type":"text","text":" "},{"text":"can also be used for taking existing dictionaries and modifying them","type":"text"},{"type":"text","text":" "},{"text":"in order to create new ones.","type":"text"}]},{"type":"paragraph","inlineContent":[{"identifier":"doc:\/\/GLib\/documentation\/GLib\/VariantDict","type":"reference","isActive":true},{"text":" can only be used with ","type":"text"},{"code":"G_VARIANT_TYPE_VARDICT","type":"codeVoice"},{"type":"text","text":" "},{"text":"dictionaries.","type":"text"}]},{"type":"paragraph","inlineContent":[{"text":"It is possible to use ","type":"text"},{"identifier":"doc:\/\/GLib\/documentation\/GLib\/VariantDict","isActive":true,"type":"reference"},{"type":"text","text":" allocated on the stack or on the"},{"type":"text","text":" "},{"type":"text","text":"heap.  When using a stack-allocated "},{"identifier":"doc:\/\/GLib\/documentation\/GLib\/VariantDict","isActive":true,"type":"reference"},{"text":", you begin with a","type":"text"},{"type":"text","text":" "},{"text":"call to ","type":"text"},{"code":"g_variant_dict_init()","type":"codeVoice"},{"text":" and free the resources with a call to","type":"text"},{"type":"text","text":" "},{"type":"codeVoice","code":"g_variant_dict_clear()"},{"type":"text","text":"."}]},{"inlineContent":[{"text":"Heap-allocated ","type":"text"},{"isActive":true,"type":"reference","identifier":"doc:\/\/GLib\/documentation\/GLib\/VariantDict"},{"type":"text","text":" follows normal refcounting rules: you"},{"type":"text","text":" "},{"text":"allocate it with ","type":"text"},{"code":"g_variant_dict_new()","type":"codeVoice"},{"text":" and use ","type":"text"},{"type":"codeVoice","code":"g_variant_dict_ref()"},{"type":"text","text":" "},{"type":"text","text":"and "},{"type":"codeVoice","code":"g_variant_dict_unref()"},{"type":"text","text":"."}],"type":"paragraph"},{"inlineContent":[{"type":"codeVoice","code":"g_variant_dict_end()"},{"type":"text","text":" is used to convert the "},{"isActive":true,"type":"reference","identifier":"doc:\/\/GLib\/documentation\/GLib\/VariantDict"},{"text":" back into a","type":"text"},{"text":" ","type":"text"},{"type":"text","text":"dictionary-type "},{"isActive":true,"type":"reference","identifier":"doc:\/\/GLib\/documentation\/GLib\/Variant"},{"text":".  When used with stack-allocated instances,","type":"text"},{"type":"text","text":" "},{"type":"text","text":"this also implicitly frees all associated memory, but for"},{"text":" ","type":"text"},{"text":"heap-allocated instances, you must still call ","type":"text"},{"type":"codeVoice","code":"g_variant_dict_unref()"},{"text":" ","type":"text"},{"text":"afterwards.","type":"text"}],"type":"paragraph"},{"type":"paragraph","inlineContent":[{"text":"You will typically want to use a heap-allocated ","type":"text"},{"type":"reference","isActive":true,"identifier":"doc:\/\/GLib\/documentation\/GLib\/VariantDict"},{"type":"text","text":" when"},{"type":"text","text":" "},{"type":"text","text":"you expose it as part of an API.  For most other uses, the"},{"type":"text","text":" "},{"type":"text","text":"stack-allocated form will be more convenient."}]},{"type":"paragraph","inlineContent":[{"text":"Consider the following two examples that do the same thing in each","type":"text"},{"text":" ","type":"text"},{"type":"text","text":"style: take an existing dictionary and look up the “count” uint32"},{"type":"text","text":" "},{"text":"key, adding 1 to it if it is found, or returning an error if the","type":"text"},{"text":" ","type":"text"},{"text":"key is not found.  Each returns the new dictionary as a floating","type":"text"},{"text":" ","type":"text"},{"type":"reference","identifier":"doc:\/\/GLib\/documentation\/GLib\/Variant","isActive":true},{"type":"text","text":"."}]},{"text":"Using a stack-allocated GVariantDict","type":"heading","level":2,"anchor":"Using-a-stack-allocated-GVariantDict"},{"inlineContent":[{"text":"(C Language Example):","type":"text"}],"type":"paragraph"},{"code":["  GVariant *","  add_to_count (GVariant  *orig,","                GError   **error)","  {","    GVariantDict dict;","    guint32 count;","","    g_variant_dict_init (&dict, orig);","    if (!g_variant_dict_lookup (&dict, \"count\", \"u\", &count))","      {","        g_set_error (...);","        g_variant_dict_clear (&dict);","        return NULL;","      }","","    g_variant_dict_insert (&dict, \"count\", \"u\", count + 1);","","    return g_variant_dict_end (&dict);","  }"],"syntax":"C","type":"codeListing"},{"level":2,"type":"heading","text":"Using heap-allocated GVariantDict","anchor":"Using-heap-allocated-GVariantDict"},{"type":"paragraph","inlineContent":[{"type":"text","text":"(C Language Example):"}]},{"syntax":"C","type":"codeListing","code":["  GVariant *","  add_to_count (GVariant  *orig,","                GError   **error)","  {","    GVariantDict *dict;","    GVariant *result;","    guint32 count;","","    dict = g_variant_dict_new (orig);","","    if (g_variant_dict_lookup (dict, \"count\", \"u\", &count))","      {","        g_variant_dict_insert (dict, \"count\", \"u\", count + 1);","        result = g_variant_dict_end (dict);","      }","    else","      {","        g_set_error (...);","        result = NULL;","      }","","    g_variant_dict_unref (dict);","","    return result;","  }"]},{"type":"paragraph","inlineContent":[{"type":"text","text":"The "},{"identifier":"doc:\/\/GLib\/documentation\/GLib\/VariantDict","type":"reference","isActive":true},{"type":"text","text":" type acts as a reference-counted owner of an underlying "},{"type":"codeVoice","code":"GVariantDict"},{"text":" instance.","type":"text"},{"text":" ","type":"text"},{"text":"It provides the methods that can operate on this data type through ","type":"text"},{"isActive":true,"type":"reference","identifier":"doc:\/\/GLib\/documentation\/GLib\/VariantDictProtocol"},{"text":" conformance.","type":"text"},{"text":" ","type":"text"},{"text":"Use ","type":"text"},{"isActive":true,"type":"reference","identifier":"doc:\/\/GLib\/documentation\/GLib\/VariantDict"},{"text":" as a strong reference or owner of a ","type":"text"},{"type":"codeVoice","code":"GVariantDict"},{"text":" instance.","type":"text"}]},{"type":"aside","content":[{"inlineContent":[{"text":"Use ","type":"text"},{"identifier":"doc:\/\/GLib\/documentation\/GLib\/VariantDictRef","isActive":true,"type":"reference"},{"text":" (instead of ","type":"text"},{"type":"reference","identifier":"doc:\/\/GLib\/documentation\/GLib\/VariantDict","isActive":true},{"text":") for a lightweight Swift reference to an underlying ","type":"text"},{"code":"GVariantDict","type":"codeVoice"},{"type":"text","text":" instance."}],"type":"paragraph"}],"name":"Note","style":"note"}]}],"identifier":{"url":"doc:\/\/GLib\/documentation\/GLib\/VariantDict","interfaceLan