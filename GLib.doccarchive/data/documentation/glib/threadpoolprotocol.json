{"relationshipsSections":[{"title":"Inherits From","identifiers":["doc:\/\/GLib\/documentation\/GLib\/PointerWrapper"],"type":"inheritsFrom","kind":"relationships"},{"identifiers":["doc:\/\/GLib\/documentation\/GLib\/ThreadPool","doc:\/\/GLib\/documentation\/GLib\/ThreadPoolRef"],"kind":"relationships","title":"Conforming Types","type":"conformingTypes"}],"schemaVersion":{"minor":3,"patch":0,"major":0},"hierarchy":{"paths":[["doc:\/\/GLib\/documentation\/GLib"]]},"sections":[],"metadata":{"title":"ThreadPoolProtocol","roleHeading":"Protocol","symbolKind":"protocol","externalID":"s:4GLib18ThreadPoolProtocolP","role":"symbol","modules":[{"name":"GLib"}],"navigatorTitle":[{"kind":"identifier","text":"ThreadPoolProtocol"}],"fragments":[{"text":"protocol","kind":"keyword"},{"kind":"text","text":" "},{"text":"ThreadPoolProtocol","kind":"identifier"}]},"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/glib\/threadpoolprotocol"]}],"kind":"symbol","identifier":{"url":"doc:\/\/GLib\/documentation\/GLib\/ThreadPoolProtocol","interfaceLanguage":"swift"},"topicSections":[{"generated":true,"title":"Instance Properties","identifiers":["doc:\/\/GLib\/documentation\/GLib\/ThreadPoolProtocol\/exclusive","doc:\/\/GLib\/documentation\/GLib\/ThreadPoolProtocol\/func","doc:\/\/GLib\/documentation\/GLib\/ThreadPoolProtocol\/maxThreads","doc:\/\/GLib\/documentation\/GLib\/ThreadPoolProtocol\/numThreads","doc:\/\/GLib\/documentation\/GLib\/ThreadPoolProtocol\/userData"],"anchor":"Instance-Properties"},{"title":"Instance Methods","generated":true,"identifiers":["doc:\/\/GLib\/documentation\/GLib\/ThreadPoolProtocol\/free(immediate:wait:)","doc:\/\/GLib\/documentation\/GLib\/ThreadPoolProtocol\/getMaxThreads()","doc:\/\/GLib\/documentation\/GLib\/ThreadPoolProtocol\/getNumThreads()","doc:\/\/GLib\/documentation\/GLib\/ThreadPoolProtocol\/moveToFront(data:)","doc:\/\/GLib\/documentation\/GLib\/ThreadPoolProtocol\/push(data:)","doc:\/\/GLib\/documentation\/GLib\/ThreadPoolProtocol\/set(maxThreads:)","doc:\/\/GLib\/documentation\/GLib\/ThreadPoolProtocol\/setSortFunction(func:userData:)","doc:\/\/GLib\/documentation\/GLib\/ThreadPoolProtocol\/unprocessed()"],"anchor":"Instance-Methods"}],"primaryContentSections":[{"declarations":[{"tokens":[{"text":"protocol","kind":"keyword"},{"text":" ","kind":"text"},{"kind":"identifier","text":"ThreadPoolProtocol"},{"kind":"text","text":" : "},{"preciseIdentifier":"s:4GLib14PointerWrapperP","kind":"typeIdentifier","identifier":"doc:\/\/GLib\/documentation\/GLib\/PointerWrapper","text":"PointerWrapper"}],"languages":["swift"],"platforms":["macOS"]}],"kind":"declarations"},{"kind":"content","content":[{"text":"Overview","level":2,"anchor":"overview","type":"heading"},{"inlineContent":[{"text":"A thread pool is useful when you wish to asynchronously fork out the execution of work","type":"text"},{"type":"text","text":" "},{"type":"text","text":"and continue working in your own thread. If that will happen often, the overhead of starting"},{"text":" ","type":"text"},{"text":"and destroying a thread each time might be too high. In such cases reusing already started","type":"text"},{"text":" ","type":"text"},{"text":"threads seems like a good idea. And it indeed is, but implementing this can be tedious","type":"text"},{"type":"text","text":" "},{"type":"text","text":"and error-prone."}],"type":"paragraph"},{"inlineContent":[{"type":"text","text":"Therefore GLib provides thread pools for your convenience. An added advantage is, that the"},{"type":"text","text":" "},{"type":"text","text":"threads can be shared between the different subsystems of your program, when they are using GLib."}],"type":"paragraph"},{"inlineContent":[{"text":"To create a new thread pool, you use [func","type":"text"},{"code":"GLib.ThreadPool.new","type":"codeVoice"},{"text":"].","type":"text"},{"type":"text","text":" "},{"text":"It is destroyed by [method","type":"text"},{"type":"codeVoice","code":"GLib.ThreadPool.free"},{"text":"].","type":"text"}],"type":"paragraph"},{"type":"paragraph","inlineContent":[{"text":"If you want to execute a certain task within a thread pool, use [method","type":"text"},{"type":"codeVoice","code":"GLib.ThreadPool.push"},{"text":"].","type":"text"}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"To get the current number of running threads you call [method"},{"type":"codeVoice","code":"GLib.ThreadPool.get_num_threads"},{"text":"].","type":"text"},{"text":" ","type":"text"},{"text":"To get the number of still unprocessed tasks you call [method","type":"text"},{"type":"codeVoice","code":"GLib.ThreadPool.unprocessed"},{"text":"].","type":"text"},{"type":"text","text":" "},{"type":"text","text":"To control the maximum number of threads for a thread pool, you use"},{"type":"text","text":" "},{"type":"text","text":"[method"},{"code":"GLib.ThreadPool.get_max_threads","type":"codeVoice"},{"type":"text","text":"]. and [method"},{"code":"GLib.ThreadPool.set_max_threads","type":"codeVoice"},{"type":"text","text":"]."}]},{"inlineContent":[{"type":"text","text":"Finally you can control the number of unused threads, that are kept alive by GLib for future use."},{"type":"text","text":" "},{"type":"text","text":"The current number can be fetched with [func"},{"type":"codeVoice","code":"GLib.ThreadPool.get_num_unused_threads"},{"type":"text","text":"]."},{"type":"text","text":" "},{"text":"The maximum number can be controlled by [func","type":"text"},{"type":"codeVoice","code":"GLib.ThreadPool.get_max_unused_threads"},{"type":"text","text":"] and"},{"text":" ","type":"text"},{"text":"[func","type":"text"},{"code":"GLib.ThreadPool.set_max_unused_threads","type":"codeVoice"},{"type":"text","text":"]. All currently unused threads"},{"type":"text","text":" "},{"text":"can be stopped by calling [func","type":"text"},{"code":"GLib.ThreadPool.stop_unused_threads","type":"codeVoice"},{"text":"].","type":"text"}],"type":"paragraph"},{"type":"paragraph","inlineContent":[{"type":"text","text":"The "},{"type":"reference","identifier":"doc:\/\/GLib\/documentation\/GLib\/ThreadPoolProtocol","isActive":true},{"type":"text","text":" protocol exposes the methods and properties of an underlying "},{"code":"GThreadPool","type":"codeVoice"},{"type":"text","text":" instance."},{"type":"text","text":" "},{"type":"text","text":"The default implementation of these can be found in the protocol extension below."},{"type":"text","text":" "},{"type":"text","text":"For a concrete class that implements these methods and properties, see "},{"type":"reference","isActive":true,"identifier":"doc:\/\/GLib\/documentation\/GLib\/ThreadPool"},{"type":"text","text":"."},{"text":" ","type":"text"},{"text":"Alternatively, use ","type":"text"},{"identifier":"doc:\/\/GLib\/documentation\/GLib\/ThreadPoolRef","type":"reference","isActive":true},{"type":"text","text":" as a lighweight, "},{"code":"unowned","type":"codeVoice"},{"type":"text","text":" reference if you already have an instance you just want to use."}]}]}],"abstract":[{"text":"The ","type":"text"},{"code":"GThreadPool","type":"codeVoice"},{"text":" struct represents a thread pool.","type":"text"}],"references":{"doc://GLib/documentation/GLib/ThreadPoolProtocol/numThreads":{"kind":"symbol","abstract":[{"text":"Returns the number of threads currently running in ","type":"text"},{"type":"codeVoice","code":"pool"},{"type":"text","text":"."}],"type":"topic","identifier":"doc:\/\/GLib\/documentation\/GLib\/ThreadPoolProtocol\/numThreads","fragments":[{"kind":"keyword","text":"var"},{"text":" ","kind":"text"},{"kind":"identifier","text":"numThreads"},{"kind":"text","text":": "},{"kind":"typeIdentifier","preciseIdentifier":"s:Si","text":"Int"}],"title":"numThreads","url":"\/documentation\/glib\/threadpoolprotocol\/numthreads","role":"symbol"},"doc://GLib/documentation/GLib/ThreadPoolProtocol/setSortFunction(func:userData:)":{"title":"setSortFunction(func:userData:)","abstract":[{"type":"text","text":"Sets the function used to sort the list of tasks. This allows the"},{"type":"text","text":" "},{"type":"text","text":"tasks to be processed by a priority determined by "},{"code":"func","type":"codeVoice"},{"type":"text","text":", and not"},{"type":"text","text":" "},{"text":"just in the order in which they were added to the pool.","type":"text"}],"url":"\/documentation\/glib\/threadpoolprotocol\/setsortfunction(func:userdata:)","kind":"symbol","type":"topic","role":"symbol","identifier":"doc:\/\/GLib\/documentation\/GLib\/ThreadPoolProtocol\/setSortFunction(func:userData:)","fragments":[{"kind":"keyword","text":"func"},{"kind":"text","text":" "},{"text":"setSortFunction","kind":"identifier"},{"kind":"text","text":"("},{"kind":"externalParam","text":"func"},{"kind":"text","text":": "},{"kind":"typeIdentifier","preciseIdentifier":"c:@T@GCompareDataFunc","text":"GCompareDataFunc"},{"text":"?, ","kind":"text"},{"text":"userData","kind":"externalParam"},{"kind":"text","text":": "},{"kind":"typeIdentifier","preciseIdentifier":"c:@T@gpointer","text":"gpointer"},{"text":"?)","kind":"text"}]},"doc://GLib/documentation/GLib/ThreadPoolProtocol":{"kind":"symbol","url":"\/documentation\/glib\/threadpoolprotocol","type":"topic","identifier":"doc:\/\/GLib\/documentation\/GLib\/ThreadPoolProtocol","role":"symbol","title":"ThreadPoolProtocol","navigatorTitle":[{"text":"ThreadPoolProtocol","kind":"identifier"}],"fragments":[{"kind":"keyword","text":"protocol"},{"text":" ","kind":"text"},{"text":"ThreadPoolProtocol","kind":"identifier"}],"abstract":[{"type":"text","text":"The "},{"code":"GThreadPool","type":"codeVoice"},{"type":"text","text":" struct represents a thread pool."}]},"doc://GLib/documentation/GLib/ThreadPoolProtocol/free(immediate:wait:)":{"abstract":[{"text":"Frees all resources allocated for ","type":"text"},{"code":"pool","type":"codeVoice"},{"type":"text","text":"."}],"url":"\/documentation\/glib\/threadpoolprotocol\/free(immediate:wait:)","role":"symbol","identifier":"doc