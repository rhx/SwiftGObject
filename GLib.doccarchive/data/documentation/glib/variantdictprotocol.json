{"kind":"symbol","hierarchy":{"paths":[["doc:\/\/GLib\/documentation\/GLib"]]},"topicSections":[{"generated":true,"identifiers":["doc:\/\/GLib\/documentation\/GLib\/VariantDictProtocol\/variant_dict_ptr-6dgor"],"anchor":"Instance-Properties","title":"Instance Properties"},{"generated":true,"identifiers":["doc:\/\/GLib\/documentation\/GLib\/VariantDictProtocol\/clear()","doc:\/\/GLib\/documentation\/GLib\/VariantDictProtocol\/contains(key:)","doc:\/\/GLib\/documentation\/GLib\/VariantDictProtocol\/end()","doc:\/\/GLib\/documentation\/GLib\/VariantDictProtocol\/init_(from:)-2u3tj","doc:\/\/GLib\/documentation\/GLib\/VariantDictProtocol\/init_(from:)-5rs48","doc:\/\/GLib\/documentation\/GLib\/VariantDictProtocol\/insertValue(key:value:)","doc:\/\/GLib\/documentation\/GLib\/VariantDictProtocol\/lookupValue(key:expectedType:)-7v6kw","doc:\/\/GLib\/documentation\/GLib\/VariantDictProtocol\/lookupValue(key:expectedType:)-9lxae","doc:\/\/GLib\/documentation\/GLib\/VariantDictProtocol\/ref()","doc:\/\/GLib\/documentation\/GLib\/VariantDictProtocol\/remove(key:)","doc:\/\/GLib\/documentation\/GLib\/VariantDictProtocol\/unref()"],"title":"Instance Methods","anchor":"Instance-Methods"}],"sections":[],"metadata":{"navigatorTitle":[{"text":"VariantDictProtocol","kind":"identifier"}],"role":"symbol","symbolKind":"protocol","fragments":[{"kind":"keyword","text":"protocol"},{"text":" ","kind":"text"},{"kind":"identifier","text":"VariantDictProtocol"}],"modules":[{"name":"GLib"}],"externalID":"s:4GLib19VariantDictProtocolP","title":"VariantDictProtocol","roleHeading":"Protocol"},"identifier":{"url":"doc:\/\/GLib\/documentation\/GLib\/VariantDictProtocol","interfaceLanguage":"swift"},"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/glib\/variantdictprotocol"]}],"primaryContentSections":[{"kind":"declarations","declarations":[{"tokens":[{"text":"protocol","kind":"keyword"},{"text":" ","kind":"text"},{"text":"VariantDictProtocol","kind":"identifier"},{"text":" : ","kind":"text"},{"preciseIdentifier":"s:4GLib14PointerWrapperP","identifier":"doc:\/\/GLib\/documentation\/GLib\/PointerWrapper","kind":"typeIdentifier","text":"PointerWrapper"}],"languages":["swift"],"platforms":["macOS"]}]},{"kind":"content","content":[{"text":"Overview","type":"heading","level":2,"anchor":"overview"},{"type":"paragraph","inlineContent":[{"text":"It can be used for doing a sequence of dictionary lookups in an","type":"text"},{"text":" ","type":"text"},{"type":"text","text":"efficient way on an existing "},{"type":"reference","identifier":"doc:\/\/GLib\/documentation\/GLib\/Variant","isActive":true},{"text":" dictionary or it can be used","type":"text"},{"type":"text","text":" "},{"type":"text","text":"to construct new dictionaries with a hashtable-like interface.  It"},{"text":" ","type":"text"},{"text":"can also be used for taking existing dictionaries and modifying them","type":"text"},{"text":" ","type":"text"},{"text":"in order to create new ones.","type":"text"}]},{"inlineContent":[{"type":"reference","isActive":true,"identifier":"doc:\/\/GLib\/documentation\/GLib\/VariantDict"},{"text":" can only be used with ","type":"text"},{"type":"codeVoice","code":"G_VARIANT_TYPE_VARDICT"},{"type":"text","text":" "},{"type":"text","text":"dictionaries."}],"type":"paragraph"},{"type":"paragraph","inlineContent":[{"text":"It is possible to use ","type":"text"},{"identifier":"doc:\/\/GLib\/documentation\/GLib\/VariantDict","type":"reference","isActive":true},{"text":" allocated on the stack or on the","type":"text"},{"type":"text","text":" "},{"text":"heap.  When using a stack-allocated ","type":"text"},{"identifier":"doc:\/\/GLib\/documentation\/GLib\/VariantDict","isActive":true,"type":"reference"},{"type":"text","text":", you begin with a"},{"type":"text","text":" "},{"text":"call to ","type":"text"},{"code":"g_variant_dict_init()","type":"codeVoice"},{"type":"text","text":" and free the resources with a call to"},{"text":" ","type":"text"},{"type":"codeVoice","code":"g_variant_dict_clear()"},{"text":".","type":"text"}]},{"type":"paragraph","inlineContent":[{"text":"Heap-allocated ","type":"text"},{"identifier":"doc:\/\/GLib\/documentation\/GLib\/VariantDict","type":"reference","isActive":true},{"text":" follows normal refcounting rules: you","type":"text"},{"text":" ","type":"text"},{"type":"text","text":"allocate it with "},{"code":"g_variant_dict_new()","type":"codeVoice"},{"type":"text","text":" and use "},{"code":"g_variant_dict_ref()","type":"codeVoice"},{"type":"text","text":" "},{"text":"and ","type":"text"},{"code":"g_variant_dict_unref()","type":"codeVoice"},{"text":".","type":"text"}]},{"type":"paragraph","inlineContent":[{"code":"g_variant_dict_end()","type":"codeVoice"},{"type":"text","text":" is used to convert the "},{"isActive":true,"identifier":"doc:\/\/GLib\/documentation\/GLib\/VariantDict","type":"reference"},{"type":"text","text":" back into a"},{"text":" ","type":"text"},{"text":"dictionary-type ","type":"text"},{"type":"reference","isActive":true,"identifier":"doc:\/\/GLib\/documentation\/GLib\/Variant"},{"text":".  When used with stack-allocated instances,","type":"text"},{"type":"text","text":" "},{"text":"this also implicitly frees all associated memory, but for","type":"text"},{"type":"text","text":" "},{"type":"text","text":"heap-allocated instances, you must still call "},{"type":"codeVoice","code":"g_variant_dict_unref()"},{"type":"text","text":" "},{"text":"afterwards.","type":"text"}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"You will typically want to use a heap-allocated "},{"type":"reference","identifier":"doc:\/\/GLib\/documentation\/GLib\/VariantDict","isActive":true},{"text":" when","type":"text"},{"type":"text","text":" "},{"text":"you expose it as part of an API.  For most other uses, the","type":"text"},{"type":"text","text":" "},{"type":"text","text":"stack-allocated form will be more convenient."}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"Consider the following two examples that do the same thing in each"},{"text":" ","type":"text"},{"text":"style: take an existing dictionary and look up the “count” uint32","type":"text"},{"type":"text","text":" "},{"text":"key, adding 1 to it if it is found, or returning an error if the","type":"text"},{"text":" ","type":"text"},{"text":"key is not found.  Each returns the new dictionary as a floating","type":"text"},{"type":"text","text":" "},{"isActive":true,"identifier":"doc:\/\/GLib\/documentation\/GLib\/Variant","type":"reference"},{"type":"text","text":"."}]},{"anchor":"Using-a-stack-allocated-GVariantDict","type":"heading","text":"Using a stack-allocated GVariantDict","level":2},{"type":"paragraph","inlineContent":[{"text":"(C Language Example):","type":"text"}]},{"code":["  GVariant *","  add_to_count (GVariant  *orig,","                GError   **error)","  {","    GVariantDict dict;","    guint32 count;","","    g_variant_dict_init (&dict, orig);","    if (!g_variant_dict_lookup (&dict, \"count\", \"u\", &count))","      {","        g_set_error (...);","        g_variant_dict_clear (&dict);","        return NULL;","      }","","    g_variant_dict_insert (&dict, \"count\", \"u\", count + 1);","","    return g_variant_dict_end (&dict);","  }"],"type":"codeListing","syntax":"C"},{"text":"Using heap-allocated GVariantDict","type":"heading","level":2,"anchor":"Using-heap-allocated-GVariantDict"},{"type":"paragraph","inlineContent":[{"type":"text","text":"(C Language Example):"}]},{"type":"codeListing","code":["  GVariant *","  add_to_count (GVariant  *orig,","                GError   **error)","  {","    GVariantDict *dict;","    GVariant *result;","    guint32 count;","","    dict = g_variant_dict_new (orig);","","    if (g_variant_dict_lookup (dict, \"count\", \"u\", &count))","      {","        g_variant_dict_insert (dict, \"count\", \"u\", count + 1);","        result = g_variant_dict_end (dict);","      }","    else","      {","        g_set_error (...);","        result = NULL;","      }","","    g_variant_dict_unref (dict);","","    return result;","  }"],"syntax":"C"},{"type":"paragraph","inlineContent":[{"text":"The ","type":"text"},{"isActive":true,"type":"reference","identifier":"doc:\/\/GLib\/documentation\/GLib\/VariantDictProtocol"},{"text":" protocol exposes the methods and properties of an underlying ","type":"text"},{"code":"GVariantDict","type":"codeVoice"},{"text":" instance.","type":"text"},{"type":"text","text":" "},{"text":"The default implementation of these can be found in the protocol extension below.","type":"text"},{"text":" ","type":"text"},{"text":"For a concrete class that implements these methods and properties, see ","type":"text"},{"identifier":"doc:\/\/GLib\/documentation\/GLib\/VariantDict","type":"reference","isActive":true},{"type":"text","text":"."},{"text":" ","type":"text"},{"type":"text","text":"Alternatively, use "},{"isActive":true,"type":"reference","identifier":"doc:\/\/GLib\/documentation\/GLib\/VariantDictRef"},{"text":" as a lighweight, ","type":"text"},{"type":"codeVoice","code":"unowned"},{"text":" reference if you already have an instance you just want to use.","type":"text"}]}]}],"schemaVersion":{"patch":0,"major":0,"minor":3},"abstract":[{"type":"reference","identifier":"doc:\/\/GLib\/documentation\/GLib\/VariantDict","isActive":true},{"text":" is a mutable interface to ","type":"text"},{"isActive":true,"identifier":"doc:\/\/GLib\/documentation\/GLib\/Variant","type":"reference"},{"type":"text","text":" dictionaries."}],"relationshipsSections":[{"identifiers":["doc:\/\/GLib\/documentation\/GLib\/PointerWrapper"],"title":"Inherits From","kind":"relationships","type":"inheritsFrom"},{"kind":"relationships","title":"Conforming Types","identifiers":["doc:\/\/GLib\/documentation\/GLib\/VariantDict","doc:\/\/GLib\/documentation\/GLib\/VariantDictRef"],"type":"conformingTypes"}],"references":{"doc://GLib/documentation/GLib/VariantDictProtocol/unref()":{"title":"