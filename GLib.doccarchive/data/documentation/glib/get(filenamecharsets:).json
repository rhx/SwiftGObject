,"code":"G_BROKEN_FILENAMES"},{"text":" is,","type":"text"},{"text":" ","type":"text"},{"text":"the character set of the current locale is taken as the filename","type":"text"},{"type":"text","text":" "},{"type":"text","text":"encoding. If neither environment variable  is set, UTF-8 is taken"},{"text":" ","type":"text"},{"text":"as the filename encoding, but the character set of the current locale","type":"text"},{"text":" ","type":"text"},{"type":"text","text":"is also put in the list of encodings."}],"type":"paragraph"},{"type":"paragraph","inlineContent":[{"text":"The returned ","type":"text"},{"type":"codeVoice","code":"charsets"},{"text":" belong to GLib and must not be freed.","type":"text"}]},{"inlineContent":[{"text":"Note that on Unix, regardless of the locale character set or","type":"text"},{"text":" ","type":"text"},{"code":"G_FILENAME_ENCODING","type":"codeVoice"},{"text":" value, the actual file names present","type":"text"},{"text":" ","type":"text"},{"type":"text","text":"on a system might be in any random encoding or just gibberish."}],"type":"paragraph"}],"kind":"content"}],"references":{"doc://GLib/documentation/GLib/get(filenameCharsets:)":{"url":"\/documentation\/glib\/get(filenamecharsets:)","role":"symbol","identifier":"doc:\/\/GLib\/documentation\/GLib\/get(filenameCharsets:)","abstract":[{"text":"Determines the preferred character sets used for filenames.","type":"text"},{"text":" ","type":"text"},{"type":"text","text":"The first character set from the "},{"type":"codeVoice","code":"charsets"},{"text":" is the filename encoding, the","type":"text"},{"type":"text","text":" "},{"text":"subsequent character sets are used when trying to generate a displayable","type":"text"},{"text":" ","type":"text"},{"type":"text","text":"representation of a filename, see "},{"code":"g_filename_display_name()","type":"codeVoice"},{"type":"text","text":"."}],"title":"get(filenameCharsets:)","kind":"symbol","fragments":[{"text":"func","kind":"keyword"},{"text":"