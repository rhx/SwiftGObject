{"kind":"symbol","hierarchy":{"paths":[["doc:\/\/GLib\/documentation\/GLib"]]},"metadata":{"symbolKind":"func","role":"symbol","fragments":[{"text":"func","kind":"keyword"},{"text":" ","kind":"text"},{"kind":"identifier","text":"getSystemDataDirs"},{"text":"() -> ","kind":"text"},{"text":"UnsafePointer","preciseIdentifier":"s:SP","kind":"typeIdentifier"},{"text":"<","kind":"text"},{"text":"UnsafePointer","kind":"typeIdentifier","preciseIdentifier":"s:SP"},{"kind":"text","text":"<"},{"kind":"typeIdentifier","text":"gchar","preciseIdentifier":"c:@T@gchar"},{"text":">?>!","kind":"text"}],"modules":[{"name":"GLib"}],"externalID":"s:4GLib17getSystemDataDirsSPySPys4Int8VGSgGSgyF","title":"getSystemDataDirs()","roleHeading":"Function"},"sections":[],"identifier":{"url":"doc:\/\/GLib\/documentation\/GLib\/getSystemDataDirs()","interfaceLanguage":"swift"},"variants":[{"paths":["\/documentation\/glib\/getsystemdatadirs()"],"traits":[{"interfaceLanguage":"swift"}]}],"primaryContentSections":[{"declarations":[{"platforms":["macOS"],"tokens":[{"text":"func","kind":"keyword"},{"kind":"text","text":" "},{"text":"getSystemDataDirs","kind":"identifier"},{"text":"() -> ","kind":"text"},{"preciseIdentifier":"s:SP","text":"UnsafePointer","kind":"typeIdentifier"},{"kind":"text","text":"<"},{"preciseIdentifier":"s:SP","text":"UnsafePointer","kind":"typeIdentifier"},{"kind":"text","text":"<"},{"preciseIdentifier":"c:@T@gchar","text":"gchar","kind":"typeIdentifier"},{"kind":"text","text":">?>!"}],"languages":["swift"]}],"kind":"declarations"},{"kind":"content","content":[{"type":"heading","level":2,"anchor":"discussion","text":"Discussion"},{"inlineContent":[{"text":"On UNIX platforms this is determined using the mechanisms described","type":"text"},{"type":"text","text":" "},{"text":"in the","type":"text"},{"type":"text","text":" "},{"identifier":"http:\/\/www.freedesktop.org\/Standards\/basedir-spec","type":"reference","isActive":true},{"text":" ","type":"text"},{"type":"text","text":"In this case the list of directories retrieved will be "},{"code":"XDG_DATA_DIRS","type":"codeVoice"},{"type":"text","text":"."}],"type":"paragraph"},{"type":"paragraph","inlineContent":[{"text":"On Windows it follows XDG Base Directory Specification if ","type":"text"},{"code":"XDG_DATA_DIRS","type":"codeVoice"},{"type":"text","text":" is defined."},{"type":"text","text":" "},{"type":"text","text":"If "},{"type":"codeVoice","code":"XDG_DATA_DIRS"},{"text":" is undefined,","type":"text"},{"text":" ","type":"text"},{"type":"text","text":"the first elements in the list are the Application Data"},{"type":"text","text":" "},{"type":"text","text":"and Documents folders for All Users. (These can be determined only"},{"text":" ","type":"text"},{"text":"on Windows 2000 or later and are not present in the list on other","type":"text"},{"text":" ","type":"text"},{"text":"Windows versions.) See documentation for FOLDERID_ProgramData and","type":"text"},{"text":" ","type":"text"},{"type":"text","text":"FOLDERID_PublicDocuments."}]},{"inlineContent":[{"type":"text","text":"Then follows the “share” subfolder in the installation folder for"},{"text":" ","type":"text"},{"text":"the package containing the DLL that calls this function, if it can","type":"text"},{"text":" ","type":"text"},{"type":"text","text":"be determined."}],"type":"paragraph"},{"inlineContent":[{"text":"Finally the list contains the “share” subfolder in the installation","type":"text"},{"text":" ","type":"text"},{"text":"folder for GLib, and in the installation folder for the package the","type":"text"},{"text":" ","type":"text"},{"type":"text","text":"application’s .exe file belongs to."}],"type":"paragraph"},{"inlineContent":[{"text":"The installation folders above are determined by looking up the","type":"text"},{"type":"text","text":" "},{"type":"text","text":"folder where the module (DLL or EXE) in question is located. If the"},{"type":"text","text":" "},{"type":"text","text":"folder’s name is “bin”, its parent is used, otherwise the folder"},{"text":" ","type":"text"},{"text":"itself.","type":"text"}],"type":"paragraph"},{"type":"paragraph","inlineContent":[{"type":"text","text":"Note that on Windows the returned list can vary depending on where"},{"type":"text","text":" "},{"type":"text","text":"this function is called."}]},{"type":"paragraph","inlineContent":[{"text":"The return value is cached and modifying it at runtime is not supported, as","type":"text"},{"type":"text","text":" "},{"text":"it’s not thread-safe to modify environment variables at runtime.","type":"text"}]}]}],"schemaVersion":{"major":0,"minor":3,"patch":0},"abstract":[{"text":"Returns an ordered list of base directories in which to access","type":"text"},{"text":" ","type":"text"},{"text":"system-wide application data.","type":"text"}],"references":{"doc://GLib/documentation/GLib":{"identifier":"doc:\/\/GLib\/documentation\/GLib","title":"GLib","abstract":[],"type":"topic","url":"\/documentation\/glib","kind":"symbol","role":"collection"},"http://www.freedesktop.org/Standards/basedir-spec":{"type":"link","title":"XDG Base Directory Specification","identifier":"http:\/\/www.freedesktop.org\/Standards\/basedir-spec","titleInlineContent":[{"type":"text","text":"XDG Base Directory Specification"}],"url":"http:\/\/www.freedesktop.org\/Standards\/basedir-spec"},"doc://GLib/documentation/GLib/getSystemDataDirs()":{"title":"getSystemDataDirs()","role":"symbol","kind":"symbol","identifier":"doc:\/\/GLib\/documentation\/GLib\/getSystemDataDirs()","url":"\/documentation\/glib\/getsystemdatadirs()","fragments":[{"text":"func","kind":"keyword"},{"text":" ","kind":"text"},{"kind":"identifier","text":"getSystemDataDirs"},{"kind":"text","text":"() -> "},{"kind":"typeIdentifier","text":"UnsafePointer","preciseIdentifier":"s:SP"},{"kind":"text","text":"<"},{"preciseIdentifier":"s:SP","text":"UnsafePointer","kind":"typeIdentifier"},{"kind":"text","text":"<"},{"text":"gchar","preciseIdentifier":"c:@T@gchar","kind":"typeIdentifier"},{"kind":"text","text":">?>!"}],"type":"topic","abstract":[{"type":"text","text":"Returns an ordered list of base directories in which to access"},{"text":" ","type":"text"},{"text":"system-wide application data.","type":"text"}]}}}