{"topicSections":[{"generated":true,"title":"Initializers","anchor":"Initializers","identifiers":["doc:\/\/GLib\/documentation\/GLib\/DateRef\/init()","doc:\/\/GLib\/documentation\/GLib\/DateRef\/init(_:)-15l2w","doc:\/\/GLib\/documentation\/GLib\/DateRef\/init(_:)-5vh9g","doc:\/\/GLib\/documentation\/GLib\/DateRef\/init(_:)-6v7fp","doc:\/\/GLib\/documentation\/GLib\/DateRef\/init(_:)-7pk3a","doc:\/\/GLib\/documentation\/GLib\/DateRef\/init(_:)-9375e","doc:\/\/GLib\/documentation\/GLib\/DateRef\/init(cPointer:)","doc:\/\/GLib\/documentation\/GLib\/DateRef\/init(constPointer:)","doc:\/\/GLib\/documentation\/GLib\/DateRef\/init(dmy:month:year:)","doc:\/\/GLib\/documentation\/GLib\/DateRef\/init(gconstpointer:)","doc:\/\/GLib\/documentation\/GLib\/DateRef\/init(gpointer:)","doc:\/\/GLib\/documentation\/GLib\/DateRef\/init(julian:)","doc:\/\/GLib\/documentation\/GLib\/DateRef\/init(mutating:)","doc:\/\/GLib\/documentation\/GLib\/DateRef\/init(opaquePointer:)"]},{"title":"Instance Properties","anchor":"Instance-Properties","generated":true,"identifiers":["doc:\/\/GLib\/documentation\/GLib\/DateRef\/ptr"]},{"generated":true,"title":"Type Methods","anchor":"Type-Methods","identifiers":["doc:\/\/GLib\/documentation\/GLib\/DateRef\/new(dmy:month:year:)","doc:\/\/GLib\/documentation\/GLib\/DateRef\/new(julian:)"]},{"title":"Default Implementations","generated":true,"anchor":"Default-Implementations","identifiers":["doc:\/\/GLib\/documentation\/GLib\/DateRef\/DateProtocol-Implementations","doc:\/\/GLib\/documentation\/GLib\/DateRef\/PointerWrapper-Implementations"]}],"kind":"symbol","metadata":{"title":"DateRef","navigatorTitle":[{"text":"DateRef","kind":"identifier"}],"symbolKind":"struct","role":"symbol","fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"DateRef","kind":"identifier"}],"modules":[{"name":"GLib"}],"roleHeading":"Structure","externalID":"s:4GLib7DateRefV"},"schemaVersion":{"minor":3,"patch":0,"major":0},"abstract":[{"code":"GDate","type":"codeVoice"},{"text":" is a struct for calendrical calculations.","type":"text"}],"hierarchy":{"paths":[["doc:\/\/GLib\/documentation\/GLib"]]},"relationshipsSections":[{"kind":"relationships","identifiers":["doc:\/\/GLib\/documentation\/GLib\/DateProtocol","doc:\/\/GLib\/documentation\/GLib\/PointerWrapper"],"title":"Conforms To","type":"conformsTo"}],"variants":[{"paths":["\/documentation\/glib\/dateref"],"traits":[{"interfaceLanguage":"swift"}]}],"primaryContentSections":[{"kind":"declarations","declarations":[{"tokens":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"text":"DateRef","kind":"identifier"}],"languages":["swift"],"platforms":["macOS"]}]},{"kind":"content","content":[{"level":2,"type":"heading","text":"Overview","anchor":"overview"},{"inlineContent":[{"type":"text","text":"The "},{"type":"codeVoice","code":"GDate"},{"text":" data structure represents a day between January 1, Year 1,","type":"text"},{"type":"text","text":" "},{"type":"text","text":"and sometime a few thousand years in the future (right now it will go"},{"text":" ","type":"text"},{"type":"text","text":"to the year 65535 or so, but [method"},{"code":"GLib.Date.set_parse","type":"codeVoice"},{"type":"text","text":"] only parses up to the"},{"text":" ","type":"text"},{"text":"year 8000 or so - just count on “a few thousand”). ","type":"text"},{"type":"codeVoice","code":"GDate"},{"type":"text","text":" is meant to"},{"text":" ","type":"text"},{"type":"text","text":"represent everyday dates, not astronomical dates or historical dates"},{"text":" ","type":"text"},{"type":"text","text":"or ISO timestamps or the like. It extrapolates the current Gregorian"},{"text":" ","type":"text"},{"text":"calendar forward and backward in time; there is no attempt to change","type":"text"},{"text":" ","type":"text"},{"type":"text","text":"the calendar to match time periods or locations. "},{"code":"GDate","type":"codeVoice"},{"text":" does not store","type":"text"},{"type":"text","text":" "},{"type":"text","text":"time information; it represents a day."}],"type":"paragraph"},{"type":"paragraph","inlineContent":[{"text":"The ","type":"text"},{"code":"GDate","type":"codeVoice"},{"text":" implementation has several nice features; it is only a","type":"text"},{"type":"text","text":" "},{"text":"64-bit struct, so storing large numbers of dates is very efficient. It","type":"text"},{"text":" ","type":"text"},{"type":"text","text":"can keep both a Julian and day-month-year representation of the date,"},{"type":"text","text":" "},{"type":"text","text":"since some calculations are much easier with one representation or the"},{"type":"text","text":" "},{"type":"text","text":"other. A Julian representation is simply a count of days since some"},{"type":"text","text":" "},{"text":"fixed day in the past; for ","type":"text"},{"type":"reference","isActive":true,"identifier":"doc:\/\/GLib\/documentation\/GLib\/Date"},{"type":"text","text":" the fixed day is January 1, 1 AD."},{"text":" ","type":"text"},{"text":"(“Julian” dates in the ","type":"text"},{"isActive":true,"type":"reference","identifier":"doc:\/\/GLib\/documentation\/GLib\/Date"},{"type":"text","text":" API aren’t really Julian dates in the"},{"text":" ","type":"text"},{"type":"text","text":"technical sense; technically, Julian dates count from the start of the"},{"type":"text","text":" "},{"text":"Julian period, Jan 1, 4713 BC).","type":"text"}]},{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"GDate"},{"text":" is simple to use. First you need a “blank” date; you can get a","type":"text"},{"text":" ","type":"text"},{"text":"dynamically allocated date from [ctor","type":"text"},{"type":"codeVoice","code":"GLib.Date.new"},{"type":"text","text":"], or you can declare an"},{"type":"text","text":" "},{"type":"text","text":"automatic variable or array and initialize it by calling [method"},{"type":"codeVoice","code":"GLib.Date.clear"},{"text":"].","type":"text"},{"text":" ","type":"text"},{"type":"text","text":"A cleared date is safe; it’s safe to call [method"},{"type":"codeVoice","code":"GLib.Date.set_dmy"},{"text":"] and the other","type":"text"},{"type":"text","text":" "},{"text":"mutator functions to initialize the value of a cleared date. However, a cleared date","type":"text"},{"text":" ","type":"text"},{"type":"text","text":"is initially invalid, meaning that it doesn’t represent a day that exists."},{"type":"text","text":" "},{"text":"It is undefined to call any of the date calculation routines on an invalid date.","type":"text"},{"text":" ","type":"text"},{"text":"If you obtain a date from a user or other unpredictable source, you should check","type":"text"},{"type":"text","text":" "},{"type":"text","text":"its validity with the [method"},{"code":"GLib.Date.valid","type":"codeVoice"},{"type":"text","text":"] predicate. [method"},{"type":"codeVoice","code":"GLib.Date.valid"},{"text":"]","type":"text"},{"type":"text","text":" "},{"type":"text","text":"is also used to check for errors with [method"},{"type":"codeVoice","code":"GLib.Date.set_parse"},{"type":"text","text":"] and other functions"},{"text":" ","type":"text"},{"text":"that can fail. Dates can be invalidated by calling [method","type":"text"},{"code":"GLib.Date.clear","type":"codeVoice"},{"type":"text","text":"] again."}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"It is very important to use the API to access the "},{"code":"GDate","type":"codeVoice"},{"type":"text","text":" struct. Often only the"},{"text":" ","type":"text"},{"type":"text","text":"day-month-year or only the Julian representation is valid. Sometimes neither is valid."},{"type":"text","text":" "},{"text":"Use the API.","type":"text"}]},{"inlineContent":[{"text":"GLib also features ","type":"text"},{"code":"GDateTime","type":"codeVoice"},{"text":" which represents a precise time.","type":"text"}],"type":"paragraph"},{"type":"paragraph","inlineContent":[{"text":"The ","type":"text"},{"identifier":"doc:\/\/GLib\/documentation\/GLib\/DateRef","isActive":true,"type":"reference"},{"text":" type acts as a lightweight Swift reference to an underlying ","type":"text"},{"code":"GDate","type":"codeVoice"},{"type":"text","text":" instance."},{"text":" ","type":"text"},{"type":"text","text":"It exposes methods that can operate on this data type through "},{"identifier":"doc:\/\/GLib\/documentation\/GLib\/DateProtocol","isActive":true,"type":"reference"},{"type":"text","text":" conformance."},{"text":" ","type":"text"},{"text":"Use ","type":"text"},{"identifier":"doc:\/\/GLib\/documentation\/GLib\/DateRef","isActive":true,"type":"reference"},{"text":" only as an ","type":"text"},{"type":"codeVoice","code":"unowned"},{"text":" reference to an existing ","type":"text"},{"code":"GDate","type":"codeVoice"},{"type":"text","text":" instance."}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"Use "},{"isActive":true,"type":"reference","identifier":"doc:\/\/GLib\/documentation\/GLib\/Date"},{"type":"text","text":" (instead of "},{"type":"reference","identifier":"doc:\/\/GLib\/documentation\/GLib\/DateRef","isActive":true},{"type":"text","text":") if you want to use Automatic Reference Counting for memory management of the underlying "},{"type":"codeVoice","code":"GDate"},{"type":"text","text":" instance."}]}],"type":"aside","style":"note","name":"Note"}]}],"sections":[],"identifier":{"url":"doc:\/\/GLib\/documentation\/GLib\/DateRef","interfaceLanguage":"swift"},"references":{"doc://GLib/documentation/GLib/DateRef":{"title":"DateRef","identifier":"doc:\/\/GLib\/documentation\/GLib\/DateRef","type":"topic","kind":"symbol","url":"\/documentation\/glib\/dateref","fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"DateRef","kind":"identifier"}],"abstract":[{"type":"codeVoice","code":"GDate"},{"text":" is a struct for calendrical calculations.","type":"text"}],"navigatorTitle":[{"kind":"identifier","text":"DateRef"}],"role":