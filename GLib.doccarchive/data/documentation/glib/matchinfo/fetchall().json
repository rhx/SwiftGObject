{"abstract":[{"type":"text","text":"Bundles up pointers to each of the matching substrings from a match"},{"text":" ","type":"text"},{"text":"and stores them in an array of gchar pointers. The first element in","type":"text"},{"type":"text","text":" "},{"text":"the returned array is the match number 0, i.e. the entire matched","type":"text"},{"text":" ","type":"text"},{"text":"text.","type":"text"}],"metadata":{"extendedModule":"GLib","symbolKind":"method","title":"fetchAll()","externalID":"s:4GLib17MatchInfoProtocolPAAE8fetchAllSpySpys4Int8VGSgGSgyF::SYNTHESIZED::s:4GLib9MatchInfoC","roleHeading":"Instance Method","role":"symbol","modules":[{"name":"GLib"}],"fragments":[{"kind":"keyword","text":"func"},{"kind":"text","text":" "},{"text":"fetchAll","kind":"identifier"},{"text":"() -> ","kind":"text"},{"text":"UnsafeMutablePointer","kind":"typeIdentifier","preciseIdentifier":"s:Sp"},{"kind":"text","text":"<"},{"preciseIdentifier":"s:Sp","kind":"typeIdentifier","text":"UnsafeMutablePointer"},{"text":"<","kind":"text"},{"kind":"typeIdentifier","preciseIdentifier":"c:@T@gchar","text":"gchar"},{"text":">?>!","kind":"text"}]},"schemaVersion":{"patch":0,"major":0,"minor":3},"primaryContentSections":[{"kind":"declarations","declarations":[{"tokens":[{"kind":"keyword","text":"func"},{"text":" ","kind":"text"},{"text":"fetchAll","kind":"identifier"},{"kind":"text","text":"() -> "},{"kind":"typeIdentifier","text":"UnsafeMutablePointer","preciseIdentifier":"s:Sp"},{"text":"<","kind":"text"},{"preciseIdentifier":"s:Sp","text":"UnsafeMutablePointer","kind":"typeIdentifier"},{"text":"<","kind":"text"},{"text":"gchar","kind":"typeIdentifier","preciseIdentifier":"c:@T@gchar"},{"kind":"text","text":">?>!"}],"platforms":["macOS"],"languages":["swift"]}]},{"content":[{"level":2,"text":"Discussion","anchor":"discussion","type":"heading"},{"inlineContent":[{"text":"If a sub pattern didn’t match anything (e.g. sub pattern 1, matching","type":"text"},{"text":" ","type":"text"},{"type":"tex