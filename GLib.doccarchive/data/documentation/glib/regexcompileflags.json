if it actually contains","type":"text"},{"type":"text","text":" "},{"type":"text","text":"newlines). The “start of line” metacharacter (”^”) matches only"},{"text":" ","type":"text"},{"type":"text","text":"at the start of the string, while the “end of line” metacharacter"},{"type":"text","text":" "},{"text":"(”$”) matches only at the end of the string, or before a terminating","type":"text"},{"type":"text","text":" "},{"text":"newline (unless ","type":"text"},{"type":"reference","identifier":"doc:\/\/GLib\/documentation\/GLib\/RegexCompileFlags\/dollarEndonly","isActive":true},{"type":"text","text":" is set). When"},{"type":"text","text":" "},{"isActive":true,"type":"reference","identifier":"doc:\/\/GLib\/documentation\/GLib\/RegexCompileFlags\/multiline"},{"text":" is set, the “start of line” and “end of line”","type":"text"},{"type":"text","text":" "},{"type":"text","text":"constructs match immediately following or immediately before any"},{"type":"text","text":" "},{"type":"text","text":"newline in the string, respectively, as well as at the very start"},{"text":" ","type":"text"},{"text":"and end. This can be changed within a pattern by a “(?m)” option","type":"text"},{"text":" ","type":"text"},{"text":"setting.","type":"text"}],"fragments":[{"text":"static","kind":"keyword"},{"text":" ","kind":"text"},{"kind":"keyword","text":"let"},{"kind":"text","text":" "},{"text":"multiline","kind":"identifier"},{"kind":"text","text":": "},{"text":"RegexCompileFlags","kind":"typeIdentifier","preciseIdentifier":"s:4GLib17RegexCompileFlagsV"}],"type":"topic","role":"symbol"},"doc://GLib/SY":{"type":"unresolvable","identifier":"doc:\/\/GLib\/SY","title":"Swift.RawRepresentable"},"doc://GLib/documentation/GLib/RegexCompileFlags/SetAlgebra-Implementations":{"type":"topic","identifier":"doc:\/\/GLib\/documentation\/GLib\/RegexCompileFlags\/SetAlgebra-Implementations","url":"\/documentation\/glib\/regexcompileflags\/setalgebra-implementations","abstract":[],"title":"SetAlgebra Imp