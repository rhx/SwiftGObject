{"sections":[],"identifier":{"url":"doc:\/\/GLib\/documentation\/GLib\/StaticRWLockRef","interfaceLanguage":"swift"},"schemaVersion":{"major":0,"patch":0,"minor":3},"metadata":{"symbolKind":"struct","navigatorTitle":[{"text":"StaticRWLockRef","kind":"identifier"}],"fragments":[{"kind":"keyword","text":"struct"},{"text":" ","kind":"text"},{"kind":"identifier","text":"StaticRWLockRef"}],"role":"symbol","modules":[{"name":"GLib"}],"roleHeading":"Structure","externalID":"s:4GLib15StaticRWLockRefV","title":"StaticRWLockRef"},"kind":"symbol","topicSections":[{"title":"Initializers","identifiers":["doc:\/\/GLib\/documentation\/GLib\/StaticRWLockRef\/init(_:)-10mti","doc:\/\/GLib\/documentation\/GLib\/StaticRWLockRef\/init(_:)-37bn","doc:\/\/GLib\/documentation\/GLib\/StaticRWLockRef\/init(_:)-3nxea","doc:\/\/GLib\/documentation\/GLib\/StaticRWLockRef\/init(_:)-56q6n","doc:\/\/GLib\/documentation\/GLib\/StaticRWLockRef\/init(_:)-qfhc","doc:\/\/GLib\/documentation\/GLib\/StaticRWLockRef\/init(cPointer:)","doc:\/\/GLib\/documentation\/GLib\/StaticRWLockRef\/init(constPointer:)","doc:\/\/GLib\/documentation\/GLib\/StaticRWLockRef\/init(gconstpointer:)","doc:\/\/GLib\/documentation\/GLib\/StaticRWLockRef\/init(gpointer:)","doc:\/\/GLib\/documentation\/GLib\/StaticRWLockRef\/init(mutating:)","doc:\/\/GLib\/documentation\/GLib\/StaticRWLockRef\/init(opaquePointer:)"],"generated":true,"anchor":"Initializers"},{"generated":true,"identifiers":["doc:\/\/GLib\/documentation\/GLib\/StaticRWLockRef\/ptr"],"title":"Instance Properties","anchor":"Instance-Properties"},{"anchor":"Default-Implementations","title":"Default Implementations","identifiers":["doc:\/\/GLib\/documentation\/GLib\/StaticRWLockRef\/PointerWrapper-Implementations","doc:\/\/GLib\/documentation\/GLib\/StaticRWLockRef\/StaticRWLockProtocol-Implementations"],"generated":true}],"abstract":[{"text":"The [struct","type":"text"},{"type":"reference","identifier":"doc:\/\/GLib\/documentation\/GLib\/StaticRWLock","isActive":true},{"type":"text","text":"] struct represents a read-write lock. A read-write"},{"type":"text","text":" "},{"type":"text","text":"lock can be used for protecting data that some portions of code only"},{"text":" ","type":"text"},{"text":"read from, while others also write. In such situations it is","type":"text"},{"text":" ","type":"text"},{"type":"text","text":"desirable that several readers can read at once, whereas of course"},{"type":"text","text":" "},{"type":"text","text":"only one writer may write at a time."}],"relationshipsSections":[{"identifiers":["doc:\/\/GLib\/documentation\/GLib\/PointerWrapper","doc:\/\/GLib\/documentation\/GLib\/StaticRWLockProtocol"],"kind":"relationships","type":"conformsTo","title":"Conforms To"}],"hierarchy":{"paths":[["doc:\/\/GLib\/documentation\/GLib"]]},"primaryContentSections":[{"kind":"declarations","declarations":[{"languages":["swift"],"tokens":[{"text":"struct","kind":"keyword"},{"kind":"text","text":" "},{"text":"StaticRWLockRef","kind":"identifier"}],"platforms":["macOS"]}]},{"kind":"content","content":[{"text":"Overview","level":2,"anchor":"overview","type":"heading"},{"type":"paragraph","inlineContent":[{"type":"text","text":"Take a look at the following example:"}]},{"syntax":null,"type":"codeListing","code":["  GStaticRWLock rwlock = G_STATIC_RW_LOCK_INIT;","  GPtrArray *array;","","  gpointer","  my_array_get (guint index)","  {","    gpointer retval = NULL;","","    if (!array)","      return NULL;","","    g_static_rw_lock_reader_lock (&rwlock);","    if (index < array->len)","      retval = g_ptr_array_index (array, index);","    g_static_rw_lock_reader_unlock (&rwlock);","","    return retval;","  }","","  void","  my_array_set (guint index, gpointer data)","  {","    g_static_rw_lock_writer_lock (&rwlock);","","    if (!array)","      array = g_ptr_array_new ();","","    if (index >= array->len)","      g_ptr_array_set_size (array, index + 1);","    g_ptr_array_index (array, index) = data;","","    g_static_rw_lock_writer_unlock (&rwlock);","  }"]},{"type":"paragraph","inlineContent":[{"text":"This example shows an array which can be accessed by many readers","type":"text"},{"type":"text","text":" "},{"type":"text","text":"(the "},{"code":"my_array_get()","type":"codeVoice"},{"type":"text","text":" function) simultaneously, whereas the writers"},{"text":" ","type":"text"},{"text":"(the ","type":"text"},{"code":"my_array_set()","type":"codeVoice"},{"type":"text","text":" function) will only be allowed once at a time"},{"text":" ","type":"text"},{"type":"text","text":"and only if no readers currently access the array. This is because"},{"text":" ","type":"text"},{"type":"text","text":"of the potentially dangerous resizing of the array. Using these"},{"text":" ","type":"text"},{"text":"functions is fully multi-thread safe now.","type":"text"}]},{"inlineContent":[{"text":"Most of the time, writers should have precedence over readers. That","type":"text"},{"text":" ","type":"text"},{"text":"means, for this implementation, that as soon as a writer wants to","type":"text"},{"text":" ","type":"text"},{"type":"text","text":"lock the data, no other reader is allowed to lock the data, whereas,"},{"type":"text","text":" "},{"text":"of course, the readers that already have locked the data are allowed","type":"text"},{"type":"text","text":" "},{"text":"to finish their operation. As soon as the last reader unlocks the","type":"text"},{"text":" ","type":"text"},{"type":"text","text":"data, the writer will lock it."}],"type":"paragraph"},{"inlineContent":[{"type":"text","text":"Even though [struct"},{"type":"reference","isActive":true,"identifier":"doc:\/\/GLib\/documentation\/GLib\/StaticRWLock"},{"text":"] is not opaque, it should only be used","type":"text"},{"type":"text","text":" "},{"text":"with the following functions.","type":"text"}],"type":"paragraph"},{"inlineContent":[{"text":"All of the ","type":"text"},{"type":"codeVoice","code":"g_static_rw_lock_*"},{"text":" functions can be used even if","type":"text"},{"type":"text","text":" "},{"text":"[func","type":"text"},{"code":"Thread.init","type":"codeVoice"},{"text":"] has not been called. Then they do nothing, apart","type":"text"},{"text":" ","type":"text"},{"text":"from ","type":"text"},{"type":"codeVoice","code":"g_static_rw_lock_*_trylock"},{"type":"text","text":", which does nothing but returning true."}],"type":"paragraph"},{"inlineContent":[{"type":"text","text":"A read-write lock has a higher overhead than a mutex. For example, both"},{"text":" ","type":"text"},{"text":"[method","type":"text"},{"type":"codeVoice","code":"StaticRWLock.reader_lock"},{"type":"text","text":"] and [method"},{"code":"StaticRWLock.reader_unlock","type":"codeVoice"},{"text":"] have","type":"text"},{"text":" ","type":"text"},{"text":"to lock and unlock a [struct","type":"text"},{"identifier":"doc:\/\/GLib\/documentation\/GLib\/StaticMutex","isActive":true,"type":"reference"},{"type":"text","text":"], so it takes at least twice the time"},{"type":"text","text":" "},{"text":"to lock and unlock a [struct","type":"text"},{"type":"reference","identifier":"doc:\/\/GLib\/documentation\/GLib\/StaticRWLock","isActive":true},{"text":"] that it does to lock and unlock a","type":"text"},{"text":" ","type":"text"},{"type":"text","text":"[struct"},{"isActive":true,"type":"reference","identifier":"doc:\/\/GLib\/documentation\/GLib\/StaticMutex"},{"text":"]. So only data structures that are accessed by multiple","type":"text"},{"text":" ","type":"text"},{"type":"text","text":"readers, and which keep the lock for a considerable time justify a"},{"type":"text","text":" "},{"text":"[struct","type":"text"},{"identifier":"doc:\/\/GLib\/documentation\/GLib\/StaticRWLock","isActive":true,"type":"reference"},{"text":"]. The above example most probably would fare better with a","type":"text"},{"type":"text","text":" "},{"type":"text","text":"[struct"},{"isActive":true,"type":"reference","identifier":"doc:\/\/GLib\/documentation\/GLib\/StaticMutex"},{"text":"].","type":"text"}],"type":"paragraph"},{"type":"paragraph","inlineContent":[{"type":"text","text":"The "},{"identifier":"doc:\/\/GLib\/documentation\/GLib\/StaticRWLockRef","isActive":true,"type":"reference"},{"type":"text","text":" type acts as a lightweight Swift reference to an underlying "},{"type":"codeVoice","code":"GStaticRWLock"},{"text":" instance.","type":"text"},{"type":"text","text":" "},{"type":"text","text":"It exposes methods that can operate on this data type through "},{"isActive":true,"type":"reference","identifier":"doc:\/\/GLib\/documentation\/GLib\/StaticRWLockProtocol"},{"text":" conformance.","type":"text"},{"type":"text","text":" "},{"type":"text","text":"Use "},{"type":"reference","isActive":true,"identifier":"doc:\/\/GLib\/documentation\/GLib\/StaticRWLockRef"},{"type":"text","text":" only as an "},{"type":"codeVoice","code":"unowned"},{"text":" reference to an existing ","type":"text"},{"type":"codeVoice","code":"GStaticRWLock"},{"type":"text","text":" instance."}]},{"name":"Note","type":"aside","style":"note","content":[{"inlineContent":[{"text":"Use ","type":"text"},{"isActive":true,"type":"reference","identifier":"doc:\/\/GLib\/documentation\/GLib\/StaticRWLock"},{"text":" (instead of ","type":"text"},{"identifier":"doc:\/\/GLib\/documentation\/GLib\/StaticRWLockRef","isActive":true,"type":"reference"},{"text":") if you want to use Automatic Reference Counting for memory management of the underlying ","type":"text"},{"code":"GStaticRWLock","type":"codeVoice"},{"text":" instance.","type":"text"}],"type":"paragraph"}]}]}],"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/glib\/staticrwlockref"]}],"references":{"doc://GLib/documentation/GLib/Mutex":{"abstract":[{"type":"text","text":"The "},{"isActive":true,"type":"reference","identifier":"doc:\/\/GLib\/documentation\/GLib\/Mutex"},{"type":"text","text":" struct is an opaque data structure to represent a mutex"},{"type":"text","tex