{"hierarchy":{"paths":[["doc:\/\/GLib\/documentation\/GLib","doc:\/\/GLib\/documentation\/GLib\/MainContextRef","doc:\/\/GLib\/documentation\/GLib\/MainContextRef\/MainContextProtocol-Implementations"]]},"variants":[{"paths":["\/documentation\/glib\/maincontextref\/iteration(mayblock:)"],"traits":[{"interfaceLanguage":"swift"}]}],"kind":"symbol","metadata":{"role":"symbol","roleHeading":"Instance Method","title":"iteration(mayBlock:)","modules":[{"name":"GLib"}],"extendedModule":"GLib","externalID":"s:4GLib19MainContextProtocolPAAE9iteration8mayBlockS2b_tF::SYNTHESIZED::s:4GLib14MainContextRefV","symbolKind":"method","fragments":[{"kind":"keyword","text":"func"},{"text":" ","kind":"text"},{"text":"iteration","kind":"identifier"},{"text":"(","kind":"text"},{"text":"mayBlock","kind":"externalParam"},{"text":": ","kind":"text"},{"text":"Bool","preciseIdentifier":"s:Sb","kind":"typeIdentifier"},{"kind":"text","text":") -> "},{"text":"Bool","preciseIdentifier":"s:Sb","kind":"typeIdentifier"}]},"abstract":[{"text":"Runs a single iteration for the given main loop.","type":"text"}],"primaryContentSections":[{"declarations":[{"tokens":[{"text":"func","kind":"keyword"},{"kind":"text","text":" "},{"kind":"identifier","text":"iteration"},{"text":"(","kind":"text"},{"kind":"externalParam","text":"mayBlock"},{"kind":"text","text":": "},{"kind":"typeIdentifier","text":"Bool","preciseIdentifier":"s:Sb"},{"kind":"text","text":") -> "},{"preciseIdentifier":"s:Sb","text":"Bool","kind":"typeIdentifier"}],"languages":["swift"],"platforms":["macOS"]}],"kind":"declarations"},{"content":[{"level":2,"text":"Discussion","anchor":"discussion","type":"heading"},{"type":"paragraph","inlineContent":[{"text":"This involves","type":"text"},{"type":"text","text":" "},{"text":"checking to see if any event sources are ready to be processed,","type":"text"},{"type":"text","text":" "},{"text":"then if no events sources are ready and ","type":"text"},{"code":"mayBlock","type":"codeVoice"},{"text":" is true, waiting","type":"text"},{"type":"text","text":" "},{"text":"for a source to become ready, then dispatching the highest priority","type":"text"},{"text":" ","type":"text"},{"text":"events sources that are ready. Otherwise, if ","type":"text"},{"code":"mayBlock","type":"codeVoice"},{"text":" is false,","type":"text"},{"type":"text","text":" "},{"text":"this function does not wait for sources to become ready, and only the highest","type":"text"},{"type":"text","text":" "},{"text":"priority sources which are already ready (if any) will be dispatched.","type":"text"}]},{"type":"paragraph","inlineContent":[{"text":"Note that even when ","type":"text"},{"type":"codeVoice","code":"mayBlock"},{"type":"text","text":" is true, it is still possible for"},{"type":"text","text":" "},{"text":"[method","type":"text"},{"code":"GLib.MainContext.iteration","type":"codeVoice"},{"text":"] to return false, since the wait may","type":"text"},{"text":" ","type":"text"},{"type":"text","text":"be interrupted for other reasons than an event source becoming ready."}]}],"kind":"content"}],"sections":[],"schemaVersion":{"patch":0,"major":0,"minor":3},"identifier":{"url":"doc:\/\/GLib\/documentation\/GLib\/MainContextRef\/iteration(mayBlock:)","interfaceLanguage":"swift"},"references":{"doc://GLib/documentation/GLib/MainContextRef":{"navigatorTitle":[{"text":"MainContextRef","kind":"identifier"}],"type":"topic","kind":"symbol","role":"symbol","url":"\/documentation\/glib\/maincontextref","identifier":"doc:\/\/GLib\/documentation\/GLib\/MainContextRef","abstract":[{"type":"text","text":"The "},{"type":"codeVoice","code":"GMainContext"},{"type":"text","text":" struct is an opaque data"},{"type":"text","text":" "},{"type":"text","text":"type representing a set of sources to be handled in a main loop."}],"fragments":[{"text":"struct","kind":"keyword"},{"kind":"text","text":" "},{"kind":"identifier","text":"MainContextRef"}],"title":"MainContextRef"},"doc://GLib/documentation/GLib/MainContextRef/