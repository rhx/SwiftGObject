{"schemaVersion":{"minor":3,"patch":0,"major":0},"hierarchy":{"paths":[["doc:\/\/GLib\/documentation\/GLib","doc:\/\/GLib\/documentation\/GLib\/OptionContextRef","doc:\/\/GLib\/documentation\/GLib\/OptionContextRef\/OptionContextProtocol-Implementations"]]},"sections":[],"metadata":{"extendedModule":"GLib","title":"set(strictPosix:)","roleHeading":"Instance Method","symbolKind":"method","fragments":[{"text":"func","kind":"keyword"},{"kind":"text","text":" "},{"text":"set","kind":"identifier"},{"text":"(","kind":"text"},{"text":"strictPosix","kind":"externalParam"},{"text":": ","kind":"text"},{"kind":"typeIdentifier","preciseIdentifier":"s:Sb","text":"Bool"},{"kind":"text","text":")"}],"role":"symbol","externalID":"s:4GLib21OptionContextProtocolPAAE3set11strictPosixySb_tF::SYNTHESIZED::s:4GLib16OptionContextRefV","modules":[{"name":"GLib"}]},"variants":[{"paths":["\/documentation\/glib\/optioncontextref\/set(strictposix:)"],"traits":[{"interfaceLanguage":"swift"}]}],"kind":"symbol","identifier":{"url":"doc:\/\/GLib\/documentation\/GLib\/OptionContextRef\/set(strictPosix:)","interfaceLanguage":"swift"},"primaryContentSections":[{"kind":"declarations","declarations":[{"languages":["swift"],"platforms":["macOS"],"tokens":[{"kind":"keyword","text":"func"},{"text":" ","kind":"text"},{"text":"set","kind":"identifier"},{"text":"(","kind":"text"},{"text":"strictPosix","kind":"externalParam"},{"kind":"text","text":": "},{"text":"Bool","preciseIdentifier":"s:Sb","kind":"typeIdentifier"},{"text":")","kind":"text"}]}]},{"content":[{"anchor":"discussion","type":"heading","text":"Discussion","level":2},{"inlineContent":[{"text":"By default, this mode is disabled.","type":"text"}],"type":"paragraph"},{"inlineContent":[{"type":"text","text":"In strict POSIX mode, the first non-argument parameter encountered"},{"type":"text","text":" "},{"type":"text","text":"(eg: filename) terminates argument processing.  Remaining arguments"},{"text":" ","type":"text"},{"text":"are treated as non-options and are not attempted to be parsed.","type":"text"}],"type":"paragraph"},{"inlineContent":[{"text":"If strict POSIX mode is disabled then parsing is done in the GNU way","type":"text"},{"text":" ","type":"text"},{"type":"text","text":"where option arguments can be freely mixed with non-options."}],"type":"paragraph"},{"inlineContent":[{"text":"As an example, consider “ls foo -l”.  With GNU style parsing, this","type":"text"},{"type":"text","text":" "},{"text":"will list “foo” in long mode.  In strict POSIX style, this will list","type":"text"},{"type":"text","text":" "},{"text":"the files named “foo” and “-l”.","type":"text"}],"type":"paragraph"},{"inlineContent":[{"type":"text","text":"It may be useful to force strict POSIX mode when creating “verb"},{"type":"text","text":" "},{"text":"style” command line tools.  For example, the “gsettings” command line","type":"text"},{"type":"text","text":" "},{"type":"text","text":"tool supports the global option “–schemadir” as well as many"},{"text":" ","type":"text"},{"type":"text","text":"subcommands (“get”, “set”, etc.) which each have their own set of"},{"text":" ","type":"text"},{"type":"text","text":"arguments.  Using strict POSIX mode will allow parsing the global"},{"type":"text","text":" "},{"text":"options up to the verb name while leaving the remaining options to be","type":"text"},{"type":"text","text":" "},{"text":"parsed by the relevant subcommand (which can be determined by","type":"text"},{"text":" ","type":"text"},{"type":"text","text":"examining the verb name, which should be present in argv[1] after"},{"type":"text","text":" "},{"text":"parsing).","type":"text"}],"type":"paragraph"}],"kind":"content"}],"abstract":[{"text":"Sets strict POSIX mode.","type":"text"}],"references":{"doc://GLib/documentation/GLib":{"identifier":"doc:\/\/GLib\/documentation\/GLib","title":"GLib","abstract":[],"type":"topic","url":"\/documentation\/glib","kind":"symbol","role":"collection"},"doc://GLib/documentation/GLib/OptionContextRef/set(strictPosix:)":{"url":"\/documentation\/glib\/optioncontextref\/set(strictposix:)","title":"set(strictPosix:)","identifier":"doc:\/\/GLib\/documentation\/GLib\/OptionContextRef\/set(strictPosix:)","type":"topic","abstract":[{"text":"Sets strict POSIX mode.","type":"text"}],"fragments":[{"text":"func","kind":"keyword"},{"text":" ","kind":"text"},{"text":"set","kind":"identifier"},{"text":"(","kind":"text"},{"text":"strictPosix","kind":"externalParam"},{"kind":"text","text":": "},{"text":"Bool","kind":"typeIdentifier","preciseIdentifier":"s:Sb"},{"kind":"text","text":")"}],"role":"symbol","kind":"symbol"},"doc://GLib/documentation/GLib/OptionContextRef":{"type":"topic","identifier":"doc:\/\/GLib\/documentation\/GLib\/OptionContextRef","title":"OptionContextRef","abstract":[{"type":"text","text":"A "},{"code":"GOptionContext","type":"codeVoice"},{"text":" struct defines which options","type":"text"},{"type":"text","text":" "},{"text":"are accepted by the commandline option parser. The struct has only private","type":"text"},{"type":"text","text":" "},{"type":"text","text":"fields and should not be directly accessed."}],"role":"symbol","fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"OptionContextRef","kind":"identifier"}],"url":"\/documentation\/glib\/optioncontextref","navigatorTitle":[{"kind":"identifier","text":"OptionContextRef"}],"kind":"symbol"},"doc://GLib/documentation/GLib/OptionContextRef/OptionContextProtocol-Implementations":{"title":"OptionContextProtocol Implementations","role":"collectionGroup","kind":"article","abstract":[],"type":"topic","identifier":"doc:\/\/GLib\/documentation\/GLib\/OptionContextRef\/OptionContextProtocol-Implementations","url":"\/documentation\/glib\/optioncontextref\/optioncontextprotocol-implementations"}}}