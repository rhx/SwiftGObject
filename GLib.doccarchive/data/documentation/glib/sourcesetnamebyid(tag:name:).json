eContent":[{"text":"This is a convenience utility to set source names from the return","type":"text"},{"text":" ","type":"text"},{"text":"value of [func","type":"text"},{"code":"GLib.idle_add","type":"codeVoice"},{"type":"text","text":"], [func"},{"type":"codeVoice","code":"GLib.timeout_add"},{"text":"], etc.","type":"text"}],"type":"paragraph"},{"inlineContent":[{"text":"It is a programmer error to attempt to set the name of a non-existent","type":"text"},{"type":"text","text":" "},{"text":"source.","type":"text"}],"type":"paragraph"},{"type":"paragraph","inlineContent":[{"text":"More specifically: source IDs can be reissued after a source has been","type":"text"},{"type":"text","text":" "},{"text":"destroyed and therefore it is never valid to use this function with a","type":"text"},{"type":"text","text":" "},{"type":"text","text":"source ID which may have already been removed.  An example is when"},{"type":"text","text":" "},{"type":"text","text":"scheduling an idle to run in another thread with [func"},{"type":"codeVoice","code":"GLib.idle_add"},{"text":"]: the","type":"text"},{"text":" ","type":"text"},{"text":"idle may already have run and been removed by the time this function","type":"text"},{"type":"text","text":" "},{"text":"is called on its (now invalid) source ID.  This source ID may have","type":"text"},{"text":" ","type":"text"},{"text":"been reissued, leading to the operation being performed against the","type":"text"},{"type":"text","text":" "},{"type":"text","text":"wrong source."}]}]}],"schemaVersion":{"patch":0,"major":0,"minor":3},"references":{"doc://GLib/documentation/GLib/sourceSetNameByID(tag:name:)":{"abstract":[{"type":"text","text":"Sets the name of a source using its ID."}],"type":"topic","identifier":"doc:\/\/GLib\/documentation\/GLib\/sourceSetNameByID(tag:name:)","title":"sourceSetNameByID(tag:name:)","role":"symbol","url":"\/documentation\/glib\/sourcesetnamebyid(tag:name:)","fragments":[{"text":"func","kind":"keyword"},{"text":" ","k