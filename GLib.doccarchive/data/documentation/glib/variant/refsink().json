{"metadata":{"symbolKind":"method","externalID":"s:4GLib15VariantProtocolPAAE7refSinkAA0B3RefVSgyF::SYNTHESIZED::s:4GLib7VariantC","title":"refSink()","modules":[{"name":"GLib"}],"fragments":[{"text":"func","kind":"keyword"},{"kind":"text","text":" "},{"kind":"identifier","text":"refSink"},{"kind":"text","text":"() -> "},{"preciseIdentifier":"s:4GLib10VariantRefV","text":"VariantRef","kind":"typeIdentifier"},{"kind":"text","text":"!"}],"roleHeading":"Instance Method","extendedModule":"GLib","role":"symbol"},"identifier":{"interfaceLanguage":"swift","url":"doc:\/\/GLib\/documentation\/GLib\/Variant\/refSink()"},"abstract":[{"identifier":"doc:\/\/GLib\/documentation\/GLib\/Variant","type":"reference","isActive":true},{"text":" uses a floating reference count system.  All functions with","type":"text"},{"text":" ","type":"text"},{"type":"text","text":"names starting with "},{"type":"codeVoice","code":"g_variant_new_"},{"type":"text","text":" return floating"},{"type":"text","text":" "},{"text":"references.","type":"text"}],"hierarchy":{"paths":[["doc:\/\/GLib\/documentation\/GLib","doc:\/\/GLib\/documentation\/GLib\/Variant","doc:\/\/GLib\/documentation\/GLib\/Variant\/VariantProtocol-Implementations"]]},"sections":[],"primaryContentSections":[{"declarations":[{"platforms":["macOS"],"tokens":[{"text":"func","kind":"keyword"},{"text":" ","kind":"text"},{"kind":"identifier","text":"refSink"},{"kind":"text","text":"() -> "},{"preciseIdentifier":"s:4GLib10VariantRefV","kind":"typeIdentifier","text":"VariantRef","identifier":"doc:\/\/GLib\/documentation\/GLib\/VariantRef"},{"kind":"text","text":"!"}],"languages":["swift"]}],"kind":"declarations"},{"kind":"content","content":[{"text":"Discussion","anchor":"discussion","level":2,"type":"heading"},{"inlineContent":[{"text":"Calling ","type":"text"},{"type":"codeVoice","code":"g_variant_ref_sink()"},{"type":"text","text":" on a "},{"isActive":true,"identifier":"doc:\/\/GLib\/documentation\/GLib\/Variant","type":"reference"},{"type":"text","text":" with a floating reference"},{"type":"text","text":" "},{"text":"will convert the floating reference into a full reference.  Calling","type":"text"},{"text":" ","type":"text"},{"type":"codeVoice","code":"g_variant_ref_sink()"},{"type":"text","text":" on a non-floating "},{"type":"reference","identifier":"doc:\/\/GLib\/documentation\/GLib\/Variant","isActive":true},{"type":"text","text":" results in an"},{"type":"text","text":" "},{"text":"additional normal reference being added.","type":"text"}],"type":"paragraph"},{"inlineContent":[{"type":"text","text":"In other words, if the "},{"code":"value","type":"codeVoice"},{"type":"text","text":" is floating, then this call “assumes"},{"text":" ","type":"text"},{"text":"ownership” of the floating reference, converting it to a normal","type":"text"},{"text":" ","type":"text"},{"text":"reference.  If the ","type":"text"},{"code":"value","type":"codeVoice"},{"text":" is not floating, then this call adds a","type":"text"},{"type":"text","text":" "},{"type":"text","text":"new normal reference increasing the reference count by one."}],"type":"paragraph"},{"inlineContent":[{"type":"text","text":"All calls that result in a "},{"type":"reference","isActive":true,"identifier":"doc:\/\/GLib\/documentation\/GLib\/Variant"},{"text":" instance being inserted into a","type":"text"},{"type":"text","text":" "},{"text":"container will call ","type":"text"},{"type":"codeVoice","code":"g_variant_ref_sink()"},{"text":" on the instance.  This means","type":"text"},{"type":"text","text":" "},{"type":"text","text":"that if the value was just created (and has only its floating"},{"type":"text","text":" "},{"text":"reference) then the container will assume sole ownership of the value","type":"text"},{"type":"text","text":" "},{"text":"at that point and the caller will not need to unreference it.  This","type":"text"},{"text":" ","type":"text"},{"type":"text","text":"makes certain common styles of programming much easier while still"},{"text":" ","type":"text"},{"text":"maintaining normal refcounting semantics in situations where values","type":"text"},{"text":" ","type":"text"},{"type":"text","text":"are not floating."}],"type":"paragraph"}]}],"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/glib\/variant\/refsink()"]}],"schemaVersion":{"major":0,"patch":0,"minor":3},"kind":"symbol","references":{"doc://GLib/documentation/GLib/Variant/refSink()":{"abstract":[{"type":"reference","identifier":"doc:\/\/GLib\/documentation\/GLib\/Variant","isActive":true},{"type":"text","text":" uses a floating reference count system.  All functions with"},{"type":"text","text":" "},{"type":"text","text":"names starting with "},{"type":"codeVoice","code":"g_variant_new_"},{"type":"text","text":" return floating"},{"text":" ","type":"text"},{"type":"text","text":"references."}],"type":"topic","identifier":"doc:\/\/GLib\/documentation\/GLib\/Variant\/refSink()","role":"symbol","fragments":[{"text":"func","kind":"keyword"},{"text":" ","kind":"text"},{"kind":"identifier","text":"refSink"},{"text":"() -> ","kind":"text"},{"preciseIdentifier":"s:4GLib10VariantRefV","kind":"typeIdentifier","text":"VariantRef"},{"text":"!","kind":"text"}],"url":"\/documentation\/glib\/variant\/refsink()","kind":"symbol","title":"refSink()"},"doc://GLib/documentation/GLib/Variant/VariantProtocol-Implementations":{"type":"topic","title":"VariantProtocol Implementations","kind":"article","role":"collectionGroup","identifier":"doc:\/\/GLib\/documentation\/GLib\/Variant\/VariantProtocol-Implementations","url":"\/documentation\/glib\/variant\/variantprotocol-implementations","abstract":[]},"doc://GLib/documentation/GLib/Variant":{"role":"symbol","kind":"symbol","navigatorTitle":[{"text":"Variant","kind":"identifier"}],"title":"Variant","identifier":"doc:\/\/GLib\/documentation\/GLib\/Variant","fragments":[{"kind":"keyword","text":"class"},{"text":" ","kind":"text"},{"text":"Variant","kind":"identifier"}],"abs