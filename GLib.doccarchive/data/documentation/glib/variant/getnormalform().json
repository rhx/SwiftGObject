{"schemaVersion":{"minor":3,"patch":0,"major":0},"identifier":{"url":"doc:\/\/GLib\/documentation\/GLib\/Variant\/getNormalForm()","interfaceLanguage":"swift"},"abstract":[{"type":"text","text":"Gets a "},{"identifier":"doc:\/\/GLib\/documentation\/GLib\/Variant","type":"reference","isActive":true},{"type":"text","text":" instance that has the same value as "},{"type":"codeVoice","code":"value"},{"type":"text","text":" and is"},{"type":"text","text":" "},{"text":"trusted to be in normal form.","type":"text"}],"primaryContentSections":[{"kind":"declarations","declarations":[{"languages":["swift"],"platforms":["macOS"],"tokens":[{"kind":"keyword","text":"func"},{"kind":"text","text":" "},{"text":"getNormalForm","kind":"identifier"},{"text":"() -> ","kind":"text"},{"preciseIdentifier":"s:4GLib10VariantRefV","identifier":"doc:\/\/GLib\/documentation\/GLib\/VariantRef","kind":"typeIdentifier","text":"VariantRef"},{"text":"!","kind":"text"}]}]},{"content":[{"type":"heading","text":"Discussion","level":2,"anchor":"discussion"},{"type":"paragraph","inlineContent":[{"type":"text","text":"If "},{"type":"codeVoice","code":"value"},{"text":" is already trusted to be in normal form then a new","type":"text"},{"text":" ","type":"text"},{"type":"text","text":"reference to "},{"code":"value","type":"codeVoice"},{"type":"text","text":" is returned."}]},{"type":"paragraph","inlineContent":[{"text":"If ","type":"text"},{"type":"codeVoice","code":"value"},{"type":"text","text":" is not already trusted, then it is scanned to check if it"},{"type":"text","text":" "},{"text":"is in normal form.  If it is found to be in normal form then it is","type":"text"},{"text":" ","type":"text"},{"text":"marked as trusted and a new reference to it is returned.","type":"text"}]},{"inlineContent":[{"type":"text","text":"If "},{"code":"value","type":"codeVoice"},{"text":" is found not to be in normal form then a new trusted","type":"text"},{"type":"text","text":" "},{"isActive":true,"identifier":"doc:\/\/GLib\/documentation\/GLib\/Variant","type":"reference"},{"type":"text","text":" is created with the same value as "},{"type":"codeVoice","code":"value"},{"type":"text","text":". The non-normal parts of"},{"type":"text","text":" "},{"type":"codeVoice","code":"value"},{"text":" will be replaced with default values which are guaranteed to be in","type":"text"},{"type":"text","text":" "},{"type":"text","text":"normal form."}],"type":"paragraph"},{"type":"paragraph","inlineContent":[{"text":"It makes sense to call this function if you’ve received ","type":"text"},{"identifier":"doc:\/\/GLib\/documentation\/GLib\/Variant","isActive":true,"type":"reference"},{"text":" ","type":"text"},{"text":"data from untrusted sources and you want to ensure your serialized","type":"text"},{"text":" ","type":"text"},{"type":"text","text":"output is definitely in normal form."}]},{"type":"paragraph","inlineContent":[{"text":"If ","type":"text"},{"type":"codeVoice","code":"value"},{"type":"text","text":" is already in normal form, a new reference will be returned"},{"text":" ","type":"text"},{"type":"text","text":"(which will be floating if "},{"type":"codeVoice","code":"value"},{"type":"text","text":" is floating). If it is not in normal form,"},{"type":"text","text":" "},{"type":"text","text":"the newly created "},{"type":"reference","identifier":"doc:\/\/GLib\/documentation\/GLib\/Variant","isActive":true},{"type":"text","text":" will be returned with a single non-floating"},{"type":"text","text":" "},{"type":"text","text":"reference. Typically, "},{"type":"codeVoice","code":"g_variant_take_ref()"},{"text":" should be called on the return","type":"text"},{"text":" ","type":"text"},{"text":"value from this function to guarantee ownership of a single non-floating","type":"text"},{"text":" ","type":"text"},{"type":"text","text":"reference to it."}]}],"kind":"content"}],"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/glib\/variant\/getnormalform()"]}],"sec