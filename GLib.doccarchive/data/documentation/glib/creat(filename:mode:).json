{"sections":[],"kind":"symbol","abstract":[{"type":"text","text":"A wrapper for the POSIX "},{"type":"codeVoice","code":"creat()"},{"type":"text","text":" function. The "},{"code":"creat()","type":"codeVoice"},{"text":" function is","type":"text"},{"text":" ","type":"text"},{"text":"used to convert a pathname into a file descriptor, creating a file","type":"text"},{"text":" ","type":"text"},{"type":"text","text":"if necessary."}],"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/glib\/creat(filename:mode:)"]}],"hierarchy":{"paths":[["doc:\/\/GLib\/documentation\/GLib"]]},"primaryContentSections":[{"declarations":[{"tokens":[{"text":"func","kind":"keyword"},{"text":" ","kind":"text"},{"text":"creat","kind":"identifier"},{"text":"(","kind":"text"},{"text":"filename","kind":"externalParam"},{"kind":"text","text":": "},{"kind":"typeIdentifier","preciseIdentifier":"s:SP","text":"UnsafePointer"},{"text":"<","kind":"text"},{"text":"gchar","kind":"typeIdentifier","preciseIdentifier":"c:@T@gchar"},{"kind":"text","text":">!, "},{"kind":"externalParam","text":"mode"},{"kind":"text","text":": "},{"preciseIdentifier":"s:Si","text":"Int","kind":"typeIdentifier"},{"kind":"text","text":") -> "},{"preciseIdentifier":"s:Si","text":"Int","kind":"typeIdentifier"}],"platforms":["macOS"],"languages":["swift"]}],"kind":"declarations"},{"content":[{"text":"Discussion","type":"heading","anchor":"discussion","level":2},{"type":"paragraph","inlineContent":[{"text":"On POSIX systems file descriptors are implemented by the operating","type":"text"},{"text":" ","type":"text"},{"text":"system. On Windows, it’s the C library that implements ","type":"text"},{"type":"codeVoice","code":"creat()"},{"type":"text","text":" and"},{"type":"text","text":" "},{"text":"file descriptors. The actual Windows API for opening files is","type":"text"},{"type":"text","text":" "},{"type":"text","text":"different, see MSDN documentation for "},{"type":"codeVoice","code":"CreateFile()"},{"type":"text","text":". The Win32 API"},{"type":"text","text":" "},{"type":"text","text":"uses file handles, which are more randomish integers, not small"},{"type":"text","text":" "},{"text":"integers like file descriptors.","type":"text"}]},{"type":"paragraph","inlineContent":[{"text":"Because file descriptors are specific to the C library on Windows,","type":"text"},{"type":"text","text":" "},{"text":"the file descriptor returned by this function makes sense only to","type":"text"},{"type":"text","text":" "},{"text":"functions in the same C library. Thus if the GLib-using code uses a","type":"text"},{"type":"text","text":" "},{"text":"different C library than GLib does, the file descriptor returned by","type":"text"},{"type":"text","text":" "},{"text":"this function cannot be passed to C library functions like ","type":"text"},{"code":"write()","type":"codeVoice"},{"type":"text","text":" "},{"type":"text","text":"or "},{"code":"read()","type":"codeVoice"},{"type":"text","text":"."}]},{"inlineContent":[{"type":"text","text":"See your C library manual for more details about "},{"type":"codeVoice","code":"creat()"},{"text":".","type":"text"}],"type":"paragraph"}],"kind":"content"}],"schemaVersion":{"major":0,"minor":3,"patch":0},"identifier":{"interfaceLanguage":"swift","url":"doc:\/\/GLib\/documentation\/GLib\/creat(filename:mode:)"},"metadata":{"title":"creat(filename:mode:)","role":"symbol","symbolKind":"func","modules":[{"name":"GLib"}],"fragments":[{"text":"func","kind":"keyword"},{"kind":"text","text":" "},{"text":"creat","kind":"identifier"},{"text":"(","kind":"text"},{"text":"filename","kind":"externalParam"},{"text":": ","kind":"text"},{"text":"UnsafePointer","kind":"typeIdentifier","preciseIdentifier":"s:SP"},{"kind":"text","text":"<"},{"preciseIdentifier":"c:@T@gchar","kind":"typeIdentifier","text":"gchar"},{"text":">!, ","kind":"text"},{"text":"mode","kind":"externalParam"},{"kind":"text","text":": "},{"text":"Int","kind":"typeIdentifier","preciseIdenti