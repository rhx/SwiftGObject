{"metadata":{"extendedModule":"GLib","title":"set(buffered:)","roleHeading":"Instance Method","symbolKind":"method","fragments":[{"text":"func","kind":"keyword"},{"kind":"text","text":" "},{"kind":"identifier","text":"set"},{"text":"(","kind":"text"},{"text":"buffered","kind":"externalParam"},{"kind":"text","text":": "},{"text":"Bool","kind":"typeIdentifier","preciseIdentifier":"s:Sb"},{"text":")","kind":"text"}],"role":"symbol","externalID":"s:4GLib17IOChannelProtocolPAAE3set8bufferedySb_tF","modules":[{"name":"GLib"}]},"abstract":[{"text":"The buffering state can only be set if the channel’s encoding","type":"text"},{"type":"text","text":" "},{"type":"text","text":"is "},{"type":"codeVoice","code":"nil"},{"type":"text","text":". For any other encoding, the channel must be buffered."}],"identifier":{"interfaceLanguage":"swift","url":"doc:\/\/GLib\/documentation\/GLib\/IOChannelProtocol\/set(buffered:)"},"primaryContentSections":[{"kind":"declarations","declarations":[{"tokens":[{"kind":"keyword","text":"func"},{"kind":"text","text":" "},{"text":"set","kind":"identifier"},{"kind":"text","text":"("},{"text":"buffered","kind":"externalParam"},{"kind":"text","text":": "},{"text":"Bool","preciseIdentifier":"s:Sb","kind":"typeIdentifier"},{"kind":"text","text":")"}],"platforms":["macOS"],"languages":["swift"]}]},{"kind":"content","content":[{"level":2,"text":"Discussion","type":"heading","anchor":"discussion"},{"inlineContent":[{"text":"A buffered channel can only be set unbuffered if the channel’s","type":"text"},{"type":"text","text":" "},{"type":"text","text":"internal buffers have been flushed. Newly created channels or"},{"type":"text","text":" "},{"text":"channels which have returned ","type":"text"},{"code":"eof","type":"codeVoice"},{"text":" ","type":"text"},{"type":"text","text":"not require such a flush. For write-only channels, a call to"},{"type":"text","text":" "},{"type":"text","text":"g_io_channel_flush () is sufficient. For all other channels,"},{"type":"text","text":" "},{"type":"text","text":"the buffers may be flushed by a call to g_io_channel_seek_position ()."},{"type":"text","text":" "},{"text":"This includes the possibility of seeking with seek type ","type":"text"},{"code":"cur","type":"codeVoice"},{"type":"text","text":" "},{"type":"text","text":"and an offset of zero. Note that this means that socket-based"},{"type":"text","text":" "},{"text":"channels cannot be set unbuffered once they have had data","type":"text"},{"type":"text","text":" "},{"type":"text","text":"read from them."}],"type":"paragraph"},{"type":"paragraph","inlineContent":[{"type":"text","text":"On unbuffered channels, it is safe to mix read and write"},{"text":" ","type":"text"},{"text":"calls from the new and old APIs, if this is necessary for","type":"text"},{"type":"text","text":" "},{"text":"maintaining old code.","type":"text"}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"The default state of the channel is buffered."}]}]}],"sections":[],"schemaVersion":{"major":0,"minor":3,"patch":0},"variants":[{"paths":["\/documentation\/glib\/iochannelprotocol\/set(buffered:)"],"traits":[{"interfaceLanguage":"swift"}]}],"kind":"symbol","hierarchy":{"paths":[["doc:\/\/GLib\/documentation\/GLib","doc:\/\/GLib\/documentation\/GLib\/IOChannelProtocol"]]},"references":{"doc://GLib/documentation/GLib/MainContext":{"title":"MainContext","identifier":"doc:\/\/GLib\/documentation\/GLib\/MainContext","fragments":[{"kind":"keyword","text":"class"},{"kind":"text","text":" "},{"kind":"identifier","text":"MainContext"}],"url":"\/documentation\/glib\/maincontext","navigatorTitle":[{"kind":"identifier","text":"MainContext"}],"kind":"symbol","type":"topic","role":"symbol","abstract":[{"type":"text","text":"The "},{"code":"GMainContext","type":"codeVoice"},{"text":" struct is an opaque data","type":"text"},{"text":" ","type":"text"},{"type":"text","text":"type representing a set of sources to be handled in a main loop."}]},"doc://GLib/documentation/GLib/IOChannelProtocol/set(buffered:)":{"fragments":[{"kind":"keyword","text":"func"},{"kind":"text","text":" "},{"kind":"identifier","text":"set"},{"text":"(","kind":"text"},{"text":"buffered","kind":"externalParam"},{"kind":"text","text":": "},{"preciseIdentifier":"s:Sb","kind":"typeIdentifier","text":"Bool"},{"text":")","kind":"text"}],"identifier":"doc:\/\/GLib\/documentation\/GLib\/IOChannelProtocol\/set(buffered:)","url":"\/documentation\/glib\/iochannelprotocol\/set(buffered:)","abstract":[{"type":"text","text":"The buffering state can only be set if the channel’s encoding"},{"type":"text","text":" "},{"text":"is ","type":"text"},{"code":"nil","type":"codeVoice"},{"type":"text","text":". For any other encoding, the channel must be buffered."}],"role":"symbol","kind":"symbol","type":"topic","title":"set(buffered:)"},"doc://GLib/documentation/GLib/IOChannelProtocol":{"fragments":[{"kind":"keyword","text":"protocol"},{"kind":"text","text":" "},{"text":"IOChannelProtocol","kind":"identifier"}],"kind":"symbol","abstract":[{"type":"text","text":"The "},{"type":"codeVoice","code":"GIOChannel"},{"type":"text","text":" data type aims to provide a portable method for"},{"type":"text","text":" "},{"type":"text","text":"using file descriptors, pipes, and sockets, and integrating them"},{"type":"text","text":" "},{"text":"into the main event loop (see [struct","type":"text"},{"identifier":"doc:\/\/GLib\/documentation\/GLib\/MainContext","isActive":true,"type":"reference"},{"type":"text","text":"]). Currently,"},{"type":"text","text":" "},{"text":"full support is available on UNIX platforms; support for Windows","type":"text"},{"type":"text","text":" "},{"type":"text","text":"is only partially complete."}],"type":"topic","title":"IOChannelProtocol","navigatorTitle":[{"text":"IOChannelProtocol","kind":"identifier"}],"role":"symbol","url":"\/documentation\/glib\/iochannelprotocol","identifier":"doc:\/\/GLib\/documentation\/GLib\/IOChannelProtocol"},"doc://GLib/documentation/GLib":{"identifier":"doc:\/\/GLib\/documentation\/GLib","title":"GLib","abstract":[],"type":"topic","url":"\/documentation\/glib","kind":"symbol","role":"collection"}}}