{"kind":"article","abstract":[{"type":"text","text":"This tutorial shows how to use GLib with Swift."},{"type":"text","text":" "},{"text":"This is particularly useful if you want to interact","type":"text"},{"text":" ","type":"text"},{"text":"with libraries written in C or other languages that use GLib.","type":"text"}],"hierarchy":{"paths":[["doc:\/\/GLib\/documentation\/GLib"]]},"identifier":{"url":"doc:\/\/GLib\/documentation\/GLib\/Tutorial","interfaceLanguage":"swift"},"schemaVersion":{"patch":0,"major":0,"minor":3},"metadata":{"role":"article","title":"Using GLib with Swift","roleHeading":"Article","modules":[{"name":"GLib"}]},"sections":[],"primaryContentSections":[{"kind":"content","content":[{"text":"What is GLib?","anchor":"What-is-GLib","type":"heading","level":2},{"type":"paragraph","inlineContent":[{"identifier":"https:\/\/docs.gtk.org\/glib\/","isActive":true,"type":"reference"},{"type":"text","text":" is a low-level,"},{"type":"text","text":" "},{"type":"text","text":"general-purpose software library that provides a set of"},{"text":" ","type":"text"},{"type":"text","text":"useful data types, string utilities, filesystem abstractions,"},{"type":"text","text":" "},{"text":"a mainloop abstraction, and similar tools for developing","type":"text"},{"type":"text","text":" "},{"type":"text","text":"libraries and applications in different programming languages."},{"type":"text","text":" "},{"type":"text","text":"GLIb is mainly used for creating and interacting with"},{"text":" ","type":"text"},{"text":"low-level data structures and supports features such as","type":"text"},{"text":" ","type":"text"},{"type":"text","text":"event-driven programming, memory management, and data"},{"text":" ","type":"text"},{"type":"text","text":"type management."},{"type":"text","text":" "},{"text":"GLib is part of the GNOME project, but works with different","type":"text"},{"text":" ","type":"text"},{"text":"Operating Systems, including Linux and macOS.","type":"text"}]},{"level":2,"type":"heading","text":"Swift Bindings","anchor":"Swift-Bindings"},{"type":"paragraph","inlineContent":[{"text":"The Swift language bindings have been generated using","type":"text"},{"type":"text","text":" "},{"type":"text","text":"the "},{"code":".gir","type":"codeVoice"},{"type":"text","text":" files from"},{"text":" ","type":"text"},{"type":"reference","isActive":true,"identifier":"https:\/\/gi.readthedocs.io\/en\/latest\/"},{"text":",","type":"text"},{"type":"text","text":" "},{"text":"allowing a more “swifty” use of the library than using it","type":"text"},{"text":" ","type":"text"},{"text":"through the low-level C interface.","type":"text"},{"text":" ","type":"text"},{"type":"text","text":"Particularly the collection interfaces, such as"},{"type":"text","text":" "},{"identifier":"https:\/\/rhx.github.io\/SwiftGLib\/GLib\/documentation\/glib\/typedslist","isActive":true,"type":"reference"},{"type":"text","text":" and"},{"text":" ","type":"text"},{"isActive":true,"type":"reference","identifier":"https:\/\/rhx.github.io\/SwiftGLib\/GLib\/documentation\/glib\/typedlist"},{"type":"text","text":" "},{"type":"text","text":"allow to use templated Swift data types rather than raw"},{"text":" ","type":"text"},{"type":"text","text":"pointers."}]},{"level":2,"anchor":"Prerequisites","text":"Prerequisites","type":"heading"},{"type":"paragraph","inlineContent":[{"type":"text","text":"To get the most out of this tutorial, you should be"},{"type":"text","text":" "},{"text":"generally familiar with Linux, macOS, or other UNIX-like","type":"text"},{"type":"text","text":" "},{"type":"text","text":"environments and know how to use a command-line shell"},{"text":" ","type":"text"},{"text":"such as ","type":"text"},{"type":"reference","identifier":"https:\/\/www.gnu.org\/software\/bash\/","isActive":true},{"text":" or","type":"text"},{"type":"text","text":" "},{"identifier":"https:\/\/www.zsh.org\/","isActive":true,"type":"reference"},{"text":".","type":"text"}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"You will need a"},{"type":"text","text":" "},{"isActive":true,"identifier":"https:\/\/www.swift.org\/getting-started\/cli-swiftpm\/","type":"reference"},{"type":"text","text":","},{"text":" ","type":"text"},{"text":"either by","type":"text"},{"type":"text","text":" "},{"type":"reference","isActive":true,"identifier":"https:\/\/developer.apple.com\/support\/xcode\/"},{"type":"text","text":" "},{"type":"text","text":"if you are running macOS, or"},{"text":" ","type":"text"},{"type":"text","text":"by "},{"isActive":true,"identifier":"https:\/\/www.swift.org\/install\/","type":"reference"},{"type":"text","text":" "},{"type":"text","text":"directly for your Operating System."}]},{"type":"paragraph","inlineContent":[{"text":"You also need to install the GLib development libraries","type":"text"},{"text":" ","type":"text"},{"type":"text","text":"for your system."}]},{"level":3,"text":"Installing GLib on Linux","anchor":"Installing-GLib-on-Linux","type":"heading"},{"inlineContent":[{"text":"Most modern Linux distributions come with the GLib runtime","type":"text"},{"type":"text","text":" "},{"type":"text","text":"preinstalled, but you will need to install the headers"},{"type":"text","text":" "},{"type":"text","text":"necessary for development."},{"text":" ","type":"text"},{"type":"text","text":"This can be done using the package manager for your system."},{"text":" ","type":"text"},{"text":"For example, on Ubuntu or other Debian-based systems,","type":"text"},{"text":" ","type":"text"},{"text":"you can use the ","type":"text"},{"type":"reference","isActive":true,"identifier":"https:\/\/wiki.debian.org\/Apt"},{"type":"text","text":" package"},{"type":"text","text":" "},{"type":"text","text":"manager using the following commands:"}],"type":"paragraph"},{"type":"codeListing","syntax":null,"code":["sudo apt update","sudo apt install libglib2.0-dev glib-networking gobject-introspection libgirepository1.0-dev libxml2-dev jq"]},{"inlineContent":[{"text":"Depending on your Linux distributions, the names of the","type":"text"},{"type":"text","text":" "},{"type":"text","text":"packages and package management tools will vary."},{"text":" ","type":"text"},{"type":"text","text":"You should be able to find this in the documentation for"},{"type":"text","text":" "},{"type":"text","text":"your Linux distribution."}],"type":"paragraph"},{"style":"tip","type":"aside","name":"Tip","content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"Some more examples can also be found in the"},{"text":" ","type":"text"},{"type":"reference","identifier":"https:\/\/github.com\/rhx\/SwiftGLib\/blob\/main\/README.md","isActive":true},{"text":".","type":"text"}]}]},{"type":"heading","anchor":"Installing-GLib-on-macOS","level":3,"text":"Installing GLib on macOS"},{"inlineContent":[{"type":"text","text":"For macOS, there are multiple package management tools"},{"type":"text","text":" "},{"type":"text","text":"that you can use."},{"text":" ","type":"text"},{"identifier":"http:\/\/brew.sh\/","type":"reference","isActive":true},{"text":" is one example.","type":"text"},{"type":"text","text":" "},{"type":"text","text":"After you have installed HomeBrew, you can install"},{"type":"text","text":" "},{"type":"text","text":"GLib using:"}],"type":"paragraph"},{"code":["brew update","brew install glib glib-networking gobject-introspection pkg-config jq"],"type":"codeListing","syntax":null},{"level":2,"anchor":"Compiling-SwiftGLib-programs","type":"heading","text":"Compiling SwiftGLib programs"},{"inlineContent":[{"type":"text","text":"The easiest way to compile programs and libraries using"},{"text":" ","type":"text"},{"type":"text","text":"SwiftGLib is through projects using the"},{"type":"text","text":" "},{"identifier":"https:\/\/swift.org\/package-manager\/","type":"reference","isActive":true},{"text":".","type":"text"},{"type":"text","text":" "},{"type":"text","text":"Here is an example for a simple program that uses a"},{"type":"text","text":" "},{"identifier":"https:\/\/rhx.github.io\/SwiftGLib\/GLib\/documentation\/glib\/typedlist","isActive":true,"overridingTitle":"type list","type":"reference","overridingTitleInlineContent":[{"type":"text","text":"type list"}]},{"text":".","type":"text"},{"type":"text","text":" "},{"text":"First, create a directory (folder) for your project, then","type":"text"},{"text":" ","type":"text"},{"text":"create the project inside the folder:","type":"text"}],"type":"paragraph"},{"syntax":null,"code":["mkdir swift-glist","cd swift-glist","swift package init --type=executable"],"type":"codeListing"},{"type":"paragraph","inlineContent":[{"text":"This will create a simple “Hello World” executable that","type":"text"},{"text":" ","type":"text"},{"type":"text","text":"you can test using "},{"type":"codeVoice","code":"swift run"},{"type":"text","text":" – the program will run"},{"type":"text","text":" "},{"text":"and print “Hello world”.","type":"text"},{"type":"text","text":" "},{"type":"text","text":"If you look at the files generated by "},{"code":"swift package init","type":"codeVoice"},{"text":",","type":"text"},{"type":"text","text":" "},{"type":"text","text":"you will find a file named "},{"type":"codeVoice","code":"Package.swift"},{"type":"text","text":" that represents"},{"type":"text","text":" "},{"text":"the project and its compilation targets.","type":"text"},{"type":"text","text":" "},{"text":"Overall, if you run","type":"text"}]},{"type":"codeListing","syntax":null,"code":["find * -type f"]},{"inlineContent":[{"type":"text","text":"you should see two files, the aforementioned "},{"code":"Package.swift","type":"codeVoice"},{"type":"text","text":" "},{"text":"and a ","type":"text"},{"type":"codeVoice","code":"main.swift"},{"text":" in ","type":"text"},{"type":"codeVoice","code":"Sources\/swift-glist"},{"text":":","type":"text"}],"type":"paragraph"},{"type":"codeListing","syntax":null,"code":["Package.swift","Sources\/swift-glist\/main.swift"]},{"style":"warning","name":"Warning","content":[{"type":"paragraph","inlineContent":[{"text":"Some versions of the Swift Package manager create","type":"text"},{"type":"text","text":" "},{"text":"a flat structure when using ","type":"text"},{"type":"codeVoice","code":"swift package init"},{"type":"text","text":" that puts"},{"text":" ","type":"text"},{"text":"the ","type":"text"},{"type":"codeVoice","code":"main.swift"},{"type":"text","text":" directly in the "},{"type":"codeVoice","code":"Sources"},{"type":"text","text":" folder."},{"type":"text","text":" "},{"type":"text","text":"This will cause the Swift compiler to exit with an error if"},{"text":" ","type":"text"},{"type":"text","text":"you try to use "},{"type":"codeVoice","code":"swift run"},{"type":"text","text":"."}]}],"type":"aside"},{"inlineContent":[{"type":"text","text":"Such a faulty structure that places your "},{"type":"codeVoice","code":"main.swift"},{"text":" ","type":"text"},{"type":"text","text":"directly in the "},{"type":"codeVoice","code":"Sources"},{"type":"text","text":" folder would look like this:"}],"type":"paragraph"},{"syntax":null,"code":["Package.swift","Sources\/main.swift"],"type":"codeListing"},{"inlineContent":[{"type":"text","text":"In this case, your program won’t compile or run."},{"text":" ","type":"text"},{"text":"To fix this, you need to move the ","type":"text"},{"code":"main.swift","type":"codeVoice"},{"type":"text","text":" file"},{"text":" ","type":"text"},{"text":"into a ","type":"text"},{"type":"codeVoice","code":"swift-glist"},{"type":"text","text":" subfolder:"}],"type":"paragraph"},{"syntax":null,"code":["mkdir Sources\/swift-glist","mv Sources\/main.swift Sources\/swift-glist\/"],"type":"codeListing"},{"inlineContent":[{"text":"Now you should be able to build your project.","type":"text"}],"type":"paragraph"},{"type":"paragraph","inlineContent":[{"type":"text","text":"Let us now change the "},{"code":"Package.swift","type":"codeVoice"},{"text":" file so that it","type":"text"},{"type":"text","text":" "},{"text":"reads:","type":"text"}]},{"code":["\/\/ swift-tools-version: 5.7","","import PackageDescription","","let package = Package(","    name: \"swift-glist\",","    dependencies: [","        .package(url: \"https:\/\/github.com\/rhx\/gir2swift.git\", branch: \"main\"),","        .package(url: \"https:\/\/github.com\/rhx\/SwiftGLib.git\", branch: \"main\"),","    ],","    targets: [","        .executableTarget(","            name: \"swift-glist\",","            dependencies: [","                .product(name: \"GLib\", package: \"SwiftGLib\"),","            ]","        ),","    ]",")"],"type":"codeListing","syntax":"Swift"},{"type":"paragraph","inlineContent":[{"type":"text","text":"This will add the relevant dependencies for SwiftGLib"},{"text":" ","type":"text"},{"type":"text","text":"to the project.  We can now change the code in our"},{"type":"text","text":" "},{"type":"codeVoice","code":"Sources\/swift-glist\/main.swift"},{"type":"text","text":" so that it reads:"}]},{"syntax":"Swift","code":["import GLib","","let list: TypedList = [\"Hello\", \"world\"]","","print(list.length())  \/\/ Prints: 2","","list.forEach { element in","    print(element)    \/\/ Prints: \"hello\" and \"world\"","}"],"type":"codeListing"},{"type":"paragraph","inlineContent":[{"text":"Compile and run the code using:","type":"text"}]},{"syntax":null,"type":"codeListing","code":["swift run"]},{"inlineContent":[{"type":"text","text":"After some compiler output (and potentially"},{"text":" ","type":"text"},{"type":"text","text":"some warnings that you can ignore), you should get the"},{"type":"text","text":" "},{"type":"text","text":"following output:"}],"type":"paragraph"},{"code":["2","Hello","world"],"type":"codeListing","syntax":null}]}],"variants":[{"paths":["\/documentation\/glib\/tutorial"],"traits":[{"interfaceLanguage":"swift"}]}],"references":{"https://docs.gtk.org/glib/":{"title":"GLib","titleInlineContent":[{"type":"text","text":"GLib"}],"identifier":"https:\/\/docs.gtk.org\/glib\/","url":"https:\/\/docs.gtk.org\/glib\/","type":"link"},"https://gi.readthedocs.io/en/latest/":{"title":"GObject Introspection","titleInlineContent":[{"type":"text","text":"GObject Introspection"}],"identifier":"https:\/\/gi.readthedocs.io\/en\/latest\/","url":"https:\/\/gi.readthedocs.io\/en\/latest\/","type":"link"},"https://www.zsh.org/":{"title":"zsh","titleInlineContent":[{"type":"text","text":"zsh"}],"identifier":"https:\/\/www.zsh.org\/","url":"https:\/\/www.zsh.org\/","type":"link"},"https://www.gnu.org/software/bash/":{"title":"bash","titleInlineContent":[{"type":"text","text":"bash"}],"identifier":"https:\/\/www.gnu.org\/software\/bash\/","url":"https:\/\/www.gnu.org\/software\/bash\/","type":"link"},"https://github.com/rhx/SwiftGLib/blob/main/README.md":{"title":"README","titleInlineContent":[{"type":"text","text":"README"}],"identifier":"https:\/\/github.com\/rhx\/SwiftGLib\/blob\/main\/README.md","url":"https:\/\/github.com\/rhx\/SwiftGLib\/blob\/main\/README.md","type":"link"},"https://www.swift.org/install/":{"title":"installing Swift","titleInlineContent":[{"type":"text","text":"installing Swift"}],"identifier":"https:\/\/www.swift.org\/install\/","url":"https:\/\/www.swift.org\/install\/","type":"link"},"https://rhx.github.io/SwiftGLib/GLib/documentation/glib/typedslist":{"title":"singly","titleInlineContent":[{"type":"text","text":"singly"}],"identifier":"https:\/\/rhx.github.io\/SwiftGLib\/GLib\/documentation\/glib\/typedslist","url":"https:\/\/rhx.github.io\/SwiftGLib\/GLib\/documentation\/glib\/typedslist","type":"link"},"https://swift.org/package-manager/":{"title":"Swift Package Manager","titleInlineContent":[{"type":"text","text":"Swift Package Manager"}],"identifier":"https:\/\/swift.org\/package-manager\/","url":"https:\/\/swift.org\/package-manager\/","type":"link"},"https://wiki.debian.org/Apt":{"title":"apt","titleInlineContent":[{"type":"text","text":"apt"}],"identifier":"https:\/\/wiki