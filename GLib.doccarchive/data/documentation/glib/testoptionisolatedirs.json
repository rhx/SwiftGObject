{"schemaVersion":{"minor":3,"major":0,"patch":0},"hierarchy":{"paths":[["doc:\/\/GLib\/documentation\/GLib"]]},"sections":[],"metadata":{"modules":[{"name":"GLib"}],"fragments":[{"kind":"keyword","text":"let"},{"kind":"text","text":" "},{"kind":"identifier","text":"testOptionIsolateDirs"},{"kind":"text","text":": "},{"text":"String","kind":"typeIdentifier","preciseIdentifier":"s:SS"}],"role":"symbol","symbolKind":"var","roleHeading":"Global Variable","title":"testOptionIsolateDirs","externalID":"s:4GLib21testOptionIsolateDirsSSvp"},"variants":[{"paths":["\/documentation\/glib\/testoptionisolatedirs"],"traits":[{"interfaceLanguage":"swift"}]}],"kind":"symbol","identifier":{"interfaceLanguage":"swift","url":"doc:\/\/GLib\/documentation\/GLib\/testOptionIsolateDirs"},"primaryContentSections":[{"kind":"declarations","declarations":[{"platforms":["macOS"],"tokens":[{"text":"let","kind":"keyword"},{"text":" ","kind":"text"},{"kind":"identifier","text":"testOptionIsolateDirs"},{"kind":"text","text":": "},{"text":"String","kind":"typeIdentifier","preciseIdentifier":"s:SS"}],"languages":["swift"]}]},{"content":[{"text":"Discussion","type":"heading","anchor":"discussion","level":2},{"type":"paragraph","inlineContent":[{"type":"text","text":"Creates a unique temporary directory for each unit test and uses sets"},{"text":" ","type":"text"},{"text":"XDG directories to point into subdirectories of it for the duration of","type":"text"},{"type":"text","text":" "},{"text":"the unit test. The directory tree is cleaned up after the test finishes","type":"text"},{"type":"text","text":" "},{"text":"successfully.","type":"text"}]},{"type":"paragraph","inlineContent":[{"text":"Note that this doesn’t take effect until [func","type":"text"},{"code":"GLib.test_run","type":"codeVoice"},{"type":"text","text":"] is called,"},{"type":"text","text":" "},{"text":"so calls to (for example) [func","type":"text"},{"code":"GLib.get_home_dir","type":"codeVoice"},{"text":"] will return the","type":"text"},{"type":"text","text":" "},{"type":"text","text":"system-wide value when made in a test program’s "},{"code":"main()","type":"codeVoice"},{"text":" function.","type":"text"}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"The following functions will return subdirectories of the temporary directory"},{"type":"text","text":" "},{"text":"when this option is used. The specific subdirectory paths in use are not","type":"text"},{"text":" ","type":"text"},{"text":"guaranteed to be stable API — always use a getter function to retrieve them.","type":"text"}]},{"type":"unorderedList","items":[{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"[func"},{"type":"codeVoice","code":"GLib.get_home_dir"},{"text":"]","type":"text"}]}]},{"content":[{"inlineContent":[{"type":"text","text":"[func"},{"code":"GLib.get_user_cache_dir","type":"codeVoice"},{"text":"]","type":"text"}],"type":"paragraph"}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"[func"},{"code":"GLib.get_system_config_dirs","type":"codeVoice"},{"type":"text","text":"]"}]}]},{"content":[{"inlineContent":[{"type":"text","text":"[func"},{"type":"codeVoice","code":"GLib.get_user_config_dir"},{"text":"]","type":"text"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"text":"[func","type":"text"},{"code":"GLib.get_system_data_dirs","type":"codeVoice"},{"text":"]","type":"text"}],"type":"paragraph"}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"[func"},{"code":"GLib.get_user_data_dir","type":"codeVoice"},{"type":"text","text":"]"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"[func"},{"type":"codeVoice","code":"GLib.get_user_state_dir"},{"text":"]","type":"text"}]}]},{"content":[{"inlineContent":[{"text":"[func","type":"text"},{"type":"codeVoice","code":"GLib.get_user_runtime_dir"},{"type":"text","text":"]"}],"type":"paragraph"}]}]},{"inlineContent":[{"text":"The subdirectories may not be created by the test harness; as with normal","type":"text"},{"text":" ","type":"text"},{"type":"text","text":"calls to functions like [func"},{"type":"codeVoice","code":"GLib.get_user_cache_dir"},{"type":"text","text":"], the caller must"},{"text":" ","type":"text"},{"type":"text","text":"be prepared to create the directory if it doesn’t exist."}],"type":"paragraph"}],"kind":"content"}],"abstract":[{"text":"A value that can be passed as an option to [func","type":"text"},{"type":"codeVoice","code":"GLib.test_init"},{"type":"text","text":"]."}],"references":{"doc://GLib/documentation/GLib":{"identifier":"doc:\/\/GLib\/documentation\/GLib","title":"GLib","abstract":[],"type":"topic","url":"\/documentation\/glib","kind":"symbol","role":"collection"},"doc://GLib/documentation/GLib/testOptionIsolateDirs":{"role":"symbol","type":"topic","identifier":"doc:\/\/GLib\/documentation\/GLib\/testOptionIsolateDirs","kind":"symbol","url":"\/documentation\/glib\/testoptionisolatedirs","abstract":[{"text":"A value that can be passed as an option to [func","type":"text"},{"code":"GLib.test_init","type":"codeVoice"},{"type":"text","text":"]."}],"fragments":[{"kind":"keyword","text":"let"},{"kind":"text","text":" "},{"text":"testOptionIsolateDirs","kind":"identifier"},{"text":": ","kind":"text"},{"preciseIdentifier":"s:SS","text":"String","kind":"typeIdentifier"}],"title":"testOptionIsolateDirs"}}}