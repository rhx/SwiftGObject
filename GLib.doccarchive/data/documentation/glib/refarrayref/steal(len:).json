{"metadata":{"symbolKind":"method","title":"steal(len:)","extendedModule":"GLib","roleHeading":"Instance Method","externalID":"s:4GLib16PtrArrayProtocolPAAE5steal3lenSpySvSgGSgSpySuGSg_tF::SYNTHESIZED::s:4GLib08RefArrayB0V","modules":[{"name":"GLib"}],"role":"symbol","fragments":[{"kind":"keyword","text":"func"},{"text":" ","kind":"text"},{"kind":"identifier","text":"steal"},{"text":"(","kind":"text"},{"kind":"externalParam","text":"len"},{"text":": ","kind":"text"},{"text":"UnsafeMutablePointer","kind":"typeIdentifier","preciseIdentifier":"s:Sp"},{"text":"<","kind":"text"},{"preciseIdentifier":"c:@T@gsize","text":"gsize","kind":"typeIdentifier"},{"text":">!) -> ","kind":"text"},{"preciseIdentifier":"s:Sp","text":"UnsafeMutablePointer","kind":"typeIdentifier"},{"kind":"text","text":"<"},{"preciseIdentifier":"c:@T@gpointer","text":"gpointer","kind":"typeIdentifier"},{"text":"?>!","kind":"text"}]},"variants":[{"paths":["\/documentation\/glib\/refarrayref\/steal(len:)"],"traits":[{"interfaceLanguage":"swift"}]}],"primaryContentSections":[{"kind":"declarations","declarations":[{"platforms":["macOS"],"languages":["swift"],"tokens":[{"kind":"keyword","text":"func"},{"text":" ","kind":"text"},{"kind":"identifier","text":"steal"},{"kind":"text","text":"("},{"kind":"externalParam","text":"len"},{"text":": ","kind":"text"},{"text":"UnsafeMutablePointer","kind":"typeIdentifier","preciseIdentifier":"s:Sp"},{"kind":"text","text":"<"},{"kind":"typeIdentifier","text":"gsize","preciseIdentifier":"c:@T@gsize"},{"kind":"text","text":">! = nil) -> "},{"text":"UnsafeMutablePointer","kind":"typeIdentifier","preciseIdentifier":"s:Sp"},{"kind":"text","text":"<"},{"kind":"typeIdentifier","text":"gpointer","preciseIdentifier":"c:@T@gpointer"},{"text":"?>!","kind":"text"}]}]},{"kind":"content","content":[{"anchor":"discussion","text":"Discussion","type":"heading","level":2},{"type":"paragraph","inlineContent":[{"type":"text","text":"Note that if the array is "},{"type":"codeVoice","code":"NULL"},{"type":"text","text":" terminated this may still return"},{"text":" ","type":"text"},{"type":"codeVoice","code":"NULL"},{"type":"text","text":" if the length of the array was zero and pdata was not yet"},{"text":" ","type":"text"},{"type":"text","text":"allocated."}]},{"type":"paragraph","inlineContent":[{"text":"Even if set, the [callback","type":"text"},{"type":"reference","isActive":true,"identifier":"doc:\/\/GLib\/documentation\/GLib\/DestroyNotify"},{"text":"] function will never be called","type":"text"},{"type":"text","text":" "},{"type":"text","text":"on the current contents of the array and the caller is"},{"text":" ","type":"text"},{"type":"text","text":"responsible for freeing the array elements."}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"An example of use:"}]},{"code":["`g_autoptr(GPtrArray)` chunk_buffer = g_ptr_array_new_with_free_func (g_bytes_unref);","","\/\/ Some part of your application appends a number of chunks to the pointer array.","g_ptr_array_add (chunk_buffer, g_bytes_new_static (\"hello\", 5));","g_ptr_array_add (chunk_buffer, g_bytes_new_static (\"world\", 5));","","…","","\/\/ Periodically, the chunks need to be sent as an array-and-length to some","\/\/ other part of the program.","GBytes **chunks;","gsize n_chunks;","","chunks = g_ptr_array_steal (chunk_buffer, &n_chunks);","for (gsize i = 0; i < n_chunks; i++)","  {","    \/\/ Do something with each chunk here, and then free them, since","    \/\/ `g_ptr_array_steal()` transfers ownership of all the elements and the","    \/\/ array to the caller.","    …","","    g_bytes_unref (chunks[i]);","  }","","g_free (chunks);","","\/\/ After calling `g_ptr_array_steal()`, the pointer array can be reused for the","\/\/ next set of chunks.","g_assert (chunk_buffer->len == 0);"],"type":"codeListing","syntax":"c"}]}],"identifier":{"interfaceLanguage":"swift","url":"doc:\/\/GLib\/documentation\/GLib\/RefArrayRef\/steal(len:)"},"schemaVersion":{"major":0,"minor":3,"patch":0},"abstract":[{"type":"text","text":"Frees the data in the array and resets the size to zero, while"},{"type":"text","text":" "},{"type":"text","text":"the underlying array is preserved for use elsewhere and returned"},{"type":"text","text":" "},{"text":"to the caller.","type":"text"}],"hierarchy":{"paths":[["doc:\/\/GLib\/documentation\/GLib","doc:\/\/GLib\/documentation\/GLib\/RefArrayRef","doc:\/\/GLib\/documentation\/GLib\/RefArrayRef\/PtrArrayProtocol-Implementations"]]},"kind":"symbol","sections":[],"references":{"doc://GLib/documentation/GLib":{"identifier":"doc:\/\/GLib\/documentation\/GLib","title":"GLib","abstract":[],"type":"topic","url":"\/documentation\/glib","kind":"symbol","role":"collection"},"doc://GLib/documentation/GLib/RefArrayRef/steal(len:)":{"type":"topic","abstract":[{"text":"Frees the data in the array and resets the size to zero, while","type":"text"},{"type":"text","text":" "},{"type":"text","text":"the underlying array is preserved for use elsewhere and returned"},{"type":"text","text":" "},{"type":"text","text":"to the caller."}],"title":"steal(len:)","kind":"symbol","identifier":"doc:\/\/GLib\/documentation\/GLib\/RefArrayRef\/steal(len:)","url":"\/documentation\/glib\/refarrayref\/steal(len:)","role":"symbol","fragments":[{"kind":"keyword","text":"func"},{"text":" ","kind":"text"},{"text":"steal","kind":"identifier"},{"kind":"text","text":"("},{"text":"len","kind":"externalParam"},{"kind":"text","text":": "},{"kind":"typeIdentifier","text":"UnsafeMutablePointer","preciseIdentifier":"s:Sp"},{"text":"<","kind":"text"},{"text":"gsize","preciseIdentifier":"c:@T@gsize","kind":"typeIdentifier"},{"text":">!) -> ","kind":"text"},{"kind":"typeIdentifier","text":"UnsafeMutablePointer","preciseIdentifier":"s:Sp"},{"kind":"text","text":"<"},{"preciseIdentifier":"c:@T@gpointer","text":"gpointer","kind":"typeIdentifier"},{"text":"?>!","kind":"text"}]},"doc://GLib/documentation/GLib/RefArrayRef/PtrArrayProtocol-Implementations":{"abstract":[],"kind":"article","url":"\/documentation\/glib\/refarrayref\/ptrarrayprotocol-implementations","role":"collectionGroup","type":"topic","identifier":"doc:\/\/GLib\/documentation\/GLib\/RefArrayRef\/PtrArrayProtocol-Implementations","title":"PtrArrayProtocol Implementations"},"doc://GLib/documentation/GLib/DestroyNotify":{"abstract":[{"type":"text","text":"Specifies the type of function which is called when a data element"},{"type":"text","text":" "},{"type":"text","text":"is destroyed. It is passed the pointer to the data element and"},{"text":" ","type":"text"},{"text":"should free any memory and resources allocated for it.","type":"text"}],"kind":"symbol","fragments":[{"kind":"keyword","text":"typealias"},{"text":" ","kind":"text"},{"text":"DestroyNotify","kind":"identifier"}],"url":"\/documentation\/glib\/destroynotify","identifier":"doc:\/\/GLib\/documentation\/GLib\/DestroyNotify","title":"DestroyNotify","navigatorTitle":[{"text":"DestroyNotify","kind":"identifier"}],"role":"symbol","type":"topic"},"doc://GLib/documentation/GLib/RefArrayRef":{"kind":"symbol","title":"RefArrayRef","type":"topic","role":"symbol","identifier":"doc:\/\/GLib\/documentation\/GLib\/RefArrayRef","fragments":[{"kind":"keyword","text":"struct"},{"text":" ","kind":"text"},{"kind":"identifier","text":"RefArrayRef"}],"abstract":[{"text":"The ","type":"text"},{"type":"codeVoice","code":"RefArrayRef"},{"type":"text","text":" struct acts as a lightweight, typed wrapper aroundptr "},{"code":"GList","type":"codeVoice"},{"type":"text","text":","},{"text":" ","type":"text"},{"type":"text","text":"with the associated "},{"type":"codeVoice","code":"Element"},{"type":"text","text":" representing the type of"},{"text":" ","type":"text"},{"text":"the elements stored in the list.","type":"text"}],"url":"\/documentation\/glib\/refarrayref","navigatorTitle":[{"text":"RefArrayRef","kind":"identifier"}]}}}