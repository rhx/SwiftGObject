{"abstract":[{"text":"Runs a single iteration for the given main loop.","type":"text"}],"variants":[{"paths":["\/documentation\/glib\/maincontext\/iteration(mayblock:)"],"traits":[{"interfaceLanguage":"swift"}]}],"hierarchy":{"paths":[["doc:\/\/GLib\/documentation\/GLib","doc:\/\/GLib\/documentation\/GLib\/MainContext","doc:\/\/GLib\/documentation\/GLib\/MainContext\/MainContextProtocol-Implementations"]]},"metadata":{"roleHeading":"Instance Method","role":"symbol","fragments":[{"kind":"keyword","text":"func"},{"kind":"text","text":" "},{"kind":"identifier","text":"iteration"},{"text":"(","kind":"text"},{"kind":"externalParam","text":"mayBlock"},{"text":": ","kind":"text"},{"preciseIdentifier":"s:Sb","text":"Bool","kind":"typeIdentifier"},{"kind":"text","text":") -> "},{"text":"Bool","kind":"typeIdentifier","preciseIdentifier":"s:Sb"}],"symbolKind":"method","title":"iteration(mayBlock:)","modules":[{"name":"GLib"}],"extendedModule":"GLib","externalID":"s:4GLib19MainContextProtocolPAAE9iteration8mayBlockS2b_tF::SYNTHESIZED::s:4GLib11MainContextC"},"kind":"symbol","primaryContentSections":[{"kind":"declarations","declarations":[{"platforms":["macOS"],"languages":["swift"],"tokens":[{"text":"func","kind":"keyword"},{"kind":"text","text":" "},{"text":"iteration","kind":"identifier"},{"text":"(","kind":"text"},{"kind":"externalParam","text":"mayBlock"},{"kind":"text","text":": "},{"kind":"typeIdentifier","preciseIdentifier":"s:Sb","text":"Bool"},{"kind":"text","text":") -> "},{"text":"Bool","preciseIdentifier":"s:Sb","kind":"typeIdentifier"}]}]},{"content":[{"text":"Discussion","type":"heading","anchor":"discussion","level":2},{"type":"paragraph","inlineContent":[{"type":"text","text":"This involves"},{"text":" ","type":"text"},{"text":"checking to see if any event sources are ready to be processed,","type":"text"},{"type":"text","text":" "},{"type":"text","text":"then if no events sources are ready and "},{"type":"codeVoice","code":"mayBlock"},{"text":" is true, waiting