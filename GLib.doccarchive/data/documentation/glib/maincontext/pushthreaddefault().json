{"schemaVersion":{"major":0,"patch":0,"minor":3},"hierarchy":{"paths":[["doc:\/\/GLib\/documentation\/GLib","doc:\/\/GLib\/documentation\/GLib\/MainContext","doc:\/\/GLib\/documentation\/GLib\/MainContext\/MainContextProtocol-Implementations"]]},"sections":[],"metadata":{"modules":[{"name":"GLib"}],"role":"symbol","externalID":"s:4GLib19MainContextProtocolPAAE17pushThreadDefaultyyF::SYNTHESIZED::s:4GLib11MainContextC","roleHeading":"Instance Method","symbolKind":"method","fragments":[{"kind":"keyword","text":"func"},{"text":" ","kind":"text"},{"kind":"identifier","text":"pushThreadDefault"},{"text":"()","kind":"text"}],"title":"pushThreadDefault()","extendedModule":"GLib"},"variants":[{"paths":["\/documentation\/glib\/maincontext\/pushthreaddefault()"],"traits":[{"interfaceLanguage":"swift"}]}],"identifier":{"url":"doc:\/\/GLib\/documentation\/GLib\/MainContext\/pushThreadDefault()","interfaceLanguage":"swift"},"kind":"symbol","primaryContentSections":[{"kind":"declarations","declarations":[{"platforms":["macOS"],"languages":["swift"],"tokens":[{"text":"func","kind":"keyword"},{"text":" ","kind":"text"},{"kind":"identifier","text":"pushThreadDefault"},{"text":"()","kind":"text"}]}]},{"kind":"content","content":[{"level":2,"text":"Discussion","type":"heading","anchor":"discussion"},{"inlineContent":[{"text":"Normally you would call this function shortly after creating a new","type":"text"},{"text":" ","type":"text"},{"type":"text","text":"thread, passing it a [struct"},{"type":"reference","identifier":"doc:\/\/GLib\/documentation\/GLib\/MainContext","isActive":true},{"type":"text","text":"] which will be run by a"},{"type":"text","text":" "},{"text":"[struct","type":"text"},{"identifier":"doc:\/\/GLib\/documentation\/GLib\/MainLoop","isActive":true,"type":"reference"},{"text":"] in that thread, to set a new default context for all","type":"text"},{"text":" ","type":"text"},{"text":"async operations in that thread. In this case you may not need to","type":"text"},{"type":"text","text":" "},{"type":"text","text":"ever call [method"},{"code":"GLib.MainContext.pop_thread_default","type":"codeVoice"},{"type":"text","text":"], assuming you want"},{"text":" ","type":"text"},{"text":"the new [struct","type":"text"},{"type":"reference","isActive":true,"identifier":"doc:\/\/GLib\/documentation\/GLib\/MainContext"},{"type":"text","text":"] to be the default for the whole lifecycle"},{"text":" ","type":"text"},{"type":"text","text":"of the thread."}],"type":"paragraph"},{"inlineContent":[{"type":"text","text":"If you don’t have control over how the new thread was created (e.g."},{"text":" ","type":"text"},{"type":"text","text":"in the new thread isn’t newly created, or if the thread life"},{"text":" ","type":"text"},{"type":"text","text":"cycle is managed by a "},{"identifier":"doc:\/\/GLib\/documentation\/GLib\/ThreadPool","type":"reference","isActive":true},{"text":"), it is always suggested to wrap","type":"text"},{"text":" ","type":"text"},{"type":"text","text":"the logic that needs to use the new [struct"},{"isActive":true,"identifier":"doc:\/\/GLib\/documentation\/GLib\/MainContext","type":"reference"},{"text":"] inside a","type":"text"},{"text":" ","type":"text"},{"text":"[method","type":"text"},{"type":"codeVoice","code":"GLib.MainContext.push_thread_default"},{"type":"text","text":"] \/"},{"text":" ","type":"text"},{"type":"text","text":"[method"},{"type":"codeVoice","code":"GLib.MainContext.pop_thread_default"},{"type":"text","text":"] pair, otherwise threads that"},{"text":" ","type":"text"},{"text":"are re-used will end up never explicitly releasing the","type":"text"},{"type":"text","text":" "},{"type":"text","text":"[struct"},{"isActive":true,"identifier":"doc:\/\/GLib\/documentation\/GLib\/MainContext","type":"reference"},{"type":"text","text":"] reference they hold."}],"type":"paragraph"},{"type":"paragraph","inlineContent":[{"text":"In some cases you may want to schedule a single operation in a","type":"text"},{"text":" ","type":"text"},{"text":"non-default context, or temporarily use a non-default context in","type":"text"},{"type":"text","text":" "},{"text":"the main thread. In that case, you can wrap the call to the","type":"text"},{"type":"text","text":" "},{"text":"asynchronous operation inside a","type":"text"},{"type":"text","text":" "},{"type":"text","text":"[method"},{"code":"GLib.MainContext.push_thread_default","type":"codeVoice"},{"text":"] \/","type":"text"},{"type":"text","text":" "},{"type":"text","text":"[method"},{"code":"GLib.MainContext.pop_thread_default","type":"codeVoice"},{"type":"text","text":"] pair, but it is up to you to"},{"text":" ","type":"text"},{"type":"text","text":"ensure that no other asynchronous operations accidentally get"},{"type":"text","text":" "},{"type":"text","text":"started while the non-default context is active."}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"Beware that libraries that predate this function may not correctly"},{"type":"text","text":" "},{"type":"text","text":"handle being used from a thread with a thread-default context. For example,"},{"type":"text","text":" "},{"text":"see ","type":"text"},{"code":"g_file_supports_thread_contexts()","type":"codeVoice"},{"text":".","type":"text"}]}]}],"abstract":[{"type":"text","text":"Acquires "},{"type":"codeVoice","code":"context"},{"text":" and sets it as the thread-default context for the","type":"text"},{"text":" ","type":"text"},{"type":"text","text":"current thread. This will cause certain asynchronous operations"},{"text":" ","type":"text"},{"type":"text","text":"(such as most "},{"identifier":"..\/gio\/index.html","type":"reference","isActive":true},{"type":"text","text":"-based I\/O) which are"},{"type":"text","text":" "},{"text":"started in this thread to run under ","type":"text"},{"type":"codeVoice","code":"context"},{"type":"text","text":" and deliver their"},{"type":"text","text":" "},{"type":"text","text":"results to its main loop, rather than running under the global"},{"text":" ","type":"text"},{"text":"default main context in the main thread. Note that calling this function","type":"text"},{"type":"text","text":" "},{"text":"changes the context returned by [func","type":"text"},{"type":"codeVoice","code":"GLib.MainContext.get_thread_default"},{"type":"text","text":"],"},{"text":" ","type":"text"},{"type":"text","text":"not the one returned by [func"},{"type":"codeVoice","code":"GLib.MainContext.default"},{"type":"text","text":"], so it does not"},{"type":"text","text":" "},{"type":"text","text":"affect the context used by functions like [func"},{"code":"GLib.idle_add","type":"codeVoice"},{"type":"text","text":"]."}],"references":{"doc://GLib/documentation/GLib/ThreadPool":{"type":"topic","kind":"symbol","title":"ThreadPool","role":"symbol","abstract":[{"type":"text","text":"The "},{"type":"codeVoice","code":"GThreadPool"},{"type":"text","text":" struct represents a thread pool."}],"identifier":"doc:\/\/GLib\/documentation\/GLib\/ThreadPool","url":"\/documentation\/glib\/threadpool","fragments":[{"text":"class","kind":"keyword"},{"kind":"text","text":" "},{"kind":"identifier","text":"ThreadPool"}],"navigatorTitle":[{"text":"ThreadPool","kind":"identifier"}]},"doc://GLib/documentation/GLib/MainContext/pushThreadDefault()":{"kind":"symbol","abstract":[{"type":"text","text":"Acquires "},{"type":"codeVoice","code":"context"},{"text":" and sets it as the thread-default context for the","type":"text"},{"type":"text","text":" "},{"type":"text","text":"current thread. This will cause certain asynchronous operations"},{"type":"text","text":" "},{"type":"text","text":"(such as most "},{"identifier":"..\/gio\/index.html","isActive":true,"type":"reference"},{"type":"text","text":"-based I\/O) which are"},{"text":" ","type":"text"},{"text":"started in this thread to run under ","type":"text"},{"type":"codeVoice","code":"context"},{"text":" and deliver their","type":"text"},{"type":"text","text":" "},{"type":"text","text":"results to its main loop, rather than running under the global"},{"text":" ","type":"text"},{"type":"text","text":"default main context in the main thread. Note that calling this function"},{"type":"text","text":" "},{"text":"changes the context returned by [func","type":"text"},{"type":"codeVoice","code":"GLib.MainContext.get_thread_default"},{"type":"text","text":"],"},{"type":"text","text":" "},{"type":"text","text":"not the one returned by [func"},{"type":"codeVoice","code":"GLib.MainContext.default"},{"text":"], so it does not","type":"text"},{"type":"text","text":" "},{"type":"text","text":"affect the context used by functions like [func"},{"type":"codeVoice","code":"GLib.idle_add"},{"type":"text","text":"]."}],"url":"\/documentation\/glib\/maincontext\/pushthreaddefault()","role":"symbol","fragments":[{"kind":"keyword","text":"func"},{"kind":"text","text":" "},{"text":"pushThreadDefault","kind":"identifier"},{"text":"()","kind":"text"}],"type":"topic","title":"pushThreadDefault()","identifier":"doc:\/\/GLib\/documentation\/GLib\/MainContext\/pushThreadDefault()"},"doc://GLib/documentation/GLib/MainContext/MainContextProtocol-Implementations":{"title":"MainContextProtocol Implementations","role":"collectionGroup","identifier":"doc:\/\/GLib\/documentation\/GLib\/MainContext\/MainContextProtocol-Implementations","abstract":[],"type":"topic","url":"\/documentation\/glib\/maincontext\/maincontextprotocol-implementations","kind":"article"},"doc://GLib/documentation/GLib/MainLoop":{"identifier":"doc:\/\/GLib\/documentation\/GLib\/MainLoop","type":"topic","fragments":[{"kind":"keyword","text":"class"},{"kind":"text","text":" "},{"text":"MainLoop","kind":"identifier"}],"role":"symbol","title":"MainLoop","kind":"symbol","navigatorTitle":[{"kind":"identifier","text":"MainLoop"}],"abstract":[{"type":"text","text":"The "},{"type":"codeVoice","code":"GMainLoop"},{"text":" struct is an opaque data type","type":"text"},{"text":" ","type":"text"},{"type":"text","text":"representing the main event loop of a GLib or GTK application."}],"url":"\/documentation\/glib\/mainloop"},"doc://GLib/documentation/GLib":{"identifier":"doc:\/\/GLib\/documentation\/GLib","title":"GLib","abstract":[],"type":"topic","url":"\/documentation\/glib","kind":"symbol","role":"collection"},"doc://GLib/documentation/GLib/MainContext":{"title":"MainContext","identifier":"doc:\/\/GLib\/documentation\/GLib\/MainContext","fragments":[{"kind":"keyword","text":"class"},{"kind":"text","text":" "},{"kind":"identifier","text":"MainContext"}],"url":"\/documentation\/glib\/maincontext","navigatorTitle":[{"kind":"identifier","text":"MainContext"}],"kind":"symbol","type":"topic","role":"symbol","abstract":[{"type":"text","text":"The "},{"code":"GMainContext","type":"codeVoice"},{"text":" struct is an opaque data","type":"text"},{"text":" ","type":"text"},{"type":"text","text":"type representing a set of sources to be handled in a main loop."}]},"../gio/index.html":{"title":"Gio","type":"link","identifier":"..\/gio\/index.html","titleInlineContent":[{"text":"Gio","type":"text"}],"url":"..\/gio\/index.html"}}}