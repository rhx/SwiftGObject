{"schemaVersion":{"minor":3,"patch":0,"major":0},"kind":"symbol","sections":[],"hierarchy":{"paths":[["doc:\/\/GLib\/documentation\/GLib"]]},"identifier":{"interfaceLanguage":"swift","url":"doc:\/\/GLib\/documentation\/GLib\/childWatchAddFull(priority:pid:function:data:notify:)"},"primaryContentSections":[{"declarations":[{"tokens":[{"kind":"keyword","text":"func"},{"text":" ","kind":"text"},{"text":"childWatchAddFull","kind":"identifier"},{"text":"(","kind":"text"},{"text":"priority","kind":"externalParam"},{"kind":"text","text":": "},{"kind":"typeIdentifier","preciseIdentifier":"s:Si","text":"Int"},{"text":", ","kind":"text"},{"kind":"externalParam","text":"pid"},{"kind":"text","text":": "},{"text":"GPid","preciseIdentifier":"c:@T@GPid","kind":"typeIdentifier"},{"kind":"text","text":", "},{"kind":"externalParam","text":"function"},{"text":": ","kind":"text"},{"text":"GChildWatchFunc","kind":"typeIdentifier","preciseIdentifier":"c:@T@GChildWatchFunc"},{"text":"?, ","kind":"text"},{"text":"data","kind":"externalParam"},{"kind":"text","text":": "},{"preciseIdentifier":"c:@T@gpointer","kind":"typeIdentifier","text":"gpointer"},{"text":"? = nil, ","kind":"text"},{"text":"notify","kind":"externalParam"},{"kind":"text","text":": "},{"preciseIdentifier":"c:@T@GDestroyNotify","kind":"typeIdentifier","text":"GDestroyNotify"},{"text":"? = nil) -> ","kind":"text"},{"preciseIdentifier":"s:Si","text":"Int","kind":"typeIdentifier"}],"platforms":["macOS"],"languages":["swift"]}],"kind":"declarations"},{"kind":"content","content":[{"level":2,"type":"heading","text":"Discussion","anchor":"discussion"},{"inlineContent":[{"type":"text","text":"If you obtain "},{"type":"codeVoice","code":"pid"},{"text":" from [func","type":"text"},{"code":"GLib.spawn_async","type":"codeVoice"},{"text":"] or","type":"text"},{"text":" ","type":"text"},{"type":"text","text":"[func"},{"code":"GLib.spawn_async_with_pipes","type":"codeVoice"},{"text":"] you will need to pass","type":"text"},{"type":"text","text":" "},{"type":"text","text":"[flags"},{"type":"codeVoice","code":"GLib.SpawnFlags.DO_NOT_REAP_CHILD"},{"text":"] as a flag to the spawn function for","type":"text"},{"text":" ","type":"text"},{"text":"the child watching to work.","type":"text"}],"type":"paragraph"},{"inlineContent":[{"text":"In many programs, you will want to call [func","type":"text"},{"type":"codeVoice","code":"GLib.spawn_check_wait_status"},{"type":"text","text":"]"},{"text":" ","type":"text"},{"type":"text","text":"in the callback to determine whether or not the child exited"},{"type":"text","text":" "},{"type":"text","text":"successfully."}],"type":"paragraph"},{"inlineContent":[{"type":"text","text":"Also, note that on platforms where [type"},{"isActive":true,"identifier":"doc:\/\/GLib\/documentation\/GLib\/Pid","type":"reference"},{"text":"] must be explicitly closed","type":"text"},{"type":"text","text":" "},{"text":"(see [func","type":"text"},{"code":"GLib.spawn_close_pid","type":"codeVoice"},{"type":"text","text":"]) "},{"code":"pid","type":"codeVoice"},{"text":" must not be closed while the source","type":"text"},{"text":" ","type":"text"},{"type":"text","text":"is still active.  Typically, you should invoke [func"},{"code":"GLib.spawn_close_pid","type":"codeVoice"},{"type":"text","text":"]"},{"text":" ","type":"text"},{"type":"text","text":"in the callback function for the source."}],"type":"paragraph"},{"type":"paragraph","inlineContent":[{"text":"GLib supports only a single callback per process ID.","type":"text"},{"text":" ","type":"text"},{"text":"On POSIX platforms, the same restrictions mentioned for","type":"text"},{"type":"text","text":" "},{"type":"text","text":"[func"},{"code":"GLib.child_watch_source_new","type":"codeVoice"},{"text":"] apply to this function.","type":"text"}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"This internally creates a main loop source using"},{"type":"text","text":" "},{"text":"[func","type":"text"},{"type":"codeVoice","code":"GLib.child_watch_source_new"},{"type":"text","text":"] and attaches it to the main loop context"},{"text":" ","type":"text"},{"type":"text","text":"using [method"},{"type":"codeVoice","code":"GLib.Source.attach"},{"text":"]. You can do these steps manually if you","type":"text"},{"type":"text","text":" "},{"type":"text","text":"need greater control."}]}]}],"variants":[{"paths":["\/documentation\/glib\/childwatchaddfull(priority:pid:function:data:notify:)"],"traits":[{"interfaceLanguage":"swift"}]}],"abstract":[{"text":"Sets a function to be called when the child indicated by ","type":"text"},{"type":"codeVoice","code":"pid"},{"type":"text","text":" "},{"text":"exits, at the priority ","type":"text"},{"code":"priority","type":"codeVoice"},{"type":"text","text":"."}],"metadata":{"externalID":"s:4GLib17childWatchAddFull8priority3pid8function4data6notifyS2i_s5Int32VyAI_AISvSgtXCSgAJyAJXCSgtF","fragments":[{"kind":"keyword","text":"func"},{"text":" ","kind":"text"},{"text":"childWatchAddFull","kind":"identifier"},{"text":"(","kind":"text"},{"text":"priority","kind":"externalParam"},{"kind":"text","text":": "},{"preciseIdentifier":"s:Si","text":"Int","kind":"typeIdentifier"},{"kind":"text","text":", "},{"text":"pid","kind":"externalParam"},{"kind":"text","text":": "},{"text":"GPid","kind":"typeIdentifier","preciseIdentifier":"c:@T@GPid"},{"kind":"text","text":", "},{"kind":"externalParam","text":"function"},{"text":": ","kind":"text"},{"preciseIdentifier":"c:@T@GChildWatchFunc","text":"GChildWatchFunc","kind":"typeIdentifier"},{"kind":"text","text":"?, "},{"kind":"externalParam","text":"data"},{"text":": ","kind":"text"},{"preciseIdentifier":"c:@T@gpointer","text":"gpointer","kind":"typeIdentifier"},{"kind":"text","text":"?, "},{"text":"notify","kind":"externalParam"},{"text":": ","kind":"text"},{"preciseIdentifier":"c:@T@GDestroyNotify","kind":"typeIdentifier","text":"GDestroyNotify"},{"text":"?) -> ","kind":"text"},{"kind":"typeIdentifier","preciseIdentifier":"s:Si","tex