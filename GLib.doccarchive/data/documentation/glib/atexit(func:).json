{"variants":[{"paths":["\/documentation\/glib\/atexit(func:)"],"traits":[{"interfaceLanguage":"swift"}]}],"hierarchy":{"paths":[["doc:\/\/GLib\/documentation\/GLib"]]},"schemaVersion":{"minor":3,"major":0,"patch":0},"kind":"symbol","identifier":{"url":"doc:\/\/GLib\/documentation\/GLib\/atexit(func:)","interfaceLanguage":"swift"},"abstract":[{"text":"Specifies a function to be called at normal program termination.","type":"text"}],"metadata":{"fragments":[{"kind":"keyword","text":"func"},{"text":" ","kind":"text"},{"text":"atexit","kind":"identifier"},{"text":"(","kind":"text"},{"text":"func","kind":"externalParam"},{"text":": ","kind":"text"},{"kind":"typeIdentifier","preciseIdentifier":"c:@T@GVoidFunc","text":"GVoidFunc"},{"kind":"text","text":"?)"}],"modules":[{"name":"GLib"}],"role":"symbol","platforms":[],"roleHeading":"Function","symbolKind":"func","title":"atexit(func:)","externalID":"s:4GLib6atexit4funcyyyXCSg_tF"},"sections":[],"primaryContentSections":[{"declarations":[{"tokens":[{"text":"func","kind":"keyword"},{"text":" ","kind":"text"},{"text":"atexit","kind":"identifier"},{"text":"(","kind":"text"},{"kind":"externalParam","text":"func"},{"kind":"text","text":": "},{"text":"GVoidFunc","kind":"typeIdentifier","preciseIdentifier":"c:@T@GVoidFunc"},{"text":"?)","kind":"text"}],"platforms":["macOS"],"languages":["swift"]}],"kind":"declarations"},{"content":[{"level":2,"anchor":"discussion","type":"heading","text":"Discussion"},{"type":"paragraph","inlineContent":[{"text":"Since GLib 2.8.2, on Windows ","type":"text"},{"type":"codeVoice","code":"g_atexit()"},{"text":" actually is a preprocessor","type":"text"},{"type":"text","text":" "},{"text":"macro that maps to a call to the ","type":"text"},{"type":"codeVoice","code":"atexit()"},{"type":"text","text":" function in the C"},{"type":"text","text":" "},{"type":"text","text":"library. This means that in case the code that calls "},{"type":"codeVoice","code":"g_atexit()"},{"text":",","type":"text"},{"type":"text","text":" "},{"type":"text","text":"i.e. "},{"code":"atexit()","type":"codeVoice"},{"type":"text","text":", is in a DLL, the function will be called when the"},{"type":"text","text":" "},{"type":"text","text":"DLL is detached from the program. This typically makes more sense"},{"text":" ","type":"text"},{"type":"text","text":"than that the function is called when the GLib DLL is detached,"},{"text":" ","type":"text"},{"text":"which happened earlier when ","type":"text"},{"type":"codeVoice","code":"g_atexit()"},{"text":" was a function in the GLib","type":"text"},{"text":" ","type":"text"},{"type":"text","text":"DLL."}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"The behaviour of "},{"type":"codeVoice","code":"atexit()"},{"type":"text","text":" in the context of dynamically loaded"},{"text":" ","type":"text"},{"type":"text","text":"modules is not formally specified and varies wildly."}]},{"inlineContent":[{"type":"text","text":"On POSIX systems, calling "},{"type":"codeVoice","code":"g_atexit()"},{"text":" (or ","type":"text"},{"code":"atexit()","type":"codeVoice"},{"text":") in a dynamically","type":"text"},{"type":"text","text":" "},{"text":"loaded module which is unloaded before the program terminates might","type":"text"},{"text":" ","type":"text"},{"text":"well cause a crash at program exit.","type":"text"}],"type":"paragraph"},{"inlineContent":[{"type":"text","text":"Some POSIX systems implement "},{"code":"atexit()","type":"codeVoice"},{"text":" like Windows, and have each","type":"text"},{"text":" ","type":"text"},{"type":"text","text":"dynamically loaded module maintain an own atexit chain that is"},{"type":"text","text":" "},{"text":"called when the module is unloaded.","type":"text"}],"type":"paragraph"},{"inlineContent":[{"type":"text","text":"On other POSIX systems, before a dynamically loaded module is"},{"type":"text","text":" "},{"type":"text","text":"unloaded, the registered atexit functions (if any) residing in that"},{"text":" ","type":"text"},{"text":"module are called, regardless where the code that registered them","type":"text"},{"text":" ","type":"text"},{"type":"text","text":"resided. This is presumably the most robust approach."}],"type":"paragraph"},{"type":"paragraph","inlineContent":[{"type":"text","text":"As can be seen from the above, for portability it’s best to avoid"},{"text":" ","type":"text"},{"type":"text","text":"calling "},{"type":"codeVoice","code":"g_atexit()"},{"type":"text","text":" (or "},{"type":"codeVoice","code":"atexit()"},{"text":") except in the main executable of a","type":"text"},{"type":"text","text":" "},{"text":"program.","type":"text"}]},{"type":"paragraph","inlineContent":[{"type":"strong","inlineContent":[{"text":"atexit is deprecated:","type":"text"}]},{"text":" ","type":"text"},{"type":"text","text":"It is best to avoid g_atexit()."}]}],"kind":"content"}],"references":{"doc://GLib/documentation/GLib/atexit(func:)":{"title":"atexit(func:)","role":"symbol","kind":"symbol","identifier":"doc:\/\/GLib\/documentation\/GLib\/atexit(func:)","deprecated":true,"url":"\/documentation\/glib\/atexit(func:)","fragments":[{"kind":"keyword","text":"func"},{"text":" ","kind":"text"},{"text":"atexit","kind":"identifier"},{"kind":"text","text":"("},{"text":"func","kind":"externalParam"},{"kind":"text","text":": "},{"text":"GVoidFunc","preciseIdentifier":"c:@T@GVoidFunc","kind":"typeIdentifier"},{"text":"?)","kind":"text"}],"type":"topic","abstract":[{"text":"Specifies a function to be called at normal program termination.","type":"text"}]},"doc://GLib/documentation/GLib":{"identifier":"doc:\/\/GLib\/documentation\/GLib","title":"GLib","abstract":[],"type":"topic","url":"\/documentation\/glib","kind":"symbol","role":"collection"}}}