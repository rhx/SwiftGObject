 error to call this function if the builder"},{"type":"text","text":" "},{"type":"text","text":"was created with an indefinite array or maybe type and no children"},{"text":" ","type":"text"},{"type":"text","text":"have been added; in this case it is impossible to infer the type of"},{"text":" ","type":"text"},{"text":"the empty array.","type":"text"}]}],"kind":"content"}],"schemaVersion":{"major":0,"minor":3,"patch":0},"identifier":{"url":"doc:\/\/GLib\/documentation\/GLib\/VariantBuilder\/end()","interfaceLanguage":"swift"},"kind":"symbol","abstract":[{"text":"Ends the builder process and returns the constructed value.","type":"text"}],"metadata":{"roleHeading":"Instance Method","externalID":"s:4GLib22VariantBuilderProtocolPAAE3endAA0B3RefVSgyF::SYNTHESIZED::s:4GLib14VariantBuilderC","title":"end()","role":"symbol","extendedModule":"GLib","symbolKind":"method","modules":[{"name":"GLib"}],"fragments":[{"text":"func","kind":"keyword"},{"text":" ","kind":"text"},{"text":"end","kind":"identifier"},{"text":"() -> ","kind":"text"},{"preciseIdentifier":"s:4GLib10VariantRefV","kind":"typeIdentifier","text":"VariantRef"},{"text":"!","kind":"text"}]},"hierarchy":{"paths":[["doc:\/\/GLib\/documentation\/GLib","doc:\/\/GLib\/documentation\/GLib\/VariantBuilder","doc:\/\/GLib\/documentation\/GLib\/VariantBuilder\/VariantBuilderProtocol-Implementations"]]},"sections":[],"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/glib\/variantbuilder\/end()"]}],"references":{"doc://GLib/documentation/GLib/Variant":{"role":"symbol","kind":"symbol","navigatorTitle":[{"text":"Variant","kind":"identifier"}],"title":"Variant","identifier":"doc:\/\/GLib\/documentation\/GLib\/Variant","fragments":[{"kind":"keyword","text":"class"},{"text":" ","kind":"text"},{"text":"Variant","kind":"identifier"}],"abstract":[{"code":"GVariant","type":"codeVoice"},{"type":"text","text":" is a variant datatype; it can contain one or more values"},{"type":"text","text":" "},{"type":"t