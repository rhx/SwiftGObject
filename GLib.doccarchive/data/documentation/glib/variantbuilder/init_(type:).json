 ","type":"text"},{"type":"codeVoice","code":"G_VARIANT_TYPE_*"},{"type":"text","text":" constants"},{"text":" ","type":"text"},{"text":"or a ","type":"text"},{"type":"codeVoice","code":"G_VARIANT_TYPE (\"(ii)\")"},{"text":" macro, it is more performant to use","type":"text"},{"type":"text","text":" "},{"code":"g_variant_builder_init_static()","type":"codeVoice"},{"type":"text","text":" rather than "},{"type":"codeVoice","code":"g_variant_builder_init()"},{"type":"text","text":"."}],"type":"paragraph"},{"inlineContent":[{"type":"text","text":"After the builder is initialised, values are added using"},{"type":"text","text":" "},{"type":"codeVoice","code":"g_variant_builder_add_value()"},{"type":"text","text":" or "},{"type":"codeVoice","code":"g_variant_builder_add()"},{"text":".","type":"text"}],"type":"paragraph"},{"type":"paragraph","inlineContent":[{"type":"text","text":"After all the child values are added, "},{"type":"codeVoice","code":"g_variant_builder_end()"},{"type":"text","text":" frees"},{"type":"text","text":" "},{"text":"the memory associated with the builder and returns the ","type":"text"},{"identifier":"doc:\/\/GLib\/documentation\/GLib\/Variant","isActive":true,"type":"reference"},{"type":"text","text":" that"},{"text":" ","type":"text"},{"text":"was created.","type":"text"}]},{"inlineContent":[{"type":"text","text":"This function completely ignores the previous contents of "},{"type":"codeVoice","code":"builder"},{"type":"text","text":"."},{"type":"text","text":" "},{"text":"On one hand this means that it is valid to pass in completely","type":"text"},{"text":" ","type":"text"},{"type":"text","text":"uninitialised memory.  On the other hand, this means that if you are"},{"text":" ","type":"text"},{"type":"text","text":"initialising over top of an existing "},{"isActive":true,"type":"reference","identifier":"doc:\/\/GLib\/documentation\/GLib\/VariantBuilder"},{"text":" you need to","type":"text"},{"text":" ","type":"text"},{"type":"text","text":"first call "},{"type":"codeVoice","code":"g_variant_builder_clear()"},{"type":"text","text":" in order to avoid leaking"},{"type":"text","text":" "},{"type":"text","text":"memory."}],"type":"paragraph"},{"type":"paragraph","inlineContent":[{"type":"text","text":"You must not call "},{"code":"g_variant_builder_ref()","type":"codeVoice"},{"type":"text","text":" or"},{"text":" ","type":"text"},{"type":"codeVoice","code":"g_variant_builder_unref()"},{"text":" on a ","type":"text"},{"type":"reference","identifier":"doc:\/\/GLib\/documentation\/GLib\/VariantBuilder","isActive":true},{"text":" that was initialised","type":"text"},{"text":" ","type":"text"},{"type":"text","text":"with this function.  If you ever pass a reference to a"},{"type":"text","text":" "},{"isActive":true,"type":"reference","identifier":"doc:\/\/GLib\/documentation\/GLib\/VariantBuilder"},{"text":" outside of the control of your own code then you","type":"text"},{"text":" ","type":"text"},{"text":"should assume that the person receiving that reference may try to use","type":"text"},{"text":" ","type":"text"},{"type":"text","text":"reference counting; you should use "},{"type":"codeVoice","code":"g_variant_builder_new()"},{"type":"text","text":" instead of"},{"type":"text","text":" "},{"text":"this function.","type":"text"}]}]}],"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/glib\/variantbuilder\/init_(type:)"]}],"abstract":[{"text":"Initialises a ","type":"text"},{"type":"reference","identifier":"doc:\/\/GLib\/documentation\/GLib\/VariantBuilder","isActive":true},{"text":" structure.","type":"text"}],"metadata":{"externalID":"s:4GLib22VariantBuilderProtocolPAAE5init_4typeyqd___tAA0b4TypeD0Rd__lF::SYNTHESIZED::s:4GLib14VariantBuilderC","extendedModule":"GLib","fragments":[{"text":"func","kind":"keyword"},{"text":" ","kind":"text"},{"text":"init_","kind":"identifier"},{"text":"<","kind":"text"},{"text":"VariantTypeT","kind":"genericParameter"},{"kind":"text","text":">("},