ext","text":": "},{"preciseIdentifier":"s:Si","kind":"typeIdentifier","text":"Int"},{"kind":"text","text":", "},{"text":"interval","kind":"externalParam"},{"text":": ","kind":"text"},{"text":"Int","preciseIdentifier":"s:Si","kind":"typeIdentifier"},{"text":", ","kind":"text"},{"text":"function","kind":"externalParam"},{"text":": ","kind":"text"},{"kind":"typeIdentifier","preciseIdentifier":"c:@T@GSourceFunc","text":"GSourceFunc"},{"text":"?, ","kind":"text"},{"kind":"externalParam","text":"data"},{"kind":"text","text":": "},{"kind":"typeIdentifier","preciseIdentifier":"c:@T@gpointer","text":"gpointer"},{"kind":"text","text":"? = nil, "},{"text":"notify","kind":"externalParam"},{"kind":"text","text":": "},{"text":"GDestroyNotify","kind":"typeIdentifier","preciseIdentifier":"c:@T@GDestroyNotify"},{"text":"? = nil) -> ","kind":"text"},{"text":"Int","kind":"typeIdentifier","preciseIdentifier":"s:Si"}]}],"kind":"declarations"},{"kind":"content","content":[{"text":"Discussion","type":"heading","anchor":"discussion","level":2},{"type":"paragraph","inlineContent":[{"type":"text","text":"The function is called repeatedly until it returns"},{"text":" ","type":"text"},{"type":"text","text":"[const"},{"identifier":"doc:\/\/GLib\/documentation\/GLib\/sourceRemove","isActive":true,"type":"reference"},{"type":"text","text":"], at which point the timeout is automatically"},{"text":" ","type":"text"},{"text":"destroyed and","type":"text"},{"text":" ","type":"text"},{"text":"the function will not be called again.  The ","type":"text"},{"type":"codeVoice","code":"notify"},{"type":"text","text":" function is"},{"text":" ","type":"text"},{"text":"called when the timeout is destroyed.  The first call to the","type":"text"},{"text":" ","type":"text"},{"text":"function will be at the end of the first ","type":"text"},{"code":"interval","type":"codeVoice"},{"type":"text","text":"."}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"Note that timeout functions may be delayed, due to the processing of other"},{"text":" ","type":"text"},{"type":"text","text":"event sources. Thus they should not be relied on for precise timing."},{"type":"text","text":" "},{"type":"text","text":"After each call to the timeout function, the time of the next"},{"text":" ","type":"text"},{"type":"text","text":"timeout is recalculated based on the current time and the given interval"},{"type":"text","text":" "},{"type":"text","text":"(it does not try to ‘catch up’ time lost in delays)."}]},{"inlineContent":[{"text":"See ","type":"text"},{"isActive":true,"type":"reference","identifier":"main-loop.html#memory-management-of-sources"},{"type":"text","text":" for details"},{"type":"text","text":" "},{"text":"on how to handle the return value and memory management of ","type":"text"},{"type":"codeVoice","code":"data"},{"type":"text","text":"."}],"type":"paragraph"},{"inlineContent":[{"text":"This internally creates a main loop source using","type":"text"},{"type":"text","text":" "},{"text":"[func","type":"text"},{"code":"GLib.timeout_source_new","type":"codeVoice"},{"type":"text","text":"] and attaches it to the global"},{"type":"text","text":" "},{"text":"[struct","type":"text"},{"type":"reference","isActive":true,"identifier":"doc:\/\/GLib\/documentation\/GLib\/MainContext"},{"type":"text","text":"] using [method"},{"code":"GLib.Source.attach","type":"codeVoice"},{"text":"], so the callback","type":"text"},{"type":"text","text":" "},{"text":"will be invoked in whichever thread is running that main context. You can do","type":"text"},{"text":" ","type":"text"},{"type":"text","text":"these steps manually if you need greater control or to use a custom main"},{"type":"text","text":" "},{"text":"context.","type":"text"}],"type":"paragraph"},{"type":"paragraph","inlineContent":[{"text":"The interval given is in terms of monotonic time, not wall clock time.","type":"text"},{"type":"text","text":" "},{"text":"See [func","type":"text"},{"type":"codeVoice","code":"GLib.get_mono