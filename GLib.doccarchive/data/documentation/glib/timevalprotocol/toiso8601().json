{"identifier":{"url":"doc:\/\/GLib\/documentation\/GLib\/TimeValProtocol\/toIso8601()","interfaceLanguage":"swift"},"schemaVersion":{"patch":0,"major":0,"minor":3},"hierarchy":{"paths":[["doc:\/\/GLib\/documentation\/GLib","doc:\/\/GLib\/documentation\/GLib\/TimeValProtocol"]]},"metadata":{"platforms":[],"title":"toIso8601()","roleHeading":"Instance Method","role":"symbol","fragments":[{"kind":"keyword","text":"func"},{"kind":"text","text":" "},{"text":"toIso8601","kind":"identifier"},{"kind":"text","text":"() -> "},{"kind":"typeIdentifier","text":"String","preciseIdentifier":"s:SS"},{"kind":"text","text":"!"}],"externalID":"s:4GLib15TimeValProtocolPAAE9toIso8601SSSgyF","modules":[{"name":"GLib"}],"symbolKind":"method","extendedModule":"GLib"},"kind":"symbol","primaryContentSections":[{"kind":"declarations","declarations":[{"languages":["swift"],"tokens":[{"text":"func","kind":"keyword"},{"text":" ","kind":"text"},{"kind":"identifier","text":"toIso8601"},{"text":"() -> ","kind":"text"},{"text":"String","preciseIdentifier":"s:SS","kind":"typeIdentifier"},{"kind":"text","text":"!"}],"platforms":["macOS"]}]},{"kind":"content","content":[{"level":2,"anchor":"discussion","type":"heading","text":"Discussion"},{"type":"paragraph","inlineContent":[{"text":"ISO 8601 allows a large number of date\/time formats, with or without","type":"text"},{"text":" ","type":"text"},{"text":"punctuation and optional elements. The format returned by this function","type":"text"},{"text":" ","type":"text"},{"type":"text","text":"is a complete date and time, with optional punctuation included, the"},{"type":"text","text":" "},{"type":"text","text":"UTC time zone represented as “Z”, and the "},{"code":"tv_usec","type":"codeVoice"},{"text":" part included if","type":"text"},{"text":" ","type":"text"},{"type":"text","text":"and only if it is nonzero, i.e. either"},{"type":"text","text":" "},{"type":"text","text":"“YYYY-MM-DDTHH:MM:SSZ” or “YYYY-MM-DDTHH:MM:SS.fffffZ”."}]},{"inlineContent":[{"type":"text","text":"This corresponds to the Internet date\/time format defined by"},{"text":" ","type":"text"},{"identifier":"https:\/\/www.ietf.org\/rfc\/rfc3339.txt","isActive":true,"type":"reference"},{"text":",","type":"text"},{"type":"text","text":" "},{"text":"and to either of the two most-precise formats defined by","type":"text"},{"text":" ","type":"text"},{"type":"text","text":"the W3C Note"},{"text":" ","type":"text"},{"type":"reference","identifier":"http:\/\/www.w3.org\/TR\/NOTE-datetime-19980827","isActive":true},{"text":".","type":"text"},{"text":" ","type":"text"},{"text":"Both of these documents are profiles of ISO 8601.","type":"text"}],"type":"paragraph"},{"inlineContent":[{"text":"Use ","type":"text"},{"type":"codeVoice","code":"g_date_time_format()"},{"text":" or ","type":"text"},{"code":"g_strdup_printf()","type":"codeVoice"},{"type":"text","text":" if a different"},{"text":" ","type":"text"},{"type":"text","text":"variation of ISO 8601 format is required."}],"type":"paragraph"},{"type":"paragraph","inlineContent":[{"type":"text","text":"If "},{"code":"time","type":"codeVoice"},{"type":"text","text":" represents a date which is too large to fit into a "},{"code":"struct tm","type":"codeVoice"},{"text":",","type":"text"},{"text":" ","type":"text"},{"type":"codeVoice","code":"nil"},{"type":"text","text":" will be returned. This is platform dependent. Note also that since"},{"type":"text","text":" "},{"code":"GTimeVal","type":"codeVoice"},{"type":"text","text":" stores the number of seconds as a "},{"type":"codeVoice","code":"glong"},{"text":", on 32-bit systems it","type":"text"},{"type":"text","text":" "},{"text":"is subject to the year 2038 problem. Accordingly, since GLib 2.62, this","type":"text"},{"text":" ","type":"text"},{"type":"text","text":"function has been deprecated. Equivalent functionality is available using:"}]},{"type":"codeListing","code":["GDateTime *dt = g_date_time_new_from_unix_utc (time_val);","iso8601_string = g_date_time_format_iso8601 (dt);","g_date_time_unref (dt);"],"syntax":null},{"type":"paragraph","inlineContent":[{"type":"text","text":"The return value of "},{"code":"g_time_val_to_iso8601()","type":"codeVoice"},{"type":"text","text":" has been nullable since GLib"},{"type":"text","text":" "},{"type":"text","text":"2.54; before then, GLib would crash under the same conditions."}]},{"inlineContent":[{"inlineContent":[{"text":"to_iso8601 is deprecated:","type":"text"}],"type":"strong"},{"text":" ","type":"text"},{"text":"#GTimeVal is not year-2038-safe. Use","type":"text"},{"type":"text","text":" "},{"text":"g_date_time_format_iso8601(dt) instead.","type":"text"}],"type":"paragraph"}]}],"sections":[],"abstract":[{"text":"Converts ","type":"text"},{"code":"time","type":"codeVoice"},{"text":" into an RFC 3339 encoded string, relative to the","type":"text"},{"text":" ","type":"text"},{"type":"text","text":"Coordinated Universal Time (UTC). This is one of the many formats"},{"type":"text","text":" "},{"type":"text","text":"allowed by ISO 8601."}],"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/glib\/timevalprotocol\/toiso8601()"]}],"references":{"https://www.ietf.org/rfc/rfc3339.txt":{"url":"https:\/\/www.ietf.org\/rfc\/rfc3339.txt","titleInlineContent":[{"type":"text","text":"RFC 3339"}],"type":"link","identifier":"https:\/\/www.ietf.org\/rfc\/rfc3339.txt","title":"RFC 3339"},"doc://GLib/documentation/GLib/TimeValProtocol/toIso8601()":{"role":"symbol","abstract":[{"type":"text","text":"Converts "},{"type":"codeVoice","code":"time"},{"text":" into an RFC 3339 encoded string, relative to the","type":"text"},{"text":" ","type":"text"},{"type":"text","text":"Coordinated Universal Time (UTC). This is one of the many formats"},{"type":"text","text":" "},{"text":"allowed by ISO 8601.","type":"text"}],"url":"\/documentation\/glib\/timevalprotocol\/toiso8601()","deprecated":true,"kind":"symbol","type":"topic","title":"toIso8601()","identifier":"doc:\/\/GLib\/documentation\/GLib\/TimeValProtocol\/toIso8601()","fragments":[{"kind":"keyword","text":"func"},{"kind":"text","text":" "},{"kind":"identifier","text":"toIso8601"},{"text":"() -> ","kind":"text"},{"kind":"typeIdentifier","preciseIdentifier":"s:SS","text":"String"},{"kind":"text","text":"!"}]},"http://www.w3.org/TR/NOTE-datetime-19980827":{"type":"link","title":"Date and Time Formats","identifier":"http:\/\/www.w3.org\/TR\/NOTE-datetime-19980827","titleInlineContent":[{"type":"text","text":"Date and Time Formats"}],"url":"http:\/\/www.w3.org\/TR\/NOTE-datetime-19980827"},"doc://GLib/documentation/GLib/TimeValProtocol":{"title":"TimeValProtocol","url":"\/documentation\/glib\/timevalprotocol","role":"symbol","kind":"symbol","fragments":[{"kind":"keyword","text":"protocol"},{"text":" ","kind":"text"},{"kind":"identifier","text":"TimeValProtocol"}],"abstract":[{"text":"Represents a precise time, with seconds and microseconds.","type":"text"}],"type":"topic","identifier":"doc:\/\/GLib\/documentation\/GLib\/TimeValProtocol","navigatorTitle":[{"kind":"identifier","text":"TimeValProtocol"}]},"doc://GLib/documentation/GLib":{"identifier":"doc:\/\/GLib\/documentation\/GLib","title":"GLib","abstract":[],"type":"topic","url":"\/documentation\/glib","kind":"symbol","role":"collection"}}}