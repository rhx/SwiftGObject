{"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/glib\/condprotocol\/waituntil(mutex:endtime:)"]}],"sections":[],"hierarchy":{"paths":[["doc:\/\/GLib\/documentation\/GLib","doc:\/\/GLib\/documentation\/GLib\/CondProtocol"]]},"kind":"symbol","schemaVersion":{"minor":3,"patch":0,"major":0},"abstract":[{"type":"text","text":"Waits until either "},{"type":"codeVoice","code":"cond"},{"type":"text","text":" is signalled or "},{"type":"codeVoice","code":"endTime"},{"text":" has passed.","type":"text"}],"metadata":{"role":"symbol","symbolKind":"method","modules":[{"name":"GLib"}],"roleHeading":"Instance Method","externalID":"s:4GLib12CondProtocolPAAE9waitUntil5mutex7endTimeSbqd___s5Int64VtAA05MutexC0Rd__lF","fragments":[{"text":"func","kind":"keyword"},{"text":" ","kind":"text"},{"text":"waitUntil","kind":"identifier"},{"text":"<","kind":"text"},{"text":"MutexT","kind":"genericParameter"},{"text":">(","kind":"text"},{"text":"mutex","kind":"externalParam"},{"text":": ","kind":"text"},{"kind":"typeIdentifier","text":"MutexT"},{"text":", ","kind":"text"},{"text":"endTime","kind":"externalParam"},{"text":": ","kind":"text"},{"kind":"typeIdentifier","preciseIdentifier":"c:@T@gint64","text":"gint64"},{"text":") -> ","kind":"text"},{"preciseIdentifier":"s:Sb","kind":"typeIdentifier","text":"Bool"}],"title":"waitUntil(mutex:endTime:)","extendedModule":"GLib"},"identifier":{"interfaceLanguage":"swift","url":"doc:\/\/GLib\/documentation\/GLib\/CondProtocol\/waitUntil(mutex:endTime:)"},"primaryContentSections":[{"kind":"declarations","declarations":[{"tokens":[{"kind":"keyword","text":"func"},{"text":" ","kind":"text"},{"text":"waitUntil","kind":"identifier"},{"text":"<","kind":"text"},{"text":"MutexT","kind":"genericParameter"},{"kind":"text","text":">("},{"text":"mutex","kind":"externalParam"},{"text":": ","kind":"text"},{"kind":"typeIdentifier","text":"MutexT"},{"kind":"text","text":", "},{"kind":"externalParam","text":"endTime"},{"text":": ","kind":"text"},{"preciseIdentifier":"c:@T@gint64","text":"gint64","kind":"typeIdentifier"},{"kind":"text","text":") -> "},{"text":"Bool","kind":"typeIdentifier","preciseIdentifier":"s:Sb"},{"text":" ","kind":"text"},{"text":"where","kind":"keyword"},{"kind":"text","text":" "},{"text":"MutexT","kind":"typeIdentifier"},{"kind":"text","text":" : "},{"kind":"typeIdentifier","preciseIdentifier":"s:4GLib13MutexProtocolP","identifier":"doc:\/\/GLib\/documentation\/GLib\/MutexProtocol","text":"MutexProtocol"}],"platforms":["macOS"],"languages":["swift"]}]},{"kind":"content","content":[{"level":2,"type":"heading","text":"Discussion","anchor":"discussion"},{"type":"paragraph","inlineContent":[{"type":"text","text":"As with "},{"code":"g_cond_wait()","type":"codeVoice"},{"text":" it is possible that a spurious or stolen wakeup","type":"text"},{"type":"text","text":" "},{"type":"text","text":"could occur.  For that reason, waiting on a condition variable should"},{"text":" ","type":"text"},{"type":"text","text":"always be in a loop, based on an explicitly-checked predicate."}]},{"type":"paragraph","inlineContent":[{"code":"true","type":"codeVoice"},{"type":"text","text":" is returned if the condition variable was signalled (or in the"},{"text":" ","type":"text"},{"type":"text","text":"case of a spurious wakeup).  "},{"type":"codeVoice","code":"false"},{"type":"text","text":" is returned if "},{"type":"codeVoice","code":"endTime"},{"text":" has","type":"text"},{"text":" ","type":"text"},{"text":"passed.","type":"text"}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"The following code shows how to correctly perform a timed wait on a"},{"text":" ","type":"text"},{"text":"condition variable (extending the example presented in the","type":"text"},{"text":" ","type":"text"},{"type":"text","text":"documentation for "},{"type":"reference","isActive":true,"identifier":"doc:\/\/GLib\/documentation\/GLib\/Cond"},{"type":"text","text":"):"}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"(C Language Example):"}]},{"syntax":"C","code":["gpointer","pop_data_timed (void)","{","  gint64 end_time;","  gpointer data;","","  g_mutex_lock (&data_mutex);","","  end_time = g_get_monotonic_time () + 5 * G_TIME_SPAN_SECOND;","  while (!current_data)","    if (!g_cond_wait_until (&data_cond, &data_mutex, end_time))","      {","        \/\/ timeout has passed.","        g_mutex_unlock (&data_mutex);","        return NULL;","      }","","  \/\/ there is data for us","  data = current_data;","  current_data = NULL;","","  g_mutex_unlock (&data_mutex);","","  return data;","}"],"type":"codeListing"},{"type":"paragraph","inlineContent":[{"text":"Notice that the end time is calculated once, before entering the","type":"text"},{"type":"text","text":" "},{"type":"text","text":"loop and reused.  This is the motivation behind the use of absolute"},{"text":" ","type":"text"},{"type":"text","text":"time on this API – if a relative time of 5 seconds were passed"},{"text":" ","type":"text"},{"type":"text","text":"directly to the call and a spurious wakeup occurred, the program would"},{"type":"text","text":" "},{"text":"have to start over waiting again (which would lead to a total wait","type":"text"},{"text":" ","type":"text"},{"text":"time of more than 5 seconds).","type":"text"}]}]}],"references":{"doc://GLib/documentation/GLib/Cond":{"identifier":"doc:\/\/GLib\/documentation\/GLib\/Cond","type":"topic","fragments":[{"kind":"keyword","text":"class"},{"text":" ","kind":"text"},{"kind":"identifier","text":"Cond"}],"role":"symbol","title":"Cond","kind":"symbol","navigatorTitle":[{"kind":"identifier","text":"Cond"}],"abstract":[{"type":"text","text":"The "},{"identifier":"doc:\/\/GLib\/documentation\/GLib\/Cond","isActive":true,"type":"reference"},{"text":" struct is an opaque data structure that represents a","type":"text"},{"type":"text","text":" "},{"type":"text","text":"condition. Threads can block on a "},{"type":"reference","identifier":"doc:\/\/GLib\/documentation\/GLib\/Cond","isActive":true},{"type":"text","text":" if they find a certain"},{"type":"text","text":" "},{"type":"text","text":"condition to be false. If other threads change the state of this"},{"text":" ","type":"text"},{"text":"condition they signal the ","type":"text"},{"type":"reference","isActive":true,"identifier":"doc:\/\/GLib\/documentation\/GLib\/Cond"},{"type":"text","text":", and that causes the waiting"},{"text":" ","type":"text"},{"text":"threads to be woken up.","type":"text"}],"url":"\/documentation\/glib\/cond"},"doc://GLib/documentation/GLib":{"identifier":"doc:\/\/GLib\/documentation\/GLib","title":"GLib","abstract":[],"type":"topic","url":"\/documentation\/glib","kind":"symbol","role":"collection"},"doc://GLib/documentation/GLib/CondProtocol/waitUntil(mutex:endTime:)":{"title":"waitUntil(mutex:endTime:)","fragments":[{"text":"func","kind":"keyword"},{"text":" ","kind":"text"},{"text":"waitUntil","kind":"identifier"},{"text":"<","kind":"text"},{"kind":"genericParameter","text":"MutexT"},{"kind":"text","text":">("},{"text":"mutex","kind":"externalParam"},{"text":": ","kind":"text"},{"kind":"typeIdentifier","text":"MutexT"},{"kind":"text","text":", "},{"kind":"externalParam","text":"endTime"},{"text":": ","kind":"text"},{"text":"gint64","kind":"typeIdentifier","preciseIdentifier":"c:@T@gint64"},{"text":") -> ","kind":"text"},{"kind":"typeIdentifier","preciseIdentifier":"s:Sb","text":"Bool"}],"role":"symbol","kind":"symbol","abstract":[{"type":"text","text":"Waits until either "},{"type":"codeVoice","code":"cond"},{"text":" is signalled or ","type":"text"},{"code":"endTime","type":"codeVoice"},{"text":" has passed.","type":"text"}],"type":"topic","identifier":"doc:\/\/GLib\/documentation\/GLib\/CondProtocol\/waitUntil(mutex:endTime:)","url":"\/documentation\/glib\/condprotocol\/waituntil(mutex:endtime:)"},"doc://GLib/documentation/GLib/CondProtocol":{"role":"symbol","type":"topic","abstract":[{"text":"The ","type":"text"},{"isActive