curred, then "},{"code":"NULL","type":"codeVoice"},{"type":"text","text":" "},{"type":"text","text":"is returned."}],"type":"paragraph"},{"inlineContent":[{"text":"Note: it is possible to have a valid zero-size region. In this case,","type":"text"},{"text":" ","type":"text"},{"type":"text","text":"the returned pointer will be equal to the base pointer of the data of"},{"type":"text","text":" "},{"type":"codeVoice","code":"bytes"},{"text":", plus ","type":"text"},{"code":"offset","type":"codeVoice"},{"type":"text","text":".  This will be non-"},{"type":"codeVoice","code":"NULL"},{"type":"text","text":" except for the case"},{"type":"text","text":" "},{"type":"text","text":"where "},{"type":"codeVoice","code":"bytes"},{"type":"text","text":" itself was a zero-sized region.  Since it is unlikely"},{"type":"text","text":" "},{"type":"text","text":"that you will be using this function to check for a zero-sized region"},{"type":"text","text":" "},{"text":"in a zero-sized ","type":"text"},{"code":"bytes","type":"codeVoice"},{"text":", ","type":"text"},{"type":"codeVoice","code":"NULL"},{"text":" effectively always means ‘error’.","type":"text"}],"type":"paragraph"}],"kind":"content"}],"kind":"symbol","references":{"doc://GLib/documentation/GLib/BytesProtocol":{"fragments":[{"text":"protocol","kind":"keyword"},{"kind":"text","text":" "},{"text":"BytesProtocol","kind":"identifier"}],"kind":"symbol","abstract":[{"type":"text","text":"A simple reference counted data type representing an immutable sequence of"},{"text":" ","type":"text"},{"text":"zero or more bytes from an unspecified origin.","type":"text"}],"type":"topic","title":"BytesProtocol","navigatorTitle":[{"kind":"identifier","text":"BytesProtocol"}],"role":"symbol","identifier":"doc:\/\/GLib\/documentation\/GLib\/BytesProtocol","url":"\/documentation\/glib\/bytesprotocol"},"doc://GLib/documentation/GLib":{"identifier":"doc:\/\/GLib\/documentation\/GLib","title":"GLib","abstract":[],"type":"topic","url":"\/documentati