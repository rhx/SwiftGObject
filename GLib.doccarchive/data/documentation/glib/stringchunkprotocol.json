{"identifier":{"url":"doc:\/\/GLib\/documentation\/GLib\/StringChunkProtocol","interfaceLanguage":"swift"},"sections":[],"hierarchy":{"paths":[["doc:\/\/GLib\/documentation\/GLib"]]},"topicSections":[{"identifiers":["doc:\/\/GLib\/documentation\/GLib\/StringChunkProtocol\/clear()","doc:\/\/GLib\/documentation\/GLib\/StringChunkProtocol\/free()","doc:\/\/GLib\/documentation\/GLib\/StringChunkProtocol\/insert(string:)","doc:\/\/GLib\/documentation\/GLib\/StringChunkProtocol\/insertConst(string:)","doc:\/\/GLib\/documentation\/GLib\/StringChunkProtocol\/insertLen(string:len:)"],"title":"Instance Methods","generated":true,"anchor":"Instance-Methods"}],"relationshipsSections":[{"title":"Inherits From","identifiers":["doc:\/\/GLib\/documentation\/GLib\/PointerWrapper"],"type":"inheritsFrom","kind":"relationships"},{"title":"Conforming Types","identifiers":["doc:\/\/GLib\/documentation\/GLib\/StringChunk","doc:\/\/GLib\/documentation\/GLib\/StringChunkRef"],"type":"conformingTypes","kind":"relationships"}],"primaryContentSections":[{"kind":"declarations","declarations":[{"tokens":[{"text":"protocol","kind":"keyword"},{"text":" ","kind":"text"},{"text":"StringChunkProtocol","kind":"identifier"},{"text":" : ","kind":"text"},{"preciseIdentifier":"s:4GLib14PointerWrapperP","identifier":"doc:\/\/GLib\/documentation\/GLib\/PointerWrapper","kind":"typeIdentifier","text":"PointerWrapper"}],"languages":["swift"],"platforms":["macOS"]}]},{"kind":"content","content":[{"anchor":"overview","text":"Overview","level":2,"type":"heading"},{"type":"paragraph","inlineContent":[{"text":"String chunks are used to store groups of strings. Memory is","type":"text"},{"type":"text","text":" "},{"text":"allocated in blocks, and as strings are added to the ","type":"text"},{"code":"GStringChunk","type":"codeVoice"},{"type":"text","text":" "},{"type":"text","text":"they are copied into the next free position in a block. When a block"},{"type":"text","text":" "},{"text":"is full a new block is allocated.","type":"text"}]},{"inlineContent":[{"type":"text","text":"When storing a large number of strings, string chunks are more"},{"text":" ","type":"text"},{"type":"text","text":"efficient than using [func"},{"type":"codeVoice","code":"GLib.strdup"},{"text":"] since fewer calls to ","type":"text"},{"type":"codeVoice","code":"malloc()"},{"type":"text","text":" "},{"text":"are needed, and less memory is wasted in memory allocation overheads.","type":"text"}],"type":"paragraph"},{"type":"paragraph","inlineContent":[{"text":"By adding strings with [method","type":"text"},{"type":"codeVoice","code":"GLib.StringChunk.insert_const"},{"type":"text","text":"] it is also"},{"type":"text","text":" "},{"text":"possible to remove duplicates.","type":"text"}]},{"type":"paragraph","inlineContent":[{"text":"To create a new ","type":"text"},{"type":"codeVoice","code":"GStringChunk"},{"type":"text","text":" use [func"},{"type":"codeVoice","code":"GLib.StringChunk.new"},{"text":"].","type":"text"}]},{"inlineContent":[{"text":"To add strings to a ","type":"text"},{"type":"codeVoice","code":"GStringChunk"},{"text":" use [method","type":"text"},{"code":"GLib.StringChunk.insert","type":"codeVoice"},{"type":"text","text":"]."}],"type":"paragraph"},{"inlineContent":[{"type":"text","text":"To add strings to a "},{"type":"codeVoice","code":"GStringChunk"},{"type":"text","text":", but without duplicating strings"},{"type":"text","text":" "},{"type":"text","text":"which are already in the "},{"code":"GStringChunk","type":"codeVoice"},{"type":"text","text":", use [method"},{"code":"GLib.StringChunk.insert_const","type":"codeVoice"},{"text":"].","type":"text"}],"type":"paragraph"},{"type":"paragraph","inlineContent":[{"type":"text","text":"To free the entire "},{"type":"codeVoice","code":"GStringChunk"},{"type":"text","text":" use [method"},{"code":"GLib.StringChunk.free","type":"codeVoice"},{"text":"].","type":"text"},{"text":" ","type":"text"},{"text":"It is not possible to free individual strings.","type":"text"}]},{"type":"paragraph","inlineContent":[{"text":"The ","type":"text"},{"identifier":"doc:\/\/GLib\/documentation\/GLib\/StringChunkProtocol","isActive":true,"type":"reference"},{"type":"text","text":" protocol exposes the methods and properties of an underlying "},{"code":"GStringChunk","type":"codeVoice"},{"type":"text","text":" instance."},{"type":"text","text":" "},{"text":"The default implementation of these can be found in the protocol extension below.","type":"text"},{"type":"text","text":" "},{"text":"For a concrete class that implements these methods and properties, see ","type":"text"},{"isActive":true,"identifier":"doc:\/\/GLib\/documentation\/GLib\/StringChunk","type":"reference"},{"text":".","type":"text"},{"text":" ","type":"text"},{"type":"text","text":"Alternatively, use "},{"identifier":"doc:\/\/GLib\/documentation\/GLib\/StringChunkRef","isActive":true,"type":"reference"},{"text":" as a lighweight, ","type":"text"},{"type":"codeVoice","code":"unowned"},{"type":"text","text":" reference if you already have an instance you just want to use."}]}]}],"schemaVersion":{"major":0,"patch":0,"minor":3},"metadata":{"navigatorTitle":[{"text":"StringChunkProtocol","kind":"identifier"}],"title":"StringChunkProtocol","roleHeading":"Protocol","symbolKind":"protocol","fragments":[{"kind":"keyword","text":"protocol"},{"text":" ","kind":"text"},{"text":"StringChunkProtocol","kind":"identifier"}],"modules":[{"name":"GLib"}],"externalID":"s:4GLib19StringChunkProtocolP","role":"symbol"},"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/glib\/stringchunkprotocol"]}],"kind":"symbol","abstract":[{"type":"codeVoice","code":"GStringChunk"},{"text":" provides efficient storage of groups of strings","type":"text"}],"references":{"doc://GLib/documentation/GLib":{"identifier":"doc:\/\/GLib\/documentation\/GLib","title":"GLib","abstract":[],"type":"topic","url":"\/documentation\/glib","kind":"symbol","role":"collection"},"doc://GLi