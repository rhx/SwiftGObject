{"relationshipsSections":[{"title":"Conforms To","type":"conformsTo","kind":"relationships","identifiers":["doc:\/\/GLib\/documentation\/GLib\/IOChannelProtocol","doc:\/\/GLib\/documentation\/GLib\/PointerWrapper"]}],"primaryContentSections":[{"declarations":[{"platforms":["macOS"],"languages":["swift"],"tokens":[{"text":"struct","kind":"keyword"},{"kind":"text","text":" "},{"kind":"identifier","text":"IOChannelRef"}]}],"kind":"declarations"},{"content":[{"level":2,"type":"heading","anchor":"overview","text":"Overview"},{"type":"paragraph","inlineContent":[{"text":"To create a new ","type":"text"},{"code":"GIOChannel","type":"codeVoice"},{"type":"text","text":" on UNIX systems use"},{"type":"text","text":" "},{"text":"[ctor","type":"text"},{"code":"GLib.IOChannel.unix_new","type":"codeVoice"},{"text":"]. This works for plain file descriptors,","type":"text"},{"text":" ","type":"text"},{"type":"text","text":"pipes and sockets. Alternatively, a channel can be created for a"},{"type":"text","text":" "},{"type":"text","text":"file in a system independent manner using [ctor"},{"type":"codeVoice","code":"GLib.IOChannel.new_file"},{"text":"].","type":"text"}]},{"inlineContent":[{"type":"text","text":"Once a "},{"type":"codeVoice","code":"GIOChannel"},{"type":"text","text":" has been created, it can be used in a generic"},{"text":" ","type":"text"},{"text":"manner with the functions [method","type":"text"},{"type":"codeVoice","code":"GLib.IOChannel.read_chars"},{"text":"],","type":"text"},{"type":"text","text":" "},{"type":"text","text":"[method"},{"type":"codeVoice","code":"GLib.IOChannel.write_chars"},{"text":"], [method","type":"text"},{"type":"codeVoice","code":"GLib.IOChannel.seek_position"},{"text":"],","type":"text"},{"text":" ","type":"text"},{"text":"and [method","type":"text"},{"type":"codeVoice","code":"GLib.IOChannel.shutdown"},{"type":"text","text":"]."}],"type":"paragraph"},{"type":"paragraph","inlineContent":[{"text":"To add a ","type":"text"},{"type":"codeVoice","code":"GIOChannel"},{"type":"text","text":" to the main event loop, use [func"},{"type":"codeVoice","code":"GLib.io_add_watch"},{"type":"text","text":"] or"},{"text":" ","type":"text"},{"type":"text","text":"[func"},{"type":"codeVoice","code":"GLib.io_add_watch_full"},{"type":"text","text":"]. Here you specify which events you are"},{"text":" ","type":"text"},{"type":"text","text":"interested in on the "},{"code":"GIOChannel","type":"codeVoice"},{"type":"text","text":", and provide a function to be called"},{"type":"text","text":" "},{"text":"whenever these events occur.","type":"text"}]},{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"GIOChannel"},{"text":" instances are created with an initial reference count of 1.","type":"text"},{"type":"text","text":" "},{"text":"[method","type":"text"},{"type":"codeVoice","code":"GLib.IOChannel.ref"},{"text":"] and [method","type":"text"},{"type":"codeVoice","code":"GLib.IOChannel.unref"},{"text":"] can be used to","type":"text"},{"text":" ","type":"text"},{"text":"increment or decrement the reference count respectively. When the","type":"text"},{"text":" ","type":"text"},{"type":"text","text":"reference count falls to 0, the "},{"type":"codeVoice","code":"GIOChannel"},{"text":" is freed. (Though it","type":"text"},{"type":"text","text":" "},{"type":"text","text":"isn’t closed automatically, unless it was created using"},{"type":"text","text":" "},{"text":"[ctor","type":"text"},{"code":"GLib.IOChannel.new_file","type":"codeVoice"},{"type":"text","text":"].) Using [func"},{"type":"codeVoice","code":"GLib.io_add_watch"},{"type":"text","text":"] or"},{"text":" ","type":"text"},{"type":"text","text":"[func"},{"code":"GLib.io_add_watch_full","type":"codeVoice"},{"text":"] increments a channel’s reference count.","type":"text"}]},{"type":"paragraph","inlineContent":[{"text":"The new functions [method","type":"text"},{"code":"GLib.IOChannel.read_chars","type":"codeVoice"},{"type":"text","text":"],"},{"type":"te