{"abstract":[{"type":"text","text":"Creates a new child watch source."}],"sections":[],"kind":"symbol","primaryContentSections":[{"kind":"declarations","declarations":[{"platforms":["macOS"],"languages":["swift"],"tokens":[{"text":"func","kind":"keyword"},{"kind":"text","text":" "},{"kind":"identifier","text":"childWatchSourceNew"},{"kind":"text","text":"("},{"kind":"externalParam","text":"pid"},{"kind":"text","text":": "},{"preciseIdentifier":"c:@T@GPid","kind":"typeIdentifier","text":"GPid"},{"text":") -> ","kind":"text"},{"text":"SourceRef","kind":"typeIdentifier","preciseIdentifier":"s:4GLib9SourceRefV","identifier":"doc:\/\/GLib\/documentation\/GLib\/SourceRef"},{"kind":"text","text":"!"}]}]},{"content":[{"text":"Discussion","type":"heading","anchor":"discussion","level":2},{"inlineContent":[{"type":"text","text":"The source will not initially be associated with any"},{"type":"text","text":" "},{"type":"text","text":"[struct"},{"identifier":"doc:\/\/GLib\/documentation\/GLib\/MainContext","type":"reference","isActive":true},{"text":"] and must be added to one with","type":"text"},{"text":" ","type":"text"},{"type":"text","text":"[method"},{"code":"GLib.Source.attach","type":"codeVoice"},{"text":"] before it will be executed.","type":"text"}],"type":"paragraph"},{"type":"paragraph","inlineContent":[{"type":"text","text":"Note that child watch sources can only be used in conjunction with"},{"type":"text","text":" "},{"code":"g_spawn...","type":"codeVoice"},{"type":"text","text":" when the [flags"},{"code":"GLib.SpawnFlags.DO_NOT_REAP_CHILD","type":"codeVoice"},{"text":"] flag is used.","type":"text"}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"Note that on platforms where [type"},{"isActive":true,"type":"reference","identifier":"doc:\/\/GLib\/documentation\/GLib\/Pid"},{"type":"text","text":"] must be explicitly closed"},{"text":" ","type":"text"},{"text":"(see [func","type":"text"},{"type":"codeVoice","code":"GLib.spawn_close_pid"},{"text":"]) ","type":"text"},{"type":"codeVoice","code":"pid"},{"type":"text","text":" must not be closed while the"},{"type":"text","text":" "},{"type":"text","text":"source is still active. Typically, you will want to call"},{"type":"text","text":" "},{"type":"text","text":"[func"},{"type":"codeVoice","code":"GLib.spawn_close_pid"},{"type":"text","text":"] in the callback function for the source."}]},{"inlineContent":[{"type":"text","text":"On POSIX platforms, the following restrictions apply to this API"},{"type":"text","text":" "},{"type":"text","text":"due to limitations in POSIX process interfaces:"}],"type":"paragraph"},{"type":"unorderedList","items":[{"content":[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"pid"},{"type":"text","text":" must be a child of this process."}]}]},{"content":[{"type":"paragraph","inlineContent":[{"code":"pid","type":"codeVoice"},{"text":" must be positive.","type":"text"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"text":"The application must not call ","type":"text"},{"isActive":true,"type":"reference","identifier":"man:waitpid(1)"},{"type":"text","text":" with a"},{"type":"text","text":" "},{"type":"text","text":"non-positive first argument, for instance in another thread."}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"The application must not wait for "},{"type":"codeVoice","code":"pid"},{"text":" to exit by any other","type":"text"},{"text":" ","type":"text"},{"type":"text","text":"mechanism, including "},{"type":"codeVoice","code":"waitpid(pid, ...)"},{"type":"text","text":" or a second child-watch"},{"type":"text","text":" "},{"text":"source for the same ","type":"text"},{"code":"pid","type":"codeVoice"},{"type":"text","text":"."}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"The application must not ignore "},{"code":"SIGCHLD","type":"codeVoice"},{"type":"text","text":"."}]}]},{"content":[{"type":"paragraph","inlineContent":[{"text":"Before 2.78, the application could not send a signal (","type":"text"},{"type":"reference","isActive":true,"identifier":"man:kill(2)"},{"type":"text","text":") to the"},{"type":"text","text":" "},{"type":"text","text":"watched "},{"type":"codeVoice","code":"pid"},{"text":" in a race free manner. Since 2.78, you can do that while the","type":"text"},{"type":"text","text":" "},{"text":"associated [struct","type":"text"},{"isActive":true,"identifier":"doc:\/\/GLib\/documentation\/GLib\/MainContext","type":"reference"},{"type":"text","text":"] is acquired."}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"Before 2.78, even after destroying the [struct"},{"type":"reference","isActive":true,"identifier":"doc:\/\/GLib\/documentation\/GLib\/Source"},{"text":"], you could not","type":"text"},{"type":"text","text":" "},{"text":"be sure that ","type":"text"},{"type":"codeVoice","code":"pid"},{"type":"text","text":" wasn’t already reaped. Hence, it was also not"},{"type":"text","text":" "},{"type":"text","text":"safe to "},{"code":"kill()","type":"codeVoice"},{"text":" or ","type":"text"},{"type":"codeVoice","code":"waitpid()"},{"type":"text","text":" on the process ID after the child watch"},{"type":"text","text":" "},{"type":"text","text":"source was gone. Destroying the source before it fired made it"},{"type":"text","text":" "},{"type":"text","text":"impossible to reliably reap the process."}]}]}]},{"inlineContent":[{"text":"If any of those conditions are not met, this and related APIs will","type":"text"},{"type":"text","text":" "},{"text":"not work correctly. This can often be diagnosed via a GLib warning","type":"text"},{"type":"text","text":" "},{"text":"stating that ","type":"text"},{"code":"ECHILD","type":"codeVoice"},{"text":" was received by ","type":"text"},{"type":"codeVoice","code":"waitpid()"},{"type":"text","text":"."}],"type":"paragraph"},{"inlineContent":[{"type":"text","text":"Calling "},{"isActive":true,"identifier":"man:waitpid(2)","type":"reference"},{"text":" for specific processes other than ","type":"text"},{"code":"pid","type":"codeVoice"},{"type":"text","text":" "},{"type":"text","text":"remains a valid thing to do."}],"type":"paragraph"}],"kind":"content"}],"variants":[{"paths":["\/documentation\/glib\/childwatchsourcenew(pid:)"],"traits":[{"interfaceLanguage":"swift"}]}],"metadata":{"role":"symbol","symbolKind":"func","modules":[{"name":"GLib"}],"roleHeading":"Function","externalID":"s:4GLib19childWatchSourceNew3pidAA0D3RefVSgs5Int32V_tF","fragments":[{"kind":"keyword","text":"func"},{"text":" ","kind":"text"},{"text":"childWatchSourceNew","kind":"identifier"},{"kind":"text","text":"("},{"kind":"externalParam","text":"pid"},{"text":": ","kind":"text"},{"kind":"typeIdentifier","preciseIdentifier":"c:@T@GPid","text":"GPid"},{"text":") -> ","kind":"text"},{"kind":"typeIdentifier","preciseIdentifier":"s:4GLib9SourceRefV","text":"SourceRef"},{"kind":"text","text":"!"}],"title":"childWatchSourceNew(pid:)"},"identifier":{"interfaceLanguage":"swift","url":"doc:\/\/GLib\/documentation\/GLib\/childWatchSourceNew(pid:)"},"hierarchy":{"paths":[["doc:\/\/GLib\/documentation\/GLib"]]},"schemaVersion":{"major":0,"minor":3,"patch":0},"references":{"doc://GLib/documentation/GLib/Source":{"url":"\/documentation\/glib\/source","role":"symbol","abstract":[{"type":"text","text":"The "},{"type":"codeVoice","code":"GSource"},{"text":" struct is an opaque data type","type":"text"},{"text":" ","type":"text"},{"text":"representing an event source.","type":"text"}],"title":"Source","fragments":[{"text":"class","kind":"keyword"},{"kind":"text","text":" "},{"kind":"identifier","text":"Source"}],"type":"topic","kind":"symbol","identifier":"doc:\/\/GLib\/documentation\/GLib\/Source","navigatorTitle":[{"kind":"identifier","text":"Source"}]},"man:waitpid(1)":{"url":"man:waitpid(1)","type":"link","title":"waitpid()","titleInlineContent":[{"code":"waitpid()","type":"codeVoice"}],"identifier":"man:waitpid(1)"},"doc://GLib/docum