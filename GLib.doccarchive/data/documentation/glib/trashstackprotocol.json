ass that implements these methods and properties, see ","type":"text"},{"isActive":true,"identifier":"doc:\/\/GLib\/documentation\/GLib\/TrashStack","type":"reference"},{"type":"text","text":"."},{"type":"text","text":" "},{"type":"text","text":"Alternatively, use "},{"isActive":true,"type":"reference","identifier":"doc:\/\/GLib\/documentation\/GLib\/TrashStackRef"},{"type":"text","text":" as a lighweight, "},{"code":"unowned","type":"codeVoice"},{"text":" reference if you already have an instance you just want to use.","type":"text"}],"type":"paragraph"}]}],"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/glib\/trashstackprotocol"]}],"topicSections":[{"anchor":"Instance-Properties","title":"Instance Properties","generated":true,"identifiers":["doc:\/\/GLib\/documentation\/GLib\/TrashStackProtocol\/next"]}],"relationshipsSections":[{"identifiers":["doc:\/\/GLib\/documentation\/GLib\/PointerWrapper"],"kind":"relationships","title":"Inherits From","type":"inheritsFrom"},{"title":"Conforming Types","identifiers":["doc:\/\/GLib\/documentation\/GLib\/TrashStack","doc:\/\/GLib\/documentation\/GLib\/TrashStackRef"],"type":"conformingTypes","kind":"relationships"}],"hierarchy":{"paths":[["doc:\/\/GLib\/documentation\/GLib"]]},"sections":[],"metadata":{"fragments":[{"kind":"keyword","text":"protocol"},{"kind":"text","text":" "},{"text":"TrashStackProtocol","kind":"identifier"}],"symbolKind":"protocol","modules":[{"name":"GLib"}],"roleHeading":"Protocol","title":"TrashStackProtocol","navigatorTitle":[{"kind":"identifier","text":"TrashStackProtocol"}],"externalID":"s:4GLib18TrashStackProtocolP","role":"symbol"},"identifier":{"interfaceLanguage":"swift","url":"doc:\/\/GLib\/documentation\/GLib\/TrashStackProtocol"},"abstract":[{"text":"A ","type":"text"},{"type":"codeVoice","code":"GTrashStack"},{"text":" is an efficient way to keep a stack of unused allocated","type":"text"},{"type":"text","text":" "},{"type":"text","text":"memory chunks. Each m