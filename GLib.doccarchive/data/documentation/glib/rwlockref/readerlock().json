{"hierarchy":{"paths":[["doc:\/\/GLib\/documentation\/GLib","doc:\/\/GLib\/documentation\/GLib\/RWLockRef","doc:\/\/GLib\/documentation\/GLib\/RWLockRef\/RWLockProtocol-Implementations"]]},"schemaVersion":{"major":0,"minor":3,"patch":0},"abstract":[{"type":"text","text":"Obtain a read lock on "},{"code":"rwLock","type":"codeVoice"},{"type":"text","text":". If another thread currently holds"},{"type":"text","text":" "},{"text":"the write lock on ","type":"text"},{"type":"codeVoice","code":"rwLock"},{"type":"text","text":", the current thread will block until the"},{"text":" ","type":"text"},{"text":"write lock was (held and) released. If another thread does not hold","type":"text"},{"type":"text","text":" "},{"type":"text","text":"the write lock, but is waiting for it, it is implementation defined"},{"type":"text","text":" "},{"text":"whether the reader or writer will block. Read locks can be taken","type":"text"},{"type":"text","text":" "},{"type":"text","text":"recursively."}],"sections":[],"metadata":{"extendedModule":"GLib","title":"readerLock()","fragments":[{"kind":"keyword","text":"func"},{"kind":"text","text":" "},{"kind":"identifier","text":"readerLock"},{"kind":"text","text":"()"}],"role":"symbol","modules":[{"name":"GLib"}],"externalID":"s:4GLib14RWLockProtocolPAAE10readerLockyyF::SYNTHESIZED::s:4GLib9RWLockRefV","roleHeading":"Instance Method","symbolKind":"method"},"kind":"symbol","identifier":{"interfaceLanguage":"swift","url":"doc:\/\/GLib\/documentation\/GLib\/RWLockRef\/readerLock()"},"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/glib\/rwlockref\/readerlock()"]}],"primaryContentSections":[{"kind":"declarations","declarations":[{"languages":["swift"],"platforms":["macOS"],"tokens":[{"text":"func","kind":"keyword"},{"text":" ","kind":"text"},{"text":"readerLock","kind":"identifier"},{"text":"()","kind":"text"}]}]},{"kind":"content","content":[{"anchor":"discussion","type":"heading","text":"Discussion","level":2},{"type":"paragraph","inlineContent":[{"type":"text","text":"Calling "},{"type":"codeVoice","code":"g_rw_lock_reader_lock()"},{"type":"text","text":" while the current thread already"},{"text":" ","type":"text"},{"text":"owns a write lock leads to undefined behaviour. Read locks however","type":"text"},{"type":"text","text":" "},{"type":"text","text":"can be taken recursively, in which case you need to make sure to"},{"type":"text","text":" "},{"text":"call ","type":"text"},{"type":"codeVoice","code":"g_rw_lock_reader_unlock()"},{"type":"text","text":" the same amount of times."}]},{"inlineContent":[{"type":"text","text":"It is implementation-defined how many read locks are allowed to be"},{"type":"text","text":" "},{"type":"text","text":"held on the same lock simultaneously. If the limit is hit,"},{"text":" ","type":"text"},{"text":"or if a deadlock is detected, a critical warning will be emitted.","type":"text"}],"type":"paragraph"}]}],"references":{"doc://GLib/documentation/GLib/RWLockRef":{"title":"RWLockRef","kind":"symbol","type":"topic","role":"symbol","abstract":[{"text":"The GRWLock struct is an opaque data structure to represent a","type":"text"},{"text":" ","type":"text"},{"type":"text","text":"reader-writer lock. It is similar to a "},{"isActive":true,"type":"reference","identifier":"doc:\/\/GLib\/documentation\/GLib\/Mutex"},{"type":"text","text":" in that it allows"},{"text":" ","type":"text"},{"text":"multiple threads to coordinate access to a shared resource.","type":"text"}],"url":"\/documentation\/glib\/rwlockref","identifier":"doc:\/\/GLib\/documentation\/GLib\/RWLockRef","fragments":[{"kind":"keyword","text":"struct"},{"text":" ","kind":"text"},{"text":"RWLockRef","kind":"identifier"}],"navigatorTitle":[{"text":"RWLockRef","kind":"identifier"}]},"doc://GLib/documentation/GLib/RWLockRef/RWLockProtocol-Implementations":{"identifier":"doc:\/\/GLib\/documentation\/GLib\/RWLockRef\/RWLockProtocol-Implementations","abstract":[],"kind":"article","title":"RWLockProtocol Implementations","url":"\/documentation\/glib\/rwlockref\/rwlockprotocol-implementations","role":"collectionGroup","type":"topic"},"doc://GLib/documentation/GLib":{"identifier":"doc:\/\/GLib\/documentation\/GLib","title":"GLib","abstract":[],"type":"topic","url":"\/documentation\/glib","kind":"symbol","role":"collection"},"doc://GLib/documentation/GLib/RWLockRef/readerLock()":{"abstract":[{"type":"text","text":"Obtain a read lock on "},{"code":"rwLock","type":"codeVoice"},{"text":". If another thread currently holds","type":"text"},{"text":" ","type":"text"},{"type":"text","text":"the write lock on "},{"type":"codeVoice","code":"rwLock"},{"type":"text","text":", the current thread will block until the"},{"type":"text","text":" "},{"type":"text","text":"write lock was (held and) released. If another thread does not hold"},{"type":"text","text":" "},{"text":"the write lock, but is waiting for it, it is implementation defined","type":"text"},{"type":"text","text":" "},{"type":"text","text":"whether the reader or writer will block. Read locks can be taken"},{"type":"text","text":" "},{"text":"recursively.","type":"text"}],"type":"topic","kind":"symbol","role":"symbol","identifier":"doc:\/\/GLib\/documentation\/GLib\/RWLockRef\/readerLock()","title":"readerLock()","url":"\/documentation\/glib\/rwlockref\/readerlock()","fragments":[{"text":"func","kind":"keyword"},{"text":" ","kind":"text"},{"text":"readerLock","kind":"identifier"},{"text":"()","kind":"text"}]},"doc://GLib/documentation/GLib/Mutex":{"abstract":[{"type":"text","text":"The "},{"isActive":true,"type":"reference","identifier":"doc:\/\/GLib\/documentation\/GLib\/Mutex"},{"type":"text","text":" struct is an opaque data structure to represent a mutex"},{"type":"text","text":" "},{"text":"(mutual exclusion). It can be used to protect data against shared","type":"text"},{"type":"text","text":" "},{"type":"text","text":"access."}],"fragments":[{"text":"class","kind":"keyword"},{"kind":"text","text":" "},{"text":"Mutex","kind":"identifier"}],"navigatorTitle":[{"text":"Mutex","kind":"identifier"}],"kind":"symbol","type":"topic","role":"symbol","title":"Mutex","identifier":"doc:\/\/GLib\/documentation\/GLib\/Mutex","url":"\/documentation\/glib\/mutex"}}}