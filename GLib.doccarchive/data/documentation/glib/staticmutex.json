{"sections":[],"metadata":{"externalID":"s:4GLib11StaticMutexC","fragments":[{"kind":"keyword","text":"class"},{"kind":"text","text":" "},{"text":"StaticMutex","kind":"identifier"}],"modules":[{"name":"GLib"}],"roleHeading":"Class","role":"symbol","navigatorTitle":[{"text":"StaticMutex","kind":"identifier"}],"title":"StaticMutex","symbolKind":"class"},"kind":"symbol","identifier":{"url":"doc:\/\/GLib\/documentation\/GLib\/StaticMutex","interfaceLanguage":"swift"},"topicSections":[{"generated":true,"title":"Initializers","identifiers":["doc:\/\/GLib\/documentation\/GLib\/StaticMutex\/init(_:)-30gyb","doc:\/\/GLib\/documentation\/GLib\/StaticMutex\/init(_:)-5ndjt","doc:\/\/GLib\/documentation\/GLib\/StaticMutex\/init(_:)-6lhvr","doc:\/\/GLib\/documentation\/GLib\/StaticMutex\/init(_:)-7apmz","doc:\/\/GLib\/documentation\/GLib\/StaticMutex\/init(_:)-8rbuv","doc:\/\/GLib\/documentation\/GLib\/StaticMutex\/init(cPointer:)","doc:\/\/GLib\/documentation\/GLib\/StaticMutex\/init(gconstpointer:)","doc:\/\/GLib\/documentation\/GLib\/StaticMutex\/init(gpointer:)","doc:\/\/GLib\/documentation\/GLib\/StaticMutex\/init(opaquePointer:)","doc:\/\/GLib\/documentation\/GLib\/StaticMutex\/init(raw:)-1nyk4","doc:\/\/GLib\/documentation\/GLib\/StaticMutex\/init(raw:)-5it8v","doc:\/\/GLib\/documentation\/GLib\/StaticMutex\/init(retaining:)","doc:\/\/GLib\/documentation\/GLib\/StaticMutex\/init(retainingCPointer:)","doc:\/\/GLib\/documentation\/GLib\/StaticMutex\/init(retainingOpaquePointer:)","doc:\/\/GLib\/documentation\/GLib\/StaticMutex\/init(retainingRaw:)-290rd","doc:\/\/GLib\/documentation\/GLib\/StaticMutex\/init(retainingRaw:)-8drmn"],"anchor":"Initializers"},{"generated":true,"identifiers":["doc:\/\/GLib\/documentation\/GLib\/StaticMutex\/ptr"],"title":"Instance Properties","anchor":"Instance-Properties"},{"generated":true,"title":"Default Implementations","identifiers":["doc:\/\/GLib\/documentation\/GLib\/StaticMutex\/StaticMutexProtocol-Implementations"],"anchor":"Default-Implementations"}],"relationshipsSections":[{"identifiers":["doc:\/\/GLib\/documentation\/GLib\/PointerWrapper","doc:\/\/GLib\/documentation\/GLib\/StaticMutexProtocol"],"title":"Conforms To","kind":"relationships","type":"conformsTo"}],"schemaVersion":{"minor":3,"major":0,"patch":0},"abstract":[{"text":"A ","type":"text"},{"identifier":"doc:\/\/GLib\/documentation\/GLib\/StaticMutex","isActive":true,"type":"reference"},{"type":"text","text":" works like a "},{"type":"reference","isActive":true,"identifier":"doc:\/\/GLib\/documentation\/GLib\/Mutex"},{"text":".","type":"text"}],"variants":[{"paths":["\/documentation\/glib\/staticmutex"],"traits":[{"interfaceLanguage":"swift"}]}],"hierarchy":{"paths":[["doc:\/\/GLib\/documentation\/GLib"]]},"primaryContentSections":[{"declarations":[{"platforms":["macOS"],"tokens":[{"kind":"keyword","text":"class"},{"text":" ","kind":"text"},{"kind":"identifier","text":"StaticMutex"}],"languages":["swift"]}],"kind":"declarations"},{"content":[{"text":"Overview","level":2,"type":"heading","anchor":"overview"},{"type":"paragraph","inlineContent":[{"text":"Prior to GLib 2.32, GStaticMutex had the significant advantage","type":"text"},{"text":" ","type":"text"},{"type":"text","text":"that it doesn’t need to be created at run-time, but can be defined"},{"type":"text","text":" "},{"type":"text","text":"at compile-time. Since 2.32, "},{"identifier":"doc:\/\/GLib\/documentation\/GLib\/Mutex","type":"reference","isActive":true},{"text":" can be statically allocated","type":"text"},{"text":" ","type":"text"},{"type":"text","text":"as well, and GStaticMutex has been deprecated."}]},{"inlineContent":[{"type":"text","text":"Here is a version of our "},{"code":"give_me_next_number()","type":"codeVoice"},{"type":"text","text":" example using"},{"text":" ","type":"text"},{"text":"a GStaticMutex:","type":"text"}],"type":"paragraph"},{"syntax":null,"type":"codeListing","code":["  int","  give_me_next_number (void)","  {","    static int current_number = 0;","    int ret_val;","    static GStaticMutex mutex = G_STATIC_MUTEX_INIT;","","    g_static_mutex_lock (&mutex);","    ret_val = current_number = calc_next_number (current_number);","    g_static_mutex_unlock (&mutex);","","    return ret_val;","  }"]},{"inlineContent":[{"type":"text","text":"Sometimes you would like to dynamically create a mutex. If you don’t"},{"type":"text","text":" "},{"type":"text","text":"want to require prior calling to "},{"type":"codeVoice","code":"g_thread_init()"},{"text":", because your code","type":"text"},{"text":" ","type":"text"},{"text":"should also be usable in non-threaded programs, you are not able to","type":"text"},{"text":" ","type":"text"},{"type":"text","text":"use "},{"type":"codeVoice","code":"g_mutex_new()"},{"text":" and thus ","type":"text"},{"isActive":true,"type":"reference","identifier":"doc:\/\/GLib\/documentation\/GLib\/Mutex"},{"type":"text","text":", as that requires a prior call to"},{"text":" ","type":"text"},{"type":"codeVoice","code":"g_thread_init()"},{"type":"text","text":". In these cases you can also use a "},{"isActive":true,"type":"reference","identifier":"doc:\/\/GLib\/documentation\/GLib\/StaticMutex"},{"type":"text","text":"."},{"text":" ","type":"text"},{"text":"It must be initialized with ","type":"text"},{"type":"codeVoice","code":"g_static_mutex_init()"},{"type":"text","text":" before using it"},{"text":" ","type":"text"},{"text":"and freed with with ","type":"text"},{"type":"codeVoice","code":"g_static_mutex_free()"},{"type":"text","text":" when not needed anymore to"},{"type":"text","text":" "},{"text":"free up any allocated resources.","type":"text"}],"type":"paragraph"},{"type":"paragraph","inlineContent":[{"type":"text","text":"Even though "},{"isActive":true,"type":"reference","identifier":"doc:\/\/GLib\/documentation\/GLib\/StaticMutex"},{"type":"text","text":" is not opaque, it should only be used with"},{"text":" ","type":"text"},{"type":"text","text":"the following functions, as it is defined differently on different"},{"text":" ","type":"text"},{"type":"text","text":"platforms."}]},{"inlineContent":[{"type":"text","text":"All of the g_static_mutex_* functions apart from"},{"type":"text","text":" "},{"code":"g_static_mutex_get_mutex()","type":"codeVoice"},{"text":" can also be used even if ","type":"text"},{"code":"g_thread_init()","type":"codeVoice"},{"type":"text","text":" "},{"type":"text","text":"has not yet been called. Then they do nothing, apart from"},{"text":" ","type":"text"},{"type":"codeVoice","code":"g_static_mutex_trylock()"},{"type":"text","text":" which does nothing but returning "},{"type":"codeVoice","code":"true"},{"type":"text","text":"."}],"type":"paragraph"},{"type":"paragraph","inlineContent":[{"text":"All of the g_static_mutex_* functions are actually macros. Apart from","type":"text"},{"type":"text","text":" "},{"type":"text","text":"taking their addresses, you can however use them as if they were"},{"text":" ","type":"text"},{"text":"functions.","type":"text"}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"The "},{"identifier":"doc:\/\/GLib\/documentation\/GLib\/StaticMutex","isActive":true,"type":"reference"},{"text":" type acts as an owner of an underlying ","type":"text"},{"type":"codeVoice","code":"GStaticMutex"},{"text":" instance.","type":"text"},{"text":" ","type":"text"},{"text":"It provides the methods that can operate on this data type through ","type":"text"},{"identifier":"doc:\/\/GLib\/documentation\/GLib\/StaticMutexProtocol","isActive":true,"type":"reference"},{"type":"text","text":" conformance."},{"type":"text","text":" "},{"type":"text","text":"Use "},{"identifier":"doc:\/\/GLib\/documentation\/GLib\/StaticMutex","type":"reference","isActive":true},{"type":"text","text":" as a strong reference or owner of a "},{"type":"codeVoice","code":"GStaticMutex"},{"type":"text","text":" instance."}]},{"name":"Note","content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"Use "},{"isActive":true,"identifier":"doc:\/\/GLib\/documentation\/GLib\/StaticMutexRef","type":"reference"},{"text":" (instead of ","type":"text"},{"isActive":true,"type":"reference","identifier":"doc:\/\/GLib\/documentation\/GLib\/StaticMutex"},{"type":"text","text":") for a lightweight Swift reference to an underlying "},{"code":"GStaticMutex","type":"codeVoice"},{"type":"text","text":" instance."}]}],"type":"aside","style":"note"}],"kind":"content"}],"references":{"doc://GLib/documentation/GLib/StaticMutex/init(cPointer:)":{"url":"\/documentation\/glib\/staticmutex\/init(cpointer:)","fragments":[{"text":"init","kind":"identifier"},{"text":"<","kind":"text"},{"kind":"genericParameter","text":"T"},{"text":">(","kind":"text"},{"kind":"externalParam","text":"cPointer"},{"kind":"text","text":": "},{"preciseIdentifier":"s:Sp","text":"UnsafeMutablePointer","kind":"typeIdentifier"},{"text":"<","kind":"text"},{"kind":"typeIdentifier","text":"T"},{"kind":"text","text":">)"}],"role":"symbol","kind":"symbol","identifier":"doc:\/\/GLib\/documentation\/GLib\/StaticMutex\/init(cPointer:)","abstract":[{"text":"Unsafe typed initialiser.","type":"text"},{"type":"text","text":" "},{"inlineContent":[{"type":"text","text":"Do not use unless you know the underlying data type the pointer points to conforms to "},{"identifier":"doc:\/\/GLib\/documentation\/GLib\/StaticMutexProtocol","isActive":true,"type":"reference"},{"type":"text","text":"."}],"type":"strong"}],"type":"topic","title":"init(cPointer:)"},"doc://GLib/documentation/GLib/StaticMutex/init(raw:)-1nyk4":{"kind":"symbol","fragments":[{"kind":"identifier","text":"init"},{"kind":"text","text":"("},{"text":"raw","kind":"externalParam"},{"text":": ","kind":"text"},{"kind":"typeIdentifier","text":"UnsafeRawPointer","preciseIdentifier":"s:SV"},{"kind":"text","text":")"}],"type":"topic","identifier":"doc:\/\/GLib\/documentation\/GLib\/StaticMutex\/init(raw:)-1nyk4","url":"\/documentation\/glib\/staticmutex\/init(raw:)-1nyk4","title":"init(raw:)"