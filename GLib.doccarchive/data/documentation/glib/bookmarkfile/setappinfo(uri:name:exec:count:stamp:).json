text","text":"You should rarely use this function; use "},{"type":"codeVoice","code":"g_bookmark_file_add_application()"},{"text":" ","type":"text"},{"type":"text","text":"and "},{"type":"codeVoice","code":"g_bookmark_file_remove_application()"},{"type":"text","text":" instead."}],"type":"paragraph"},{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"name"},{"type":"text","text":" can be any UTF-8 encoded string used to identify an"},{"type":"text","text":" "},{"type":"text","text":"application."},{"text":" ","type":"text"},{"code":"exec","type":"codeVoice"},{"type":"text","text":" can have one of these two modifiers: “`f"},{"type":"codeVoice","code":"\", which will be expanded as the local file name retrieved from the bookmark's URI; \"\\"},{"text":"u","type":"text"},{"type":"codeVoice","code":"\", which will be expanded as the bookmark's URI. The expansion is done automatically when retrieving the stored command line using the "},{"type":"text","text":"g_bookmark_file_get_application_info()"},{"type":"codeVoice","code":"function."},{"type":"text","text":"count"},{"type":"codeVoice","code":"is the number of times the application has registered the bookmark; if is < 0, the current registration count will be increased by one, if is 0, the application with"},{"type":"text","text":"name"},{"code":"will be removed from the list of registered applications.","type":"codeVoice"},{"text":"stamp` is the Unix time of the last registration; if it is -1, the","type":"text"},{"type":"text","text":" "},{"text":"current time will be used.","type":"text"}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"If you try to remove an application by setting its registration count to"},{"type":"text","text":" "},{"type":"text","text":"zero, and no bookmark for "},{"type":"codeVoice","code":"uri"},{"type":"text","text":" is found, "},{"type":"codeVoice","code":"false"},{"type":"text","text":" is returned and"},{"type":"text","text":" "},{"type":"codeVoice","code":"error"},{"text":" is set to ","type":"text"},{"type":"codeVoice","code":"uriNotFound"},{"text":"; similarly,","type":"text"},{"text":" ","type":"text"},{"type":"text","text":"in the event that no application "},{"code":"name","type":"codeVoice"},{"text":" has registered a bookmark","type":"text"},{"text":" ","type":"text"},{"type":"text","text":"for "},{"type":"codeVoice","code":"uri"},{"type":"text","text":",  "},{"type":"codeVoice","code":"false"},{"type":"text","text":" is returned and error is set to"},{"type":"text","text":" "},{"code":"appNotRegistered","type":"codeVoice"},{"type":"text","text":".  Otherwise, if no bookmark"},{"type":"text","text":" "},{"text":"for ","type":"text"},{"type":"codeVoice","code":"uri"},{"type":"text","text":" is found, one is created."}]},{"type":"paragraph","inlineContent":[{"type":"strong","inlineContent":[{"type":"text","text":"set_app_info is deprecated:"}]},{"text":" ","type":"text"},{"type":"text","text":"Use g_bookmark_file_set_application_info() instead, as"},{"type":"text","text":" "},{"type":"codeVoice","code":"time_t"},{"type":"text","text":" is deprecated due to the year 2038 problem."}]}]}],"sections":[],"schemaVersion":{"patch":0,"major":0,"minor":3},"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/glib\/bookmarkfile\/setappinfo(uri:name:exec:count:stamp:)"]}],"kind":"symbol","hierarchy":{"paths":[["doc:\/\/GLib\/documentation\/GLib","doc:\/\/GLib\/documentation\/GLib\/BookmarkFile","doc:\/\/GLib\/documentation\/GLib\/BookmarkFile\/BookmarkFileProtocol-Implementations"]]},"references":{"doc://GLib/documentation/GLib":{"identifier":"doc:\/\/GLib\/documentation\/GLib","title":"GLib","abstract":[],"type":"topic","url":"\/documentation\/glib","kind":"symbol","role":"collection"},"doc://GLib/documentation/GLib/BookmarkFile":{"abstract":[{"code":"GBookmarkFile","type":"codeVoice"},{"type":"text","text":" lets you parse, edit or create files containing bookmarks."}],"url":"\/documentation\/gl