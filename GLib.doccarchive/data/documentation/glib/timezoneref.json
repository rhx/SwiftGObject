{"kind":"symbol","primaryContentSections":[{"declarations":[{"platforms":["macOS"],"languages":["swift"],"tokens":[{"text":"struct","kind":"keyword"},{"kind":"text","text":" "},{"kind":"identifier","text":"TimeZoneRef"}]}],"kind":"declarations"},{"content":[{"level":2,"type":"heading","text":"Overview","anchor":"overview"},{"inlineContent":[{"type":"text","text":"The "},{"type":"codeVoice","code":"GTimeZone"},{"text":" struct is refcounted and immutable.","type":"text"}],"type":"paragraph"},{"type":"paragraph","inlineContent":[{"type":"text","text":"Each time zone has an identifier (for example, ‘Europe\/London’) which is"},{"type":"text","text":" "},{"type":"text","text":"platform dependent. See [ctor"},{"type":"codeVoice","code":"GLib.TimeZone.new"},{"text":"] for information on the","type":"text"},{"text":" ","type":"text"},{"type":"text","text":"identifier formats. The identifier of a time zone can be retrieved using"},{"type":"text","text":" "},{"type":"text","text":"[method"},{"type":"codeVoice","code":"GLib.TimeZone.get_identifier"},{"text":"].","type":"text"}]},{"inlineContent":[{"type":"text","text":"A time zone contains a number of intervals. Each interval has an abbreviation"},{"type":"text","text":" "},{"text":"to describe it (for example, ‘PDT’), an offset to UTC and a flag indicating","type":"text"},{"type":"text","text":" "},{"type":"text","text":"if the daylight savings time is in effect during that interval. A time zone"},{"type":"text","text":" "},{"type":"text","text":"always has at least one interval — interval 0. Note that interval abbreviations"},{"type":"text","text":" "},{"text":"are not the same as time zone identifiers (apart from ‘UTC’), and cannot be","type":"text"},{"text":" ","type":"text"},{"text":"passed to [ctor","type":"text"},{"type":"codeVoice","code":"GLib.TimeZone.new"},{"type":"text","text":"]."}],"type":"paragraph"},{"inlineContent":[{"text":"Every UTC time is contained within exactly one interval, but a given","type":"text"},{"text":" ","type":"text"},{"text":"local time may be contained within zero, one or two intervals (due to","type":"text"},{"type":"text","text":" "},{"type":"text","text":"incontinuities associated with daylight savings time)."}],"type":"paragraph"},{"type":"paragraph","inlineContent":[{"type":"text","text":"An interval may refer to a specific period of time (eg: the duration"},{"type":"text","text":" "},{"type":"text","text":"of daylight savings time during 2010) or it may refer to many periods"},{"type":"text","text":" "},{"text":"of time that share the same properties (eg: all periods of daylight","type":"text"},{"type":"text","text":" "},{"text":"savings time).  It is also possible (usually for political reasons)","type":"text"},{"type":"text","text":" "},{"text":"that some properties (like the abbreviation) change between intervals","type":"text"},{"text":" ","type":"text"},{"type":"text","text":"without other properties changing."}]},{"type":"paragraph","inlineContent":[{"text":"The ","type":"text"},{"type":"reference","isActive":true,"identifier":"doc:\/\/GLib\/documentation\/GLib\/TimeZoneRef"},{"type":"text","text":" type acts as a lightweight Swift reference to an underlying "},{"type":"codeVoice","code":"GTimeZone"},{"text":" instance.","type":"text"},{"type":"text","text":" "},{"type":"text","text":"It exposes methods that can operate on this data type through "},{"identifier":"doc:\/\/GLib\/documentation\/GLib\/TimeZoneProtocol","isActive":true,"type":"reference"},{"text":" conformance.","type":"text"},{"type":"text","text":" "},{"text":"Use ","type":"text"},{"identifier":"doc:\/\/GLib\/documentation\/GLib\/TimeZoneRef","type":"reference","isActive":true},{"text":" only as an ","type":"text"},{"code":"unowned","type":"codeVoice"},{"type":"text","text":" reference to an existing "},{"code":"GTimeZone","type":"codeVoice"},{"type":"text","text":" instance."}]},{"name":"Note","style":"note","type":"aside","content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"Use "},{"isActive":true,"identifier":"doc:\/\/GLib\/documentation\/GLib\/TimeZone","type":"reference"},{"type":"text","text":" (instead of "},{"isActive":true,"type":"reference","identifier":"doc:\/\/GLib\/documentation\/GLib\/TimeZoneRef"},{"type":"text","text":") if you want to use Automatic Reference Counting for memory management of the underlying "},{"type":"codeVoice","code":"GTimeZone"},{"text":" instance.","type":"text"}]}]}],"kind":"content"}],"variants":[{"paths":["\/documentation\/glib\/timezoneref"],"traits":[{"interfaceLanguage":"swift"}]}],"topicSections":[{"anchor":"Initializers","generated":true,"title":"Initializers","identifiers":["doc:\/\/GLib\/documentation\/GLib\/TimeZoneRef\/init(_:)-3wi4a","doc:\/\/GLib\/documentation\/GLib\/TimeZoneRef\/init(_:)-5j2y","doc:\/\/GLib\/documentation\/GLib\/TimeZoneRef\/init(_:)-7gvn1","doc:\/\/GLib\/documentation\/GLib\/TimeZoneRef\/init(_:)-8j5ou","doc:\/\/GLib\/documentation\/GLib\/TimeZoneRef\/init(_:)-8m404","doc:\/\/GLib\/documentation\/GLib\/TimeZoneRef\/init(cPointer:)","doc:\/\/GLib\/documentation\/GLib\/TimeZoneRef\/init(constPointer:)","doc:\/\/GLib\/documentation\/GLib\/TimeZoneRef\/init(gconstpointer:)","doc:\/\/GLib\/documentation\/GLib\/TimeZoneRef\/init(gpointer:)","doc:\/\/GLib\/documentation\/GLib\/TimeZoneRef\/init(identifier:)","doc:\/\/GLib\/documentation\/GLib\/TimeZoneRef\/init(identifierOrUtc:)","doc:\/\/GLib\/documentation\/GLib\/TimeZoneRef\/init(mutating:)","doc:\/\/GLib\/documentation\/GLib\/TimeZoneRef\/init(offset:)","doc:\/\/GLib\/documentation\/GLib\/TimeZoneRef\/init(opaquePointer:)"]},{"identifiers":["doc:\/\/GLib\/documentation\/GLib\/TimeZoneRef\/ptr"],"anchor":"Instance-Properties","generated":true,"title":"Instance Properties"},{"anchor":"Type-Methods","identifiers":["doc:\/\/GLib\/documentation\/GLib\/TimeZoneRef\/new(identifier:)","doc:\/\/GLib\/documentation\/GLib\/TimeZoneRef\/new(offset:)","doc:\/\/GLib\/documentation\/GLib\/TimeZoneRef\/newLocal()","d