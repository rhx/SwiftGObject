{"kind":"symbol","variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/glib\/testtrapsubprocesswithenvp(testpath:envp:usectimeout:testflags:)"]}],"schemaVersion":{"patch":0,"minor":3,"major":0},"identifier":{"url":"doc:\/\/GLib\/documentation\/GLib\/testTrapSubprocessWithEnvp(testPath:envp:usecTimeout:testFlags:)","interfaceLanguage":"swift"},"primaryContentSections":[{"declarations":[{"languages":["swift"],"tokens":[{"text":"func","kind":"keyword"},{"text":" ","kind":"text"},{"text":"testTrapSubprocessWithEnvp","kind":"identifier"},{"text":"(","kind":"text"},{"kind":"externalParam","text":"testPath"},{"kind":"text","text":": "},{"kind":"typeIdentifier","text":"UnsafePointer","preciseIdentifier":"s:SP"},{"text":"<","kind":"text"},{"kind":"typeIdentifier","preciseIdentifier":"s:s5CChara","text":"CChar"},{"kind":"text","text":">? = nil, "},{"kind":"externalParam","text":"envp"},{"text":": ","kind":"text"},{"text":"UnsafePointer","preciseIdentifier":"s:SP","kind":"typeIdentifier"},{"kind":"text","text":"<"},{"kind":"typeIdentifier","preciseIdentifier":"s:SP","text":"UnsafePointer"},{"text":"<","kind":"text"},{"kind":"typeIdentifier","text":"CChar","preciseIdentifier":"s:s5CChara"},{"text":">?>! = nil, ","kind":"text"},{"kind":"externalParam","text":"usecTimeout"},{"kind":"text","text":": "},{"text":"guint64","kind":"typeIdentifier","preciseIdentifier":"c:@T@guint64"},{"text":", ","kind":"text"},{"text":"testFlags","kind":"externalParam"},{"kind":"text","text":": "},{"kind":"typeIdentifier","preciseIdentifier":"s:4GLib19TestSubprocessFlagsV","text":"TestSubprocessFlags","identifier":"doc:\/\/GLib\/documentation\/GLib\/TestSubprocessFlags"},{"text":")","kind":"text"}],"platforms":["macOS"]}],"kind":"declarations"},{"content":[{"type":"heading","text":"Discussion","level":2,"anchor":"discussion"},{"type":"paragraph","inlineContent":[{"type":"text","text":"This can be used for a test case that might not return, or that"},{"text":" ","type":"text"},{"text":"might abort.","type":"text"}]},{"inlineContent":[{"type":"text","text":"If "},{"code":"testPath","type":"codeVoice"},{"type":"text","text":" is "},{"code":"NULL","type":"codeVoice"},{"type":"text","text":" then the same test is re-run in a subprocess."},{"text":" ","type":"text"},{"type":"text","text":"You can use [func"},{"code":"GLib.test_subprocess","type":"codeVoice"},{"type":"text","text":"] to determine whether the test"},{"text":" ","type":"text"},{"type":"text","text":"is in a subprocess or not."}],"type":"paragraph"},{"inlineContent":[{"type":"codeVoice","code":"testPath"},{"text":" can also be the name of the parent test, followed by","type":"text"},{"text":" ","type":"text"},{"text":"“","type":"text"},{"code":"\/subprocess\/","type":"codeVoice"},{"type":"text","text":"” and then a name for the specific subtest (or just"},{"type":"text","text":" "},{"type":"text","text":"ending with “"},{"type":"codeVoice","code":"\/subprocess"},{"text":"” if the test only has one child test);","type":"text"},{"text":" ","type":"text"},{"type":"text","text":"tests with names of this form will automatically be skipped in the"},{"type":"text","text":" "},{"type":"text","text":"parent process."}],"type":"paragraph"},{"type":"paragraph","inlineContent":[{"type":"text","text":"If "},{"type":"codeVoice","code":"envp"},{"text":" is ","type":"text"},{"type":"codeVoice","code":"NULL"},{"type":"text","text":", the parent process’ environment will be inherited."}]},{"type":"paragraph","inlineContent":[{"text":"If ","type":"text"},{"code":"usecTimeout","type":"codeVoice"},{"type":"text","text":" is non-0, the test subprocess is aborted and"},{"text":" ","type":"text"},{"text":"considered failing if its run time exceeds it.","type":"text"}]},{"inlineContent":[{"type":"text","text":"The subprocess behavior can be configured with [flags"},{"identifier":"doc:\/\/GLib\/documentation\/GLib\/TestSubprocessFlags","isActive":true,"type":"reference"},{"text":"]","type":"text"},{"type":"text","text":" "},{"text":"flags.","type":"text"}],"type":"paragraph"},{"type":"paragraph","inlineContent":[{"text":"You can use methods such as [func","type":"text"},{"type":"codeVoice","code":"GLib.test_trap_assert_passed"},{"type":"text","text":"],"},{"type":"text","text":" "},{"type":"text","text":"[func"},{"type":"codeVoice","code":"GLib.test_trap_assert_failed"},{"type":"text","text":"], and [func"},{"code":"GLib.test_trap_assert_stderr","type":"codeVoice"},{"type":"text","text":"] to"},{"type":"text","text":" "},{"type":"text","text":"check the results of the subprocess. (But note that"},{"text":" ","type":"text"},{"text":"[func","type":"text"},{"type":"codeVoice","code":"GLib.test_trap_assert_stdout"},{"text":"] and [func","type":"text"},{"type":"codeVoice","code":"GLib.test_trap_assert_stderr"},{"text":"]","type":"text"},{"type":"text","text":" "},{"text":"cannot be used if ","type":"text"},{"code":"testFlags","type":"codeVoice"},{"type":"text","text":" specifies that the child should"},{"text":" ","type":"text"},{"type":"text","text":"inherit the parent stdout\/stderr.)"}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"If your "},{"type":"codeVoice","code":"main ()"},{"type":"text","text":" needs to behave differently in the subprocess, you can"},{"type":"text","text":" "},{"text":"call [func","type":"text"},{"type":"codeVoice","code":"GLib.test_subprocess"},{"text":"] (after calling [func","type":"text"},{"code":"GLib.test_init","type":"codeVoice"},{"type":"text","text":"])"},{"text":" ","type":"text"},{"type":"text","text":"to see whether you are in a subprocess."}]},{"inlineContent":[{"text":"Internally, this function tracks the child process using","type":"text"},{"type":"text","text":" "},{"type":"text","text":"[func"},{"type":"codeVoice","code":"GLib.child_watch_source_new"},{"text":"], so your process must not ignore","type":"text"},{"type":"text","text":" "},{"type":"codeVoice","code":"SIGCHLD"},{"text":", and must not attempt to watch or wait for the child process","type":"text"},{"text":" ","type":"text"},{"type":"text","text":"via another mechanism."}],"type":"paragraph"},{"inlineContent":[{"text":"The following example tests that calling ","type":"text"},{"type":"codeVoice","code":"my_object_new(1000000)"},{"type":"text","text":" will"},{"type":"text","text":" "},{"text":"abort with an error message.","type":"text"}],"type":"paragraph"},{"code":["  static void","  test_create_large_object (void)","  {","    if (g_test_subprocess ())","      {","        my_object_new (1000000);","        return;","      }","","    \/\/ Reruns this same test in a subprocess","    g_test_trap_subprocess (NULL, 0, G_TEST_SUBPROCESS_DEFAULT);","    g_test_trap_assert_failed ();","    g_test_trap_assert_stderr (\"*ERROR*too large*\");","  }","","  static void","  test_different_username (void)","  {","    if (g_test_subprocess ())","      {","        \/\/ Code under test goes here","        g_message (\"Username is now simulated as `s`\", g_getenv (\"USER\"));","        return;","      }","","    \/\/ Reruns this same test in a subprocess","    `g_auto(GStrv)` envp = g_get_environ ();","    envp = g_environ_setenv (g_steal_pointer (&envp), \"USER\", \"charlie\", TRUE);","    g_test_trap_subprocess_with_envp (NULL, envp, 0, G_TEST_SUBPROCESS_DEFAULT);","    g_test_trap_assert_passed ();","    g_test_trap_assert_stdout (\"Username is now simulated as charlie\");","  }","","  int","  main (int argc, char **argv)","  {","    g_test_init (&argc, &argv, NULL);","","    g_test_add_func (\"\/myobject\/create-large-object\",","                     test_create_large_object);","    g_test_add_func (\"\/myobject\/different-username\",","                     test_different_username);","    return g_test_run ();","  }"],"type":"codeListing","syntax":"c"}],"kind":"content"}],"sections":[],"abstract":[{"text":"Respawns the test program to run only ","type":"text"},{"type":"codeVoice","code":"testPath"},{"type":"text","text":" in a subprocess with"},{"text":" ","type":"text"},{"type":"text","text":"a given environment."}],"metadata":{"modules":[{"name":"GLib"}],"externalID":"s:4GLib26testTrapSubprocessWithEnvp0B4Path4envp11usecTimeout0B5FlagsySPys4Int8VGSg_SPyAJGSgs6UInt64VAA04TestdK0VtF","role":"symbol","title":"testTrapSubprocessWithEnvp(testPath:envp:usecTimeout:testFlags:)","symbolKind":"func","roleHeading":"Function","fragments":[{"text":"func","kind":"keyword"},{"kind":"text","text":" "},{"text":"testTrapSubprocessWithEnvp","kind":"identifier"},{"text":"(","kind":"text"},{"kind":"externalParam","text":"testPath"},{"text":": ","kind":"text"},{"preciseIdentifier":"s:SP","text":"UnsafePointer","kind":"typeIdentifier"},{"text":"<","kind":"text"},{"text":"CChar","kind":"typeIdentifier","preciseIdentifier":"s:s5CChara"},{"text":">?, ","kind":"text"},{"kind":"externalParam","text":"envp"},{"text":": ","kind":"text"},{"kind":"typeIdentifier","preciseIdentifier":"s:SP","text":"UnsafePointer"},{"kind":"text","text":"<"},{"text":"UnsafePointer","preciseIdentifier":"s:SP","kind":"typeIdentifier"},{"kind":"text","text":"<"},{"text":"CChar","preciseIdentifier":"s:s5CChara","kind":"typeIdentifier"},{"kind":"text","text":">?>!, "},{"kind":"externalParam","text":"usecTimeout"},{"text":": ","kind":"text"},{"preciseIdentifier":"c:@T@guint64","text":"guint64","kind":"typeIdentifier"},{"text":", ","kind":"text"},{"text":"testFlags","kind":"externalParam"},{"text":": ","kind":"text"},{"kind":"typeIdentifier","text":"TestSubprocessFlags","preciseIdentifier":"s:4GLib19TestSubprocessFlagsV"},{"text":")","kind":"text"}]},"hierarchy":{"paths":[["doc:\/\/GLib\/documentation\/GLib"]]},"references":{"doc://GLib/documentation/GLib/testTrapSubprocessWithEnvp(testPath:envp:usecTimeout:testFlags:)":{"kind":"symbol","identifier":"doc:\/\/GLib\/documentation\/GLib\/testTrapSubprocessWithEnvp(testPath:envp:usecTimeout:testFlags:)","fragments":[{"kind":"keyword","text":"func"},{"text":" ","kind":"text"},{"kind":"identif