{"sections":[],"abstract":[{"type":"text","text":"Changes the behaviour of the various assertion macros."}],"metadata":{"modules":[{"name":"GLib"}],"roleHeading":"Function","externalID":"s:4GLib25testSetNonfatalAssertionsyyF","title":"testSetNonfatalAssertions()","role":"symbol","symbolKind":"func","fragments":[{"text":"func","kind":"keyword"},{"text":" ","kind":"text"},{"text":"testSetNonfatalAssertions","kind":"identifier"},{"text":"()","kind":"text"}]},"hierarchy":{"paths":[["doc:\/\/GLib\/documentation\/GLib"]]},"primaryContentSections":[{"declarations":[{"tokens":[{"text":"func","kind":"keyword"},{"kind":"text","text":" "},{"kind":"identifier","text":"testSetNonfatalAssertions"},{"text":"()","kind":"text"}],"platforms":["macOS"],"languages":["swift"]}],"kind":"declarations"},{"content":[{"type":"heading","anchor":"discussion","level":2,"text":"Discussion"},{"type":"paragraph","inlineContent":[{"text":"The ","type":"text"},{"type":"codeVoice","code":"g_assert_*()"},{"text":" macros, ","type":"text"},{"code":"g_test_assert_expected_messages()","type":"codeVoice"},{"type":"text","text":" "},{"type":"text","text":"and the various "},{"type":"codeVoice","code":"g_test_trap_assert_*()"},{"text":" macros are changed","type":"text"},{"type":"text","text":" "},{"type":"text","text":"to not abort to program."}]},{"inlineContent":[{"type":"text","text":"Instead, they will call [func"},{"type":"codeVoice","code":"GLib.test_fail"},{"type":"text","text":"] and continue."},{"text":" ","type":"text"},{"text":"(This also changes the behavior of [func","type":"text"},{"type":"codeVoice","code":"GLib.test_fail"},{"type":"text","text":"] so that"},{"type":"text","text":" "},{"text":"it will not cause the test program to abort after completing","type":"text"},{"text":" ","type":"text"},{"text":"the failed test.)","type":"text"}],"type":"paragraph"},{"inlineContent":[{"type":"text","text":"Note that the [func"},{"type":"codeVoice","code":"GLib.assert_not_reached"},{"type":"text","text":"] and [func"},{"type":"codeVoice","code":"GLib.assert"},{"text":"]","type":"text"},{"text":" ","type":"text"},{"text":"macros are not affected by this.","type":"text"}],"type":"paragraph"},{"type":"paragraph","inlineContent":[{"text":"This function can only be called after [func","type":"text"},{"code":"GLib.test_init","type":"codeVoice"},{"type":"text","text":"]."}]}],"kind":"content"}],"identifier":{"url":"doc:\/\/GLib\/documentation\/GLib\/testSetNonfatalAssertions()","interfaceLanguage":"swift"},"variants":[{"paths":["\/documentation\/glib\/testsetnonfatalassertions()"],"traits":[{"interfaceLanguage":"swift"}]}],"kind":"symbol","schemaVersion":{"minor":3,"major":0,"patch":0},"references":{"doc://GLib/documentation/GLib/testSetNonfatalAssertions()":{"abstract":[{"text":"Changes the behaviour of the various assertion macros.","type":"text"}],"role":"symbol","identifier":"doc:\/\/GLib\/documentation\/GLib\/testSetNonfatalAssertions()","type":"topic","kind":"symbol","title":"testSetNonfatalAssertions()","fragments":[{"text":"func","kind":"keyword"},{"text":" ","kind":"text"},{"text":"testSetNonfatalAssertions","kind":"identifier"},{"text":"()","kind":"text"}],"url":"\/documentation\/glib\/testsetnonfatalassertions()"},"doc://GLib/documentation/GLib":{"identifier":"doc:\/\/GLib\/documentation\/GLib","title":"GLib","abstract":[],"type":"topic","url":"\/documentation\/glib","kind":"symbol","role":"collection"}}}