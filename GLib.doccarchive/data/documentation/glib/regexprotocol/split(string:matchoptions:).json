{"schemaVersion":{"major":0,"minor":3,"patch":0},"abstract":[{"type":"text","text":"Breaks the string on the pattern, and returns an array of the tokens."},{"text":" ","type":"text"},{"text":"If the pattern contains capturing parentheses, then the text for each","type":"text"},{"type":"text","text":" "},{"text":"of the substrings will also be returned. If the pattern does not match","type":"text"},{"type":"text","text":" "},{"type":"text","text":"anywhere in the string, then the whole string is returned as the first"},{"type":"text","text":" "},{"text":"token.","type":"text"}],"sections":[],"primaryContentSections":[{"declarations":[{"platforms":["macOS"],"languages":["swift"],"tokens":[{"kind":"keyword","text":"func"},{"kind":"text","text":" "},{"text":"split","kind":"identifier"},{"text":"(","kind":"text"},{"kind":"externalParam","text":"string"},{"text":": ","kind":"text"},{"kind":"typeIdentifier","preciseIdentifier":"s:SP","text":"UnsafePointer"},{"kind":"text","text":"<"},{"kind":"typeIdentifier","text":"gchar","preciseIdentifier":"c:@T@gchar"},{"text":">!, ","kind":"text"},{"text":"matchOptions","kind":"externalParam"},{"text":": ","kind":"text"},{"text":"RegexMatchFlags","preciseIdentifier":"s:4GLib15RegexMatchFlagsV","identifier":"doc:\/\/GLib\/documentation\/GLib\/RegexMatchFlags","kind":"typeIdentifier"},{"text":") -> ","kind":"text"},{"text":"UnsafeMutablePointer","preciseIdentifier":"s:Sp","kind":"typeIdentifier"},{"text":"<","kind":"text"},{"text":"UnsafeMutablePointer","preciseIdentifier":"s:Sp","kind":"typeIdentifier"},{"kind":"text","text":"<"},{"kind":"typeIdentifier","text":"gchar","preciseIdentifier":"c:@T@gchar"},{"text":">?>!","kind":"text"}]}],"kind":"declarations"},{"content":[{"text":"Discussion","anchor":"discussion","level":2,"type":"heading"},{"inlineContent":[{"text":"As a special case, the result of splitting the empty string “” is an","type":"text"},{"type":"text","text":" "},{"type":"text","text":"empty vector, not a vector containing a single string. The reason for"},{"text":" ","type":"text"},{"type":"text","text":"this special case is that being able to represent an empty vector is"},{"text":" ","type":"text"},{"type":"text","text":"typically more useful than consistent handling of empty elements. If"},{"text":" ","type":"text"},{"type":"text","text":"you do need to represent empty elements, you’ll need to check for the"},{"type":"text","text":" "},{"type":"text","text":"empty string before calling this function."}],"type":"paragraph"},{"inlineContent":[{"text":"A pattern that can match empty strings splits ","type":"text"},{"code":"string","type":"codeVoice"},{"type":"text","text":" into separate"},{"text":" ","type":"text"},{"type":"text","text":"characters wherever it matches the empty string between characters."},{"type":"text","text":" "},{"text":"For example splitting “ab c” using as a separator “\\s*”, you will get","type":"text"},{"text":" ","type":"text"},{"text":"“a”, “b” and “c”.","type":"text"}],"type":"paragraph"}],"kind":"content"}],"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/glib\/regexprotocol\/split(string:matchoptions:)"]}],"identifier":{"interfaceLanguage":"swift","url":"doc:\/\/GLib\/documentation\/GLib\/RegexProtocol\/split(string:matchOptions:)"},"kind":"symbol","hierarchy":{"paths":[["doc:\/\/GLib\/documentation\/GLib","doc:\/\/GLib\/documentation\/GLib\/RegexProtocol"]]},"metadata":{"role":"symbol","roleHeading":"Instance Method","extendedModule":"GLib","fragments":[{"text":"func","kind":"keyword"},{"text":" ","kind":"text"},{"kind":"identifier","text":"split"},{"kind":"text","text":"("},{"text":"string","kind":"externalParam"},{"text":": ","kind":"text"},{"preciseIdentifier":"s:SP","text":"UnsafePointer","kind":"typeIdentifier"},{"text":"<","kind":"text"},{"preciseIdentifier":"c:@T@gchar","kind":"typeIdentifier","text":"gchar"},{"text":">!, ","kind":"text"},{"kind":"externalParam","text":"matchOptions"},{"kind":"text","text":": "},{