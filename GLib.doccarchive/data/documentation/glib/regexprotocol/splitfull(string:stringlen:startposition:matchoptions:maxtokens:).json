{"sections":[],"kind":"symbol","abstract":[{"text":"Breaks the string on the pattern, and returns an array of the tokens.","type":"text"},{"type":"text","text":" "},{"type":"text","text":"If the pattern contains capturing parentheses, then the text for each"},{"text":" ","type":"text"},{"type":"text","text":"of the substrings will also be returned. If the pattern does not match"},{"text":" ","type":"text"},{"type":"text","text":"anywhere in the string, then the whole string is returned as the first"},{"type":"text","text":" "},{"type":"text","text":"token."}],"variants":[{"paths":["\/documentation\/glib\/regexprotocol\/splitfull(string:stringlen:startposition:matchoptions:maxtokens:)"],"traits":[{"interfaceLanguage":"swift"}]}],"hierarchy":{"paths":[["doc:\/\/GLib\/documentation\/GLib","doc:\/\/GLib\/documentation\/GLib\/RegexProtocol"]]},"primaryContentSections":[{"declarations":[{"tokens":[{"kind":"keyword","text":"func"},{"text":" ","kind":"text"},{"text":"splitFull","kind":"identifier"},{"text":"(","kind":"text"},{"kind":"externalParam","text":"string"},{"text":": ","kind":"text"},{"preciseIdentifier":"s:SP","text":"UnsafePointer","kind":"typeIdentifier"},{"text":"<","kind":"text"},{"kind":"typeIdentifier","text":"gchar","preciseIdentifier":"c:@T@gchar"},{"text":">!, ","kind":"text"},{"text":"stringLen","kind":"externalParam"},{"kind":"text","text":": "},{"kind":"typeIdentifier","text":"gssize","preciseIdentifier":"c:@T@gssize"},{"text":", ","kind":"text"},{"kind":"externalParam","text":"startPosition"},{"text":": ","kind":"text"},{"kind":"typeIdentifier","text":"Int","preciseIdentifier":"s:Si"},{"kind":"text","text":", "},{"text":"matchOptions","kind":"externalParam"},{"kind":"text","text":": "},{"kind":"typeIdentifier","text":"RegexMatchFlags","identifier":"doc:\/\/GLib\/documentation\/GLib\/RegexMatchFlags","preciseIdentifier":"s:4GLib15RegexMatchFlagsV"},{"text":", ","kind":"text"},{"kind":"externalParam","text":"maxTokens"},{"kind":"text","text":": "},{"pre