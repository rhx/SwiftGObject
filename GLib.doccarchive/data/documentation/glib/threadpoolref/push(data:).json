ontent","content":[{"type":"heading","text":"Discussion","anchor":"discussion","level":2},{"type":"paragraph","inlineContent":[{"type":"text","text":"When the number of currently running threads is lower than the"},{"type":"text","text":" "},{"text":"maximal allowed number of threads, a new thread is started (or","type":"text"},{"type":"text","text":" "},{"type":"text","text":"reused) with the properties given to "},{"code":"g_thread_pool_new()","type":"codeVoice"},{"text":".","type":"text"},{"type":"text","text":" "},{"text":"Otherwise, ","type":"text"},{"code":"data","type":"codeVoice"},{"type":"text","text":" stays in the queue until a thread in this pool"},{"text":" ","type":"text"},{"text":"finishes its previous task and processes ","type":"text"},{"code":"data","type":"codeVoice"},{"type":"text","text":"."}]},{"inlineContent":[{"code":"error","type":"codeVoice"},{"type":"text","text":" can be "},{"type":"codeVoice","code":"nil"},{"text":" to ignore errors, or non-","type":"text"},{"code":"nil","type":"codeVoice"},{"text":" to report","type":"text"},{"type":"text","text":" "},{"type":"text","text":"errors. An error can only occur when a new thread couldn’t be"},{"text":" ","type":"text"},{"text":"created. In that case ","type":"text"},{"type":"codeVoice","code":"data"},{"text":" is simply appended to the queue of","type":"text"},{"text":" ","type":"text"},{"type":"text","text":"work to do."}],"type":"paragraph"},{"inlineContent":[{"text":"Before version 2.32, this function did not return a success status.","type":"text"}],"type":"paragraph"}]}],"references":{"doc://GLib/documentation/GLib":{"identifier":"doc:\/\/GLib\/documentation\/GLib","title":"GLib","abstract":[],"type":"topic","url":"\/documentation\/glib","kind":"symbol","role":"collection"},"doc://GLib/documentation/GLib/ThreadPoolRef/ThreadPoolProtocol-Implementations":{"identifier":"doc:\/\/GLib\/documentation\/GLib\/ThreadPoolRef\/ThreadPoolProtocol-Implementations","abstract":[],"type":"topic","title