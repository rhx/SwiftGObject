{"topicSections":[{"generated":true,"title":"Initializers","identifiers":["doc:\/\/GLib\/documentation\/GLib\/KeyFile\/init()","doc:\/\/GLib\/documentation\/GLib\/KeyFile\/init(_:)-1hpxa","doc:\/\/GLib\/documentation\/GLib\/KeyFile\/init(_:)-2cylo","doc:\/\/GLib\/documentation\/GLib\/KeyFile\/init(_:)-55cb","doc:\/\/GLib\/documentation\/GLib\/KeyFile\/init(_:)-6cxh2","doc:\/\/GLib\/documentation\/GLib\/KeyFile\/init(_:)-7e0t2","doc:\/\/GLib\/documentation\/GLib\/KeyFile\/init(cPointer:)","doc:\/\/GLib\/documentation\/GLib\/KeyFile\/init(gconstpointer:)","doc:\/\/GLib\/documentation\/GLib\/KeyFile\/init(gpointer:)","doc:\/\/GLib\/documentation\/GLib\/KeyFile\/init(opaquePointer:)","doc:\/\/GLib\/documentation\/GLib\/KeyFile\/init(raw:)-1fvqt","doc:\/\/GLib\/documentation\/GLib\/KeyFile\/init(raw:)-9irr5","doc:\/\/GLib\/documentation\/GLib\/KeyFile\/init(retaining:)","doc:\/\/GLib\/documentation\/GLib\/KeyFile\/init(retainingCPointer:)","doc:\/\/GLib\/documentation\/GLib\/KeyFile\/init(retainingOpaquePointer:)","doc:\/\/GLib\/documentation\/GLib\/KeyFile\/init(retainingRaw:)-3tfsd","doc:\/\/GLib\/documentation\/GLib\/KeyFile\/init(retainingRaw:)-9y6hj"],"anchor":"Initializers"},{"generated":true,"title":"Instance Properties","identifiers":["doc:\/\/GLib\/documentation\/GLib\/KeyFile\/ptr"],"anchor":"Instance-Properties"},{"title":"Default Implementations","generated":true,"identifiers":["doc:\/\/GLib\/documentation\/GLib\/KeyFile\/KeyFileProtocol-Implementations"],"anchor":"Default-Implementations"}],"kind":"symbol","hierarchy":{"paths":[["doc:\/\/GLib\/documentation\/GLib"]]},"schemaVersion":{"major":0,"patch":0,"minor":3},"identifier":{"url":"doc:\/\/GLib\/documentation\/GLib\/KeyFile","interfaceLanguage":"swift"},"abstract":[{"code":"GKeyFile","type":"codeVoice"},{"type":"text","text":" parses .ini-like config files."}],"primaryContentSections":[{"kind":"declarations","declarations":[{"platforms":["macOS"],"languages":["swift"],"tokens":[{"kind":"keyword","text":"class"},{"text":" ","kind":"text"},{"kind":"identifier","text":"KeyFile"}]}]},{"kind":"content","content":[{"type":"heading","anchor":"overview","text":"Overview","level":2},{"type":"paragraph","inlineContent":[{"code":"GKeyFile","type":"codeVoice"},{"type":"text","text":" lets you parse, edit or create files containing groups of"},{"type":"text","text":" "},{"type":"text","text":"key-value pairs, which we call ‘key files’ for lack of a better name."},{"text":" ","type":"text"},{"text":"Several freedesktop.org specifications use key files. For example, the","type":"text"},{"type":"text","text":" "},{"type":"reference","identifier":"https:\/\/specifications.freedesktop.org\/desktop-entry-spec\/latest\/","isActive":true},{"text":" ","type":"text"},{"type":"text","text":"and the "},{"type":"reference","identifier":"https:\/\/specifications.freedesktop.org\/icon-theme-spec\/latest\/","isActive":true},{"text":".","type":"text"}]},{"inlineContent":[{"text":"The syntax of key files is described in detail in the","type":"text"},{"type":"text","text":" "},{"identifier":"https:\/\/specifications.freedesktop.org\/desktop-entry-spec\/latest\/","overridingTitle":"Desktop Entry Specification","overridingTitleInlineContent":[{"type":"text","text":"Desktop Entry Specification"}],"type":"reference","isActive":true},{"type":"text","text":","},{"text":" ","type":"text"},{"text":"here is a quick summary: Key files consists of groups of key-value pairs, interspersed","type":"text"},{"text":" ","type":"text"},{"type":"text","text":"with comments."}],"type":"paragraph"},{"code":["# this is just an example","# there can be comments before the first group","","[First Group]","","Name=Key File Example\\tthis value shows\\nescaping","","# localized strings are stored in multiple key-value pairs","Welcome=Hello","Welcome[de]=Hallo","Welcome[fr_FR]=Bonjour","Welcome[it]=Ciao","","[Another Group]","","Numbers=2;20;-200;0","","Booleans=true;false;true;true"],"syntax":"txt","type":"codeListing"},{"inlineContent":[{"text":"Lines beginning with a ","type":"text"},{"code":"#","type":"codeVoice"},{"text":" and blank lines are considered comments.","type":"text"}],"type":"paragraph"},{"inlineContent":[{"type":"text","text":"Groups are started by a header line containing the group name enclosed"},{"type":"text","text":" "},{"text":"in ","type":"text"},{"type":"codeVoice","code":"["},{"type":"text","text":" and "},{"code":"]","type":"codeVoice"},{"type":"text","text":", and ended implicitly by the start of the next group or"},{"type":"text","text":" "},{"text":"the end of the file. Each key-value pair must be contained in a group.","type":"text"}],"type":"paragraph"},{"type":"paragraph","inlineContent":[{"text":"Key-value pairs generally have the form ","type":"text"},{"type":"codeVoice","code":"key=value"},{"text":", with the exception","type":"text"},{"text":" ","type":"text"},{"type":"text","text":"of localized strings, which have the form "},{"type":"codeVoice","code":"key[locale]=value"},{"type":"text","text":", with a"},{"text":" ","type":"text"},{"text":"locale identifier of the form ","type":"text"},{"type":"codeVoice","code":"lang_COUNTRY"},{"text":"MODIFIER`` where ","type":"text"},{"code":"COUNTRY","type":"codeVoice"},{"type":"text","text":" "},{"type":"text","text":"and `MODIFIER` are optional. As a special case, the locale `C` is associated"},{"type":"text","text":" "},{"type":"text","text":"with the untranslated pair `key=value` (since GLib 2.84). Space before and"},{"type":"text","text":" "},{"type":"text","text":"after the `=` character is ignored. Newline, tab, carriage return and"},{"text":" ","type":"text"},{"text":"backslash characters in value are escaped as `\\n`, `\\t`, `\\r`, and `\\\\`,","type":"text"},{"type":"text","text":" "},{"type":"text","text":"respectively. To preserve leading spaces in values, these can also be escaped"},{"type":"text","text":" "},{"type":"text","text":"as `\\s`."}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"Key files can store strings (possibly with localized variants), integers,"},{"text":" ","type":"text"},{"text":"booleans and lists of these. Lists are separated by a separator character,","type":"text"},{"type":"text","text":" "},{"text":"typically ","type":"text"},{"type":"codeVoice","code":";"},{"type":"text","text":" or "},{"code":",","type":"codeVoice"},{"text":". To use the list separator character in a value in","type":"text"},{"type":"text","text":" "},{"type":"text","text":"a list, it has to be escaped by prefixing it with a backslash."}]},{"inlineContent":[{"text":"This syntax is obviously inspired by the .ini files commonly met","type":"text"},{"text":" ","type":"text"},{"type":"text","text":"on Windows, but there are some important differences:"}],"type":"paragraph"},{"type":"unorderedList","items":[{"content":[{"inlineContent":[{"type":"text","text":".ini files use the "},{"code":";","type":"codeVoice"},{"type":"text","text":" character to begin comments,"},{"text":" ","type":"text"},{"text":"key files use the ","type":"text"},{"type":"codeVoice","code":"#"},{"type":"text","text":" character."}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"text":"Key files do not allow for ungrouped keys meaning only","type":"text"},{"type":"text","text":" "},{"type":"text","text":"comments can precede the first group."}],"type":"paragraph"}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"Key files are always encoded in UTF-8."}]}]},{"content":[{"type":"paragraph","inlineContent":[{"text":"Key and Group names are case-sensitive. For example, a group called","type":"text"},{"text":" ","type":"text"},{"type":"codeVoice","code":"[GROUP]"},{"text":" is a different from ","type":"text"},{"code":"[group]","type":"codeVoice"},{"text":".","type":"text"}]}]},{"content":[{"inlineContent":[{"text":".ini files don’t have a strongly typed boolean entry type,","type":"text"},{"text":" ","type":"text"},{"type":"text","text":"they only have "},{"code":"GetProfileInt()","type":"codeVoice"},{"text":". In key files, only","type":"text"},{"type":"text","text":" "},{"code":"true","type":"codeVoice"},{"type":"text","text":" and "},{"code":"false","type":"codeVoice"},{"text":" (in lower case) are allowed.","type":"text"}],"type":"paragraph"}]}]},{"inlineContent":[{"text":"Note that in contrast to the","type":"text"},{"text":" ","type":"text"},{"overridingTitle":"Desktop Entry Specification","overridingTitleInlineContent":[{"text":"Desktop Entry Specification","type":"text"}],"identifier":"https:\/\/specifications.freedesktop.org\/desktop-entry-spec\/latest\/","isActive":true,"type":"reference"},{"text":",","type":"text"},{"text":" ","type":"text"},{"type":"text","text":"groups in key files may contain the same key multiple times; the last entry wins."},{"text":" ","type":"text"},{"text":"Key files may also contain multiple groups with the same name; they are merged","type":"text"},{"text":" ","type":"text"},{"type":"text","text":"together. Another difference is that keys and group names in key files are not"},{"type":"text","text":" "},{"type":"text","text":"restricted to ASCII characters."}],"type":"paragraph"},{"inlineContent":[{"type":"text","text":"Here is an example of loading a key file and reading a value:"}],"type":"paragraph"},{"type":"codeListing","syntax":"c","code":["`g_autoptr(GError)` error = NULL;","`g_autoptr(GKeyFile)` key_file = g_key_file_new ();","","if (!g_key_file_load_from_file (key_file, \"key-file.ini\", flags, &error))","  {","    if (!g_error_matches (error, G_FILE_ERROR, G_FILE_ERROR_NOENT))","      g_warning (\"Error loading key file: `s`\", error->message);","    return;","  }","","g_autofree gchar *val = g_key_file_get_string (key_file, \"Group Name\", \"SomeKey\", &error);","if (val == NULL &&","    !g_error_matches (error, G_KEY_FILE_ERROR, G_KEY_FILE_ERROR_KEY_NOT_FOUND))","  {","    g_warning (\"Error finding key in key file: `s`\", error->message);","    return;","  }","else if (val == NULL)","  {","    \/\/ Fall back to a default value.","    val = g_strdup (\"default-value\");","  }"]},{"type":"paragraph","inlineContent":[{"text":"Here is an example of creating and saving a key file:","type":"text"}]},{"code":["`g_autoptr(GKeyFile)` key_file = g_key_file_new ();","const gchar *val = …;","`g_autoptr(GError)` error = NULL;","","g_key_file_set_string (key_file, \"Group Name\", \"SomeKey\", val);","","\/\/ Save as a file.","if (!g_key_file_save_to_file (key_file, \"key-file.ini\", &error))","  {","    g_warning (\"Error saving key file: `s`\", error->message);","    return;","  }","","\/\/ Or store to a GBytes for use elsewhere.","gsize data_len;","g_autofree guint8 *data = (guint8 *) g_key_file_to_data (key_file, &data_len, &error);","if (data == NULL)","  {","    g_warning (\"Error saving key file: `s`\", error->message);","    return;","  }","`g_autoptr(GBytes)` bytes = g_bytes_new_take (g_steal_pointer (&data), data_len);"],"type":"codeListing","syntax":"c"},{"inlineContent":[{"text":"The ","type":"text"},{"type":"reference","identifier":"doc:\/\/GLib\/documentation\/GLib\/KeyFile","isActive":true},{"text":" type acts as a reference-counted owner of an underlying ","type":"text"},{"code":"GKeyFile","type":"codeVoice"},{"text":" instance.","type":"text"},{"type":"text","text":" "},{"text":"It provides the methods that can operate on this data type through ","type":"text"},{"type":"reference","identifier":"doc:\/\/GLib\/documentation\/GLib\/KeyFileProtocol","isActive":true},{"type":"text","text":" conformance."},{"text":" ","type":"text"},{"type":"text","text":"Use "},{"identifier":"doc:\/\/GLib\/documentation\/GLib\/KeyFile","isActive":true,"type":"reference"},{"text":" as a strong reference or owner of a ","type":"text"},{"code":"GKeyFile","type":"codeVoice"},{"type":"text","text":" instance."}],"type":"paragraph"},{"type":"aside","content":[{"inlineContent":[{"text":"Use ","type":"text"},{"identifier":"doc:\/\/GLib\/documentation\/GLib\/KeyFileRef","type":"reference","isActive":true},{"text":" (instead of ","type":"text"},{"type":"reference","identifier":"doc:\/\/GLib\/documentation\/GLib\/KeyFile","isActive":true},{"type":"text","text":") for a lightweight Swift reference to an underlying "},{"code":"GKeyFile","type":"codeVoice"},{"type":"text","text":" instance."}],"type":"paragraph"}],"name":"Note","style":"note"}]}],"metadata":{"navigatorTitle":[{"kind":"identifier","text":"KeyFile"}],"modules":[{"name":"GLib"}],"roleHeading":"Class","title":"KeyFile","role":"symbol","symbolKind":"class","externalID":"s:4GLib7KeyFileC","fragments":[{"kind":"keyword","text":"class"},{"text":" ","kind":"text"},{"kind":"identifier","text":"KeyFile"}]},"variants":[{"paths":["\/documentation\/glib\/keyfile"],"traits":[{"interfaceLanguage":"swift"}]}],"sections":[],"relationshipsSections":[{"identifiers":["doc:\/\/GLib\/documentation\/GLib\/KeyFileProtocol","doc:\/\/GLib\/documentation\/GLib\/PointerWrapper"],"kind":"relationships","title":"Conforms To","type":"conformsTo"}],"references":{"doc://GLib/documentation/GLib/KeyFile/init(gconstpointer:)":{"type":"topic","title":"init(gconstpointer:)","kind":"symbol","abstract":[{"type":"text","text":"Optional initialiser from a non-mutating "},{"type":"codeVoice","code":"gconstpointer"},{"type":"text","text":" to"},{"type":"text","text":" "},{"text":"the underlying ","type":"text"},{"type":"codeVoice","code":"C"},{"type":"text","text":" data type."},{"text":" ","type":"text"},{"type":"text","text":"This creates an instance without performing an unbalanced retain"},{"text":" ","type":"text"},{"type":"text","text":"i.e., ownership is transferred to the "},{"type":"reference","isActive":true,"identifier":"doc:\/\/GLib\/documentation\/GLib\/KeyFile"},{"type":"text","text":" instance."}],"identifier":"doc:\/\/GLib\/documentation\/GLib\/KeyFile\/init(gconstpointer:)","role":"symbol","fragments":[{"kind":"identifier","text":"init"},{"text":"!(","kind":"text"},{"text":"gcons