{"kind":"symbol","hierarchy":{"paths":[["doc:\/\/GLib\/documentation\/GLib","doc:\/\/GLib\/documentation\/GLib\/PatternSpecRef","doc:\/\/GLib\/documentation\/GLib\/PatternSpecRef\/PatternSpecProtocol-Implementations"]]},"sections":[],"metadata":{"title":"patternMatch(stringLength:string:stringReversed:)","role":"symbol","symbolKind":"method","modules":[{"name":"GLib"}],"extendedModule":"GLib","fragments":[{"text":"func","kind":"keyword"},{"text":" ","kind":"text"},{"text":"patternMatch","kind":"identifier"},{"text":"(","kind":"text"},{"kind":"externalParam","text":"stringLength"},{"text":": ","kind":"text"},{"text":"Int","kind":"typeIdentifier","preciseIdentifier":"s:Si"},{"text":", ","kind":"text"},{"text":"string","kind":"externalParam"},{"text":": ","kind":"text"},{"preciseIdentifier":"s:SP","kind":"typeIdentifier","text":"UnsafePointer"},{"kind":"text","text":"<"},{"kind":"typeIdentifier","text":"gchar","preciseIdentifier":"c:@T@gchar"},{"text":">!, ","kind":"text"},{"kind":"externalParam","text":"stringReversed"},{"text":": ","kind":"text"},{"text":"UnsafePointer","kind":"typeIdentifier","preciseIdentifier":"s:SP"},{"text":"<","kind":"text"},{"kind":"typeIdentifier","preciseIdentifier":"c:@T@gchar","text":"gchar"},{"kind":"text","text":">?) -> "},{"kind":"typeIdentifier","text":"Bool","preciseIdentifier":"s:Sb"}],"roleHeading":"Instance Method","externalID":"s:4GLib19PatternSpecProtocolPAAE12patternMatch12stringLength0G00G8ReversedSbSi_SPys4Int8VGSgAKtF::SYNTHESIZED::s:4GLib14PatternSpecRefV","platforms":[]},"identifier":{"interfaceLanguage":"swift","url":"doc:\/\/GLib\/documentation\/GLib\/PatternSpecRef\/patternMatch(stringLength:string:stringReversed:)"},"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/glib\/patternspecref\/patternmatch(stringlength:string:stringreversed:)"]}],"primaryContentSections":[{"kind":"declarations","declarations":[{"tokens":[{"kind":"keyword","text":"func"},{"kind":"text","text":" "},{"kind":"identifier","text":"patternMatch"},{"text":"(","kind":"text"},{"kind":"externalParam","text":"stringLength"},{"text":": ","kind":"text"},{"text":"Int","kind":"typeIdentifier","preciseIdentifier":"s:Si"},{"text":", ","kind":"text"},{"text":"string","kind":"externalParam"},{"kind":"text","text":": "},{"kind":"typeIdentifier","preciseIdentifier":"s:SP","text":"UnsafePointer"},{"kind":"text","text":"<"},{"kind":"typeIdentifier","preciseIdentifier":"c:@T@gchar","text":"gchar"},{"text":">!, ","kind":"text"},{"text":"stringReversed","kind":"externalParam"},{"kind":"text","text":": "},{"text":"UnsafePointer","preciseIdentifier":"s:SP","kind":"typeIdentifier"},{"text":"<","kind":"text"},{"preciseIdentifier":"c:@T@gchar","kind":"typeIdentifier","text":"gchar"},{"text":">? = nil) -> ","kind":"text"},{"text":"Bool","kind":"typeIdentifier","preciseIdentifier":"s:Sb"}],"platforms":["macOS"],"languages":["swift"]}]},{"content":[{"level":2,"type":"heading","text":"Discussion","anchor":"discussion"},{"inlineContent":[{"type":"text","text":"Passing the correct"},{"text":" ","type":"text"},{"type":"text","text":"length of the string given is mandatory. The reversed string can be"},{"type":"text","text":" "},{"type":"text","text":"omitted by passing "},{"code":"NULL","type":"codeVoice"},{"text":", this is more efficient if the reversed","type":"text"},{"text":" ","type":"text"},{"text":"version of the string to be matched is not at hand, as","type":"text"},{"text":" ","type":"text"},{"type":"codeVoice","code":"g_pattern_match()"},{"type":"text","text":" will only construct it if the compiled pattern"},{"type":"text","text":" "},{"type":"text","text":"requires reverse matches."}],"type":"paragraph"},{"inlineContent":[{"text":"Note that, if the user code will (possibly) match a string against a","type":"text"},{"type":"text","text":" "},{"type":"text","text":"multitude of patterns containing wildcards, chances are high that"},{"type":"text","text":" "},{"text":"some patterns will require a reversed string. In this case, it’s","type":"text"},{"text":" ","type":"text"},{"type":"text","text":"more efficient to provide the reversed string to avoid multiple"},{"type":"text","text":" "},{"text":"constructions thereof in the various calls to ","type":"text"},{"code":"g_pattern_match()","type":"codeVoice"},{"text":".","type":"text"}],"type":"paragraph"},{"type":"paragraph","inlineContent":[{"text":"Note also that the reverse of a UTF-8 encoded string can in general","type":"text"},{"type":"text","text":" "},{"type":"text","text":"not be obtained by [func"},{"type":"codeVoice","code":"GLib.strreverse"},{"type":"text","text":"]. This works only if the string"},{"type":"text","text":" "},{"type":"text","text":"does not contain any multibyte characters. GLib offers the"},{"type":"text","text":" "},{"type":"text","text":"[func"},{"type":"codeVoice","code":"GLib.utf8_strreverse"},{"text":"] function to reverse UTF-8 encoded strings.","type":"text"}]},{"inlineContent":[{"inlineContent":[{"type":"text","text":"pattern_match is deprecated:"}],"type":"strong"},{"type":"text","text":" "},{"type":"text","text":"Use [method@GLib.PatternSpec.match] instead"}],"type":"paragraph"}],"kind":"content"}],"schemaVersion":{"patch":0,"major":0,"minor":3},"abstract":[{"type":"text","text":"Matches a string against a compiled pattern."}],"references":{"doc://GLib/documentation/GLib/PatternSpecRef/patternMatch(stringLength:string:stringReversed:)":{"title":"patternMatch(stringLength:string:stringReversed:)","role":"symbol","kind":"symbol","identifier":"doc:\/\/GLib\/documentation\/GLib\/PatternSpecRef\/patternMatch(stringLength:string:stringReversed:)","deprecated":true,"url":"\/documentation\/glib\/patternspecref\/patternmatch(stringlength:string:stringreversed:)","fragments":[{"kind":"keyword","text":"func"},{"text":" ","kind":"text"},{"text":"patternMatch","kind":"identifier"},{"text":"(","kind":"text"},{"kind":"externalParam","text":"stringLength"},{"text":": ","kind":"text"},{"kind":