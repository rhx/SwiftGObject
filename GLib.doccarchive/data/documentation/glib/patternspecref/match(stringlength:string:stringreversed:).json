"identifier"},{"kind":"text","text":"("},{"kind":"externalParam","text":"stringLength"},{"kind":"text","text":": "},{"preciseIdentifier":"s:Si","text":"Int","kind":"typeIdentifier"},{"text":", ","kind":"text"},{"kind":"externalParam","text":"string"},{"text":": ","kind":"text"},{"text":"UnsafePointer","kind":"typeIdentifier","preciseIdentifier":"s:SP"},{"text":"<","kind":"text"},{"kind":"typeIdentifier","text":"gchar","preciseIdentifier":"c:@T@gchar"},{"kind":"text","text":">!, "},{"kind":"externalParam","text":"stringReversed"},{"kind":"text","text":": "},{"text":"UnsafePointer","kind":"typeIdentifier","preciseIdentifier":"s:SP"},{"kind":"text","text":"<"},{"preciseIdentifier":"c:@T@gchar","text":"gchar","kind":"typeIdentifier"},{"text":">? = nil) -> ","kind":"text"},{"preciseIdentifier":"s:Sb","kind":"typeIdentifier","text":"Bool"}]}]},{"kind":"content","content":[{"type":"heading","text":"Discussion","anchor":"discussion","level":2},{"type":"paragraph","inlineContent":[{"text":"Passing the correct","type":"text"},{"type":"text","text":" "},{"type":"text","text":"length of the string given is mandatory. The reversed string can be"},{"type":"text","text":" "},{"type":"text","text":"omitted by passing "},{"code":"NULL","type":"codeVoice"},{"text":", this is more efficient if the reversed","type":"text"},{"type":"text","text":" "},{"type":"text","text":"version of the string to be matched is not at hand, as"},{"text":" ","type":"text"},{"type":"text","text":"[method"},{"type":"codeVoice","code":"GLib.PatternSpec.match"},{"type":"text","text":"] will only construct it if the compiled pattern"},{"type":"text","text":" "},{"text":"requires reverse matches.","type":"text"}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"Note that, if the user code will (possibly) match a string against a"},{"type":"text","text":" "},{"text":"multitude of patterns containing wildcards, chances are high that","type":"text"},{"type":"text","text":" "},{"text":"some patterns will require a reversed string. In this case, it’s","type":"text"},{"type":"text","text":" "},{"type":"text","text":"more efficient to provide the reversed string to avoid multiple"},{"type":"text","text":" "},{"type":"text","text":"constructions thereof in the various calls to [method"},{"type":"codeVoice","code":"GLib.PatternSpec.match"},{"text":"].","type":"text"}]},{"inlineContent":[{"type":"text","text":"Note also that the reverse of a UTF-8 encoded string can in general"},{"type":"text","text":" "},{"type":"text","text":"not be obtained by [func"},{"code":"GLib.strreverse","type":"codeVoice"},{"type":"text","text":"]. This works only if the string"},{"type":"text","text":" "},{"text":"does not contain any multibyte characters. GLib offers the","type":"text"},{"text":" ","type":"text"},{"type":"text","text":"[func"},{"code":"GLib.utf8_strreverse","type":"codeVoice"},{"type":"text","text":"] function to reverse UTF-8 encoded strings."}],"type":"paragraph"}]}],"schemaVersion":{"major":0,"patch":0,"minor":3},"abstract":[{"type":"text","text":"Matches a string against a compiled pattern."}],"references":{"doc://GLib/documentation/GLib/PatternSpecRef":{"url":"\/documentation\/glib\/patternspecref","role":"symbol","navigatorTitle":[{"text":"PatternSpecRef","kind":"identifier"}],"identifier":"doc:\/\/GLib\/documentation\/GLib\/PatternSpecRef","abstract":[{"type":"text","text":"A "},{"code":"GPatternSpec","type":"codeVoice"},{"type":"text","text":" struct is the ‘compiled’ form of a glob-style pattern."}],"title":"PatternSpecRef","kind":"symbol","fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"PatternSpecRef","kind":"identifier"}],"type":"topic"},"doc://GLib/documentation/GLib/PatternSpecRef/match(stringLength:string:stringReversed:)":{"title":"match(stringLength:string:stringReversed:)","kind":"symbol","url":"\/documentation\/glib\/patternspecref\/match(stringlength:string:stringreversed:)","fragments":[{"kind":"keyword","text":"func"}