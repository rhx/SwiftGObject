 = nil)"}],"platforms":["macOS"]}]},{"content":[{"anchor":"discussion","level":2,"text":"Discussion","type":"heading"},{"type":"paragraph","inlineContent":[{"text":"Note that threads may decide to exit while ","type":"text"},{"type":"codeVoice","code":"threadFunc"},{"text":" is","type":"text"},{"text":" ","type":"text"},{"type":"text","text":"running, so without intimate knowledge about the lifetime of"},{"text":" ","type":"text"},{"type":"text","text":"foreign threads, "},{"type":"codeVoice","code":"threadFunc"},{"type":"text","text":" shouldn’t access the GThread*"},{"type":"text","text":" "},{"text":"pointer passed in as first argument. However, ","type":"text"},{"code":"threadFunc","type":"codeVoice"},{"type":"text","text":" will"},{"type":"text","text":" "},{"type":"text","text":"not be called for threads which are known to have exited already."}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"Due to thread lifetime checks, this function has an execution complexity"},{"text":" ","type":"text"},{"type":"text","text":"which is quadratic in the number of existing threads."}]},{"inlineContent":[{"type":"strong","inlineContent":[{"type":"text","text":"thread_foreach is deprecated:"}]},{"type":"text","text":" "},{"text":"There aren’t many things you can do with a #GThread,","type":"text"},{"type":"text","text":" "},{"type":"text","text":"except comparing it with one that was returned from g_thread_create()."},{"text":" ","type":"text"},{"text":"There are better ways to find out if your thread is still alive.","type":"text"}],"type":"paragraph"}],"kind":"content"}],"schemaVersion":{"patch":0,"major":0,"minor":3},"references":{"doc://GLib/documentation/GLib/threadForeach(threadFunc:userData:)":{"abstract":[{"text":"Call ","type":"text"},{"type":"codeVoice","code":"threadFunc"},{"text":" on all ","type":"text"},{"type":"codeVoice","code":"GThreads"},{"type":"text","text":" that have been"},{"type":"text","text":" "},{"type":"text","text":"created with "},{