{"sections":[],"identifier":{"interfaceLanguage":"swift","url":"doc:\/\/GLib\/documentation\/GLib\/DateTimeRef\/getWeekNumberingYear()"},"abstract":[{"type":"text","text":"Returns the ISO 8601 week-numbering year in which the week containing"},{"type":"text","text":" "},{"code":"datetime","type":"codeVoice"},{"text":" falls.","type":"text"}],"metadata":{"symbolKind":"method","roleHeading":"Instance Method","extendedModule":"GLib","externalID":"s:4GLib16DateTimeProtocolPAAE20getWeekNumberingYearSiyF::SYNTHESIZED::s:4GLib11DateTimeRefV","modules":[{"name":"GLib"}],"title":"getWeekNumberingYear()","fragments":[{"kind":"keyword","text":"func"},{"text":" ","kind":"text"},{"text":"getWeekNumberingYear","kind":"identifier"},{"kind":"text","text":"() -> "},{"preciseIdentifier":"s:Si","text":"Int","kind":"typeIdentifier"}],"role":"symbol"},"kind":"symbol","primaryContentSections":[{"declarations":[{"languages":["swift"],"platforms":["macOS"],"tokens":[{"kind":"keyword","text":"func"},{"kind":"text","text":" "},{"text":"getWeekNumberingYear","kind":"identifier"},{"text":"() -> ","kind":"text"},{"kind":"typeIdentifier","text":"Int","preciseIdentifier":"s:Si"}]}],"kind":"declarations"},{"kind":"content","content":[{"text":"Discussion","level":2,"type":"heading","anchor":"discussion"},{"type":"paragraph","inlineContent":[{"text":"This function, taken together with ","type":"text"},{"type":"codeVoice","code":"g_date_time_get_week_of_year()"},{"type":"text","text":" and"},{"type":"text","text":" "},{"code":"g_date_time_get_day_of_week()","type":"codeVoice"},{"type":"text","text":" can be used to determine the full ISO"},{"type":"text","text":" "},{"text":"week date on which ","type":"text"},{"type":"codeVoice","code":"datetime"},{"type":"text","text":" falls."}]},{"inlineContent":[{"type":"text","text":"This is usually equal to the normal Gregorian year (as returned by"},{"text":" ","type":"text"},{"type":"codeVoice","code":"g_date_time_get_year()"},{"text":"), except as detailed below:","type":"text"}],"type":"paragraph"},{"type":"paragraph","inlineContent":[{"text":"For Thursday, the week-numbering year is always equal to the usual","type":"text"},{"text":" ","type":"text"},{"text":"calendar year.  For other days, the number is such that every day","type":"text"},{"type":"text","text":" "},{"type":"text","text":"within a complete week (Monday to Sunday) is contained within the"},{"text":" ","type":"text"},{"type":"text","text":"same week-numbering year."}]},{"inlineContent":[{"text":"For Monday, Tuesday and Wednesday occurring near the end of the year,","type":"text"},{"text":" ","type":"text"},{"text":"this may mean that the week-numbering year is one greater than the","type":"text"},{"type":"text","text":" "},{"text":"calendar year (so that these days have the same week-numbering year","type":"text"},{"text":" ","type":"text"},{"type":"text","text":"as the Thursday occurring early in the next year)."}],"type":"paragraph"},{"inlineContent":[{"type":"text","text":"For Friday, Saturday and Sunday occurring near the start of the year,"},{"text":" ","type":"text"},{"text":"this may mean that the week-numbering year is one less than the","type":"text"},{"text":" ","type":"text"},{"type":"text","text":"calendar year (so that these days have the same week-numbering year"},{"type":"text","text":" "},{"type":"text","text":"as the Thursday occurring late in the previous year)."}],"type":"paragraph"},{"inlineContent":[{"type":"text","text":"An equivalent description is that the week-numbering year is equal to"},{"text":" ","type":"text"},{"text":"the calendar year containing the majority of the days in the current","type":"text"},{"text":" ","type":"text"},{"type":"text","text":"week (Monday to Sunday)."}],"type":"paragraph"},{"inlineContent":[{"text":"Note that January 1 0001 in the proleptic Gregorian calendar is a","type":"text"},{"type":"text","text":" "},{"text":"Monday, so this function never returns 0.","type":"text"}],"type":"paragraph"}]}],"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/glib\/datetimeref\/getweeknumberingyear()"]}],"schemaVersion":{"minor":3,"major":0,"patch":0},"hierarchy":{"paths":[["doc:\/\/GLib\/documentation\/GLib","doc:\/\/GLib\/documentation\/GLib\/DateTimeRef","doc:\/\/GLib\/documentation\/GLib\/DateTimeRef\/DateTimeProtocol-Implementations"]]},"references":{"doc://GLib/documentation/GLib":{"identifier":"doc:\/\/GLib\/documentation\/GLib","title":"GLib","abstract":[],"type":"topic","url":"\/documentation\/glib","kind":"symbol","role":"collection"},"doc://GLib/documentation/GLib/DateTimeRef":{"title":"DateTimeRef","fragments":[{"kind":"keyword","text":"struct"},{"text":" ","kind":"text"},{"kind":"identifier","text":"DateTimeRef"}],"navigatorTitle":[{"text":"DateTimeRef","kind":"identifier"}],"identifier":"doc:\/\/GLib\/documentation\/GLib\/DateTimeRef","type":"topic","role":"symbol","abstract":[{"code":"GDateTime","type":"codeVoice"},{"type":"text","text":" is a structure that combines a Gregorian date and time"},{"text":" ","type":"text"},{"text":"into a single structure.","type":"text"}],"kind":"symbol","url":"\/documentation\/glib\/datetimeref"},"doc://GLib/documentation/GLib/DateTimeRef/getWeekNumberingYear()":{"url":"\/documentation\/glib\/datetimeref\/getweeknumberingyear()","role":"symbol","abstract":[{"type":"text","text":"Returns the ISO 8601 week-numbering year in which the week containing"},{"type":"text","text":" "},{"type":"codeVoice","code":"datetime"},{"text":" falls.","type":"text"}],"fragments":[{"kind":"keyword","text":"func"},{"text":" ","kind":"text"},{"text":"getWeekNumberingYear","kind":"identifier"},{"text":"() -> ","kind":"text"},{"preciseIdentifier":"s:Si","kind":"typeIdentifier","text":"Int"}],"type":"topic","identifier":"doc:\/\/GLib\/documentation\/GLib\/DateTimeRef\/getWeekNumberingYear()","title":"getWeekNumberingYear()","kind":"symbol"},"doc://GLib/documentation/GLib/DateTimeRef/DateTimeProtocol-Implementations":{"