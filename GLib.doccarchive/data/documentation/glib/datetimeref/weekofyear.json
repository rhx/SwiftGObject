{"abstract":[{"text":"Returns the ISO 8601 week number for the week containing ","type":"text"},{"code":"datetime","type":"codeVoice"},{"type":"text","text":"."},{"text":" ","type":"text"},{"type":"text","text":"The ISO 8601 week number is the same for every day of the week (from"},{"text":" ","type":"text"},{"text":"Moday through Sunday).  That can produce some unusual results","type":"text"},{"type":"text","text":" "},{"text":"(described below).","type":"text"}],"identifier":{"interfaceLanguage":"swift","url":"doc:\/\/GLib\/documentation\/GLib\/DateTimeRef\/weekOfYear"},"schemaVersion":{"major":0,"minor":3,"patch":0},"primaryContentSections":[{"kind":"declarations","declarations":[{"platforms":["macOS"],"tokens":[{"text":"var","kind":"keyword"},{"text":" ","kind":"text"},{"kind":"identifier","text":"weekOfYear"},{"kind":"text","text":": "},{"text":"Int","kind":"typeIdentifier","preciseIdentifier":"s:Si"},{"text":" { ","kind":"text"},{"text":"get","kind":"keyword"},{"kind":"text","text":" }"}],"languages":["swift"]}]},{"kind":"content","content":[{"anchor":"discussion","type":"heading","text":"Discussion","level":2},{"inlineContent":[{"type":"text","text":"The first week of the year is week 1.  This is the week that contains"},{"type":"text","text":" "},{"type":"text","text":"the first Thursday of the year.  Equivalently, this is the first week"},{"type":"text","text":" "},{"text":"that has more than 4 of its days falling within the calendar year.","type":"text"}],"type":"paragraph"},{"type":"paragraph","inlineContent":[{"type":"text","text":"The value 0 is never returned by this function.  Days contained"},{"type":"text","text":" "},{"text":"within a year but occurring before the first ISO 8601 week of that","type":"text"},{"type":"text","text":" "},{"type":"text","text":"year are considered as being contained in the last week of the"},{"type":"text","text":" "},{"text":"previous year.  Similarly, the final days of a calendar year may be","type":"text"},{"type":"text","text":" "},{"type":"text","text":"considered as being part of the first ISO 8601 week of the next year"},{"text":" ","type":"text"},{"text":"if 4 or more days of that week are contained within the new year.","type":"text"}]}]}],"hierarchy":{"paths":[["doc:\/\/GLib\/documentation\/GLib","doc:\/\/GLib\/documentation\/GLib\/DateTimeRef","doc:\/\/GLib\/documentation\/GLib\/DateTimeRef\/DateTimeProtocol-Implementations"]]},"variants":[{"paths":["\/documentation\/glib\/datetimeref\/weekofyear"],"traits":[{"interfaceLanguage":"swift"}]}],"sections":[],"kind":"symbol","metadata":{"extendedModule":"GLib","title":"weekOfYear","roleHeading":"Instance Property","symbolKind":"property","fragments":[{"kind":"keyword","text":"var"},{"kind":"text","text":" "},{"text":"weekOfYear","kind":"identifier"},{"kind":"text","text":": "},{"preciseIdentifier":"s:Si","text":"Int","kind":"typeIdentifier"}],"role":"symbol","externalID":"s:4GLib16DateTimeProtocolPAAE10weekOfYearSivp::SYNTHESIZED::s:4GLib11DateTimeRefV","modules":[{"name":"GLib"}]},"references":{"doc://GLib/documentation/GLib/DateTimeRef/DateTimeProtocol-Implementations":{"kind":"article","title":"DateTimeProtocol Implementations","url":"\/documentation\/glib\/datetimeref\/datetimeprotocol-implementations","role":"collectionGroup","type":"topic","identifier":"doc:\/\/GLib\/documentation\/GLib\/DateTimeRef\/DateTimeProtocol-Implementations","abstract":[]},"doc://GLib/documentation/GLib/DateTimeRef":{"title":"DateTimeRef","fragments":[{"kind":"keyword","text":"struct"},{"text":" ","kind":"text"},{"kind":"identifier","text":"DateTimeRef"}],"navigatorTitle":[{"text":"DateTimeRef","kind":"identifier"}],"identifier":"doc:\/\/GLib\/documentation\/GLib\/DateTimeRef","type":"topic","role":"symbol","abstract":[{"code":"GDateTime","type":"codeVoice"},{"type":"text","text":" is a structure that combines a Gregorian date and time"},{"text":" ","type":"text"},{"text":"into a single structure.","type":"text"}],"kind":"symbol","url":"\/docu