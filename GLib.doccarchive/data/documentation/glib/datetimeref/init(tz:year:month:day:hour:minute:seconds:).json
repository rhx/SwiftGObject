ext","text":" must be between 0 and 23 and "},{"type":"codeVoice","code":"minute"},{"type":"text","text":" must be between 0 and 59."}]},{"inlineContent":[{"type":"codeVoice","code":"seconds"},{"text":" must be at least 0.0 and must be strictly less than 60.0.","type":"text"},{"text":" ","type":"text"},{"type":"text","text":"It will be rounded down to the nearest microsecond."}],"type":"paragraph"},{"inlineContent":[{"type":"text","text":"If the given time is not representable in the given time zone (for"},{"text":" ","type":"text"},{"text":"example, 02:30 on March 14th 2010 in Toronto, due to daylight savings","type":"text"},{"text":" ","type":"text"},{"text":"time) then the time will be rounded up to the nearest existing time","type":"text"},{"type":"text","text":" "},{"type":"text","text":"(in this case, 03:00).  If this matters to you then you should verify"},{"text":" ","type":"text"},{"type":"text","text":"the return value for containing the same as the numbers you gave."}],"type":"paragraph"},{"type":"paragraph","inlineContent":[{"type":"text","text":"In the case that the given time is ambiguous in the given time zone"},{"text":" ","type":"text"},{"text":"(for example, 01:30 on November 7th 2010 in Toronto, due to daylight","type":"text"},{"type":"text","text":" "},{"type":"text","text":"savings time) then the time falling within standard (ie:"},{"type":"text","text":" "},{"text":"non-daylight) time is taken.","type":"text"}]},{"inlineContent":[{"text":"It not considered a programmer error for the values to this function","type":"text"},{"text":" ","type":"text"},{"type":"text","text":"to be out of range, but in the case that they are, the function will"},{"text":" ","type":"text"},{"type":"text","text":"return "},{"type":"codeVoice","code":"nil"},{"type":"text","text":"."}],"type":"paragraph"},{"type":"paragraph","inlineContent":[{"text":"You should release the return value by calling ","type":"text"},{"code":"g_date_time_unref()","type":"codeVoice"},{"text":" ","type":"text"},{"text":"when you are done with it.","type":"text"}]}],"kind":"content"}],"kind":"symbol","variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/glib\/datetimeref\/init(tz:year:month:day:hour:minute:seconds:)"]}],"hierarchy":{"paths":[["doc:\/\/GLib\/documentation\/GLib","doc:\/\/GLib\/documentation\/GLib\/DateTimeRef"]]},"abstract":[{"text":"Creates a new ","type":"text"},{"type":"reference","isActive":true,"identifier":"doc:\/\/GLib\/documentation\/GLib\/DateTime"},{"text":" corresponding to the given date and time in","type":"text"},{"type":"text","text":" "},{"text":"the time zone ","type":"text"},{"type":"codeVoice","code":"tz"},{"type":"text","text":"."}],"references":{"doc://GLib/documentation/GLib/DateTimeRef/init(tz:year:month:day:hour:minute:seconds:)":{"type":"topic","title":"init(tz:year:month:day:hour:minute:seconds:)","url":"\/documentation\/glib\/datetimeref\/init(tz:year:month:day:hour:minute:seconds:)","role":"symbol","identifier":"doc:\/\/GLib\/documentation\/GLib\/DateTimeRef\/init(tz:year:month:day:hour:minute:seconds:)","abstract":[{"type":"text","text":"Creates a new "},{"identifier":"doc:\/\/GLib\/documentation\/GLib\/DateTime","isActive":true,"type":"reference"},{"type":"text","text":" corresponding to the given date and time in"},{"text":" ","type":"text"},{"text":"the time zone ","type":"text"},{"code":"tz","type":"codeVoice"},{"text":".","type":"text"}],"kind":"symbol","fragments":[{"kind":"identifier","text":"init"},{"kind":"text","text":"<"},{"text":"TimeZoneT","kind":"genericParameter"},{"kind":"text","text":">("},{"text":"tz","kind":"externalParam"},{"text":": ","kind":"text"},{"text":"TimeZoneT","kind":"typeIdentifier"},{"kind":"text","text":", "},{"text":"year","kind":"externalParam"},{"text":": ","kind":"text"},{"preciseIdentifier":"s:Si","text":"Int","kind":"typeIdentifier"},{"kind":"text","text":", "},{"kind":"externalParam","text":"month"},{"text":": ","kind":"text"},{"preciseIdentifi