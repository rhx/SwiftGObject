{"metadata":{"title":"weekNumberingYear","roleHeading":"Instance Property","externalID":"s:4GLib16DateTimeProtocolPAAE17weekNumberingYearSivp::SYNTHESIZED::s:4GLib11DateTimeRefV","modules":[{"name":"GLib"}],"role":"symbol","extendedModule":"GLib","symbolKind":"property","fragments":[{"text":"var","kind":"keyword"},{"text":" ","kind":"text"},{"kind":"identifier","text":"weekNumberingYear"},{"kind":"text","text":": "},{"text":"Int","kind":"typeIdentifier","preciseIdentifier":"s:Si"}]},"abstract":[{"type":"text","text":"Returns the ISO 8601 week-numbering year in which the week containing"},{"type":"text","text":" "},{"type":"codeVoice","code":"datetime"},{"type":"text","text":" falls."}],"identifier":{"interfaceLanguage":"swift","url":"doc:\/\/GLib\/documentation\/GLib\/DateTimeRef\/weekNumberingYear"},"primaryContentSections":[{"declarations":[{"languages":["swift"],"tokens":[{"text":"var","kind":"keyword"},{"text":" ","kind":"text"},{"text":"weekNumberingYear","kind":"identifier"},{"text":": ","kind":"text"},{"kind":"typeIdentifier","text":"Int","preciseIdentifier":"s:Si"},{"text":" { ","kind":"text"},{"text":"get","kind":"keyword"},{"kind":"text","text":" }"}],"platforms":["macOS"]}],"kind":"declarations"},{"content":[{"text":"Discussion","level":2,"type":"heading","anchor":"discussion"},{"type":"paragraph","inlineContent":[{"type":"text","text":"This function, taken together with "},{"code":"g_date_time_get_week_of_year()","type":"codeVoice"},{"text":" and","type":"text"},{"type":"text","text":" "},{"type":"codeVoice","code":"g_date_time_get_day_of_week()"},{"type":"text","text":" can be used to determine the full ISO"},{"text":" ","type":"text"},{"text":"week date on which ","type":"text"},{"type":"codeVoice","code":"datetime"},{"text":" falls.","type":"text"}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"This is usually equal to the normal Gregorian year (as returned by"},{"text":" ","type":"text"},{"type":"codeVoice","code":"g_date_time_get_year()"},{"type":"text","text":"), except as detailed below:"}]},{"inlineContent":[{"text":"For Thursday, the week-numbering year is always equal to the usual","type":"text"},{"text":" ","type":"text"},{"type":"text","text":"calendar year.  For other days, the number is such that every day"},{"text":" ","type":"text"},{"type":"text","text":"within a complete week (Monday to Sunday) is contained within the"},{"type":"text","text":" "},{"text":"same week-numbering year.","type":"text"}],"type":"paragraph"},{"inlineContent":[{"text":"For Monday, Tuesday and Wednesday occurring near the end of the year,","type":"text"},{"text":" ","type":"text"},{"type":"text","text":"this may mean that the week-numbering year is one greater than the"},{"type":"text","text":" "},{"type":"text","text":"calendar year (so that these days have the same week-numbering year"},{"text":" ","type":"text"},{"text":"as the Thursday occurring early in the next year).","type":"text"}],"type":"paragraph"},{"type":"paragraph","inlineContent":[{"text":"For Friday, Saturday and Sunday occurring near the start of the year,","type":"text"},{"text":" ","type":"text"},{"type":"text","text":"this may mean that the week-numbering year is one less than the"},{"type":"text","text":" "},{"type":"text","text":"calendar year (so that these days have the same week-numbering year"},{"type":"text","text":" "},{"text":"as the Thursday occurring late in the previous year).","type":"text"}]},{"inlineContent":[{"type":"text","text":"An equivalent description is that the week-numbering year is equal to"},{"text":" ","type":"text"},{"text":"the calendar year containing the majority of the days in the current","type":"text"},{"text":" ","type":"text"},{"type":"text","text":"week (Monday to Sunday)."}],"type":"paragraph"},{"type":"paragraph","inlineContent":[{"type":"text","text":"Note that January 1 0001 in the proleptic Gregorian calendar is a"},{"text":" ","type":"text"},{"text":"Monday, so this function never returns 0.","type":"text"}]}],"kind":"content"}],"sections":[],"schemaVersion":{"minor":3,"major":0,"patch":0},"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/glib\/datetimeref\/weeknumberingyear"]}],"kind":"symbol","hierarchy":{"paths":[["doc:\/\/GLib\/documentation\/GLib","doc:\/\/GLib\/documentation\/GLib\/DateTimeRef","doc:\/\/GLib\/documentation\/GLib\/DateTimeRef\/DateTimeProtocol-Implementations"]]},"references":{"doc://GLib/documentation/GLib":{"identifier":"doc:\/\/GLib\/documentation\/GLib","title":"GLib","abstract":[],"type":"topic","url":"\/documentation\/glib","kind":"symbol","role":"collection"},"doc://GLib/documentation/GLib/DateTimeRef":{"title":"DateTimeRef","fragments":[{"kind":"keyword","text":"struct"},{"text":" ","kind":"text"},{"kind":"identifier","text":"DateTimeRef"}],"navigatorTitle":[{"text":"DateTimeRef","kind":"identifier"}],"identifier":"doc:\/\/GLib\/documentation\/GLib\/DateTimeRef","type":"topic","role":"symbol","abstract":[{"code":"GDateTime","type":"codeVoice"},{"type":"text","text":" is a structure that combines a Gregorian date and time"},{"text":" ","type":"text"},{"text":"into a single structure.","type":"text"}],"kind":"symbol","url":"\/documentation\/glib\/datetimeref"},"doc://GLib/documentation/GLib/DateTimeRef/weekNumberingYear":{"title":"weekNumberingYear","fragments":[{"text":"var","kind":"keyword"},{"kind":"text","text":" "},{"kind":"identifier","text":"weekNumberingYear"},{"kind":"text","text":": "},{"kind":"typeIdentifier","preciseIdentifier":"s:Si","text":"Int"}],"url":"\/documentation\/glib\/datetimeref\/weeknumberingyear","type":"topic","identifier":"doc:\/\/GLib\/documentation\/GLib\/DateTimeRef\/weekNumberingYear","role":"symbol","kind":"symbol","abstract":[{"text":"Returns the ISO 8601 week-numbering year in which the week containing","type":"text"},{"text":" ","type":"text"},{"code":"datetime","type":"codeVoice"},{"text":" falls.","type":"text"}]},"doc://GLib/documentation/GLib/DateTimeRef/DateTimeProtocol-Implementations":{"kind":"article","title":"DateTimeProtocol Implementations","url":"\/documentation\/glib\/datetimeref\/datetimeprotocol-implementations","role":"collectionGroup","type":"topic","identifier":"doc:\/\/GLib\/documentation\/GLib\/DateTimeRef\/DateTimeProtocol-Implementations","abstract":[]}}}