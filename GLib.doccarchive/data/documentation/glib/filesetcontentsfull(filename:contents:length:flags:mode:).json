{"abstract":[{"text":"Writes all of ","type":"text"},{"code":"contents","type":"codeVoice"},{"text":" to a file named ","type":"text"},{"code":"filename","type":"codeVoice"},{"type":"text","text":", with good error checking."},{"text":" ","type":"text"},{"text":"If a file called ","type":"text"},{"type":"codeVoice","code":"filename"},{"type":"text","text":" already exists it will be overwritten."}],"sections":[],"identifier":{"interfaceLanguage":"swift","url":"doc:\/\/GLib\/documentation\/GLib\/fileSetContentsFull(filename:contents:length:flags:mode:)"},"schemaVersion":{"minor":3,"patch":0,"major":0},"variants":[{"paths":["\/documentation\/glib\/filesetcontentsfull(filename:contents:length:flags:mode:)"],"traits":[{"interfaceLanguage":"swift"}]}],"hierarchy":{"paths":[["doc:\/\/GLib\/documentation\/GLib"]]},"primaryContentSections":[{"kind":"declarations","declarations":[{"tokens":[{"text":"func","kind":"keyword"},{"kind":"text","text":" "},{"text":"fileSetContentsFull","kind":"identifier"},{"text":"(","kind":"text"},{"kind":"externalParam","text":"filename"},{"kind":"text","text":": "},{"text":"UnsafePointer","kind":"typeIdentifier","preciseIdentifier":"s:SP"},{"text":"<","kind":"text"},{"text":"gchar","kind":"typeIdentifier","preciseIdentifier":"c:@T@gchar"},{"text":">!, ","kind":"text"},{"text":"contents","kind":"externalParam"},{"kind":"text","text":": "},{"text":"UnsafePointer","preciseIdentifier":"s:SP","kind":"typeIdentifier"},{"text":"<","kind":"text"},{"kind":"typeIdentifier","text":"gchar","preciseIdentifier":"c:@T@gchar"},{"text":">!, ","kind":"text"},{"kind":"externalParam","text":"length"},{"kind":"text","text":": "},{"text":"gssize","preciseIdentifier":"c:@T@gssize","kind":"typeIdentifier"},{"text":", ","kind":"text"},{"kind":"externalParam","text":"flags"},{"text":": ","kind":"text"},{"identifier":"doc:\/\/GLib\/documentation\/GLib\/FileSetContentsFlags","text":"FileSetContentsFlags","kind":"typeIdentifier","preciseIdentifier":"s:4GLib20FileSetContentsFlagsV"},{"text":", ","kind":"text"},{"text":"mode","kind":"externalParam"},{"kind":"text","text":": "},{"text":"Int","preciseIdentifier":"s:Si","kind":"typeIdentifier"},{"text":") ","kind":"text"},{"text":"throws","kind":"keyword"},{"text":" -> ","kind":"text"},{"kind":"typeIdentifier","preciseIdentifier":"s:Sb","text":"Bool"}],"platforms":["macOS"],"languages":["swift"]}]},{"content":[{"type":"heading","anchor":"discussion","level":2,"text":"Discussion"},{"inlineContent":[{"code":"flags","type":"codeVoice"},{"type":"text","text":" control the properties of the write operation: whether it’s atomic,"},{"type":"text","text":" "},{"text":"and what the tradeoff is between returning quickly or being resilient to","type":"text"},{"text":" ","type":"text"},{"type":"text","text":"system crashes."}],"type":"paragraph"},{"type":"paragraph","inlineContent":[{"type":"text","text":"As this function performs file I\/O, it is recommended to not call it anywhere"},{"text":" ","type":"text"},{"type":"text","text":"where blocking would cause problems, such as in the main loop of a graphical"},{"type":"text","text":" "},{"type":"text","text":"application. In particular, if "},{"code":"flags","type":"codeVoice"},{"text":" has any value other than","type":"text"},{"type":"text","text":" "},{"code":"none","type":"codeVoice"},{"type":"text","text":" then this function may call "},{"type":"codeVoice","code":"fsync()"},{"type":"text","text":"."}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"If "},{"code":"consistent","type":"codeVoice"},{"text":" is set in ","type":"text"},{"type":"codeVoice","code":"flags"},{"type":"text","text":", the operation is atomic"},{"text":" ","type":"text"},{"type":"text","text":"in the sense that it is first written to a temporary file which is then"},{"type":"text","text":" "},{"type":"text","text":"renamed to the final name."}]},{"inlineContent":[{"type":"text","text":"Notes:"}],"type":"paragraph"},{"items":[{"content":[{"inlineContent":[{"text":"On UNIX, if ","type":"text"},{"type":"codeVoice","code":"filename"},{"text":" already exists hard links to ","type":"text"},{"type":"codeVoice","code":"filename"},{"text":" will break.","type":"text"},{"type":"text","text":" "},{"type":"text","text":"Also since the file is recreated, existing permissions, access control"},{"type":"text","text":" "},{"text":"lists, metadata etc. may be lost. If ","type":"text"},{"type":"codeVoice","code":"filename"},{"type":"text","text":" is a symbolic link,"},{"text":" ","type":"text"},{"type":"text","text":"the link itself will be replaced, not the linked file."}],"type":"paragraph"}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"On UNIX, if "},{"type":"codeVoice","code":"filename"},{"text":" already exists and is non-empty, and if the system","type":"text"},{"text":" ","type":"text"},{"type":"text","text":"supports it (via a journalling filesystem or equivalent), and if"},{"type":"text","text":" "},{"type":"codeVoice","code":"consistent"},{"type":"text","text":" is set in "},{"type":"codeVoice","code":"flags"},{"text":", the ","type":"text"},{"type":"codeVoice","code":"fsync()"},{"type":"text","text":" call (or"},{"type":"text","text":" "},{"text":"equivalent) will be used to ensure atomic replacement: ","type":"text"},{"type":"codeVoice","code":"filename"},{"type":"text","text":" "},{"type":"text","text":"will contain either its old contents or "},{"type":"codeVoice","code":"contents"},{"type":"text","text":", even in the face of"},{"type":"text","text":" "},{"text":"system power loss, the disk being unsafely removed, etc.","type":"text"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"On UNIX, if "},{"type":"codeVoice","code":"filename"},{"text":" does not already exist or is empty, there is a","type":"text"},{"text":" ","type":"text"},{"type":"text","text":"possibility that system power loss etc. after calling this function will"},{"type":"text","text":" "},{"type":"text","text":"leave "},{"type":"codeVoice","code":"filename"},{"text":" empty or full of NUL bytes, depending on the underlying","type":"text"},{"text":" ","type":"text"},{"type":"text","text":"filesystem, unless "},{"code":"durable","type":"codeVoice"},{"text":" and","type":"text"},{"type":"text","text":" "},{"type":"codeVoice","code":"consistent"},{"type":"text","text":" are set in "},{"type":"codeVoice","code":"flags"},{"text":".","type":"text"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"On Windows renaming a file will not remove an existing file with the"},{"type":"text","text":" "},{"text":"new name, so on Windows there is a race condition between the existing","type":"text"},{"type":"text","text":" "},{"type":"text","text":"file being removed and the temporary file being renamed."}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"On Windows there is no way to remove a file that is open to some"},{"text":" ","type":"text"},{"text":"process, or mapped into memory. Thus, this function will fail if","type":"text"},{"type":"text","text":" "},{"type":"codeVoice","code":"filename"},{"type":"text","text":" already exists and is open."}]}]}],"type":"unorderedList"},{"type":"paragraph","inlineContent":[{"type":"text","text":"If the call was successful, it returns "},{"type":"codeVoice","code":"true"},{"text":". If the call was not successful,","type":"text"},{"type":"text","text":" "},{"text":"it returns ","type":"text"},{"type":"codeVoice","code":"false"},{"type":"text","text":" and sets "},{"type":"codeVoice","code":"error"},{"text":". The error domain is ","type":"text"},{"type":"codeVoice","code":"G_FILE_ERROR"},{"text":".","type":"text"},{"type":"text","text":" "},{"type":"text","text":"Possible error codes are those in the "},{"isActive":true,"type":"reference","identifier":"doc:\/\/GLib\/documentation\/GLib\/FileError"},{"type":"text","text":" enumeration."}]},{"inlineContent":[{"text":"Note that the name for the temporary file is constructed by appending up","type":"text"},{"type":"text","text":" "},{"type":"text","text":"to 7 characters to "},{"code":"filename","type":"codeVoice"},{"text":".","type":"text"}],"type":"paragraph"},{"type":"paragraph","inlineContent":[{"text":"If the file didn’t exist before and is created, it will be given the","type":"text"},{"type":"text","text":" "},{"text":"permissions from ","type":"text"},{"type":"codeVoice","code":"mode"},{"type":"text","text":". Otherwise, the permissions of the existing file will"},{"type":"text","text":" "},{"text":"remain unchanged.","type":"text"}]}],"kind":"content"}],"kind":"symbol","metadata":{"modules":[{"name":"GLib"}],"externalID":"s:4GLib19fileSetContentsFull8filename8contents6length5flags4modeSbSPys4Int8VGSg_AKSiAA04FilecD5FlagsVSitKF","title":"fileSetContentsFull(filename:contents:length:flags:mode:)","symbolKind":"func","fragments":[{"kind":"keyword","text":"func"},{"text":" ","kind":"text"},{"text":"fileSetContentsFull","kind":"identifier"},{"kind":"text","text":"("},{"text":"filename","kind":"externalParam"},{"text":": ","kind":"text"},{"text":"UnsafePointer","kind":"typeIdentifier","preciseIdentifier":"s:SP"},{"text":"<","kind":"text"},{"text":"gchar","kind":"typeIdentifier","preciseIdentifier":"c:@T@gchar"},{"text":">!, ","kind":"text"},{"kind":"externalParam","text":"contents"},{"text":": ","kind":"text"},{"kind":"typeIdentifier","preciseIdentifier":"s:SP","text":"UnsafePointer"},{"kind":"text","text":"<"},{"text":"gchar","kind":"typeIdentifier","preciseIdentifier":"c:@T@gchar"},{"text":">!, ","kind":"text"},{"text":"length","kind":"externalParam"},{"text":": ","kind":"text"},{"text":"gssize","kind":"typeIdentifier","preciseIdentifier":"c:@T@gssize"},{"kind":"text","text":", "},{"kind":"externalParam","text":"flags"},{"text":": ","kind":"text"},{"kind":"typeIdentifier","text":"FileSetContentsFlags","preciseIdentifier":"s:4GLib20FileSetContentsFlagsV"},{"kind":"text","text":", "},{"kind":"externalParam","text":"mode"},{"text":": ","kind":"text"},{"text":"Int","kind":"typeIdentifier","preciseIdentifier":"s:Si"},{"text":") ","kind":"text"},{"kind":"keyword","text":"throws"},{"text":" -> ","kind":"text"},{"kind":"typeIdentifier","text":"Bool","preciseIdentifier":"s:Sb"}],"roleHeading":"Function","role":"symbol"},"references":{"doc://GLib/documentation/GLib/FileError":{"abstract":[{"type":"text","text":"Values corresponding to "},{"code":"errno","type":"codeVoice"},{"text":" codes returned from file operations","type":"text"},{"type":"text","text":" "},{"type":"text","text":"on UNIX. Unlike "},{"type":"codeVoice","code":"errno"},{"type":"text","text":" codes, GFileError values are available on"},{"text":" ","type":"text"},{"type":"text","text":"all systems, even Windows. The exact meaning of each code depends"},{"type":"text","text":" "},{"type":"text","text":"on what sort of file operation you were performing; the UNIX"},{"type":"text","text":" "},{"type":"text","text":"documentation gives more details. The following error code descriptions"},{"text":" ","type":"text"},{"text":"come from the GNU C Library manual, and are under the copyright","type":"text"},{"text":" ","type":"text"},{"type":"text","text":"of that manual."}],"type":"topic","navigatorTitle":[{"kind":"identifier","text":"FileError"}],"kind":"symbol","role":"symbol","identifier":"doc:\/\/GLib\/documentation\/GLib\/FileError","title":"FileError","url":"\/documentation\/glib\/fileerror","fragments":[{"text":"typealias","kind":"keyword"},{"kind":"text","text":" "},{"text":"FileError","kind":"identifier"}]},"doc://GLib/documentation/GLib/fileSetContentsFull(filename:contents:length:flags:mode:)":{"title":"fileSetContentsFull(filename:contents:length:flags:mode:)","identifier":"doc:\/\/GLib\/documentation\/GLib\/fileSetContentsFull(filename:contents:length:flags:mode:)","url":"\/documentation\/glib\/filesetcontentsfull(filename:contents:length:flags:mode:)","kind":"symbol","fragments":[{"text":"func","kind":"keyword"},{"kind":"text","text":" "},{"kind":"identifier","text":"fileSetContentsFull"},{"text":"(","kind":"text"},{"text":"filename","kind":"externalParam"},{"text":": ","kind":"text"},{"text":"UnsafePointer","kind":"typeIdentifier","preciseIdentifier":"s:SP"},{"kind":"text","text":"<"},{"text":"gchar","preciseIdentifier":"c:@T@gchar","kind":"typeIdentifier"},{"kind":"text","text":">!, "},{"text":"contents","kind":"externalParam"},{"text":": ","kind":"text"},{"text":"UnsafePointer","kind":"typeIdentifier","preciseIdentifier":"s:SP"},{"kind":"text","text":"<"},{"kind":"typeIdentifier","preciseIdentifier":"c:@T@gchar","text":"gchar"},{"text":">!, ","kind":"text"},{"kind":"externalParam","text":"length"},{"kind":"text","text":": "},{"kind":"typeIdentifier","text":"gssize","preciseIdentifier":"c:@T@gssize"},{"kind":"text","text":", "},{"kind":"externalParam","text":"flags"},{"kind":"text","text":": "},{"preciseIdentifier":"s:4GLib20FileSetContentsFlagsV","text":"FileSetContentsFlags","kind":"typeIdentifier"},{"text":", ","kind":"text"},{"kind":"externalParam","text":"mode"},{"kind":"text","text":": "},{"kind":"typeIdentifier","preciseIdentifier":"s:Si","text":"Int"},{"text":") ","kind":"text"},{"kind":"keyword","text":"throws"},{"text":" -> ","kind":"text"},{"kind":"typeIdentifier","text":"Bool","preciseIdentifier":"s:Sb"}],"type":"topic","abstract":[{"type":"text","text":"Writes all of "},{"code":"contents","type":"codeVoice"},{"text":" to a file named ","type":"text"},{"type":"codeVoice","code":"filename"},{"text":", with good error checking.","type":"text"},{"text":" ","type":"text"},{"type":"text","text":"If a file called "},{"code":"filename","type":"codeVoice"},{"type":"text","text":" already exists it will be overwritten."}],"role":"symbol"},"doc://GLib/documentation/GLib":{"identifier":"doc:\/\/GLib\/documentation\/GLib","title":"GLib","abstract":[],"type":"topic","url":"\/documentation\/glib","kind":"symbol","role":"collection"},"doc://GLib/documentation/GLib/FileSetContentsFlags":{"abstract":[{"type":"text","text":"Flags to pass to "},{"type":"codeVoice","code":"g_file_set_contents_full()"},{"type":"text","text":" to affect its safety and"},{"type":"text","text":" "},{"type":"text","text":"performance."}],"fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"FileSetContentsFlags","kind":"identifier"}],"title":"FileSetContentsFlags","role":"symbol","type":"topic","identifier":"doc:\/\/GLib\/documentation\/GLib\/FileSetContentsFlags","url":"\/documentation\/glib\/filesetcontentsflags","navigatorTitle":[{"kind":"identifier","text":"FileSetContentsFlags"}],"kind":"symbol"}}}