rence","identifier":"doc:\/\/GLib\/documentation\/GLib\/Variant","isActive":true},{"type":"text","text":" instances."}],"kind":"symbol","navigatorTitle":[{"kind":"identifier","text":"VariantBuilderProtocol"}],"url":"\/documentation\/glib\/variantbuilderprotocol","role":"symbol","type":"topic","identifier":"doc:\/\/GLib\/documentation\/GLib\/VariantBuilderProtocol","fragments":[{"kind":"keyword","text":"protocol"},{"text":" ","kind":"text"},{"text":"VariantBuilderProtocol","kind":"identifier"}],"title":"VariantBuilderProtocol"},"doc://GLib/documentation/GLib/VariantTypeProtocol":{"identifier":"doc:\/\/GLib\/documentation\/GLib\/VariantTypeProtocol","title":"VariantTypeProtocol","type":"topic","role":"symbol","navigatorTitle":[{"kind":"identifier","text":"VariantTypeProtocol"}],"abstract":[{"text":"A type in the [type","type":"text"},{"identifier":"doc:\/\/GLib\/documentation\/GLib\/Variant","isActive":true,"type":"reference"},{"text":"] type system.","type":"text"}],"url":"\/documentation\/glib\/varianttypeprotocol","fragments":[{"text":"protocol","kind":"keyword"},{"text":" ","kind":"text"},{"kind":"identifier","text":"VariantTypeProtocol"}],"kind":"symbol"},"doc://GLib/documentation/GLib/Variant":{"role":"symbol","kind":"symbol","navigatorTitle":[{"text":"Variant","kind":"identifier"}],"title":"Variant","identifier":"doc:\/\/GLib\/documentation\/GLib\/Variant","fragments":[{"kind":"keyword","text":"class"},{"text":" ","kind":"text"},{"text":"Variant","kind":"identifier"}],"abstract":[{"code":"GVariant","type":"codeVoice"},{"type":"text","text":" is a variant datatype; it can contain one or more values"},{"type":"text","text":" "},{"type":"text","text":"along with information about the type of the values."}],"type":"topic","url":"\/documentation\/glib\/variant"}}}