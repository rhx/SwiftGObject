poll(2)","type":"reference","isActive":true},{"type":"text","text":" but it"},{"type":"text","text":" "},{"text":"may not always be possible to do this.","type":"text"}]},{"inlineContent":[{"text":"Another version of this function exists.","type":"text"},{"text":" ","type":"text"},{"text":"[func","type":"text"},{"type":"codeVoice","code":"GLib.get_monotonic_time"},{"type":"text","text":"] returns the time in microseconds."},{"type":"text","text":" "},{"text":"If you want to support older GLib versions, it is an alternative.","type":"text"}],"type":"paragraph"}],"kind":"content"}],"references":{"doc://GLib/documentation/GLib/getMonotonicTimeNs()":{"fragments":[{"text":"func","kind":"keyword"},{"kind":"text","text":" "},{"kind":"identifier","text":"getMonotonicTimeNs"},{"text":"() -> ","kind":"text"},{"preciseIdentifier":"s:s6UInt64V","text":"UInt64","kind":"typeIdentifier"}],"kind":"symbol","type":"topic","role":"symbol","abstract":[{"type":"text","text":"Queries the system monotonic time in nanoseconds."}],"identifier":"doc:\/\/GLib\/documentation\/GLib\/getMonotonicTimeNs()","url":"\/documentation\/glib\/getmonotonictimens()","title":"getMonotonicTimeNs()"},"man:poll(2)":{"identifier":"man:poll(2)","title":"poll()","titleInlineContent":[{"code":"poll()","type":"codeVoice"}],"type":"link","url":"man:poll(2)"},"doc://GLib/documentation/GLib":{"identifier":"doc:\/\/GLib\/documentation\/GLib","title":"GLib","abstract":[],"type":"topic","url":"\/documentation\/glib","kind":"symbol","role":"collection"}}}