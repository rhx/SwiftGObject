{"hierarchy":{"paths":[["doc:\/\/GLib\/documentation\/GLib"]]},"identifier":{"url":"doc:\/\/GLib\/documentation\/GLib\/RWLockRef","interfaceLanguage":"swift"},"relationshipsSections":[{"identifiers":["doc:\/\/GLib\/documentation\/GLib\/PointerWrapper","doc:\/\/GLib\/documentation\/GLib\/RWLockProtocol"],"kind":"relationships","type":"conformsTo","title":"Conforms To"}],"schemaVersion":{"minor":3,"major":0,"patch":0},"kind":"symbol","abstract":[{"type":"text","text":"The GRWLock struct is an opaque data structure to represent a"},{"type":"text","text":" "},{"text":"reader-writer lock. It is similar to a ","type":"text"},{"type":"reference","isActive":true,"identifier":"doc:\/\/GLib\/documentation\/GLib\/Mutex"},{"text":" in that it allows","type":"text"},{"text":" ","type":"text"},{"type":"text","text":"multiple threads to coordinate access to a shared resource."}],"sections":[],"metadata":{"role":"symbol","title":"RWLockRef","roleHeading":"Structure","modules":[{"name":"GLib"}],"fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"RWLockRef","kind":"identifier"}],"externalID":"s:4GLib9RWLockRefV","navigatorTitle":[{"kind":"identifier","text":"RWLockRef"}],"symbolKind":"struct"},"primaryContentSections":[{"kind":"declarations","declarations":[{"tokens":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"text":"RWLockRef","kind":"identifier"}],"platforms":["macOS"],"languages":["swift"]}]},{"content":[{"text":"Overview","type":"heading","level":2,"anchor":"overview"},{"inlineContent":[{"type":"text","text":"The difference to a mutex is that a reader-writer lock discriminates"},{"text":" ","type":"text"},{"text":"between read-only (‘reader’) and full (‘writer’) access. While only","type":"text"},{"type":"text","text":" "},{"text":"one thread at a time is allowed write access (by holding the ‘writer’","type":"text"},{"type":"text","text":" "},{"type":"text","text":"lock via "},{"code":"g_rw_lock_writer_lock()","type":"codeVoice"},{"type":"text","text":"), multiple threads can gain"},{"type":"text","text":" "},{"type":"text","text":"simultaneous read-only access (by holding the ‘reader’ lock via"},{"text":" ","type":"text"},{"code":"g_rw_lock_reader_lock()","type":"codeVoice"},{"text":").","type":"text"}],"type":"paragraph"},{"inlineContent":[{"text":"It is unspecified whether readers or writers have priority in acquiring the","type":"text"},{"text":" ","type":"text"},{"type":"text","text":"lock when a reader already holds the lock and a writer is queued to acquire"},{"type":"text","text":" "},{"text":"it.","type":"text"}],"type":"paragraph"},{"inlineContent":[{"type":"text","text":"Here is an example for an array with access functions:"},{"type":"text","text":" "},{"type":"text","text":"(C Language Example):"}],"type":"paragraph"},{"type":"codeListing","syntax":"C","code":["  GRWLock lock;","  GPtrArray *array;","","  gpointer","  my_array_get (guint index)","  {","    gpointer retval = NULL;","","    if (!array)","      return NULL;","","    g_rw_lock_reader_lock (&lock);","    if (index < array->len)","      retval = g_ptr_array_index (array, index);","    g_rw_lock_reader_unlock (&lock);","","    return retval;","  }","","  void","  my_array_set (guint index, gpointer data)","  {","    g_rw_lock_writer_lock (&lock);","","    if (!array)","      array = g_ptr_array_new ();","","    if (index >= array->len)","      g_ptr_array_set_size (array, index+1);","    g_ptr_array_index (array, index) = data;","","    g_rw_lock_writer_unlock (&lock);","  }"," "]},{"type":"paragraph","inlineContent":[{"text":"This example shows an array which can be accessed by many readers","type":"text"},{"type":"text","text":" "},{"text":"(the ","type":"text"},{"type":"codeVoice","code":"my_array_get()"},{"text":" function) simultaneously, whereas the writers","type":"text"},{"type":"text","text":" "},{"type":"text","text":"(the "},{"code":"my_array_set()","type":"codeVoice"},{"text":" function) will only be allowed one at a time","type":"text"},{"type":"text","text":" "},{"text":"and only if no readers currently access the array. This is because","type":"text"},{"type":"text","text":" "},{"text":"of the potentially dangerous resizing of the array. Using these","type":"text"},{"type":"text","text":" "},{"type":"text","text":"functions is fully multi-thread safe now."}]},{"type":"paragraph","inlineContent":[{"text":"If a ","type":"text"},{"isActive":true,"identifier":"doc:\/\/GLib\/documentation\/GLib\/RWLock","type":"reference"},{"type":"text","text":" is allocated in static storage then it can be used"},{"type":"text","text":" "},{"text":"without initialisation.  Otherwise, you should call","type":"text"},{"text":" ","type":"text"},{"code":"g_rw_lock_init()","type":"codeVoice"},{"text":" on it and ","type":"text"},{"code":"g_rw_lock_clear()","type":"codeVoice"},{"type":"text","text":" when done."}]},{"inlineContent":[{"type":"text","text":"A GRWLock should only be accessed with the g_rw_lock_ functions."}],"type":"paragraph"},{"type":"paragraph","inlineContent":[{"type":"text","text":"The "},{"type":"reference","identifier":"doc:\/\/GLib\/documentation\/GLib\/RWLockRef","isActive":true},{"text":" type acts as a lightweight Swift reference to an underlying ","type":"text"},{"type":"codeVoice","code":"GRWLock"},{"text":" instance.","type":"text"},{"text":" ","type":"text"},{"type":"text","text":"It exposes methods that can operate on this data type through "},{"type":"reference","identifier":"doc:\/\/GLib\/documentation\/GLib\/RWLockProtocol","isActive":true},{"type":"text","text":" conformance."},{"text":" ","type":"text"},{"text":"Use ","type":"text"},{"isActive":true,"type":"reference","identifier":"doc:\/\/GLib\/documentation\/GLib\/RWLockRef"},{"type":"text","text":" only as an "},{"code":"unowned","type":"codeVoice"},{"text":" reference to an existing ","type":"text"},{"code":"GRWLock","type":"codeVoice"},{"type":"text","text":" instance."}]},{"type":"aside","style":"note","name":"Note","content":[{"inlineContent":[{"type":"text","text":"Use "},{"type":"reference","identifier":"doc:\/\/GLib\/documentation\/GLib\/RWLock","isActive":true},{"text":" (instead of ","type":"text"},{"identifier":"doc:\/\/GLib\/documentation\/GLib\/RWLockRef","type":"reference","isActive":true},{"text":") if you want to use Automatic Reference Counting for memory management of the underlying ","type":"text"},{"type":"codeVoice","code":"GRWLock"},{"type":"text","text":" instance."}],"type":"paragraph"}]}],"kind":"content"}],"variants":[{"paths":["\/documentation\/glib\/rwlockref"],"traits":[{"interfaceLanguage":"swift"}]}],"topicSections":[{"anchor":"Initializers","identifiers":["doc:\/\/GLib\/documentation\/GLib\/RWLockRef\/init(_:)-3kjfl","doc:\/\/GLib\/documentation\/GLib\/RWLockRef\/init(_:)-4ny6y","doc:\/\/GLib\/documentation\/GLib\/RWLockRef\/init(_:)-6up5f","doc:\/\/GLib\/documentation\/GLib\/RWLockRef\/init(_:)-8ofb","doc:\/\/GLib\/documentation\/GLib\/RWLockRef\/init(_:)-8tf2d","doc:\/\/GLib\/documentation\/GLib\/RWLockRef\/init(cPointer:)","doc:\/\/GLib\/documentation\/GLib\/RWLockRef\/init(constPointer:)","doc:\/\/GLib\/documentation\/GLib\/RWLockRef\/init(gconstpointer:)","doc:\/\/GLib\/documentation\/GLib\/RWLockRef\/init(gpointer:)","doc:\/\/GLib\/documentation\/GLib\/RWLockRef\/init(mutating:)","doc:\/\/GLib\/documentation\/GLib\/RWLockRef\/init(opaquePointer:)"],"title":"Initializers","generated":true},{"generated":true,"identifiers":["doc:\/\/GLib\/documentation\/GLib\/RWLockRef\/ptr"],"anchor":"Instance-Properties","title":"Instance Properties"},{"generated":true,"identifiers":["doc:\/\/GLib\/documentation\/GLib\/RWLockRef\/PointerWrapper-Implementations","doc:\/\/GLib\/documentation\/GLib\/RWLockRef\/RWLockProtocol-Implementations"],"anchor":"Default-Implementations","title":"Default Implementations"}],"references":{"doc://GLib/documentation/GLib/RWLockRef/PointerWrapper-Implementations":{"type":"topic","title":"PointerWrapper Implemen