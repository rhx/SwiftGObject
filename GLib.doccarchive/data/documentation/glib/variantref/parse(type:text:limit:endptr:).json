},{"content":[{"text":"Discussion","anchor":"discussion","type":"heading","level":2},{"type":"paragraph","inlineContent":[{"type":"text","text":"A single "},{"isActive":true,"type":"reference","identifier":"doc:\/\/GLib\/documentation\/GLib\/Variant"},{"text":" is parsed from the content of ","type":"text"},{"code":"text","type":"codeVoice"},{"type":"text","text":"."}]},{"inlineContent":[{"type":"text","text":"The format is described "},{"isActive":true,"type":"reference","identifier":"gvariant-text-format.html"},{"type":"text","text":"."}],"type":"paragraph"},{"type":"paragraph","inlineContent":[{"text":"The memory at ","type":"text"},{"type":"codeVoice","code":"limit"},{"type":"text","text":" will never be accessed and the parser behaves as"},{"text":" ","type":"text"},{"type":"text","text":"if the character at "},{"code":"limit","type":"codeVoice"},{"type":"text","text":" is the nul terminator.  This has the"},{"type":"text","text":" "},{"type":"text","text":"effect of bounding "},{"type":"codeVoice","code":"text"},{"type":"text","text":"."}]},{"inlineContent":[{"type":"text","text":"If "},{"code":"endptr","type":"codeVoice"},{"text":" is non-","type":"text"},{"code":"nil","type":"codeVoice"},{"text":" then ","type":"text"},{"type":"codeVoice","code":"text"},{"text":" is permitted to contain data","type":"text"},{"type":"text","text":" "},{"text":"following the value that this function parses and ","type":"text"},{"code":"endptr","type":"codeVoice"},{"text":" will be","type":"text"},{"text":" ","type":"text"},{"text":"updated to point to the first character past the end of the text","type":"text"},{"type":"text","text":" "},{"type":"text","text":"parsed by this function.  If "},{"type":"codeVoice","code":"endptr"},{"type":"text","text":" is "},{"type":"codeVoice","code":"nil"},{"type":"text","text":" and there is extra data"},{"text":" ","type":"text"},{"type":"text","text":"then an error is returned."}],"type":"paragraph"},{"type":"paragraph","inlineContent":[{"