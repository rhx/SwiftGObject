text":"There may be implementation specific restrictions on deeply nested values,","type":"text"},{"type":"text","text":" "},{"type":"text","text":"which would result in a "},{"type":"codeVoice","code":"recursion"},{"text":" error. ","type":"text"},{"isActive":true,"identifier":"doc:\/\/GLib\/documentation\/GLib\/Variant","type":"reference"},{"type":"text","text":" is"},{"text":" ","type":"text"},{"type":"text","text":"guaranteed to handle nesting up to at least 64 levels."}],"type":"paragraph"}],"kind":"content"}],"schemaVersion":{"patch":0,"major":0,"minor":3},"sections":[],"variants":[{"paths":["\/documentation\/glib\/variantref\/parse(type:text:limit:endptr:)"],"traits":[{"interfaceLanguage":"swift"}]}],"hierarchy":{"paths":[["doc:\/\/GLib\/documentation\/GLib","doc:\/\/GLib\/documentation\/GLib\/VariantRef"]]},"kind":"symbol","abstract":[{"text":"Parses a ","type":"text"},{"identifier":"doc:\/\/GLib\/documentation\/GLib\/Variant","isActive":true,"type":"reference"},{"type":"text","text":" from a text representation."}],"references":{"doc://GLib/documentation/GLib/Variant":{"role":"symbol","kind":"symbol","navigatorTitle":[{"text":"Variant","kind":"identifier"}],"title":"Variant","identifier":"doc:\/\/GLib\/documentation\/GLib\/Variant","fragments":[{"kind":"keyword","text":"class"},{"text":" ","kind":"text"},{"text":"Variant","kind":"identifier"}],"abstract":[{"code":"GVariant","type":"codeVoice"},{"type":"text","text":" is a variant datatype; it can contain one or more values"},{"type":"text","text":" "},{"type":"text","text":"along with information about the type of the values."}],"type":"topic","url":"\/documentation\/glib\/variant"},"doc://GLib/documentation/GLib/VariantTypeProtocol":{"identifier":"doc:\/\/GLib\/documentation\/GLib\/VariantTypeProtocol","title":"VariantTypeProtocol","type":"topic","role":"symbol","navigatorTitle":[{"kind":"identifier","text":"VariantTypeProtocol"}],"abstract":[{"text":"A type in the [type","type":"text"},{"identifier":"doc: