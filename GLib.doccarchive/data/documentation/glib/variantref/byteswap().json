eck whether the input is in normal form beforehand, using"},{"text":" ","type":"text"},{"type":"codeVoice","code":"g_variant_is_normal_form()"},{"type":"text","text":", and to reject non-normal inputs if your"},{"type":"text","text":" "},{"type":"text","text":"application can be strict about what inputs it rejects."}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"The returned value is always in normal form and is marked as trusted."},{"text":" ","type":"text"},{"text":"A full, not floating, reference is returned.","type":"text"}]}]}],"abstract":[{"type":"text","text":"Performs a byteswapping operation on the contents of "},{"code":"value","type":"codeVoice"},{"type":"text","text":".  The"},{"type":"text","text":" "},{"text":"result is that all multi-byte numeric data contained in ","type":"text"},{"type":"codeVoice","code":"value"},{"text":" is","type":"text"},{"type":"text","text":" "},{"type":"text","text":"byteswapped.  That includes 16, 32, and 64bit signed and unsigned"},{"type":"text","text":" "},{"text":"integers as well as file handles and double precision floating point","type":"text"},{"type":"text","text":" "},{"type":"text","text":"values."}],"identifier":{"url":"doc:\/\/GLib\/documentation\/GLib\/VariantRef\/byteswap()","interfaceLanguage":"swift"},"references":{"doc://GLib/documentation/GLib/VariantRef/VariantProtocol-Implementations":{"title":"VariantProtocol Implementations","kind":"article","role":"collectionGroup","abstract":[],"identifier":"doc:\/\/GLib\/documentation\/GLib\/VariantRef\/VariantProtocol-Implementations","url":"\/documentation\/glib\/variantref\/variantprotocol-implementations","type":"topic"},"doc://GLib/documentation/GLib":{"identifier":"doc:\/\/GLib\/documentation\/GLib","title":"GLib","abstract":[],"type":"topic","url":"\/documentation\/glib","kind":"symbol","role":"collection"},"doc://GLib/documentation/GLib/VariantRef/byteswap()":{"title":"byteswap()","role":"symbol","identifier":"doc:\/\/GLib\/documentation\/GLib\/VariantRef\/byteswap()","kind":"symbol","url":"\/documentation\/glib\/variantref\/byteswap()","fragments":[{"text":"func","kind":"keyword"},{"kind":"text","text":" "},{"text":"byteswap","kind":"identifier"},{"kind":"text","text":"() -> "},{"text":"VariantRef","kind":"typeIdentifier","preciseIdentifier":"s:4GLib10VariantRefV"},{"kind":"text","text":"!"}],"type":"topic","abstract":[{"text":"Performs a byteswapping operation on the contents of ","type":"text"},{"type":"codeVoice","code":"value"},{"type":"text","text":".  The"},{"text":" ","type":"text"},{"text":"result is that all multi-byte numeric data contained in ","type":"text"},{"type":"codeVoice","code":"value"},{"type":"text","text":" is"},{"type":"text","text":" "},{"text":"byteswapped.  That includes 16, 32, and 64bit signed and unsigned","type":"text"},{"text":" ","type":"text"},{"text":"integers as well as file handles and double precision floating point","type":"text"},{"text":" ","type":"text"},{"type":"text","text":"values."}]},"doc://GLib/documentation/GLib/VariantRef":{"url":"\/documentation\/glib\/variantref","kind":"symbol","role":"symbol","type":"topic","identifier":"doc:\/\/GLib\/documentation\/GLib\/VariantRef","abstract":[{"code":"GVariant","type":"codeVoice"},{"type":"text","text":" is a variant datatype; it can contain one or more values"},{"type":"text","text":" "},{"text":"along with information about the type of the values.","type":"text"}],"fragments":[{"text":"struct","kind":"keyword"},{"kind":"text","text":" "},{"text":"VariantRef","kind":"identifier"}],"navigatorTitle":[{"text":"VariantRef","kind":"identifier"}],"title":"VariantRef"}}}