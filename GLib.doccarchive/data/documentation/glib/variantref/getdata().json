ext","text":" "},{"text":"it. As a result, file formats or network messages that incorporate","type":"text"},{"text":" ","type":"text"},{"type":"text","text":"serialized "},{"code":"GVariants","type":"codeVoice"},{"type":"text","text":" must include this information either"},{"type":"text","text":" "},{"type":"text","text":"implicitly (for instance “the file always contains a"},{"type":"text","text":" "},{"code":"G_VARIANT_TYPE_VARIANT","type":"codeVoice"},{"text":" and it is always in little-endian order”) or","type":"text"},{"type":"text","text":" "},{"text":"explicitly (by storing the type and\/or endianness in addition to the","type":"text"},{"text":" ","type":"text"},{"type":"text","text":"serialized data)."}],"type":"paragraph"}]}],"references":{"doc://GLib/documentation/GLib/Variant":{"role":"symbol","kind":"symbol","navigatorTitle":[{"text":"Variant","kind":"identifier"}],"title":"Variant","identifier":"doc:\/\/GLib\/documentation\/GLib\/Variant","fragments":[{"kind":"keyword","text":"class"},{"text":" ","kind":"text"},{"text":"Variant","kind":"identifier"}],"abstract":[{"code":"GVariant","type":"codeVoice"},{"type":"text","text":" is a variant datatype; it can contain one or more values"},{"type":"text","text":" "},{"type":"text","text":"along with information about the type of the values."}],"type":"topic","url":"\/documentation\/glib\/variant"},"doc://GLib/documentation/GLib":{"identifier":"doc:\/\/GLib\/documentation\/GLib","title":"GLib","abstract":[],"type":"topic","url":"\/documentation\/glib","kind":"symbol","role":"collection"},"doc://GLib/documentation/GLib/VariantRef/getData()":{"fragments":[{"text":"func","kind":"keyword"},{"kind":"text","text":" "},{"text":"getData","kind":"identifier"},{"text":"() -> ","kind":"text"},{"kind":"typeIdentifier","text":"gconstpointer","preciseIdentifier":"c:@T@gconstpointer"},{"kind":"text","text":"?"}],"identifier":"doc:\/\/GLib\/documentation\/GLib\/VariantRef\/getData()","title":"getData()","role":"symbol","url"