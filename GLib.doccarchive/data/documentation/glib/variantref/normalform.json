ype":"text","text":" is not already trusted, then it is scanned to check if it"},{"text":" ","type":"text"},{"text":"is in normal form.  If it is found to be in normal form then it is","type":"text"},{"text":" ","type":"text"},{"type":"text","text":"marked as trusted and a new reference to it is returned."}],"type":"paragraph"},{"inlineContent":[{"text":"If ","type":"text"},{"type":"codeVoice","code":"value"},{"text":" is found not to be in normal form then a new trusted","type":"text"},{"type":"text","text":" "},{"isActive":true,"identifier":"doc:\/\/GLib\/documentation\/GLib\/Variant","type":"reference"},{"type":"text","text":" is created with the same value as "},{"type":"codeVoice","code":"value"},{"text":". The non-normal parts of","type":"text"},{"text":" ","type":"text"},{"type":"codeVoice","code":"value"},{"type":"text","text":" will be replaced with default values which are guaranteed to be in"},{"text":" ","type":"text"},{"text":"normal form.","type":"text"}],"type":"paragraph"},{"type":"paragraph","inlineContent":[{"text":"It makes sense to call this function if you’ve received ","type":"text"},{"isActive":true,"identifier":"doc:\/\/GLib\/documentation\/GLib\/Variant","type":"reference"},{"type":"text","text":" "},{"type":"text","text":"data from untrusted sources and you want to ensure your serialized"},{"text":" ","type":"text"},{"type":"text","text":"output is definitely in normal form."}]},{"type":"paragraph","inlineContent":[{"text":"If ","type":"text"},{"type":"codeVoice","code":"value"},{"type":"text","text":" is already in normal form, a new reference will be returned"},{"type":"text","text":" "},{"type":"text","text":"(which will be floating if "},{"type":"codeVoice","code":"value"},{"type":"text","text":" is floating). If it is not in normal form,"},{"type":"text","text":" "},{"type":"text","text":"the newly created "},{"identifier":"doc:\/\/GLib\/documentation\/GLib\/Variant","isActive":true,"type":"reference"},{"text":" will be returned with a single non-floating","type":"text"},{"type":"text","text":" "},{"text":"reference. Typically, ","type":"text"},{"type":"codeVoice","code":"g_variant_take_ref()"},{"type":"text","text":" should be called on the return"},{"type":"text","text":" "},{"type":"text","text":"value from this function to guarantee ownership of a single non-floating"},{"text":" ","type":"text"},{"text":"reference to it.","type":"text"}]}],"kind":"content"}],"abstract":[{"type":"text","text":"Gets a "},{"type":"reference","isActive":true,"identifier":"doc:\/\/GLib\/documentation\/GLib\/Variant"},{"text":" instance that has the same value as ","type":"text"},{"type":"codeVoice","code":"value"},{"type":"text","text":" and is"},{"type":"text","text":" "},{"type":"text","text":"trusted to be in normal form."}],"references":{"doc://GLib/documentation/GLib/VariantRef":{"url":"\/documentation\/glib\/variantref","kind":"symbol","role":"symbol","type":"topic","identifier":"doc:\/\/GLib\/documentation\/GLib\/VariantRef","abstract":[{"code":"GVariant","type":"codeVoice"},{"type":"text","text":" is a variant datatype; it can contain one or more values"},{"type":"text","text":" "},{"text":"along with information about the type of the values.","type":"text"}],"fragments":[{"text":"struct","kind":"keyword"},{"kind":"text","text":" "},{"text":"VariantRef","kind":"identifier"}],"navigatorTitle":[{"text":"VariantRef","kind":"identifier"}],"title":"VariantRef"},"doc://GLib/documentation/GLib":{"identifier":"doc:\/\/GLib\/documentation\/GLib","title":"GLib","abstract":[],"type":"topic","url":"\/documentation\/glib","kind":"symbol","role":"collection"},"doc://GLib/documentation/GLib/Variant":{"role":"symbol","kind":"symbol","navigatorTitle":[{"text":"Variant","kind":"identifier"}],"title":"Variant","identifier":"doc:\/\/GLib\/documentation\/GLib\/Variant","fragments":[{"kind":"keyword","text":"class"},{"text":" ","kind":"text"},{"text":"Variant","kind":"identifier"}],"abstract":[{"code":"GVariant","type":"codeVoi