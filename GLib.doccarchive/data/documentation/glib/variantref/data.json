{"abstract":[{"type":"text","text":"Returns a pointer to the serialized form of a "},{"identifier":"doc:\/\/GLib\/documentation\/GLib\/Variant","isActive":true,"type":"reference"},{"type":"text","text":" instance."},{"type":"text","text":" "},{"type":"text","text":"The returned data may not be in fully-normalised form if read from an"},{"text":" ","type":"text"},{"type":"text","text":"untrusted source.  The returned data must not be freed; it remains"},{"text":" ","type":"text"},{"text":"valid for as long as ","type":"text"},{"code":"value","type":"codeVoice"},{"type":"text","text":" exists."}],"metadata":{"roleHeading":"Instance Property","symbolKind":"property","fragments":[{"text":"var","kind":"keyword"},{"text":" ","kind":"text"},{"text":"data","kind":"identifier"},{"text":": ","kind":"text"},{"kind":"typeIdentifier","text":"gconstpointer","preciseIdentifier":"c:@T@gconstpointer"},{"kind":"text","text":"?"}],"modules":[{"name":"GLib"}],"role":"symbol","externalID":"s:4GLib15VariantProtocolPAAE4dataSVSgvp::SYNTHESIZED::s:4GLib10VariantRefV","title":"data","extendedModule":"GLib"},"schemaVersion":{"patch":0,"major":0,"minor":3},"primaryContentSections":[{"declarations":[{"tokens":[{"text":"var","kind":"keyword"},{"text":" ","kind":"text"},{"kind":"identifier","text":"data"},{"kind":"text","text":": "},{"text":"gconstpointer","kind":"typeIdentifier","preciseIdentifier":"c:@T@gconstpointer"},{"kind":"text","text":"? { "},{"text":"get","kind":"keyword"},{"text":" }","kind":"text"}],"languages":["swift"],"platforms":["macOS"]}],"kind":"declarations"},{"content":[{"level":2,"type":"heading","text":"Discussion","anchor":"discussion"},{"inlineContent":[{"type":"text","text":"If "},{"type":"codeVoice","code":"value"},{"type":"text","text":" is a fixed-sized value that was deserialized from a"},{"text":" ","type":"text"},{"text":"corrupted serialized container then ","type":"text"},{"code":"nil","type":"codeVoice"},{"text":" may be returned.  In this","type":"text"},{"text":" ","type":"text"},{"type":"text","text":"case, the proper thing to do is typically to use the appropriate"},{"type":"text","text":" "},{"text":"number of nul bytes in place of ","type":"text"},{"type":"codeVoice","code":"value"},{"type":"text","text":".  If "},{"type":"codeVoice","code":"value"},{"text":" is not fixed-sized","type":"text"},{"text":" ","type":"text"},{"text":"then ","type":"text"},{"code":"nil","type":"codeVoice"},{"type":"text","text":" is never returned."}],"type":"paragraph"},{"type":"paragraph","inlineContent":[{"text":"In the case that ","type":"text"},{"code":"value","type":"codeVoice"},{"type":"text","text":" is already in serialized form, this function"},{"text":" ","type":"text"},{"type":"text","text":"is "},{"code":"O(1)","type":"codeVoice"},{"text":".  If the value is not already in serialized form,","type":"text"},{"text":" ","type":"text"},{"type":"text","text":"serialization occurs implicitly and is approximately "},{"type":"codeVoice","code":"O(n)"},{"type":"text","text":" in the size"},{"type":"text","text":" "},{"type":"text","text":"of the result."}]},{"inlineContent":[{"text":"To deserialize the data returned by this function, in addition to the","type":"text"},{"type":"text","text":" "},{"type":"text","text":"serialized data, you must know the type of the "},{"type":"reference","isActive":true,"identifier":"doc:\/\/GLib\/documentation\/GLib\/Variant"},{"type":"text","text":", and (if the"},{"text":" ","type":"text"},{"text":"machine might be different) the endianness of the machine that stored","type":"text"},{"text":" ","type":"text"},{"text":"it. As a result, file formats or network messages that incorporate","type":"text"},{"type":"text","text":" "},{"type":"text","text":"serialized "},{"code":"GVariants","type":"codeVoice"},{"type":"text","text":" must include this information either"},{"text":" ","type":"text"},{"type":"text","text":"implicitly (for instance “the file always contains a"},{"type":"text","text":" "},{"code":"G_VARIANT_TYPE_VARIANT","type":"codeVoice"},{"type":"text","text":" and it is always in little-endian order”) or"},{"type":"text","text":" "},{"text":"explicitly (by storing the type and\/or endianness in addition to the","type":"text"},{"type":"text","text":" "},{"text":"serialized data).","type":"text"}],"type":"paragraph"}],"kind":"content"}],"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/glib\/variantref\/data"]}],"sections":[],"kind":"symbol","hierarchy":{"paths":[["doc:\/\/GLib\/documentation\/GLib","doc:\/\/GLib\/documentation\/GLib\/VariantRef","doc:\/\/GLib\/documentation\/GLib\/VariantRef\/VariantProtocol-Implementations"]]},"identifier":{"interfaceLanguage":"swift","url":"doc:\/\/GLib\/documentation\/GLib\/VariantRef\/data"},"references":{"doc://GLib/documentation/GLib":{"identifier":"doc:\/\/GLib\/documentation\/GLib","title":"GLib","abstract":[],"type":"topic","url":"\/documentation\/glib","kind":"symbol","role":"collection"},"doc://GLib/documentation/GLib/Variant":{"role":"symbol","kind":"symbol","navigatorTitle":[{"text":"Variant","kind":"identifier"}],"title":"Variant","identifier":"doc:\/\/GLib\/documentation\/GLib\/Variant","fragments":[{"kind":"keyword","text":"class"},{"text":" ","kind":"text"},{"text":"Variant","kind":"identifier"}],"abstract":[{"code":"GVariant","type":"codeVoice"},{"type":"text","text":" is a variant datatype; it can contain one or more values"},{"type":"text","text":" "},{"type":"text","text":"along with information about the type of the values."}],"type":"topic","url":"\/documentation\/glib\/variant"},"doc://GLib/documentation/GLib/VariantRef":{"url":"\/documentation\/glib\/variantref","kind":"symbol","role":"symbol","type":"topic","identifier":"doc:\/\/GLib\/documentation\/GLib\/VariantRef","abstract":[{"code":"GVariant","type":"codeVoice"},{"type":"text","text":" is a variant datatype; it can contain one or more values"},{"type":"text","text":" "},{"text":"along with information about the