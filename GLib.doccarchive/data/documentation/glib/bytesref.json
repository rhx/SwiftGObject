{"sections":[],"primaryContentSections":[{"declarations":[{"languages":["swift"],"tokens":[{"text":"struct","kind":"keyword"},{"kind":"text","text":" "},{"text":"BytesRef","kind":"identifier"}],"platforms":["macOS"]}],"kind":"declarations"},{"kind":"content","content":[{"anchor":"overview","type":"heading","text":"Overview","level":2},{"inlineContent":[{"text":"The purpose of a ","type":"text"},{"code":"GBytes","type":"codeVoice"},{"type":"text","text":" is to keep the memory region that it holds"},{"text":" ","type":"text"},{"type":"text","text":"alive for as long as anyone holds a reference to the bytes.  When"},{"type":"text","text":" "},{"text":"the last reference count is dropped, the memory is released. Multiple","type":"text"},{"type":"text","text":" "},{"type":"text","text":"unrelated callers can use byte data in the "},{"code":"GBytes","type":"codeVoice"},{"type":"text","text":" without coordinating"},{"type":"text","text":" "},{"type":"text","text":"their activities, resting assured that the byte data will not change or"},{"text":" ","type":"text"},{"text":"move while they hold a reference.","type":"text"}],"type":"paragraph"},{"type":"paragraph","inlineContent":[{"type":"text","text":"A "},{"code":"GBytes","type":"codeVoice"},{"text":" can come from many different origins that may have","type":"text"},{"text":" ","type":"text"},{"type":"text","text":"different procedures for freeing the memory region.  Examples are"},{"text":" ","type":"text"},{"text":"memory from [func","type":"text"},{"code":"GLib.malloc","type":"codeVoice"},{"text":"], from memory slices, from a","type":"text"},{"type":"text","text":" "},{"text":"[struct","type":"text"},{"identifier":"doc:\/\/GLib\/documentation\/GLib\/MappedFile","isActive":true,"type":"reference"},{"type":"text","text":"] or memory from other allocators."}]},{"inlineContent":[{"type":"codeVoice","code":"GBytes"},{"type":"text","text":" work well as keys in [struct"},{"type":"reference","identifier":"doc:\/\/GLib\/documentation\/GLib\/HashTable","isActive":true},{"type":"text","text":"]. Use"},{"text":" ","type":"text"},{"text":"[method","type":"text"},{"type":"codeVoice","code":"GLib.Bytes.equal"},{"text":"] and [method","type":"text"},{"type":"codeVoice","code":"GLib.Bytes.hash"},{"type":"text","text":"] as parameters to"},{"type":"text","text":" "},{"type":"text","text":"[func"},{"type":"codeVoice","code":"GLib.HashTable.new"},{"text":"] or [func","type":"text"},{"type":"codeVoice","code":"GLib.HashTable.new_full"},{"type":"text","text":"]."},{"text":" ","type":"text"},{"type":"codeVoice","code":"GBytes"},{"text":" can also be used as keys in a [struct","type":"text"},{"type":"reference","identifier":"doc:\/\/GLib\/documentation\/GLib\/Tree","isActive":true},{"type":"text","text":"] by passing the"},{"type":"text","text":" "},{"type":"text","text":"[method"},{"code":"GLib.Bytes.compare","type":"codeVoice"},{"text":"] function to [ctor","type":"text"},{"code":"GLib.Tree.new","type":"codeVoice"},{"text":"].","type":"text"}],"type":"paragraph"},{"type":"paragraph","inlineContent":[{"type":"text","text":"The data pointed to by this bytes must not be modified. For a mutable"},{"type":"text","text":" "},{"text":"array of bytes see [struct","type":"text"},{"type":"reference","identifier":"doc:\/\/GLib\/documentation\/GLib\/ByteArray","isActive":true},{"type":"text","text":"]. Use"},{"text":" ","type":"text"},{"type":"text","text":"[method"},{"code":"GLib.Bytes.unref_to_array","type":"codeVoice"},{"text":"] to create a mutable array for a ","type":"text"},{"type":"codeVoice","code":"GBytes"},{"type":"text","text":" "},{"text":"sequence. To create an immutable ","type":"text"},{"type":"codeVoice","code":"GBytes"},{"type":"text","text":" from a mutable"},{"type":"text","text":" "},{"type":"text","text":"[struct"},{"identifier":"doc:\/\/GLib\/documentation\/GLib\/ByteArray","type":"reference","isActive":true},{"text":"], use the [func","type":"text"},{"type":"codeVoice","code":"GLib.ByteArray.free_to_bytes"},{"text":"]","type":"text"},{"text":" ","type":"text"},{"type":"text","text":"function."}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"The "},{"isActive":true,"type":"reference","identifier":"doc:\/\/GLib\/documentation\/GLib\/BytesRef"},{"text":" type acts as a lightweight Swift reference to an underlying ","type":"text"},{"code":"GBytes","type":"codeVoice"},{"type":"text","text":" instance."},{"text":" ","type":"text"},{"text":"It exposes methods that can operate on this data type through ","type":"text"},{"identifier":"doc:\/\/GLib\/documentation\/GLib\/BytesProtocol","isActive":true,"type":"reference"},{"type":"text","text":" conformance."},{"text":" ","type":"text"},{"type":"text","text":"Use "},{"identifier":"doc:\/\/GLib\/documentation\/GLib\/BytesRef","type":"reference","isActive":true},{"text":" only as an ","type":"text"},{"type":"codeVoice","code":"unowned"},{"text":" reference to an existing ","type":"text"},{"type":"codeVoice","code":"GBytes"},{"text":" instance.","type":"text"}]},{"content":[{"inlineContent":[{"type":"text","text":"Use "},{"identifier":"doc:\/\/GLib\/documentation\/GLib\/Bytes","type":"reference","isActive":true},{"text":" (instead of ","type":"text"},{"type":"reference","identifier":"doc:\/\/GLib\/documentation\/GLib\/BytesRef","isActive":true},{"type":"text","text":") if you want to use Automatic Reference Counting for memory management of the underlying "},{"code":"GBytes","type":"codeVoice"},{"text":" instance.","type":"text"}],"type":"paragraph"}],"type":"aside","style":"note","name":"Note"}]}],"variants":[{"paths":["\/documentation\/glib\/bytesref"],"traits":[{"interfaceLanguage":"swift"}]}],"identifier":{"interfaceLanguage":"swift","url":"doc:\/\/GLib\/documentation\/GLib\/BytesRef"},"metadata":{"fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"text":"BytesRef","kind":"identifier"}],"symbolKind":"struct","title":"BytesRef","externalID":"s:4GLib8BytesRefV","roleHea