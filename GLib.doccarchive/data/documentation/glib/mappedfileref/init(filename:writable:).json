"kind":"text"},{"text":"throws","kind":"keyword"}],"languages":["swift"]}]},{"content":[{"level":2,"anchor":"discussion","type":"heading","text":"Discussion"},{"type":"paragraph","inlineContent":[{"text":"If ","type":"text"},{"code":"writable","type":"codeVoice"},{"text":" is ","type":"text"},{"code":"true","type":"codeVoice"},{"type":"text","text":", the mapped buffer may be modified, otherwise"},{"text":" ","type":"text"},{"text":"it is an error to modify the mapped buffer. Modifications to the buffer","type":"text"},{"type":"text","text":" "},{"type":"text","text":"are not visible to other processes mapping the same file, and are not"},{"text":" ","type":"text"},{"text":"written back to the file.","type":"text"}]},{"inlineContent":[{"type":"text","text":"Note that modifications of the underlying file might affect the contents"},{"type":"text","text":" "},{"type":"text","text":"of the "},{"type":"reference","isActive":true,"identifier":"doc:\/\/GLib\/documentation\/GLib\/MappedFile"},{"type":"text","text":". Therefore, mapping should only be used if the file"},{"type":"text","text":" "},{"text":"will not be modified, or if all modifications of the file are done","type":"text"},{"type":"text","text":" "},{"text":"atomically (e.g. using ","type":"text"},{"code":"g_file_set_contents()","type":"codeVoice"},{"type":"text","text":")."}],"type":"paragraph"},{"inlineContent":[{"text":"If ","type":"text"},{"code":"filename","type":"codeVoice"},{"text":" is the name of an empty, regular file, the function","type":"text"},{"type":"text","text":" "},{"text":"will successfully return an empty ","type":"text"},{"identifier":"doc:\/\/GLib\/documentation\/GLib\/MappedFile","type":"reference","isActive":true},{"text":". In other cases of","type":"text"},{"text":" ","type":"text"},{"text":"size 0 (e.g. device files such as \/dev\/null), ","type":"text"},{"code":"error","type":"codeVoice"},{"type":"text","text":" will be set"},{"text":" ","type":"text"},{"text":"to the ","type":"text"},{"type":"reference","identifier":"doc:\/\/GLib\/documentation\/GLib\/FileError","isActive":true},{"text":" value ","type":"text"},{"type":"codeVoice","code":"inval"},{"type":"text","text":"."}],"type":"paragraph"}],"kind":"content"}],"references":{"doc://GLib/documentation/GLib/MappedFileRef/init(filename:writable:)":{"identifier":"doc:\/\/GLib\/documentation\/GLib\/MappedFileRef\/init(filename:writable:)","url":"\/documentation\/glib\/mappedfileref\/init(filename:writable:)","fragments":[{"text":"init","kind":"identifier"},{"text":"(","kind":"text"},{"kind":"externalParam","text":"filename"},{"kind":"text","text":": "},{"text":"UnsafePointer","kind":"typeIdentifier","preciseIdentifier":"s:SP"},{"text":"<","kind":"text"},{"preciseIdentifier":"c:@T@gchar","text":"gchar","kind":"typeIdentifier"},{"text":">!, ","kind":"text"},{"kind":"externalParam","text":"writable"},{"text":": ","kind":"text"},{"text":"Bool","kind":"typeIdentifier","preciseIdentifier":"s:Sb"},{"text":") ","kind":"text"},{"text":"throws","kind":"keyword"}],"type":"topic","kind":"symbol","abstract":[{"text":"Maps a file into memory. On UNIX, this is using the ","type":"text"},{"type":"codeVoice","code":"mmap()"},{"type":"text","text":" function."}],"role":"symbol","title":"init(filename:writable:)"},"doc://GLib/documentation/GLib/FileError":{"abstract":[{"type":"text","text":"Values corresponding to "},{"code":"errno","type":"codeVoice"},{"text":" codes returned from file operations","type":"text"},{"type":"text","text":" "},{"type":"text","text":"on UNIX. Unlike "},{"type":"codeVoice","code":"errno"},{"type":"text","text":" codes, GFileError values are available on"},{"text":" ","type":"text"},{"type":"text","text":"all systems, even Windows. The exact meaning of each code depends"},{"type":"text","text":" "},{"type":"text","text":"on what sort of file operation you were performing; the UNIX"},{"type":"text","text":" "},{"type":"text","text":"documentation gives more details. The following error code descriptions"},{"text":" ","type":"text"},{"text":"come from the GNU C Library manual, and are under the copyright","type":"text"},{"text":" ","type":"text"},{"type":"text","text":"of that manual."}],"type":"topic","navigatorTitle":[{"kind":"identifier","text":"FileError"}],"kind":"symbol","role":"symbol","identifier":"doc:\/\/GLib\/documentation\/GLib\/FileError","title":"FileError","url":"\/documentation\/glib\/fileerror","fragments":[{"text":"typealias","kind":"keyword"},{"kind":"text","text":" "},{"text":"FileError","kind":"identifier"}]},"doc://GLib/documentation/GLib/MappedFileRef":{"navigatorTitle":[{"kind":"identifier","text":"MappedFileRef"}],"url":"\/documentation\/glib\/mappedfileref","identifier":"doc:\/\/GLib\/documentation\/GLib\/MappedFileRef","title":"MappedFileRef","type":"topic","kind":"symbol","role":"symbol","abstract":[{"type":"text","text":"The "},{"identifier":"doc:\/\/GLib\/documentation\/GLib\/MappedFile","type":"reference","isActive":true},{"type":"text","text":" represents a file mapping created with"},{"text":" ","type":"text"},{"code":"g_mapped_file_new()","type":"codeVoice"},{"type":"text","text":". It has only private members and should"},{"type":"text","text":" "},{"type":"text","text":"not be accessed directly."}],"fragments":[{"kind":"keyword","text":"struct"},{"text":" ","kind":"text"},{"kind":"identifier","text":"MappedFileRef"}]},"doc://GLib/documentation/GLib":{"identifier":"doc:\/\/GLib\/documentation\/GLib","title":"GLib","abstract":[],"type":"topic","url":"\/documentation\/glib","kind":"symbol","role":"collection"},"doc://GLib/documentation/GLib/MappedFile":{"title":"MappedFile","identifier":"doc:\/\/GLib\/documentation\/GLib\/MappedFile","type":"topic","url":"\/documentation\/glib\/mappedfile","kind":"symbol","fragments":[{"text":"class","kind":"keyword"},{"kind":"text","text":" "},{"kind":"identifier","text":"MappedFile"}],"abstract":[{"type":"text","text":"The "},{"identifier":"doc:\/\/GLib\/documentation\/GLib\/MappedFile","type":"reference","isActive":true},{"type":"text","text":" represents a file mapping created with"},{"type":"text","text":" "},{"type":"codeVoice","code":"g_mapped_file_new()"},{"type":"text","text":". It has only private members and should"},{"text":" ","type":"text"},{"text":"not be accessed directly.","type":"text"}],"navigatorTitle":[{"kind":"identifier","text":"MappedFile"}],"role":"symbol"}}}