{"abstract":[{"type":"text","text":"Sets strict POSIX mode."}],"schemaVersion":{"patch":0,"major":0,"minor":3},"hierarchy":{"paths":[["doc:\/\/GLib\/documentation\/GLib","doc:\/\/GLib\/documentation\/GLib\/OptionContext","doc:\/\/GLib\/documentation\/GLib\/OptionContext\/OptionContextProtocol-Implementations"]]},"metadata":{"role":"symbol","externalID":"s:4GLib21OptionContextProtocolPAAE3set11strictPosixySb_tF::SYNTHESIZED::s:4GLib13OptionContextC","extendedModule":"GLib","title":"set(strictPosix:)","modules":[{"name":"GLib"}],"roleHeading":"Instance Method","symbolKind":"method","fragments":[{"kind":"keyword","text":"func"},{"text":" ","kind":"text"},{"text":"set","kind":"identifier"},{"text":"(","kind":"text"},{"kind":"externalParam","text":"strictPosix"},{"kind":"text","text":": "},{"text":"Bool","kind":"typeIdentifier","preciseIdentifier":"s:Sb"},{"kind":"text","text":")"}]},"primaryContentSections":[{"kind":"declarations","declarations":[{"platforms":["macOS"],"languages":["swift"],"tokens":[{"kind":"keyword","text":"func"},{"kind":"text","text":" "},{"text":"set","kind":"identifier"},{"kind":"text","text":"("},{"text":"strictPosix","kind":"externalParam"},{"text":": ","kind":"text"},{"preciseIdentifier":"s:Sb","text":"Bool","kind":"typeIdentifier"},{"kind":"text","text":")"}]}]},{"content":[{"level":2,"type":"heading","anchor":"discussion","text":"Discussion"},{"type":"paragraph","inlineContent":[{"type":"text","text":"By default, this mode is disabled."}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"In strict POSIX mode, the first non-argument parameter encountered"},{"type":"text","text":" "},{"type":"text","text":"(eg: filename) terminates argument processing.  Remaining arguments"},{"text":" ","type":"text"},{"type":"text","text":"are treated as non-options and are not attempted to be parsed."}]},{"inlineContent":[{"text":"If strict POSIX mode is disabled then parsing is done in the GNU way","type":"text"},{"text":" ","type":"text"},{"type":"text","text":"where option arguments can be freely mixed with non-options."}],"type":"paragraph"},{"type":"paragraph","inlineContent":[{"text":"As an example, consider “ls foo -l”.  With GNU style parsing, this","type":"text"},{"text":" ","type":"text"},{"type":"text","text":"will list “foo” in long mode.  In strict POSIX style, this will list"},{"text":" ","type":"text"},{"text":"the files named “foo” and “-l”.","type":"text"}]},{"inlineContent":[{"type":"text","text":"It may be useful to force strict POSIX mode when creating “verb"},{"type":"text","text":" "},{"text":"style” command line tools.  For example, the “gsettings” command line","type":"text"},{"type":"text","text":" "},{"text":"tool supports the global option “–schemadir” as well as many","type":"text"},{"text":" ","type":"text"},{"text":"subcommands (“get”, “set”, etc.) which each have their own set of","type":"text"},{"type":"text","text":" "},{"text":"arguments.  Using strict POSIX mode will allow parsing the global","type":"text"},{"type":"text","text":" "},{"text":"options up to the verb name while leaving the remaining options to be","type":"text"},{"type":"text","text":" "},{"text":"parsed by the relevant subcommand (which can be determined by","type":"text"},{"text":" ","type":"text"},{"type":"text","text":"examining the verb name, which should be present in argv[1] after"},{"text":" ","type":"text"},{"type":"text","text":"parsing)."}],"type":"paragraph"}],"kind":"content"}],"variants":[{"paths":["\/documentation\/glib\/optioncontext\/set(strictposix:)"],"traits":[{"interfaceLanguage":"swift"}]}],"identifier":{"url":"doc:\/\/GLib\/documentation\/GLib\/OptionContext\/set(strictPosix:)","interfaceLanguage":"swift"},"sections":[],"kind":"symbol","references":{"doc://GLib/documentation/GLib/OptionContext":{"type":"topic","kind":"symbol","title":"OptionContext","role":"symbol","abstract":[{"text":"A ","type":"text"},{"type":"codeVoice","code":"GOptionContext"},{"text":" struct defines which options","type":"text"},{"text":" ","type":"text"},{"text":"are accepted by the commandline option parser. The struct has only private","type":"text"},{"type":"text","text":" "},{"type":"text","text":"fields and should not be directly accessed."}],"identifier":"doc:\/\/GLib\/documentation\/GLib\/OptionContext","url":"\/documentation\/glib\/optioncontext","fragments":[{"kind":"keyword","text":"class"},{"kind":"text","text":" "},{"text":"OptionContext","kind":"identifier"}],"navigatorTitle":[{"kind":"identifier","text":"OptionContext"}]},"doc://GLib/documentation/GLib":{"identifier":"doc:\/\/GLib\/documentation\/GLib","title":"GLib","abstract":[],"type":"topic","url":"\/documentation\/glib","kind":"symbol","role":"collection"},"doc://GLib/documentation/GLib/OptionContext/set(strictPosix:)":{"identifier":"doc:\/\/GLib\/documentation\/GLib\/OptionContext\/set(strictPosix:)","abstract":[{"text":"Sets strict POSIX mode.","type":"text"}],"type":"topic","kind":"symbol","role":"symbol","fragments":[{"kind":"keyword","text":"func"},{"text":" ","kind":"text"},{"kind":"identifier","text":"set"},{"text":"(","kind":"text"},{"text":"strictPosix","kind":"externalParam"},{"text":": ","kind":"text"},{"text":"Bool","kind":"typeIdentifier","preciseIdentifier":"s:Sb"},{"text":")","kind":"text"}],"title":"set(strictPosix:)","url":"\/documentation\/glib\/optioncontext\/set(strictposix:)"},"doc://GLib/documentation/GLib/OptionContext/OptionContextProtocol-Implementations":{"type":"topic","kind":"article","title":"OptionContextProtocol Implementations","role":"collectionGroup","abstract":[],"identifier":"doc:\/\/GLib\/documentation\/GLib\/OptionContext\/OptionContextProtocol-Implementations","url":"\/documentation\/glib\/optioncontext\/optioncontextprotocol-implementations"}}}