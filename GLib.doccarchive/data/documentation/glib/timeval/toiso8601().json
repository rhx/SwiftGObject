{"metadata":{"role":"symbol","symbolKind":"method","extendedModule":"GLib","modules":[{"name":"GLib"}],"platforms":[],"title":"toIso8601()","roleHeading":"Instance Method","externalID":"s:4GLib15TimeValProtocolPAAE9toIso8601SSSgyF::SYNTHESIZED::s:4GLib7TimeValC","fragments":[{"text":"func","kind":"keyword"},{"kind":"text","text":" "},{"text":"toIso8601","kind":"identifier"},{"kind":"text","text":"() -> "},{"kind":"typeIdentifier","text":"String","preciseIdentifier":"s:SS"},{"text":"!","kind":"text"}]},"kind":"symbol","identifier":{"interfaceLanguage":"swift","url":"doc:\/\/GLib\/documentation\/GLib\/TimeVal\/toIso8601()"},"abstract":[{"type":"text","text":"Converts "},{"code":"time","type":"codeVoice"},{"type":"text","text":" into an RFC 3339 encoded string, relative to the"},{"text":" ","type":"text"},{"type":"text","text":"Coordinated Universal Time (UTC). This is one of the many formats"},{"text":" ","type":"text"},{"type":"text","text":"allowed by ISO 8601."}],"sections":[],"schemaVersion":{"patch":0,"major":0,"minor":3},"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/glib\/timeval\/toiso8601()"]}],"hierarchy":{"paths":[["doc:\/\/GLib\/documentation\/GLib","doc:\/\/GLib\/documentation\/GLib\/TimeVal","doc:\/\/GLib\/documentation\/GLib\/TimeVal\/TimeValProtocol-Implementations"]]},"primaryContentSections":[{"kind":"declarations","declarations":[{"platforms":["macOS"],"languages":["swift"],"tokens":[{"text":"func","kind":"keyword"},{"kind":"text","text":" "},{"kind":"identifier","text":"toIso8601"},{"text":"() -> ","kind":"text"},{"kind":"typeIdentifier","preciseIdentifier":"s:SS","text":"String"},{"kind":"text","text":"!"}]}]},{"content":[{"level":2,"type":"heading","anchor":"discussion","text":"Discussion"},{"inlineContent":[{"type":"text","text":"ISO 8601 allows a large number of date\/time formats, with or without"},{"type":"text","text":" "},{"text":"punctuation and optional elements. The format returned by this function","type":"text"},{"type":"text","text":" "},{"text":"is a complete date and time, with optional punctuation included, the","type":"text"},{"type":"text","text":" "},{"text":"UTC time zone represented as “Z”, and the ","type":"text"},{"type":"codeVoice","code":"tv_usec"},{"text":" part included if","type":"text"},{"type":"text","text":" "},{"type":"text","text":"and only if it is nonzero, i.e. either"},{"type":"text","text":" "},{"type":"text","text":"“YYYY-MM-DDTHH:MM:SSZ” or “YYYY-MM-DDTHH:MM:SS.fffffZ”."}],"type":"paragraph"},{"type":"paragraph","inlineContent":[{"text":"This corresponds to the Internet date\/time format defined by","type":"text"},{"text":" ","type":"text"},{"identifier":"https:\/\/www.ietf.org\/rfc\/rfc3339.txt","isActive":true,"type":"reference"},{"text":",","type":"text"},{"text":" ","type":"text"},{"text":"and to either of the two most-precise formats defined by","type":"text"},{"type":"text","text":" "},{"type":"text","text":"the W3C Note"},{"text":" ","type":"text"},{"type":"reference","identifier":"http:\/\/www.w3.org\/TR\/NOTE-datetime-19980827","isActive":true},{"text":".","type":"text"},{"type":"text","text":" "},{"type":"text","text":"Both of these documents are profiles of ISO 8601."}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"Use "},{"type":"codeVoice","code":"g_date_time_format()"},{"type":"text","text":" or "},{"code":"g_strdup_printf()","type":"codeVoice"},{"type":"text","text":" if a different"},{"type":"text","text":" "},{"type":"text","text":"variation of ISO 8601 format is required."}]},{"inlineContent":[{"type":"text","text":"If "},{"code":"time","type":"codeVoice"},{"text":" represents a date which is too large to fit into a ","type":"text"},{"type":"codeVoice","code":"struct tm"},{"type":"text","text":","},{"text":" ","type":"text"},{"code":"nil","type":"codeVoice"},{"type":"text","text":" will be returned. This is platform dependent. Note also that since"},{"text":" ","type":"text"},{"code":"GTimeVal","type":"codeVoice"},{"text":" stores the number of seconds as a ","type":"text"},{"code":"glong","type":"codeVoice"},{"type":"text","text":", on 32-bit systems it"},{"type":"text","text":" "},{"type":"text","text":"is subject to the year 2038 problem. Accordingly, since GLib 2.62, this"},{"type":"text","text":" "},{"text":"function has been deprecated. Equivalent functionality is available using:","type":"text"}],"type":"paragraph"},{"syntax":null,"code":["GDateTime *dt = g_date_time_new_from_unix_utc (time_val);","iso8601_string = g_date_time_format_iso8601 (dt);","g_date_time_unref (dt);"],"type":"codeListing"},{"inlineContent":[{"text":"The return value of ","type":"text"},{"type":"codeVoice","code":"g_time_val_to_iso8601()"},{"text":" has been nullable since GLib","type":"text"},{"text":" ","type":"text"},{"text":"2.54; before then, GLib would crash under the same conditions.","type":"text"}],"type":"paragraph"},{"type":"paragraph","inlineContent":[{"type":"strong","inlineContent":[{"type":"text","text":"to_iso8601 is deprecated:"}]},{"text":" ","type":"text"},{"type":"text","text":"#GTimeVal is not year-2038-safe. Use"},{"type":"text","text":" "},{"type":"text","text":"g_date_time_format_iso8601(dt) instead."}]}],"kind":"content"}],"references":{"doc://GLib/documentation/GLib/TimeVal":{"url":"\/documentation\/glib\/timeval","role":"symbol","abstract":[{"type":"text","text":"Represents a precise time, with seconds and microseconds."}],"title":"TimeVal","fragments":[{"text":"class","kind":"keyword"},{"text":" ","kind":"text"},{"text":"TimeVal","kind":"identifier"}],"type":"topic","kind":"symbol","identifier":"doc:\/\/GLib\/documentation\/GLib\/TimeVal","navigatorTitle":[{"text":"TimeVal","kind":"identifier"}]},"doc://GLib/documentation/GLib/TimeVal/toIso8601()":{"title":"toIso8601()","type":"topic","url":"\/documentation\/glib\/timeval\/toiso8601()","role":"symbol","identifier":"doc:\/\/GLib\/documentation\/GLib\/TimeVal\/toIso8601()","kind":"symbol","abstract":[{"type":"text","text":"Converts "},{"code":"time","type":"codeVoice"},{"type":"text","text":" into an RFC 3339 encoded string, relative to the"},{"text":" ","type":"text"},{"text":"Coordinated Universal Time (UTC). This is one of the many formats","type":"text"},{"type":"text","text":" "},{"type":"text","text":"allowed by ISO 8601."}],"fragments":[{"text":"func","kind":"keyword"},{"kind":"text","text":" "},{"text":"toIso8601","kind":"identifier"},{"kind":"text","text":"() -> "},{"preciseIdentifier":"s:SS","text":"String","kind":"typeIdentifier"},{"text":"!","kind":"text"}],"deprecated":true},"doc://GLib/documentation/GLib/TimeVal/TimeValProtocol-Implementations":{"url":"\/documentation\/glib\/timeval\/timevalprotocol-implementations","title":"TimeValProtocol Implementations","kind":"article","identifier":"doc:\/\/GLib\/documentation\/GLib\/TimeVal\/TimeValProtocol-Implementations","abstract":[],"type":"topic","role":"collectionGroup"},"https://www.ietf.org/rfc/rfc3339.txt":{"title":"RFC 3339","titleInlineContent":[{"type":"text","text":"RFC 3339"}],"type":"link","url":"https:\/\/www.ietf.org\/rfc\/rfc3339.txt","identifier":"https:\/\/www.ietf.org\/rfc\/rfc3339.txt"},"doc://GLib/documentation/GLib":{"identifier":"doc:\/\/GLib\/documentation\/GLib","title":"GLib","abstract":[],"type":"topic","url":"\/documentation\/glib","kind":"symbol","role":"collection"},"http://www.w3.org/TR/NOTE-datetime-19980827":{"title":"Date and Time Formats","titleInlineContent":[{"text":"Date and Time Formats","type":"text"}],"type":"link","url":"http:\/\/www.w3.org\/TR\/NOTE-datetime-19980827","identifier":"http:\/\/www.w3.org\/TR\/NOTE-datetime-19980827"}}}