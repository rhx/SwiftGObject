b\/documentation\/GLib\/StaticMutex"},{"type":"text","text":" works like a "},{"isActive":true,"type":"reference","identifier":"doc:\/\/GLib\/documentation\/GLib\/Mutex"},{"text":".","type":"text"}],"role":"symbol","navigatorTitle":[{"text":"StaticMutex","kind":"identifier"}]},"doc://GLib/documentation/GLib/StaticRecMutex":{"title":"StaticRecMutex","fragments":[{"kind":"keyword","text":"class"},{"text":" ","kind":"text"},{"kind":"identifier","text":"StaticRecMutex"}],"abstract":[{"type":"text","text":"A "},{"type":"reference","identifier":"doc:\/\/GLib\/documentation\/GLib\/StaticRecMutex","isActive":true},{"text":" works like a ","type":"text"},{"isActive":true,"type":"reference","identifier":"doc:\/\/GLib\/documentation\/GLib\/StaticMutex"},{"text":", but it can be locked","type":"text"},{"type":"text","text":" "},{"type":"text","text":"multiple times by one thread. If you enter it n times, you have to"},{"type":"text","text":" "},{"text":"unlock it n times again to let other threads lock it. An exception","type":"text"},{"type":"text","text":" "},{"text":"is the function ","type":"text"},{"type":"codeVoice","code":"g_static_rec_mutex_unlock_full()"},{"type":"text","text":": that allows you to"},{"type":"text","text":" "},{"type":"text","text":"unlock a "},{"type":"reference","identifier":"doc:\/\/GLib\/documentation\/GLib\/StaticRecMutex","isActive":true},{"text":" completely returning the depth, (i.e. the","type":"text"},{"text":" ","type":"text"},{"text":"number of times this mutex was locked). The depth can later be used","type":"text"},{"type":"text","text":" "},{"type":"text","text":"to restore the state of the "},{"type":"reference","identifier":"doc:\/\/GLib\/documentation\/GLib\/StaticRecMutex","isActive":true},{"type":"text","text":" by calling"},{"type":"text","text":" "},{"type":"codeVoice","code":"g_static_rec_mutex_lock_full()"},{"type":"text","text":". In GLib 2.32, "},{"type":"reference","identifier":"doc:\/\/GLib\/documentation\/GLib\/StaticRecMut