{"kind":"symbol","sections":[],"abstract":[{"type":"text","text":"Designated initialiser from the underlying "},{"type":"codeVoice","code":"C"},{"type":"text","text":" data type."},{"text":" ","type":"text"},{"code":"GStaticRecMutex","type":"codeVoice"},{"type":"text","text":" does not allow reference counting, so despite the name no actual retaining will occur."},{"text":" ","type":"text"},{"type":"text","text":"i.e., ownership is transferred to the "},{"identifier":"doc:\/\/GLib\/documentation\/GLib\/StaticRecMutex","isActive":true,"type":"reference"},{"type":"text","text":" instance."}],"variants":[{"paths":["\/documentation\/glib\/staticrecmutex\/init(retaining:)"],"traits":[{"interfaceLanguage":"swift"}]}],"hierarchy":{"paths":[["doc:\/\/GLib\/documentation\/GLib","doc:\/\/GLib\/documentation\/GLib\/StaticRecMutex"]]},"primaryContentSections":[{"kind":"declarations","declarations":[{"languages":["swift"],"tokens":[{"kind":"keyword","text":"init"},{"kind":"text","text":"("},{"text":"retaining","kind":"externalParam"},{"text":" ","kind":"text"},{"text":"op","kind":"internalParam"},{"kind":"text","text":": "},{"kind":"typeIdentifier","text":"UnsafeMutablePointer","preciseIdentifier":"s:Sp"},{"text":"<","kind":"text"},{"text":"GStaticRecMutex","kind":"typeIdentifier"},{"text":">)","kind":"text"}],"platforms":["macOS"]}]},{"kind":"parameters","parameters":[{"content":[{"inlineContent":[{"text":"Pointer to the underlying object","type":"text"}],"type":"paragraph"}],"name":"op"}]}],"schemaVersion":{"minor":3,"major":0,"patch":0},"identifier":{"url":"doc:\/\/GLib\/documentation\/GLib\/StaticRecMutex\/init(retaining:)","interfaceLanguage":"swift"},"metadata":{"title":"init(retaining:)","role":"symbol","symbolKind":"init","modules":[{"name":"GLib"}],"fragments":[{"kind":"identifier","text":"init"},{"text":"(","kind":"text"},{"text":"retaining","kind":"externalParam"},{"text":": ","kind":"text"},{"preciseIdentifier":"s:Sp","kind":"typeIdentifier","text":"UnsafeMutablePointer"},{"kind":"text","text":"<"},{"text":"GStaticRecMutex","kind":"typeIdentifier"},{"kind":"text","text":">)"}],"externalID":"s:4GLib14StaticRecMutexC9retainingACSpySo08_GStaticcD0VG_tcfc","roleHeading":"Initializer"},"references":{"doc://GLib/documentation/GLib/RecMutex":{"fragments":[{"text":"class","kind":"keyword"},{"text":" ","kind":"text"},{"kind":"identifier","text":"RecMutex"}],"abstract":[{"text":"The GRecMutex struct is an opaque data structure to represent a","type":"text"},{"type":"text","text":" "},{"text":"recursive mutex. It is similar to a ","type":"text"},{"type":"reference","identifier":"doc:\/\/GLib\/documentation\/GLib\/Mutex","isActive":true},{"text":" with the difference","type":"text"},{"type":"text","text":" "},{"type":"text","text":"that it is possible to lock a GRecMutex multiple times in the same"},{"type":"text","text":" "},{"type":"text","text":"thread without deadlock. When doing so, care has to be taken to"},{"text":" ","type":"text"},{"type":"text","text":"unlock the recursive mutex as often as it has been locked."}],"url":"\/documentation\/glib\/recmutex","identifier":"doc:\/\/GLib\/documentation\/GLib\/RecMutex","title":"RecMutex","type":"topic","kind":"symbol","role":"symbol","navigatorTitle":[{"kind":"identifier","text":"RecMutex"}]},"doc://GLib/documentation/GLib/StaticMutex":{"type":"topic","url":"\/documentation\/glib\/staticmutex","fragments":[{"text":"class","kind":"keyword"},{"text":" ","kind":"text"},{"kind":"identifier","text":"StaticMutex"}],"kind":"symbol","identifier":"doc:\/\/GLib\/documentation\/GLib\/StaticMutex","title":"StaticMutex","abstract":[{"text":"A ","type":"text"},{"isActive":true,"type":"reference","identifier":"doc:\/\/GLib\/documentation\/GLib\/StaticMutex"},{"type":"text","text":" works like a "},{"isActive":true,"type":"reference","identifier":"doc:\/\/GLib\/documentation\/GLib\/Mutex"},{"text":".","type":"text"}],"role":"symbol","navigatorTitle":[{"text":"StaticMutex","kind":"identifier"}]},"doc://GLib/documentation/GLib":{"identifier":"doc:\/\/GLib\/documentation\/GLib","title":"GLib","abstract":[],"type":"topic","url":"\/documentation\/glib","kind":"symbol","role":"collection"},"doc://GLib/documentation/GLib/StaticRecMutex":{"title":"StaticRecMutex","fragments":[{"kind":"keyword","text":"class"},{"text":" ","kind":"text"},{"kind":"identifier","text":"StaticRecMutex"}],"abstract":[{"type":"text","text":"A "},{"type":"reference","identifier":"doc:\/\/GLib\/documentation\/GLib\/StaticRecMutex","isActive":true},{"text":" works like a ","type":"text"},{"isActive":true,"type":"reference","identifier":"doc:\/\/GLib\/documentation\/GLib\/StaticMutex"},{"text":", but it can be locked","type":"text"},{"type":"text","text":" "},{"type":"text","text":"multiple times by one thread. If you enter it n times, you have to"},{"type":"text","text":" "},{"text":"unlock it n times again to let other threads lock it. An exception","type":"text"},{"type":"text","text":" "},{"text":"is the function ","type":"text"},{"type":"codeVoice","code":"g_static_rec_mutex_unlock_full()"},{"type":"text","text":": that allows you to"},{"type":"text","text":" "},{"type":"text","text":"unlock a "},{"type":"reference","identifier":"doc:\/\/GLib\/documentation\/GLib\/StaticRecMutex","isActive":true},{"text":" completely returning the depth, (i.e. the","type":"text"},{"text":" ","type":"text"},{"text":"number of times this mutex was locked). The depth can later be used","type":"text"},{"type":"text","text":" "},{"type":"text","text":"to restore the state of the "},{"type":"reference","identifier":"doc:\/\/GLib\/documentation\/GLib\/StaticRecMutex","isActive":true},{"type":"text","text":" by calling"},{"type":"text","text":" "},{"type":"codeVoice","code":"g_static_rec_mutex_lock_full()"},{"type":"text","text":". In GLib 2.32, "},{"type":"reference","identifier":"doc:\/\/GLib\/documentation\/GLib\/StaticRecMutex","isActive":true},{"type":"text","text":" has"},{"type":"text","text":" "},{"text":"been deprecated in favor of ","type":"text"},{"type":"reference","isActive":true,"identifier":"doc:\/\/GLib\/documentation\/GLib\/RecMutex"},{"type":"text","text":"."}],"url":"\/documentation\/glib\/staticrecmutex","navigatorTitle":[{"text":"StaticRecMutex","kind":"identifier"}],"type":"topic","kind":"symbol","identifier":"doc:\/\/GLib\/documentation\/GLib\/StaticRecMutex","role":"symbol"},"doc://GLib/documentation/GLib/StaticRecMutex/init(retaining:)":{"role":"symbol","identifier":"doc:\/\/GLib\/documentation\/GLib\/StaticRecMutex\/init(retaining:)","type":"topic","url":"\/documentation\/glib\/staticrecmutex\/init(retaining:)","kind":"symbol","abstract":[{"type":"text","text":"Designated initialiser from the underlying "},{"type":"codeVoice","code":"C"},{"text":" data type.","type":"text"},{"text":" ","type":"text"},{"code":"GStaticRecMutex","type":"codeVoice"},{"text":" does not allow reference counting, so despite the name no actual retaining will occur.","type":"text"},{"type":"text","text":" "},{"type":"text","text":"i.e., ownership is transferred to the "},{"identifier":"doc:\/\/GLib\/documentation\/GLib\/StaticRecMutex","isActive":true,"type":"reference"},{"text":" instance.","type":"text"}],"fragments":[{"text":"init","kind":"identifier"},{"text":"(","kind":"text"},{"text":"retaining","kind":"externalParam"},{"text":": ","kind":"text"},{"text":"UnsafeMutablePointer","kind":"typeIdentifier","preciseIdentifier":"s:Sp"},{"kind":"text","text":"<"},{"kind":"typeIdentifier","text":"GStaticRecMutex"},{"text":">)","kind":"text"}],"title":"init(retaining:)"}}}