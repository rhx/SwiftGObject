/\/GLib\/documentation\/GLib\/StaticRecMutex","isActive":true},{"text":" completely returning the depth, (i.e. the","type":"text"},{"text":" ","type":"text"},{"text":"number of times this mutex was locked). The depth can later be used","type":"text"},{"type":"text","text":" "},{"type":"text","text":"to restore the state of the "},{"type":"reference","identifier":"doc:\/\/GLib\/documentation\/GLib\/StaticRecMutex","isActive":true},{"type":"text","text":" by calling"},{"type":"text","text":" "},{"type":"codeVoice","code":"g_static_rec_mutex_lock_full()"},{"type":"text","text":". In GLib 2.32, "},{"type":"reference","identifier":"doc:\/\/GLib\/documentation\/GLib\/StaticRecMutex","isActive":true},{"type":"text","text":" has"},{"type":"text","text":" "},{"text":"been deprecated in favor of ","type":"text"},{"type":"reference","isActive":true,"identifier":"doc:\/\/GLib\/documentation\/GLib\/RecMutex"},{"type":"text","text":"."}],"url":"\/documentation\/glib\/staticrecmutex","navigatorTitle":[{"text":"StaticRecMutex","kind":"identifier"}],"type":"topic","kind":"symbol","identifier":"doc:\/\/GLib\/documentation\/GLib\/StaticRecMutex","role":"symbol"},"doc://GLib/documentation/GLib/StaticRecMutex/init(_:)-1iu63":{"role":"symbol","identifier":"doc:\/\/GLib\/documentation\/GLib\/StaticRecMutex\/init(_:)-1iu63","kind":"symbol","url":"\/documentation\/glib\/staticrecmutex\/init(_:)-1iu63","type":"topic","abstract":[{"type":"text","text":"Optional initialiser from the underlying "},{"code":"C","type":"codeVoice"},{"text":" data type.","type":"text"},{"text":" ","type":"text"},{"text":"This creates an instance without performing an unbalanced retain","type":"text"},{"text":" ","type":"text"},{"type":"text","text":"i.e., ownership is transferred to the "},{"identifier":"doc:\/\/GLib\/documentation\/GLib\/StaticRecMutex","type":"reference","isActive":true},{"text":" instance.","type":"text"}],"fragments":[{"kind":"identifier","text":"init"},{"kind":"text","text":"!("},{"text":"Unsa