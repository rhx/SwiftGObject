 used","type":"text"},{"type":"text","text":" "},{"type":"text","text":"to restore the state of the "},{"type":"reference","identifier":"doc:\/\/GLib\/documentation\/GLib\/StaticRecMutex","isActive":true},{"type":"text","text":" by calling"},{"type":"text","text":" "},{"type":"codeVoice","code":"g_static_rec_mutex_lock_full()"},{"type":"text","text":". In GLib 2.32, "},{"type":"reference","identifier":"doc:\/\/GLib\/documentation\/GLib\/StaticRecMutex","isActive":true},{"type":"text","text":" has"},{"type":"text","text":" "},{"text":"been deprecated in favor of ","type":"text"},{"type":"reference","isActive":true,"identifier":"doc:\/\/GLib\/documentation\/GLib\/RecMutex"},{"type":"text","text":"."}],"url":"\/documentation\/glib\/staticrecmutex","navigatorTitle":[{"text":"StaticRecMutex","kind":"identifier"}],"type":"topic","kind":"symbol","identifier":"doc:\/\/GLib\/documentation\/GLib\/StaticRecMutex","role":"symbol"},"doc://GLib/documentation/GLib/StaticRecMutex/free()":{"identifier":"doc:\/\/GLib\/documentation\/GLib\/StaticRecMutex\/free()","abstract":[{"type":"text","text":"Releases all resources allocated to a "},{"identifier":"doc:\/\/GLib\/documentation\/GLib\/StaticRecMutex","isActive":true,"type":"reference"},{"type":"text","text":"."}],"deprecated":true,"url":"\/documentation\/glib\/staticrecmutex\/free()","role":"symbol","title":"free()","kind":"symbol","type":"topic","fragments":[{"text":"func","kind":"keyword"},{"text":" ","kind":"text"},{"text":"free","kind":"identifier"},{"kind":"text","text":"()"}]},"doc://GLib/documentation/GLib/RecMutex":{"fragments":[{"text":"class","kind":"keyword"},{"text":" ","kind":"text"},{"kind":"identifier","text":"RecMutex"}],"abstract":[{"text":"The GRecMutex struct is an opaque data structure to represent a","type":"text"},{"type":"text","text":" "},{"text":"recursive mutex. It is similar to a ","type":"text"},{"type":"reference","identifier":"doc:\/\/GLib\/documentation\/GLib\/Mutex","isActive":true},{"text":" with the difference","type":"text"},{"type":"text","text":" "},{"type":"text","text":"that it is possible to lock a GRecMutex multiple times in the same"},{"type":"text","text":" "},{"type":"text","text":"thread without deadlock. When doing so, care has to be taken to"},{"text":" ","type":"text"},{"type":"text","text":"unlock the recursive mutex as often as it has been locked."}],"url":"\/documentation\/glib\/recmutex","identifier":"doc:\/\/GLib\/documentation\/GLib\/RecMutex","title":"RecMutex","type":"topic","kind":"symbol","role":"symbol","navigatorTitle":[{"kind":"identifier","text":"RecMutex"}]},"doc://GLib/documentation/GLib":{"identifier":"doc:\/\/GLib\/documentation\/GLib","title":"GLib","abstract":[],"type":"topic","url":"\/documentation\/glib","kind":"symbol","role":"collection"},"doc://GLib/documentation/GLib/StaticRecMutex/lock()":{"type":"topic","title":"lock()","url":"\/documentation\/glib\/staticrecmutex\/lock()","fragments":[{"text":"func","kind":"keyword"},{"kind":"text","text":" "},{"kind":"identifier","text":"lock"},{"kind":"text","text":"()"}],"deprecated":true,"identifier":"doc:\/\/GLib\/documentation\/GLib\/StaticRecMutex\/lock()","abstract":[{"text":"Locks ","type":"text"},{"type":"codeVoice","code":"mutex"},{"type":"text","text":". If "},{"type":"codeVoice","code":"mutex"},{"type":"text","text":" is already locked by another thread, the"},{"type":"text","text":" "},{"type":"text","text":"current thread will block until "},{"type":"codeVoice","code":"mutex"},{"text":" is unlocked by the other","type":"text"},{"type":"text","text":" "},{"text":"thread. If ","type":"text"},{"type":"codeVoice","code":"mutex"},{"type":"text","text":" is already locked by the calling thread, this"},{"type":"text","text":" "},{"type":"text","text":"functions increases the depth of "},{"code":"mutex","type":"codeVoice"},{"type":"text","text":" and returns immediately."}],"kind":"symbol","role":"symbol"},"doc://GLib/documentation/GLib/StaticRecMutex/unlockFull()":{"type":"top