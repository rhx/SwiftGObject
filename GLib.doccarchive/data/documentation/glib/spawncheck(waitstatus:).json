{"abstract":[{"type":"text","text":"Set "},{"code":"error","type":"codeVoice"},{"type":"text","text":" if "},{"type":"codeVoice","code":"waitStatus"},{"text":" indicates the child exited abnormally","type":"text"},{"text":" ","type":"text"},{"text":"(e.g. with a nonzero exit code, or via a fatal signal).","type":"text"}],"primaryContentSections":[{"kind":"declarations","declarations":[{"languages":["swift"],"tokens":[{"text":"func","kind":"keyword"},{"kind":"text","text":" "},{"text":"spawnCheck","kind":"identifier"},{"kind":"text","text":"("},{"text":"waitStatus","kind":"externalParam"},{"kind":"text","text":": "},{"text":"Int","kind":"typeIdentifier","preciseIdentifier":"s:Si"},{"text":") ","kind":"text"},{"kind":"keyword","text":"throws"},{"kind":"text","text":" -> "},{"preciseIdentifier":"s:Sb","text":"Bool","kind":"typeIdentifier"}],"platforms":["macOS"]}]},{"kind":"content","content":[{"text":"Discussion","level":2,"anchor":"discussion","type":"heading"},{"inlineContent":[{"type":"text","text":"The "},{"type":"codeVoice","code":"g_spawn_sync()"},{"type":"text","text":" and "},{"code":"g_child_watch_add()","type":"codeVoice"},{"text":" family of APIs return the","type":"text"},{"text":" ","type":"text"},{"type":"text","text":"status of subprocesses encoded in a platform-specific way."},{"text":" ","type":"text"},{"text":"On Unix, this is guaranteed to be in the same format ","type":"text"},{"type":"codeVoice","code":"waitpid()"},{"type":"text","text":" returns,"},{"text":" ","type":"text"},{"type":"text","text":"and on Windows it is guaranteed to be the result of "},{"type":"codeVoice","code":"GetExitCodeProcess()"},{"type":"text","text":"."}],"type":"paragraph"},{"type":"paragraph","inlineContent":[{"type":"text","text":"Prior to the introduction of this function in GLib 2.34, interpreting"},{"type":"text","text":" "},{"code":"waitStatus","type":"codeVoice"},{"type":"text","text":" required use of platform-specific APIs, which is problematic"},{"text":" ","type":"text"},{"text":"for software using GLib as a cross-platform layer.","type":"text"}]},{"inlineContent":[{"type":"text","text":"Additionally, many programs simply want to determine whether or not"},{"type":"text","text":" "},{"type":"text","text":"the child exited successfully, and either propagate a "},{"identifier":"doc:\/\/GLib\/documentation\/GLib\/GLibError","type":"reference","isActive":true},{"type":"text","text":" or"},{"text":" ","type":"text"},{"type":"text","text":"print a message to standard error. In that common case, this function"},{"type":"text","text":" "},{"type":"text","text":"can be used. Note that the error message in "},{"code":"error","type":"codeVoice"},{"text":" will contain","type":"text"},{"text":" ","type":"text"},{"type":"text","text":"human-readable information about the wait status."}],"type":"paragraph"},{"inlineContent":[{"type":"text","text":"The "},{"type":"codeVoice","code":"domain"},{"type":"text","text":" and "},{"type":"codeVoice","code":"code"},{"type":"text","text":" of "},{"code":"error","type":"codeVoice"},{"type":"text","text":" have special semantics in the case"},{"type":"text","text":" "},{"text":"where the process has an “exit code”, as opposed to being killed by","type":"text"},{"text":" ","type":"text"},{"text":"a signal. On Unix, this happens if ","type":"text"},{"type":"codeVoice","code":"WIFEXITED()"},{"text":" would be true of","type":"text"},{"type":"text","text":" "},{"type":"codeVoice","code":"waitStatus"},{"text":". On Windows, it is always the case.","type":"text"}],"type":"paragraph"},{"inlineContent":[{"type":"text","text":"The special semantics are that the actual exit code will be the"},{"text":" ","type":"text"},{"type":"text","text":"code set in "},{"type":"codeVoice","code":"error"},{"text":", and the domain will be ","type":"text"},{"type":"codeVoice","code":"G_SPAWN_EXIT_ERROR"},{"type":"text","text":"."},{"text":" ","type":"text"},{"text":"This allows you to differentiate between different exit codes.","type":"text"}],"type":"paragraph"},{"inlineContent":[{"type":"text","text":"If the process was terminated by some means other than an exit"},{"type":"text","text":" "},{"text":"status (for example if it was killed by a signal), the domain will be","type":"text"},{"text":" ","type":"text"},{"type":"codeVoice","code":"G_SPAWN_ERROR"},{"type":"text","text":" and the code will be "},{"code":"failed","type":"codeVoice"},{"type":"text","text":"."}],"type":"paragraph"},{"type":"paragraph","inlineContent":[{"text":"This function just offers convenience; you can of course also check","type":"text"},{"text":" ","type":"text"},{"text":"the available platform via a macro such as ","type":"text"},{"type":"codeVoice","code":"G_OS_UNIX"},{"text":", and use","type":"text"},{"type":"text","text":" "},{"type":"codeVoice","code":"WIFEXITED()"},{"type":"text","text":" and "},{"code":"WEXITSTATUS()","type":"codeVoice"},{"text":" on ","type":"text"},{"type":"codeVoice","code":"waitStatus"},{"type":"text","text":" directly. Do not attempt"},{"type":"text","text":" "},{"type":"text","text":"to scan or parse the error message string; it may be translated and\/or"},{"text":" ","type":"text"},{"text":"change in future versions of GLib.","type":"text"}]},{"inlineContent":[{"type":"text","text":"Prior to version 2.70, "},{"code":"g_spawn_check_exit_status()","type":"codeVoice"},{"text":" provides the same","type":"text"},{"text":" ","type":"text"},{"text":"functionality, although under a misleading name.","type":"text"}],"type":"paragraph"}]}],"variants":[{"paths":["\/documentation\/glib\/spawncheck(waitstatus:)"],"traits":[{"interfaceLanguage":"swift"}]}],"hierarchy":{"paths":[["doc:\/\/GLib\/documentation\/GLib"]]},"schemaVersion":{"major":0,"patch":0,"minor":3},"sections":[],"metadata":{"symbolKind":"func","modules":[{"name":"GLib"}],"title":"spawnCheck(waitStatus:)","fragments":[{"kind":"keyword","text":"func"},{"kind":"text","text":" "},{"text":"spawnCheck","kind":"identifier"},{"kind":"text","text":"("},{"text":"waitStatus","kind":"externalParam"},{"text":": ","kind":"text"},{"preciseIdentifier":"s:Si","kind":"typeIdentifier","text":"Int"},{"kind":"text","text":") "},{"kind":"keyword","text":"throws"},{"text":" -> ","kind":"text"},{"preciseIdentifier":"s:Sb","kind":"typeIdentifier","text":"Bool"}],"role":"symbol","externalID":"s:4GLib10spawnCheck10waitStatusSbSi_tKF","roleHeading":"Function"},"kind":"symbol","identifier":{"url":"doc:\/\/GLib\/documentation\/GLib\/spawnCheck(waitStatus:)","interfaceLanguage":"swift"},"references":{"doc://GLib/documentation/GLib":{"identifier":"doc:\/\/GLib\/documentation\/GLib","title":"GLib","abstract":[],"type":"topic","url":"\/documentation\/glib","kind":"symbol","role":"collection"},"doc://GLib/documentation/GLib/GLibError":{"navigatorTitle":[{"kind":"identifier","text":"GLibError"}],"role":"symbol","title":"GLibError","identifier":"doc:\/\/GLib\/documentation\/GLib\/GLibError","url":"\/documentation\/glib\/gliberror","abstract":[{"type":"text","text":"The "},{"type":"codeVoice","code":"GError"},{"type":"text","text":" structure contains information about"},{"type":"text","text":" "},{"text":"an error that has occurred.","type":"text"}],"fragments":[{"kind":"keyword","text":"class"},{"kind":"text","text":" "},{"text":"GLibError","kind":"identifier"}],"type":"topic","kind":"symbol"},"doc://GLib/documentation/GLib/spawnCheck(waitStatus:)":{"title":"spawnCheck(waitStatus:)","role":"symbol","fragments":[{"kind":"keyword","text":"func"},{"kind":"text","text":" "},{"text":"spawnCheck","kind":"identifier"},{"text":"(","kind":"text"},{"kind":"externalParam","text":"waitStatus"},{"kind":"text","text":": "},{"preciseIdentifier":"s:Si","kind":"typeIdentifier","text":"Int"},{"text":") ","kind":"text"},{"kind":"keyword","text":"throws"},{"kind":"text","text":" -> "},{"kind":"typeIdentifier","text":"Bool","preciseIdentifier":"s:Sb"}],"identifier":"doc:\/\/GLib\/documentation\/GLib\/spawnCheck(waitStatus:)","abstract":[{"type":"text","text":"Set "},{"type":"codeVoice","code":"error"},{"text":" if ","type":"text"},{"type":"codeVoice","code":"waitStatus"},{"type":"text","text":" indicates the child exited abnormally"},{"text":" ","type":"text"},{"type":"text","text":"(e.g. with a nonzero exit code, or via a fatal signal)."}],"kind":"symbol","type":"topic","url":"\/documentation\/glib\/spawncheck(waitstatus:)"}}}