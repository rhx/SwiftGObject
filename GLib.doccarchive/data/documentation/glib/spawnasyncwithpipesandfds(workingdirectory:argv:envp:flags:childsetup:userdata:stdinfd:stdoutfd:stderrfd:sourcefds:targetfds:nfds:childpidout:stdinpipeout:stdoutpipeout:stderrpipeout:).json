{"identifier":{"url":"doc:\/\/GLib\/documentation\/GLib\/spawnAsyncWithPipesAndFds(workingDirectory:argv:envp:flags:childSetup:userData:stdinFd:stdoutFd:stderrFd:sourceFds:targetFds:nFds:childPidOut:stdinPipeOut:stdoutPipeOut:stderrPipeOut:)","interfaceLanguage":"swift"},"primaryContentSections":[{"kind":"declarations","declarations":[{"platforms":["macOS"],"tokens":[{"kind":"keyword","text":"func"},{"text":" ","kind":"text"},{"text":"spawnAsyncWithPipesAndFds","kind":"identifier"},{"kind":"text","text":"("},{"text":"workingDirectory","kind":"externalParam"},{"kind":"text","text":": "},{"text":"UnsafePointer","kind":"typeIdentifier","preciseIdentifier":"s:SP"},{"text":"<","kind":"text"},{"kind":"typeIdentifier","text":"gchar","preciseIdentifier":"c:@T@gchar"},{"kind":"text","text":">? = nil, "},{"kind":"externalParam","text":"argv"},{"text":": ","kind":"text"},{"text":"UnsafePointer","kind":"typeIdentifier","preciseIdentifier":"s:SP"},{"kind":"text","text":"<"},{"preciseIdentifier":"s:SP","kind":"typeIdentifier","text":"UnsafePointer"},{"kind":"text","text":"<"},{"preciseIdentifier":"c:@T@gchar","kind":"typeIdentifier","text":"gchar"},{"text":">?>!, ","kind":"text"},{"kind":"externalParam","text":"envp"},{"text":": ","kind":"text"},{"preciseIdentifier":"s:SP","kind":"typeIdentifier","text":"UnsafePointer"},{"kind":"text","text":"<"},{"preciseIdentifier":"s:SP","kind":"typeIdentifier","text":"UnsafePointer"},{"text":"<","kind":"text"},{"text":"gchar","kind":"typeIdentifier","preciseIdentifier":"c:@T@gchar"},{"text":">?>! = nil, ","kind":"text"},{"text":"flags","kind":"externalParam"},{"kind":"text","text":": "},{"kind":"typeIdentifier","preciseIdentifier":"s:4GLib10SpawnFlagsV","identifier":"doc:\/\/GLib\/documentation\/GLib\/SpawnFlags","text":"SpawnFlags"},{"kind":"text","text":", "},{"text":"childSetup","kind":"externalParam"},{"text":": ","kind":"text"},{"text":"GSpawnChildSetupFunc","kind":"typeIdentifier","preciseIdentifier":"c:@T@GSpawnChildSetupFunc"},{"text":"? = nil, ","kind":"text"},{"kind":"externalParam","text":"userData"},{"text":": ","kind":"text"},{"kind":"typeIdentifier","preciseIdentifier":"c:@T@gpointer","text":"gpointer"},{"kind":"text","text":"? = nil, "},{"text":"stdinFd","kind":"externalParam"},{"kind":"text","text":": "},{"text":"Int","kind":"typeIdentifier","preciseIdentifier":"s:Si"},{"text":", ","kind":"text"},{"kind":"externalParam","text":"stdoutFd"},{"kind":"text","text":": "},{"preciseIdentifier":"s:Si","text":"Int","kind":"typeIdentifier"},{"kind":"text","text":", "},{"kind":"externalParam","text":"stderrFd"},{"text":": ","kind":"text"},{"kind":"typeIdentifier","text":"Int","preciseIdentifier":"s:Si"},{"kind":"text","text":", "},{"kind":"externalParam","text":"sourceFds"},{"text":": ","kind":"text"},{"kind":"typeIdentifier","preciseIdentifier":"s:SP","text":"UnsafePointer"},{"kind":"text","text":"<"},{"text":"gint","kind":"typeIdentifier","preciseIdentifier":"c:@T@gint"},{"text":">! = nil, ","kind":"text"},{"text":"targetFds","kind":"externalParam"},{"kind":"text","text":": "},{"text":"UnsafePointer","kind":"typeIdentifier","preciseIdentifier":"s:SP"},{"kind":"text","text":"<"},{"kind":"typeIdentifier","text":"gint","preciseIdentifier":"c:@T@gint"},{"text":">! = nil, ","kind":"text"},{"text":"nFds","kind":"externalParam"},{"text":": ","kind":"text"},{"text":"Int","preciseIdentifier":"s:Si","kind":"typeIdentifier"},{"kind":"text","text":", "},{"kind":"externalParam","text":"childPidOut"},{"kind":"text","text":": "},{"preciseIdentifier":"s:Sp","kind":"typeIdentifier","text":"UnsafeMutablePointer"},{"text":"<","kind":"text"},{"text":"GPid","kind":"typeIdentifier","preciseIdentifier":"c:@T@GPid"},{"text":">! = nil, ","kind":"text"},{"text":"stdinPipeOut","kind":"externalParam"},{"kind":"text","text":": "},{"kind":"typeIdentifier","text":"UnsafeMutablePointer","preciseIdentifier":"s:Sp"},{"text":"<","kind":"text"},{"preciseIdentifier":"c:@T@gint","text":"gint","kind":"typeIdentifier"},{"text":">! = nil, ","kind":"text"},{"kind":"externalParam","text":"stdoutPipeOut"},{"kind":"text","text":": "},{"preciseIdentifier":"s:Sp","text":"UnsafeMutablePointer","kind":"typeIdentifier"},{"text":"<","kind":"text"},{"kind":"typeIdentifier","text":"gint","preciseIdentifier":"c:@T@gint"},{"kind":"text","text":">! = nil, "},{"kind":"externalParam","text":"stderrPipeOut"},{"text":": ","kind":"text"},{"text":"UnsafeMutablePointer","preciseIdentifier":"s:Sp","kind":"typeIdentifier"},{"kind":"text","text":"<"},{"preciseIdentifier":"c:@T@gint","text":"gint","kind":"typeIdentifier"},{"kind":"text","text":">! = nil) "},{"kind":"keyword","text":"throws"},{"text":" -> ","kind":"text"},{"kind":"typeIdentifier","text":"Bool","preciseIdentifier":"s:Sb"}],"languages":["swift"]}]},{"content":[{"level":2,"type":"heading","anchor":"discussion","text":"Discussion"},{"type":"paragraph","inlineContent":[{"type":"text","text":"The child program is specified by the only argument that must be"},{"type":"text","text":" "},{"type":"text","text":"provided, "},{"type":"codeVoice","code":"argv"},{"text":". ","type":"text"},{"type":"codeVoice","code":"argv"},{"type":"text","text":" should be a "},{"code":"nil","type":"codeVoice"},{"type":"text","text":"-terminated array of strings,"},{"type":"text","text":" "},{"type":"text","text":"to be passed as the argument vector for the child. The first string"},{"text":" ","type":"text"},{"type":"text","text":"in "},{"code":"argv","type":"codeVoice"},{"text":" is of course the name of the program to execute. By default,","type":"text"},{"type":"text","text":" "},{"type":"text","text":"the name of the program must be a full path. If "},{"type":"codeVoice","code":"flags"},{"type":"text","text":" contains the"},{"type":"text","text":" "},{"type":"codeVoice","code":"searchPath"},{"type":"text","text":" flag, the "},{"type":"codeVoice","code":"PATH"},{"type":"text","text":" environment variable is used to"},{"type":"text","text":" "},{"type":"text","text":"search for the executable. If "},{"type":"codeVoice","code":"flags"},{"type":"text","text":" contains the"},{"type":"text","text":" "},{"type":"codeVoice","code":"searchPathFromEnvp"},{"text":" flag, the ","type":"text"},{"code":"PATH","type":"codeVoice"},{"text":" variable from ","type":"text"},{"code":"envp","type":"codeVoice"},{"type":"text","text":" "},{"type":"text","text":"is used to search for the executable. If both the"},{"text":" ","type":"text"},{"type":"codeVoice","code":"searchPath"},{"type":"text","text":" and "},{"type":"codeVoice","code":"searchPathFromEnvp"},{"text":" flags are","type":"text"},{"text":" ","type":"text"},{"type":"text","text":"set, the "},{"code":"PATH","type":"codeVoice"},{"text":" variable from ","type":"text"},{"code":"envp","type":"codeVoice"},{"text":" takes precedence over the","type":"text"},{"type":"text","text":" "},{"text":"environment variable.","type":"text"}]},{"inlineContent":[{"text":"If the program name is not a full path and ","type":"text"},{"code":"searchPath","type":"codeVoice"},{"type":"text","text":" flag"},{"text":" ","type":"text"},{"type":"text","text":"is not used, then the program will be run from the current directory"},{"type":"text","text":" "},{"text":"(or ","type":"text"},{"code":"workingDirectory","type":"codeVoice"},{"text":", if specified); this might be unexpected or even","type":"text"},{"type":"text","text":" "},{"type":"text","text":"dangerous in some cases when the current directory is world-writable."}],"type":"paragraph"},{"inlineContent":[{"type":"text","text":"On Windows, note that all the string or string vector arguments to"},{"type":"text","text":" "},{"text":"this function and the other ","type":"text"},{"code":"g_spawn*()","type":"codeVoice"},{"type":"text","text":" functions are in UTF-8, the"},{"type":"text","text":" "},{"type":"text","text":"GLib file name encoding. Unicode characters that are not part of"},{"text":" ","type":"text"},{"text":"the system codepage passed in these arguments will be correctly","type":"text"},{"text":" ","type":"text"},{"text":"available in the spawned program only if it uses wide character API","type":"text"},{"text":" ","type":"text"},{"text":"to retrieve its command line. For C programs built with Microsoft’s","type":"text"},{"type":"text","text":" "},{"text":"tools it is enough to make the program have a ","type":"text"},{"code":"wmain()","type":"codeVoice"},{"text":" instead of","type":"text"},{"text":" ","type":"text"},{"code":"main()","type":"codeVoice"},{"text":". ","type":"text"},{"type":"codeVoice","code":"wmain()"},{"text":" has a wide character argument vector as parameter.","type":"text"}],"type":"paragraph"},{"type":"paragraph","inlineContent":[{"type":"text","text":"At least currently, mingw doesn’t support "},{"type":"codeVoice","code":"wmain()"},{"type":"text","text":", so if you use"},{"type":"text","text":" "},{"text":"mingw to develop the spawned program, it should call","type":"text"},{"type":"text","text":" "},{"type":"codeVoice","code":"g_win32_get_command_line()"},{"type":"text","text":" to get arguments in UTF-8."}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"On Windows the low-level child process creation API "},{"type":"codeVoice","code":"CreateProcess()"},{"type":"text","text":" "},{"type":"text","text":"doesn’t use argument vectors, but a command line. The C runtime"},{"type":"text","text":" "},{"text":"library’s ","type":"text"},{"type":"codeVoice","code":"spawn*()"},{"text":" family of functions (which ","type":"text"},{"type":"codeVoice","code":"g_spawn_async_with_pipes()"},{"text":" ","type":"text"},{"text":"eventually calls) paste the argument vector elements together into","type":"text"},{"text":" ","type":"text"},{"type":"text","text":"a command line, and the C runtime startup code does a corresponding"},{"text":" ","type":"text"},{"text":"reconstruction of an argument vector from the command line, to be","type":"text"},{"text":" ","type":"text"},{"text":"passed to ","type":"text"},{"type":"codeVoice","code":"main()"},{"type":"text","text":". Complications arise when you have argument vector"},{"text":" ","type":"text"},{"type":"text","text":"elements that contain spaces or double quotes. The "},{"code":"spawn*()","type":"codeVoice"},{"text":" functions","type":"text"},{"type":"text","text":" "},{"type":"text","text":"don’t do any quoting or escaping, but on the other hand the startup"},{"text":" ","type":"text"},{"text":"code does do unquoting and unescaping in order to enable receiving","type":"text"},{"text":" ","type":"text"},{"type":"text","text":"arguments with embedded spaces or double quotes. To work around this"},{"type":"text","text":" "},{"type":"text","text":"asymmetry, "},{"code":"g_spawn_async_with_pipes()","type":"codeVoice"},{"type":"text","text":" will do quoting and escaping on"},{"type":"text","text":" "},{"type":"text","text":"argument vector elements that need it before calling the C runtime"},{"text":" ","type":"text"},{"type":"codeVoice","code":"spawn()"},{"text":" function.","type":"text"}]},{"type":"paragraph","inlineContent":[{"text":"The returned ","type":"text"},{"type":"codeVoice","code":"child_pid"},{"text":" on Windows is a handle to the child","type":"text"},{"text":" ","type":"text"},{"text":"process, not its identifier. Process handles and process","type":"text"},{"type":"text","text":" "},{"type":"text","text":"identifiers are different concepts on Windows."}]},{"inlineContent":[{"type":"codeVoice","code":"envp"},{"type":"text","text":" is a "},{"type":"codeVoice","code":"nil"},{"text":"-terminated array of strings, where each string","type":"text"},{"text":" ","type":"text"},{"text":"has the form ","type":"text"},{"type":"codeVoice","code":"KEY=VALUE"},{"text":". This will become the child’s environment.","type":"text"},{"type":"text","text":" "},{"type":"text","text":"If "},{"code":"envp","type":"codeVoice"},{"text":" is ","type":"text"},{"code":"nil","type":"codeVoice"},{"text":", the child inherits its parent’s environment.","type":"text"}],"type":"paragraph"},{"inlineContent":[{"code":"flags","type":"codeVoice"},{"type":"text","text":" should be the bitwise OR of any flags you want to affect the"},{"text":" ","type":"text"},{"type":"text","text":"function’s behaviour. The "},{"type":"codeVoice","code":"doNotReapChild"},{"type":"text","text":" means that the"},{"type":"text","text":" "},{"text":"child will not automatically be reaped; you must use a child watch","type":"text"},{"type":"text","text":" "},{"text":"(","type":"text"},{"code":"g_child_watch_add()","type":"codeVoice"},{"type":"text","text":") to be notified about the death of the child process,"},{"type":"text","text":" "},{"text":"otherwise it will stay around as a zombie process until this process exits.","type":"text"},{"type":"text","text":" "},{"type":"text","text":"Eventually you must call "},{"code":"g_spawn_close_pid()","type":"codeVoice"},{"text":" on the ","type":"text"},{"type":"codeVoice","code":"child_pid"},{"type":"text","text":", in order to"},{"type":"text","text":" "},{"text":"free resources which may be associated with the child process. (On Unix,","type":"text"},{"type":"text","text":" "},{"type":"text","text":"using a child watch is equivalent to calling "},{"type":"codeVoice","code":"waitpid()"},{"text":" or handling","type":"text"},{"type":"text","text":" "},{"type":"text","text":"the "},{"type":"codeVoice","code":"SIGCHLD"},{"type":"text","text":" signal manually. On Windows, calling "},{"type":"codeVoice","code":"g_spawn_close_pid()"},{"type":"text","text":" "},{"type":"text","text":"is equivalent to calling "},{"code":"CloseHandle()","type":"codeVoice"},{"type":"text","text":" on the process handle returned"},{"type":"text","text":" "},{"text":"in ","type":"text"},{"type":"codeVoice","code":"child_pid"},{"text":"). See ","type":"text"},{"type":"codeVoice","code":"g_child_watch_add()"},{"type":"text","text":"."}],"type":"paragraph"},{"inlineContent":[{"type":"text","text":"Open UNIX file descriptors marked as "},{"code":"FD_CLOEXEC","type":"codeVoice"},{"type":"text","text":" will be automatically"},{"type":"text","text":" "},{"type":"text","text":"closed in the child process. "},{"type":"codeVoice","code":"leaveDescriptorsOpen"},{"type":"text","text":" means that"},{"type":"text","text":" "},{"text":"other open file descriptors will be inherited by the child; otherwise all","type":"text"},{"text":" ","type":"text"},{"text":"descriptors except stdin\/stdout\/stderr will be closed before calling ","type":"text"},{"code":"exec()","type":"codeVoice"},{"text":" ","type":"text"},{"type":"text","text":"in the child. "},{"type":"codeVoice","code":"searchPath"},{"type":"text","text":" means that "},{"type":"codeVoice","code":"argv"},{"text":"[0] need not be an","type":"text"},{"text":" ","type":"text"},{"type":"text","text":"absolute path, it will be looked for in the "},{"type":"codeVoice","code":"PATH"},{"type":"text","text":" environment"},{"type":"text","text":" "},{"type":"text","text":"variable. "},{"type":"codeVoice","code":"searchPathFromEnvp"},{"text":" means need not be an","type":"text"},{"type":"text","text":" "},{"type":"text","text":"absolute path, it will be looked for in the "},{"code":"PATH","type":"codeVoice"},{"type":"text","text":" variable from"},{"type":"text","text":" "},{"code":"envp","type":"codeVoice"},{"type":"text","text":". If both "},{"type":"codeVoice","code":"searchPath"},{"text":" and ","type":"text"},{"code":"searchPathFromEnvp","type":"codeVoice"},{"text":" ","type":"text"},{"text":"are used, the value from ","type":"text"},{"code":"envp","type":"codeVoice"},{"type":"text","text":" takes precedence over the environment."}],"type":"paragraph"},{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"childInheritsStdin"},{"text":" means that the child will inherit the parent’s","type":"text"},{"type":"text","text":" "},{"text":"standard input (by default, the child’s standard input is attached to","type":"text"},{"type":"text","text":" "},{"code":"\/dev\/null","type":"codeVoice"},{"text":"). ","type":"text"},{"code":"stdinFromDevNull","type":"codeVoice"},{"text":" explicitly imposes the default","type":"text"},{"text":" ","type":"text"},{"text":"behavior. Both flags cannot be enabled at the same time and, in both cases,","type":"text"},{"text":" ","type":"text"},{"text":"the ","type":"text"},{"type":"codeVoice","code":"stdinPipeOut"},{"text":" argument is ignored.","type":"text"}]},{"type":"paragraph","inlineContent":[{"code":"stdoutToDevNull","type":"codeVoice"},{"text":" means that the child’s standard output","type":"text"},{"type":"text","text":" "},{"type":"text","text":"will be discarded (by default, it goes to the same location as the parent’s"},{"type":"text","text":" "},{"text":"standard output). ","type":"text"},{"type":"codeVoice","code":"childInheritsStdout"},{"text":" explicitly imposes the","type":"text"},{"type":"text","text":" "},{"type":"text","text":"default behavior. Both flags cannot be enabled at the same time and, in"},{"text":" ","type":"text"},{"type":"text","text":"both cases, the "},{"code":"stdoutPipeOut","type":"codeVoice"},{"type":"text","text":" argument is ignored."}]},{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"stderrToDevNull"},{"type":"text","text":" means that the child’s standard error"},{"text":" ","type":"text"},{"type":"text","text":"will be discarded (by default, it goes to the same location as the parent’s"},{"type":"text","text":" "},{"text":"standard error). ","type":"text"},{"code":"childInheritsStderr","type":"codeVoice"},{"type":"text","text":" explicitly imposes the"},{"type":"text","text":" "},{"text":"default behavior. Both flags cannot be enabled at the same time and, in","type":"text"},{"type":"text","text":" "},{"type":"text","text":"both cases, the "},{"type":"codeVoice","code":"stderrPipeOut"},{"type":"text","text":" argument is ignored."}]},{"inlineContent":[{"type":"text","text":"It is valid to pass the same FD in multiple parameters (e.g. you can pass"},{"type":"text","text":" "},{"type":"text","text":"a single FD for both "},{"type":"codeVoice","code":"stdoutFd"},{"type":"text","text":" and "},{"code":"stderrFd","type":"codeVoice"},{"text":", and include it in","type":"text"},{"text":" ","type":"text"},{"type":"codeVoice","code":"sourceFds"},{"type":"text","text":" too)."}],"type":"paragraph"},{"type":"paragraph","inlineContent":[{"code":"sourceFds","type":"codeVoice"},{"text":" and ","type":"text"},{"code":"targetFds","type":"codeVoice"},{"text":" allow zero or more FDs from this process to be","type":"text"},{"text":" ","type":"text"},{"type":"text","text":"remapped to different FDs in the spawned process. If "},{"type":"codeVoice","code":"nFds"},{"type":"text","text":" is greater than"},{"type":"text","text":" "},{"type":"text","text":"zero, "},{"type":"codeVoice","code":"sourceFds"},{"type":"text","text":" and "},{"code":"targetFds","type":"codeVoice"},{"type":"text","text":" must both be non-"},{"type":"codeVoice","code":"nil"},{"text":" and the same length.","type":"text"},{"text":" ","type":"text"},{"type":"text","text":"Each FD in "},{"type":"codeVoice","code":"sourceFds"},{"type":"text","text":" is remapped to the FD number at the same index in"},{"text":" ","type":"text"},{"type":"codeVoice","code":"targetFds"},{"text":". The source and target FD may be equal to simply propagate an FD","type":"text"},{"text":" ","type":"text"},{"text":"to the spawned process. FD remappings are processed after standard FDs, so","type":"text"},{"text":" ","type":"text"},{"text":"any target FDs which equal ","type":"text"},{"type":"codeVoice","code":"stdinFd"},{"type":"text","text":", "},{"type":"codeVoice","code":"stdoutFd"},{"type":"text","text":" or "},{"code":"stderrFd","type":"codeVoice"},{"text":" will overwrite","type":"text"},{"text":" ","type":"text"},{"type":"text","text":"them in the spawned process."}]},{"inlineContent":[{"type":"codeVoice","code":"sourceFds"},{"type":"text","text":" is supported on Windows since 2.72."}],"type":"paragraph"},{"inlineContent":[{"type":"codeVoice","code":"fileAndArgvZero"},{"type":"text","text":" means that the first element of "},{"code":"argv","type":"codeVoice"},{"text":" is","type":"text"},{"text":" ","type":"text"},{"type":"text","text":"the file to execute, while the remaining elements are the actual"},{"type":"text","text":" "},{"type":"text","text":"argument vector to pass to the file. Normally "},{"code":"g_spawn_async_with_pipes()","type":"codeVoice"},{"text":" ","type":"text"},{"type":"text","text":"uses "},{"code":"argv","type":"codeVoice"},{"type":"text","text":"[0] as the file to execute, and passes all of "},{"type":"codeVoice","code":"argv"},{"type":"text","text":" to the child."}],"type":"paragraph"},{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"childSetup"},{"type":"text","text":" and "},{"type":"codeVoice","code":"userData"},{"text":" are a function and user data. On POSIX","type":"text"},{"type":"text","text":" "},{"type":"text","text":"platforms, the function is called in the child after GLib has"},{"text":" ","type":"text"},{"type":"text","text":"performed all the setup it plans to perform (including creating"},{"type":"text","text":" "},{"type":"text","text":"pipes, closing file descriptors, etc.) but before calling "},{"code":"exec()","type":"codeVoice"},{"text":".","type":"text"},{"type":"text","text":" "},{"text":"That is, ","type":"text"},{"type":"codeVoice","code":"childSetup"},{"text":" is called just before calling ","type":"text"},{"code":"exec()","type":"codeVoice"},{"type":"text","text":" in the"},{"type":"text","text":" "},{"text":"child. Obviously actions taken in this function will only affect","type":"text"},{"text":" ","type":"text"},{"type":"text","text":"the child, not the parent."}]},{"type":"paragraph","inlineContent":[{"text":"On Windows, there is no separate ","type":"text"},{"type":"codeVoice","code":"fork()"},{"text":" and ","type":"text"},{"type":"codeVoice","code":"exec()"},{"text":" functionality.","type":"text"},{"type":"text","text":" "},{"text":"Child processes are created and run with a single API call,","type":"text"},{"text":" ","type":"text"},{"type":"codeVoice","code":"CreateProcess()"},{"type":"text","text":". There is no sensible thing "},{"type":"codeVoice","code":"childSetup"},{"type":"text","text":" "},{"type":"text","text":"could be used for on Windows so it is ignored and not called."}]},{"inlineContent":[{"type":"text","text":"If non-"},{"code":"nil","type":"codeVoice"},{"type":"text","text":", "},{"code":"child_pid","type":"codeVoice"},{"type":"text","text":" will on Unix be filled with the child’s"},{"text":" ","type":"text"},{"text":"process ID. You can use the process ID to send signals to the child,","type":"text"},{"type":"text","text":" "},{"type":"text","text":"or to use "},{"type":"codeVoice","code":"g_child_watch_add()"},{"type":"text","text":" (or "},{"type":"codeVoice","code":"waitpid()"},{"type":"text","text":") if you specified the"},{"type":"text","text":" "},{"type":"codeVoice","code":"doNotReapChild"},{"text":" flag. On Windows, ","type":"text"},{"type":"codeVoice","code":"child_pid"},{"type":"text","text":" will be"},{"type":"text","text":" "},{"text":"filled with a handle to the child process only if you specified the","type":"text"},{"text":" ","type":"text"},{"type":"codeVoice","code":"doNotReapChild"},{"type":"text","text":" flag. You can then access the child"},{"type":"text","text":" "},{"type":"text","text":"process using the Win32 API, for example wait for its termination"},{"text":" ","type":"text"},{"type":"text","text":"with the "},{"type":"codeVoice","code":"WaitFor*()"},{"type":"text","text":" functions, or examine its exit code with"},{"type":"text","text":" "},{"code":"GetExitCodeProcess()","type":"codeVoice"},{"type":"text","text":". You should close the handle with "},{"type":"codeVoice","code":"CloseHandle()"},{"text":" ","type":"text"},{"type":"text","text":"or "},{"type":"codeVoice","code":"g_spawn_close_pid()"},{"text":" when you no longer need it.","type":"text"}],"type":"paragraph"},{"type":"paragraph","inlineContent":[{"text":"If non-","type":"text"},{"code":"nil","type":"codeVoice"},{"type":"text","text":", the "},{"code":"stdinPipeOut","type":"codeVoice"},{"type":"text","text":", "},{"type":"codeVoice","code":"stdoutPipeOut"},{"type":"text","text":", "},{"code":"stderrPipeOut","type":"codeVoice"},{"text":" ","type":"text"},{"text":"locations will be filled with file descriptors for writing to the child’s","type":"text"},{"text":" ","type":"text"},{"text":"standard input or reading from its standard output or standard error.","type":"text"},{"text":" ","type":"text"},{"text":"The caller of ","type":"text"},{"type":"codeVoice","code":"g_spawn_async_with_pipes()"},{"text":" must close these file descriptors","type":"text"},{"text":" ","type":"text"},{"type":"text","text":"when they are no longer in use. If these parameters are "},{"type":"codeVoice","code":"nil"},{"text":", the","type":"text"},{"type":"text","text":" "},{"type":"text","text":"corresponding pipe won’t be created."}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"If "},{"code":"stdinPipeOut","type":"codeVoice"},{"type":"text","text":" is "},{"type":"codeVoice","code":"nil"},{"type":"text","text":", the child’s standard input is attached to"},{"type":"text","text":" "},{"type":"codeVoice","code":"\/dev\/null"},{"type":"text","text":" unless "},{"type":"codeVoice","code":"childInheritsStdin"},{"type":"text","text":" is set."}]},{"type":"paragraph","inlineContent":[{"text":"If ","type":"text"},{"code":"stderrPipeOut","type":"codeVoice"},{"text":" is NULL, the child’s standard error goes to the same","type":"text"},{"type":"text","text":" "},{"type":"text","text":"location as the parent’s standard error unless "},{"type":"codeVoice","code":"stderrToDevNull"},{"text":" ","type":"text"},{"type":"text","text":"is set."}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"If "},{"type":"codeVoice","code":"stdoutPipeOut"},{"type":"text","text":" is NULL, the child’s standard output goes to the same"},{"type":"text","text":" "},{"type":"text","text":"location as the parent’s standard output unless "},{"type":"codeVoice","code":"stdoutToDevNull"},{"type":"text","text":" "},{"type":"text","text":"is set."}]},{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"error"},{"type":"text","text":" can be "},{"code":"nil","type":"codeVoice"},{"type":"text","text":" to ignore errors, or non-"},{"code":"nil","type":"codeVoice"},{"type":"text","text":" to report errors."},{"text":" ","type":"text"},{"type":"text","text":"If an error is set, the function returns "},{"type":"codeVoice","code":"false"},{"text":". Errors are reported","type":"text"},{"text":" ","type":"text"},{"type":"text","text":"even if they occur in the child (for example if the executable in"},{"type":"text","text":" "},{"type":"text","text":"``argv"},{"code":"[0]","type":"codeVoice"},{"text":" is not found). Typically the `message` field of returned","type":"text"},{"type":"text","text":" "},{"type":"text","text":"errors should be displayed to users. Possible errors are those from"},{"type":"text","text":" "},{"text":"the `G_SPAWN_ERROR` domain.","type":"text"}]},{"type":"paragraph","inlineContent":[{"text":"If an error occurs, ","type":"text"},{"code":"child_pid","type":"codeVoice"},{"text":", ","type":"text"},{"type":"codeVoice","code":"stdinPipeOut"},{"type":"text","text":", "},{"code":"stdoutPipeOut","type":"codeVoice"},{"text":",","type":"text"},{"type":"text","text":" "},{"text":"and ","type":"text"},{"type":"codeVoice","code":"stderrPipeOut"},{"text":" will not be filled with valid values.","type":"text"}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"If "},{"type":"codeVoice","code":"child_pid"},{"text":" is not ","type":"text"},{"code":"nil","type":"codeVoice"},{"text":" and an error does not occur then the returned","type":"text"},{"type":"text","text":" "},{"text":"process reference must be closed using ","type":"text"},{"type":"codeVoice","code":"g_spawn_close_pid()"},{"type":"text","text":"."}]},{"type":"paragraph","inlineContent":[{"text":"On modern UNIX platforms, GLib can use an efficient process launching","type":"text"},{"type":"text","text":" "},{"type":"text","text":"codepath driven internally by "},{"code":"posix_spawn()","type":"codeVoice"},{"type":"text","text":". This has the advantage of"},{"type":"text","text":" "},{"text":"avoiding the fork-time performance costs of cloning the parent process","type":"text"},{"type":"text","text":" "},{"text":"address space, and avoiding associated memory overcommit checks that are","type":"text"},{"text":" ","type":"text"},{"type":"text","text":"not relevant in the context of immediately executing a distinct process."},{"type":"text","text":" "},{"type":"text","text":"This optimized codepath will be used provided that the following conditions"},{"text":" ","type":"text"},{"type":"text","text":"are met:"}]},{"type":"orderedList","items":[{"content":[{"inlineContent":[{"type":"codeVoice","code":"doNotReapChild"},{"type":"text","text":" is set"}],"type":"paragraph"}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"leaveDescriptorsOpen"},{"type":"text","text":" is set"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"code":"searchPathFromEnvp","type":"codeVoice"},{"type":"text","text":" is not set"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"code":"workingDirectory","type":"codeVoice"},{"text":" is ","type":"text"},{"type":"codeVoice","code":"nil"}]}]},{"content":[{"inlineContent":[{"code":"childSetup","type":"codeVoice"},{"type":"text","text":" is "},{"type":"codeVoice","code":"nil"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"type":"text","text":"The program is of a recognised binary format, or has a shebang."},{"text":" ","type":"text"},{"type":"text","text":"Otherwise, GLib will have to execute the program through the"},{"text":" ","type":"text"},{"text":"shell, which is not done using the optimized codepath.","type":"text"}],"type":"paragraph"}]}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"If you are writing a GTK application, and the program you are spawning is a"},{"text":" ","type":"text"},{"type":"text","text":"graphical application too, then to ensure that the spawned program opens its"},{"text":" ","type":"text"},{"type":"text","text":"windows on the right screen, you may want to use "},{"type":"codeVoice","code":"GdkAppLaunchContext"},{"type":"text","text":","},{"type":"text","text":" "},{"type":"codeVoice","code":"GAppLaunchContext"},{"type":"text","text":", or set the "},{"code":"DISPLAY","type":"codeVoice"},{"type":"text","text":" environment variable."}]}],"kind":"content"}],"variants":[{"paths":["\/documentation\/glib\/spawnasyncwithpipesandfds(workingdirectory:argv:envp:flags:childsetup:userdata:stdinfd:stdoutfd:stderrfd:sourcefds:targetfds:nfds:childpidout:stdinpipeout:stdoutpipeout:stderrpipeout:)"],"traits":[{"interfaceLanguage":"swift"}]}],"schemaVersion":{"patch":0,"minor":3,"major":0},"hierarchy":{"paths":[["doc:\/\/GLib\/documentation\/GLib"]]},"kind":"symbol","abstract":[{"text":"Executes a child program asynchronously (your program will not","type":"text"},{"type":"text","text":" "},{"text":"block waiting for the child to exit).","type":"text"}],"sections":[],"metadata":{"fragments":[{"text":"func","kind":"keyword"},{"text":" ","kind":"text"},{"text":"spawnAsyncWithPipesAndFds","kind":"identifier"},{"kind":"text","text":"("},{"text":"workingDirectory","kind":"externalParam"},{"kind":"text","text":": "},{"text":"UnsafePointer","preciseIdentifier":"s:SP","kind":"typeIdentifier"},{"text":"<","kind":"text"},{"kind":"typeIdentifier","preciseIdentifier":"c:@T@gchar","text":"gchar"},{"text":">?, ","kind":"text"},{"text":"argv","kind":"extern