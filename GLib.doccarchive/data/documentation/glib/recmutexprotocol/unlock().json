he "},{"isActive":true,"type":"reference","identifier":"doc:\/\/GLib\/documentation\/GLib\/Mutex"},{"type":"text","text":" struct is an opaque data structure to represent a mutex"},{"type":"text","text":" "},{"text":"(mutual exclusion). It can be used to protect data against shared","type":"text"},{"type":"text","text":" "},{"type":"text","text":"access."}],"fragments":[{"text":"class","kind":"keyword"},{"kind":"text","text":" "},{"text":"Mutex","kind":"identifier"}],"navigatorTitle":[{"text":"Mutex","kind":"identifier"}],"kind":"symbol","type":"topic","role":"symbol","title":"Mutex","identifier":"doc:\/\/GLib\/documentation\/GLib\/Mutex","url":"\/documentation\/glib\/mutex"},"doc://GLib/documentation/GLib/RecMutexProtocol/unlock()":{"title":"unlock()","url":"\/documentation\/glib\/recmutexprotocol\/unlock()","type":"topic","fragments":[{"kind":"keyword","text":"func"},{"text":" ","kind":"text"},{"text":"unlock","kind":"identifier"},{"text":"()","kind":"text"}],"kind":"symbol","role":"symbol","identifier":"doc:\/\/GLib\/documentation\/GLib\/RecMutexProtocol\/unlock()","abstract":[{"text":"Unlocks ","type":"text"},{"type":"codeVoice","code":"recMutex"},{"type":"text","text":". If another thread is blocked in a"},{"text":" ","type":"text"},{"type":"codeVoice","code":"g_rec_mutex_lock()"},{"type":"text","text":" call for "},{"type":"codeVoice","code":"recMutex"},{"text":", it will become unblocked","type":"text"},{"text":" ","type":"text"},{"text":"and can lock ","type":"text"},{"code":"recMutex","type":"codeVoice"},{"type":"text","text":" itself."}]},"doc://GLib/documentation/GLib/RecMutexProtocol":{"fragments":[{"kind":"keyword","text":"protocol"},{"kind":"text","text":" "},{"text":"RecMutexProtocol","kind":"identifier"}],"navigatorTitle":[{"text":"RecMutexProtocol","kind":"identifier"}],"role":"symbol","abstract":[{"type":"text","text":"The GRecMutex struct is an opaque data structure to represent a"},{"text":" ","type":"text"},{"type":"text","text":"recursive mutex. It is similar to a "},{"type":"reference","isActive":true,"identifier":"doc:\/\/GLib\/documentation\/GLib\/Mutex"},{"type":"text","text":" with the difference"},{"type":"text","text":" "},{"text":"that it is possible to lock a GRecMutex multiple times in the same","type":"text"},{"type":"text","text":" "},{"text":"thread without deadlock. When doing so, care has to be taken to","type":"text"},{"type":"text","text":" "},{"text":"unlock the recursive mutex as often as it has been locked.","type":"text"}],"type":"topic","url":"\/documentation\/glib\/recmutexprotocol","identifier":"doc:\/\/GLib\/documentation\/GLib\/RecMutexProtocol","kind":"symbol","title":"RecMutexProtocol"},"doc://GLib/documentation/GLib":{"identifier":"doc:\/\/GLib\/documentation\/GLib","title":"GLib","abstract":[],"type":"topic","url":"\/documentation\/glib","kind":"symbol","role":"collection"}}}