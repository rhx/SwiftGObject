"heading","anchor":"discussion","level":2},{"type":"paragraph","inlineContent":[{"text":"The sort function ","type":"text"},{"type":"codeVoice","code":"func"},{"type":"text","text":" is passed two elements of the "},{"code":"queue","type":"codeVoice"},{"type":"text","text":"."},{"text":" ","type":"text"},{"type":"text","text":"It should return 0 if they are equal, a negative value if the"},{"type":"text","text":" "},{"type":"text","text":"first element should be higher in the "},{"code":"queue","type":"codeVoice"},{"type":"text","text":" or a positive value"},{"type":"text","text":" "},{"text":"if the first element should be lower in the ","type":"text"},{"code":"queue","type":"codeVoice"},{"type":"text","text":" than the second"},{"type":"text","text":" "},{"type":"text","text":"element."}]},{"type":"paragraph","inlineContent":[{"text":"This function will lock ","type":"text"},{"type":"codeVoice","code":"queue"},{"text":" before it sorts the queue and unlock","type":"text"},{"type":"text","text":" "},{"type":"text","text":"it when it is finished."}]},{"inlineContent":[{"type":"text","text":"If you were sorting a list of priority numbers to make sure the"},{"type":"text","text":" "},{"type":"text","text":"lowest priority would be at the top of the queue, you could use:"},{"text":" ","type":"text"},{"text":"(C Language Example):","type":"text"}],"type":"paragraph"},{"code":[" gint32 id1;"," gint32 id2;",""," id1 = GPOINTER_TO_INT (element1);"," id2 = GPOINTER_TO_INT (element2);",""," return (id1 > id2 ? +1 : id1 == id2 ? 0 : -1);"],"syntax":"C","type":"codeListing"}],"kind":"content"}],"abstract":[{"text":"Sorts ","type":"text"},{"type":"codeVoice","code":"queue"},{"type":"text","text":" using "},{"type":"codeVoice","code":"func"},{"text":".","type":"text"}],"references":{"doc://GLib/documentation/GLib/AsyncQueueRef/AsyncQueueProtocol-Implementations":{"abstract":[],"identifier":"doc:\/\/GLib\/documentation\/GLib\/AsyncQueueRef\/AsyncQueueProtocol-Implementations","k