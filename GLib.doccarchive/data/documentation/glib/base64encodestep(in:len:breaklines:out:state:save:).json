g":"Function"},"identifier":{"url":"doc:\/\/GLib\/documentation\/GLib\/base64EncodeStep(in:len:breakLines:out:state:save:)","interfaceLanguage":"swift"},"primaryContentSections":[{"kind":"declarations","declarations":[{"platforms":["macOS"],"tokens":[{"text":"func","kind":"keyword"},{"text":" ","kind":"text"},{"kind":"identifier","text":"base64EncodeStep"},{"text":"(","kind":"text"},{"kind":"externalParam","text":"in"},{"kind":"text","text":": "},{"kind":"typeIdentifier","preciseIdentifier":"s:SP","text":"UnsafePointer"},{"kind":"text","text":"<"},{"preciseIdentifier":"c:@T@guchar","text":"guchar","kind":"typeIdentifier"},{"kind":"text","text":">!, "},{"text":"len","kind":"externalParam"},{"kind":"text","text":": "},{"text":"Int","kind":"typeIdentifier","preciseIdentifier":"s:Si"},{"kind":"text","text":", "},{"kind":"externalParam","text":"breakLines"},{"kind":"text","text":": "},{"text":"Bool","kind":"typeIdentifier","preciseIdentifier":"s:Sb"},{"kind":"text","text":", "},{"text":"out","kind":"externalParam"},{"text":": ","kind":"text"},{"preciseIdentifier":"s:Sp","kind":"typeIdentifier","text":"UnsafeMutablePointer"},{"kind":"text","text":"<"},{"kind":"typeIdentifier","preciseIdentifier":"c:@T@gchar","text":"gchar"},{"text":">!, ","kind":"text"},{"kind":"externalParam","text":"state"},{"kind":"text","text":": "},{"kind":"typeIdentifier","text":"UnsafeMutablePointer","preciseIdentifier":"s:Sp"},{"text":"<","kind":"text"},{"preciseIdentifier":"c:@T@gint","text":"gint","kind":"typeIdentifier"},{"kind":"text","text":">!, "},{"text":"save","kind":"externalParam"},{"kind":"text","text":": "},{"text":"UnsafeMutablePointer","kind":"typeIdentifier","preciseIdentifier":"s:Sp"},{"kind":"text","text":"<"},{"preciseIdentifier":"c:@T@gint","text":"gint","kind":"typeIdentifier"},{"text":">!) -> ","kind":"text"},{"kind":"typeIdentifier","preciseIdentifier":"s:Si","text":"Int"}],"languages":["swift"]}]},{"kind":"content","content":[{"anchor":"discussion","type":"heading","text":"Discussion","level":2},{"type":"paragraph","inlineContent":[{"text":"When all of the data has been converted you must call","type":"text"},{"type":"text","text":" "},{"code":"g_base64_encode_close()","type":"codeVoice"},{"type":"text","text":" to flush the saved state."}]},{"inlineContent":[{"text":"The output buffer must be large enough to fit all the data that will","type":"text"},{"type":"text","text":" "},{"text":"be written to it. Due to the way base64 encodes you will need","type":"text"},{"type":"text","text":" "},{"type":"text","text":"at least: ("},{"type":"codeVoice","code":"len"},{"text":" \/ 3 + 1) * 4 + 4 bytes (+ 4 may be needed in case of","type":"text"},{"type":"text","text":" "},{"type":"text","text":"non-zero state). If you enable line-breaking you will need at least:"},{"text":" ","type":"text"},{"text":"((","type":"text"},{"code":"len","type":"codeVoice"},{"text":" \/ 3 + 1) * 4 + 4) \/ 76 + 1 bytes of extra space.","type":"text"}],"type":"paragraph"},{"inlineContent":[{"type":"codeVoice","code":"breakLines"},{"type":"text","text":" is typically used when putting base64-encoded data in emails."},{"type":"text","text":" "},{"text":"It breaks the lines at 76 columns instead of putting all of the text on","type":"text"},{"type":"text","text":" "},{"text":"the same line. This avoids problems with long lines in the email system.","type":"text"},{"text":" ","type":"text"},{"type":"text","text":"Note however that it breaks the lines with "},{"type":"codeVoice","code":"LF"},{"type":"text","text":" characters, not"},{"type":"text","text":" "},{"type":"codeVoice","code":"CR LF"},{"type":"text","text":" sequences, so the result cannot be passed directly to SMTP"},{"type":"text","text":" "},{"type":"text","text":"or certain other protocols."}],"type":"paragraph"}]}],"sections":[],"abstract":[{"type":"text","text":"Incrementally encode a sequence of binary data into its Base-64 stringified"},{"type":"text","text":" "},{"text":"representation. By calling this function multiple times you can convert","type":"text"},{"type":"text","text":" "},{"text":"data in chunks to avoid having to have the full encoded data in memory.","type":"text"}],"variants":[{"paths":["\/documentation\/glib\/base64encodestep(in:len:breaklines:out:state:save:)"],"traits":[{"interfaceLanguage":"swift"}]}],"hierarchy":{"paths":[["doc:\/\/GLib\/documentation\/GLib"]]},"references":{"doc://GLib/documentation/GLib":{"identifier":"doc:\/\/GLib\/documentation\/GLib","title":"GLib","abstract":[],"type":"topic","url":"\/documentation\/glib","kind":"symbol","role":"collection"},"doc://GLib/documentation/GLib/base64EncodeStep(in:len:breakLines:out:state:save:)":{"abstract":[{"type":"text","text":"Incrementally encode a sequence of binary data into its Base-64 stringified"},{"text":" ","type":"text"},{"type":"text","text":"representation. By calling this function multiple times you can convert"},{"type":"text","text":" "},{"type":"text","text":"data in chunks to avoid having to have the full encoded data in memory."}],"identifier":"doc:\/\/GLib\/documentation\/GLib\/base64EncodeStep(in:len:breakLines:out:state:save:)","kind":"symbol","type":"topic","url":"\/documentation\/glib\/base64encodestep(in:len:breaklines:out:state:save:)","title":"base64EncodeStep(in:len:breakLines:out:state:save:)","role":"symbol","fragments":[{"kind":"keyword","text":"func"},{"text":" ","kind":"text"},{"text":"base64EncodeStep","kind":"identifier"},{"text":"(","kind":"text"},{"kind":"externalParam","text":"in"},{"kind":"text","text":": "},{"text":"UnsafePointer","preciseIdentifier":"s:SP","kind":"typeIdentifier"},{"kind":"text","text":"<"},{"text":"guchar","kind":"typeIdentifier","preciseIdentifier":"c:@T@guchar"},{"text":">!, ","kind":"text"},{"kind":"externalParam","text":"len"},{"text":": ","kind":"text"},{"preciseIdentifier":"s:Si","kind":"typeIdentifier","text":"Int"},{"text":", ","kind":"text"},{"text":"breakLines","kind":"externalParam"},{"kind":"text","text":": "},{"text":"Boo