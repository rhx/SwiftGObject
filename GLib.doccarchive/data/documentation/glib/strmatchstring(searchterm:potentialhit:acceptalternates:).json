pically be","type":"text"},{"text":" ","type":"text"},{"type":"text","text":"faster to call "},{"type":"codeVoice","code":"g_str_tokenize_and_fold()"},{"text":" on each string in","type":"text"},{"text":" ","type":"text"},{"type":"text","text":"your corpus and build an index on the returned folded tokens, then"},{"text":" ","type":"text"},{"text":"call ","type":"text"},{"code":"g_str_tokenize_and_fold()","type":"codeVoice"},{"text":" on the search term and","type":"text"},{"text":" ","type":"text"},{"type":"text","text":"perform lookups into that index."}]},{"inlineContent":[{"text":"As some examples, searching for ‘fred’ would match the potential hit","type":"text"},{"text":" ","type":"text"},{"text":"‘Smith, Fred’ and also ‘Frédéric’.  Searching for ‘Fréd’ would match","type":"text"},{"type":"text","text":" "},{"type":"text","text":"‘Frédéric’ but not ‘Frederic’ (due to the one-directional nature of"},{"type":"text","text":" "},{"type":"text","text":"accent matching).  Searching ‘fo’ would match ‘Foo’ and ‘Bar Foo"},{"text":" ","type":"text"},{"type":"text","text":"Baz’, but not ‘SFO’ (because no word has ‘fo’ as a prefix)."}],"type":"paragraph"}]}],"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/glib\/strmatchstring(searchterm:potentialhit:acceptalternates:)"]}],"schemaVersion":{"patch":0,"major":0,"minor":3},"hierarchy":{"paths":[["doc:\/\/GLib\/documentation\/GLib"]]},"references":{"doc://GLib/documentation/GLib/strMatchString(searchTerm:potentialHit:acceptAlternates:)":{"url":"\/documentation\/glib\/strmatchstring(searchterm:potentialhit:acceptalternates:)","type":"topic","abstract":[{"text":"Checks if a search conducted for ","type":"text"},{"type":"codeVoice","code":"searchTerm"},{"type":"text","text":" should match"},{"type":"text","text":" "},{"type":"codeVoice","code":"potentialHit"},{"type":"text","text":"."}],"title":"strMatchString(searchTerm:potentialHit:acceptAlternates:)","role":"symbol","identifier":"doc:\/\/GLib\/d