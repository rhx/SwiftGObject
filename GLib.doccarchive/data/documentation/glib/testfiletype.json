{"kind":"symbol","hierarchy":{"paths":[["doc:\/\/GLib\/documentation\/GLib"]]},"sections":[],"metadata":{"modules":[{"name":"GLib"}],"externalID":"s:4GLib12TestFileTypea","title":"TestFileType","symbolKind":"typealias","fragments":[{"text":"typealias","kind":"keyword"},{"kind":"text","text":" "},{"text":"TestFileType","kind":"identifier"}],"roleHeading":"Type Alias","navigatorTitle":[{"text":"TestFileType","kind":"identifier"}],"role":"symbol"},"primaryContentSections":[{"kind":"declarations","declarations":[{"platforms":["macOS"],"languages":["swift"],"tokens":[{"text":"typealias","kind":"keyword"},{"kind":"text","text":" "},{"text":"TestFileType","kind":"identifier"},{"text":" = ","kind":"text"},{"text":"GTestFileType","kind":"typeIdentifier","preciseIdentifier":"c:@EA@GTestFileType"}]}]},{"content":[{"anchor":"discussion","text":"Discussion","type":"heading","level":2},{"type":"paragraph","inlineContent":[{"type":"text","text":"These two options correspond rather directly to the ‘dist’ and"},{"type":"text","text":" "},{"type":"text","text":"‘built’ terminology that automake uses and are explicitly used to"},{"text":" ","type":"text"},{"type":"text","text":"distinguish between the ‘srcdir’ and ‘builddir’ being separate. All"},{"text":" ","type":"text"},{"text":"files in your project should either be dist (in the ","type":"text"},{"code":"EXTRA_DIST","type":"codeVoice"},{"type":"text","text":" or"},{"text":" ","type":"text"},{"type":"codeVoice","code":"dist_schema_DATA"},{"type":"text","text":" sense, in which case they will always be in the"},{"type":"text","text":" "},{"text":"srcdir) or built (in the ","type":"text"},{"type":"codeVoice","code":"BUILT_SOURCES"},{"type":"text","text":" sense, in which case they"},{"text":" ","type":"text"},{"text":"will always be in the builddir).","type":"text"}]},{"inlineContent":[{"type":"text","text":"Note: As a general rule of automake, files that are generated only as"},{"text":" ","type":"text"},{"text":"part of the build-from-git process (but then are distributed with the","type":"text"},{"text":" ","type":"text"},{"type":"text","text":"tarball) always go in srcdir (even if doing a srcdir != builddir"},{"type":"text","text":" "},{"type":"text","text":"build from git) and are considered as distributed files."}],"type":"paragraph"},{"type":"paragraph","inlineContent":[{"type":"text","text":"The same principles apply for other build systems, such as meson."}]}],"kind":"content"}],"schemaVersion":{"major":0,"minor":3,"patch":0},"abstract":[{"text":"The type of file to return the filename for, when used with","type":"text"},{"text":" ","type":"text"},{"type":"text","text":"[func"},{"code":"GLib.test_build_filename","type":"codeVoice"},{"text":"].","type":"text"}],"identifier":{"interfaceLanguage":"swift","url":"doc:\/\/GLib\/documentation\/GLib\/TestFileType"},"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/glib\/testfiletype"]}],"references":{"doc://GLib/documentation/GLib":{"identifier":"doc:\/\/GLib\/documentation\/GLib","title":"GLib","abstract":[],"type":"topic","url":"\/documentation\/glib","kind":"symbol","role":"collection"},"doc://GLib/documentation/GLib/TestFileType":{"role":"symbol","navigatorTitle":[{"text":"TestFileType","kind":"identifier"}],"abstract":[{"type":"text","text":"The type of file to return the filename for, when used with"},{"text":" ","type":"text"},{"type":"text","text":"[func"},{"type":"codeVoice","code":"GLib.test_build_filename"},{"text":"].","type":"text"}],"identifier":"doc:\/\/GLib\/documentation\/GLib\/TestFileType","fragments":[{"text":"typealias","kind":"keyword"},{"kind":"text","text":" "},{"text":"TestFileType","kind":"identifier"}],"kind":"symbol","url":"\/documentation\/glib\/testfiletype","type":"topic","title":"TestFileType"}}}