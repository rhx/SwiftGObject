e quoted text, you have to do something","type":"text"},{"type":"text","text":" "},{"type":"text","text":"like "},{"code":"'foo'\\''bar'","type":"codeVoice"},{"text":". Double quotes allow ","type":"text"},{"type":"codeVoice","code":"$"},{"type":"text","text":", ```, "},{"type":"codeVoice","code":"\""},{"type":"text","text":", ``, and"},{"type":"text","text":" "},{"type":"text","text":"newline to be escaped with backslash. Otherwise double quotes"},{"text":" ","type":"text"},{"type":"text","text":"preserve things literally."}]}]}],"identifier":{"interfaceLanguage":"swift","url":"doc:\/\/GLib\/documentation\/GLib\/shellUnquote(quotedString:)"},"sections":[],"variants":[{"paths":["\/documentation\/glib\/shellunquote(quotedstring:)"],"traits":[{"interfaceLanguage":"swift"}]}],"kind":"symbol","abstract":[{"text":"Unquotes a string as the shell (\/bin\/sh) would.","type":"text"}],"references":{"doc://GLib/documentation/GLib/shellUnquote(quotedString:)":{"title":"shellUnquote(quotedString:)","role":"symbol","kind":"symbol","identifier":"doc:\/\/GLib\/documentation\/GLib\/shellUnquote(quotedString:)","url":"\/documentation\/glib\/shellunquote(quotedstring:)","fragments":[{"kind":"keyword","text":"func"},{"text":" ","kind":"text"},{"text":"shellUnquote","kind":"identifier"},{"kind":"text","text":"("},{"text":"quotedString","kind":"externalParam"},{"kind":"text","text":": "},{"kind":"typeIdentifier","preciseIdentifier":"s:SP","text":"UnsafePointer"},{"kind":"text","text":"<"},{"kind":"typeIdentifier","text":"gchar","preciseIdentifier":"c:@T@gchar"},{"text":">!) ","kind":"text"},{"text":"throws","kind":"keyword"},{"text":" -> ","kind":"text"},{"kind":"typeIdentifier","text":"String","preciseIdentifier":"s:SS"},{"kind":"text","text":"!"}],"type":"topic","abstract":[{"type":"text","text":"Unquotes a string as the shell (\/bin\/sh) would."}]},"doc://GLib/documentation/GLib":{"identifier":"doc:\/\/GLib\/documentation\/GLib","title":"GLib","abstract":[],"type":"topic","url":"\/doc