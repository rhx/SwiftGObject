{"hierarchy":{"paths":[["doc:\/\/GLib\/documentation\/GLib","doc:\/\/GLib\/documentation\/GLib\/MatchInfoRef","doc:\/\/GLib\/documentation\/GLib\/MatchInfoRef\/MatchInfoProtocol-Implementations"]]},"kind":"symbol","variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/glib\/matchinforef\/fetchall()"]}],"sections":[],"schemaVersion":{"minor":3,"major":0,"patch":0},"abstract":[{"type":"text","text":"Bundles up pointers to each of the matching substrings from a match"},{"text":" ","type":"text"},{"text":"and stores them in an array of gchar pointers. The first element in","type":"text"},{"type":"text","text":" "},{"text":"the returned array is the match number 0, i.e. the entire matched","type":"text"},{"text":" ","type":"text"},{"type":"text","text":"text."}],"primaryContentSections":[{"kind":"declarations","declarations":[{"languages":["swift"],"tokens":[{"kind":"keyword","text":"func"},{"kind":"text","text":" "},{"kind":"identifier","text":"fetchAll"},{"text":"() -> ","kind":"text"},{"preciseIdentifier":"s:Sp","text":"UnsafeMutablePointer","kind":"typeIdentifier"},{"kind":"text","text":"<"},{"text":"UnsafeMutablePointer","kind":"typeIdentifier","preciseIdentifier":"s:Sp"},{"kind":"text","text":"<"},{"kind":"typeIdentifier","preciseIdentifier":"c:@T@gchar","text":"gchar"},{"text":">?>!","kind":"text"}],"platforms":["macOS"]}]},{"content":[{"anchor":"discussion","text":"Discussion","type":"heading","level":2},{"inlineContent":[{"text":"If a sub pattern didn’t match anything (e.g. sub pattern 1, matching","type":"text"},{"type":"text","text":" "},{"text":"“b” against “(a)?b”) then an empty string is inserted.","type":"text"}],"type":"paragraph"},{"type":"paragraph","inlineContent":[{"text":"If the last match was obtained using the DFA algorithm, that is using","type":"text"},{"text":" ","type":"text"},{"code":"g_regex_match_all()","type":"codeVoice"},{"text":" or ","type":"text"},{"code":"g_regex_match_all_full()","type":"codeVoice"},{"text":", the retrieved","type":"text"},{"type":"text","text":" "},{"text":"strings are not that matched by sets of parentheses but that of the","type":"text"},{"text":" ","type":"text"},{"type":"text","text":"matched substring. Substrings are matched in reverse order of length,"},{"text":" ","type":"text"},{"text":"so the first one is the longest match.","type":"text"}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"The strings are fetched from the string passed to the match function,"},{"type":"text","text":" "},{"text":"so you cannot call this function after freeing the string.","type":"text"}]}],"kind":"content"}],"identifier":{"url":"doc:\/\/GLib\/documentation\/GLib\/MatchInfoRef\/fetchAll()","interfaceLanguage":"swift"},"metadata":{"title":"fetchAll()","modules":[{"name":"GLib"}],"role":"symbol","roleHeading":"Instance Method","externalID":"s:4GLib17MatchInfoProtocolPAAE8fetchAllSpySpys4Int8VGSgGSgyF::SYNTHESIZED::s:4GLib12MatchInfoRefV","fragments":[{"text":"func","kind":"keyword"},{"text":" ","kind":"text"},{"text":"fetchAll","kind":"identifier"},{"text":"() -> ","kind":"text"},{"text":"UnsafeMutablePointer","kind":"typeIdentifier","preciseIdentifier":"s:Sp"},{"text":"<","kind":"text"},{"text":"UnsafeMutablePointer","kind":"typeIdentifier","preciseIdentifier":"s:Sp"},{"text":"<","kind":"text"},{"text":"gchar","kind":"typeIdentifier","preciseIdentifier":"c:@T@gchar"},{"kind":"text","text":">?>!"}],"extendedModule":"GLib","symbolKind":"method"},"references":{"doc://GLib/documentation/GLib/MatchInfoRef/MatchInfoProtocol-Implementations":{"kind":"article","type":"topic","url":"\/documentation\/glib\/matchinforef\/matchinfoprotocol-implementations","abstract":[],"role":"collectionGroup","title":"MatchInfoProtocol Implementations","identifier":"doc:\/\/GLib\/documentation\/GLib\/MatchInfoRef\/MatchInfoProtocol-Implementations"},"doc://GLib/documentation/GLib/MatchInfoRef":{"identifier":"doc:\/\/GLib\/documentation\/GLib\/MatchInfoRef","type":"topic","abstract":[{"type":"text","text":"A GMatchInfo is an opaque struct used to return information about"},{"text":" ","type":"text"},{"text":"matches.","type":"text"}],"title":"MatchInfoRef","role":"symbol","url":"\/documentation\/glib\/matchinforef","kind":"symbol","fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"MatchInfoRef"}],"navigatorTitle":[{"text":"MatchInfoRef","kind":"identifier"}]},"doc://GLib/documentation/GLib":{"identifier":"doc:\/\/GLib\/documentation\/GLib","title":"GLib","abstract":[],"type":"topic","url":"\/documentation\/glib","kind":"symbol","role":"collection"},"doc://GLib/documentation/GLib/MatchInfoRef/fetchAll()":{"title":"fetchAll()","role":"symbol","identifier":"doc:\/\/GLib\/documentation\/GLib\/MatchInfoRef\/fetchAll()","kind":"symbol","url":"\/documentation\/glib\/matchinforef\/fetchall()","fragments":[{"kind":"keyword","text":"func"},{"text":" ","kind":"text"},{"text":"fetchAll","kind":"identifier"},{"kind":"text","text":"() -> "},{"preciseIdentifier":"s:Sp","text":"UnsafeMutablePointer","kind":"typeIdentifier"},{"kind":"text","text":"<"},{"text":"UnsafeMutablePointer","preciseIdentifier":"s:Sp","kind":"typeIdentifier"},{"text":"<","kind":"text"},{"text":"gchar","kind":"typeIdentifier","preciseIdentifier":"c:@T@gchar"},{"text":">?>!","kind":"text"}],"type":"topic","abstract":[{"type":"text","text":"Bundles up pointers to each of the matching substrings from a match"},{"type":"text","text":" "},{"type":"text","text":"and stores them in an array of gchar pointers. The first element in"},{"text":" ","type":"text"},{"type":"text","text":"the returned array is the match number 0, i.e. the entire matched"},{"type":"text","text":" "},{"type":"text","text":"text."}]}}}