{"metadata":{"symbolKind":"property","title":"isPartialMatch","extendedModule":"GLib","roleHeading":"Instance Property","externalID":"s:4GLib17MatchInfoProtocolPAAE09isPartialB0Sbvp::SYNTHESIZED::s:4GLib12MatchInfoRefV","modules":[{"name":"GLib"}],"role":"symbol","fragments":[{"text":"var","kind":"keyword"},{"text":" ","kind":"text"},{"text":"isPartialMatch","kind":"identifier"},{"text":": ","kind":"text"},{"text":"Bool","kind":"typeIdentifier","preciseIdentifier":"s:Sb"}]},"variants":[{"paths":["\/documentation\/glib\/matchinforef\/ispartialmatch"],"traits":[{"interfaceLanguage":"swift"}]}],"primaryContentSections":[{"kind":"declarations","declarations":[{"tokens":[{"text":"var","kind":"keyword"},{"text":" ","kind":"text"},{"text":"isPartialMatch","kind":"identifier"},{"kind":"text","text":": "},{"kind":"typeIdentifier","text":"Bool","preciseIdentifier":"s:Sb"},{"text":" { ","kind":"text"},{"text":"get","kind":"keyword"},{"text":" }","kind":"text"}],"languages":["swift"],"platforms":["macOS"]}]},{"content":[{"text":"Discussion","anchor":"discussion","level":2,"type":"heading"},{"type":"paragraph","inlineContent":[{"text":"Consider, for example, an application where a human is required to","type":"text"},{"type":"text","text":" "},{"type":"text","text":"type in data for a field with specific formatting requirements. An"},{"text":" ","type":"text"},{"text":"example might be a date in the form ddmmmyy, defined by the pattern","type":"text"},{"type":"text","text":" "},{"type":"codeVoice","code":"\"^\\d?\\d(jan|feb|mar|apr|may|jun|jul|aug|sep|oct|nov|dec)"},{"type":"text","text":"\\d\\d$”."},{"text":" ","type":"text"},{"type":"text","text":"If the application sees the user’s keystrokes one by one, and can"},{"type":"text","text":" "},{"text":"check that what has been typed so far is potentially valid, it is","type":"text"},{"type":"text","text":" "},{"type":"text","text":"able to raise an error as soon as a mistake is made."}]},{"inlineContent":[{"type":"text","text":"GRegex supports the concept of partial matching by means of the"},{"type":"text","text":" "},{"type":"codeVoice","code":"partialSoft"},{"text":" and ","type":"text"},{"type":"codeVoice","code":"partialHard"},{"text":" flags.","type":"text"},{"text":" ","type":"text"},{"type":"text","text":"When they are used, the return code for"},{"text":" ","type":"text"},{"type":"codeVoice","code":"g_regex_match()"},{"type":"text","text":" or "},{"type":"codeVoice","code":"g_regex_match_full()"},{"type":"text","text":" is, as usual, "},{"code":"true","type":"codeVoice"},{"text":" ","type":"text"},{"type":"text","text":"for a complete match, "},{"code":"false","type":"codeVoice"},{"type":"text","text":" otherwise. But, when these functions"},{"type":"text","text":" "},{"type":"text","text":"return "},{"type":"codeVoice","code":"false"},{"text":", you can check if the match was partial calling","type":"text"},{"text":" ","type":"text"},{"code":"g_match_info_is_partial_match()","type":"codeVoice"},{"text":".","type":"text"}],"type":"paragraph"},{"inlineContent":[{"type":"text","text":"The difference between "},{"code":"partialSoft","type":"codeVoice"},{"text":" and","type":"text"},{"text":" ","type":"text"},{"type":"codeVoice","code":"partialHard"},{"type":"text","text":" is that when a partial match is encountered"},{"text":" ","type":"text"},{"type":"text","text":"with "},{"code":"partialSoft","type":"codeVoice"},{"type":"text","text":", matching continues to search for a"},{"text":" ","type":"text"},{"type":"text","text":"possible complete match, while with "},{"code":"partialHard","type":"codeVoice"},{"type":"text","text":" matching"},{"text":" ","type":"text"},{"type":"text","text":"stops at the partial match."},{"text":" ","type":"text"},{"type":"text","text":"When both "},{"code":"partialSoft","type":"codeVoice"},{"type":"text","text":" and "},{"type":"codeVoice","code":"partialHard"},{"type":"text","text":" "},{"type":"text","text":"are set, the latter takes precedence."}],"type":"paragraph"},{"inlineContent":[{"type":"text","text":"There were formerly some restrictions on the pattern for partial matching."},{"type":"text","text":" "},{"type":"text","text":"The restrictions no longer apply."}],"type":"paragraph"},{"type":"paragraph","inlineContent":[{"type":"text","text":"See "},{"type":"codeVoice","code":"pcrepartial(3)"},{"text":" for more information on partial matching.","type":"text"}]}],"kind":"content"}],"identifier":{"interfaceLanguage":"swift","url":"doc:\/\/GLib\/documentation\/GLib\/MatchInfoRef\/isPartialMatch"},"schemaVersion":{"major":0,"minor":3,"patch":0},"abstract":[{"type":"text","text":"Usually if the string passed to g_regex_match*() matches as far as"},{"type":"text","text":" "},{"type":"text","text":"it goes, but is too short to match the entire pattern, "},{"type":"codeVoice","code":"false"},{"type":"text","text":" is"},{"type":"text","text":" "},{"type":"text","text":"returned. There are circumstances where it might be helpful to"},{"type":"text","text":" "},{"text":"distinguish this case from other cases in which there is no match.","type":"text"}],"hierarchy":{"paths":[["doc:\/\/GLib\/documentation\/GLib","doc:\/\/GLib\/documentation\/GLib\/MatchInfoRef","doc:\/\/GLib\/documentation\/GLib\/MatchInfoRef\/MatchInfoProtocol-Implementations"]]},"kind":"symbol","sections":[],"references":{"doc://GLib/documentation/GLib":{"identifier":"doc:\/\/GLib\/documentation\/GLib","title":"GLib","abstract":[],"type":"topic","url":"\/documentation\/glib","kind":"symbol","role":"collection"},"doc://GLib/documentation/GLib/MatchInfoRef/MatchInfoProtocol-Implementations":{"kind":"article","type":"topic","url":"\/documentation\/glib\/matchinforef\/matchinfoprotocol-implementations","abstract":[],"role":"collectionGroup","title":"MatchInfoProtocol Implementations","identifier":"doc:\/\/GLib\/documentation\/GLib\/MatchInfoRef\/MatchInfoProtocol-Implementations"},"doc://GLib/documentation/GLib/MatchInfoRef":{"identifier":"doc:\/\/GLib\/documentation\/GLib\/MatchInfoRef","type":"topic","abstract":[{"type":"text","text":"A GMatchInfo is an opaque struct used to return information about"},{"text":" ","type":"text"},{"text":"matches.","type":"text"}],"title":"MatchInfoRef","role":"symbol","url":"\/documentation\/glib\/matchinforef","kind":"symbol","fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"MatchInfoRef"}],"navigatorTitle":[{"text":"MatchInfoRef","kind":"identifier"}]},"doc://GLib/documentation/GLib/MatchInfoRef/isPartialMatch":{"type":"topic","abstract":[{"type":"text","text":"Usually if the string passed to g_regex_match*() matches as far as"},{"text":" ","type":"text"},{"text":"it goes, but is too short to match the entire pattern, ","type":"text"},{"type":"codeVoice","code":"false"},{"type":"text","text":" is"},{"text":" ","type":"text"},{"type":"text","text":"returned. There are circumstances where it might be helpful to"},{"type":"text","text":" "},{"type":"text","text":"distinguish this case from other cases in which there is no match."}],"title":"isPartialMatch","url":"\/documentation\/glib\/matchinforef\/ispartialmatch","identifier":"doc:\/\/GLib\/documentation\/GLib\/MatchInfoRef\/isPartialMatch","kind":"symbol","role":"symbol","fragments":[{"kind":"keyword","text":"var"},{"text":" ","kind":"text"},{"kind":"identifier","text":"isPartialMatch"},{"text":": ","kind":"text"},{"text":"Bool","kind":"typeIdentifier","preciseIdentifier":"s:Sb"}]}}}