{"schemaVersion":{"major":0,"minor":3,"patch":0},"sections":[],"kind":"symbol","abstract":[{"type":"text","text":"Returns the start and end positions (in bytes) of a successfully matching"},{"type":"text","text":" "},{"text":"capture parenthesis.","type":"text"}],"identifier":{"interfaceLanguage":"swift","url":"doc:\/\/GLib\/documentation\/GLib\/MatchInfoRef\/fetchPos(matchNum:startPos:endPos:)"},"variants":[{"paths":["\/documentation\/glib\/matchinforef\/fetchpos(matchnum:startpos:endpos:)"],"traits":[{"interfaceLanguage":"swift"}]}],"primaryContentSections":[{"kind":"declarations","declarations":[{"tokens":[{"kind":"keyword","text":"func"},{"kind":"text","text":" "},{"text":"fetchPos","kind":"identifier"},{"text":"(","kind":"text"},{"text":"matchNum","kind":"externalParam"},{"text":": ","kind":"text"},{"text":"Int","kind":"typeIdentifier","preciseIdentifier":"s:Si"},{"kind":"text","text":", "},{"text":"startPos","kind":"externalParam"},{"text":": ","kind":"text"},{"kind":"typeIdentifier","text":"UnsafeMutablePointer","preciseIdentifier":"s:Sp"},{"text":"<","kind":"text"},{"text":"gint","kind":"typeIdentifier","preciseIdentifier":"c:@T@gint"},{"text":">! = nil, ","kind":"text"},{"kind":"externalParam","text":"endPos"},{"kind":"text","text":": "},{"preciseIdentifier":"s:Sp","text":"UnsafeMutablePointer","kind":"typeIdentifier"},{"text":"<","kind":"text"},{"text":"gint","preciseIdentifier":"c:@T@gint","kind":"typeIdentifier"},{"text":">! = nil) -> ","kind":"text"},{"preciseIdentifier":"s:Sb","kind":"typeIdentifier","text":"Bool"}],"platforms":["macOS"],"languages":["swift"]}]},{"kind":"content","content":[{"anchor":"discussion","text":"Discussion","type":"heading","level":2},{"type":"paragraph","inlineContent":[{"type":"text","text":"Valid values for "},{"code":"matchNum","type":"codeVoice"},{"type":"text","text":" are "},{"type":"codeVoice","code":"0"},{"type":"text","text":" for the full text of the match,"},{"type":"text","text":" "},{"type":"codeVoice","code":"1"},{"type":"text","text":" for the first paren set, "},{"code":"2","type":"codeVoice"},{"type":"text","text":" for the second, and so on."}]},{"inlineContent":[{"type":"text","text":"As "},{"code":"endPos","type":"codeVoice"},{"text":" is set to the byte after the final byte of the match (on success),","type":"text"},{"type":"text","text":" "},{"type":"text","text":"the length of the match can be calculated as "},{"type":"codeVoice","code":"end_pos - start_pos"},{"type":"text","text":"."}],"type":"paragraph"},{"inlineContent":[{"text":"As a best practice, initialize ","type":"text"},{"type":"codeVoice","code":"startPos"},{"type":"text","text":" and "},{"code":"endPos","type":"codeVoice"},{"type":"text","text":" to identifiable"},{"text":" ","type":"text"},{"text":"values, such as ","type":"text"},{"type":"codeVoice","code":"G_MAXINT"},{"type":"text","text":", so that you can test if"},{"type":"text","text":" "},{"type":"codeVoice","code":"g_match_info_fetch_pos()"},{"type":"text","text":" actually changed the value for a given"},{"type":"text","text":" "},{"text":"capture parenthesis.","type":"text"}],"type":"paragraph"},{"inlineContent":[{"type":"text","text":"The parameter "},{"code":"matchNum","type":"codeVoice"},{"type":"text","text":" corresponds to a matched capture parenthesis. The"},{"type":"text","text":" "},{"type":"text","text":"actual value you use for "},{"code":"matchNum","type":"codeVoice"},{"text":" depends on the method used to generate","type":"text"},{"text":" ","type":"text"},{"code":"matchInfo","type":"codeVoice"},{"text":". The following sections describe those methods.","type":"text"}],"type":"paragraph"},{"text":"Methods Using Non-deterministic Finite Automata Matching","anchor":"Methods-Using-Non-deterministic-Finite-Automata-Matching","level":2,"type":"heading"},{"type":"paragraph","inlineContent":[{"type":"text","text":"The methods [method"},{"type":"codeVoice","code":"GLib.Regex.match"},{"type":"text","text":"] and [method"},{"type":"codeVoice","code":"GLib.Regex.match_full"},{"type":"text","text":"]"},{"type":"text","text":" "},{"type":"text","text":"return a [struct"},{"isActive":true,"type":"reference","identifier":"doc:\/\/GLib\/documentation\/GLib\/MatchInfo"},{"type":"text","text":"] using traditional (greedy) pattern"},{"type":"text","text":" "},{"type":"text","text":"matching, also known as"},{"type":"text","text":" "},{"type":"reference","identifier":"https:\/\/en.wikipedia.org\/wiki\/Nondeterministic_finite_automaton","isActive":true},{"type":"text","text":" "},{"type":"text","text":"(NFA) matching. You pass the returned "},{"type":"codeVoice","code":"GMatchInfo"},{"text":" from these methods to","type":"text"},{"type":"text","text":" "},{"type":"codeVoice","code":"g_match_info_fetch_pos()"},{"text":" to determine the start and end positions","type":"text"},{"text":" ","type":"text"},{"type":"text","text":"of capture parentheses. The values for "},{"type":"codeVoice","code":"matchNum"},{"type":"text","text":" correspond to the capture"},{"type":"text","text":" "},{"type":"text","text":"parentheses in order, with "},{"code":"0","type":"codeVoice"},{"text":" corresponding to the entire matched string.","type":"text"}]},{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"matchNum"},{"type":"text","text":" can refer to a capture parenthesis with no match. For example,"},{"text":" ","type":"text"},{"type":"text","text":"the string "},{"type":"codeVoice","code":"b"},{"type":"text","text":" matches against the pattern "},{"code":"(a)?b","type":"codeVoice"},{"type":"text","text":", but the capture"},{"text":" ","type":"text"},{"type":"text","text":"parenthesis "},{"code":"(a)","type":"codeVoice"},{"type":"text","text":" has no match. In this case, "},{"code":"g_match_info_fetch_pos()","type":"codeVoice"},{"type":"text","text":" "},{"text":"returns true and sets ","type":"text"},{"type":"codeVoice","code":"startPos"},{"text":" and ","type":"text"},{"type":"codeVoice","code":"endPos"},{"type":"text","text":" to "},{"type":"codeVoice","code":"-1"},{"type":"text","text":" when called with"},{"type":"text","text":" "},{"type":"codeVoice","code":"match_num"},{"text":" as ","type":"text"},{"code":"1","type":"codeVoice"},{"text":" (for ","type":"text"},{"code":"(a)","type":"codeVoice"},{"text":").","type":"text"}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"For an expanded example, a regex pattern is "},{"code":"(a)?(.*?)the (.*)","type":"codeVoice"},{"type":"text","text":","},{"text":" ","type":"text"},{"type":"text","text":"and a candidate string is "},{"type":"codeVoice","code":"glib regexes are the best"},{"type":"text","text":". In this scenario"},{"text":" ","type":"text"},{"text":"there are four capture parentheses numbered 0–3: an implicit one","type":"text"},{"text":" ","type":"text"},{"text":"for the entire string, and three explicitly declared in the regex pattern.","type":"text"}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"Given this example, the following table describes the return values"},{"type":"text","text":" "},{"type":"text","text":"from "},{"type":"codeVoice","code":"g_match_info_fetch_pos()"},{"type":"text","text":" for various values of "},{"type":"codeVoice","code":"matchNum"},{"text":".","type":"text"}]},{"type":"table","header":"row","rows":[[[{"inlineContent":[{"code":"match_num","type":"codeVoice"}],"type":"paragraph"}],[{"inlineContent":[{"type":"text","text":"Contents"}],"type":"paragraph"}],[{"type":"paragraph","inlineContent":[{"type":"text","text":"Return value"}]}],[{"type":"paragraph","inlineContent":[{"text":"Returned ","type":"text"},{"type":"codeVoice","code":"start_pos"}]}],[{"inlineContent":[{"type":"text","text":"Returned "},{"code":"end_pos","type":"codeVoice"}],"type":"paragraph"}]],[[{"inlineContent":[{"text":"0","type":"text"}],"type":"paragraph"}],[{"inlineContent":[{"text":"Matches entire string","type":"text"}],"type":"paragraph"}],[{"type":"paragraph","inlineContent":[{"text":"True","type":"text"}]}],[{"type":"paragraph","inlineContent":[{"type":"text","text":"0"}]}],[{"type":"paragraph","inlineContent":[{"type":"text","text":"25"}]}]],[[{"type":"paragraph","inlineContent":[{"type":"text","text":"1"}]}],[{"inlineContent":[{"text":"Does not match first character","type":"text"}],"type":"paragraph"}],[{"inlineContent":[{"type":"text","text":"True"}],"type":"paragraph"}],[{"type":"paragraph","inlineContent":[{"type":"text","text":"-1"}]}],[{"type":"paragraph","inlineContent":[{"text":"-1","type":"text"}]}]],[[{"type":"paragraph","inlineContent":[{"type":"text","text":"2"}]}],[{"type":"paragraph","inlineContent":[{"text":"All text before ","type":"text"},{"code":"the ","type":"codeVoice"}]}],[{"type":"paragraph","inlineContent":[{"type":"text","text":"True"}]}],[{"inlineContent":[{"type":"text","text":"0"}],"type":"paragraph"}],[{"inlineContent":[{"type":"text","text":"17"}],"type":"paragraph"}]],[[{"type":"paragraph","inlineContent":[{"type":"text","text":"3"}]}],[{"type":"paragraph","inlineContent":[{"text":"All text after ","type":"text"},{"code":"the ","type":"codeVoice"}]}],[{"inlineContent":[{"text":"True","type":"text"}],"type":"paragraph"}],[{"inlineContent":[{"text":"21","type":"text"}],"type":"paragraph"}],[{"type":"paragraph","inlineContent":[{"type":"text","text":"25"}]}]],[[{"type":"paragraph","inlineContent":[{"type":"text","text":"4"}]}],[{"type":"paragraph","inlineContent":[{"type":"text","text":"Capture paren out of range"}]}],[{"type":"paragraph","inlineContent":[{"text":"False","type":"text"}]}],[{"type":"paragraph","inlineContent":[{"type":"text","text":"Unchanged"}]}],[{"type":"paragraph","inlineContent":[{"type":"text","text":"Unchanged"}]}]]]},{"inlineContent":[{"text":"The following code sample and output implements this example.","type":"text"}],"type":"paragraph"},{"type":"codeListing","syntax":"{ .c }","code":["`include` <glib.h>","","int","main (int argc, char *argv[])","{","  `g_autoptr(GError)` local_error = NULL;","  const char *regex_pattern = \"(a)?(.*?)the (.*)\";","  const char *test_string = \"glib regexes are the best\";","  `g_autoptr(GRegex)` regex = NULL;","","  regex = g_regex_new (regex_pattern,","                       G_REGEX_DEFAULT,","                       G_REGEX_MATCH_DEFAULT,","                       &local_error);","  if (regex == NULL)","    {","      g_printerr (\"Error creating regex: `s`\\n\", local_error->message);","      return 1;","    }","","  `g_autoptr(GMatchInfo)` match_info = NULL;","  g_regex_match (regex, test_string, G_REGEX_MATCH_DEFAULT, &match_info);","","  int n_matched_strings = g_match_info_get_match_count (match_info);","","  \/\/ Print header line","  g_print (\"match_num Contents                  Return value returned start_pos returned end_pos\\n\");","","  \/\/ Iterate over each capture paren, including one that is out of range as a demonstration.","  for (int match_num = 0; match_num <= n_matched_strings; match_num++)","    {","      gboolean found_match;","      g_autofree char *paren_string = NULL;","      int start_pos = G_MAXINT;","      int end_pos = G_MAXINT;","","      found_match = g_match_info_fetch_pos (match_info,","                                            match_num,","                                            &start_pos,","                                            &end_pos);","","      \/\/ If no match, display N\/A as the found string.","      if (start_pos == G_MAXINT || start_pos == -1)","        paren_string = g_strdup (\"N\/A\");","      else","        paren_string = g_strndup (test_string + start_pos, end_pos - start_pos);","","      g_print (\"`-9d` `-25s` `-12d` `-18d` `d`\\n\", match_num, paren_string, found_match, start_pos, end_pos);","    }","","  return 0;","}"]},{"type":"codeListing","syntax":null,"code":["match_num Contents                  Return value returned start_pos returned end_pos","0         glib regexes are the best 1            0                  25","1         N\/A                       1            -1                 -1","2         glib regexes are          1            0                  17","3         best                      1            21                 25","4         N\/A                       0            2147483647         2147483647"]},{"type":"heading","text":"Methods Using Deterministic Finite Automata Matching","anchor":"Methods-Using-Deterministic-Finite-Automata-Matching","level":2},{"type":"paragraph","inlineContent":[{"type":"text","text":"The methods [method"},{"code":"GLib.Regex.match_all","type":"codeVoice"},{"text":"] and","type":"text"},{"type":"text","text":" "},{"type":"text","text":"[method"},{"code":"GLib.Regex.match_all_full","type":"codeVoice"},{"type":"text","text":"]"},{"type":"text","text":" "},{"type":"text","text":"return a "},{"type":"codeVoice","code":"GMatchInfo"},{"text":" using","type":"text"},{"text":" ","type":"text"},{"type":"reference","isActive":true,"identifier":"https:\/\/en.wikipedia.org\/wiki\/Deterministic_finite_automaton"},{"text":" ","type":"text"},{"text":"(DFA) pattern matching. This algorithm detects overlapping matches. You pass","type":"text"},{"text":" ","type":"text"},{"text":"the returned ","type":"text"},{"code":"GMatchInfo","type":"codeVoice"},{"type":"text","text":" from these methods to "},{"code":"g_match_info_fetch_pos()","type":"codeVoice"},{"text":" ","type":"text"},{"type":"text","text":"to determine the start and end positions of each overlapping match. Use the"},{"type":"text","text":" "},{"text":"method [method","type":"text"},{"type":"codeVoice","code":"GLib.MatchInfo.get_match_count"},{"text":"] to determine the number","type":"text"},{"type":"text","text":" "},{"type":"text","text":"of overlapping matches."}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"For example, a regex pattern is "},{"type":"codeVoice","code":"<.*>"},{"type":"text","text":", and a candidate string is"},{"text":" ","type":"text"},{"type":"codeVoice","code":"<a> <b> <c>"},{"text":". In this scenario there are three implicit capture","type":"text"},{"type":"text","text":" "},{"text":"parentheses: one for the entire string, one for ","type":"text"},{"type":"codeVoice","code":"<a> <b>"},{"type":"text","text":", and one for "},{"type":"codeVoice","code":"<a>"},{"type":"text","text":"."}]},{"inlineContent":[{"type":"text","text":"Given this example, the following table describes the return values from"},{"text":" ","type":"text"},{"code":"g_match_info_fetch_pos()","type":"codeVoice"},{"text":" for various values of ","type":"text"},{"code":"matchNum","type":"codeVoice"},{"text":".","type":"text"}],"type":"paragraph"},{"rows":[[[{"type":"paragraph","inlineContent":[{"code":"match_num","type":"codeVoice"}]}],[{"inlineContent":[{"text":"Contents","type":"text"}],"type":"paragraph"}],[{"type":"paragraph","inlineContent":[{"text":"Return value","type":"text"}]}],[{"type":"paragraph","inlineContent":[{"type":"text","text":"Returned "},{"code":"start_pos","type":"codeVoice"}]}],[{"type":"paragraph","inlineContent":[{"type":"text","text":"Returned "},{"type":"codeVoice","code":"end_pos"}]}]],[[{"inlineContent":[{"text":"0","type":"text"}],"type":"paragraph"}],[{"type":"paragraph","inlineContent":[{"text":"Matches entire string","type":"text"}]}],[{"inlineContent":[{"text":"True","type":"text"}],"type":"paragraph"}],[{"inlineContent":[{"text":"0","type":"text"}],"type":"paragraph"}],[{"type":"paragraph","inlineContent":[{"type":"text","text":"11"}]}]],[[{"inlineContent":[{"type":"text","text":"1"}],"type":"paragraph"}],[{"type":"paragraph","inlineContent":[{"type":"text","text":"Matches "},{"code":"<a> <b>","type":"codeVoice"}]}],[{"inlineContent":[{"text":"True","type":"text"}],"type":"paragraph"}],[{"type":"paragraph","inlineContent":[{"type":"text","text":"0"}]}],[{"inlineContent":[{"text":"7","type":"text"}],"type":"paragraph"}]],[[{"type":"paragraph","inlineContent":[{"text":"2","type":"text"}]}],[{"inlineContent":[{"type":"text","text":"Matches "},{"code":"<a>","type":"codeVoice"}],"type":"paragraph"}],[{"type":"paragraph","inlineContent":[{"type":"text","text":"True"}]}],[{"type":"paragraph","inlineContent":[{"text":"0","type":"text"}]}],[{"inlineContent":[{"text":"3","type":"text"}],"type":"paragraph"}]],[[{"type":"paragraph","inlineContent":[{"type":"text","text":"3"}]}],[{"inlineContent":[{"text":"Capture paren out of range","type":"text"}],"type":"paragraph"}],[{"type":"paragraph","inlineContent":[{"text":"False","type":"text"}]}],[{"inlineContent":[{"type":"text","text":"Unchanged"}],"type":"paragraph"}],[{"type":"paragraph","inlineContent":[{"type":"text","text":"Unchanged"}]}]]],"type":"table","header":"row"},{"inlineContent":[{"text":"The following code sample and output implements this example.","type":"text"}],"type":"paragraph"},{"syntax":"{ .c }","code":["`include` <glib.h>","","int","main (int argc, char *argv[])","{","  `g_autoptr(GError)` local_error = NULL;","  const char *regex_pattern = \"<.*>\";","  const char *test_string = \"<a> <b> <c>\";","  `g_autoptr(GRegex)` regex = NULL;","","  regex = g_regex_new (regex_pattern,","                       G_REGEX_DEFAULT,","                       G_REGEX_MATCH_DEFAULT,","                       &local_error);","  if (regex == NULL)","    {","      g_printerr (\"Error creating regex: `s`\\n\", local_error->message);","      return -1;","    }","","  `g_autoptr(GMatchInfo)` match_info = NULL;","  g_regex_match_all (regex, test_string, G_REGEX_MATCH_DEFAULT, &match_info);","","  int n_matched_strings = g_match_info_get_match_count (match_info);","","  \/\/ Print header line","  g_print (\"match_num Contents                  Return value returned start_pos returned end_pos\\n\");","","  \/\/ Iterate over each capture paren, including one that is out of range as a demonstration.","  for (int match_num = 0; match_num <= n_matched_strings; match_num++)","    {","      gboolean found_match;","      g_autofree char *paren_string = NULL;","      int start_pos = G_MAXINT;","      int end_pos = G_MAXINT;","","      found_match = g_match_info_fetch_pos (match_info, match_num, &start_pos, &end_pos);","","      \/\/ If no match, display N\/A as the found string.","      if (start_pos == G_MAXINT || start_pos == -1)","        paren_string = g_strdup (\"N\/A\");","      else","        paren_string = g_strndup (test_string + start_pos, end_pos - start_pos);","","      g_print (\"`-9d` `-25s` `-12d` `-18d` `d`\\n\", match_num, paren_string, found_match, start_pos, end_pos);","    }","","  return 0;","}"],"type":"codeListing"},{"code":["match_num Contents                  Return value returned start_pos returned end_pos","0         <a> <b> <c>               1            0                  11","1         <a> <b>                   1            0                  7","2         <a>                       1            0                  3","3         N\/A                       0            2147483647         2147483647"],"syntax":null,"type":"codeListing"}]}],"hierarchy":{"paths":[["doc:\/\/GLib\/documentation\/GLib","doc:\/\/GLib\/documentation\/GLib\/MatchInfoRef","doc:\/\/GLib\/documentation\/GLib\/MatchInfoRef\/MatchInfoProtocol-Implementations"]]},"metadata":{"symbolKind":"method","title":"fetchPos(matchNum:startPos:endPos:)","extendedModule":"GLib","fragments":[{"text":"func","kind":"keyword"},{"kind":"text","text":" "},{"kind":"identifier","text":"fetchPos"},{"text":"(","kind":"text"},{"text":"matchNum","kind":"externalParam"},{"kind":"text","text":": "},{"kind":"typeIdentifier","text":"Int","preciseIdentifier":"s:Si"},{"text":", ","kind":"text"},{"text":"startPos","kind":"externalParam"},{"text":": ","kind":"text"},{"kind":"typeIdentifier","preciseIdentifier":"s:Sp","text":"UnsafeMutablePointer"},{"text":"<","kind":"text"},{"preciseIdentifier":"c:@T@gint","text":"gint","kind":"typeIdentifier"},{"text":">!, ","kind":"text"},{"kind":"externalParam","text":"endPos"},{"text":": ","kind":"text"},{"kind":"typeIdentifier","text":"U