entifier"},{"kind":"text","text":"!"}],"platforms":["macOS"]}]},{"content":[{"anchor":"discussion","level":2,"type":"heading","text":"Discussion"},{"inlineContent":[{"type":"text","text":"A single "},{"type":"reference","isActive":true,"identifier":"doc:\/\/GLib\/documentation\/GLib\/Variant"},{"type":"text","text":" is parsed from the content of "},{"type":"codeVoice","code":"text"},{"type":"text","text":"."}],"type":"paragraph"},{"inlineContent":[{"type":"text","text":"The format is described "},{"type":"reference","isActive":true,"identifier":"gvariant-text-format.html"},{"type":"text","text":"."}],"type":"paragraph"},{"inlineContent":[{"type":"text","text":"The memory at "},{"type":"codeVoice","code":"limit"},{"text":" will never be accessed and the parser behaves as","type":"text"},{"text":" ","type":"text"},{"text":"if the character at ","type":"text"},{"type":"codeVoice","code":"limit"},{"text":" is the nul terminator.  This has the","type":"text"},{"text":" ","type":"text"},{"type":"text","text":"effect of bounding "},{"type":"codeVoice","code":"text"},{"text":".","type":"text"}],"type":"paragraph"},{"type":"paragraph","inlineContent":[{"type":"text","text":"If "},{"code":"endptr","type":"codeVoice"},{"type":"text","text":" is non-"},{"code":"nil","type":"codeVoice"},{"type":"text","text":" then "},{"code":"text","type":"codeVoice"},{"type":"text","text":" is permitted to contain data"},{"type":"text","text":" "},{"text":"following the value that this function parses and ","type":"text"},{"type":"codeVoice","code":"endptr"},{"type":"text","text":" will be"},{"text":" ","type":"text"},{"type":"text","text":"updated to point to the first character past the end of the text"},{"text":" ","type":"text"},{"type":"text","text":"parsed by this function.  If "},{"type":"codeVoice","code":"endptr"},{"text":" is ","type":"text"},{"type":"codeVoice","code":"nil"},{"type":"text","text":" and there is extra data"},{"text":" ","type":"text"},{"text":"then an error is returned.","type":"text"}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"If "},{"type":"codeVoice","code":"type"},{"type":"text","text":" is non-"},{"type":"codeVoice","code":"nil"},{"text":" then the value will be parsed to have that","type":"text"},{"type":"text","text":" "},{"text":"type.  This may result in additional parse errors (in the case that","type":"text"},{"text":" ","type":"text"},{"type":"text","text":"the parsed value doesn’t fit the type) but may also result in fewer"},{"type":"text","text":" "},{"text":"errors (in the case that the type would have been ambiguous, such as","type":"text"},{"text":" ","type":"text"},{"text":"with empty arrays).","type":"text"}]},{"type":"paragraph","inlineContent":[{"text":"In the event that the parsing is successful, the resulting ","type":"text"},{"isActive":true,"identifier":"doc:\/\/GLib\/documentation\/GLib\/Variant","type":"reference"},{"type":"text","text":" "},{"type":"text","text":"is returned. It is never floating, and must be freed with"},{"type":"text","text":" "},{"type":"text","text":"[method"},{"code":"GLib.Variant.unref","type":"codeVoice"},{"text":"].","type":"text"}]},{"type":"paragraph","inlineContent":[{"text":"In case of any error, ","type":"text"},{"type":"codeVoice","code":"nil"},{"type":"text","text":" will be returned.  If "},{"type":"codeVoice","code":"error"},{"text":" is non-","type":"text"},{"type":"codeVoice","code":"nil"},{"type":"text","text":" "},{"text":"then it will be set to reflect the error that occurred.","type":"text"}]},{"inlineContent":[{"text":"Officially, the language understood by the parser is “any string","type":"text"},{"text":" ","type":"text"},{"type":"text","text":"produced by [method"},{"type":"codeVoice","code":"GLib.Variant.print"},{"text":"]”. This explicitly includes","type":"text"},{"type":"text","text":" "},{"type":"codeVoice","code":"g_variant_print()"},{"type":"text","text":"’s annotated types like "},{"code":"int64 -1000","type":"codeVoice"},{"type":"text","text":"."}],"type":"paragraph"},{"type":"paragraph","inlineContent":[{"text":"There may be implementation specific restrictions on deeply nested values,","type":"text"},{"text":" ","type":"text"},{"type":"text","text":"which would result in a "},{"code":"recursion","type":"codeVoice"},{"text":" error. ","type":"text"},{"type":"reference","identifier":"doc:\/\/GLib\/documentation\/GLib\/Variant","isActive":true},{"text":" is","type":"text"},{"type":"text","text":" "},{"type":"text","text":"guaranteed to handle nesting up to at least 64 levels."}]}],"kind":"content"}],"sections":[],"schemaVersion":{"major":0,"minor":3,"patch":0},"metadata":{"extendedModule":"GLib","symbolKind":"method","title":"variantParse(text:limit:endptr:)","externalID":"s:4GLib19VariantTypeProtocolPAAE12variantParse4text5limit6endptrAA0B3RefVSgSPys4Int8VGSg_ANSpyANGSgtKF","roleHeading":"Instance Method","role":"symbol","modules":[{"name":"GLib"}],"fragments":[{"kind":"keyword","text":"func"},{"text":" ","kind":"text"},{"text":"variantParse","kind":"identifier"},{"text":"(","kind":"text"},{"text":"text","kind":"externalParam"},{"text":": ","kind":"text"},{"kind":"typeIdentifier","text":"UnsafePointer","preciseIdentifier":"s:SP"},{"kind":"text","text":"<"},{"text":"gchar","kind":"typeIdentifier","preciseIdentifier":"c:@T@gchar"},{"kind":"text","text":">!, "},{"text":"limit","kind":"externalParam"},{"text":": ","kind":"text"},{"kind":"typeIdentifier","text":"UnsafePointer","preciseIdentifier":"s:SP"},{"text":"<","kind":"text"},{"text":"gchar","preciseIdentifier":"c:@T@gchar","kind":"typeIdentifier"},{"text":">?, ","kind":"text"},{"text":"endptr","kind":"externalParam"},{"text":": ","kind":"text"},{"kind":"typeIdentifier","preciseIdentifier":"s:Sp","text":"UnsafeMutablePointer"},{"kind":"text","text":"<"},{"preciseIdentifier":"s:SP","text":"UnsafePointer","kind":"typeIdentifier"},{"text":"<","kind":"text"},{"kind":"typeIdentifier","preciseIdentifier":"c:@T@gchar","text":"gchar"},{"kind":"te