{"schemaVersion":{"patch":0,"major":0,"minor":3},"hierarchy":{"paths":[["doc:\/\/GLib\/documentation\/GLib"]]},"sections":[],"metadata":{"modules":[{"name":"GLib"}],"fragments":[{"kind":"keyword","text":"func"},{"kind":"text","text":" "},{"text":"getTmpDir","kind":"identifier"},{"text":"() -> ","kind":"text"},{"kind":"typeIdentifier","text":"String","preciseIdentifier":"s:SS"},{"text":"!","kind":"text"}],"role":"symbol","symbolKind":"func","roleHeading":"Function","title":"getTmpDir()","externalID":"s:4GLib9getTmpDirSSSgyF"},"variants":[{"paths":["\/documentation\/glib\/gettmpdir()"],"traits":[{"interfaceLanguage":"swift"}]}],"identifier":{"url":"doc:\/\/GLib\/documentation\/GLib\/getTmpDir()","interfaceLanguage":"swift"},"kind":"symbol","primaryContentSections":[{"kind":"declarations","declarations":[{"platforms":["macOS"],"languages":["swift"],"tokens":[{"text":"func","kind":"keyword"},{"kind":"text","text":" "},{"kind":"identifier","text":"getTmpDir"},{"text":"() -> ","kind":"text"},{"text":"String","kind":"typeIdentifier","preciseIdentifier":"s:SS"},{"kind":"text","text":"!"}]}]},{"content":[{"type":"heading","anchor":"discussion","text":"Discussion","level":2},{"type":"paragraph","inlineContent":[{"text":"On UNIX, this is taken from the ","type":"text"},{"code":"TMPDIR","type":"codeVoice"},{"text":" environment variable.","type":"text"},{"text":" ","type":"text"},{"type":"text","text":"If the variable is not set, "},{"code":"P_tmpdir","type":"codeVoice"},{"text":" is","type":"text"},{"text":" ","type":"text"},{"text":"used, as defined by the system C library. Failing that, a","type":"text"},{"text":" ","type":"text"},{"type":"text","text":"hard-coded default of “\/tmp” is returned."}]},{"inlineContent":[{"text":"On Windows, the ","type":"text"},{"type":"codeVoice","code":"TEMP"},{"text":" environment variable is used, with the","type":"text"},{"type":"text","text":" "},{"text":"root directory of the Windows installation (eg: “C:\") used","type":"text"},{"type":"text","text":" "},{"type":"text","text":"as a default."}],"type":"paragraph"},{"inlineContent":[{"text":"The encoding of the returned string is system-defined. On Windows,","type":"text"},{"text":" ","type":"text"},{"text":"it is always UTF-8. The return value is never ","type":"text"},{"code":"nil","type":"codeVoice"},{"type":"text","text":" or the empty"},{"text":" ","type":"text"},{"text":"string.","type":"text"}],"type":"paragraph"}],"kind":"content"}],"abstract":[{"text":"Gets the directory to use for temporary files.","type":"text"}],"references":{"doc://GLib/documentation/GLib/getTmpDir()":{"url":"\/documentation\/glib\/gettmpdir()","fragments":[{"text":"func","kind":"keyword"},{"text":" ","kind":"text"},{"kind":"identifier","text":"getTmpDir"},{"text":"() -> ","kind":"text"},{"text":"String","kind":"typeIdentifier","preciseIdentifier":"s:SS"},{"text":"!","kind":"text"}],"identifier":"doc:\/\/GLib\/documentation\/GLib\/getTmpDir()","type":"topic","abstract":[{"type":"text","text":"Gets the directory to use for temporary files."}],"title":"getTmpDir()","kind":"symbol","role":"symbol"},"doc://GLib/documentation/GLib":{"identifier":"doc:\/\/GLib\/documentation\/GLib","title":"GLib","abstract":[],"type":"topic","url":"\/documentation\/glib","kind":"symbol","role":"collection"}}}