{"kind":"symbol","hierarchy":{"paths":[["doc:\/\/GLib\/documentation\/GLib"]]},"identifier":{"interfaceLanguage":"swift","url":"doc:\/\/GLib\/documentation\/GLib\/pathIsAbsolute(fileName:)"},"sections":[],"primaryContentSections":[{"declarations":[{"platforms":["macOS"],"tokens":[{"kind":"keyword","text":"func"},{"kind":"text","text":" "},{"text":"pathIsAbsolute","kind":"identifier"},{"kind":"text","text":"("},{"text":"fileName","kind":"externalParam"},{"text":": ","kind":"text"},{"text":"UnsafePointer","kind":"typeIdentifier","preciseIdentifier":"s:SP"},{"kind":"text","text":"<"},{"text":"gchar","preciseIdentifier":"c:@T@gchar","kind":"typeIdentifier"},{"kind":"text","text":">!) -> "},{"kind":"typeIdentifier","preciseIdentifier":"s:Sb","text":"Bool"}],"languages":["swift"]}],"kind":"declarations"},{"kind":"content","content":[{"anchor":"discussion","text":"Discussion","type":"heading","level":2},{"type":"paragraph","inlineContent":[{"text":"On POSIX systems, an absolute file name is well-defined. It always","type":"text"},{"type":"text","text":" "},{"text":"starts from the single root directory. For example “\/usr\/local”.","type":"text"}]},{"type":"paragraph","inlineContent":[{"text":"On Windows, the concepts of current drive and drive-specific","type":"text"},{"type":"text","text":" "},{"type":"text","text":"current directory introduce vagueness. This function interprets as"},{"type":"text","text":" "},{"type":"text","text":"an absolute file name one that either begins with a directory"},{"text":" ","type":"text"},{"text":"separator such as “\\Users\\tml” or begins with the root on a drive,","type":"text"},{"text":" ","type":"text"},{"type":"text","text":"for example “C:\\Windows”. The first case also includes UNC paths"},{"type":"text","text":" "},{"type":"text","text":"such as “\\\\myserver\\docs\\foo”. In all cases, either slashes or"},{"type":"text","text":" "},{"text":"backslashes are accepted.","type":"text"}]},{"inlineContent":[{"type":"text","text":"Note that a file name relative to the current drive root does not"},{"type":"text","text":" "},{"text":"truly specify a file uniquely over time and across processes, as","type":"text"},{"type":"text","text":" "},{"type":"text","text":"the current drive is a per-process value and can be changed."}],"type":"paragraph"},{"type":"paragraph","inlineContent":[{"type":"text","text":"File names relative the current directory on some specific drive,"},{"type":"text","text":" "},{"text":"such as “D:foo\/bar”, are not interpreted as absolute by this","type":"text"},{"type":"text","text":" "},{"type":"text","text":"function, but they obviously are not relative to the normal current"},{"text":" ","type":"text"},{"type":"text","text":"directory as returned by "},{"type":"codeVoice","code":"getcwd()"},{"text":" or ","type":"text"},{"code":"g_get_current_dir()","type":"codeVoice"},{"type":"text","text":" "},{"type":"text","text":"either. Such paths should be avoided, or need to be handled using"},{"type":"text","text":" "},{"text":"Windows-specific code.","type":"text"}]}]}],"schemaVersion":{"minor":3,"patch":0,"major":0},"abstract":[{"text":"Returns ","type":"text"},{"code":"true","type":"codeVoice"},{"type":"text","text":" if the given "},{"code":"fileName","type":"codeVoice"},{"type":"text","text":" is an absolute file name."},{"text":" ","type":"text"},{"type":"text","text":"Note that this is a somewhat vague concept on Windows."}],"variants":[{"paths":["\/documentation\/glib\/pathisabsolute(filename:)"],"traits":[{"interfaceLanguage":"swift"}]}],"metadata":{"symbolKind":"func","modules":[{"name":"GLib"}],"title":"pathIsAbsolute(fileName:)","fragments":[{"text":"func","kind":"keyword"},{"text":" ","kind":"text"},{"kind":"identifier","text":"pathIsAbsolute"},{"text":"(","kind":"text"},{"text":"fileName","kind":"externalParam"},{"kind":"text","text":": "},{"preciseIdentifier":"s:SP","text":"UnsafePointer","kind":"typeIdentifier"},{"text":"<","kind":"text"},{"text":"gchar","kind":"typeIdentifier","preciseIdentifier":"c:@T@gchar"},{"text":">!) -> ","kind":"text"},{"preciseIdentifier":"s:Sb","kind":"typeIdentifier","text":"Bool"}],"role":"symbol","externalID":"s:4GLib14pathIsAbsolute8fileNameSbSPys4Int8VGSg_tF","roleHeading":"Function"},"references":{"doc://GLib/documentation/GLib/pathIsAbsolute(fileName:)":{"title":"pathIsAbsolute(fileName:)","role":"symbol","kind":"symbol","identifier":"doc:\/\/GLib\/documentation\/GLib\/pathIsAbsolute(fileName:)","url":"\/documentation\/glib\/pathisabsolute(filename:)","fragments":[{"kind":"keyword","text":"func"},{"text":" ","kind":"text"},{"kind":"identifier","text":"pathIsAbsolute"},{"text":"(","kind":"text"},{"text":"fileName","kind":"externalParam"},{"kind":"text","text":": "},{"text":"UnsafePointer","kind":"typeIdentifier","preciseIdentifier":"s:SP"},{"kind":"text","text":"<"},{"preciseIdentifier":"c:@T@gchar","kind":"typeIdentifier","text":"gchar"},{"text":">!) -> ","kind":"text"},{"text":"Bool","kind":"typeIdentifier","preciseIdentifier":"s:Sb"}],"type":"topic","abstract":[{"type":"text","text":"Returns "},{"type":"codeVoice","code":"true"},{"type":"text","text":" if the given "},{"code":"fileName","type":"codeVoice"},{"type":"text","text":" is an absolute file name."},{"type":"text","text":" "},{"type":"text","text":"Note that this is a somewhat vague concept on Windows."}]},"doc://GLib/documentation/GLib":{"identifier":"doc:\/\/GLib\/documentation\/GLib","title":"GLib","abstract":[],"type":"topic","url":"\/documentation\/glib","kind":"symbol","role":"collection"}}}