{"abstract":[{"text":"A value that can be passed as an option to [func","type":"text"},{"type":"codeVoice","code":"GLib.test_init"},{"text":"].","type":"text"}],"kind":"symbol","hierarchy":{"paths":[["doc:\/\/GLib\/documentation\/GLib"]]},"primaryContentSections":[{"declarations":[{"tokens":[{"kind":"keyword","text":"let"},{"kind":"text","text":" "},{"kind":"identifier","text":"TEST_OPTION_ISOLATE_DIRS"},{"kind":"text","text":": "},{"text":"String","kind":"typeIdentifier","preciseIdentifier":"s:SS"}],"platforms":["macOS"],"languages":["swift"]}],"kind":"declarations"},{"content":[{"text":"Discussion","type":"heading","anchor":"discussion","level":2},{"type":"paragraph","inlineContent":[{"text":"Creates a unique temporary directory for each unit test and uses sets","type":"text"},{"text":" ","type":"text"},{"type":"text","text":"XDG directories to point into subdirectories of it for the duration of"},{"text":" ","type":"text"},{"type":"text","text":"the unit test. The directory tree is cleaned up after the test finishes"},{"text":" ","type":"text"},{"type":"text","text":"successfully."}]},{"inlineContent":[{"type":"text","text":"Note that this doesn’t take effect until [func"},{"code":"GLib.test_run","type":"codeVoice"},{"text":"] is called,","type":"text"},{"type":"text","text":" "},{"type":"text","text":"so calls to (for example) [func"},{"code":"GLib.get_home_dir","type":"codeVoice"},{"type":"text","text":"] will return the"},{"type":"text","text":" "},{"text":"system-wide value when made in a test program’s ","type":"text"},{"type":"codeVoice","code":"main()"},{"text":" function.","type":"text"}],"type":"paragraph"},{"type":"paragraph","inlineContent":[{"type":"text","text":"The following functions will return subdirectories of the temporary directory"},{"type":"text","text":" "},{"type":"text","text":"when this option is used. The specific subdirectory paths in use are not"},{"text":" ","type":"text"},{"text":"guaranteed to be stable API — always use a getter function to retrieve them.","type":"text"}]},{"type":"unorderedList","items":[{"content":[{"inlineContent":[{"text":"[func","type":"text"},{"code":"GLib.get_home_dir","type":"codeVoice"},{"text":"]","type":"text"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"type":"text","text":"[func"},{"type":"codeVoice","code":"GLib.get_user_cache_dir"},{"type":"text","text":"]"}],"type":"paragraph"}]},{"content":[{"type":"paragraph","inlineContent":[{"text":"[func","type":"text"},{"type":"codeVoice","code":"GLib.get_system_config_dirs"},{"type":"text","text":"]"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"[func"},{"code":"GLib.get_user_config_dir","type":"codeVoice"},{"type":"text","text":"]"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"[func"},{"code":"GLib.get_system_data_dirs","type":"codeVoice"},{"type":"text","text":"]"}]}]},{"content":[{"inlineContent":[{"type":"text","text":"[func"},{"type":"codeVoice","code":"GLib.get_user_data_dir"},{"type":"text","text":"]"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"type":"text","text":"[func"},{"type":"codeVoice","code":"GLib.get_user_state_dir"},{"type":"text","text":"]"}],"type":"paragraph"}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"[func"},{"code":"GLib.get_user_runtime_dir","type":"codeVoice"},{"type":"text","text":"]"}]}]}]},{"inlineContent":[{"text":"The subdirectories may not be created by the test harness; as with normal","type":"text"},{"type":"text","text":" "},{"text":"calls to functions like [func","type":"text"},{"type":"codeVoice","code":"GLib.get_user_cache_dir"},{"text":"], the caller must","type":"text"},{"type":"text","text":" "},{"text":"be prepared to create the directory if it doesn’t exist.","type":"text"},{"type":"text","text":" "},{"type":"strong","inlineContent":[{"text":"TEST_OPTION_ISOLATE_DIRS is deprecated:","type":"text"}]},{"text":" ","type":"text"},{"text":"Use ","type":"text"},{"isActive":true,"type":"reference","identifier":"doc:\/\/GLib\/documentation\/GLib\/testOptionIsolateDirs"},{"text":" instead.","type":"text"}],"type":"paragraph"}],"kind":"content"}],"sections":[],"metadata":{"title":"TEST_OPTION_ISOLATE_DIRS","roleHeading":"Global Variable","symbolKind":"var","fragments":[{"text":"let","kind":"keyword"},{"text":" ","kind":"text"},{"text":"TEST_OPTION_ISOLATE_DIRS","kind":"identifier"},{"text":": ","kind":"text"},{"text":"String","kind":"typeIdentifier","preciseIdentifier":"s:SS"}],"platforms":[],"role":"symbol","externalID":"s:4GLib24TEST_OPTION_ISOLATE_DIRSSSvp","modules":[{"name":"GLib"}]},"schemaVersion":{"patch":0,"minor":3,"major":0},"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/glib\/test_option_isolate_dirs"]}],"identifier":{"interfaceLanguage":"swift","url":"doc:\/\/GLib\/documentation\/GLib\/TEST_OPTION_ISOLATE_DIRS"},"references":{"doc://GLib/documentation/GLib/TEST_OPTION_ISOLATE_DIRS":{"deprecated":true,"url":"\/documentation\/glib\/test_option_isolate_dirs","abstract":[{"type":"text","text":"A value that can be passed as an option to [func"},{"type":"codeVoice","code":"GLib.test_init"},{"type":"text","text":"]."}],"identifier":"doc:\/\/GLib\/documentation\/GLib\/TEST_OPTION_ISOLATE_DIRS","type":"topic","kind":"symbol","role":"symbol","title":"TEST_OPTION_ISOLATE_DIRS","fragments":[{"kind":"keyword","text":"let"},{"text":" ","kind":"text"},{"text":"TEST_OPTION_ISOLATE_DIRS","kind":"identifier"},{"text":": ","kind":"text"},{"text":"String","kind":"typeIdentifier","preciseIdentifier":"s:SS"}]},"doc://GLib/documentation/GLib":{"identifier":"doc:\/\/GLib\/documentation\/GLib","title":"GLib","abstract":[],"type":"topic","url":"\/documentation\/glib","kind":"symbol","role":"collection"},"doc://GLib/documentation/GLib/testOptionIsolateDirs":{"role":"symbol","type":"topic","identifier":"doc:\/\/GLib\/documentation\/GLib\/testOptionIsolateDirs","kind":"symbol","url":"\/documentation\/glib\/testoptioni