ill be used.","type":"text"}]},{"type":"paragraph","inlineContent":[{"text":"If you try to remove an application by setting its registration count to","type":"text"},{"text":" ","type":"text"},{"text":"zero, and no bookmark for ","type":"text"},{"code":"uri","type":"codeVoice"},{"type":"text","text":" is found, "},{"type":"codeVoice","code":"false"},{"type":"text","text":" is returned and"},{"type":"text","text":" "},{"code":"error","type":"codeVoice"},{"type":"text","text":" is set to "},{"type":"codeVoice","code":"uriNotFound"},{"text":"; similarly,","type":"text"},{"type":"text","text":" "},{"text":"in the event that no application ","type":"text"},{"code":"name","type":"codeVoice"},{"text":" has registered a bookmark","type":"text"},{"type":"text","text":" "},{"text":"for ","type":"text"},{"type":"codeVoice","code":"uri"},{"text":",  ","type":"text"},{"code":"false","type":"codeVoice"},{"type":"text","text":" is returned and error is set to"},{"type":"text","text":" "},{"code":"appNotRegistered","type":"codeVoice"},{"text":".  Otherwise, if no bookmark","type":"text"},{"type":"text","text":" "},{"text":"for ","type":"text"},{"code":"uri","type":"codeVoice"},{"type":"text","text":" is found, one is created."}]},{"type":"paragraph","inlineContent":[{"inlineContent":[{"type":"text","text":"set_app_info is deprecated:"}],"type":"strong"},{"type":"text","text":" "},{"text":"Use g_bookmark_file_set_application_info() instead, as","type":"text"},{"type":"text","text":" "},{"type":"codeVoice","code":"time_t"},{"type":"text","text":" is deprecated due to the year 2038 problem."}]}],"kind":"content"}],"schemaVersion":{"major":0,"minor":3,"patch":0},"identifier":{"url":"doc:\/\/GLib\/documentation\/GLib\/BookmarkFileRef\/setAppInfo(uri:name:exec:count:stamp:)","interfaceLanguage":"swift"},"metadata":{"title":"setAppInfo(uri:name:exec:count:stamp:)","role":"symbol","symbolKind":"method","extendedModule":"GLib","modules":[{"name":"GLib"}],"fragments":[{"text":"func","kind":"