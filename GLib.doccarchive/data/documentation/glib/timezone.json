{"schemaVersion":{"patch":0,"major":0,"minor":3},"variants":[{"paths":["\/documentation\/glib\/timezone"],"traits":[{"interfaceLanguage":"swift"}]}],"identifier":{"url":"doc:\/\/GLib\/documentation\/GLib\/TimeZone","interfaceLanguage":"swift"},"hierarchy":{"paths":[["doc:\/\/GLib\/documentation\/GLib"]]},"primaryContentSections":[{"kind":"declarations","declarations":[{"tokens":[{"kind":"keyword","text":"class"},{"kind":"text","text":" "},{"kind":"identifier","text":"TimeZone"}],"languages":["swift"],"platforms":["macOS"]}]},{"kind":"content","content":[{"anchor":"overview","level":2,"type":"heading","text":"Overview"},{"type":"paragraph","inlineContent":[{"type":"text","text":"The "},{"type":"codeVoice","code":"GTimeZone"},{"text":" struct is refcounted and immutable.","type":"text"}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"Each time zone has an identifier (for example, ‘Europe\/London’) which is"},{"text":" ","type":"text"},{"type":"text","text":"platform dependent. See [ctor"},{"type":"codeVoice","code":"GLib.TimeZone.new"},{"text":"] for information on the","type":"text"},{"type":"text","text":" "},{"text":"identifier formats. The identifier of a time zone can be retrieved using","type":"text"},{"type":"text","text":" "},{"type":"text","text":"[method"},{"type":"codeVoice","code":"GLib.TimeZone.get_identifier"},{"text":"].","type":"text"}]},{"type":"paragraph","inlineContent":[{"text":"A time zone contains a number of intervals. Each interval has an abbreviation","type":"text"},{"text":" ","type":"text"},{"text":"to describe it (for example, ‘PDT’), an offset to UTC and a flag indicating","type":"text"},{"text":" ","type":"text"},{"type":"text","text":"if the daylight savings time is in effect during that interval. A time zone"},{"type":"text","text":" "},{"type":"text","text":"always has at least one interval — interval 0. Note that interval abbreviations"},{"text":" ","type":"text"},{"text":"are not the same as time zone identifiers (apart from ‘UTC’), and cannot be","type":"text"},{"text":" ","type":"text"},{"text":"passed to [ctor","type":"text"},{"code":"GLib.TimeZone.new","type":"codeVoice"},{"type":"text","text":"]."}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"Every UTC time is contained within exactly one interval, but a given"},{"type":"text","text":" "},{"text":"local time may be contained within zero, one or two intervals (due to","type":"text"},{"type":"text","text":" "},{"text":"incontinuities associated with daylight savings time).","type":"text"}]},{"inlineContent":[{"type":"text","text":"An interval may refer to a specific period of time (eg: the duration"},{"type":"text","text":" "},{"type":"text","text":"of daylight savings time during 2010) or it may refer to many periods"},{"type":"text","text":" "},{"text":"of time that share the same properties (eg: all periods of daylight","type":"text"},{"type":"text","text":" "},{"text":"savings time).  It is also possible (usually for political reasons)","type":"text"},{"text":" ","type":"text"},{"type":"text","text":"that some properties (like the abbreviation) change between intervals"},{"text":" ","type":"text"},{"text":"without other properties changing.","type":"text"}],"type":"paragraph"},{"type":"paragraph","inlineContent":[{"type":"text","text":"The "},{"type":"reference","identifier":"doc:\/\/GLib\/documentation\/GLib\/TimeZone","isActive":true},{"type":"text","text":" type acts as a reference-counted owner of an underlying "},{"type":"codeVoice","code":"GTimeZone"},{"type":"text","text":" instance."},{"text":" ","type":"text"},{"type":"text","text":"It provides the methods that can operate on this data type through "},{"type":"reference","identifier":"doc:\/\/GLib\/documentation\/GLib\/TimeZoneProtocol","isActive":true},{"type":"text","text":" conformance."},{"type":"text","text":" "},{"text":"Use ","type":"text"},{"type":"reference","isActive":true,"identifier":"doc:\/\/GLib\/documentation\/GLib\/TimeZone"},{"type":"text","text":" as a strong reference or owner of a "},{"type":"codeVoice","code":"GTimeZone"},{"type":"text","text":" instance."}]},{"type":"aside","content":[{"inlineContent":[{"text":"Use ","type":"text"},{"identifier":"doc:\/\/GLib\/documentation\/GLib\/TimeZoneRef","isActive":true,"type":"reference"},{"type":"text","text":" (instead of "},{"type":"reference","identifier":"doc:\/\/GLib\/documentation\/GLib\/TimeZone","isActive":true},{"type":"text","text":") for a lightweight Swift reference to an underlying "},{"type":"codeVoice","code":"GTimeZone"},{"text":" instance.","type":"text"}],"type":"paragraph"}],"name":"Note","style":"note"}]}],"sections":[],"metadata":{"externalID":"s:4GLib8TimeZoneC","title":"TimeZone","role":"symbol","fragments":[{"kind":"keyword","text":"class"},{"kind":"text","text":" "},{"kind":"identifier","text":"TimeZone"}],"navigatorTitle":[{"text":"TimeZone","kind":"identifier"}],"symbolKind":"class","roleHeading":"Class","modules":[{"name":"GLib"}]},"abstract":[{"text":"A ","type":"text"},{"code":"GTimeZone","type":"codeVoice"},{"type":"text","text":" represents a time zone, at no particular point in time."}],"topicSections":[{"anchor":"Initializers","generated":true,"title":"Initializers","identifiers":["doc:\/\/GLib\/documentation\/GLib\/TimeZone\/init(_:)-3m8y2","doc:\/\/GLib\/documentation\/GLib\/TimeZone\/init(_:)-6hi6j","doc:\/\/GLib\/documentation\/GLib\/TimeZone\/init(_:)-8wflv","doc:\/\/GLib\/documentation\/GLib\/TimeZone\/init(_:)-9sndc","doc:\/\/GLib\/documentation\/GLib\/TimeZone\/init(_:)-fwfq","doc:\/\/GLib\/documentation\/GLib\/TimeZone\/init(cPointer:)","doc:\/\/GLib\/documentation\/GLib\/TimeZone\/init(gconstpointer:)","doc:\/\/GLib\/documentation\/GLib\/TimeZone\/init(gpointer:)","doc:\/\/GLib\/documentation\/GLib\/TimeZone\/init(identiferOrUtc:)","doc:\/\/GLib\/documentation\/GLib\/TimeZone\/init(identifier:)","doc:\/\/GLib\/documentation\/GLib\/TimeZone\/init(offset:)","doc:\/\/GLib\/documentation\/GLib\/TimeZone\/in