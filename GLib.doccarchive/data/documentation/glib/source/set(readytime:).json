{"sections":[],"identifier":{"interfaceLanguage":"swift","url":"doc:\/\/GLib\/documentation\/GLib\/Source\/set(readyTime:)"},"abstract":[{"type":"text","text":"Sets a source to be dispatched when the given monotonic time is"},{"text":" ","type":"text"},{"text":"reached (or passed).","type":"text"}],"metadata":{"extendedModule":"GLib","role":"symbol","externalID":"s:4GLib14SourceProtocolPAAE3set9readyTimeys5Int64V_tF::SYNTHESIZED::s:4GLib6SourceC","symbolKind":"method","title":"set(readyTime:)","modules":[{"name":"GLib"}],"fragments":[{"text":"func","kind":"keyword"},{"text":" ","kind":"text"},{"text":"set","kind":"identifier"},{"text":"(","kind":"text"},{"text":"readyTime","kind":"externalParam"},{"text":": ","kind":"text"},{"kind":"typeIdentifier","text":"gint64","preciseIdentifier":"c:@T@gint64"},{"kind":"text","text":")"}],"roleHeading":"Instance Method"},"kind":"symbol","hierarchy":{"paths":[["doc:\/\/GLib\/documentation\/GLib","doc:\/\/GLib\/documentation\/GLib\/Source","doc:\/\/GLib\/documentation\/GLib\/Source\/SourceProtocol-Implementations"]]},"primaryContentSections":[{"kind":"declarations","declarations":[{"tokens":[{"text":"func","kind":"keyword"},{"text":" ","kind":"text"},{"kind":"identifier","text":"set"},{"text":"(","kind":"text"},{"text":"readyTime","kind":"externalParam"},{"text":": ","kind":"text"},{"text":"gint64","preciseIdentifier":"c:@T@gint64","kind":"typeIdentifier"},{"text":")","kind":"text"}],"platforms":["macOS"],"languages":["swift"]}]},{"kind":"content","content":[{"text":"Discussion","type":"heading","anchor":"discussion","level":2},{"type":"paragraph","inlineContent":[{"type":"text","text":"If the monotonic time is in the past (as it"},{"type":"text","text":" "},{"text":"always will be if ","type":"text"},{"type":"codeVoice","code":"readyTime"},{"text":" is ","type":"text"},{"code":"0","type":"codeVoice"},{"type":"text","text":") then the source will be"},{"type":"text","text":" "},{"type":"text","text":"dispatched immediately."}]},{"type":"paragraph","inlineContent":[{"text":"If ","type":"text"},{"code":"readyTime","type":"codeVoice"},{"text":" is ","type":"text"},{"code":"-1","type":"codeVoice"},{"type":"text","text":" then the source is never woken up on the basis"},{"type":"text","text":" "},{"text":"of the passage of time.","type":"text"}]},{"inlineContent":[{"type":"text","text":"Dispatching the source does not reset the ready time.  You should do"},{"type":"text","text":" "},{"type":"text","text":"so yourself, from the source dispatch function."}],"type":"paragraph"},{"type":"paragraph","inlineContent":[{"type":"text","text":"Note that if you have a pair of sources where the ready time of one"},{"type":"text","text":" "},{"type":"text","text":"suggests that it will be delivered first but the priority for the"},{"type":"text","text":" "},{"text":"other suggests that it would be delivered first, and the ready time","type":"text"},{"text":" ","type":"text"},{"text":"for both sources is reached during the same main context iteration,","type":"text"},{"text":" ","type":"text"},{"type":"text","text":"then the order of dispatch is undefined."}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"It is a no-op to call this function on a [struct"},{"isActive":true,"identifier":"doc:\/\/GLib\/documentation\/GLib\/Source","type":"reference"},{"text":"] which has","type":"text"},{"type":"text","text":" "},{"type":"text","text":"already been destroyed with [method"},{"type":"codeVoice","code":"GLib.Source.destroy"},{"type":"text","text":"]."}]},{"type":"paragraph","inlineContent":[{"text":"This API is only intended to be used by implementations of [struct","type":"text"},{"isActive":true,"type":"reference","identifier":"doc:\/\/GLib\/documentation\/GLib\/Source"},{"type":"text","text":"]."},{"type":"text","text":" "},{"text":"Do not call this API on a [struct","type":"text"},{"identifier":"doc:\/\/GLib\/documentation\/GLib\/Source","type":"reference","isActive":true},{"type":"text","text":"] that you did not create."}]}]}],"variants":[{"paths":["\/documentation\/glib\/source\/set(readytime:)"],"traits":[{"interfaceLanguage":"swift"}]}],"schemaVersion":{"major":0,"minor":3,"patch":0},"references":{"doc://GLib/documentation/GLib":{"identifier":"doc:\/\/GLib\/documentation\/GLib","title":"GLib","abstract":[],"type":"topic","url":"\/documentation\/glib","kind":"symbol","role":"collection"},"doc://GLib/documentation/GLib/Source/SourceProtocol-Implementations":{"abstract":[],"url":"\/documentation\/glib\/source\/sourceprotocol-implementations","identifier":"doc:\/\/GLib\/documentation\/GLib\/Source\/SourceProtocol-Implementations","title":"SourceProtocol Implementations","role":"collectionGroup","type":"topic","kind":"article"},"doc://GLib/documentation/GLib/Source/set(readyTime:)":{"title":"set(readyTime:)","role":"symbol","url":"\/documentation\/glib\/source\/set(readytime:)","fragments":[{"text":"func","kind":"keyword"},{"kind":"text","text":" "},{"text":"set","kind":"identifier"},{"kind":"text","text":"("},{"text":"readyTime","kind":"externalParam"},{"kind":"text","text":": "},{"kind":"typeIdentifier","preciseIdentifier":"c:@T@gint64","text":"gint64"},{"kind":"text","text":")"}],"identifier":"doc:\/\/GLib\/documentation\/GLib\/Source\/set(readyTime:)","kind":"symbol","abstract":[{"text":"Sets a source to be dispatched when the given monotonic time is","type":"text"},{"type":"text","text":" "},{"text":"reached (or passed).","type":"text"}],"type":"topic"},"doc://GLib/documentation/GLib/Source":{"url":"\/documentation\/glib\/source","role":"symbol","abstract":[{"type":"text","text":"The "},{"type":"codeVoice","code":"GSource"},{"text":" struct is an opaque data type","type":"text"},{"text":" ","type":"text"},{"text":"representing an event source.","type":"text"}],"title":"Source","fragments":[{"text":"class","kind":"keyword"},{"kind":"text","text":" "},{"kind":"identifier","text":"Source"}],"type":"topic","kind":"symbol","identifier":"doc:\/\/GLib\/document