ext":" ","kind":"text"},{"kind":"identifier","text":"sourceContinue"},{"text":": ","kind":"text"},{"preciseIdentifier":"c:@T@gboolean","kind":"typeIdentifier","text":"gboolean"}],"type":"topic","url":"\/documentation\/glib\/sourcecontinue"},"doc://GLib/documentation/GLib/SourceFuncsRef/dispatch":{"abstract":[{"type":"text","text":"Called to dispatch the event source, after it has returned"},{"text":" ","type":"text"},{"type":"codeVoice","code":"true"},{"text":" in either its ","type":"text"},{"type":"codeVoice","code":"prepare"},{"type":"text","text":" or its "},{"type":"codeVoice","code":"check"},{"type":"text","text":" function, or if a ready time"},{"text":" ","type":"text"},{"text":"has been reached. The ","type":"text"},{"type":"codeVoice","code":"dispatch"},{"text":" function receives a callback function and","type":"text"},{"type":"text","text":" "},{"text":"user data. The callback function may be ","type":"text"},{"type":"codeVoice","code":"nil"},{"text":" if the source was never","type":"text"},{"text":" ","type":"text"},{"type":"text","text":"connected to a callback using [method"},{"type":"codeVoice","code":"GLib.Source.set_callback"},{"text":"]. The","type":"text"},{"text":" ","type":"text"},{"code":"dispatch","type":"codeVoice"},{"text":" function should call the callback function with ","type":"text"},{"type":"codeVoice","code":"user_data"},{"type":"text","text":" and"},{"text":" ","type":"text"},{"text":"whatever additional parameters are needed for this type of event source.","type":"text"},{"type":"text","text":" "},{"text":"The return value of the ","type":"text"},{"type":"codeVoice","code":"dispatch"},{"text":" function should be","type":"text"},{"type":"text","text":" "},{"type":"text","text":"[const"},{"identifier":"doc:\/\/GLib\/documentation\/GLib\/sourceRemove","type":"reference","isActive":true},{"text":"] if the source should be removed or","type":"text"},{"type":"text","text":" "},{"text":"[const","type":"text"},{"isActive":true,"type":"reference","identifier":"doc:\/\/GLib\/documentation\/GLib\/sourceContinue"},{"type":"text","text":"] to keep it."}],"type":"topic","url":"\/documentation\/glib\/sourcefuncsref\/dispatch","title":"dispatch","identifier":"doc:\/\/GLib\/documentation\/GLib\/SourceFuncsRef\/dispatch","kind":"symbol","role":"symbol","fragments":[{"kind":"keyword","text":"var"},{"kind":"text","text":" "},{"text":"dispatch","kind":"identifier"},{"kind":"text","text":": "},{"kind":"typeIdentifier","text":"GSourceFuncsDispatchFunc","preciseIdentifier":"c:@T@GSourceFuncsDispatchFunc"},{"text":"!","kind":"text"}]},"doc://GLib/documentation/GLib/SourceFuncsRef/sourceRemoveByFuncs(userData:)":{"fragments":[{"text":"func","kind":"keyword"},{"kind":"text","text":" "},{"kind":"identifier","text":"sourceRemoveByFuncs"},{"text":"(","kind":"text"},{"kind":"externalParam","text":"userData"},{"kind":"text","text":": "},{"text":"gpointer","preciseIdentifier":"c:@T@gpointer","kind":"typeIdentifier"},{"text":"?) -> ","kind":"text"},{"kind":"typeIdentifier","preciseIdentifier":"s:Sb","text":"Bool"}],"kind":"symbol","abstract":[{"text":"Removes a source from the default main loop context given the","type":"text"},{"type":"text","text":" "},{"type":"text","text":"source functions and user data."}],"title":"sourceRemoveByFuncs(userData:)","identifier":"doc:\/\/GLib\/documentation\/GLib\/SourceFuncsRef\/sourceRemoveByFuncs(userData:)","url":"\/documentation\/glib\/sourcefuncsref\/sourceremovebyfuncs(userdata:)","type":"topic","role":"symbol"},"doc://GLib/documentation/GLib/SourceFuncsRef/finalize":{"fragments":[{"text":"var","kind":"keyword"},{"kind":"text","text":" "},{"kind":"identifier","text":"finalize"},{"text":": ","kind":"text"},{"preciseIdentifier":"c:@T@GSourceFuncsFinalizeFunc","text":"GSourceFuncsFinalizeFunc","kind":"typeIdentifier"},{"text":"!","kind":"text"}],"title":"finalize","type":"topic","abstract":[{"type":"text","text":"Called when the source is finalized. At this point,"},{"type":"text","text":" "},{"text":"the source will have been destroyed, had its callback cleared, and have","type":"text"},{"type":"text","text":" "},{"text":"been removed from its [struct","type":"text"},{"type":"reference","identifier":"doc:\/\/GLib\/documentation\/GLib\/MainContext","isActive":true},{"text":"], but it will still have","type":"text"},{"type":"text","text":" "},{"type":"text","text":"its final reference count, so methods can be called on it from within"},{"type":"text","text":" "},{"type":"text","text":"this function. This may be "},{"code":"nil","type":"codeVoice"},{"type":"text","text":", in which case the effect is as if the"},{"type":"text","text":" "},{"text":"function does nothing and returns.","type":"text"}],"url":"\/documentation\/glib\/sourcefuncsref\/finalize","kind":"symbol","role":"symbol","identifier":"doc:\/\/GLib\/documentation\/GLib\/SourceFuncsRef\/finalize"},"doc://GLib/documentation/GLib/sourceRemove":{"identifier":"doc:\/\/GLib\/documentation\/GLib\/sourceRemove","fragments":[{"text":"let","kind":"keyword"},{"kind":"text","text":" "},{"text":"sourceRemove","kind":"identifier"},{"kind":"text","text":": "},{"kind":"typeIdentifier","preciseIdentifier":"s:s5Int32V","text":"Int32"}],"abstract":[{"type":"text","text":"Use this macro as the return value of a [callback"},{"isActive":true,"type":"reference","identifier":"doc:\/\/GLib\/documentation\/GLib\/SourceFunc"},{"type":"text","text":"] to remove"},{"type":"text","text":" "},{"text":"the [struct","type":"text"},{"isActive":true,"type":"reference","identifier":"doc:\/\/GLib\/documentation\/GLib\/Source"},{"type":"text","text":"] from the main loop."}],"type":"topic","title":"sourceRemove","kind":"symbol","role":"symbol","url":"\/documentation\/glib\/sourceremove"},"doc://GLib/documentation/GLib/SourceFuncsRef":{"identifier":"doc:\/\/GLib\/documentation\/GLib\/SourceFuncsRef","abstract":[{"text":"The ","type":"text"},{"code":"GSourceFuncs","type":"codeVoice"},{"type":"text","text":" struct contains a table of"},{"type":"text","text":" "},{"text":"functions used to handle event sources in a generic manner.","type":"text"}],"title":"SourceFuncsRef","role":"symbol","navigatorTitle":[{"text":"SourceFuncsRef","kind":"identifier"}],"kind":"symbol","fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"kind":"identifier","text":"SourceFuncsRef"}],"type":"topic","url":"\/documentation\/glib\/sourcefuncsref"},"doc://GLib/documentation/GLib/SourceFuncsRef/check":{"type":"topic","fragments":[{"kind":"keyword","text":"var"},{"kind":"text","text":" "},{"text":"check","kind":"identifier"},{"kind":"text","text":": "},{"preciseIdentifier":"c:@T@GSourceFuncsCheckFunc","kind":"typeIdentifier","text":"GSourceFuncsCheckFunc"},{"kind":"text","text":"!"}],"title":"check","identifier":"doc:\/\/GLib\/documentation\/GLib\/SourceFuncsRef\/check","kind":"symbol","url":"\/documentation\/glib\/sourcefuncsref\/check","abstract":[{"type":"text","text":"Called after all the file descriptors are polled. The"},{"type":"text","text":" "},{"text":"source should return ","type":"text"},{"type":"codeVoice","code":"true"},{"text":" if it is ready to be dispatched. Note that","type":"text"},{"type":"text","text":" "},{"type":"text","text":"some time may have passed since the previous prepare function was called,"},{"type":"text","text":" "},{"text":"so the source should be checked again here.  Since 2.36 this may","type":"text"},{"text":" ","type":"text"},{"type":"text","text":"be "},{"type":"codeVoice","code":"nil"},{"type":"text","text":", in which case the effect is as if the function always returns"},{"type":"text","text":" "},{"type":"codeVoice","code":"false"},{"type":"text","text":"."}],"role":"symbol"},"doc://GLib/documentation/GLib/SourceFuncsRef/prepare":{"type":"topic","abstract":[{"text":"Called before all the file descriptors are polled. If","type":"text"},{"type":"text","text":" "},{"type":"text","text":"the source can determine that it is ready here (without waiting for the"},{"text":" ","type":"text"},{"type":"text","text":"results of the "},{"type":"codeVoice","code":"poll()"},{"type":"text","text":" call) it should return "},{"type":"codeVoice","code":"true"},{"text":". It can also return","type":"text"},{"type":"text","text":" "},{"text":"a ","type":"text"},{"type":"codeVoice","code":"timeout_"},{"text":" value which should be the maximum timeout (in milliseconds)","type":"text"},{"type":"text","text":" "},{"type":"text","text":"which should be passed to the "},{"type":"codeVoice","code":"poll()"},{"type":"text","text":" call. The actual timeout used will"},{"text":" ","type":"text"},{"type":"text","text":"be -1 if all sources returned -1, or it will be the minimum of all"},{"text":" ","type":"text"},{"text":"the ","type":"text"},{"code":"timeout_","type":"codeVoice"},{"type":"text","text":" values returned which were >= 0.  Since 2.36 this may"},{"text":" ","type":"text"},{"text":"be ","type":"text"},{"type":"codeVoice","code":"nil"},{"type":"text","text":", in which case the effect is as if the function always returns"},{"text":" ","type":"text"},{"code":"false","type":"codeVoice"},{"text":" with a timeout of -1.  If ","type":"text"},{"code":"prepare","type":"codeVoice"},{"type":"text","text":" returns a"},{"text":" ","type":"text"},{"text":"timeout and the source also has a ready time set, then the","type":"text"},{"type":"text","text":" "},{"type":"text","text":"lower of the two will be used."}],"title":"prepare","url":"\/documentation\/glib\/sourcefuncsref\/prepare","identifier":"doc:\/\/GLib\/documentation\/GLib\/SourceFuncsRef\/prepare","kind":"symbol","role":"symbol","fragments":[{"text":"var","kind":"keyword"},{"text":" ","kind":"text"},{"kind":"identifier","text":"prepare"},{"kind":"text","text":": "},{"preciseIdentifier":"c:@T@GSourceFuncsPrepareFunc","text":"GSourceFuncsPrepareFunc","kind":"typeIdentifier"},{"kind":"text","text":"!"}]},"doc://GLib/documentation/GLib/MainContext":{"title":"MainContext","identifier":"doc:\/\/GLib\/documentation\/GLib\/MainContext","fragments":[{"kind":"keyword","text":"class"},{"kind":"text","text":" "},{"kind":"identifier","text":"MainContext"}],"url":"\/documentation\/glib\/maincontext","navigatorTitle":[{"kind":"identifier","text":"MainContext"}],"kind":"symbol","type":"topic","role":"symbol","abstract":[{"type":"text","text":"The "},{"code":"GMainContext","type":"codeVoice"},{"text":" struct is an opaque data","type":"text"},{"text":" ","type":"text"},{"type":"text","text":"type representing a set of sources to be handled in a main loop."}]}}}