{"schemaVersion":{"patch":0,"major":0,"minor":3},"identifier":{"url":"doc:\/\/GLib\/documentation\/GLib\/SourceFuncsProtocol","interfaceLanguage":"swift"},"abstract":[{"type":"text","text":"The "},{"type":"codeVoice","code":"GSourceFuncs"},{"text":" struct contains a table of","type":"text"},{"text":" ","type":"text"},{"type":"text","text":"functions used to handle event sources in a generic manner."}],"topicSections":[{"identifiers":["doc:\/\/GLib\/documentation\/GLib\/SourceFuncsProtocol\/check","doc:\/\/GLib\/documentation\/GLib\/SourceFuncsProtocol\/dispatch","doc:\/\/GLib\/documentation\/GLib\/SourceFuncsProtocol\/finalize","doc:\/\/GLib\/documentation\/GLib\/SourceFuncsProtocol\/prepare"],"anchor":"Instance-Properties","generated":true,"title":"Instance Properties"},{"identifiers":["doc:\/\/GLib\/documentation\/GLib\/SourceFuncsProtocol\/sourceRemoveByFuncs(userData:)"],"anchor":"Instance-Methods","generated":true,"title":"Instance Methods"}],"hierarchy":{"paths":[["doc:\/\/GLib\/documentation\/GLib"]]},"metadata":{"modules":[{"name":"GLib"}],"fragments":[{"kind":"keyword","text":"protocol"},{"text":" ","kind":"text"},{"text":"SourceFuncsProtocol","kind":"identifier"}],"symbolKind":"protocol","title":"SourceFuncsProtocol","externalID":"s:4GLib19SourceFuncsProtocolP","role":"symbol","roleHeading":"Protocol","navigatorTitle":[{"kind":"identifier","text":"SourceFuncsProtocol"}]},"kind":"symbol","relationshipsSections":[{"title":"Inherits From","type":"inheritsFrom","kind":"relationships","identifiers":["doc:\/\/GLib\/documentation\/GLib\/PointerWrapper"]},{"type":"conformingTypes","identifiers":["doc:\/\/GLib\/documentation\/GLib\/SourceFuncs","doc:\/\/GLib\/documentation\/GLib\/SourceFuncsRef"],"title":"Conforming Types","kind":"relationships"}],"primaryContentSections":[{"kind":"declarations","declarations":[{"languages":["swift"],"tokens":[{"text":"protocol","kind":"keyword"},{"kind":"text","text":" "},{"text":"SourceFuncsProtocol","kind":"identifier"},{"kind":"text","text":" : "},{"kind":"typeIdentifier","preciseIdentifier":"s:4GLib14PointerWrapperP","text":"PointerWrapper","identifier":"doc:\/\/GLib\/documentation\/GLib\/PointerWrapper"}],"platforms":["macOS"]}]},{"content":[{"text":"Overview","type":"heading","anchor":"overview","level":2},{"type":"paragraph","inlineContent":[{"text":"For idle sources, the prepare and check functions always return ","type":"text"},{"code":"true","type":"codeVoice"},{"text":" ","type":"text"},{"text":"to indicate that the source is always ready to be processed. The prepare","type":"text"},{"text":" ","type":"text"},{"text":"function also returns a timeout value of 0 to ensure that the ","type":"text"},{"type":"codeVoice","code":"poll()"},{"text":" call","type":"text"},{"type":"text","text":" "},{"text":"doesn’t block (since that would be time wasted which could have been spent","type":"text"},{"text":" ","type":"text"},{"type":"text","text":"running the idle function)."}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"For timeout sources, the prepare and check functions both return "},{"type":"codeVoice","code":"true"},{"type":"text","text":" "},{"type":"text","text":"if the timeout interval has expired. The prepare function also returns"},{"type":"text","text":" "},{"type":"text","text":"a timeout value to ensure that the "},{"code":"poll()","type":"codeVoice"},{"type":"text","text":" call doesn’t block too long"},{"type":"text","text":" "},{"type":"text","text":"and miss the next timeout."}]},{"inlineContent":[{"type":"text","text":"For file descriptor sources, the prepare function typically returns "},{"type":"codeVoice","code":"false"},{"type":"text","text":","},{"text":" ","type":"text"},{"text":"since it must wait until ","type":"text"},{"type":"codeVoice","code":"poll()"},{"type":"text","text":" has been called before it knows whether"},{"text":" ","type":"text"},{"type":"text","text":"any events need to be processed. It sets the returned timeout to -1 to"},{"type":"text","text":" "},{"text":"indicate that it doesn’t mind how long the ","type":"text"},{"code":"poll()","type":"codeVoice"},{"text":" call blocks. In the","type":"text"},{"type":"text","text":" "},{"text":"check function, it tests the results of the ","type":"text"},{"type":"codeVoice","code":"poll()"},{"type":"text","text":" call to see if the"},{"text":" ","type":"text"},{"type":"text","text":"required condition has been met, and returns "},{"type":"codeVoice","code":"true"},{"type":"text","text":" if so."}],"type":"paragraph"},{"type":"paragraph","inlineContent":[{"type":"text","text":"The "},{"identifier":"doc:\/\/GLib\/documentation\/GLib\/SourceFuncsProtocol","type":"reference","isActive":true},{"type":"text","text":" protocol exposes the methods and properties of an underlying "},{"code":"GSourceFuncs","type":"codeVoice"},{"type":"text","text":" instance."},{"type":"text","text":" "},{"type":"text","text":"The default implementation of these can be found in the protocol extension below."},{"type":"text","text":" "},{"type":"text","text":"For a concrete class that implements these methods and properties, see "},{"type":"reference","identifier":"doc:\/\/GLib\/documentation\/GLib\/SourceFuncs","isActive":true},{"type":"text","text":"."},{"type":"text","text":" "},{"type":"text","text":"Alternatively, use "},{"isActive":true,"identifier":"doc:\/\/GLib\/documentation\/GLib\/SourceFuncsRef","type":"reference"},{"text":" as a lighweight, ","type":"text"},{"code":"unowned","type":"codeVoice"},{"type":"text","text":" reference if you already have an instance you just want to use."}]}],"kind":"content"}],"sections":[],"variants":[{"paths":["\/documentation\/glib\/sourcefuncsprotocol"],"traits":[{"interfaceLanguage":"swift"}]}],"references":{"doc://GLib/documentation/GLib/MainContext":{"title":"MainContext","identifier":"doc:\/\/GLib\/documentation\/GLib\/MainContext","fragments":[{"kind":"keyword","text":"class"},{"kind":"text","text":" "},{"kind":"identifier","text":"MainContext"}],"url":"\/documentation\/glib\/maincontext","navigatorTitle":[{"kind":"identifier","text":"MainContext"}],"kind":"symbol","type":"topic","role":"symbol","abstract":[{"type":"text","text":"The "},{"code":"GMainContext","type":"codeVoice"},{"text":" struct is an opaque data","type":"text"},{"text":" ","type":"text"},{"type":"text","text":"type representing a set of sources to be handled in a main loop."}]},"doc://GLib/documentation/GLib/SourceFuncsRef":{"identifier":"doc:\/\/GLib\/documentation\/GLib\/SourceFuncsRef","abstract":[{"text":"The ","type":"text"},{"code":"GSourceFuncs","type":"codeVoice"},{"type":"text","text":" struct contains a table of"},{"type":"text","text":" "},{"text":"functions used to handle event sources in a generic manner.","type":"text"}],"title":"SourceFuncsRef","role":"symbol","navigatorTitle":[{"text":"SourceFuncsRef","kind":"identifier"}],"kind":"symbol","fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"kind":"identifier","text":"SourceFuncsRef"}],"type":"topic","url":"\/documentation\/glib\/sourcefuncsref"},"doc://GLib/documentation/GLib/SourceFuncsProtocol/check":{"identifier":"doc:\/\/GLib\/documentation\/GLib\/SourceFuncsProtocol\/check","fragments":[{"kind":"keyword","text":"var"},{"text":" ","kind":"text"},{"text":"check","kind":"identifier"},{"kind":"text","text":": "},{"kind":"typeIdentifier","preciseIdentifier":"c:@T@GSourceFuncsCheckFunc","text":"GSourceFuncsCheckFunc"},{"text":"!","kind":"text"}],"abstract":[{"type":"text","text":"Called after all the file descriptors are polled. The"},{"text":" ","type":"text"},{"text":"source should return ","type":"text"},{"type":"codeVoice","code":"true"},{"text":" if it is ready to be dispatched. Note that","type":"text"},{"type":"text","text":" "},{"type":"text","text":"some time may have passed since the previous prepare function was called,"},{"text":" ","type":"text"},{"text":"so the source should be checked again here.  Since 2.36 this may","type":"text"},{"type":"text","text":" "},{"text":"be ","type":"text"},{"type":"codeVoice","code":"nil"},{"type":"text","text":", in which case the effect is as if the function always returns"},{"type":"text","text":" "},{"type":"codeVoice","code":"false"},{"type":"text","text":"."}],"type":"topic","title":"check","kind":"symbol","role":"symbol","url":"\/documentation\/glib\/sourcefuncsprotocol\/check"},"doc://GLib/documentation/GLib/sourceContinue":{"identifier":"doc:\/\/GLib\/documentation\/GLib\/sourceContinue","abstract":[{"type":"text","text":"Use this macro as the return value of a [callback"},{"type":"reference","identifier":"doc:\/\/GLib\/documentation\/GLib\/SourceFunc","isActive":true},{"type":"text","text":"] to leave"},{"type":"text","text":" "},{"type":"text","text":"the [struct"},{"type":"reference","identifier":"doc:\/\/GLib\/documentation\/GLib\/Source","isActive":true},{"type":"text","text":"] in the main loop."}],"title":"sourceContinue","role":"symbol","kind":"symbol","fragments":[{"text":"let","kind":"keyword"},{"text":" ","kind":"text"},{"kind":"identifier","text":"sourceContinue"},{"text":": ","kind":"text"},{"preciseIdentifier":"c:@T@gboolean","kind":"typeIdentifier","text":"gboolean"}],"type":"topic","url":"\/documentation\/glib\/sourcecontinue"},"doc://GLib/documentation/GLib/SourceFuncsProtocol/finalize":{"identifier":"doc:\/\/GLib\/documentation\/GLib\/SourceFuncsProtocol\/finalize","fragments":[{"kind":"keyword","text":"var"},{"text":" ","kind":"text"},{"kind":"identifier","text":"finalize"},{"kind":"text","text":": "},{"preciseIdentifier":"c:@T@GSourceFuncsFinalizeFunc","text":"GSourceFuncsFinalizeFunc","kind":"typeIdentifier"},{"text":"!","kind":"text"}],"abstract":[{"text":"Called when the source is finalized. At this point,","type":"text"},{"type":"text","text":" "},{"type":"text","text":"the source will have been destroyed, had its callback cleared, and have"},{"text":" ","type":"text"},{"text":"been removed from its [struct","type":"text"},{"type":"reference","identifier":"doc:\/\/GLib\/documentation\/GLib\/MainContext","isActive":true},{"text":"], but it will still have","type":"text"},{"type":"text","text":" "},{"type":"text","text":"its final reference count, so methods can be called on it from within"},{"type":"text","text":" "},{"type":"text","text":"this function. This may be "},{"type":"codeVoice","code":"nil"},{"type":"text","text":", in which case the effect is as if the"},{"text":" ","type":"text"},{"text":"function does nothing and returns.","type":"text"}],"type":"topic","title":"finalize","kind":"symbol","role":"symbol","url":"\/documentation\/glib\/sourcefuncsprotocol\/finalize"},"doc://GLib/documentation/GLib/SourceFuncs":{"identifier":"doc:\/\/GLib\/documentation\/GLib\/SourceFuncs","abstract":[{"text":"The ","type":"text"},{"code":"GSourceFuncs","type":"codeVoice"},{"type":"text","text":" struct contains a table of"},{"type":"text","text":" "},{"type":"text","text":"functions used to handle event sources in a generic manner."}],"title":"SourceFuncs","role":"symbol","navigatorTitle":[{"text":"SourceFuncs","kind":"identifier"}],"kind":"symbol","fragments":[{"kind":"keyword","text":"class"},{"kind":"text","text":" "},{"text":"SourceFuncs","kind":"identifier"}],"type":"topic","url":"\/documentation\/glib\/sourcefuncs"},"doc://GLib/documentation/GLib":{"identifier":"doc:\/\/GLib\/documentation\/GLib","title":"GLib","abstract":[],"type":"topic","url":"\/documentation\/glib","kind":"symbol","role":"collection"},"doc://GLib/documentation/GLib/SourceFuncsProtocol/prepare":{"identifier":"doc:\/\/GLib\/documentation\/GLib\/SourceFuncsProtocol\/prepare","fragments":[{"kind":"keyword","text":"var"},{"text":" ","kind":"text"},{"text":"prepare","kind":"identifier"},{"kind":"text","text":": "},{"preciseIdentifier":"c:@T@GSourceFuncsPrepareFunc","text":"GSourceFuncsPrepareFunc","kind":"typeIdentifier"},{"kind":"text","text":"!"}],"abstract":[{"type":"text","text":"Called before all the file descriptors are polled. If"},{"type":"text","text":" "},{"type":"text","text":"the source can determine that it is ready here (without waiting for the"},{"text":" ","type":"text"},{"type":"text","text":"results of the "},{"type":"codeVoice","code":"poll()"},{"type":"text","text":" call) it should return "},{"code":"true","type":"codeVoice"},{"text":". It can also return","type":"text"},{"type":"text","text":" "},{"text":"a ","type":"text"},{"code":"timeout_","type":"codeVoice"},{"type":"text","text":" value which should be the maximum timeout (in milliseconds)"},{"type":"text","text":" "},{"text":"which should be passed to the ","type":"text"},{"type":"codeVoice","code":"poll()"},{"text":" call. The actual timeout used will","type":"text"},{"type":"text","text":" "},{"text":"be -1 if all sources returned -1, or it will be the minimum of all","type":"text"},{"type":"text","text":" "},{"type":"text","text":"the "},{"code":"timeout_","type":"codeVoice"},{"type":"text","text":" values returned which were >= 0.  Since 2.36 this may"},{"type":"text","text":" "},{"text":"be ","type":"text"},{"type":"codeVoice","code":"nil"},{"type":"text","text":", in which case the effect is as if the function always returns"},{"text":" ","type":"text"},{"type":"codeVoice","code":"false"},{"text":" with a timeout of -1.  If ","type":"text"},{"code":"prepare","type":"codeVoice"},{"text":" returns a","type":"text"},{"type":"text","text":" "},{"type":"text","text":"timeout and the source also has a ready time set, then the"},{"text":" ","type":"text"},{"type":"text","text":"lower of the two will be used."}],"type":"topic","title":"prepare","kind":"symbol","role":"symbol","url":"\/documentation\/glib\/sourcefuncsprotocol\/prepare"},"doc://GLib/documentation/GLib/SourceFuncsProtocol/sourceRemoveByFuncs(userData:)":{"identifier":"doc:\/\/GLib\/documentation\/GLib\/SourceFuncsProtocol\/sourceRemoveByFuncs(userData:)","abstract":[{"type":"text","text":"Removes a source from the default main loop context given the"},{"text":" ","type":"text"},{"type":"text","text":"source functions and user data."}],"title":"sourceRemoveByFuncs(userData:)","role":"symbol","kind":"symbol","fragments":[{"kind":"keyword","text":"func"},{"kind":"text","text":" "},{"text":"sourceRemoveByFuncs","kind":"identifier"},{"text":"(","kind":"text"},{"kind":"externalParam","text":"userData"},{"kind":"text","text":": "},{"kind":"typeIdentifier","preciseIdentifier":"c:@T@gpointer","text":"gpointer"},{"text":"?) -> ","kind":"text"},{"text":"Bool","kind":"typeIdentifier","preciseIdentifier":"s:Sb"}],"type":"topic","url":"\/documentation\/glib\/sourcefuncsprotocol\/sourceremovebyfuncs(userdata:)"},"doc://GLib/documentation/GLib/SourceFuncsProtocol":{"identifier":"doc:\/\/GLib\/documentation\/GLib\/SourceFuncsProtocol","fragments":[{"text":"protocol","kind":"keyword"},{"text":" ","kind":"text"},{"kind":"identifier","text":"SourceFuncsProtocol"}],"abstract":[{"text":"The ","type":"text"},{"type":"codeVoice","code":"GSourceFuncs"},{"type":"text","text":" struct contains a table of"},{"text":" ","type":"text"},{"type":"text","text":"functions used to handle event sources in a generic manner."}],"type":"topic","title":"SourceFuncsProtocol","kind":"symbol","role":"symbol","url":"\/documentation\/glib\/sourcefuncsprotocol","navigatorTitle":[{"kind":"identifier","text":"SourceFuncsProtocol"}]},"doc://GLib/documentation/GLib/SourceFuncsProtocol/dispatch":{"identifier":"doc:\/\/GLib\/documentation\/GLib\/SourceFuncsProtocol\/dispatch","abstract":[{"type":"text","text":"Called to dispatch the event source, after it has returned"},{"type":"text","text":" "},{"code":"true","type":"codeVoice"},{"type":"text","text":" in either its "},{"type":"codeVoice","code":"prepare"},{"text":" or its ","type":"text"},{"code":"check","type":"codeVoice"},{"text":" function, or if a ready time","type":"text"},{"text":" ","type":"text"},{"type":"text","text":"has been reached. The "},{"code":"dispatch","type":"codeVoice"},{"type":"text","text":" function receives a callback function and"},{"type":"text","text":" "},{"type":"text","text":"user data. The callback function may be "},{"code":"nil","type":"codeVoice"},{"type":"text","text":" if the source was never"},{"type":"text","text":" "},{"text":"connected to a callback using [method","type":"text"},{"type":"codeVoice","code":"GLib.Source.set_callback"},{"text":"]. The","type":"text"},{"type":"text","text":" "},{"code":"dispatch","type":"codeVoice"},{"type":"text","text":" function should call the callback function with "},{"type":"codeVoice","code":"user_data"},{"text":" and","type":"text"},{"text":" ","type":"text"},{"type":"text","text":"whatever additional parameters are needed for this type of event source."},{"text":" ","type":"text"},{"text":"The return value of the ","type":"text"},{"type":"codeVoice","code":"dispatch"},{"type":"text","text":" function should be"},{"type":"text","text":" "},{"text":"[const","type":"text"},{"type":"reference","isActive":true,"identifier":"doc:\/\/GLib\/documentation\/GLib\/sourceRemove"},{"type":"text","text":"] if the source should be removed or"},{"type":"text","text":" "},{"type":"text","text":"[const"},{"isActive":true,"type":"reference","identifier":"doc:\/\/GLib\/documentation\/GLib\/sourceContinue"},{"type":"text","text":"] to keep it."}],"title":"dispatch","role":"symbol","kind":"symbol","fragments":[{"text":"var","kind":"keyword"},{"text":" ","kind":"text"},{"kind":"identifier","text":"dispatch"},{"kind":"text","text":": "},{"kind":"typeIdentifier","preciseIdentifier":"c:@T@GSourceFuncsDispatchFunc","text":"GSourceFuncsDispatchFunc"},{"kind":"text","text":"!"}],"type":"topic","url":"\/documentation\/glib\/sourcefuncsprotocol\/dispatch"},"doc://GLib/documentation/GLib/PointerWrapper":{"type":"topic","kind":"symbol","fragments":[{"text":"protocol","kind":"keyword"},{"kind":"text","text":" "},{"kind":"identifier","text":"PointerWrapper"}],"abstract":[{"text":"Protocol for GLib types that wrap pointers.","type":"text"}],"role":"symbol","url":"\/documentation\/glib\/pointerwrapper","navigatorTitle":[{"text":"PointerWrapper","kind":"identifier"}],"title":"PointerWrapper","identifier":"doc:\/\/GLib\/documentation\/GLib\/PointerWrapper"},"doc://GLib/documentation/GLib/sourceRemove":{"identifier":"doc:\/\/GLib\/documentation\/GLib\/sourceRemove","fragments":[{"text":"let","kind":"keyword"},{"kind":"text","text":" "},{"text":"sourceRemove","kind":"identifier"},{"kind":"text","text":": "},{"kind":"typeIdentifier","preciseIdentifier":"s:s5Int32V","text":"Int32"}],"abstract":[{"type":"text","text":"Use this macro as the return value of a [callback"},{"isActive":true,"type":"reference","identifier":"doc:\/\/GLib\/documentation\/GLib\/SourceFunc"},{"type":"text","text":"] to remove"},{"type":"text","text":" "},{"text":"the [struct","type":"text"},{"isActive":true,"type":"reference","identifier":"doc:\/\/GLib\/documentation\/GLib\/Source"},{"type":"text","text":"] from the main loop."}],"type":"topic","title":"sourceRemove","kind":"symbol","role":"symbol","url":"\/documentation\/glib\/sourceremove"}}}