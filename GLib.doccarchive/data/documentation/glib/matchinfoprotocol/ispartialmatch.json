{"schemaVersion":{"patch":0,"minor":3,"major":0},"sections":[],"metadata":{"extendedModule":"GLib","symbolKind":"property","title":"isPartialMatch","externalID":"s:4GLib17MatchInfoProtocolPAAE09isPartialB0Sbvp","fragments":[{"text":"var","kind":"keyword"},{"text":" ","kind":"text"},{"kind":"identifier","text":"isPartialMatch"},{"text":": ","kind":"text"},{"kind":"typeIdentifier","text":"Bool","preciseIdentifier":"s:Sb"}],"roleHeading":"Instance Property","modules":[{"name":"GLib"}],"role":"symbol"},"hierarchy":{"paths":[["doc:\/\/GLib\/documentation\/GLib","doc:\/\/GLib\/documentation\/GLib\/MatchInfoProtocol"]]},"identifier":{"url":"doc:\/\/GLib\/documentation\/GLib\/MatchInfoProtocol\/isPartialMatch","interfaceLanguage":"swift"},"primaryContentSections":[{"kind":"declarations","declarations":[{"tokens":[{"kind":"keyword","text":"var"},{"kind":"text","text":" "},{"text":"isPartialMatch","kind":"identifier"},{"kind":"text","text":": "},{"preciseIdentifier":"s:Sb","text":"Bool","kind":"typeIdentifier"},{"text":" { ","kind":"text"},{"text":"get","kind":"keyword"},{"kind":"text","text":" }"}],"platforms":["macOS"],"languages":["swift"]}]},{"kind":"content","content":[{"anchor":"discussion","text":"Discussion","type":"heading","level":2},{"inlineContent":[{"type":"text","text":"Consider, for example, an application where a human is required to"},{"type":"text","text":" "},{"type":"text","text":"type in data for a field with specific formatting requirements. An"},{"text":" ","type":"text"},{"text":"example might be a date in the form ddmmmyy, defined by the pattern","type":"text"},{"type":"text","text":" "},{"type":"codeVoice","code":"\"^\\d?\\d(jan|feb|mar|apr|may|jun|jul|aug|sep|oct|nov|dec)"},{"type":"text","text":"\\d\\d$”."},{"text":" ","type":"text"},{"text":"If the application sees the user’s keystrokes one by one, and can","type":"text"},{"type":"text","text":" "},{"type":"text","text":"check that what has been typed so far is potentially valid, it is"},{"type":"text","text":" "},{"type":"text","text":"able to raise an error as soon as a mistake is made."}],"type":"paragraph"},{"type":"paragraph","inlineContent":[{"type":"text","text":"GRegex supports the concept of partial matching by means of the"},{"type":"text","text":" "},{"type":"codeVoice","code":"partialSoft"},{"text":" and ","type":"text"},{"code":"partialHard","type":"codeVoice"},{"type":"text","text":" flags."},{"text":" ","type":"text"},{"text":"When they are used, the return code for","type":"text"},{"text":" ","type":"text"},{"type":"codeVoice","code":"g_regex_match()"},{"text":" or ","type":"text"},{"type":"codeVoice","code":"g_regex_match_full()"},{"text":" is, as usual, ","type":"text"},{"type":"codeVoice","code":"true"},{"type":"text","text":" "},{"type":"text","text":"for a complete match, "},{"code":"false","type":"codeVoice"},{"type":"text","text":" otherwise. But, when these functions"},{"type":"text","text":" "},{"type":"text","text":"return "},{"type":"codeVoice","code":"false"},{"type":"text","text":", you can check if the match was partial calling"},{"type":"text","text":" "},{"type":"codeVoice","code":"g_match_info_is_partial_match()"},{"type":"text","text":"."}]},{"type":"paragraph","inlineContent":[{"text":"The difference between ","type":"text"},{"code":"partialSoft","type":"codeVoice"},{"text":" and","type":"text"},{"type":"text","text":" "},{"code":"partialHard","type":"codeVoice"},{"text":" is that when a partial match is encountered","type":"text"},{"type":"text","text":" "},{"text":"with ","type":"text"},{"type":"codeVoice","code":"partialSoft"},{"text":", matching continues to search for a","type":"text"},{"type":"text","text":" "},{"type":"text","text":"possible complete match, while with "},{"type":"codeVoice","code":"partialHard"},{"type":"text","text":" matching"},{"type":"text","text":" "},{"text":"stops at the partial match.","type":"text"},{"type":"text","text":" "},{"text":"When both ","type":"text"},{"type":"codeVoice","code":"partialSoft"},{"type":"text","text":" and "},{"code":"partialHard","type":"codeVoice"},{"type":"text","text":" "},{"type":"text","text":"are set, the latter takes precedence."}]},{"inlineContent":[{"type":"text","text":"There were formerly some restrictions on the pattern for partial matching."},{"type":"text","text":" "},{"type":"text","text":"The restrictions no longer apply."}],"type":"paragraph"},{"type":"paragraph","inlineContent":[{"type":"text","text":"See "},{"code":"pcrepartial(3)","type":"codeVoice"},{"type":"text","text":" for more information on partial matching."}]}]}],"abstract":[{"type":"text","text":"Usually if the string passed to g_regex_match*() matches as far as"},{"type":"text","text":" "},{"type":"text","text":"it goes, but is too short to match the entire pattern, "},{"type":"codeVoice","code":"false"},{"type":"text","text":" is"},{"text":" ","type":"text"},{"type":"text","text":"returned. There are circumstances where it might be helpful to"},{"text":" ","type":"text"},{"text":"distinguish this case from other cases in which there is no match.","type":"text"}],"kind":"symbol","variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/glib\/matchinfoprotocol\/ispartialmatch"]}],"references":{"doc://GLib/documentation/GLib/MatchInfoProtocol/isPartialMatch":{"fragments":[{"text":"var","kind":"keyword"},{"kind":"text","text":" "},{"text":"isPartialMatch","kind":"identifier"},{"kind":"text","text":": "},{"preciseIdentifier":"s:Sb","text":"Bool","kind":"typeIdentifier"}],"kind":"symbol","abstract":[{"type":"text","text":"Usually if the string passed to g_regex_match*() matches as far as"},{"text":" ","type":"text"},{"type":"text","text":"it goes, but is too short to match the entire pattern, "},{"type":"codeVoice","code":"false"},{"text":" is","type":"text"},{"type":"text","text":" "},{"type":"text","text":"returned. There are circumstances where it might be helpful to"},{"type":"text","text":" "},{"type":"text","text":"distinguish this case from other cases in which there is no match."}],"type":"topic","title":"isPartialMatch","role":"symbol","url":"\/documentation\/glib\/matchinfoprotocol\/ispartialmatch","identifier":"doc:\/\/GLib\/documentation\/GLib\/MatchInfoProtocol\/isPartialMatch"},"doc://GLib/documentation/GLib":{"identifier":"doc:\/\/GLib\/documentation\/GLib","title":"GLib","abstract":[],"type":"topic","url":"\/documentation\/glib","kind":"symbol","role":"collection"},"doc://GLib/documentation/GLib/MatchInfoProtocol":{"abstract":[{"type":"text","text":"A GMatchInfo is an opaque struct used to return information about"},{"type":"text","text":" "},{"type":"text","text":"matches."}],"title":"MatchInfoProtocol","url":"\/documentation\/glib\/matchinfoprotocol","identifier":"doc:\/\/GLib\/documentation\/GLib\/MatchInfoProtocol","type":"topic","fragments":[{"text":"protocol","kind":"keyword"},{"text":" ","kind":"text"},{"kind":"identifier","text":"MatchInfoProtocol"}],"kind":"symbol","navigatorTitle":[{"text":"MatchInfoProtocol","kind":"identifier"}],"role":"symbol"}}}