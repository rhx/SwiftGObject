 "},{"type":"text","text":"so you cannot call this function after freeing the string."}]}]}],"schemaVersion":{"minor":3,"patch":0,"major":0},"sections":[],"metadata":{"fragments":[{"text":"func","kind":"keyword"},{"text":" ","kind":"text"},{"kind":"identifier","text":"fetchAll"},{"text":"() -> ","kind":"text"},{"kind":"typeIdentifier","preciseIdentifier":"s:Sp","text":"UnsafeMutablePointer"},{"text":"<","kind":"text"},{"text":"UnsafeMutablePointer","kind":"typeIdentifier","preciseIdentifier":"s:Sp"},{"kind":"text","text":"<"},{"preciseIdentifier":"c:@T@gchar","text":"gchar","kind":"typeIdentifier"},{"kind":"text","text":">?>!"}],"modules":[{"name":"GLib"}],"externalID":"s:4GLib17MatchInfoProtocolPAAE8fetchAllSpySpys4Int8VGSgGSgyF","symbolKind":"method","roleHeading":"Instance Method","role":"symbol","title":"fetchAll()","extendedModule":"GLib"},"abstract":[{"text":"Bundles up pointers to each of the matching substrings from a match","type":"text"},{"text":" ","type":"text"},{"text":"and stores them in an array of gchar pointers. The first element in","type":"text"},{"type":"text","text":" "},{"type":"text","text":"the returned array is the match number 0, i.e. the entire matched"},{"type":"text","text":" "},{"type":"text","text":"text."}],"identifier":{"url":"doc:\/\/GLib\/documentation\/GLib\/MatchInfoProtocol\/fetchAll()","interfaceLanguage":"swift"},"references":{"doc://GLib/documentation/GLib/MatchInfoProtocol":{"abstract":[{"type":"text","text":"A GMatchInfo is an opaque struct used to return information about"},{"type":"text","text":" "},{"type":"text","text":"matches."}],"title":"MatchInfoProtocol","url":"\/documentation\/glib\/matchinfoprotocol","identifier":"doc:\/\/GLib\/documentation\/GLib\/MatchInfoProtocol","type":"topic","fragments":[{"text":"protocol","kind":"keyword"},{"text":" ","kind":"text"},{"kind":"identifier","text":"MatchInfoProtocol"}],"kind":"symbol","navigatorTitle":[{"text":"MatchInfoProtocol","kind":"identifier"}],"role":"symbol"},"doc://