{"kind":"symbol","sections":[],"identifier":{"url":"doc:\/\/GLib\/documentation\/GLib\/getSystemConfigDirs()","interfaceLanguage":"swift"},"abstract":[{"type":"text","text":"Returns an ordered list of base directories in which to access"},{"type":"text","text":" "},{"type":"text","text":"system-wide configuration information."}],"metadata":{"modules":[{"name":"GLib"}],"externalID":"s:4GLib19getSystemConfigDirsSPySPys4Int8VGSgGSgyF","fragments":[{"kind":"keyword","text":"func"},{"text":" ","kind":"text"},{"kind":"identifier","text":"getSystemConfigDirs"},{"text":"() -> ","kind":"text"},{"kind":"typeIdentifier","text":"UnsafePointer","preciseIdentifier":"s:SP"},{"text":"<","kind":"text"},{"kind":"typeIdentifier","preciseIdentifier":"s:SP","text":"UnsafePointer"},{"kind":"text","text":"<"},{"kind":"typeIdentifier","text":"gchar","preciseIdentifier":"c:@T@gchar"},{"text":">?>!","kind":"text"}],"roleHeading":"Function","role":"symbol","title":"getSystemConfigDirs()","symbolKind":"func"},"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/glib\/getsystemconfigdirs()"]}],"hierarchy":{"paths":[["doc:\/\/GLib\/documentation\/GLib"]]},"primaryContentSections":[{"declarations":[{"platforms":["macOS"],"tokens":[{"text":"func","kind":"keyword"},{"kind":"text","text":" "},{"text":"getSystemConfigDirs","kind":"identifier"},{"kind":"text","text":"() -> "},{"kind":"typeIdentifier","preciseIdentifier":"s:SP","text":"UnsafePointer"},{"text":"<","kind":"text"},{"preciseIdentifier":"s:SP","kind":"typeIdentifier","text":"UnsafePointer"},{"kind":"text","text":"<"},{"kind":"typeIdentifier","text":"gchar","preciseIdentifier":"c:@T@gchar"},{"text":">?>!","kind":"text"}],"languages":["swift"]}],"kind":"declarations"},{"content":[{"text":"Discussion","level":2,"anchor":"discussion","type":"heading"},{"inlineContent":[{"type":"text","text":"On UNIX platforms this is determined using the mechanisms described"},{"text":" ","type":"text"},{"type":"text","text":"in the"},{"text":" ","type":"text"},{"identifier":"http:\/\/www.freedesktop.org\/Standards\/basedir-spec","isActive":true,"type":"reference"},{"type":"text","text":"."},{"type":"text","text":" "},{"text":"In this case the list of directories retrieved will be ","type":"text"},{"type":"codeVoice","code":"XDG_CONFIG_DIRS"},{"type":"text","text":"."}],"type":"paragraph"},{"type":"paragraph","inlineContent":[{"text":"On Windows it follows XDG Base Directory Specification if ","type":"text"},{"code":"XDG_CONFIG_DIRS","type":"codeVoice"},{"type":"text","text":" is defined."},{"type":"text","text":" "},{"type":"text","text":"If "},{"type":"codeVoice","code":"XDG_CONFIG_DIRS"},{"type":"text","text":" is undefined, the directory that contains application"},{"text":" ","type":"text"},{"text":"data for all users is used instead. A typical path is","type":"text"},{"type":"text","text":" "},{"code":"C:\\Documents and Settings\\All Users\\Application Data","type":"codeVoice"},{"type":"text","text":"."},{"text":" ","type":"text"},{"text":"This folder is used for application data","type":"text"},{"type":"text","text":" "},{"text":"that is not user specific. For example, an application can store","type":"text"},{"type":"text","text":" "},{"type":"text","text":"a spell-check dictionary, a database of clip art, or a log file in the"},{"type":"text","text":" "},{"text":"FOLDERID_ProgramData folder. This information will not roam and is available","type":"text"},{"type":"text","text":" "},{"text":"to anyone using the computer.","type":"text"}]},{"inlineContent":[{"text":"The return value is cached and modifying it at runtime is not supported, as","type":"text"},{"type":"text","text":" "},{"type":"text","text":"it’s not thread-safe to modify environment variables at runtime."}],"type":"paragraph"}],"kind":"content"}],"schemaVersion":{"minor":3,"major":0,"patch":0},"references":{"doc://GLib/documentation/GLib":{"identifier":"doc:\/\/GLib\/documentation\/GLib","title":"GLib","abstract":[],"type":