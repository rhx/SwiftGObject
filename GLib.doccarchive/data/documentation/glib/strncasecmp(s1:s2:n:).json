{"schemaVersion":{"patch":0,"major":0,"minor":3},"abstract":[{"type":"text","text":"A case-insensitive string comparison, corresponding to the standard"},{"type":"text","text":" "},{"type":"codeVoice","code":"strncasecmp()"},{"text":" function on platforms which support it. It is similar","type":"text"},{"type":"text","text":" "},{"type":"text","text":"to [func"},{"code":"GLib.strcasecmp","type":"codeVoice"},{"text":"] except it only compares the first ","type":"text"},{"code":"n","type":"codeVoice"},{"text":" characters of","type":"text"},{"text":" ","type":"text"},{"text":"the strings.","type":"text"}],"hierarchy":{"paths":[["doc:\/\/GLib\/documentation\/GLib"]]},"variants":[{"paths":["\/documentation\/glib\/strncasecmp(s1:s2:n:)"],"traits":[{"interfaceLanguage":"swift"}]}],"primaryContentSections":[{"declarations":[{"platforms":["macOS"],"languages":["swift"],"tokens":[{"text":"func","kind":"keyword"},{"kind":"text","text":" "},{"kind":"identifier","text":"strncasecmp"},{"text":"(","kind":"text"},{"kind":"externalParam","text":"s1"},{"text":": ","kind":"text"},{"text":"UnsafePointer","kind":"typeIdentifier","preciseIdentifier":"s:SP"},{"text":"<","kind":"text"},{"kind":"typeIdentifier","text":"gchar","preciseIdentifier":"c:@T@gchar"},{"text":">!, ","kind":"text"},{"text":"s2","kind":"externalParam"},{"kind":"text","text":": "},{"preciseIdentifier":"s:SP","text":"UnsafePointer","kind":"typeIdentifier"},{"text":"<","kind":"text"},{"preciseIdentifier":"c:@T@gchar","text":"gchar","kind":"typeIdentifier"},{"kind":"text","text":">!, "},{"text":"n","kind":"externalParam"},{"text":": ","kind":"text"},{"text":"Int","preciseIdentifier":"s:Si","kind":"typeIdentifier"},{"kind":"text","text":") -> "},{"text":"Int","kind":"typeIdentifier","preciseIdentifier":"s:Si"}]}],"kind":"declarations"},{"content":[{"text":"Discussion","anchor":"discussion","level":2,"type":"heading"},{"type":"paragraph","inlineContent":[{"inlineContent":[{"type":"text","text":"Strncasecmp is deprecated:"}],"type":"strong"},{"text":" ","type":"text"},{"text":"The problem with ","type":"text"},{"type":"codeVoice","code":"g_strncasecmp()"},{"type":"text","text":" is that it does"},{"text":" ","type":"text"},{"text":"the comparison by calling ","type":"text"},{"code":"toupper()","type":"codeVoice"},{"text":"\/","type":"text"},{"type":"codeVoice","code":"tolower()"},{"text":". These functions","type":"text"},{"type":"text","text":" "},{"text":"are locale-specific and operate on single bytes. However, it is","type":"text"},{"type":"text","text":" "},{"text":"impossible to handle things correctly from an internationalization","type":"text"},{"text":" ","type":"text"},{"text":"standpoint by operating on bytes, since characters may be multibyte.","type":"text"},{"text":" ","type":"text"},{"type":"text","text":"Thus "},{"type":"codeVoice","code":"g_strncasecmp()"},{"text":" is broken if your string is guaranteed to be","type":"text"},{"text":" ","type":"text"},{"text":"ASCII, since it is locale-sensitive, and it’s broken if your string","type":"text"},{"type":"text","text":" "},{"text":"is localized, since it doesn’t work on many encodings at all,","type":"text"},{"text":" ","type":"text"},{"type":"text","text":"including UTF-8, EUC-JP, etc."}]},{"inlineContent":[{"type":"text","text":"There are therefore two replacement techniques: [func@GLib.ascii_strncasecmp],"},{"text":" ","type":"text"},{"type":"text","text":"which only works on ASCII and is not locale-sensitive, and"},{"type":"text","text":" "},{"text":"[func@GLib.utf8_casefold] followed by ","type":"text"},{"code":"strcmp()","type":"codeVoice"},{"type":"text","text":" on the resulting strings,"},{"type":"text","text":" "},{"text":"which is good for case-insensitive sorting of UTF-8.","type":"text"}],"type":"paragraph"}],"kind":"content"}],"metadata":{"externalID":"s:4GLib11strncasecmp2s12s21nSiSPys4Int8VGSg_AISitF","title":"strncasecmp(s1:s2:n:)","role":"symbol","roleHeading":"Function","modules":[{"name":"GLib"}],"sy