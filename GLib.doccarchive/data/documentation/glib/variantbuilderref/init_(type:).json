tTypeProtocolP","text":"VariantTypeProtocol","kind":"typeIdentifier"}]}]},{"kind":"content","content":[{"text":"Discussion","level":2,"type":"heading","anchor":"discussion"},{"inlineContent":[{"type":"codeVoice","code":"type"},{"text":" must be non-","type":"text"},{"type":"codeVoice","code":"nil"},{"type":"text","text":".  It specifies the type of container to"},{"type":"text","text":" "},{"text":"construct.  It can be an indefinite type such as","type":"text"},{"type":"text","text":" "},{"code":"G_VARIANT_TYPE_ARRAY","type":"codeVoice"},{"type":"text","text":" or a definite type such as “as” or “(ii)”."},{"type":"text","text":" "},{"type":"text","text":"Maybe, array, tuple, dictionary entry and variant-typed values may be"},{"text":" ","type":"text"},{"type":"text","text":"constructed."}],"type":"paragraph"},{"type":"paragraph","inlineContent":[{"type":"text","text":"If using a static type such as one of the "},{"code":"G_VARIANT_TYPE_*","type":"codeVoice"},{"text":" constants","type":"text"},{"type":"text","text":" "},{"type":"text","text":"or a "},{"code":"G_VARIANT_TYPE (\"(ii)\")","type":"codeVoice"},{"text":" macro, it is more performant to use","type":"text"},{"text":" ","type":"text"},{"type":"codeVoice","code":"g_variant_builder_init_static()"},{"text":" rather than ","type":"text"},{"code":"g_variant_builder_init()","type":"codeVoice"},{"type":"text","text":"."}]},{"type":"paragraph","inlineContent":[{"text":"After the builder is initialised, values are added using","type":"text"},{"text":" ","type":"text"},{"type":"codeVoice","code":"g_variant_builder_add_value()"},{"type":"text","text":" or "},{"code":"g_variant_builder_add()","type":"codeVoice"},{"text":".","type":"text"}]},{"inlineContent":[{"text":"After all the child values are added, ","type":"text"},{"type":"codeVoice","code":"g_variant_builder_end()"},{"text":" frees","type":"text"},{"type":"text","text":" "},{"text":"the memory associated with the builder and returns the ","type":"text"},{"identifier":"doc:\/\/GLib\/documentation\/GLib\/Variant","isActive":true,"type":"reference"},{"type":"text","text":" that"},{"text":" ","type":"text"},{"text":"was created.","type":"text"}],"type":"paragraph"},{"type":"paragraph","inlineContent":[{"type":"text","text":"This function completely ignores the previous contents of "},{"type":"codeVoice","code":"builder"},{"text":".","type":"text"},{"type":"text","text":" "},{"text":"On one hand this means that it is valid to pass in completely","type":"text"},{"type":"text","text":" "},{"text":"uninitialised memory.  On the other hand, this means that if you are","type":"text"},{"type":"text","text":" "},{"text":"initialising over top of an existing ","type":"text"},{"identifier":"doc:\/\/GLib\/documentation\/GLib\/VariantBuilder","isActive":true,"type":"reference"},{"type":"text","text":" you need to"},{"text":" ","type":"text"},{"text":"first call ","type":"text"},{"type":"codeVoice","code":"g_variant_builder_clear()"},{"type":"text","text":" in order to avoid leaking"},{"text":" ","type":"text"},{"type":"text","text":"memory."}]},{"type":"paragraph","inlineContent":[{"text":"You must not call ","type":"text"},{"type":"codeVoice","code":"g_variant_builder_ref()"},{"text":" or","type":"text"},{"text":" ","type":"text"},{"type":"codeVoice","code":"g_variant_builder_unref()"},{"type":"text","text":" on a "},{"identifier":"doc:\/\/GLib\/documentation\/GLib\/VariantBuilder","type":"reference","isActive":true},{"type":"text","text":" that was initialised"},{"type":"text","text":" "},{"type":"text","text":"with this function.  If you ever pass a reference to a"},{"type":"text","text":" "},{"identifier":"doc:\/\/GLib\/documentation\/GLib\/VariantBuilder","isActive":true,"type":"reference"},{"type":"text","text":" outside of the control of your own code then you"},{"type":"text","text":" "},{"text":"should assume that the person receiving that reference may try to use","type":"text"},{"text":" ","type":"text"},{"text":"reference counting; you should use ","type":"text"},{"code":"g_variant_builder_new()","type":"codeVoice"},{"type":"text","text":" instead of"},{"type":"text","text":" "},{"text":"this function.","type":"text"}]}]}],"sections":[],"schemaVersion":{"major":0,"minor":3,"patch":0},"kind":"symbol","references":{"doc://GLib/documentation/GLib/VariantBuilderRef":{"navigatorTitle":[{"text":"VariantBuilderRef","kind":"identifier"}],"title":"VariantBuilderRef","type":"topic","url":"\/documentation\/glib\/variantbuilderref","kind":"symbol","fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"VariantBuilderRef"}],"abstract":[{"text":"A utility type for constructing container-type ","type":"text"},{"identifier":"doc:\/\/GLib\/documentation\/GLib\/Variant","isActive":true,"type":"reference"},{"text":" instances.","type":"text"}],"identifier":"doc:\/\/GLib\/documentation\/GLib\/VariantBuilderRef","role":"symbol"},"doc://GLib/documentation/GLib/VariantTypeProtocol":{"identifier":"doc:\/\/GLib\/documentation\/GLib\/VariantTypeProtocol","title":"VariantTypeProtocol","type":"topic","role":"symbol","navigatorTitle":[{"kind":"identifier","text":"VariantTypeProtocol"}],"abstract":[{"text":"A type in the [type","type":"text"},{"identifier":"doc:\/\/GLib\/documentation\/GLib\/Variant","isActive":true,"type":"reference"},{"text":"] type system.","type":"text"}],"url":"\/documentation\/glib\/varianttypeprotocol","fragments":[{"text":"protocol","kind":"keyword"},{"text":" ","kind":"text"},{"kind":"identifier","text":"VariantTypeProtocol"}],"kind":"symbol"},"doc://GLib/documentation/GLib":{"identifier":"doc:\/\/GLib\/documentation\/GLib","title":"GLib","abstract":[],"type":"topic","url":"\/documentation\/glib","kind":"symbol","role":"collection"},"doc://GLib/documentation/GLib/VariantBuilder":{"role":"symbol","type":"topic","title":"VariantBuilder","abstract":[{"type":"text","text":"A utility type for constructing container-type "},{"identifier":"doc:\/\/GL