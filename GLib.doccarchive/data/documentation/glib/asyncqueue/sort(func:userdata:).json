":"codeVoice"},{"type":"text","text":"."},{"text":" ","type":"text"},{"text":"It should return 0 if they are equal, a negative value if the","type":"text"},{"type":"text","text":" "},{"text":"first element should be higher in the ","type":"text"},{"type":"codeVoice","code":"queue"},{"type":"text","text":" or a positive value"},{"type":"text","text":" "},{"text":"if the first element should be lower in the ","type":"text"},{"type":"codeVoice","code":"queue"},{"type":"text","text":" than the second"},{"type":"text","text":" "},{"text":"element.","type":"text"}],"type":"paragraph"},{"type":"paragraph","inlineContent":[{"type":"text","text":"This function will lock "},{"code":"queue","type":"codeVoice"},{"text":" before it sorts the queue and unlock","type":"text"},{"type":"text","text":" "},{"type":"text","text":"it when it is finished."}]},{"inlineContent":[{"type":"text","text":"If you were sorting a list of priority numbers to make sure the"},{"type":"text","text":" "},{"type":"text","text":"lowest priority would be at the top of the queue, you could use:"},{"text":" ","type":"text"},{"text":"(C Language Example):","type":"text"}],"type":"paragraph"},{"code":[" gint32 id1;"," gint32 id2;",""," id1 = GPOINTER_TO_INT (element1);"," id2 = GPOINTER_TO_INT (element2);",""," return (id1 > id2 ? +1 : id1 == id2 ? 0 : -1);"],"syntax":"C","type":"codeListing"}]}],"sections":[],"schemaVersion":{"major":0,"minor":3,"patch":0},"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/glib\/asyncqueue\/sort(func:userdata:)"]}],"kind":"symbol","hierarchy":{"paths":[["doc:\/\/GLib\/documentation\/GLib","doc:\/\/GLib\/documentation\/GLib\/AsyncQueue","doc:\/\/GLib\/documentation\/GLib\/AsyncQueue\/AsyncQueueProtocol-Implementations"]]},"references":{"doc://GLib/documentation/GLib/AsyncQueue":{"url":"\/documentation\/glib\/asyncqueue","title":"AsyncQueue","kind":"symbol","identifier":"doc:\/\/GLib\/documentation\/GLib\/AsyncQueue","fragments":[{"kind":"keyword