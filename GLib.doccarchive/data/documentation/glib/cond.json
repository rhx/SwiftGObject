{"schemaVersion":{"minor":3,"major":0,"patch":0},"relationshipsSections":[{"identifiers":["doc:\/\/GLib\/documentation\/GLib\/CondProtocol","doc:\/\/GLib\/documentation\/GLib\/PointerWrapper"],"type":"conformsTo","kind":"relationships","title":"Conforms To"}],"variants":[{"paths":["\/documentation\/glib\/cond"],"traits":[{"interfaceLanguage":"swift"}]}],"metadata":{"fragments":[{"text":"class","kind":"keyword"},{"kind":"text","text":" "},{"kind":"identifier","text":"Cond"}],"externalID":"s:4GLib4CondC","navigatorTitle":[{"text":"Cond","kind":"identifier"}],"symbolKind":"class","roleHeading":"Class","modules":[{"name":"GLib"}],"title":"Cond","role":"symbol"},"kind":"symbol","sections":[],"abstract":[{"text":"The ","type":"text"},{"isActive":true,"identifier":"doc:\/\/GLib\/documentation\/GLib\/Cond","type":"reference"},{"type":"text","text":" struct is an opaque data structure that represents a"},{"text":" ","type":"text"},{"type":"text","text":"condition. Threads can block on a "},{"identifier":"doc:\/\/GLib\/documentation\/GLib\/Cond","isActive":true,"type":"reference"},{"type":"text","text":" if they find a certain"},{"type":"text","text":" "},{"text":"condition to be false. If other threads change the state of this","type":"text"},{"type":"text","text":" "},{"type":"text","text":"condition they signal the "},{"isActive":true,"type":"reference","identifier":"doc:\/\/GLib\/documentation\/GLib\/Cond"},{"text":", and that causes the waiting","type":"text"},{"text":" ","type":"text"},{"text":"threads to be woken up.","type":"text"}],"identifier":{"interfaceLanguage":"swift","url":"doc:\/\/GLib\/documentation\/GLib\/Cond"},"topicSections":[{"title":"Initializers","generated":true,"identifiers":["doc:\/\/GLib\/documentation\/GLib\/Cond\/init(_:)-3cuz9","doc:\/\/GLib\/documentation\/GLib\/Cond\/init(_:)-3wkhq","doc:\/\/GLib\/documentation\/GLib\/Cond\/init(_:)-46zzs","doc:\/\/GLib\/documentation\/GLib\/Cond\/init(_:)-8cx4a","doc:\/\/GLib\/documentation\/GLib\/Cond\/init(_:)-ewbk","doc:\/\/GLib\/documentation\/GLib\/Cond\/init(cPointer:)","doc:\/\/GLib\/documentation\/GLib\/Cond\/init(gconstpointer:)","doc:\/\/GLib\/documentation\/GLib\/Cond\/init(gpointer:)","doc:\/\/GLib\/documentation\/GLib\/Cond\/init(opaquePointer:)","doc:\/\/GLib\/documentation\/GLib\/Cond\/init(raw:)-6h5wo","doc:\/\/GLib\/documentation\/GLib\/Cond\/init(raw:)-91iij","doc:\/\/GLib\/documentation\/GLib\/Cond\/init(retaining:)","doc:\/\/GLib\/documentation\/GLib\/Cond\/init(retainingCPointer:)","doc:\/\/GLib\/documentation\/GLib\/Cond\/init(retainingOpaquePointer:)","doc:\/\/GLib\/documentation\/GLib\/Cond\/init(retainingRaw:)-2zlm8","doc:\/\/GLib\/documentation\/GLib\/Cond\/init(retainingRaw:)-9u70y"],"anchor":"Initializers"},{"title":"Instance Properties","anchor":"Instance-Properties","generated":true,"identifiers":["doc:\/\/GLib\/documentation\/GLib\/Cond\/ptr"]},{"identifiers":["doc:\/\/GLib\/documentation\/GLib\/Cond\/CondProtocol-Implementations"],"anchor":"Default-Implementations","generated":true,"title":"Default Implementations"}],"hierarchy":{"paths":[["doc:\/\/GLib\/documentation\/GLib"]]},"primaryContentSections":[{"declarations":[{"languages":["swift"],"platforms":["macOS"],"tokens":[{"text":"class","kind":"keyword"},{"text":" ","kind":"text"},{"text":"Cond","kind":"identifier"}]}],"kind":"declarations"},{"kind":"content","content":[{"level":2,"type":"heading","anchor":"overview","text":"Overview"},{"type":"paragraph","inlineContent":[{"text":"Consider the following example of a shared variable.  One or more","type":"text"},{"type":"text","text":" "},{"type":"text","text":"threads can wait for data to be published to the variable and when"},{"text":" ","type":"text"},{"type":"text","text":"another thread publishes the data, it can signal one of the waiting"},{"type":"text","text":" "},{"text":"threads to wake up to collect the data.","type":"text"}]},{"inlineContent":[{"type":"text","text":"Here is an example for using GCond to block a thread until a condition"},{"type":"text","text":" "},{"text":"is satisfied:","type":"text"},{"type":"text","text":" "},{"type":"text","text":"(C Language Example):"}],"type":"paragraph"},{"code":["  gpointer current_data = NULL;","  GMutex data_mutex;","  GCond data_cond;","","  void","  push_data (gpointer data)","  {","    g_mutex_lock (&data_mutex);","    current_data = data;","    g_cond_signal (&data_cond);","    g_mutex_unlock (&data_mutex);","  }","","  gpointer","  pop_data (void)","  {","    gpointer data;","","    g_mutex_lock (&data_mutex);","    while (!current_data)","      g_cond_wait (&data_cond, &data_mutex);","    data = current_data;","    current_data = NULL;","    g_mutex_unlock (&data_mutex);","","    return data;","  }"],"type":"codeListing","syntax":"C"},{"inlineContent":[{"type":"text","text":"Whenever a thread calls "},{"code":"pop_data()","type":"codeVoice"},{"type":"text","text":" now, it will wait until"},{"type":"text","text":" "},{"text":"current_data is non-","type":"text"},{"type":"codeVoice","code":"nil"},{"type":"text","text":", i.e. until some other thread"},{"type":"text","text":" "},{"type":"text","text":"has called "},{"code":"push_data()","type":"codeVoice"},{"text":".","type":"text"}],"type":"paragraph"},{"type":"paragraph","inlineContent":[{"text":"The example shows that use of a condition variable must always be","type":"text"},{"type":"text","text":" "},{"text":"paired with a mutex.  Without the use of a mutex, there would be a","type":"text"},{"text":" ","type":"text"},{"text":"race between the check of ","type":"text"},{"code":"current_data","type":"codeVoice"},{"type":"text","text":" by the while loop in"},{"text":" ","type":"text"},{"type":"codeVoice","code":"pop_data()"},{"text":" and waiting. Specifically, another thread could set","type":"text"},{"type":"text","text":" "},{"type":"codeVoice","code":"current_data"},{"text":" after the check, and signal the cond (with nobody","type":"text"},{"type":"text","text":" "},{"type":"text","text":"waiting on it) before the first thread goes to sleep. "},{"type":"reference","identifier":"doc:\/\/GLib\/documentation\/GLib\/Cond","isActive":true},{"type":"text","text":" is"},{"type":"text","text":" "},{"text":"specifically useful for its ability to release the mutex and go","type":"text"},{"text":" ","type":"text"},{"type":"text","text":"to sleep atomically."}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"It is also important to use the "},{"code":"g_cond_wait()","type":"codeVoice"},{"type":"text","text":" and "},{"type":"codeVoice","code":"g_cond_wait_until()"},{"type":"text","text":" "},{"type":"text","text":"functions only inside a loop which checks for the condition to be"},{"type":"text","text":" "},{"type":"text","text":"true.  See "},{"type":"codeVoice","code":"g_cond_wait()"},{"text":" for an explanation of why the condition may","type":"text"},{"type":"text","text":" "},{"text":"not be true even after it returns.","type":"text"}]},{"inlineContent":[{"type":"text","text":"If a "},{"type":"reference","identifier":"doc:\/\/GLib\/documentation\/GLib\/Cond","isActive":true},{"text":" is allocated in static storage then it can be used","type":"text"},{"text":" ","type":"text"},{"text":"without initialisation.  Otherwise, you should call ","type":"text"},{"type":"codeVoice","code":"g_cond_init()"},{"type":"text","text":" "},{"text":"on it and ","type":"text"},{"type":"codeVoice","code":"g_cond_clear()"},{"type":"text","text":" when done."}],"type":"paragraph"},{"inlineContent":[{"type":"text","text":"A "},{"identifier":"doc:\/\/GLib\/documentation\/GLib\/Cond","type":"reference","isActive":true},{"text":" should only be accessed via the g_cond_ functions.","type":"text"}],"type":"paragraph"},{"type":"paragraph","inlineContent":[{"type":"text","text":"The "},{"isActive":true,"identifier":"doc:\/\/GLib\/documentation\/GLib\/Cond","type":"reference"},{"type":"text","text":" type acts as an owner of an underlying "},{"type":"codeVoice","code":"GCond"},{"type":"text","text":" instance."},{"text":" ","type":"text"},{"text":"It provides the methods that can operate on this data type through ","type":"text"},{"isActive":true,"identifier":"doc:\/\/GLib\/documentation\/GLib\/CondProtocol","type":"reference"},{"type":"text","text":" conformance."},{"text":" ","type":"text"},{"type":"text","text":"Use "},{"isActive":true,"identifier":"doc:\/\/GLib\/documentation\/GLib\/Cond","type":"reference"},{"type":"text","text":" as a strong reference or owner of a "},{"code":"GCond","type":"codeVoice"},{"text":" instance.","type":"text"}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"Use "},{"isActive":true,"type":"reference","identifier":"doc:\/\/GLib\/documentation\/GLib\/CondRef"},{"text":" (instead of ","type":"text"},{"type":"reference","identifier":"doc:\/\/GLib\/documentation\/GLib\/Cond","isActive":true},{"text":") for a lightweight Swift reference to an underlying ","type":"text"},{"type":"codeVoice","code":"GCond"},{"type":"text","text":" instance."}]}],"type":"aside","style":"note","name":"Note"}]}],"references":{"doc://GLib/documentation/GLib/Cond/init(raw:)-91iij":{"kind":"symbol","identifier":"doc:\/\/GLib\/documentation\/GLib\/Cond\/init(raw:)-91iij","url":"\/documentation\/glib\/cond\/init(raw:)-91iij","fragments":[{"text":"init","kind":"identifier"},{"kind":"text","text":"("},{"kind":"externalParam","text":"raw"},{"text":": ","kind":"text"},{"text":"UnsafeRawPointer","kind":"typeIdentifier","preciseIdentifier":"s:SV"},{"text":")","kind":"text"}],"role":"symbol","abstract":[{"type":"text","text":"Unsafe untyped initialiser."},{"text":" ","type":"text"},{"inlineContent":[{"text":"Do not use unless you know the underlying data type the pointer points to conforms to ","type":"text"},{"identifier":"doc:\/\/GLib\/documentation\/GLib\/CondProtocol","type":"reference","isActive":true},{"text":".","type":"text"}],"type":"strong"}],"type":"topic","title":"init(raw:)"},"doc://GLib/doc