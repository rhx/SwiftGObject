{"hierarchy":{"paths":[["doc:\/\/GLib\/documentation\/GLib"]]},"kind":"article","variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/glib\/troubleshooting"]}],"sections":[],"schemaVersion":{"minor":3,"major":0,"patch":0},"abstract":[{"type":"text","text":"This section shows some common errors you might encounter and how to fix them."}],"primaryContentSections":[{"content":[{"anchor":"FFI-Module-Errors","text":"FFI Module Errors","type":"heading","level":2},{"inlineContent":[{"text":"On some versions of macOS, when Xcode is installed,","type":"text"},{"type":"text","text":" "},{"text":"there is a conflict between the FFI library module","type":"text"},{"text":" ","type":"text"},{"text":"available through Xcode and the command line tools.","type":"text"},{"text":" ","type":"text"},{"text":"This typically results in an error such as","type":"text"}],"type":"paragraph"},{"syntax":null,"code":["\/Applications\/Xcode.app\/Contents\/Developer\/Platforms\/MacOSX.platform\/Developer\/SDKs\/MacOSX14.2.sdk\/usr\/include\/ffi\/module.modulemap:1:8: error: redefinition of module 'FFI'","module FFI [system] {","       ^","\/Library\/Developer\/CommandLineTools\/SDKs\/MacOSX13.sdk\/usr\/include\/ffi\/module.modulemap:1:8: note: previously defined here","module FFI [system] [extern_c] {","       ^","error: fatalError"],"type":"codeListing"},{"inlineContent":[{"type":"text","text":"A way to resolve this is to remove the Command Line Tools."},{"type":"text","text":" "},{"text":"Alternatively, you can temporarily rename the CommandLineTools folder, i.e.","type":"text"}],"type":"paragraph"},{"code":["sudo mv \/Library\/Developer\/CommandLineTools{,.orig}"],"syntax":null,"type":"codeListing"},{"type":"paragraph","inlineContent":[{"type":"text","text":"Later you can move the folder back:"}]},{"syntax":null,"code":["sudo mv \/Library\/Developer\/CommandLineTools{.orig,}"],"type":"codeListing"},{"text":"Missing `.gir` Files","anchor":"Missing-gir-Files","level":2,"type":"heading"},{"type":"paragraph","inlineContent":[{"text":"If you get an error such as","type":"text"}]},{"code":["Girs located at","Cannot open '\/GLib-2.0.gir': No such file or directory"],"syntax":null,"type":"codeListing"},{"inlineContent":[{"type":"text","text":"Make sure that you have the relevant "},{"code":"gobject-introspection","type":"codeVoice"},{"type":"text","text":" packages installed (as per the Pre-requisites section), including their "},{"type":"codeVoice","code":".gir"},{"type":"text","text":" and "},{"code":".pc","type":"codeVoice"},{"text":" files.","type":"text"}],"type":"paragraph"},{"level":2,"type":"heading","anchor":"Old-Swift-toolchain-or-Xcode","text":"Old Swift toolchain or Xcode"},{"type":"paragraph","inlineContent":[{"text":"If, when you run ","type":"text"},{"type":"codeVoice","code":"swift build"},{"text":", you get a ","type":"text"},{"type":"codeVoice","code":"Segmentation fault (core dumped)"},{"text":" or circular dependency error such as","type":"text"}]},{"syntax":null,"type":"codeListing","code":["warning: circular dependency detected while parsing pangocairo: harfbuzz -> freetype2 -> harfbuzz"]},{"inlineContent":[{"type":"text","text":"this probably means that your Swift toolchain is too old, particularly on Linux."},{"text":" ","type":"text"},{"text":"Make sure the latest toolchain is the one that is found when you run the Swift compiler (see above).","type":"text"}],"type":"paragraph"},{"inlineContent":[{"text":"If you get an older version, make sure that the right version of the swift compiler is found first in your ","type":"text"},{"code":"PATH","type":"codeVoice"},{"type":"text","text":".  On macOS, use xcode-select to select and install the latest version, e.g.:"}],"type":"paragraph"},{"type":"codeListing","syntax":null,"code":["sudo xcode-select -s \/Applications\/Xcode.app","xcode-select --install"]}],"kind":"content"}],"metadata":{"modules":[{"name":"GLib"}],"title":"Troubleshooting","role":"article","roleHeading":"Article"},"identifier":{"interfaceLanguage":"swift","url":"doc:\/\/GLib\/documentation\/GLib\/Troubleshooting"},"references":{"doc://GLib/documentation/GLib":{"identifier":"doc:\/\/GLib\/documentation\/GLib","title":"GLib","abstract":[],"type":"topic","url":"\/documentation\/glib","kind":"symbol","role":"collection"}}}