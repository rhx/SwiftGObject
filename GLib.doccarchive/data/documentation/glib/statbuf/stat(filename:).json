","code":"_stat()"},{"type":"text","text":", "},{"type":"codeVoice","code":"_stat32()"},{"text":",","type":"text"},{"type":"text","text":" "},{"code":"_stat32i64()","type":"codeVoice"},{"text":" and ","type":"text"},{"type":"codeVoice","code":"_stat64i32()"},{"type":"text","text":". The one used here is for 32-bit code"},{"type":"text","text":" "},{"text":"the one with 32-bit size and time fields, specifically called ","type":"text"},{"code":"_stat32()","type":"codeVoice"},{"text":".","type":"text"}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"In Microsoft’s compiler, by default struct stat means one with"},{"text":" ","type":"text"},{"text":"64-bit time fields while in MinGW struct stat is the legacy one","type":"text"},{"text":" ","type":"text"},{"text":"with 32-bit fields. To hopefully clear up this messs, the gstdio.h","type":"text"},{"type":"text","text":" "},{"type":"text","text":"header defines a type "},{"identifier":"doc:\/\/GLib\/documentation\/GLib\/StatBuf","isActive":true,"type":"reference"},{"type":"text","text":" which is the appropriate struct type"},{"type":"text","text":" "},{"type":"text","text":"depending on the platform and\/or compiler being used. On POSIX it"},{"text":" ","type":"text"},{"type":"text","text":"is just struct stat, but note that even on POSIX platforms, "},{"code":"stat()","type":"codeVoice"},{"text":" ","type":"text"},{"text":"might be a macro.","type":"text"}]},{"inlineContent":[{"type":"text","text":"See your C library manual for more details about "},{"type":"codeVoice","code":"stat()"},{"type":"text","text":"."}],"type":"paragraph"}]}],"sections":[],"abstract":[{"type":"text","text":"A wrapper for the POSIX "},{"type":"codeVoice","code":"stat()"},{"text":" function. The ","type":"text"},{"code":"stat()","type":"codeVoice"},{"type":"text","text":" function"},{"text":" ","type":"text"},{"text":"returns information about a file. On Windows the ","type":"text"},{"type":"codeVoice","code":"stat()"},{"type":"text","text":" function in"},{"text":" ","type":"text"},{"text":"the C library checks only the FAT-style READONLY attribute and does","type":"text"},{"type":"text","text":" "},{"text":"not look at the ACL at all. Thus on Windows the protection bits in","type":"text"},{"text":" ","type":"text"},{"text":"the ","type":"text"},{"code":"st_mode","type":"codeVoice"},{"type":"text","text":" field are a fabrication of little use."}],"identifier":{"interfaceLanguage":"swift","url":"doc:\/\/GLib\/documentation\/GLib\/StatBuf\/stat(filename:)"},"variants":[{"paths":["\/documentation\/glib\/statbuf\/stat(filename:)"],"traits":[{"interfaceLanguage":"swift"}]}],"references":{"doc://GLib/documentation/GLib/StatBuf/StatBufProtocol-Implementations":{"abstract":[],"title":"StatBufProtocol Implementations","url":"\/documentation\/glib\/statbuf\/statbufprotocol-implementations","kind":"article","role":"collectionGroup","identifier":"doc:\/\/GLib\/documentation\/GLib\/StatBuf\/StatBufProtocol-Implementations","type":"topic"},"doc://GLib/documentation/GLib/StatBuf/stat(filename:)":{"role":"symbol","fragments":[{"kind":"keyword","text":"func"},{"text":" ","kind":"text"},{"text":"stat","kind":"identifier"},{"text":"(","kind":"text"},{"text":"filename","kind":"externalParam"},{"kind":"text","text":": "},{"text":"UnsafePointer","kind":"typeIdentifier","preciseIdentifier":"s:SP"},{"text":"<","kind":"text"},{"preciseIdentifier":"c:@T@gchar","text":"gchar","kind":"typeIdentifier"},{"text":">!) -> ","kind":"text"},{"preciseIdentifier":"s:Si","text":"Int","kind":"typeIdentifier"}],"kind":"symbol","title":"stat(filename:)","type":"topic","abstract":[{"text":"A wrapper for the POSIX ","type":"text"},{"type":"codeVoice","code":"stat()"},{"text":" function. The ","type":"text"},{"type":"codeVoice","code":"stat()"},{"type":"text","text":" function"},{"type":"text","text":" "},{"text":"returns information about a file. On Windows the ","type":"text"},{"code":"stat()","type":"codeVoice"},{"text":" function 