{"identifier":{"url":"doc:\/\/GLibObject\/documentation\/GLibObject\/Closure","interfaceLanguage":"swift"},"schemaVersion":{"minor":3,"patch":0,"major":0},"topicSections":[{"anchor":"Initializers","title":"Initializers","generated":true,"identifiers":["doc:\/\/GLibObject\/documentation\/GLibObject\/Closure\/init(_:)-3dal7","doc:\/\/GLibObject\/documentation\/GLibObject\/Closure\/init(_:)-3g7pp","doc:\/\/GLibObject\/documentation\/GLibObject\/Closure\/init(_:)-3sg1w","doc:\/\/GLibObject\/documentation\/GLibObject\/Closure\/init(_:)-6iibg","doc:\/\/GLibObject\/documentation\/GLibObject\/Closure\/init(_:)-8g8g2","doc:\/\/GLibObject\/documentation\/GLibObject\/Closure\/init(cPointer:)","doc:\/\/GLibObject\/documentation\/GLibObject\/Closure\/init(gconstpointer:)","doc:\/\/GLibObject\/documentation\/GLibObject\/Closure\/init(gpointer:)","doc:\/\/GLibObject\/documentation\/GLibObject\/Closure\/init(object:object:)","doc:\/\/GLibObject\/documentation\/GLibObject\/Closure\/init(opaquePointer:)","doc:\/\/GLibObject\/documentation\/GLibObject\/Closure\/init(raw:)-26247","doc:\/\/GLibObject\/documentation\/GLibObject\/Closure\/init(raw:)-797bm","doc:\/\/GLibObject\/documentation\/GLibObject\/Closure\/init(retaining:)","doc:\/\/GLibObject\/documentation\/GLibObject\/Closure\/init(retainingCPointer:)","doc:\/\/GLibObject\/documentation\/GLibObject\/Closure\/init(retainingOpaquePointer:)","doc:\/\/GLibObject\/documentation\/GLibObject\/Closure\/init(retainingRaw:)-16wjq","doc:\/\/GLibObject\/documentation\/GLibObject\/Closure\/init(retainingRaw:)-7dv4s","doc:\/\/GLibObject\/documentation\/GLibObject\/Closure\/init(simple:data:)"]},{"title":"Instance Properties","identifiers":["doc:\/\/GLibObject\/documentation\/GLibObject\/Closure\/ptr"],"anchor":"Instance-Properties","generated":true},{"identifiers":["doc:\/\/GLibObject\/documentation\/GLibObject\/Closure\/new(object:object:)","doc:\/\/GLibObject\/documentation\/GLibObject\/Closure\/new(simple:data:)"],"title":"Type Methods","anchor":"Type-Methods","generated":true},{"generated":true,"identifiers":["doc:\/\/GLibObject\/documentation\/GLibObject\/Closure\/ClosureProtocol-Implementations"],"title":"Default Implementations","anchor":"Default-Implementations"}],"hierarchy":{"paths":[["doc:\/\/GLibObject\/documentation\/GLibObject"]]},"sections":[],"relationshipsSections":[{"identifiers":["doc:\/\/GLibObject\/documentation\/GLibObject\/ClosureProtocol","doc:\/\/GLibObject\/4GLib14PointerWrapperP"],"kind":"relationships","title":"Conforms To","type":"conformsTo"}],"kind":"symbol","primaryContentSections":[{"declarations":[{"platforms":["macOS"],"languages":["swift"],"tokens":[{"text":"class","kind":"keyword"},{"kind":"text","text":" "},{"text":"Closure","kind":"identifier"}]}],"kind":"declarations"},{"content":[{"type":"heading","level":2,"text":"Overview","anchor":"overview"},{"type":"paragraph","inlineContent":[{"type":"text","text":"It will generally comprise a function of some kind and a marshaller"},{"text":" ","type":"text"},{"text":"used to call it. It is the responsibility of the marshaller to","type":"text"},{"text":" ","type":"text"},{"type":"text","text":"convert the arguments for the invocation from "},{"identifier":"#struct@Value","isActive":true,"type":"reference"},{"type":"text","text":" into"},{"text":" ","type":"text"},{"type":"text","text":"a suitable form, perform the callback on the converted arguments,"},{"type":"text","text":" "},{"type":"text","text":"and transform the return value back into a [struct"},{"identifier":"doc:\/\/GLibObject\/documentation\/GLibObject\/Value","isActive":true,"type":"reference"},{"type":"text","text":"]."}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"In the case of C programs, a closure usually just holds a pointer"},{"type":"text","text":" "},{"type":"text","text":"to a function and maybe a data argument, and the marshaller"},{"type":"text","text":" "},{"text":"converts between [struct","type":"text"},{"identifier":"doc:\/\/GLibObject\/documentation\/GLibObject\/Value","isActive":true,"type":"reference"},{"text":"] and native C types. The GObject","type":"text"},{"text":" ","type":"text"},{"type":"text","text":"library provides the [struct"},{"isActive":true,"type":"reference","identifier":"doc:\/\/GLibObject\/documentation\/GLibObject\/CClosure"},{"type":"text","text":"] type for this purpose. Bindings for"},{"type":"text","text":" "},{"text":"other languages need marshallers which convert between ","type":"text"},{"overridingTitle":"GValues","type":"reference","isActive":true,"identifier":"#struct@Value","overridingTitleInlineContent":[{"type":"text","text":"GValues"}]},{"type":"text","text":" "},{"text":"and suitable representations in the runtime of the language in","type":"text"},{"type":"text","text":" "},{"text":"order to use functions written in that language as callbacks. Use","type":"text"},{"text":" ","type":"text"},{"text":"[method","type":"text"},{"code":"Closure.set_marshal","type":"codeVoice"},{"type":"text","text":"] to set the marshaller on such a custom"},{"text":" ","type":"text"},{"text":"closure implementation.","type":"text"}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"Within GObject, closures play an important role in the"},{"type":"text","text":" "},{"text":"implementation of signals. When a signal is registered, the","type":"text"},{"type":"text","text":" "},{"type":"codeVoice","code":"c_marshaller"},{"type":"text","text":" argument to [func"},{"type":"codeVoice","code":"signal_new"},{"type":"text","text":"] specifies the default C"},{"text":" ","type":"text"},{"type":"text","text":"marshaller for any closure which is connected to this"},{"text":" ","type":"text"},{"text":"signal. GObject provides a number of C marshallers for this","type":"text"},{"type":"text","text":" "},{"type":"text","text":"purpose, see the "},{"type":"codeVoice","code":"g_cclosure_marshal_*()"},{"text":" functions. Additional C","type":"text"},{"type":"text","text":" "},{"type":"text","text":"marshallers can be generated with the "},{"identifier":"#glib-genmarshal","isActive":true,"type":"reference"},{"text":" ","type":"text"},{"type":"text","text":"utility.  Closures can be explicitly connected to signals with"},{"type":"text","text":" "},{"text":"[func","type":"text"},{"type":"codeVoice","code":"signal_connect_closure"},{"text":"], but it usually more convenient to let","type":"text"},{"type":"text","text":" "},{"text":"GObject create a closure automatically by using one of the","type":"text"},{"type":"text","text":" "},{"type":"codeVoice","code":"g_signal_connect_*()"},{"type":"text","text":" functions which take a callback function\/user"},{"type":"text","text":" "},{"type":"text","text":"data pair."}]},{"inlineContent":[{"type":"text","text":"Using closures has a number of important advantages over a simple"},{"type":"text","text":" "},{"type":"text","text":"callback function\/data pointer combination:"}],"type":"paragraph"},{"items":[{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"Closures allow the callee to get the types of the callback parameters,"},{"type":"text","text":" "},{"text":"which means that language bindings don’t have to write individual glue","type":"text"},{"text":" ","type":"text"},{"type":"text","text":"for each callback type."}]}]},{"content":[{"inlineContent":[{"text":"The reference counting of [struct","type":"text"},{"identifier":"doc:\/\/GLibObject\/documentation\/GLibObject\/Closure","type":"reference","isActive":true},{"type":"text","text":"] makes it easy to handle reentrancy"},{"type":"text","text":" "},{"type":"text","text":"right; if a callback is removed while it is being invoked, the closure"},{"type":"text","text":" "},{"type":"text","text":"and its parameters won’t be freed until the invocation finishes."}],"type":"paragraph"}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"[method"},{"code":"Closure.invalidate","type":"codeVoice"},{"text":"] and invalidation notifiers allow callbacks to be","type":"text"},{"type":"text","text":" "},{"text":"automatically removed when the objects they point to go away.","type":"text"}]}]}],"type":"unorderedList"},{"type":"paragraph","inlineContent":[{"type":"text","text":"The "},{"isActive":true,"identifier":"doc:\/\/GLibObject\/documentation\/GLibObject\/Closure","type":"reference"},{"type":"text","text":" type acts as a reference-counted owner of an underlying "},{"type":"codeVoice","code":"GClosure"},{"type":"text","text":" instance."},{"text":" ","type":"text"},{"type":"text","text":"It provides the methods that can operate on this data type through "},{"type":"reference","identifier":"doc:\/\/GLibObject\/documentation\/GLibObject\/ClosureProtocol","isActive":true},{"type":"text","text":" conformance."},{"type":"text","text":" "},{"type":"text","text":"Use "},{"isActive":true,"type":"reference","identifier":"doc:\/\/GLibObject\/documentation\/GLibObject\/Closure"},{"text":" as a strong reference or owner of a ","type":"text"},{"type":"codeVoice","code":"GClosure"},{"type":"text","text":" instance."}]},{"name":"Note","style":"note","type":"aside","content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"Use "},{"type":"reference","identifier":"doc:\/\/GLibObject\/documentation\/GLibObject\/ClosureRef","isActive":true},{"type":"text","text":" (instead of "},{"isActive":true,"type":"reference","identifier":"doc:\/\/GLibObject\/documentation\/GLibObject\/Closure"},{"type":"text","text":") for a lightweight Swift reference to an underlying "},{"type":"codeVoice","code":"GClosure"},{"type":"text","text":" instance."}]}]}],"kind":"content"}],"metadata":{"externalID":"s:10GLibObject7ClosureC","role":"symbol","title":"Closure","symbolKind":"class","fragments":[{"text":"class","kind":"keyword"},{"kind":"text","text":" "},{"text":"Closure","kind":"identifier"}],"modules":[{"name":"GLibObject"}],"roleHeading":"Class","navigatorTitle":[{"kind":"identifier","text":"Closure"}]},"abstract":[{"type":"text","text":"A "},{"code":"GClosure","type":"codeVoice"},{"type":"text","text":" represents a callback supplied by the programmer."}],"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/glibobject\/closure"]}],"references":{"doc://GLibObject/documentation/GLibObject/Closure/init(_:)-3sg1w":{"kind":"symbol","fragments":[{"kind":"identifier","text":"init"},{"kind":"text","text":"!("},{"preciseIdentifier":"s:Sp","text":"UnsafeMutablePointer","kind":"typeIdentifier"},{"kind":"text","text":"<"},{"text":"GClosure","kind":"typeIdentifier"},{"kind":"text","text":">?)"}],"abstract":[{"type":"text","text":"Optional initialiser from the underlying "},{"type":"codeVoice","code":"C"},{"type":"text","text":" data type."},{"type":"text","text":" "},{"type":"text","text":"This creates an instance without performing an unbalanced retain"},{"text":" ","type":"text"},{"text":"i.e., ownership is transferred to the ","type":"text"},{"type":"reference","identifier":"doc:\/\/GLibObject\/documentation\/GLibObject\/Closure","isActive":true},{"text":" instance.","type":"text"}],"type":"topic","identifier":"doc:\/\/GLibObject\/documentation\/GLibObject\/Closure\/init(_:)-3sg1w","url":"\/documentation\/glibobject\/closure\/init(_:)-3sg1w","role":"symbol","title":"init(_:)"},"doc://GLibObject/documentation/GLibObject/Closure/init(retaining:)":{"abstract":[{"type":"text","text":"Designated initialiser from the underlying "},{"type":"codeVoice","code":"C"},{"type":"text","text":" data type."},{"type":"text","text":" "},{"type":"text","text":"Will retain "},{"type":"codeVoice","code":"GClosure"},{"type":"text","text":"."},{"type":"text","text":" "},{"type":"text","text":"i.e., ownership is transferred to the "},{"isActive":true,"type":"reference","identifier":"doc:\/\/GLibObject\/documentation\/GLibObject\/Closure"},{"type":"text","text":" instance."}],"title":"init(retaining:)","role":"symbol","type":"topic","kind":"symbol","identifier":"