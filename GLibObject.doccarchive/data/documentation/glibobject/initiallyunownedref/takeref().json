{"abstract":[{"type":"text","text":"If "},{"type":"codeVoice","code":"object"},{"text":" is floating, sink it.  Otherwise, do nothing.","type":"text"}],"hierarchy":{"paths":[["doc:\/\/GLibObject\/documentation\/GLibObject","doc:\/\/GLibObject\/documentation\/GLibObject\/InitiallyUnownedRef","doc:\/\/GLibObject\/documentation\/GLibObject\/InitiallyUnownedRef\/ObjectProtocol-Implementations"]]},"primaryContentSections":[{"kind":"declarations","declarations":[{"languages":["swift"],"tokens":[{"kind":"keyword","text":"func"},{"kind":"text","text":" "},{"text":"takeRef","kind":"identifier"},{"text":"() -> ","kind":"text"},{"identifier":"doc:\/\/GLibObject\/documentation\/GLibObject\/ObjectRef","preciseIdentifier":"s:10GLibObject0B3RefV","kind":"typeIdentifier","text":"ObjectRef"},{"text":"!","kind":"text"}],"platforms":["macOS"]}]},{"kind":"content","content":[{"level":2,"anchor":"discussion","text":"Discussion","type":"heading"},{"inlineContent":[{"type":"text","text":"In other words, this function will convert a floating reference (if"},{"type":"text","text":" "},{"type":"text","text":"present) into a full reference."}],"type":"paragraph"},{"type":"paragraph","inlineContent":[{"text":"Typically you want to use ","type":"text"},{"code":"g_object_ref_sink()","type":"codeVoice"},{"type":"text","text":" in order to"},{"text":" ","type":"text"},{"type":"text","text":"automatically do the correct thing with respect to floating or"},{"text":" ","type":"text"},{"text":"non-floating references, but there is one specific scenario where","type":"text"},{"type":"text","text":" "},{"text":"this function is helpful.","type":"text"}]},{"inlineContent":[{"text":"The situation where this function is helpful is when creating an API","type":"text"},{"text":" ","type":"text"},{"type":"text","text":"that allows the user to provide a callback function that returns a"},{"type":"text","text":" "},{"type":"text","text":"GObject. We certainly want to allow the user the flexibility to"},{"type":"text","text":" "},{"text":"return a non-floating reference from this callback (for the case","type":"text"},{"type":"text","text":" "},{"type":"text","text":"where the object that is being returned already exists)."}],"type":"paragraph"},{"type":"paragraph","inlineContent":[{"type":"text","text":"At the same time, the API style of some popular GObject-based"},{"type":"text","text":" "},{"text":"libraries (such as Gtk) make it likely that for newly-created GObject","type":"text"},{"type":"text","text":" "},{"type":"text","text":"instances, the user can be saved some typing if they are allowed to"},{"text":" ","type":"text"},{"type":"text","text":"return a floating reference."}]},{"inlineContent":[{"type":"text","text":"Using this function on the return value of the user’s callback allows"},{"text":" ","type":"text"},{"type":"text","text":"the user to do whichever is more convenient for them. The caller will"},{"type":"text","text":" "},{"type":"text","text":"always receives exactly one full reference to the value: either the"},{"type":"text","text":" "},{"text":"one that was returned in the first place, or a floating reference","type":"text"},{"type":"text","text":" "},{"text":"that has been converted to a full reference.","type":"text"}],"type":"paragraph"},{"type":"paragraph","inlineContent":[{"type":"text","text":"This function has an odd interaction when combined with"},{"type":"text","text":" "},{"code":"g_object_ref_sink()","type":"codeVoice"},{"text":" running at the same time in another thread on","type":"text"},{"text":" ","type":"text"},{"type":"text","text":"the same "},{"isActive":true,"type":"reference","identifier":"doc:\/\/GLibObject\/documentation\/GLibObject\/Object"},{"type":"text","text":" instance. If "},{"type":"codeVoice","code":"g_object_ref_sink()"},{"text":" runs first then","type":"text"},{"text":" ","type":"text"},{"type":"text","text":"the result will be that the floating reference is converted to a hard"},{"type":"text","text":" "},{"text":"reference. If ","type":"text"},{"type":"codeVoice","code":"g_object_take_ref()"},{"type":"text","text":" runs first then the result will be"},{"type":"text","text":" "},{"type":"text","text":"that the floating reference is converted to a hard reference and an"},{"type":"text","text":" "},{"text":"additional reference on top of that one is added. It is best to avoid","type":"text"},{"type":"text","text":" "},{"text":"this situation.","type":"text"}]}]}],"sections":[],"schemaVersion":{"major":0,"minor":3,"patch":0},"identifier":{"url":"doc:\/\/GLibObject\/documentation\/GLibObject\/InitiallyUnownedRef\/takeRef()","interfaceLanguage":"swift"},"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/glibobject\/initiallyunownedref\/takeref()"]}],"kind":"symbol","metadata":{"modules":[{"name":"GLibObject"}],"externalID":"s:10GLibObject0B8ProtocolPAAE7takeRefAA0bE0VSgyF::SYNTHESIZED::s:10GLibObject19InitiallyUnownedRefV","extendedModule":"GLibObject","title":"takeRef()","roleHeading":"Instance Method","symbolKind":"method","role":"symbol","fragments":[{"kind":"keyword","text":"func"},{"text":" ","kind":"text"},{"kind":"identifier","text":"takeRef"},{"text":"() -> ","kind":"text"},{"preciseIdentifier":"s:10GLibObject0B3RefV","kind":"typeIdentifier","text":"ObjectRef"},{"text":"!","kind":"text"}]},"references":{"doc://GLibObject/documentation/GLibObject/InitiallyUnownedRef/ObjectProtocol-Implementations":{"title":"ObjectProtocol Implementations","abstract":[],"role":"collectionGroup","identifier":"doc:\/\/GLibObject\/documentation\/GLibObject\/InitiallyUnownedRef\/ObjectProtocol-Implementations","url":"\/documentation\/glibobject\/initiallyunownedref\/objectprotocol-implementations","kind":"article","type":"topic"},"doc://GLibObject/documentation/GLibObject":{"role":"collection","identifier":"doc:\/\/GLibObject\/documentation\/GLibObject","type":"topic","url":"\/documentation\/glibobject","title":"GLibObject","abstract":[],"kind":"symbol"},"doc://GLibObject/documentation/GLibObject/Object":{"navigatorTitle":[{"text":"Object","kind":"identifier"}],"type":"topic","url":"\/documentation\/glibobject\/object","identifier":"doc:\/\/GLibObject\/documentation\/GLibObject\/Object","abstract":[{"type":"text","text":"The base object type."}],"kind":"symbol","title":"Object","role":"symbol","fragments":[{"kind":"keyword","text":"class"},{"kind":"text","text":" "},{"kind":"identifier","text":"Object"}]},"doc://GLibObject/documentation/GLibObject/InitiallyUnownedRef/takeRef()":{"identifier":"doc:\/\/GLibObject\/documentation\/GLibObject\/InitiallyUnownedRef\/takeRef()","url":"\/documentation\/glibobject\/initiallyunownedref\/takeref()","fragments":[{"kind":"keyword","text":"func"},{"text":" ","kind":"text"},{"kind":"identifier","text":"takeRef"},{"kind":"text","text":"() -> "},{"preciseIdentifier":"s:10GLibObject0B3RefV","kind":"typeIdentifier","text":"ObjectRef"},{"text":"!","kind":"text"}],"title":"takeRef()","kind":"symbol","role":"symbol","abstract":[{"text":"If ","type":"text"},{"code":"object","type":"codeVoice"},{"text":" is floating, sink it.  Otherwise, do nothing.","type":"text"}],"type":"topic"},"doc://GLibObject/documentation/GLibObject/InitiallyUnownedRef":{"kind":"symbol","abstract":[{"type":"text","text":"A type for objects that have an initially floating reference."}],"title":"InitiallyUnownedRef","fragments":[{"text":"struct","kind":"keyword"},{"kind":"text","text":" "},{"text":"InitiallyUnownedRef","kind":"identifier"}],"url":"\/documentation\/glibobject\/initiallyunownedref","type":"topic","identifier":"doc:\/\/GLibObject\/documentation\/GLibObject\/InitiallyUnownedRef","role":"symbol","navigatorTitle":[{"kind":"identifier","text":"InitiallyUnownedRef"}]},"doc://GLibObject/documentation/GLibObject/ObjectRef":{"fragments":[{"text":"struct","kind":"keyword"},{"kind":"text","text":" "},{"text":"ObjectRef","kind":"identifier"}],"type":"topic","kind":"symbol","navigatorTitle":[{"text":"ObjectRef","kind":"identifier"}],"abstract":[{"text":"The base object type.","type":"text"}],"identifier":"doc:\/\/GLibObject\/documentation\/GLibObject\/ObjectRef","url":"\/documentation\/glibobject\/objectref","role":"symbol","title":"ObjectRef"}}}