{"metadata":{"roleHeading":"Protocol","externalID":"s:10GLibObject18TypePluginProtocolP","title":"TypePluginProtocol","navigatorTitle":[{"kind":"identifier","text":"TypePluginProtocol"}],"symbolKind":"protocol","role":"symbol","modules":[{"name":"GLibObject"}],"fragments":[{"kind":"keyword","text":"protocol"},{"kind":"text","text":" "},{"kind":"identifier","text":"TypePluginProtocol"}]},"schemaVersion":{"major":0,"patch":0,"minor":3},"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/glibobject\/typepluginprotocol"]}],"kind":"symbol","identifier":{"url":"doc:\/\/GLibObject\/documentation\/GLibObject\/TypePluginProtocol","interfaceLanguage":"swift"},"primaryContentSections":[{"kind":"declarations","declarations":[{"tokens":[{"kind":"keyword","text":"protocol"},{"text":" ","kind":"text"},{"text":"TypePluginProtocol","kind":"identifier"},{"text":" : ","kind":"text"},{"preciseIdentifier":"s:4GLib14PointerWrapperP","kind":"typeIdentifier","text":"PointerWrapper"}],"platforms":["macOS"],"languages":["swift"]}]},{"content":[{"text":"Overview","anchor":"overview","type":"heading","level":2},{"type":"paragraph","inlineContent":[{"type":"text","text":"The GObject type system supports dynamic loading of types."},{"type":"text","text":" "},{"text":"It goes as follows:","type":"text"}]},{"items":[{"content":[{"type":"paragraph","inlineContent":[{"text":"The type is initially introduced (usually upon loading the module","type":"text"},{"type":"text","text":" "},{"text":"the first time, or by your main application that knows what modules","type":"text"},{"type":"text","text":" "},{"text":"introduces what types), like this:","type":"text"}]},{"syntax":"c","code":["new_type_id = g_type_register_dynamic (parent_type_id,","                                       \"TypeName\",","                                       new_type_plugin,","                                       type_flags);"],"type":"codeListing"},{"inlineContent":[{"text":"where ","type":"text"},{"type":"codeVoice","code":"new_type_plugin"},{"type":"text","text":" is an implementation of the"},{"text":" ","type":"text"},{"code":"GTypePlugin","type":"codeVoice"},{"type":"text","text":" interface."}],"type":"paragraph"}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"The type’s implementation is referenced, e.g. through"},{"type":"text","text":" "},{"text":"[func","type":"text"},{"type":"codeVoice","code":"GObject.TypeClass.ref"},{"type":"text","text":"] or through [func"},{"type":"codeVoice","code":"GObject.type_create_instance"},{"text":"]","type":"text"},{"type":"text","text":" "},{"type":"text","text":"(this is being called by [ctor"},{"type":"codeVoice","code":"GObject.Object.new"},{"text":"]) or through one of the above","type":"text"},{"text":" ","type":"text"},{"text":"done on a type derived from ","type":"text"},{"code":"new_type_id","type":"codeVoice"},{"text":".","type":"text"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"This causes the type system to load the type’s implementation by calling"},{"type":"text","text":" "},{"type":"text","text":"[method"},{"code":"GObject.TypePlugin.use","type":"codeVoice"},{"text":"] and [method","type":"text"},{"type":"codeVoice","code":"GObject.TypePlugin.complete_type_info"},{"text":"]","type":"text"},{"type":"text","text":" "},{"text":"on ","type":"text"},{"type":"codeVoice","code":"new_type_plugin"},{"type":"text","text":"."}]}]},{"content":[{"inlineContent":[{"type":"text","text":"At some point the type’s implementation isn’t required anymore, e.g. after"},{"type":"text","text":" "},{"text":"[method","type":"text"},{"type":"codeVoice","code":"GObject.TypeClass.unref"},{"text":"] or [func","type":"text"},{"code":"GObject.type_free_instance","type":"codeVoice"},{"type":"text","text":"]"},{"type":"text","text":" "},{"type":"text","text":"(called when the reference count of an instance drops to zero)."}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"type":"text","text":"This causes the type system to throw away the information retrieved"},{"type":"text","text":" "},{"text":"from [method","type":"text"},{"code":"GObject.TypePlugin.complete_type_info","type":"codeVoice"},{"type":"text","text":"] and then it calls"},{"type":"text","text":" "},{"text":"[method","type":"text"},{"type":"codeVoice","code":"GObject.TypePlugin.unuse"},{"text":"] on ","type":"text"},{"type":"codeVoice","code":"new_type_plugin"},{"text":".","type":"text"}],"type":"paragraph"}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"Things may repeat from the second step."}]}]}],"type":"orderedList"},{"inlineContent":[{"type":"text","text":"So basically, you need to implement a "},{"code":"GTypePlugin","type":"codeVoice"},{"type":"text","text":" type that"},{"type":"text","text":" "},{"text":"carries a use_count, once use_count goes from zero to one, you need","type":"text"},{"text":" ","type":"text"},{"type":"text","text":"to load the implementation to successfully handle the upcoming"},{"type":"text","text":" "},{"text":"[method","type":"text"},{"type":"codeVoice","code":"GObject.TypePlugin.complete_type_info"},{"type":"text","text":"] call. Later, maybe after"},{"text":" ","type":"text"},{"type":"text","text":"succeeding use\/unuse calls, once use_count drops to zero, you can"},{"type":"text","text":" "},{"type":"text","text":"unload the implementation again. The type system makes sure to call"},{"type":"text","text":" "},{"type":"text","text":"[method"},{"code":"GObject.TypePlugin.use","type":"codeVoice"},{"type":"text","text":"] and [method"},{"code":"GObject.TypePlugin.complete_type_info","type":"codeVoice"},{"type":"text","text":"]"},{"type":"text","text":" "},{"type":"text","text":"again when the type is needed again."}],"type":"paragraph"},{"type":"paragraph","inlineContent":[{"type":"text","text":"[class"},{"identifier":"doc:\/\/GLibObject\/documentation\/GLibObject\/TypeModule","type":"reference","isActive":true},{"type":"text","text":"] is an implementation of "},{"type":"codeVoice","code":"GTypePlugin"},{"type":"text","text":" that"},{"type":"text","text":" "},{"type":"text","text":"already implements most of this except for the actual module loading and"},{"text":" ","type":"text"},{"text":"unloading. It even handles multiple registered types per module.","type":"text"}]},{"type":"paragraph","inlineContent":[{"text":"The ","type":"text"},{"isActive":true,"type":"reference","identifier":"doc:\/\/GLibObject\/documentation\/GLibObject\/TypePluginProtocol"},{"type":"text","text":" protocol exposes the methods and properties of an underlying "},{"code":"GTypePlugin","type":"codeVoice"},{"type":"text","text":" instance."},{"type":"text","text":" "},{"text":"The default implementation of these can be found in the protocol extension below.","type":"text"},{"type":"text","text":" "},{"text":"For a concrete class that implements these methods and properties, see ","type":"text"},{"isActive":true,"identifier":"doc:\/\/GLibObject\/documentation\/GLibObject\/TypePlugin","type":"reference"},{"text":".","type":"text"},{"type":"text","text":" "},{"text":"Alternatively, use ","type":"text"},{"isActive":true,"type":"reference","identifier":"doc:\/\/GLibObject\/documentation\/GLibObject\/TypePluginRef"},{"type":"text","text":" as a lighweight, "},{"type":"codeVoice","code":"unowned"},{"type":"text","text":" reference if you already have an instance you just want to use."}]}],"kind":"content"}],"relationshipsSections":[{"type":"inheritsFrom","identifiers":["doc:\/\/GLibObject\/4GLib14PointerWrapperP"],"title":"Inherits From","kind":"relationships"},{"type":"inheritedBy","title":"Inherited By","kind":"relationships","identifiers":["doc:\/\/GLibObject\/documentation\/GLibObject\/TypeModuleProtocol"]},{"type":"conformingTypes","title":"Conforming Types","identifiers":["doc:\/\/GLibObject\/documentation\/GLibObject\/TypeModule","doc:\/\/GLibObject\/documentation\/GLibObject\/TypeModuleRef","doc:\/\/GLibObject\/documentation\/GLibObject\/TypePlugin","doc:\/\/GLibObject\/documentation\/GLibObject\/TypePluginRef"],"kind":"relationships"}],"abstract":[{"type":"text","text":"An interface that handles the lifecycle of dynamically loaded types."}],"hierarchy":{"paths":[["doc:\/\/GLibObject\/documentation\/GLibObject"]]},"topicSections":[{"anchor":"Instance-Properties","generated":true,"identifiers":["doc:\/\/GLibObject\/documentation\/GLibObject\/TypePluginProtocol\/type_plugin_ptr-1f7zf"],"title":"Instance Properties"},{"title":"Instance Methods","anchor":"Instance-Methods","generated":true,"identifiers":["doc:\/\/GLibObject\/documentation\/GLibObject\/TypePluginProtocol\/completeInterfaceInfo(instanceType:interfaceType:info:)","doc:\/\/GLibObject\/documentation\/GLibObject\/TypePluginProtocol\/completeTypeInfo(gType:info:valueTable:)","doc:\/\/GLibObject\/documentation\/GLibObject\/TypePluginProtocol\/typeAddInterfaceDynamic(instanceType:interfaceType:)","doc:\/\/GLibObject\/documentation\/GLibObject\/TypePluginProtocol\/typeRegisterDynamic(parentType:typeName:flags:)","doc:\/\/GLibObject\/documentation\/GLibObject\/TypePluginProtocol\/unuse()","doc:\/\/GLibObject\/documentation\/GLibObject\/TypePluginProtocol\/use()"]}],"sections":[],"references":{"doc://GLibObject/documentation/GLibObject/TypePluginProtocol/completeTypeInfo(gType:info:valueTable:)":{"role":"symbol","identifier":"doc:\/\/GLibObject\/documentation\/GLibObject\/TypePluginProtocol\/completeTypeInfo(gType:info:valueTable:)","type":"topic","url":"\/documentation\/glibobject\/typepluginprotocol\/completetypeinfo(gtype:info:valuetable:)","title":"completeTypeInfo(gType:info:valueTable:)","abstract":[{"text":"Calls the ","type":"text"},{"type":"codeVoice","code":"complete_type_info"},{"type":"text","text":" function from the "},{"type":"reference","identifier":"doc:\/\/GLibObject\/documentation\/GLibObject\/TypePluginClass","isActive":true},{"type":"text","text":" of "},{"code":"plugin","type":"codeVoice"},{"text":".","type":"text"},{"type":"text","text":" "},{"text":"There should be no need to use this function outside of the GObject","type":"text"},{"type":"text","text":" "},{"type":"text","text":"type system itself."}],"kind":"symbol","fragments":[{"kind":"keyword","text":"func"},{"text":" ","kind":"text"},{"kind":"identifier","text":"completeTypeInfo"},{"text":"<","kind":"text"},{"text":"TypeInfoT","kind":"genericParameter"},{"text":", ","kind":"text"},{"text":"TypeValueTableT","kind":"genericParameter"},{"text":">(","kind":"text"},{"kind":"externalParam","text":"gType"},{"kind":"text","text":": "},{"kind":"typeIdentifier","text":"GType","preciseIdentifier":"c:@T@GType"},{"kind":"text","text":", "},{"kind":"externalParam","text":"info"},{"kind":"text","text":": "},{"text":"TypeInfoT","kind":"typeIdentifier"},{"kind":"text","text":", "},{"text":"valueTable","kind":"externalParam"},{"kind":"text","text":": "},{"text":"TypeValueTableT","kind":"typeIdentifier"},{"text":")","kind":"text"}]},"doc://GLibObject/documentation/GLibObject/TypePluginRef":{"navigatorTitle":[{"text":"TypePluginRef","kind":"identifier"}],"abstract":[{"type":"text","text":"An interface that handles the lifecycle of dynamically loaded types."}],"kind":"symbol","title":"TypePluginRef","url":"\/documentation\/glibobject\/typepluginref","type":"topic","role":"symbol","identifier":"doc:\/\/GLibObject\/documentation\/GLibObject\/TypePluginRef","fragments":[{"kind":"keyword","text":"struct"},{"text":" ","kind":"text"},{"kind":"identifier","text":"TypePluginRef"}]},"doc://GLibObject/documentation/GLibObject/TypeModuleProtocol":{"fragments":[{"kind":"keyword","text":"protocol"},{"text":" ","kind":"text"},{"text":"TypeModuleProtocol","kind":"identifier"}],"kind":"symbol","title":"TypeModuleProtocol","identifier":"doc:\/\/GLibObject\/documentation\/GLibObject\/TypeModuleProtocol","role":"symbol","navigatorTitle":[{"kind":"identifier","text":"TypeModuleProtocol"}],"type":"topic","abstract":[{"typ