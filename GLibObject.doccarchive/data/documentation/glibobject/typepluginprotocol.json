eName"},{"type":"text","text":" as the name of a new dynamic type derived from"},{"type":"text","text":" "},{"type":"codeVoice","code":"parentType"},{"type":"text","text":".  The type system uses the information contained in the"},{"type":"text","text":" "},{"isActive":true,"type":"reference","identifier":"doc:\/\/GLibObject\/documentation\/GLibObject\/TypePlugin"},{"type":"text","text":" structure pointed to by "},{"type":"codeVoice","code":"plugin"},{"type":"text","text":" to manage the type and its"},{"text":" ","type":"text"},{"type":"text","text":"instances (if not abstract).  The value of "},{"code":"flags","type":"codeVoice"},{"type":"text","text":" determines the nature"},{"type":"text","text":" "},{"type":"text","text":"(e.g. abstract or not) of the type."}],"kind":"symbol","title":"typeRegisterDynamic(parentType:typeName:flags:)","url":"\/documentation\/glibobject\/typepluginprotocol\/typeregisterdynamic(parenttype:typename:flags:)","type":"topic","role":"symbol","identifier":"doc:\/\/GLibObject\/documentation\/GLibObject\/TypePluginProtocol\/typeRegisterDynamic(parentType:typeName:flags:)","fragments":[{"kind":"keyword","text":"func"},{"text":" ","kind":"text"},{"text":"typeRegisterDynamic","kind":"identifier"},{"text":"(","kind":"text"},{"kind":"externalParam","text":"parentType"},{"text":": ","kind":"text"},{"kind":"typeIdentifier","text":"GType","preciseIdentifier":"c:@T@GType"},{"text":", ","kind":"text"},{"kind":"externalParam","text":"typeName"},{"text":": ","kind":"text"},{"preciseIdentifier":"s:SP","text":"UnsafePointer","kind":"typeIdentifier"},{"kind":"text","text":"<"},{"kind":"typeIdentifier","preciseIdentifier":"c:@T@gchar","text":"gchar"},{"text":">!, ","kind":"text"},{"kind":"externalParam","text":"flags"},{"kind":"text","text":": "},{"text":"TypeFlags","preciseIdentifier":"s:10GLibObject9TypeFlagsV","kind":"typeIdentifier"},{"kind":"text","text":") -> "},{"text":"GType","preciseIdentifier":"c:@T@GType","kind":"typeIdentifier"}]},"doc://GLibObject/documentation/GLibObject/TypePluginProtocol":{"role":"symbol","identifier":"doc:\/\/GLibObject\/documentation\/GLibObject\/TypePluginProtocol","type":"topic","navigatorTitle":[{"kind":"identifier","text":"TypePluginProtocol"}],"url":"\/documentation\/glibobject\/typepluginprotocol","title":"TypePluginProtocol","abstract":[{"type":"text","text":"An interface that handles the lifecycle of dynamically loaded types."}],"kind":"symbol","fragments":[{"kind":"keyword","text":"protocol"},{"kind":"text","text":" "},{"kind":"identifier","text":"TypePluginProtocol"}]},"doc://GLibObject/documentation/GLibObject/TypePluginProtocol/type_plugin_ptr-1f7zf":{"url":"\/documentation\/glibobject\/typepluginprotocol\/type_plugin_ptr-1f7zf","fragments":[{"kind":"keyword","text":"var"},{"kind":"text","text":" "},{"text":"type_plugin_ptr","kind":"identifier"},{"kind":"text","text":": "},{"kind":"typeIdentifier","preciseIdentifier":"s:Sp","text":"UnsafeMutablePointer"},{"text":"<","kind":"text"},{"text":"GTypePlugin","kind":"typeIdentifier"},{"kind":"text","text":">!"}],"defaultImplementations":1,"role":"symbol","kind":"symbol","identifier":"doc:\/\/GLibObject\/documentation\/GLibObject\/TypePluginProtocol\/type_plugin_ptr-1f7zf","title":"type_plugin_ptr","required":true,"abstract":[{"type":"text","text":"Typed pointer to the underlying "},{"code":"GTypePlugin","type":"codeVoice"},{"text":" instance.","type":"text"}],"type":"topic"},"doc://GLibObject/documentation/GLibObject/TypeModule":{"identifier":"doc:\/\/GLibObject\/documentation\/GLibObject\/TypeModule","url":"\/documentation\/glibobject\/typemodule","fragments":[{"text":"class","kind":"keyword"},{"kind":"text","text":" "},{"kind":"identifier","text":"TypeModule"}],"abstract":[{"type":"codeVoice","code":"GTypeModule"},{"text":" provides a simple implementation of the ","type":"text"},{"type":"codeVoice","code":"GTypePlugin"},{"type":"text","text":" "},{"text":"interface.","type":"text"}],"title":"TypeModule","navigatorTitle":[