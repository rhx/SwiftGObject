{"abstract":[{"type":"text","text":"Sets the meta marshaller of "},{"type":"codeVoice","code":"closure"},{"type":"text","text":"."}],"sections":[],"primaryContentSections":[{"kind":"declarations","declarations":[{"tokens":[{"text":"func","kind":"keyword"},{"kind":"text","text":" "},{"text":"setMetaMarshal","kind":"identifier"},{"kind":"text","text":"("},{"kind":"externalParam","text":"marshalData"},{"text":": ","kind":"text"},{"preciseIdentifier":"c:gtypes.h@T@gpointer","kind":"typeIdentifier","text":"gpointer"},{"kind":"text","text":"? = nil, "},{"text":"metaMarshal","kind":"externalParam"},{"kind":"text","text":": "},{"text":"GClosureMarshal","preciseIdentifier":"c:gclosure.h@T@GClosureMarshal","kind":"typeIdentifier"},{"text":")","kind":"text"}],"platforms":["macOS"],"languages":["swift"]}]},{"content":[{"level":2,"type":"heading","text":"Discussion","anchor":"discussion"},{"inlineContent":[{"type":"text","text":"A meta marshaller wraps the "},{"type":"codeVoice","code":"closure"},{"type":"text","text":"’s marshal and modifies the way"},{"type":"text","text":" "},{"type":"text","text":"it is called in some fashion. The most common use of this facility"},{"type":"text","text":" "},{"type":"text","text":"is for C callbacks."}],"type":"paragraph"},{"inlineContent":[{"type":"text","text":"The same marshallers (generated by "},{"type":"reference","identifier":"#glib-genmarshal","isActive":true},{"type":"text","text":"),"},{"type":"text","text":" "},{"type":"text","text":"are used everywhere, but the way that we get the callback function"},{"text":" ","type":"text"},{"type":"text","text":"differs. In most cases we want to use the "},{"code":"closure","type":"codeVoice"},{"type":"text","text":"’s callback, but in"},{"text":" ","type":"text"},{"type":"text","text":"other cases we want to use some different technique to retrieve the"},{"text":" ","type":"text"},{"text":"callback function.","type":"text"}],"type":"paragraph"},{"inlineContent":[{"type":"text","text":"For example, class closures for signals (see"},{"type":"text","text":" "},{"code":"g_signal_type_cclosure_new()","type":"codeVoice"},{"type":"text","text":") retrieve the callback function from a"},{"type":"text","text":" "},{"text":"fixed offset in the class structure.  The meta marshaller retrieves","type":"text"},{"type":"text","text":" "},{"text":"the right callback and passes it to the marshaller as the","type":"text"},{"type":"text","text":" "},{"code":"marshalData","type":"codeVoice"},{"text":" argument.","type":"text"}],"type":"paragraph"}],"kind":"content"}],"hierarchy":{"paths":[["doc:\/\/GLibObject\/documentation\/GLibObject","doc:\/\/GLibObject\/documentation\/GLibObject\/ClosureRef","doc:\/\/GLibObject\/documentation\/GLibObject\/ClosureRef\/ClosureProtocol-Implementations"]]},"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/glibobject\/closureref\/setmetamarshal(marshaldata:metamarshal:)"]}],"identifier":{"url":"doc:\/\/GLibObject\/documentation\/GLibObject\/ClosureRef\/setMetaMarshal(marshalData:metaMarshal:)","interfaceLanguage":"swift"},"kind":"symbol","metadata":{"role":"symbol","modules":[{"name":"GLibObject"}],"extendedModule":"GLibObject","fragments":[{"kind":"keyword","text":"func"},{"text":" ","kind":"text"},{"text":"setMetaMarshal","kind":"identifier"},{"kind":"text","text":"("},{"text":"marshalData","kind":"externalParam"},{"text":": ","kind":"text"},{"kind":"typeIdentifier","preciseIdentifier":"c:gtypes.h@T@gpointer","text":"gpointer"},{"kind":"text","text":"?, "},{"text":"metaMarshal","kind":"externalParam"},{"kind":"text","text":": "},{"text":"GClosureMarshal","preciseIdentifier":"c:gclosure.h@T@GClosureMarshal","kind":"typeIdentifier"},{"kind":"text","text":")"}],"title":"setMetaMarshal(marshalData:metaMarshal:)","roleHeading":"Instance Method","externalID":"s:10GLibObject15ClosureProtocolPAAE14setMetaMarshal11marshalData04metaG0ySvSg_ySpySo9_GClosureVGSg_SpySo7_GValueVGSgs6UInt32VSPyAMGSgA2GtXCtF::SYNTHESIZED::