bObject/documentation/GLibObject/ClosureRef":{"type":"topic","navigatorTitle":[{"text":"ClosureRef","kind":"identifier"}],"identifier":"doc:\/\/GLibObject\/documentation\/GLibObject\/ClosureRef","title":"ClosureRef","abstract":[{"type":"text","text":"A "},{"type":"codeVoice","code":"GClosure"},{"type":"text","text":" represents a callback supplied by the programmer."}],"kind":"symbol","url":"\/documentation\/glibobject\/closureref","fragments":[{"text":"struct","kind":"keyword"},{"kind":"text","text":" "},{"kind":"identifier","text":"ClosureRef"}],"role":"symbol"}}}