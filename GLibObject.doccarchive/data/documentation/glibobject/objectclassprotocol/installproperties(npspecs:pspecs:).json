d":"typeIdentifier"},{"text":">?>!)","kind":"text"}],"platforms":["macOS"]}]},{"content":[{"type":"heading","level":2,"anchor":"discussion","text":"Discussion"},{"inlineContent":[{"text":"All properties should be installed during the class initializer.  It","type":"text"},{"type":"text","text":" "},{"type":"text","text":"is possible to install properties after that, but doing so is not"},{"type":"text","text":" "},{"text":"recommend, and specifically, is not guaranteed to be thread-safe vs.","type":"text"},{"text":" ","type":"text"},{"text":"use of properties on the same type on other threads.","type":"text"}],"type":"paragraph"},{"inlineContent":[{"text":"The property id of each property is the index of each ","type":"text"},{"type":"reference","isActive":true,"identifier":"doc:\/\/GLibObject\/documentation\/GLibObject\/ParamSpec"},{"text":" in","type":"text"},{"text":" ","type":"text"},{"text":"the ","type":"text"},{"type":"codeVoice","code":"pspecs"},{"text":" array.","type":"text"}],"type":"paragraph"},{"type":"paragraph","inlineContent":[{"type":"text","text":"The property id of 0 is treated specially by "},{"type":"reference","identifier":"doc:\/\/GLibObject\/documentation\/GLibObject\/Object","isActive":true},{"text":" and it should not","type":"text"},{"type":"text","text":" "},{"type":"text","text":"be used to store a "},{"isActive":true,"identifier":"doc:\/\/GLibObject\/documentation\/GLibObject\/ParamSpec","type":"reference"},{"type":"text","text":"."}]},{"inlineContent":[{"type":"text","text":"This function should be used if you plan to use a static array of"},{"text":" ","type":"text"},{"type":"codeVoice","code":"GParamSpecs"},{"text":" and ","type":"text"},{"type":"codeVoice","code":"g_object_notify_by_pspec()"},{"text":". For instance, this","type":"text"},{"type":"text","text":" "},{"text":"class initialization:","type":"text"}],"type":"paragraph"},{"inlineContent":[{"type":"text","text":"(C Language Example):"}],"type":"paragraph"},{"code":["typedef enum {","  PROP_FOO = 1,","  PROP_BAR,","  N_PROPERTIES","} MyObjectProperty;","","static GParamSpec *obj_properties[N_PROPERTIES] = { NULL, };","","static void","my_object_class_init (MyObjectClass *klass)","{","  GObjectClass *gobject_class = G_OBJECT_CLASS (klass);","","  obj_properties[PROP_FOO] =","    g_param_spec_int (\"foo\", NULL, NULL,","                      -1, G_MAXINT,","                      0,","                      G_PARAM_READWRITE | G_PARAM_STATIC_STRINGS);","","  obj_properties[PROP_BAR] =","    g_param_spec_string (\"bar\", NULL, NULL,","                         NULL,","                         G_PARAM_READWRITE | G_PARAM_STATIC_STRINGS);","","  gobject_class->set_property = my_object_set_property;","  gobject_class->get_property = my_object_get_property;","  g_object_class_install_properties (gobject_class,","                                     G_N_ELEMENTS (obj_properties),","                                     obj_properties);","}"],"syntax":"C","type":"codeListing"},{"inlineContent":[{"text":"allows calling ","type":"text"},{"type":"codeVoice","code":"g_object_notify_by_pspec()"},{"text":" to notify of property changes:","type":"text"}],"type":"paragraph"},{"type":"paragraph","inlineContent":[{"type":"text","text":"(C Language Example):"}]},{"syntax":"C","type":"codeListing","code":["void","my_object_set_foo (MyObject *self, gint foo)","{","  if (self->foo != foo)","    {","      self->foo = foo;","      g_object_notify_by_pspec (G_OBJECT (self), obj_properties[PROP_FOO]);","    }"," }"]}],"kind":"content"}],"abstract":[{"text":"Installs new properties from an array of ","type":"text"},{"code":"GParamSpecs","type":"codeVoice"},{"text":".","type":"text"}],"schemaVersion":{"major":0,"minor":3,"patch":0},"sections":[],"identifier":{"url":"doc:\/\/GLibObject\/documentation\/GLibObject\/ObjectClassProtocol\/installProperties(nPspecs:pspecs:)","interfaceLanguage":"swift"},"kind":"symbol","references":{"doc://GLibObject/documentation/GLibObject