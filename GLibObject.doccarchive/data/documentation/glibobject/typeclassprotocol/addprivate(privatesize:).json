t_get_some_field (MyObject *my_object)","{","  MyObjectPrivate *priv;","","  g_return_val_if_fail (MY_IS_OBJECT (my_object), 0);","","  priv = my_object->priv;","","  return priv->some_field;","}"]},{"type":"paragraph","inlineContent":[{"type":"strong","inlineContent":[{"text":"add_private is deprecated:","type":"text"}]},{"text":" ","type":"text"},{"text":"Use the G_ADD_PRIVATE() macro with the ","type":"text"},{"type":"codeVoice","code":"G_DEFINE_*"},{"text":" ","type":"text"},{"type":"text","text":"family of macros to add instance private data to a type"}]}]}],"sections":[],"hierarchy":{"paths":[["doc:\/\/GLibObject\/documentation\/GLibObject","doc:\/\/GLibObject\/documentation\/GLibObject\/TypeClassProtocol"]]},"abstract":[{"type":"text","text":"Registers a private structure for an instantiatable type."}],"schemaVersion":{"minor":3,"major":0,"patch":0},"references":{"doc://GLibObject/documentation/GLibObject/TypeClassProtocol":{"title":"TypeClassProtocol","abstract":[{"type":"text","text":"An opaque structure used as the base of all classes."}],"role":"symbol","url":"\/documentation\/glibobject\/typeclassprotocol","identifier":"doc:\/\/GLibObject\/documentation\/GLibObject\/TypeClassProtocol","kind":"symbol","navigatorTitle":[{"text":"TypeClassProtocol","kind":"identifier"}],"fragments":[{"text":"protocol","kind":"keyword"},{"kind":"text","text":" "},{"text":"TypeClassProtocol","kind":"identifier"}],"type":"topic"},"doc://GLibObject/documentation/GLibObject":{"role":"collection","identifier":"doc:\/\/GLibObject\/documentation\/GLibObject","type":"topic","url":"\/documentation\/glibobject","title":"GLibObject","abstract":[],"kind":"symbol"},"doc://GLibObject/documentation/GLibObject/TypeClassProtocol/addPrivate(privateSize:)":{"type":"topic","url":"\/documentation\/glibobject\/typeclassprotocol\/addprivate(privatesize:)","kind":"symbol","role":"symbol","abstract":[{"text":"Registers a private structure for an instantiatable type.","type":"text"}],"title":"addPriv