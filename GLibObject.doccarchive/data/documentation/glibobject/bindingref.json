{"schemaVersion":{"major":0,"minor":3,"patch":0},"identifier":{"interfaceLanguage":"swift","url":"doc:\/\/GLibObject\/documentation\/GLibObject\/BindingRef"},"relationshipsSections":[{"kind":"relationships","identifiers":["doc:\/\/GLibObject\/documentation\/GLibObject\/BindingProtocol","doc:\/\/GLibObject\/4GLib14PointerWrapperP","doc:\/\/GLibObject\/documentation\/GLibObject\/GWeakCapturing","doc:\/\/GLibObject\/documentation\/GLibObject\/ObjectProtocol"],"title":"Conforms To","type":"conformsTo"}],"abstract":[{"type":"codeVoice","code":"GObject"},{"text":" instance (or source) and another property on another ","type":"text"},{"type":"codeVoice","code":"GObject"},{"type":"text","text":" "},{"text":"instance (or target).","type":"text"}],"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/glibobject\/bindingref"]}],"metadata":{"symbolKind":"struct","roleHeading":"Structure","role":"symbol","modules":[{"name":"GLibObject"}],"navigatorTitle":[{"text":"BindingRef","kind":"identifier"}],"externalID":"s:10GLibObject10BindingRefV","fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"BindingRef","kind":"identifier"}],"title":"BindingRef"},"primaryContentSections":[{"kind":"declarations","declarations":[{"languages":["swift"],"tokens":[{"text":"struct","kind":"keyword"},{"kind":"text","text":" "},{"kind":"identifier","text":"BindingRef"}],"platforms":["macOS"]}]},{"content":[{"text":"Overview","level":2,"anchor":"overview","type":"heading"},{"inlineContent":[{"text":"Whenever the source property changes, the same value is applied to the","type":"text"},{"type":"text","text":" "},{"text":"target property; for instance, the following binding:","type":"text"}],"type":"paragraph"},{"type":"codeListing","syntax":"c","code":["  g_object_bind_property (object1, \"property-a\",","                          object2, \"property-b\",","                          G_BINDING_DEFAULT);"]},{"inlineContent":[{"type":"text","text":"will cause the property named “property-b” of "},{"type":"codeVoice","code":"object2"},{"type":"text","text":" to be updated"},{"type":"text","text":" "},{"text":"every time [method","type":"text"},{"code":"GObject.set","type":"codeVoice"},{"type":"text","text":"] or the specific accessor changes the value of"},{"type":"text","text":" "},{"text":"the property “property-a” of ","type":"text"},{"code":"object1","type":"codeVoice"},{"type":"text","text":"."}],"type":"paragraph"},{"type":"paragraph","inlineContent":[{"type":"text","text":"It is possible to create a bidirectional binding between two properties"},{"type":"text","text":" "},{"text":"of two ","type":"text"},{"type":"codeVoice","code":"GObject"},{"text":" instances, so that if either property changes, the","type":"text"},{"type":"text","text":" "},{"text":"other is updated as well, for instance:","type":"text"}]},{"code":["  g_object_bind_property (object1, \"property-a\",","                          object2, \"property-b\",","                          G_BINDING_BIDIRECTIONAL);"],"type":"codeListing","syntax":"c"},{"type":"paragraph","inlineContent":[{"type":"text","text":"will keep the two properties in sync."}]},{"inlineContent":[{"type":"text","text":"It is also possible to set a custom transformation function (in both"},{"text":" ","type":"text"},{"type":"text","text":"directions, in case of a bidirectional binding) to apply a custom"},{"text":" ","type":"text"},{"text":"transformation from the source value to the target value before","type":"text"},{"type":"text","text":" "},{"text":"applying it; for instance, the following binding:","type":"text"}],"type":"paragraph"},{"syntax":"c","type":"codeListing","code":["  g_object_bind_property_full (adjustment1, \"value\",","                               adjustment2, \"value\",","                               G_BINDING_BIDIRECTIONAL,","                               celsius_to_fahrenheit,","                               fahrenheit_to_celsius,","                               NULL, NULL);"]},{"inlineContent":[{"type":"text","text":"will keep the “value” property of the two adjustments in sync; the"},{"type":"text","text":" "},{"type":"codeVoice","code":"celsius_to_fahrenheit"},{"type":"text","text":" function will be called whenever the “value”"},{"text":" ","type":"text"},{"type":"text","text":"property of "},{"code":"adjustment1","type":"codeVoice"},{"type":"text","text":" changes and will transform the current value"},{"type":"text","text":" "},{"text":"of the property before applying it to the “value” property of ","type":"text"},{"code":"adjustment2","type":"codeVoice"},{"type":"text","text":"."}],"type":"paragraph"},{"inlineContent":[{"type":"text","text":"Vice versa, the "},{"type":"codeVoice","code":"fahrenheit_to_celsius"},{"text":" function will be called whenever","type":"text"},{"type":"text","text":" "},{"text":"the “value” property of ","type":"text"},{"type":"codeVoice","code":"adjustment2"},{"type":"text","text":" changes, and will transform the"},{"text":" ","type":"text"},{"type":"text","text":"current value of the property before applying it to the “value” property"},{"type":"text","text":" "},{"text":"of ","type":"text"},{"code":"adjustment1","type":"codeVoice"},{"type":"text","text":"."}],"type":"paragraph"},{"type":"paragraph","inlineContent":[{"text":"Note that ","type":"text"},{"isActive":true,"type":"reference","identifier":"doc:\/\/GLibObject\/documentation\/GLibObject\/Binding"},{"type":"text","text":" does not resolve cycles by itself; a cycle like"}]},{"syntax":null,"type":"codeListing","code":["  object1:propertyA -> object2:propertyB","  object2:propertyB -> object3:propertyC","  object3:propertyC -> object1:propertyA"]},{"type":"paragraph","inlineContent":[{"type":"text","text":"might lead to an infinite loop. The loop, in this particular case,"},{"type":"text","text":" "},{"type":"text","text":"can be avoided if the objects emit the "},{"type":"codeVoice","code":"GObject"},{"type":"text","text":"notify"},{"code":" signal only if the value has effectively been changed. A binding is implemented using the `GObject`notify","type":"codeVoice"},{"text":" signal, so it is susceptible to all the","type":"text"},{"text":" ","type":"text"},{"type":"text","text":"various ways of blocking a signal emission, like [func"},{"code":"GObject.signal_stop_emission","type":"codeVoice"},{"type":"text","text":"]"},{"type":"text","text":" "},{"type":"text","text":"or [func"},{"type":"codeVoice","code":"GObject.signal_handler_block"},{"text":"].","type":"text"}]},{"type":"paragraph","inlineContent":[{"text":"A binding will be severed, and the resources it allocates freed, whenever","type":"text"},{"text":" ","type":"text"},{"type":"text","text":"either one of the "},{"code":"GObject","type":"codeVoice"},{"type":"text","text":" instances it refers to are finalized, or when"},{"type":"text","text":" "},{"type":"text","text":"the "},{"type":"reference","identifier":"doc:\/\/GLibObject\/documentation\/GLibObject\/Binding","isActive":true},{"type":"text","text":" instance loses its last reference."}]},{"inlineContent":[{"type":"text","text":"Bindings for languages with garbage collection can use"},{"text":" ","type":"text"},{"text":"[method","type":"text"},{"type":"codeVoice","code":"GObject.Binding.unbind"},{"type":"text","text":"] to explicitly release a binding between the source"},{"type":"text","text":" "},{"type":"text","text":"and target properties, instead of relying on the last reference on the"},{"text":" ","type":"text"},{"type":"text","text":"binding, source, and target instances to drop."}],"type":"paragraph"},{"inlineContent":[{"type":"text","text":"The "},{"identifier":"doc:\/\/GLibObject\/documentation\/GLibObject\/BindingRef","type":"reference","isActive":true},{"text":" type acts as a lightweight Swift reference to an underlying ","type":"text"},{"type":"codeVoice","code":"GBinding"},{"text":" instance.","type":"text"},{"text":" ","type":"text"},{"type":"text","text":"It exposes methods that can operate on this data type through "},{"type":"reference","identifier":"doc:\/\/GLibObject\/documentation\/GLibObject\/BindingProtocol","isActive":true},{"type":"text","text":" conformance."},{"type":"text","text":" "},{"text":"Use ","type":"text"},{"isActive":true,"type":"reference","identifier":"doc:\/\/GLibObject\/documentation\/GLibObject\/BindingRef"},{"text":" only as an ","type":"text"},{"type":"codeVoice","code":"unowned"},{"type":"text","text":" reference to an existing "},{"type":"codeVoice","code":"GBinding"},{"type":"text","text":" instance."}],"type":"paragraph"},{"type":"aside","style":"note","name":"Note","content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"Use "},{"isActive":true,"type":"reference","identifier":"doc:\/\/GLibObject\/documentation\/GLibObject\/Binding"},{"text":" (instead of ","type":"text"},{"type":"reference","identifier":"doc:\/\/GLibObject\/documentation\/GLibObject\/BindingRef","isActive":true},{"text":") if you want to use Automatic Reference Counting for memory management of the underlying ","type":"text"},{"code":"GBinding","type":"codeVoice"},{"text":" instance.","type":"text"}]}]}],"kind":"content"}],"hierarchy":{"paths":[["doc:\/\/GLibObject\/documentation\/GLibObject"]]},"sections":[],"kind":"symbol","topicSections":[{"identifiers":["doc:\/\/GLibObject\/documentation\/GLibObject\/BindingRef\/init(_:)-4t7wl","doc:\/\/GLibObject\/documentation\/GLibObject\/BindingRef\/init(_:)-76590","doc:\/\/GLibObject\/documentation\/GLibObject\/BindingRef\/init(_:)-791e9","doc:\/\/GLibObject\/documentation\/GLibObject\/BindingRef\/init(_:)-7vk9n","doc:\/\/GLibObject\/documentation\/GLibObject\/BindingRef\/init(_:)-9r2ew","doc:\/\/GLibObject\/documentation\/GLibObject\/BindingRef\/init(cPointer:)","doc:\/\/GLibObject\/documentation\/GLibObject\/BindingRef\/init(constPointer:)","doc:\/\/GLibObject\/documentation\/GLibObject\/BindingRef\/init(gconstpointer:)","doc:\/\/GLibObject\/documenta