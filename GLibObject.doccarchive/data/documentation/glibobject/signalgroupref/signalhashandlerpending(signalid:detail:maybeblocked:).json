{"abstract":[{"text":"Returns whether there are any handlers connected to ","type":"text"},{"type":"codeVoice","code":"instance"},{"text":" for the","type":"text"},{"type":"text","text":" "},{"type":"text","text":"given signal id and detail."}],"sections":[],"primaryContentSections":[{"kind":"declarations","declarations":[{"tokens":[{"text":"func","kind":"keyword"},{"kind":"text","text":" "},{"text":"signalHasHandlerPending","kind":"identifier"},{"text":"(","kind":"text"},{"kind":"externalParam","text":"signalID"},{"text":": ","kind":"text"},{"text":"Int","kind":"typeIdentifier","preciseIdentifier":"s:Si"},{"text":", ","kind":"text"},{"kind":"externalParam","text":"detail"},{"text":": ","kind":"text"},{"preciseIdentifier":"c:@T@GQuark","kind":"typeIdentifier","text":"GQuark"},{"text":", ","kind":"text"},{"text":"mayBeBlocked","kind":"externalParam"},{"text":": ","kind":"text"},{"text":"Bool","preciseIdentifier":"s:Sb","kind":"typeIdentifier"},{"kind":"text","text":") -> "},{"text":"Bool","preciseIdentifier":"s:Sb","kind":"typeIdentifier"}],"platforms":["macOS"],"languages":["swift"]}]},{"kind":"content","content":[{"type":"heading","level":2,"text":"Discussion","anchor":"discussion"},{"inlineContent":[{"text":"If ","type":"text"},{"type":"codeVoice","code":"detail"},{"text":" is 0 then it will only match handlers that were connected","type":"text"},{"type":"text","text":" "},{"type":"text","text":"without detail.  If "},{"type":"codeVoice","code":"detail"},{"type":"text","text":" is non-zero then it will match handlers"},{"type":"text","text":" "},{"type":"text","text":"connected both without detail and with the given detail.  This is"},{"text":" ","type":"text"},{"type":"text","text":"consistent with how a signal emitted with "},{"code":"detail","type":"codeVoice"},{"type":"text","text":" would be delivered"},{"type":"text","text":" "},{"type":"text","text":"to those handlers."}],"type":"paragraph"},{"type":"paragraph","inlineContent":[{"text":"Since 2.46 this also