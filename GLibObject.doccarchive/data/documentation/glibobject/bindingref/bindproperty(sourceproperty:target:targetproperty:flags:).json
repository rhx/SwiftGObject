xt"},{"type":"text","text":"finalized from different threads. Keep another reference to the binding and"},{"type":"text","text":" "},{"type":"text","text":"use "},{"code":"g_binding_unbind()","type":"codeVoice"},{"type":"text","text":" instead to be on the safe side."}],"type":"paragraph"},{"inlineContent":[{"text":"A ","type":"text"},{"isActive":true,"identifier":"doc:\/\/GLibObject\/documentation\/GLibObject\/Object","type":"reference"},{"type":"text","text":" can have multiple bindings."}],"type":"paragraph"}],"kind":"content"}],"references":{"doc://GLibObject/documentation/GLibObject/BindingRef/ObjectProtocol-Implementations":{"identifier":"doc:\/\/GLibObject\/documentation\/GLibObject\/BindingRef\/ObjectProtocol-Implementations","title":"ObjectProtocol Implementations","role":"collectionGroup","abstract":[],"kind":"article","url":"\/documentation\/glibobject\/bindingref\/objectprotocol-implementations","type":"topic"},"doc://GLibObject/documentation/GLibObject/BindingRef/bindProperty(sourceProperty:target:targetProperty:flags:)":{"type":"topic","kind":"symbol","role":"symbol","fragments":[{"kind":"keyword","text":"func"},{"text":" ","kind":"text"},{"kind":"identifier","text":"bindProperty"},{"kind":"text","text":"<"},{"kind":"genericParameter","text":"ObjectT"},{"text":">(","kind":"text"},{"text":"sourceProperty","kind":"externalParam"},{"kind":"text","text":": "},{"kind":"typeIdentifier","text":"UnsafePointer","preciseIdentifier":"s:SP"},{"text":"<","kind":"text"},{"preciseIdentifier":"c:@T@gchar","text":"gchar","kind":"typeIdentifier"},{"text":">!, ","kind":"text"},{"text":"target","kind":"externalParam"},{"text":": ","kind":"text"},{"kind":"typeIdentifier","text":"ObjectT"},{"kind":"text","text":", "},{"text":"targetProperty","kind":"externalParam"},{"kind":"text","text":": "},{"kind":"typeIdentifier","preciseIdentifier":"s:SP","text":"UnsafePointer"},{"text":"<","kind":"text"},{"preciseIdentifier":"c:@T@gchar","kind":"typeIdentifier","text":"gchar"},{"text"