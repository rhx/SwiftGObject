\/documentation\/GLibObject\/BindingRef","preciseIdentifier":"s:10GLibObject10BindingRefV","text":"BindingRef","kind":"typeIdentifier"},{"text":"! ","kind":"text"},{"text":"where","kind":"keyword"},{"kind":"text","text":" "},{"text":"ObjectT","kind":"typeIdentifier"},{"kind":"text","text":" : "},{"preciseIdentifier":"s:10GLibObject0B8ProtocolP","text":"ObjectProtocol","kind":"typeIdentifier","identifier":"doc:\/\/GLibObject\/documentation\/GLibObject\/ObjectProtocol"}]}]},{"content":[{"text":"Discussion","anchor":"discussion","type":"heading","level":2},{"inlineContent":[{"type":"text","text":"Whenever the "},{"code":"sourceProperty","type":"codeVoice"},{"type":"text","text":" is changed the "},{"code":"targetProperty","type":"codeVoice"},{"text":" is","type":"text"},{"type":"text","text":" "},{"type":"text","text":"updated using the same value. For instance:"}],"type":"paragraph"},{"type":"paragraph","inlineContent":[{"type":"text","text":"(C Language Example):"}]},{"type":"codeListing","code":["  g_object_bind_property (action, \"active\", widget, \"sensitive\", 0);"],"syntax":"C"},{"inlineContent":[{"type":"text","text":"Will result in the “sensitive” property of the widget "},{"type":"reference","identifier":"doc:\/\/GLibObject\/documentation\/GLibObject\/Object","isActive":true},{"type":"text","text":" instance to be"},{"type":"text","text":" "},{"text":"updated with the same value of the “active” property of the action ","type":"text"},{"type":"reference","identifier":"doc:\/\/GLibObject\/documentation\/GLibObject\/Object","isActive":true},{"text":" ","type":"text"},{"text":"instance.","type":"text"}],"type":"paragraph"},{"inlineContent":[{"type":"text","text":"If "},{"type":"codeVoice","code":"flags"},{"text":" contains ","type":"text"},{"code":"bidirectional","type":"codeVoice"},{"type":"text","text":" then the binding will be mutual:"},{"type":"text","text":" "},{"type":"text","text":"if "},{"type":"codeVoice","code":"targetProperty"},{"text":" on ","type":