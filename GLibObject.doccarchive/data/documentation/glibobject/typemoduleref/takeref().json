{"variants":[{"paths":["\/documentation\/glibobject\/typemoduleref\/takeref()"],"traits":[{"interfaceLanguage":"swift"}]}],"schemaVersion":{"patch":0,"minor":3,"major":0},"hierarchy":{"paths":[["doc:\/\/GLibObject\/documentation\/GLibObject","doc:\/\/GLibObject\/documentation\/GLibObject\/TypeModuleRef","doc:\/\/GLibObject\/documentation\/GLibObject\/TypeModuleRef\/ObjectProtocol-Implementations"]]},"sections":[],"metadata":{"title":"takeRef()","roleHeading":"Instance Method","role":"symbol","modules":[{"name":"GLibObject"}],"externalID":"s:10GLibObject0B8ProtocolPAAE7takeRefAA0bE0VSgyF::SYNTHESIZED::s:10GLibObject13TypeModuleRefV","extendedModule":"GLibObject","symbolKind":"method","fragments":[{"text":"func","kind":"keyword"},{"kind":"text","text":" "},{"kind":"identifier","text":"takeRef"},{"kind":"text","text":"() -> "},{"text":"ObjectRef","preciseIdentifier":"s:10GLibObject0B3RefV","kind":"typeIdentifier"},{"text":"!","kind":"text"}]},"kind":"symbol","abstract":[{"text":"If ","type":"text"},{"type":"codeVoice","code":"object"},{"type":"text","text":" is floating, sink it.  Otherwise, do nothing."}],"primaryContentSections":[{"kind":"declarations","declarations":[{"platforms":["macOS"],"languages":["swift"],"tokens":[{"kind":"keyword","text":"func"},{"text":" ","kind":"text"},{"text":"takeRef","kind":"identifier"},{"text":"() -> ","kind":"text"},{"kind":"typeIdentifier","text":"ObjectRef","identifier":"doc:\/\/GLibObject\/documentation\/GLibObject\/ObjectRef","preciseIdentifier":"s:10GLibObject0B3RefV"},{"kind":"text","text":"!"}]}]},{"kind":"content","content":[{"text":"Discussion","anchor":"discussion","level":2,"type":"heading"},{"inlineContent":[{"type":"text","text":"In other words, this function will convert a floating reference (if"},{"type":"text","text":" "},{"type":"text","text":"present) into a full reference."}],"type":"paragraph"},{"type":"paragraph","inlineContent":[{"text":"Typically you want to use ","type":"text"},{"type":"codeVoice","code":"g_object_ref_sink()"},{"type":"text","text":" in order to"},{"type":"text","text":" "},{"type":"text","text":"automatically do the correct thing with respect to floating or"},{"type":"text","text":" "},{"text":"non-floating references, but there is one specific scenario where","type":"text"},{"text":" ","type":"text"},{"text":"this function is helpful.","type":"text"}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"The situation where this function is helpful is when creating an API"},{"type":"text","text":" "},{"text":"that allows the user to provide a callback function that returns a","type":"text"},{"type":"text","text":" "},{"type":"text","text":"GObject. We certainly want to allow the user the flexibility to"},{"text":" ","type":"text"},{"type":"text","text":"return a non-floating reference from this callback (for the case"},{"type":"text","text":" "},{"text":"where the object that is being returned already exists).","type":"text"}]},{"inlineContent":[{"type":"text","text":"At the same time, the API style of some popular GObject-based"},{"type":"text","text":" "},{"type":"text","text":"libraries (such as Gtk) make it likely that for newly-created GObject"},{"type":"text","text":" "},{"text":"instances, the user can be saved some typing if they are allowed to","type":"text"},{"text":" ","type":"text"},{"text":"return a floating reference.","type":"text"}],"type":"paragraph"},{"inlineContent":[{"text":"Using this function on the return value of the user’s callback allows","type":"text"},{"text":" ","type":"text"},{"type":"text","text":"the user to do whichever is more convenient for them. The caller will"},{"type":"text","text":" "},{"text":"always receives exactly one full reference to the value: either the","type":"text"},{"text":" ","type":"text"},{"text":"one that was returned in the first place, or a floating reference","type":"text"},{"text":" ","type":"text"},{"text":"that has been converted to a full reference.","type":"text"}],"type":"paragraph"},{"inlineContent":[{"text":"This function has an odd interaction when combined with","type":"text"},{"type":"text","text":" "},{"type":"codeVoice","code":"g_object_ref_sink()"},{"text":" running at the same time in another thread on","type":"text"},{"type":"text","text":" "},{"text":"the same ","type":"text"},{"type":"reference","isActive":true,"identifier":"doc:\/\/GLibObject\/documentation\/GLibObject\/Object"},{"type":"text","text":" instance. If "},{"type":"codeVoice","code":"g_object_ref_sink()"},{"type":"text","text":" runs first then"},{"type":"text","text":" "},{"type":"text","text":"the result will be that the floating reference is converted to a hard"},{"text":" ","type":"text"},{"text":"reference. If ","type":"text"},{"type":"codeVoice","code":"g_object_take_ref()"},{"type":"text","text":" runs first then the result will be"},{"type":"text","text":" "},{"type":"text","text":"that the floating reference is converted to a hard reference and an"},{"type":"text","text":" "},{"type":"text","text":"additional reference on top of that one is added. It is best to avoid"},{"type":"text","text":" "},{"type":"text","text":"this situation."}],"type":"paragraph"}]}],"identifier":{"url":"doc:\/\/GLibObject\/documentation\/GLibObject\/TypeModuleRef\/takeRef()","interfaceLanguage":"swift"},"references":{"doc://GLibObject/documentation/GLibObject/ObjectRef":{"fragments":[{"text":"struct","kind":"keyword"},{"kind":"text","text":" "},{"text":"ObjectRef","kind":"identifier"}],"type":"topic","kind":"symbol","navigatorTitle":[{"text":"ObjectRef","kind":"identifier"}],"abstract":[{"text":"The base object type.","type":"text"}],"identifier":"doc:\/\/GLibObject\/documentation\/GLibObject\/ObjectRef","url":"\/documentation\/glibobject\/objectref","role":"symbol","title":"ObjectRef"},"doc://GLibObject/documentation/GLibObject/Object":{"navigatorTitle":[{"text":"Object","kind":"identifier"}],"type":"topic","url":"\/documentation\/glibobject\/object","identifier":"doc:\/\/GLibObject\/documentation\/GLibObject\/Object","abstract":[{"type":"text","text":"The base object type."}],"kind":"symbol","title":"Object","role":"symbol","fragments":[{"kind":"keyword","text":"class"},{"kind":"text","text":" "},{"kind":"identifier","text":"Object"}]},"doc://GLibObject/documentation/GLibObject":{"role":"collection","identifier":"doc:\/\/GLibObject\/documentation\/GLibObject","type":"topic","url":"\/documentation\/glibobject","title":"GLibObject","abstract":[],"kind":"symbol"},"doc://GLibObject/documentation/GLibObject/TypeModuleRef/takeRef()":{"role":"symbol","fragments":[{"text":"func","kind":"keyword"},{"kind":"text","text":" "},{"text":"takeRef","kind":"identifier"},{"text":"() -> ","kind":"text"},{"text":"ObjectRef","kind":"typeIdentifier","preciseIdentifier":"s:10GLibObject0B3RefV"},{"text":"!","kind":"text"}],"title":"takeRef()","type":"topic","abstract":[{"text":"If ","type":"text"},{"code":"object","type":"codeVoice"},{"type":"text","text":" is floating, sink it.  Otherwise, do nothing."}],"identifier":"doc:\/\/GLibObject\/documentation\/GLibObject\/TypeModuleRef\/takeRef()","kind":"symbol","url":"\/documentation\/glibobject\/typemoduleref\/takeref()"},"doc://GLibObject/documentation/GLibObject/TypeModuleRef/ObjectProtocol-Implementations":{"title":"ObjectProtocol Implementations","role":"collectionGroup","type":"topic","kind":"article","identifier":"doc:\/\/GLibObject\/documentation\/GLibObject\/TypeModuleRef\/ObjectProtocol-Implementations","abstract":[],"url":"\/documentation\/glibobject\/typemoduleref\/objectprotocol-implementations"},"doc://GLibObject/documentation/GLibObject/TypeModuleRef":{"role":"symbol","identifier":"doc:\/\/GLibObject\/documentation\/GLibObject\/TypeModuleRef","navigatorTitle":[{"text":"TypeModuleRef","kind":"identifier"}],"kind":"symbol","type":"topic","url":"\/documentation\/glibobject\/typemoduleref","abstract":[{"type":"codeVoice","code":"GTypeModule"},{"type":"text","text":" provides a simple implementation of the "},{"code":"GTypePlugin","type":"codeVoice"},{"text":" ","type":"text"},{"type":"text","text":"interface."}],"fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"TypeModuleRef","kind":"identifier"}],"title":"TypeModuleRef"}}}