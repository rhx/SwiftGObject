ndingRefV","kind":"typeIdentifier","text":"BindingRef","identifier":"doc:\/\/GLibObject\/documentation\/GLibObject\/BindingRef"},{"text":"! ","kind":"text"},{"text":"where","kind":"keyword"},{"text":" ","kind":"text"},{"text":"ObjectT","kind":"typeIdentifier"},{"text":" : ","kind":"text"},{"text":"ObjectProtocol","identifier":"doc:\/\/GLibObject\/documentation\/GLibObject\/ObjectProtocol","preciseIdentifier":"s:10GLibObject0B8ProtocolP","kind":"typeIdentifier"}]}],"kind":"declarations"},{"content":[{"text":"Discussion","type":"heading","level":2,"anchor":"discussion"},{"inlineContent":[{"type":"text","text":"Whenever the "},{"code":"sourceProperty","type":"codeVoice"},{"type":"text","text":" is changed the "},{"code":"targetProperty","type":"codeVoice"},{"text":" is","type":"text"},{"text":" ","type":"text"},{"text":"updated using the same value. For instance:","type":"text"}],"type":"paragraph"},{"inlineContent":[{"type":"text","text":"(C Language Example):"}],"type":"paragraph"},{"syntax":"C","code":["  g_object_bind_property (action, \"active\", widget, \"sensitive\", 0);"],"type":"codeListing"},{"type":"paragraph","inlineContent":[{"text":"Will result in the “sensitive” property of the widget ","type":"text"},{"isActive":true,"type":"reference","identifier":"doc:\/\/GLibObject\/documentation\/GLibObject\/Object"},{"text":" instance to be","type":"text"},{"type":"text","text":" "},{"text":"updated with the same value of the “active” property of the action ","type":"text"},{"identifier":"doc:\/\/GLibObject\/documentation\/GLibObject\/Object","type":"reference","isActive":true},{"type":"text","text":" "},{"text":"instance.","type":"text"}]},{"inlineContent":[{"type":"text","text":"If "},{"code":"flags","type":"codeVoice"},{"text":" contains ","type":"text"},{"type":"codeVoice","code":"bidirectional"},{"type":"text","text":" then the binding will be mutual:"},{"text":" ","type":"text"},{"text":"if ","type":"text"},{"code":"targetProperty","type":"codeVoice"},{"type"