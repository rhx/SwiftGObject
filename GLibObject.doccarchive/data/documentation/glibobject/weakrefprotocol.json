{"hierarchy":{"paths":[["doc:\/\/GLibObject\/documentation\/GLibObject"]]},"identifier":{"url":"doc:\/\/GLibObject\/documentation\/GLibObject\/WeakRefProtocol","interfaceLanguage":"swift"},"primaryContentSections":[{"declarations":[{"platforms":["macOS"],"languages":["swift"],"tokens":[{"kind":"keyword","text":"protocol"},{"kind":"text","text":" "},{"text":"WeakRefProtocol","kind":"identifier"},{"text":" : ","kind":"text"},{"preciseIdentifier":"s:4GLib14PointerWrapperP","text":"PointerWrapper","kind":"typeIdentifier"}]}],"kind":"declarations"},{"content":[{"text":"Overview","level":2,"anchor":"overview","type":"heading"},{"type":"paragraph","inlineContent":[{"type":"text","text":"A "},{"type":"codeVoice","code":"GWeakRef"},{"text":" can either be empty (i.e. point to ","type":"text"},{"code":"nil","type":"codeVoice"},{"type":"text","text":"), or point to an"},{"type":"text","text":" "},{"text":"object for as long as at least one “strong” reference to that object","type":"text"},{"text":" ","type":"text"},{"type":"text","text":"exists. Before the object’s "},{"type":"codeVoice","code":"GObjectClass.dispose"},{"text":" method is called,","type":"text"},{"type":"text","text":" "},{"text":"every ","type":"text"},{"type":"reference","isActive":true,"identifier":"doc:\/\/GLibObject\/documentation\/GLibObject\/WeakRef"},{"type":"text","text":" associated with becomes empty (i.e. points to "},{"code":"nil","type":"codeVoice"},{"text":").","type":"text"}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"Like "},{"identifier":"doc:\/\/GLibObject\/documentation\/GLibObject\/Value","isActive":true,"type":"reference"},{"type":"text","text":", "},{"isActive":true,"type":"reference","identifier":"doc:\/\/GLibObject\/documentation\/GLibObject\/WeakRef"},{"type":"text","text":" can be statically allocated, stack- or"},{"text":" ","type":"text"},{"type":"text","text":"heap-allocated, or embedded in larger structures."}]},{"type":"paragraph","inlineContent":[{"text":"Unlike ","type":"text"},{"type":"codeVoice","code":"g_object_weak_ref()"},{"type":"text","text":" and "},{"code":"g_object_add_weak_pointer()","type":"codeVoice"},{"text":", this weak","type":"text"},{"text":" ","type":"text"},{"type":"text","text":"reference is thread-safe: converting a weak pointer to a reference is"},{"text":" ","type":"text"},{"type":"text","text":"atomic with respect to invalidation of weak pointers to destroyed"},{"type":"text","text":" "},{"type":"text","text":"objects."}]},{"inlineContent":[{"type":"text","text":"If the object’s "},{"type":"codeVoice","code":"GObjectClass.dispose"},{"text":" method results in additional","type":"text"},{"type":"text","text":" "},{"text":"references to the object being held (‘re-referencing’), any ","type":"text"},{"code":"GWeakRefs","type":"codeVoice"},{"type":"text","text":" taken"},{"type":"text","text":" "},{"text":"before it was disposed will continue to point to ","type":"text"},{"type":"codeVoice","code":"nil"},{"text":".  Any ","type":"text"},{"code":"GWeakRefs","type":"codeVoice"},{"type":"text","text":" taken"},{"type":"text","text":" "},{"type":"text","text":"during disposal and after re-referencing, or after disposal has returned due"},{"type":"text","text":" "},{"type":"text","text":"to the re-referencing, will continue to point to the object until its refcount"},{"text":" ","type":"text"},{"type":"text","text":"goes back to zero, at which point they too will be invalidated."}],"type":"paragraph"},{"type":"paragraph","inlineContent":[{"type":"text","text":"It is invalid to take a "},{"type":"reference","identifier":"doc:\/\/GLibObject\/documentation\/GLibObject\/WeakRef","isActive":true},{"text":" on an object during ","type":"text"},{"code":"GObjectClass.dispose","type":"codeVoice"},{"type":"text","text":" "},{"type":"text","text":"without first having or creating a strong reference to the object."}]},{"inlineContent":[{"type":"text","text":"The "},{"identifier":"doc:\/\/GLibObject\/documentation\/GLibObject\/WeakRefProtocol","isActive":true,"type":"reference"},{"type":"text","text":" protocol exposes the methods and properties of an underlying "},{"code":"GWeakRef","type":"codeVoice"},{"text":" instance.","type":"text"},{"text":" ","type":"text"},{"text":"The default implementation of these can be found in the protocol extension below.","type":"text"},{"text":" ","type":"text"},{"text":"For a concrete class that implements these methods and properties, see ","type":"text"},{"type":"reference","isActive":true,"identifier":"doc:\/\/GLibObject\/documentation\/GLibObject\/WeakRef"},{"text":".","type":"text"},{"type":"text","text":" "},{"type":"text","text":"Alternatively, use "},{"identifier":"doc:\/\/GLibObject\/documentation\/GLibObject\/WeakRefRef","isActive":true,"type":"reference"},{"type":"text","text":" as a lighweight, "},{"code":"unowned","type":"codeVoice"},{"text":" reference if you already have an instance you just want to use.","type":"text"}],"type":"paragraph"}],"kind":"content"}],"kind":"symbol","relationshipsSections":[{"kind":"relationships","title":"Inherits From","identifiers":["doc:\/\/GLibObject\/4GLib14PointerWrapperP"],"type":"inheritsFrom"},{"kind":"relationships","identifiers":["doc:\/\/GLibObject\/documentation\/GLibObject\/WeakRef","doc:\/\/GLibObject\/documentation\/GLibObject\/WeakRefRef"],"type":"conformingTypes","title":"Conforming Types"}],"schemaVersion":{"major":0,"minor":3,"patch":0},"variants":[{"paths":["\/documentation\/glibobject\/weakrefprotocol"],"traits":[{"interfaceLanguage":"swift"}]}],"sections":[],"metadata":{"symbolKind":"protocol","role":"symbol","navigatorTitle":[{"kind":"identifier","text":"WeakRefProtocol"}],"title":"WeakRefProtocol","externalID":"s:10GLibObject15WeakRefProtocolP","roleHeading":"Protocol","fragments":[{"text":"protocol","kind":"keyword"},{"text":" ","kind":"text"},{"text":"WeakRefProtocol","kind":"identifier"}],"modules":[{"name":"GLibObject"}]},"topicSections":[{"identifiers":["doc:\/\/GLibObjec