{"abstract":[{"type":"text","text":"Returns whether there are any handlers connected to "},{"type":"codeVoice","code":"instance"},{"type":"text","text":" for the"},{"text":" ","type":"text"},{"text":"given signal id and detail.","type":"text"}],"primaryContentSections":[{"kind":"declarations","declarations":[{"platforms":["macOS"],"tokens":[{"kind":"keyword","text":"func"},{"kind":"text","text":" "},{"kind":"identifier","text":"signalHasHandlerPending"},{"text":"<","kind":"text"},{"kind":"genericParameter","text":"ObjectT"},{"kind":"text","text":">("},{"text":"instance","kind":"externalParam"},{"text":": ","kind":"text"},{"kind":"typeIdentifier","text":"ObjectT"},{"text":", ","kind":"text"},{"text":"signalID","kind":"externalParam"},{"text":": ","kind":"text"},{"preciseIdentifier":"s:Si","kind":"typeIdentifier","text":"Int"},{"text":", ","kind":"text"},{"kind":"externalParam","text":"detail"},{"text":": ","kind":"text"},{"text":"GQuark","kind":"typeIdentifier","preciseIdentifier":"c:@T@GQuark"},{"text":", ","kind":"text"},{"kind":"externalParam","text":"mayBeBlocked"},{"kind":"text","text":": "},{"kind":"typeIdentifier","text":"Bool","preciseIdentifier":"s:Sb"},{"text":") -> ","kind":"text"},{"text":"Bool","preciseIdentifier":"s:Sb","kind":"typeIdentifier"},{"kind":"text","text":" "},{"text":"where","kind":"keyword"},{"text":" ","kind":"text"},{"text":"ObjectT","kind":"typeIdentifier"},{"kind":"text","text":" : "},{"preciseIdentifier":"s:10GLibObject0B8ProtocolP","kind":"typeIdentifier","identifier":"doc:\/\/GLibObject\/documentation\/GLibObject\/ObjectProtocol","text":"ObjectProtocol"}],"languages":["swift"]}]},{"content":[{"type":"heading","level":2,"anchor":"discussion","text":"Discussion"},{"inlineContent":[{"text":"If ","type":"text"},{"type":"codeVoice","code":"detail"},{"text":" is 0 then it will only match handlers that were connected","type":"text"},{"text":" ","type":"text"},{"text":"without detail.  If ","type":"text"},{"code":"detail","type":"codeVoice"}