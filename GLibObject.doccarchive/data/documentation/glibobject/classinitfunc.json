{"kind":"symbol","sections":[],"hierarchy":{"paths":[["doc:\/\/GLibObject\/documentation\/GLibObject"]]},"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/glibobject\/classinitfunc"]}],"metadata":{"roleHeading":"Type Alias","navigatorTitle":[{"text":"ClassInitFunc","kind":"identifier"}],"title":"ClassInitFunc","externalID":"s:10GLibObject13ClassInitFunca","modules":[{"name":"GLibObject"}],"symbolKind":"typealias","role":"symbol","fragments":[{"kind":"keyword","text":"typealias"},{"text":" ","kind":"text"},{"kind":"identifier","text":"ClassInitFunc"}]},"schemaVersion":{"major":0,"minor":3,"patch":0},"identifier":{"interfaceLanguage":"swift","url":"doc:\/\/GLibObject\/documentation\/GLibObject\/ClassInitFunc"},"primaryContentSections":[{"kind":"declarations","declarations":[{"tokens":[{"text":"typealias","kind":"keyword"},{"text":" ","kind":"text"},{"kind":"identifier","text":"ClassInitFunc"},{"kind":"text","text":" = "},{"kind":"typeIdentifier","text":"GClassInitFunc","preciseIdentifier":"c:gtype.h@T@GClassInitFunc"}],"languages":["swift"],"platforms":["macOS"]}]},{"kind":"content","content":[{"text":"Discussion","type":"heading","level":2,"anchor":"discussion"},{"type":"paragraph","inlineContent":[{"type":"text","text":"This function should initialize all static class members."}]},{"type":"paragraph","inlineContent":[{"text":"The initialization process of a class involves:","type":"text"}]},{"items":[{"content":[{"inlineContent":[{"text":"Copying common members from the parent class over to the","type":"text"},{"text":" ","type":"text"},{"type":"text","text":"derived class structure."}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"type":"text","text":"Zero initialization of the remaining members not copied"},{"type":"text","text":" "},{"text":"over from the parent class.","type":"text"}],"type":"paragraph"}]},{"content":[{"type":"paragraph","inlineContent":[{"text":"Invocation of the ","type":"text"},{"type":"codeVoice","code":"GBaseInitFunc()"},{"type":"text","text":" initializers of all parent"},{"type":"text","text":" "},{"type":"text","text":"types and the class’ type."}]}]},{"content":[{"inlineContent":[{"type":"text","text":"Invocation of the class’ "},{"code":"GClassInitFunc()","type":"codeVoice"},{"type":"text","text":" initializer."}],"type":"paragraph"}]}],"type":"unorderedList"},{"type":"paragraph","inlineContent":[{"type":"text","text":"Since derived classes are partially initialized through a memory copy"},{"type":"text","text":" "},{"type":"text","text":"of the parent class, the general rule is that "},{"code":"GBaseInitFunc()","type":"codeVoice"},{"type":"text","text":" and"},{"text":" ","type":"text"},{"code":"GBaseFinalizeFunc()","type":"codeVoice"},{"text":" should take care of necessary reinitialization","type":"text"},{"type":"text","text":" "},{"text":"and release of those class members that were introduced by the type","type":"text"},{"type":"text","text":" "},{"text":"that specified these ","type":"text"},{"code":"GBaseInitFunc()``\/GBaseFinalizeFunc()","type":"codeVoice"},{"text":".","type":"text"},{"type":"text","text":" "},{"type":"codeVoice","code":"GClassInitFunc()"},{"text":" should only care about initializing static","type":"text"},{"type":"text","text":" "},{"type":"text","text":"class members, while dynamic class members (such as allocated strings"},{"type":"text","text":" "},{"type":"text","text":"or reference counted resources) are better handled by a "},{"type":"codeVoice","code":"GBaseInitFunc()"},{"text":" ","type":"text"},{"type":"text","text":"for this type, so proper initialization of the dynamic class members"},{"text":" ","type":"text"},{"text":"is performed for class initialization of derived types as well.","type":"text"}]},{"type":"paragraph","inlineContent":[{"text":"An example may help to correspond the intend of the different class","type":"text"},{"type":"text","text":" "},{"type":"text","text":"initializers:"}]},{"type":"paragraph","inlineContent":[{"text":"(C Language Example):","type":"text"}]},{"syntax":"C","code":["typedef struct {","  GObjectClass parent_class;","  gint         static_integer;","  gchar       *dynamic_string;","} TypeAClass;","static void","type_a_base_class_init (TypeAClass *class)","{","  class->dynamic_string = g_strdup (\"some string\");","}","static void","type_a_base_class_finalize (TypeAClass *class)","{","  g_free (class->dynamic_string);","}","static void","type_a_class_init (TypeAClass *class)","{","  class->static_integer = 42;","}","","typedef struct {","  TypeAClass   parent_class;","  gfloat       static_float;","  GString     *dynamic_gstring;","} TypeBClass;","static void","type_b_base_class_init (TypeBClass *class)","{","  class->dynamic_gstring = g_string_new (\"some other string\");","}","static void","type_b_base_class_finalize (TypeBClass *class)","{","  g_string_free (class->dynamic_gstring);","}","static void","type_b_class_init (TypeBClass *class)","{","  class->static_float = 3.14159265358979323846;","}"],"type":"codeListing"},{"type":"paragraph","inlineContent":[{"type":"text","text":"Initialization of TypeBClass will first cause initialization of"},{"text":" ","type":"text"},{"type":"text","text":"TypeAClass (derived classes reference their parent classes, see"},{"text":" ","type":"text"},{"type":"codeVoice","code":"g_type_class_ref()"},{"type":"text","text":" on this)."}]},{"inlineContent":[{"text":"Initialization of TypeAClass roughly involves zero-initializing its fields,","type":"text"},{"type":"text","text":" "},{"type":"text","text":"then calling its "},{"code":"GBaseInitFunc()","type":"codeVoice"},{"type":"text","text":" "},{"type":"codeVoice","code":"type_a_base_class_init()"},{"text":" to allocate","type":"text"},{"text":" ","type":"text"},{"type":"text","text":"its dynamic members (dynamic_string), and finally calling its "},{"type":"codeVoice","code":"GClassInitFunc()"},{"text":" ","type":"text"},{"type":"codeVoice","code":"type_a_class_init()"},{"text":" to initialize its static members (static_integer).","type":"text"},{"type":"text","text":" "},{"type":"text","text":"The first step in the initialization process of TypeBClass is then"},{"type":"text","text":" "},{"type":"text","text":"a plain memory copy of the contents of TypeAClass into TypeBClass and"},{"text":" ","type":"text"},{"type":"text","text":"zero-initialization of the remaining fields in TypeBClass."},{"type":"text","text":" "},{"text":"The dynamic members of TypeAClass within TypeBClass now need","type":"text"},{"type":"text","text":" "},{"text":"reinitialization which is performed by calling ","type":"text"},{"type":"codeVoice","code":"type_a_base_class_init()"},{"type":"text","text":" "},{"text":"with an argument of TypeBClass.","type":"text"}],"type":"paragraph"},{"inlineContent":[{"type":"text","text":"After that, the "},{"code":"GBaseInitFunc()","type":"codeVoice"},{"text":" of TypeBClass, ","type":"text"},{"type":"codeVoice","code":"type_b_base_class_init()"},{"type":"text","text":" "},{"type":"text","text":"is called to allocate the dynamic members of TypeBClass (dynamic_gstring),"},{"type":"text","text":" "},{"text":"and finally the ","type":"text"},{"type":"codeVoice","code":"GClassInitFunc()"},{"type":"text","text":" of TypeBClass, "},{"type":"codeVoice","code":"type_b_class_init()"},{"type":"text","text":","},{"type":"text","text":" "},{"type":"text","text":"is called to complete the initialization process with the static members"},{"text":" ","type":"text"},{"text":"(static_float).","type":"text"}],"type":"paragraph"},{"inlineContent":[{"type":"text","text":"Corresponding finalization counter parts to the "},{"type":"codeVoice","code":"GBaseInitFunc()"},{"type":"text","text":" functions"},{"type":"text","text":" "},{"type":"text","text":"have to be provided to release allocated resources at class finalization"},{"text":" ","type":"text"},{"type":"text","text":"time."}],"type":"paragraph"}]}],"abstract":[{"type":"text","text":"A callback function used by the type system to initialize the class"},{"type":"text","text":" "},{"text":"of a specific type.","type":"text"}],"references":{"doc://GLibObject/documentation/GLibObject/ClassInitFunc":{"type":"topic","kind":"symbol","identifier":"doc:\/\/GLibObject\/documentation\/GLibObject\/ClassInitFunc","title":"ClassInitFunc","role":"symbol","fragments":[{"kind":"keyword","text":"typealias"},{"kind":"text","text":" "},{"text":"ClassInitFunc","kind":"identifier"}],"abstract":[{"type":"text","text":"A callback function used by the type system to initialize the class"},{"text":" ","type":"text"},{"text":"of a specific type.","type":"text"}],"url":"\/documentation\/glibobject\/classinitfunc","navigatorTitle":[{"kind":"identifier","text":"ClassInitFunc"}]},"doc://GLibObject/documentation/GLibObject":{"role":"collection","identifier":"doc:\/\/GLibObject\/documentation\/GLibObject","type":"topic","url":"\/documentation\/glibobject","title":"GLibObject","abstract":[],"kind":"symbol"}}}