{"sections":[],"abstract":[{"type":"codeVoice","code":"GTypeModule"},{"text":" provides a simple implementation of the ","type":"text"},{"type":"codeVoice","code":"GTypePlugin"},{"type":"text","text":" "},{"type":"text","text":"interface."}],"topicSections":[{"anchor":"Instance-Properties","generated":true,"identifiers":["doc:\/\/GLibObject\/documentation\/GLibObject\/TypeModuleProtocol\/interfaceInfos","doc:\/\/GLibObject\/documentation\/GLibObject\/TypeModuleProtocol\/name","doc:\/\/GLibObject\/documentation\/GLibObject\/TypeModuleProtocol\/parentInstance","doc:\/\/GLibObject\/documentation\/GLibObject\/TypeModuleProtocol\/typeInfos","doc:\/\/GLibObject\/documentation\/GLibObject\/TypeModuleProtocol\/type_module_ptr-lh1o","doc:\/\/GLibObject\/documentation\/GLibObject\/TypeModuleProtocol\/useCount"],"title":"Instance Properties"},{"anchor":"Instance-Methods","generated":true,"title":"Instance Methods","identifiers":["doc:\/\/GLibObject\/documentation\/GLibObject\/TypeModuleProtocol\/addInterface(instanceType:interfaceType:interfaceInfo:)","doc:\/\/GLibObject\/documentation\/GLibObject\/TypeModuleProtocol\/registerEnum(name:constStaticValues:)","doc:\/\/GLibObject\/documentation\/GLibObject\/TypeModuleProtocol\/registerFlags(name:constStaticValues:)","doc:\/\/GLibObject\/documentation\/GLibObject\/TypeModuleProtocol\/registerType(parentType:typeName:typeInfo:flags:)","doc:\/\/GLibObject\/documentation\/GLibObject\/TypeModuleProtocol\/set(name:)","doc:\/\/GLibObject\/documentation\/GLibObject\/TypeModuleProtocol\/unuse()","doc:\/\/GLibObject\/documentation\/GLibObject\/TypeModuleProtocol\/use()"]}],"relationshipsSections":[{"title":"Inherits From","kind":"relationships","identifiers":["doc:\/\/GLibObject\/4GLib14PointerWrapperP","doc:\/\/GLibObject\/documentation\/GLibObject\/ObjectProtocol","doc:\/\/GLibObject\/documentation\/GLibObject\/TypePluginProtocol"],"type":"inheritsFrom"},{"title":"Conforming Types","type":"conformingTypes","kind":"relationships","identifiers":["doc:\/\/GLibObject\/documentation\/GLibObject\/TypeModule","doc:\/\/GLibObject\/documentation\/GLibObject\/TypeModuleRef"]}],"kind":"symbol","hierarchy":{"paths":[["doc:\/\/GLibObject\/documentation\/GLibObject"]]},"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/glibobject\/typemoduleprotocol"]}],"metadata":{"roleHeading":"Protocol","role":"symbol","fragments":[{"kind":"keyword","text":"protocol"},{"text":" ","kind":"text"},{"kind":"identifier","text":"TypeModuleProtocol"}],"modules":[{"name":"GLibObject"}],"externalID":"s:10GLibObject18TypeModuleProtocolP","navigatorTitle":[{"text":"TypeModuleProtocol","kind":"identifier"}],"symbolKind":"protocol","title":"TypeModuleProtocol"},"schemaVersion":{"patch":0,"major":0,"minor":3},"identifier":{"url":"doc:\/\/GLibObject\/documentation\/GLibObject\/TypeModuleProtocol","interfaceLanguage":"swift"},"primaryContentSections":[{"declarations":[{"platforms":["macOS"],"tokens":[{"text":"protocol","kind":"keyword"},{"text":" ","kind":"text"},{"kind":"identifier","text":"TypeModuleProtocol"},{"kind":"text","text":" : "},{"identifier":"doc:\/\/GLibObject\/documentation\/GLibObject\/ObjectProtocol","preciseIdentifier":"s:10GLibObject0B8ProtocolP","text":"ObjectProtocol","kind":"typeIdentifier"},{"text":", ","kind":"text"},{"kind":"typeIdentifier","identifier":"doc:\/\/GLibObject\/documentation\/GLibObject\/TypePluginProtocol","text":"TypePluginProtocol","preciseIdentifier":"s:10GLibObject18TypePluginProtocolP"}],"languages":["swift"]}],"kind":"declarations"},{"content":[{"anchor":"overview","text":"Overview","level":2,"type":"heading"},{"inlineContent":[{"type":"text","text":"The model of "},{"type":"codeVoice","code":"GTypeModule"},{"type":"text","text":" is a dynamically loaded module which"},{"type":"text","text":" "},{"type":"text","text":"implements some number of types and interface implementations."}],"type":"paragraph"},{"type":"paragraph","inlineContent":[{"text":"When the module is loaded, it registers its types and interfaces","type":"text"},{"type":"text","text":" "},{"type":"text","text":"using [method"},{"code":"GObject.TypeModule.register_type","type":"codeVoice"},{"text":"] and","type":"text"},{"type":"text","text":" "},{"text":"[method","type":"text"},{"type":"codeVoice","code":"GObject.TypeModule.add_interface"},{"type":"text","text":"]."},{"type":"text","text":" "},{"text":"As long as any instances of these types and interface implementations","type":"text"},{"text":" ","type":"text"},{"text":"are in use, the module is kept loaded. When the types and interfaces","type":"text"},{"type":"text","text":" "},{"type":"text","text":"are gone, the module may be unloaded. If the types and interfaces"},{"text":" ","type":"text"},{"text":"become used again, the module will be reloaded. Note that the last","type":"text"},{"type":"text","text":" "},{"type":"text","text":"reference cannot be released from within the module code, since that"},{"type":"text","text":" "},{"type":"text","text":"would lead to the caller’s code being unloaded before "},{"type":"codeVoice","code":"g_object_unref()"},{"text":" ","type":"text"},{"type":"text","text":"returns to it."}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"Keeping track of whether the module should be loaded or not is done by"},{"type":"text","text":" "},{"type":"text","text":"using a use count - it starts at zero, and whenever it is greater than"},{"type":"text","text":" "},{"type":"text","text":"zero, the module is loaded. The use count is maintained internally by"},{"type":"text","text":" "},{"text":"the type system, but also can be explicitly controlled by","type":"text"},{"type":"text","text":" "},{"text":"[method","type":"text"},{"type":"codeVoice","code":"GObject.TypeModule.use"},{"text":"] and [method","type":"text"},{"code":"GObject.TypeModule.unuse","type":"codeVoice"},{"text":"].","type":"text"},{"text":" ","type":"text"},{"type":"text","text":"Typically, when loading a module for the first type, "},{"type":"codeVoice","code":"g_type_module_use()"},{"text":" ","type":"text"},{"type":"text","text":"will be used to load it so that it can initialize its types. At some later"},{"text":" ","type":"text"},{"type":"text","text":"point, when the module no longer needs to be loaded except for the type"},{"text":" ","type":"text"},{"type":"text","text":"implementations it contains, "},{"type":"codeVoice","code":"g_type_module_unuse()"},{"type":"text","text":" is called."}]},{"type":"paragraph","inlineContent":[{"code":"GTypeModule","type":"codeVoice"},{"type":"text","text":" does not actually provide any implementation of module"},{"text":" ","type":"text"},{"text":"loading and unloading. To create a particular module type you must","type":"text"},{"text":" ","type":"text"},{"text":"derive from ","type":"text"},{"code":"GTypeModule","type":"codeVoice"},{"type":"text","text":" and implement the load and unload functions"},{"type":"text","text":" "},{"text":"in ","type":"text"},{"code":"GTypeModuleClass","type":"codeVoice"},{"type":"text","text":"."}]},{"inlineContent":[{"text":"The ","type":"text"},{"isActive":true,"type":"reference","identifier":"doc:\/\/GLibObject\/documentation\/GLibObject\/TypeModuleProtocol"},{"type":"text","text":" protocol exposes the methods and properties of an underlying "},{"code":"GTypeModule","type":"codeVoice"},{"type":"text","text":" instance."},{"text":" ","type":"text"},{"type":"text","text":"The default implementation of these can be found in the protocol extension below."},{"type":"text","text":" "},{"text":"For a concrete class that implements these methods and properties, see ","type":"text"},{"type":"reference","identifier":"doc:\/\/GLibObject\/documentation\/GLibObject\/TypeModule","isActive":true},{"type":"text","text":"."},{"text":" ","type":"text"},{"type":"text","text":"Alternatively, use "},{"type":"reference","identifier":"doc:\/\/GLibObject\/documentation\/GLibObject\/TypeModuleRef","isActive":true},{"text":" as a lighweight, ","type":"text"},{"type":"codeVoice","code":"unowned"},{"text":" reference if you already have an instance you just want to use.","type":"text"}],"type":"paragraph"}],"kind":"content"}],"references":{"doc://GLibObject/documentation/GLibObject/TypeModuleProtocol/useCount":{"abstract":[],"role":"symbol","url":"\/documentation\/glibobject\/typemoduleprotocol\/usecount","type":"topic","kind":"symbol","title":"useCount","identifier":"doc:\/\/GLibObject\/documentation\/GLibObject\/TypeModuleProtocol\/useCount","fragments":[{"kind":"keyword","text":"var"},{"text":" ","kind":"text"},{"text":"useCount","kind":"identifier"},{"kind":"text","text":": "},{"preciseIdentifier":"c:gtypes.h@T@guint","text":"guint","kind":"typeIdentifier"}]},"doc://GLibObject/documentation/GLibObject/TypeModuleProtocol/parentInstance":{"kind":"symbol","abstract":[],"type":"topic","role":"symbol","title":"parentInstance","url":"\/documentation\/glibobject\/typemoduleprotocol\/parentinstance","fragments":[{"text":"var","kind":"keyword"},{"kind":"text","text":" "},{"text":"parentInstance","kind":"identifier"},{"text":": ","kind":"text"},{"kind":"typeIdentifier","text":"GObject"}],"identifier":"doc:\/\/GLibObject\/documentation\/GLibObject\/TypeModuleProtocol\/parentInstance"},"doc://GLibObject/documentation/GLibObject/TypeModuleProtocol/addInterface(instanceType:interfaceType:interfaceInfo:)":{"abstract":[{"type":"text","text":"Registers an additional interface for a type, whose interface lives"},{"text":" ","type":"text"},{"text":"in the given type plugin. If the interface was already registered","type":"text"},{"type":"text","text":" "},{"type":"text","text":"for the type in this plugin, nothing will be done."}],"role":"symbol","url":"\/documentation\/glibobject\/typemoduleprotocol\/addinterface(instancetype:interfacetype:interfaceinfo:)","type":"topic","kind":"symbol","title":"addInterface(instanceType:interfaceType:interfaceInfo:)","identifier":"doc:\/\/GLibObject\/documenta