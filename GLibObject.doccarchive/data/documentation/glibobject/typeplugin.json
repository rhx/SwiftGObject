{"primaryContentSections":[{"kind":"declarations","declarations":[{"platforms":["macOS"],"languages":["swift"],"tokens":[{"kind":"keyword","text":"class"},{"text":" ","kind":"text"},{"kind":"identifier","text":"TypePlugin"}]}]},{"content":[{"text":"Overview","anchor":"overview","type":"heading","level":2},{"inlineContent":[{"text":"The GObject type system supports dynamic loading of types.","type":"text"},{"type":"text","text":" "},{"text":"It goes as follows:","type":"text"}],"type":"paragraph"},{"type":"orderedList","items":[{"content":[{"inlineContent":[{"type":"text","text":"The type is initially introduced (usually upon loading the module"},{"text":" ","type":"text"},{"type":"text","text":"the first time, or by your main application that knows what modules"},{"text":" ","type":"text"},{"text":"introduces what types), like this:","type":"text"}],"type":"paragraph"},{"syntax":"c","code":["new_type_id = g_type_register_dynamic (parent_type_id,","                                       \"TypeName\",","                                       new_type_plugin,","                                       type_flags);"],"type":"codeListing"},{"inlineContent":[{"text":"where ","type":"text"},{"code":"new_type_plugin","type":"codeVoice"},{"type":"text","text":" is an implementation of the"},{"text":" ","type":"text"},{"code":"GTypePlugin","type":"codeVoice"},{"type":"text","text":" interface."}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"type":"text","text":"The type’s implementation is referenced, e.g. through"},{"type":"text","text":" "},{"text":"[func","type":"text"},{"code":"GObject.TypeClass.ref","type":"codeVoice"},{"type":"text","text":"] or through [func"},{"code":"GObject.type_create_instance","type":"codeVoice"},{"type":"text","text":"]"},{"text":" ","type":"text"},{"text":"(this is being called by [ctor","type":"text"},{"type":"codeVoice","code":"GObject.Object.new"},{"text":"]) or through one of the above","type":"text"},{"text":" ","type":"text"},{"text":"done on a type derived from ","type":"text"},{"code":"new_type_id","type":"codeVoice"},{"type":"text","text":"."}],"type":"paragraph"}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"This causes the type system to load the type’s implementation by calling"},{"text":" ","type":"text"},{"text":"[method","type":"text"},{"code":"GObject.TypePlugin.use","type":"codeVoice"},{"type":"text","text":"] and [method"},{"code":"GObject.TypePlugin.complete_type_info","type":"codeVoice"},{"text":"]","type":"text"},{"text":" ","type":"text"},{"text":"on ","type":"text"},{"type":"codeVoice","code":"new_type_plugin"},{"text":".","type":"text"}]}]},{"content":[{"inlineContent":[{"type":"text","text":"At some point the type’s implementation isn’t required anymore, e.g. after"},{"type":"text","text":" "},{"type":"text","text":"[method"},{"code":"GObject.TypeClass.unref","type":"codeVoice"},{"type":"text","text":"] or [func"},{"code":"GObject.type_free_instance","type":"codeVoice"},{"text":"]","type":"text"},{"type":"text","text":" "},{"type":"text","text":"(called when the reference count of an instance drops to zero)."}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"type":"text","text":"This causes the type system to throw away the information retrieved"},{"type":"text","text":" "},{"type":"text","text":"from [method"},{"code":"GObject.TypePlugin.complete_type_info","type":"codeVoice"},{"type":"text","text":"] and then it calls"},{"type":"text","text":" "},{"text":"[method","type":"text"},{"code":"GObject.TypePlugin.unuse","type":"codeVoice"},{"text":"] on ","type":"text"},{"code":"new_type_plugin","type":"codeVoice"},{"text":".","type":"text"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"text":"Things may repeat from the second step.","type":"text"}],"type":"paragraph"}]}]},{"inlineContent":[{"type":"text","text":"So basically, you need to implement a "},{"code":"GTypePlugin","type":"codeVoice"},{"type":"text","text":" type that"},{"type":"text","text":" "},{"type":"text","text":"carries a use_count, once use_count goes from zero to one, you need"},{"type":"text","text":" "},{"text":"to load the implementation to successfully handle the upcoming","type":"text"},{"text":" ","type":"text"},{"text":"[method","type":"text"},{"type":"codeVoice","code":"GObject.TypePlugin.complete_type_info"},{"type":"text","text":"] call. Later, maybe after"},{"text":" ","type":"text"},{"text":"succeeding use\/unuse calls, once use_count drops to zero, you can","type":"text"},{"type":"text","text":" "},{"type":"text","text":"unload the implementation again. The type system makes sure to call"},{"type":"text","text":" "},{"type":"text","text":"[method"},{"type":"codeVoice","code":"GObject.TypePlugin.use"},{"text":"] and [method","type":"text"},{"type":"codeVoice","code":"GObject.TypePlugin.complete_type_info"},{"type":"text","text":"]"},{"text":" ","type":"text"},{"text":"again when the type is needed again.","type":"text"}],"type":"paragraph"},{"inlineContent":[{"type":"text","text":"[class"},{"isActive":true,"type":"reference","identifier":"doc:\/\/GLibObject\/documentation\/GLibObject\/TypeModule"},{"type":"text","text":"] is an implementation of "},{"code":"GTypePlugin","type":"codeVoice"},{"text":" that","type":"text"},{"text":" ","type":"text"},{"type":"text","text":"already implements most of this except for the actual module loading and"},{"text":" ","type":"text"},{"type":"text","text":"unloading. It even handles multiple registered types per module."}],"type":"paragraph"},{"inlineContent":[{"type":"text","text":"The "},{"type":"reference","identifier":"doc:\/\/GLibObject\/documentation\/GLibObject\/TypePlugin","isActive":true},{"text":" type acts as an owner of an underlying ","type":"text"},{"type":"codeVoice","code":"GTypePlugin"},{"text":" instance.","type":"text"},{"type":"text","text":" "},{"type":"text","text":"It provides the methods that can operate on this data type through "},{"type":"reference","identifier":"doc:\/\/GLibObject\/documentation\/GLibObject\/TypePluginProtocol","isActive":true},{"text":" conformance.","type":"text"},{"type":"text","text":" "},{"text":"Use ","type":"text"},{"type":"reference","identifier":"doc:\/\/GLibObject\/documentation\/GLibObject\/TypePlugin","isActive":true},{"text":" as a strong reference or owner of a ","type":"text"},{"code":"GTypePlugin","type":"codeVoice"},{"type":"text","text":" instance."}],"type":"paragraph"},{"style":"note","type":"aside","content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"Use "},{"identifier":"doc:\/\/GLibObject\/documentation\/GLibObject\/TypePluginRef","isActive":true,"type":"reference"},{"text":" (instead of ","type":"text"},{"type":"reference","identifier":"doc:\/\/GLibObject\/documentation\/GLibObject\/TypePlugin","isActive":true},{"type":"text","text":") for a lightweight Swift reference to an underlying "},{"code":"GTypePlugin","type":"codeVoice"},{"type":"text","text":" instance."}]}],"name":"Note"}],"kind":"content"}],"variants":[{"paths":["\/documentation\/glibobject\/typeplugin"],"traits":[{"interfaceLanguage":"swift"}]}],"relationshipsSections":[{"title":"Conforms To","identifiers":["doc:\/\/GLibObject\/4GLib14PointerWrapperP","doc:\/\/GLibObject\/documentation\/GLibObject\/TypePluginProtocol"],"type":"conformsTo","kind":"relationships"}],"schemaVersion":{"major":0,"patch":0,"minor":3},"identifier":{"interfaceLanguage":"swift","url":"doc:\/\/GLibObject\/documentation\/GLibObject\/TypePlugin"},"topicSections":[{"generated":true,"title":"Initializers","identifiers":["doc:\/\/GLibObject\/documentation\/GLibObject\/TypePlugin\/init(_:)-3cm5a","doc:\/\/GLibObject\/documentation\/GLibObject\/TypePlugin\/init(_:)-62sev","doc:\/\/GLibObject\/documentation\/GLibObject\/TypePlugin\/init(_:)-62wpb","doc:\/\/GLibObject\/documentation\/GLibObject\/TypePlugin\/init(_:)-8ummq","doc:\/\/GLibObject\/documentation\/GLibObject\/TypePlugin\/init(_:)-92sfd","doc:\/\/GLibObject\/documentation