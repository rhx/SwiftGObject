ctProtocol"}],"platforms":["macOS"]}],"kind":"declarations"},{"kind":"content","content":[{"anchor":"discussion","level":2,"text":"Discussion","type":"heading"},{"type":"paragraph","inlineContent":[{"type":"text","text":"Whenever the "},{"type":"codeVoice","code":"sourceProperty"},{"text":" is changed the ","type":"text"},{"type":"codeVoice","code":"targetProperty"},{"type":"text","text":" is"},{"text":" ","type":"text"},{"text":"updated using the same value. For instance:","type":"text"}]},{"inlineContent":[{"text":"(C Language Example):","type":"text"}],"type":"paragraph"},{"code":["  g_object_bind_property (action, \"active\", widget, \"sensitive\", 0);"],"syntax":"C","type":"codeListing"},{"inlineContent":[{"text":"Will result in the “sensitive” property of the widget ","type":"text"},{"isActive":true,"type":"reference","identifier":"doc:\/\/GLibObject\/documentation\/GLibObject\/Object"},{"text":" instance to be","type":"text"},{"type":"text","text":" "},{"type":"text","text":"updated with the same value of the “active” property of the action "},{"identifier":"doc:\/\/GLibObject\/documentation\/GLibObject\/Object","isActive":true,"type":"reference"},{"text":" ","type":"text"},{"type":"text","text":"instance."}],"type":"paragraph"},{"type":"paragraph","inlineContent":[{"text":"If ","type":"text"},{"code":"flags","type":"codeVoice"},{"type":"text","text":" contains "},{"type":"codeVoice","code":"bidirectional"},{"type":"text","text":" then the binding will be mutual:"},{"type":"text","text":" "},{"type":"text","text":"if "},{"type":"codeVoice","code":"targetProperty"},{"type":"text","text":" on "},{"code":"target","type":"codeVoice"},{"type":"text","text":" changes then the "},{"type":"codeVoice","code":"sourceProperty"},{"type":"text","text":" on "},{"code":"source","type":"codeVoice"},{"text":" ","type":"text"},{"text":"will be updated as well.","type":"text"}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"The binding will automatically be remove