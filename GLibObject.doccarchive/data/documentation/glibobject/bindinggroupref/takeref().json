{"abstract":[{"text":"If ","type":"text"},{"code":"object","type":"codeVoice"},{"type":"text","text":" is floating, sink it.  Otherwise, do nothing."}],"primaryContentSections":[{"kind":"declarations","declarations":[{"languages":["swift"],"tokens":[{"text":"func","kind":"keyword"},{"kind":"text","text":" "},{"text":"takeRef","kind":"identifier"},{"kind":"text","text":"() -> "},{"preciseIdentifier":"s:10GLibObject0B3RefV","identifier":"doc:\/\/GLibObject\/documentation\/GLibObject\/ObjectRef","kind":"typeIdentifier","text":"ObjectRef"},{"kind":"text","text":"!"}],"platforms":["macOS"]}]},{"content":[{"anchor":"discussion","type":"heading","level":2,"text":"Discussion"},{"type":"paragraph","inlineContent":[{"type":"text","text":"In other words, this function will convert a floating reference (if"},{"text":" ","type":"text"},{"type":"text","text":"present) into a full reference."}]},{"inlineContent":[{"type":"text","text":"Typically you want to use "},{"type":"codeVoice","code":"g_object_ref_sink()"},{"type":"text","text":" in order to"},{"type":"text","text":" "},{"type":"text","text":"automatically do the correct thing with respect to floating or"},{"type":"text","text":" "},{"type":"text","text":"non-floating references, but there is one specific scenario where"},{"text":" ","type":"text"},{"type":"text","text":"this function is helpful."}],"type":"paragraph"},{"inlineContent":[{"type":"text","text":"The situation where this function is helpful is when creating an API"},{"type":"text","text":" "},{"type":"text","text":"that allows the user to provide a callback function that returns a"},{"text":" ","type":"text"},{"type":"text","text":"GObject. We certainly want to allow the user the flexibility to"},{"type":"text","text":" "},{"text":"return a non-floating reference from this callback (for the case","type":"text"},{"type":"text","text":" "},{"type":"text","text":"where the object that is being returned already exists)."}],"type":"paragraph"},{"inlineContent":[{"text":"At the same time, the API style of some popular GObject-based","type":"text"},{"type":"text","text":" "},{"type":"text","text":"libraries (such as Gtk) make it likely that for newly-created GObject"},{"type":"text","text":" "},{"text":"instances, the user can be saved some typing if they are allowed to","type":"text"},{"type":"text","text":" "},{"text":"return a floating reference.","type":"text"}],"type":"paragraph"},{"type":"paragraph","inlineContent":[{"text":"Using this function on the return value of the user’s callback allows","type":"text"},{"type":"text","text":" "},{"type":"text","text":"the user to do whichever is more convenient for them. The caller will"},{"text":" ","type":"text"},{"text":"always receives exactly one full reference to the value: either the","type":"text"},{"type":"text","text":" "},{"type":"text","text":"one that was returned in the first place, or a floating reference"},{"type":"text","text":" "},{"text":"that has been converted to a full reference.","type":"text"}]},{"inlineContent":[{"type":"text","text":"This function has an odd interaction when combined with"},{"type":"text","text":" "},{"code":"g_object_ref_sink()","type":"codeVoice"},{"text":" running at the same time in another thread on","type":"text"},{"type":"text","text":" "},{"text":"the same ","type":"text"},{"identifier":"doc:\/\/GLibObject\/documentation\/GLibObject\/Object","isActive":true,"type":"reference"},{"type":"text","text":" instance. If "},{"code":"g_object_ref_sink()","type":"codeVoice"},{"text":" runs first then","type":"text"},{"type":"text","text":" "},{"text":"the result will be that the floating reference is converted to a hard","type":"text"},{"type":"text","text":" "},{"text":"reference. If ","type":"text"},{"type":"codeVoice","code":"g_object_take_ref()"},{"text":" runs first then the result will be","type":"text"},{"text":" ","type":"text"},{"text":"that the floating reference is converted to a hard reference and an","type":"text"},{"type":"text","text":" "},{"type":"text","text":"additional reference on top of that one is added. It is best to avoid"},{"type":"text","text":" "},{"type":"text","text":"this situation."}],"type":"paragraph"}],"kind":"content"}],"schemaVersion":{"patch":0,"major":0,"minor":3},"metadata":{"title":"takeRef()","role":"symbol","externalID":"s:10GLibObject0B8ProtocolPAAE7takeRefAA0bE0VSgyF::SYNTHESIZED::s:10GLibObject15BindingGroupRefV","roleHeading":"Instance Method","extendedModule":"GLibObject","symbolKind":"method","modules":[{"name":"GLibObject"}],"fragments":[{"kind":"keyword","text":"func"},{"text":" ","kind":"text"},{"kind":"identifier","text":"takeRef"},{"kind":"text","text":"() -> "},{"kind":"typeIdentifier","preciseIdentifier":"s:10GLibObject0B3RefV","text":"ObjectRef"},{"text":"!","kind":"text"}]},"hierarchy":{"paths":[["doc:\/\/GLibObject\/documentation\/GLibObject","doc:\/\/GLibObject\/documentation\/GLibObject\/BindingGroupRef","doc:\/\/GLibObject\/documentation\/GLibObject\/BindingGroupRef\/ObjectProtocol-Implementations"]]},"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/glibobject\/bindinggroupref\/takeref()"]}],"identifier":{"url":"doc:\/\/GLibObject\/documentation\/GLibObject\/BindingGroupRef\/takeRef()","interfaceLanguage":"swift"},"kind":"symbol","sections":[],"references":{"doc://GLibObject/documentation/GLibObject/ObjectRef":{"fragments":[{"text":"struct","kind":"keyword"},{"kind":"text","text":" "},{"text":"ObjectRef","kind":"identifier"}],"type":"topic","kind":"symbol","navigatorTitle":[{"text":"ObjectRef","kind":"identifier"}],"abstract":[{"text":"The base object type.","type":"text"}],"identifier":"doc:\/\/GLibObject\/documentation\/GLibObject\/ObjectRef","url":"\/documentation\/glibobject\/objectref","role":"symbol","title":"ObjectRef"},"doc://GLibObject/documentation/GLibObject":{"role":"collection","identifier":"doc:\/\/GLibObject\/documentation\/GLibObject","type":"topic","url":"\/documentation\/glibobject","title":"GLibObject","abstract":[],"kind":"symbol"},"doc://GLibObject/documentation/GLibObject/BindingGroupRef/takeRef()":{"type":"topic","fragments":[{"kind":"keyword","text":"func"},{"kind":"text","text":" "},{"kind":"identifier","text":"takeRef"},{"text":"() -> ","kind":"text"},{"kind":"typeIdentifier","text":"ObjectRef","preciseIdentifier":"s:10GLibObject0B3RefV"},{"text":"!","kind":"text"}],"role":"symbol","title":"takeRef()","url":"\/documentation\/glibobject\/bindinggroupref\/takeref()","identifier":"doc:\/\/GLibObject\/documentation\/GLibObject\/BindingGroupRef\/takeRef()","abstract":[{"text":"If ","type":"text"},{"code":"object","type":"codeVoice"},{"type":"text","text":" is floating, sink it.  Otherwise, do nothing."}],"kind":"symbol"},"doc://GLibObject/documentation/GLibObject/Object":{"navigatorTitle":[{"text":"Object","kind":"identifier"}],"type":"topic","url":"\/documentation\/glibobject\/object","identifier":"doc:\/\/GLibObject\/documentation\/GLibObject\/Object","abstract":[{"type":"text","text":"The base object type."}],"kind":"symbol","title":"Object","role":"symbol","fragments":[{"kind":"keyword","text":"class"},{"kind":"text","text":" "},{"kind":"identifier","text":"Object"}]},"doc://GLibObject/documentation/GLibObject/BindingGroupRef/ObjectProtocol-Implementations":{"abstract":[],"title":"ObjectProtocol Implementations","identifier":"doc:\/\/GLibObject\/documentation\/GLibObject\/BindingGroupRef\/ObjectProtocol-Implementations","role":"collectionGroup","kind":"article","url":"\/documentation\/glibobject\/bindinggroupref\/objectprotocol-implementations","type":"topic"},"doc://GLibObject/documentation/GLibObject/BindingGroupRef":{"title":"BindingGroupRef","role":"symbol","navigatorTitle":[{"text":"BindingGroupRef","kind":"identifier"}],"abstract":[{"type":"codeVoice","code":"GBindingGroup"},{"text":" can be used to bind multiple properties","type":"text"},{"text":" ","type":"text"},{"type":"text","text":"from an object collectively."}],"kind":"symbol","type":"topic","identifier":"doc:\/\/GLibObject\/documentation\/GLibObject\/BindingGroupRef","fragments":[{"kind":"keyword","text":"struct"},{"text":" ","kind":"text"},{"kind":"identifier","text":"BindingGroupRef"}],"url":"\/documentation\/glibobject\/bindinggroupref"}}}