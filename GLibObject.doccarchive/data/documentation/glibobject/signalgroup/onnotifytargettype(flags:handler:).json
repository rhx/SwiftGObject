{"identifier":{"url":"doc:\/\/GLibObject\/documentation\/GLibObject\/SignalGroup\/onNotifyTargetType(flags:handler:)","interfaceLanguage":"swift"},"schemaVersion":{"major":0,"minor":3,"patch":0},"primaryContentSections":[{"kind":"declarations","declarations":[{"tokens":[{"kind":"attribute","text":"@discardableResult"},{"kind":"text","text":" "},{"text":"func","kind":"keyword"},{"text":" ","kind":"text"},{"text":"onNotifyTargetType","kind":"identifier"},{"text":"(","kind":"text"},{"kind":"externalParam","text":"flags"},{"kind":"text","text":": "},{"kind":"typeIdentifier","preciseIdentifier":"s:10GLibObject12ConnectFlagsV","identifier":"doc:\/\/GLibObject\/documentation\/GLibObject\/ConnectFlags","text":"ConnectFlags"},{"text":" = ConnectFlags(0), ","kind":"text"},{"text":"handler","kind":"externalParam"},{"text":": ","kind":"text"},{"text":"@escaping","kind":"keyword"},{"text":" (","kind":"text"},{"text":"SignalGroupRef","identifier":"doc:\/\/GLibObject\/documentation\/GLibObject\/SignalGroupRef","preciseIdentifier":"s:10GLibObject14SignalGroupRefV","kind":"typeIdentifier"},{"kind":"text","text":", "},{"identifier":"doc:\/\/GLibObject\/documentation\/GLibObject\/ParamSpecRef","text":"ParamSpecRef","kind":"typeIdentifier","preciseIdentifier":"s:10GLibObject12ParamSpecRefV"},{"kind":"text","text":") -> "},{"text":"Void","kind":"typeIdentifier","preciseIdentifier":"s:s4Voida"},{"kind":"text","text":") -> "},{"text":"Int","kind":"typeIdentifier","preciseIdentifier":"s:Si"}],"platforms":["macOS"],"languages":["swift"]}]},{"kind":"parameters","parameters":[{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"Flags"}]}],"name":"flags"},{"name":"handler","content":[{"type":"paragraph","inlineContent":[{"text":"The signal handler to call","type":"text"},{"text":" ","type":"text"},{"text":"Run the given callback whenever the ","type":"text"},{"code":"notifyTargetType","type":"codeVoice"},{"text":" signal is emitted","type":"text"}]}]}]},{"kind":"content","co