{"abstract":[{"type":"codeVoice","code":"GObject"},{"type":"text","text":" instance (or source) and another property on another "},{"type":"codeVoice","code":"GObject"},{"text":" ","type":"text"},{"text":"instance (or target).","type":"text"}],"relationshipsSections":[{"title":"Inherits From","type":"inheritsFrom","identifiers":["doc:\/\/GLibObject\/documentation\/GLibObject\/Object"],"kind":"relationships"},{"title":"Conforms To","kind":"relationships","type":"conformsTo","identifiers":["doc:\/\/GLibObject\/documentation\/GLibObject\/BindingProtocol","doc:\/\/GLibObject\/4GLib14PointerWrapperP","doc:\/\/GLibObject\/documentation\/GLibObject\/ObjectProtocol"]}],"variants":[{"paths":["\/documentation\/glibobject\/binding"],"traits":[{"interfaceLanguage":"swift"}]}],"metadata":{"externalID":"s:10GLibObject7BindingC","title":"Binding","role":"symbol","symbolKind":"class","roleHeading":"Class","modules":[{"name":"GLibObject"}],"navigatorTitle":[{"text":"Binding","kind":"identifier"}],"fragments":[{"text":"class","kind":"keyword"},{"text":" ","kind":"text"},{"kind":"identifier","text":"Binding"}]},"primaryContentSections":[{"kind":"declarations","declarations":[{"tokens":[{"kind":"keyword","text":"class"},{"text":" ","kind":"text"},{"text":"Binding","kind":"identifier"}],"platforms":["macOS"],"languages":["swift"]}]},{"content":[{"text":"Overview","anchor":"overview","level":2,"type":"heading"},{"type":"paragraph","inlineContent":[{"text":"Whenever the source property changes, the same value is applied to the","type":"text"},{"type":"text","text":" "},{"text":"target property; for instance, the following binding:","type":"text"}]},{"syntax":"c","type":"codeListing","code":["  g_object_bind_property (object1, \"property-a\",","                          object2, \"property-b\",","                          G_BINDING_DEFAULT);"]},{"inlineContent":[{"text":"will cause the property named “property-b” of ","type":"text"},{"code":"object2","type":"codeVoice"},{"text":" to be updated","type":"text"},{"type":"text","text":" "},{"text":"every time [method","type":"text"},{"type":"codeVoice","code":"GObject.set"},{"text":"] or the specific accessor changes the value of","type":"text"},{"text":" ","type":"text"},{"type":"text","text":"the property “property-a” of "},{"type":"codeVoice","code":"object1"},{"type":"text","text":"."}],"type":"paragraph"},{"type":"paragraph","inlineContent":[{"type":"text","text":"It is possible to create a bidirectional binding between two properties"},{"type":"text","text":" "},{"type":"text","text":"of two "},{"type":"codeVoice","code":"GObject"},{"type":"text","text":" instances, so that if either property changes, the"},{"type":"text","text":" "},{"type":"text","text":"other is updated as well, for instance:"}]},{"syntax":"c","code":["  g_object_bind_property (object1, \"property-a\",","                          object2, \"property-b\",","                          G_BINDING_BIDIRECTIONAL);"],"type":"codeListing"},{"inlineContent":[{"text":"will keep the two properties in sync.","type":"text"}],"type":"paragraph"},{"inlineContent":[{"type":"text","text":"It is also possible to set a custom transformation function (in both"},{"text":" ","type":"text"},{"type":"text","text":"directions, in case of a bidirectional binding) to apply a custom"},{"type":"text","text":" "},{"text":"transformation from the source value to the target value before","type":"text"},{"text":" ","type":"text"},{"text":"applying it; for instance, the following binding:","type":"text"}],"type":"paragraph"},{"syntax":"c","code":["  g_object_bind_property_full (adjustment1, \"value\",","                               adjustment2, \"value\",","                               G_BINDING_BIDIRECTIONAL,","                               celsius_to_fahrenheit,","                               fahrenheit_to_celsius,","                               NULL, NULL);"],"type":"codeListing"},{"type":"paragraph","inlineContent":[{"text":"will keep the “value” property of the two adjustments in sync; the","type":"text"},{"type":"text","text":" "},{"type":"codeVoice","code":"celsius_to_fahrenheit"},{"text":" function will be called whenever the “value”","type":"text"},{"type":"text","text":" "},{"type":"text","text":"property of "},{"type":"codeVoice","code":"adjustment1"},{"type":"text","text":" changes and will transform the current value"},{"text":" ","type":"text"},{"type":"text","text":"of the property before applying it to the “value” property of "},{"type":"codeVoice","code":"adjustment2"},{"text":".","type":"text"}]},{"inlineContent":[{"text":"Vice versa, the ","type":"text"},{"code":"fahrenheit_to_celsius","type":"codeVoice"},{"type":"text","text":" function will be called whenever"},{"type":"text","text":" "},{"type":"text","text":"the “value” property of "},{"code":"adjustment2","type":"codeVoice"},{"text":" changes, and will transform the","type":"text"},{"text":" ","type":"text"},{"type":"text","text":"current value of the property before applying it to the “value” property"},{"type":"text","text":" "},{"text":"of ","type":"text"},{"type":"codeVoice","code":"adjustment1"},{"text":".","type":"text"}],"type":"paragraph"},{"inlineContent":[{"text":"Note that ","type":"text"},{"isActive":true,"type":"reference","identifier":"doc:\/\/GLibObject\/documentation\/GLibObject\/Binding"},{"type":"text","text":" does not resolve cycles by itself; a cycle like"}],"type":"paragraph"},{"type":"codeListing","syntax":null,"code":["  object1:propertyA -> object2:propertyB","  object2:propertyB -> object3:propertyC","  object3:propertyC -> object1:propertyA"]},{"type":"paragraph","inlineContent":[{"text":"might lead to an infinite loop. The loop, in this particular case,","type":"text"},{"type":"text","text":" "},{"type":"text","text":"can be avoided if the objects emit the "},{"code":"GObject","type":"codeVoice"},{"text":"notify","type":"text"},{"code":" signal only if the value has effectively been changed. A binding is implemented using the `GObject`notify","type":"codeVoice"},{"text":" signal, so it is susceptible to all the","type":"text"},{"type":"text","text":" "},{"type":"text","text":"various ways of blocking a signal emission, like [func"},{"type":"codeVoice","code":"GObject.signal_stop_emission"},{"text":"]","type":"text"},{"text":" ","type":"text"},{"type":"text","text":"or [func"},{"code":"GObject.signal_handler_block","type":"codeVoice"},{"type":"text","text":"]."}]},{"type":"paragraph","inlineContent":[{"text":"A binding will be severed, and the resources it allocates freed, whenever","type":"text"},{"type":"text","text":" "},{"text":"either one of the ","type":"text"},{"type":"codeVoice","code":"GObject"},{"type":"text","text":" instances it refers to are finalized, or when"},{"text":" ","type":"text"},{"text":"the ","type":"text"},{"type":"reference","identifier":"doc:\/\/GLibObject\/documentation\/GLibObject\/Binding","isActive":true},{"text":" instance loses its last reference.","type":"text"}]},{"type":"paragraph","inlineContent":[{"text":"Bindings for languages with garbage collection can use","type":"text"},{"text":" ","type":"text"},{"type":"text","text":"[method"},{"type":"codeVoice","code":"GObject.Binding.unbind"},{"text":"] to explicitly release a binding between the source","type":"text"},{"type":"text","text":" "},{"type":"text","text":"and target properties, instead of relying on the last reference on the"},{"text":" ","type":"text"},{"type":"text","text":"binding, source, and target instances to drop."}]},{"inlineContent":[{"text":"The ","type":"text"},{"type":"reference","isActive":true,"identifier":"doc:\/\/GLibObject\/documentation\/GLibObject\/Binding"},{"text":" type acts as a reference-counted owner of an underlying ","type":"text"},{"code":"GBinding","type":"codeVoice"},{"type":"text","text":" instance."},{"type":"text","text":" "},{"type":"text","text":"It provides the methods that can operate on this data type through "},{"isActive":true,"type":"reference","identifier":"doc:\/\/GLibObject\/documentation\/GLibObject\/BindingProtocol"},{"text":" conformance.","type":"text"},{"type":"text","text":" "},{"type":"text","text":"Use "},{"identifier":"doc:\/\/GLibObject\/documentation\/GLibObject\/Binding","isActive":true,"type":"reference"},{"type":"text","text":" as a strong reference or owner of a "},{"code":"GBinding","type":"codeVoice"},{"text":" instance.","type":"text"}],"type":"paragraph"},{"content":[{"inlineContent":[{"type":"text","text":"Use "},{"type":"reference","isActive":true,"identifier":"doc:\/\/GLibObject\/documentation\/GLibObject\/BindingRef"},{"type":"text","text":" (instead of "},{"type":"reference","isActive":true,"identifier":"doc:\/\/GLibObject\/documentation\/GLibObject\/Binding"},{"text":") for a lightweight Swift reference to an underlying ","type":"text"},{"type":"codeVoice","code":"GBinding"},{"text":" instance.","type":"text"}],"type":"paragraph"}],"name":"Note","type":"aside","style":"note"}],"kind":"content"}],"hierarchy":{"paths":[["doc:\/\/GLibObject\/documentation\/GLibObject"]]},"kind":"symbol","schemaVersion":{"minor":3,"major":0,"patch":0},"topicSections":[{"identifiers":["doc:\/\/GLibObject\/documentation\/GLibObject\/Binding\/init(_:)-2gjer","doc:\/\/GLibObject\/documentation\/GLibObject\/Binding\/init(_:)-6ihlv","doc:\/\/GLibObject\/documentation\/GLibObject\/Binding\/init(_:)-9ejwo","doc:\/\/GLibObject\/documentation\/GLibObject\/Binding\/init(_:)-c2ks","doc:\/\/GLibObject\/documentation\/GLibObject\/Binding\/init(binding:)","doc:\/\/GLibObject\/documentation\/GLibObject\/Binding\/init(cPointer:)","doc:\/\/GLibObject\/documentation\/GLibObject\/Binding\/init(gconstpointer:)","doc:\/\/GLibObject\/documentation\/GLibObject\/Binding\/init(gpointer:)","doc:\/\/GLibObject\/documentation\/GLibObject\/Binding\/init(opaquePointer:)","doc:\/\/GLibObject\/documentation\/GLibObject\/Binding\/init(raw:)-6d9mu","doc:\/\/GLibObject\/documentation\/GLibObject\/Binding\/init(raw:)-8xm6p","doc:\/